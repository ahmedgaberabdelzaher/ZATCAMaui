<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms" xmlns:custom="clr-namespace:GAZT" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="EGAZT.Views.NewDesign.ZakatDeregistration.ZakatRegistrationOutletsDetails"
                   NavigationPage.HasNavigationBar="false"
             BackgroundImageSource="partials_background.png" xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms" xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:FontImage="clr-namespace:MVP.FontIcons" xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:local="clr-namespace:EGAZT.Helper"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms">
        <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,0,0,0" x:Name="VATRMainGrid">

                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                                
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>

                </Grid>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
                      <Grid IsVisible="{Binding IsOutletViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0"
                    HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="1"/>
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.TinDeregistrationOutletDetails}" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource SectionTitleBlack}" />
                        <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.TinDeregistrationOutletReviewMessage}" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}" Margin="0,0,0,8" />
                        <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        
                        <listView:SfListView Margin="-3,0,-3,0"   Grid.Row="3" Grid.Column="0" ItemsSource="{Binding AllOutlets}" x:Name="outletsListView" HorizontalOptions="Center"
                                             IsScrollBarVisible="False" IsScrollingEnabled="True"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                SelectionMode="Single" SelectionBackgroundColor="Transparent" >
                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <border:SfBorder Margin="0,16,0,10" Grid.Row="3" Grid.Column="0" HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0">
                                    <Grid Padding="15" RowSpacing="0" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Center" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                       HasShadow="False">
                                        </Frame> 
                                        <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"  Aspect="AspectFit" Source="establishments"/>
                                        <StackLayout Grid.Row="0" Grid.Column="1" Padding="8,0">
                                            <Label Text="{Binding  AOutletNameTb}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                                        </StackLayout>
                                    </Grid>

                                    <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                    <Grid Padding="10" RowSpacing="8">
                                        <Grid.RowDefinitions >
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackLayout Grid.Row="0" Grid.Column="0" Spacing="-5">
                                            <Label Text="{x:Static ResourceManager:AppResources.TinDeregistrationOutletNumber}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                        </StackLayout>
                                        <StackLayout Grid.Row="0" Grid.Column="1" Spacing="-5">
                                            <Label Text="{Binding AOutletNoTb}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                        </StackLayout>
                                         <StackLayout Grid.Row="1" Grid.Column="0" Spacing="-5">
                                            <Label Text="{x:Static ResourceManager:AppResources.TinDeregistrationOutletCommercialName}"  Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                        </StackLayout>
                                        <StackLayout Grid.Row="1" Grid.Column="1" Spacing="-5">
                                            <Label Text="{Binding AOutletNameTb}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                        </StackLayout>
                                         <StackLayout Grid.Row="2" Grid.Column="0" Spacing="-5">
                                            <Label Text="{x:Static ResourceManager:AppResources.ZVatAddress}"  Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                        </StackLayout>
                                        <StackLayout Grid.Row="2" Grid.Column="1" Spacing="-5">
                                            <Label Text="{Binding AOutletCompAddr}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                        </StackLayout>
                                         <listView:SfListView Margin="0" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding PermitTypes}" HorizontalOptions="FillAndExpand" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="FillAndExpand" AutoFitMode="Height" ItemSpacing="5"
                                            SelectionMode="None" SelectionBackgroundColor="Transparent" >
                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>
                                                        <Grid>
                                                             <Grid.RowDefinitions >
                                                                <RowDefinition Height="auto"/>
                                                                <RowDefinition Height="auto"/>
                                                                <RowDefinition Height="auto"/>
                                                                 <RowDefinition Height="auto"/>
                                                                 <RowDefinition Height="auto"/>
                                                                 <RowDefinition Height="auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                             <border:SfBorder  Grid.Row="0" Grid.Column="0" HeightRequest="1" Grid.ColumnSpan="2" Margin="-4,8,-4,0" Padding="0" HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow}"/>

                                                             <StackLayout  Grid.Row="1" Grid.Column="0">
                                                                <Label Text="{x:Static ResourceManager:AppResources.TinDeregistrationPermitType}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="1" Grid.Column="1" Spacing="-5">
                                                                <Label Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End">
                                                                    <Label.Triggers>
                                                                       <DataTrigger TargetType="Label" Binding="{Binding APermitTypeTb}" Value="ZS0001">
                                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ZIBANNationalID}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding APermitTypeTb}" Value="BUP002">
                                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ZIBANCommercialRegistrationID}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding APermitTypeTb}" Value="ZS0005">
                                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ZIBANCompanyID}" />
                                                                        </DataTrigger>
                                                                         <DataTrigger TargetType="Label" Binding="{Binding APermitTypeTb}" Value="ZS0002">
                                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ZZIqamaID}" />
                                                                        </DataTrigger>
                                                                         <DataTrigger TargetType="Label" Binding="{Binding APermitTypeTb}" Value="ZS0004">
                                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ZZLicenseNumber}" />
                                                                        </DataTrigger>
                                                                    </Label.Triggers>
                                                                </Label>
                                                            </StackLayout>
                                                                <StackLayout Grid.Row="2" Grid.Column="0" Spacing="-5">
                                                                <Label Text="{x:Static ResourceManager:AppResources.TinDeregistrationPermitNumber}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="2" Grid.Column="1" Spacing="-5">
                                                                <Label Text="{Binding APermitNoTb}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                                            </StackLayout>
                                                                <StackLayout Grid.Row="3" Grid.Column="0" Spacing="-5">
                                                                <Label Text="{x:Static ResourceManager:AppResources.TinDeregistrationValidFrom}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="3" Grid.Column="1" Spacing="-5">
                                                                <Label Text="{Binding APermitValfrDtHTb,StringFormat='{0:dd MMM yyyy}'}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                                            </StackLayout>
                                                                <StackLayout Grid.Row="4" Grid.Column="0" Spacing="-5">
                                                                <Label Text="{x:Static ResourceManager:AppResources.TinDeregistrationDate}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="4" Grid.Column="1" Spacing="-5">
                                                                <Label Text="{Binding APermitDeregDisplayDate, StringFormat='{0:dd MMM yyyy}'}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                                            </StackLayout>
                                                                <StackLayout Grid.Row="5" Grid.Column="0" Spacing="-5">
                                                                <Label Text="{x:Static ResourceManager:AppResources.TinDeregistrationDeregReason}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="5" Grid.Column="1" Spacing="-5">
                                                                <Label Text="{Binding ReasonDescription}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                                            </StackLayout>
                                                        </Grid>
                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                         </listView:SfListView>
                                       
                                    </Grid>
                                </StackLayout>
                        </border:SfBorder >

			                </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                        </listView:SfListView>

                        
                    </Grid>
          
               </Grid>

    </ContentPage.Content>
</ContentPage>
