<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.ZakatDeregistration.ZakatRegistrationOutletsDetails"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:custom1="clr-namespace:GAZT.CustomControl"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:local="clr-namespace:EGAZT.Helper"
    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="false">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        CornerRadius="15,15,0,0">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">

                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid
                        Grid.Row="0"
                        Margin="8,0"
                        Padding="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="CenterAndExpand"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.ESTOutletsTabTitleLabel}"
                            VerticalOptions="Center" />
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="true"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid
            Margin="20,10,20,0"
            BackgroundColor="Transparent"
            HorizontalOptions="FillAndExpand"
            IsVisible="true"
            VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="50*" />
            </Grid.ColumnDefinitions>
            <listView:SfListView
                x:Name="outletsListView"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="-3,0,-3,0"
                AutoFitMode="Height"
                HorizontalOptions="Center"
                IsScrollBarVisible="False"
                IsScrollingEnabled="True"
                ItemSpacing="5"
                ItemsSource="{Binding OutletData}"
                SelectionBackgroundColor="Transparent"
                SelectionMode="Single"
                VerticalOptions="Start">
                <listView:SfListView.ItemTemplate>
                    <DataTemplate>
                        <border:SfBorder
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,16,0,10"
                            HasShadow="False"
                            Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout Padding="0">
                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Center" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                        HasShadow="False">
                        </Frame>-->
                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="8,0"
                                        Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Aspect="AspectFit"
                                            HeightRequest="24"
                                            HorizontalOptions="Start"
                                            Source="establishments"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />

                                        <Label
                                            Padding="8,0"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{Binding Actnm}"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                <Grid Padding="10" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Spacing="-5">
                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationOutletNumber}" />
                                    </StackLayout>
                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Spacing="-5">
                                        <Label
                                            HorizontalOptions="End"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding Actno}" />
                                    </StackLayout>
                                    <StackLayout
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Spacing="-5">
                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ESTOutletCity}" />
                                    </StackLayout>
                                    <StackLayout
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Spacing="-5">
                                        <Label
                                            HorizontalOptions="End"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding City1}" />
                                    </StackLayout>
                                    <StackLayout
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Spacing="-5">
                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ESTAddCRAndOrLicenseDetails}" />
                                    </StackLayout>
                                    <StackLayout
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Spacing="-5">
                                        <Label
                                            HorizontalOptions="End"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding Crlicenceno}" />
                                    </StackLayout>

                                </Grid>
                            </StackLayout>
                        </border:SfBorder>

                    </DataTemplate>
                </listView:SfListView.ItemTemplate>
            </listView:SfListView>


        </Grid>
    </ContentPage.Content>
</ContentPage>
