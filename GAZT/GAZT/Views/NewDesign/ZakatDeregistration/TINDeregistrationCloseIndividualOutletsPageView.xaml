    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    x:Name="TinDeregIndOutlets">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="CaptionLabelBlack" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <converters:TINDeregistrationAPermitDregRsnTbValueConverter x:Key="dregRsnTbValueConverter" />
            <converters:BoolToVisibilityConverter x:Key="xBoolToVisibilityConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </ContentPage.Resources>
    <yummy:PancakeView
        Grid.Row="1"
        Padding="0"
        BackgroundColor="White"
        CornerRadius="30,30,0,0">
        <!--<Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0"
                  Padding="0,0,0,0" x:Name="VATRMainGrid">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="10*" />
                                <RowDefinition Height="100*" />

                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>-->
        <Grid>
            <ScrollView>
                <Grid
                    Margin="20,10,20,0"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="true"
                    VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="1" />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource SectionTitleBlack}"
                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationReason}" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource BodyLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationSelectReason}" />
                        <BoxView
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                    </Grid>

                    <listView:SfListView
                        x:Name="outletDecisionOptionsListView"
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        AutoFitMode="Height"
                        HorizontalOptions="FillAndExpand"
                        IsScrollBarVisible="False"
                        IsScrollingEnabled="False"
                        IsVisible="true"
                        ItemSpacing="5"
                        ItemsSource="{Binding PermitOutletDecisionOptions}"
                        SelectedItem="{Binding SelectedPermitTypeOutletOption, Mode=TwoWay}"
                        SelectionBackgroundColor="Transparent"
                        SelectionChanged="outletDecisionOptionsListView_SelectionChanged"
                        SelectionMode="Single"
                        VerticalOptions="FillAndExpand">
                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView
                                    BackgroundColor="Transparent"
                                    CornerRadius="20"
                                    HasShadow="False"
                                    HeightRequest="104"
                                    WidthRequest="171">
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="104" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Aspect="Fill"
                                            HorizontalOptions="FillAndExpand"
                                            Source="unselected171x136"
                                            VerticalOptions="FillAndExpand" />
                                        <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                            <Label Style="{DynamicResource CardLabelBlack}" Text="{Binding CardLabel}" />
                                        </StackLayout>
                                    </Grid>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                        <listView:SfListView.SelectedItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView
                                    BackgroundColor="Transparent"
                                    CornerRadius="20"
                                    HasShadow="False"
                                    HeightRequest="104"
                                    WidthRequest="171">
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="104" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Aspect="Fill"
                                            HorizontalOptions="FillAndExpand"
                                            Source="re_Tile_Background_S"
                                            VerticalOptions="FillAndExpand" />
                                        <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                            <Label Style="{DynamicResource CardLabelWhite}" Text="{Binding CardLabel}" />
                                        </StackLayout>
                                    </Grid>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.SelectedItemTemplate>
                        <listView:SfListView.LayoutManager>
                            <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                        </listView:SfListView.LayoutManager>
                    </listView:SfListView>

                    <StackLayout
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        IsVisible="{Binding IsPermitOption1Visible}">
                        <Label>
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.TinDeregistrationDate}" />
                                    <Span Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <StackLayout
                            x:Name="CalLabel"
                            Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal">
                            <Label
                                HorizontalOptions="Start"
                                Style="{StaticResource CaptionLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.NDGregorian}" />
                            <Switch
                                x:Name="HijriCalSwitch"
                                HorizontalOptions="CenterAndExpand"
                                IsToggled="{Binding IsHijriCal}"
                                Toggled="HijriCalSwitch_Toggled" />
                            <Label
                                HorizontalOptions="End"
                                Style="{StaticResource CaptionLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.NDHijri}" />
                        </StackLayout>
                        <Grid
                            Grid.Row="5"
                            Grid.Column="0"
                            Grid.ColumnSpan="2">
                            <inputLayout:SfTextInputLayout
                                x:Name="FrmDBO"
                                Margin="0,-10,0,0"
                                Style="{StaticResource InputTableTextInputLayoutStyle}">
                                <custom:BorderlessEntry
                                    x:Name="DateEntry"
                                    BackgroundColor="Gray"
                                    Focused="OnDateEntryFocussed"
                                    IsReadOnly="True"
                                    Placeholder="yyyy/MM/dd"
                                    Style="{StaticResource InputTableEntryLayoutStyle}"
                                    Text="{Binding PickerCloseAllDeregDateDisplay}"
                                    TextChanged="DeregDateEntry_TextChanged"
                                    TextColor="{StaticResource NeutralBlack}"
                                    Unfocused="CloseDeregDatePicker_Unfocused"
                                    VerticalTextAlignment="End" />
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <!--<Image Source="arrowDropdown.png"/>-->
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                        <Image Margin="5,0">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="UserIconFont"
                                                    Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                    Size="20"
                                                    Color="{StaticResource SecondaryNew}" />
                                            </Image.Source>
                                        </Image>
                                    </StackLayout>
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>
                            <Button
                                Margin="0,0,0,0"
                                BackgroundColor="Transparent"
                                Clicked="OnDOBClicked" />
                            <custom1:CustomDatePicker
                                x:Name="CloseDeregDatePicker"
                                Margin="10,0,10,0"
                                BackgroundColor="White"
                                BorderColor="Black"
                                CancelButtonBackgroundColor="#EAF7CC"
                                CancelButtonTextColor="{StaticResource Primary}"
                                Closed="CloseDeregDatePicker_Closed"
                                ColumnHeaderBackgroundColor="White"
                                ColumnHeaderHeight="46"
                                FlowDirection="RightToLeft"
                                HeaderBackgroundColor="#EAF7CC"
                                HorizontalOptions="FillAndExpand"
                                ItemHeight="40"
                                OKButtonBackgroundColor="#EAF7CC"
                                OKButtonTextColor="{StaticResource Primary}"
                                PickerMode="Dialog"
                                SelectedItem="{Binding TodayDate}"
                                SelectedItemTextColor="{StaticResource NeutralBlack}"
                                ShowColumnHeader="True"
                                ShowFooter="False"
                                ShowHeader="False">
                                <custom1:CustomDatePicker.Behaviors>
                                    <custom1:SfPickerBehavior />
                                </custom1:CustomDatePicker.Behaviors>
                            </custom1:CustomDatePicker>
                            <!--  HijriDatePicker  -->
                            <custom1:CustomHijriDatePicker
                                x:Name="CloseDeregDatePickerHijri"
                                Margin="10,0,10,0"
                                BackgroundColor="White"
                                BorderColor="Black"
                                CancelButtonBackgroundColor="#EAF7CC"
                                CancelButtonTextColor="{StaticResource Primary}"
                                Closed="CloseDeregDatePicker_Closed"
                                ColumnHeaderBackgroundColor="White"
                                ColumnHeaderHeight="46"
                                FlowDirection="RightToLeft"
                                HeaderBackgroundColor="#EAF7CC"
                                HorizontalOptions="FillAndExpand"
                                ItemHeight="40"
                                OKButtonBackgroundColor="#EAF7CC"
                                OKButtonTextColor="{StaticResource Primary}"
                                PickerMode="Dialog"
                                SelectedItem="{Binding TodayDateinHijri}"
                                SelectedItemTextColor="{StaticResource NeutralBlack}"
                                ShowColumnHeader="True"
                                ShowFooter="False"
                                ShowHeader="False" />
                            <!--  SelectedItem="{Binding TodayDate}"  -->
                            <!--  HijriDatePicker  -->
                        </Grid>

                        <!--<border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="0,0,0,10"  Style="{StaticResource GreyBorderFrame}">

                                <StackLayout Orientation="Horizontal"  Padding="5,15,5,15">

                                    <Label Text="{Binding BindingContext.SingleDeregistrationDate,Source={x:Reference TinDeregIndOutlets}}" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Start"/>
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                        <Image Margin="5,0">
                                            <Image.Source>
