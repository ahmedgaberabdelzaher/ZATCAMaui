                                                            Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"/>
                                            </Image.Source>
                                        </Image>
                                    </StackLayout>

                                    <StackLayout.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="TapGestureRecognizerSingleDeregDate_Tapped" CommandParameter="{Binding APermitNoTb}"></TapGestureRecognizer>
                                    </StackLayout.GestureRecognizers>
                                </StackLayout>
                            </border:SfBorder >-->
                        <!--<StackLayout.Triggers>
                                 <DataTrigger TargetType="StackLayout" Binding="{Binding SelectedPermitOutletOptionIndex}" Value="0">
                                    <Setter Property="IsVisible" Value="true" />
                                </DataTrigger>
                                <DataTrigger TargetType="StackLayout" Binding="{Binding SelectedPermitOutletOptionIndex}" Value="1">
                                    <Setter Property="IsVisible" Value="false" />
                                </DataTrigger>
                                <DataTrigger TargetType="StackLayout" Binding="{Binding SelectedPermitOutletOptionIndex}" Value="2">
                                    <Setter Property="IsVisible" Value="false" />
                                </DataTrigger>
                            </StackLayout.Triggers>-->
                    </StackLayout>

                    <StackLayout
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        IsVisible="{Binding IsPermitOption2Visible}">
                        <!--<StackLayout.Triggers>
                                <DataTrigger TargetType="StackLayout" Binding="{Binding SelectedPermitOutletOptionIndex}" Value="0">
                                <Setter Property="IsVisible" Value="false" />
                            </DataTrigger>
                            <DataTrigger TargetType="StackLayout" Binding="{Binding SelectedPermitOutletOptionIndex}" Value="1">
                                <Setter Property="IsVisible" Value="true" />
                            </DataTrigger>
                            <DataTrigger TargetType="StackLayout" Binding="{Binding SelectedPermitOutletOptionIndex}" Value="2">
                                <Setter Property="IsVisible" Value="false" />
                            </DataTrigger>
                        </StackLayout.Triggers>-->
                        <!--  Display this view in both cases Transfer outlets to snigle transferee an sub selection all id types-!>  -->

                        <StackLayout>
                            <StackLayout>
                                <Label>
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.TinDeregistrationDate}" />
                                            <Span Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <StackLayout Orientation="Horizontal">
                                    <Label
                                        HorizontalOptions="Start"
                                        Style="{StaticResource CaptionLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDGregorian}" />
                                    <Switch
                                        x:Name="HijriCalSwitch1"
                                        HorizontalOptions="CenterAndExpand"
                                        IsToggled="{Binding IsHijriCal, Mode=TwoWay}"
                                        Toggled="HijriCal2Switch_Toggled" />
                                    <Label
                                        HorizontalOptions="End"
                                        Style="{StaticResource CaptionLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDHijri}" />
                                </StackLayout>
                                <Grid>
                                    <inputLayout:SfTextInputLayout
                                        x:Name="FrmDBO2"
                                        Margin="0,-10,0,0"
                                        Style="{StaticResource InputTableTextInputLayoutStyle}">
                                        <custom:BorderlessEntry
                                            x:Name="DateEntry21"
                                            Focused="OnDateEntryFocussed"
                                            IsReadOnly="True"
                                            Placeholder="yyyy/MM/dd"
                                            Style="{StaticResource InputTableEntryLayoutStyle}"
                                            Text="{Binding PickerCloseAllDeregDateDisplay}"
                                            TextChanged="DeregDateEntry_TextChanged"
                                            TextColor="{StaticResource NeutralBlack}"
                                            Unfocused="CloseDeregDatePicker_Unfocused"
                                            VerticalTextAlignment="End" />
                                        <inputLayout:SfTextInputLayout.TrailingView>
                                            <!--<Image Source="arrowDropdown.png"/>-->
                                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                                <Image Margin="5,0">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                            Size="20"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                </Image>
                                            </StackLayout>
                                        </inputLayout:SfTextInputLayout.TrailingView>
                                    </inputLayout:SfTextInputLayout>
                                    <Button
                                        Margin="0,0,0,0"
                                        BackgroundColor="Transparent"
                                        Clicked="OnDOBClicked"
                                        TextColor="Transparent" />
                                    <custom1:CustomDatePicker
                                        x:Name="TransferDeregDatePicker"
                                        Margin="10,0,10,0"
                                        BackgroundColor="White"
                                        BorderColor="Black"
                                        CancelButtonBackgroundColor="#EAF7CC"
                                        CancelButtonTextColor="{StaticResource Primary}"
                                        Closed="CloseDeregDatePicker_Closed"
                                        ColumnHeaderBackgroundColor="White"
                                        ColumnHeaderHeight="46"
                                        FlowDirection="RightToLeft"
                                        HeaderBackgroundColor="#EAF7CC"
                                        HorizontalOptions="FillAndExpand"
                                        ItemHeight="40"
                                        OKButtonBackgroundColor="#EAF7CC"
                                        OKButtonTextColor="{StaticResource Primary}"
                                        PickerMode="Dialog"
                                        SelectedItem="{Binding TodayDate}"
                                        SelectedItemTextColor="{StaticResource NeutralBlack}"
                                        ShowColumnHeader="True"
                                        ShowFooter="False"
                                        ShowHeader="False">
                                        <custom1:CustomDatePicker.Behaviors>
                                            <custom1:SfPickerBehavior />
                                        </custom1:CustomDatePicker.Behaviors>
                                    </custom1:CustomDatePicker>
                                    <!--  HijriDatePicker  -->
                                    <custom1:CustomHijriDatePicker
                                        x:Name="TransferDeregDatePickerHijri"
                                        Margin="10,0,10,0"
                                        BackgroundColor="White"
                                        BorderColor="Black"
                                        CancelButtonBackgroundColor="#EAF7CC"
                                        CancelButtonTextColor="{StaticResource Primary}"
                                        Closed="CloseDeregDatePicker_Closed"
                                        ColumnHeaderBackgroundColor="White"
                                        ColumnHeaderHeight="46"
                                        FlowDirection="RightToLeft"
                                        HeaderBackgroundColor="#EAF7CC"
                                        HorizontalOptions="FillAndExpand"
                                        ItemHeight="40"
                                        OKButtonBackgroundColor="#EAF7CC"
                                        OKButtonTextColor="{StaticResource Primary}"
                                        PickerMode="Dialog"
                                        SelectedItem="{Binding TodayDateinHijri}"
                                        SelectedItemTextColor="{StaticResource NeutralBlack}"
                                        ShowColumnHeader="True"
                                        ShowFooter="False"
                                        ShowHeader="False" />
                                    <!--  SelectedItem="{Binding TodayDate}"  -->
                                    <!--  HijriDatePicker  -->
                                </Grid>

                                <!--<border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="0,0,0,10"  Style="{StaticResource GreyBorderFrame}">

                                    <StackLayout Orientation="Horizontal"  Padding="5,15,5,15">

                                        <Label Text="{Binding BindingContext.SingleDeregistrationDate,Source={x:Reference TinDeregIndOutlets}}"
                                               Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Start"/>
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                            <Image Margin="5,0">
                                                <Image.Source>
