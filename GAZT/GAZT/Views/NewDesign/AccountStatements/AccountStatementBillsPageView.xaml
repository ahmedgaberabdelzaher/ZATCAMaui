<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters" 
             xmlns:local="clr-namespace:EGAZT.CustomControl"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" 
              xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT" xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.NewDesign.AccountStatements.AccountStatementBillsPageView"
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="partials_background.png">
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:StringToColorConvertor x:Key="StringToColorConvertor" />
            <local:IntToBoolConverter x:Key="IntToBoolConverter" />
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
 
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>
                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.ASAccountStatementDashboardTileText}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>
                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}" VerticalOptions="CenterAndExpand" 
                               HorizontalOptions="StartAndExpand" Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}"
                               HeightRequest="24" WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <StackLayout Spacing="15" Orientation="Horizontal" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Grid.Row="0" Grid.Column="2">
                            <Image Source="search" IsVisible="{TemplateBinding BindingContext.IsSearchButtonVisible}" HeightRequest="20" WidthRequest="20">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="searchButtonTapped"/>
                                </Image.GestureRecognizers> 
                            </Image>
                            <Image Source="filter" HeightRequest="20" WidthRequest="20">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="filterButtonTapped"/>
                                </Image.GestureRecognizers>  
                            </Image>
                        </StackLayout>
                        <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
                                      Grid.Row="1" Grid.ColumnSpan="3">

                            <Grid HorizontalOptions="FillAndExpand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <SearchBar Grid.Column="0"  BackgroundColor="White" custom:RoundCornersEffect.CornerRadius="12" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0" TextChanged="SearchBar_TextChanged" IsVisible="{TemplateBinding BindingContext.IsCloseButtonVisible}">
                                </SearchBar>
                                <Image Grid.Column="1" WidthRequest="24" HeightRequest="24" Source="close" IsVisible="{TemplateBinding BindingContext.IsCloseButtonVisible}">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="CloseSearchButton_Tapped">
                                        </TapGestureRecognizer>
                                    </Image.GestureRecognizers> 
                                </Image>

                            </Grid>
                        </StackLayout>
                    </Grid>
                    <yummy:PancakeView  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" Padding="0,15,0,0" BackgroundColor="White" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Grid.Column="0" Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <Grid Padding="24,5,24,5" RowSpacing="12" x:Name="pageBinder">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackLayout Spacing="-5" Grid.Row="0" BackgroundColor="Transparent" Padding="0">

                    <StackLayout Orientation="Horizontal">
                        <custom:CustomLabel Text="{Binding SelectedTransactionTypeFilter.Txt30, Mode=OneWay}" Style="{StaticResource SectionTitleBlack}" HorizontalOptions="Start"
                                        VerticalOptions="CenterAndExpand">
                            <custom:CustomLabel.GestureRecognizers>
                                <TapGestureRecognizer Tapped="btn_Clicked"/>
                            </custom:CustomLabel.GestureRecognizers>
                        </custom:CustomLabel>
                        <Image Source="arrowDropdown"   HorizontalOptions="Center" VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="btn_Clicked"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </StackLayout>

                    <custom:CustomLabel Padding="0,-10,0,0"  HorizontalOptions="StartAndExpand" VerticalOptions="Start" VerticalTextAlignment="Start">
                        <custom:CustomLabel.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static ResourceManager:AppResources.ACMyTaxObligations}" Style="{StaticResource CaptionLabelGrey}" ></Span>
                                <Span Text="&#160;" Style="{StaticResource SectionTitleBlackBold}"></Span>
                                <Span Text="{Binding AmountLabel}"  Style="{StaticResource CaptionLabelGrey}"></Span>
                            </FormattedString>
                        </custom:CustomLabel.FormattedText>
                    </custom:CustomLabel>
                    <!--<custom:CustomLabel Text="{Binding AmountLabel}" Style="{StaticResource CaptionLabelGrey}"/>-->
                    <StackLayout BackgroundColor="Transparent" Orientation="Horizontal"
                            VerticalOptions="Center" Margin="0,10,0,0">
                        <!--Status Chips-->


                        <Grid VerticalOptions="Start" Margin="0,5,0,0">
                            <CollectionView 
                          SelectionMode="None"
                               ItemsLayout="HorizontalList"
                          ItemsSource="{Binding ChipDataFilterlistForStatus}"
                               HeightRequest="50"
                               HorizontalOptions="StartAndExpand" VerticalOptions="Start">

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>

                                        <StackLayout Margin="5">
                                            <Grid Margin="5,0,5,0">
                                                <Frame Grid.Row="0" 
                                                           HorizontalOptions="FillAndExpand"
                                                    Padding="10,10,10,10" CornerRadius="14"
                                                    HeightRequest="20" Opacity=".2" BackgroundColor="{StaticResource Primary}"
                                                     HasShadow="False"  VerticalOptions="CenterAndExpand" 
                                                     >
                                                    <Frame.Triggers>
                                                        <DataTrigger TargetType="Frame" Binding="{Binding Text}" Value="{x:Static ResourceManager:AppResources.Paid}">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Frame" Binding="{Binding Text}" Value="{x:Static ResourceManager:AppResources.PartiallyPaid}">
                                                            <Setter Property="BackgroundColor" Value="Orange" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Frame" Binding="{Binding Text}" Value="{x:Static ResourceManager:AppResources.UnPaid}">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}" />
                                                        </DataTrigger>
                                                    </Frame.Triggers>
                                                </Frame>
                                                <StackLayout Grid.Row="0"  Padding="10,0,10,0">
                                                    <!--TextColor="{Binding Status,Converter={StaticResource StringToColorConvertor}}" -->
                                                    <custom:CustomLabel Style="{StaticResource CaptionLabelBlack}"
                                                                             Text="{Binding Text}" HorizontalOptions="CenterAndExpand"  
                                                                                VerticalOptions="CenterAndExpand" >

                                                    </custom:CustomLabel>
                                                </StackLayout>

                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer 
                                                                Tapped="ChipsData_Tapped">
                                                    </TapGestureRecognizer>
                                                </Grid.GestureRecognizers>


                                            </Grid>
                                        </StackLayout>

                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </StackLayout>
                </StackLayout>
                <StackLayout Grid.Row="1" Padding="0">

                    <ListView  x:Name="Bills" ItemsSource="{Binding MyBills,Mode=TwoWay}"
                           IsVisible="{Binding IsListVisible}" VerticalScrollBarVisibility="Never" HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand" HasUnevenRows="True" BackgroundColor="White" SelectionMode="None"
                           SeparatorVisibility="None" ItemTapped="LVNormalStatements_ItemTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <border:SfBorder   Margin="0,12" Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Spacing="0">
                                            <Grid RowSpacing="3"  Padding="16,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackLayout Grid.Row="0" Grid.Column="0">
                                                    <Label  Text="{Binding Abtypt}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                                                </StackLayout>

                                                

                                                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="{StaticResource Primary}" Padding="15" CornerRadius="14" Opacity=".2"    VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand" >
                                                    <Frame.Triggers>
                                                        <DataTrigger TargetType="Frame" Binding="{Binding StatusText}" Value="{x:Static ResourceManager:AppResources.Paid}">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Frame" Binding="{Binding StatusText}" Value="{x:Static ResourceManager:AppResources.PartiallyPaid}">
                                                            <Setter Property="BackgroundColor" Value="Orange" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Frame" Binding="{Binding StatusText}" Value="{x:Static ResourceManager:AppResources.UnPaid}">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}" />
                                                        </DataTrigger>
                                                    </Frame.Triggers>
                                                </Frame>
                                                <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalOptions="FillAndExpand" Spacing="2"  Margin="0,0,0,0" Padding="15,12,15,12" HorizontalOptions="FillAndExpand" >
                                                    <custom:CustomLabel  TextColor="{StaticResource NewDarkGreenColor}"  Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" LineBreakMode="WordWrap">
                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding TestDueAmount}"></Span>
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                        <custom:CustomLabel.Triggers>
                                                            <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding StatusText}" Value="{x:Static ResourceManager:AppResources.Paid}">
                                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding StatusText}" Value="{x:Static ResourceManager:AppResources.PartiallyPaid}">
                                                                <Setter Property="TextColor" Value="Orange" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding StatusText}" Value="{x:Static ResourceManager:AppResources.UnPaid}">
                                                                <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
                                                            </DataTrigger>
                                                        </custom:CustomLabel.Triggers>
                                                    </custom:CustomLabel>

                                                    <custom:CustomLabel  TextColor="{StaticResource NewDarkGreenColor}"  Style="{StaticResource CaptionLabelBlack}"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" LineBreakMode="WordWrap">
                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"></Span>
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                        <custom:CustomLabel.Triggers>
                                                            <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding StatusText}" Value="{x:Static ResourceManager:AppResources.Paid}">
                                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding StatusText}" Value="{x:Static ResourceManager:AppResources.PartiallyPaid}">
                                                                <Setter Property="TextColor" Value="Orange" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding StatusText}" Value="{x:Static ResourceManager:AppResources.UnPaid}">
                                                                <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
                                                            </DataTrigger>
                                                        </custom:CustomLabel.Triggers>
                                                    </custom:CustomLabel>

                                                </StackLayout>


                                                <!--<custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{Binding Txt30}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"   />-->

                                                <custom:CustomLabel Grid.Row="1" Grid.Column="1" Text="{Binding FormatedFaedn}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand"/>
                                               
                                            </Grid>

                                        </StackLayout>
                                    </border:SfBorder >
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <custom:CustomLabel Margin="0,20,0,0"  Text="{x:Static ResourceManager:AppResources.NoBillsAvailable}" Style="{StaticResource CaptionLabelGrey}"  HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding isNoDataLableVisible}"/>

                </StackLayout>
            </Grid>
            <Grid IsVisible="{Binding IsLoading}" BackgroundColor="Transparent">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black"
                         Opacity="0.4" VerticalOptions="FillAndExpand" />
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent"
                         Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding"
                                                   EnableAnimation="True"
                                                   AnimationType="SingleCircle"
                                                   HorizontalOptions="CenterAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                                   IsBusy="True"
                                                   ViewBoxWidth="70"
                                                   TitlePlacement="Bottom"
                                                   ViewBoxHeight="70"
                                                   TextColor="#D99A29" />
                        <!--Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"-->
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>