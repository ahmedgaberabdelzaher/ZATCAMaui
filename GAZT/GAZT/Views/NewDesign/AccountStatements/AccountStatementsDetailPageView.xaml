<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.AccountStatements.AccountStatementsDetailPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:local="clr-namespace:EGAZT.CustomControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">


    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <local:StringToColorConvertor x:Key="StringToColorConvertor" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />

                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>


    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        CornerRadius="15,15,0,0">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Grid.Row="0" Padding="24,10,24,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontFamily="{StaticResource GAZT_FONT_BOLD}"
                            FontSize="Large"
                            HorizontalOptions="CenterAndExpand"
                            Text="{x:Static ResourceManager:AppResources.ASStatementDetails}"
                            TextColor="White"
                            VerticalOptions="CenterAndExpand" />

                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="24"
                            HorizontalOptions="StartAndExpand"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="backButton_Tapped" />
                            </Image.GestureRecognizers>
                        </Image>


                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>



        <StackLayout>
            <border:SfBorder
                Margin="10"
                HasShadow="False"
                Style="{StaticResource GreyBorderFrameWithShadow}">
                <StackLayout Padding="0" Spacing="0">
                    <Grid Padding="15" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="0">
                            <Label
                                x:Name="LableCardTitle"
                                Style="{StaticResource SectionTitleSmallMediumBlack}"
                                VerticalOptions="CenterAndExpand" />

                            <StackLayout Orientation="Horizontal">
                                <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ASFBNum}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="Start"></custom:CustomLabel>
                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="Start" Text=": "></custom:CustomLabel>-->
                                <custom:CustomLabel
                                    x:Name="LableFbNum"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    VerticalOptions="CenterAndExpand" />
                            </StackLayout>
                        </StackLayout>
                        <Frame
                            x:Name="FrameCardStatus"
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="10,10,10,10"
                            BackgroundColor="{Binding Status, Converter={StaticResource StringToColorConvertor}}"
                            CornerRadius="14"
                            HasShadow="False"
                            HeightRequest="20"
                            HorizontalOptions="FillAndExpand"
                            Opacity=".2"
                            VerticalOptions="CenterAndExpand" />
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="10,0,10,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <!--<Label Style="{StaticResource CaptionLabelBlack}" Text="{Binding Betrh}"
                                               TextColor="{Binding Status,Converter={StaticResource StringToColorConvertor}}"   HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                                        </Label>-->



                            <custom:CustomLabel
                                x:Name="LableCardStatus"
                                HorizontalOptions="CenterAndExpand"
                                Style="{StaticResource CaptionLabelBlack}"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>
                        <BoxView
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,5"
                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        <StackLayout
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,5">
                            <custom:CustomLabel
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ASSadadBillNumber}"
                                VerticalOptions="CenterAndExpand" />
                            <custom:CustomLabel
                                x:Name="LableSadadNum"
                                Margin="0,-10"
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource ValueLabelBlack}"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>

                        <!--<StackLayout Grid.Row="2" Grid.Column="1" Margin="0,5">
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ASTransactionDate}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></custom:CustomLabel>
                            <custom:CustomLabel x:Name="LableTransactionDate"  Margin="0,-10" Style="{StaticResource SectionTitleSmallMediumBlack}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></custom:CustomLabel>
                        </StackLayout>-->
                        <StackLayout
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,5">
                            <custom:CustomLabel
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentDueDate}"
                                VerticalOptions="CenterAndExpand" />
                            <custom:CustomLabel
                                x:Name="LableDueDate"
                                Margin="0,-10"
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource ValueLabelBlack}"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>


                        <StackLayout
                            Grid.Row="3"
                            Grid.ColumnSpan="2"
                            Margin="0,5">
                            <custom:CustomLabel
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryTaxPeriod}"
                                VerticalOptions="CenterAndExpand" />
                            <custom:CustomLabel
                                x:Name="LableTaxPeriod"
                                Margin="0,-10"
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource ValueLabelBlack}"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>


                    </Grid>

                </StackLayout>
            </border:SfBorder>

            <StackLayout>
                <StackLayout
                    x:Name="TaxTypeGrid"
                    Padding="10"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
                    <border:SfBorder
                        Margin="1"
                        HorizontalOptions="FillAndExpand"
                        Style="{StaticResource GreyBorderFrameWithShadow}"
                        VerticalOptions="FillAndExpand">

                        <Grid
                            Margin="0"
                            Padding="0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="StartAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Frame
                                x:Name="TaxTypeDesc"
                                Grid.Row="0"
                                CornerRadius="8"
                                HasShadow="False"
                                HorizontalOptions="FillAndExpand"
                                Opacity=".2"
                                VerticalOptions="FillAndExpand" />
                            <StackLayout
                                Grid.Row="0"
                                Padding="10"
                                VerticalOptions="FillAndExpand">
                                <custom:CustomLabel
                                    x:Name="LableTaxType"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text=""
                                    VerticalOptions="CenterAndExpand" />

                            </StackLayout>
                        </Grid>
                    </border:SfBorder>
                </StackLayout>
                <Grid
                    Margin="0"
                    Padding="10"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="StartAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Frame
                        x:Name="CardAmount"
                        Grid.Row="0"
                        CornerRadius="20"
                        HasShadow="False"
                        HorizontalOptions="FillAndExpand"
                        Opacity=".2" />
                    <StackLayout
                        Grid.Row="0"
                        Padding="10"
                        Orientation="Horizontal">
                        <custom:CustomLabel
                            x:Name="LableAmountTitle"
                            FontSize="15"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource BodyLabelBlack}"
                            VerticalOptions="CenterAndExpand" />
                        <custom:CustomLabel
                            x:Name="LableAmount"
                            HorizontalOptions="EndAndExpand"
                            Style="{StaticResource SectionTitleBlackBold}"
                            Text=""
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </Grid>

                <Grid
                    x:Name="GridAmountRemaining"
                    Margin="0"
                    Padding="10"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="False"
                    VerticalOptions="StartAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Frame
                        x:Name="CardAmountRemaining"
                        Grid.Row="0"
                        CornerRadius="20"
                        HasShadow="False"
                        HorizontalOptions="FillAndExpand"
                        Opacity=".2" />
                    <StackLayout
                        Grid.Row="0"
                        Padding="10"
                        Orientation="Horizontal">
                        <custom:CustomLabel
                            FontSize="15"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource BodyLabelBlack}"
                            Text="{x:Static ResourceManager:AppResources.MyBillsRemainingAmount}"
                            VerticalOptions="CenterAndExpand" />
                        <custom:CustomLabel
                            x:Name="RemainingAmount"
                            HorizontalOptions="EndAndExpand"
                            Style="{StaticResource SectionTitleBlackBold}"
                            Text=""
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </Grid>
            </StackLayout>
        </StackLayout>


    </ContentPage.Content>
</ContentPage>