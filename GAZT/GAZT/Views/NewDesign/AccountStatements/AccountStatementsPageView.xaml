                                                                <Grid  Padding="15" RowSpacing="0">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="auto"/>
                                                                        <RowDefinition Height="auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-10">
                                                                        <Label  Text="{Binding Desc}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleSmallMediumBlack}"/>
                                                                        <Label Text="{Binding FormattedBldat}" Style="{StaticResource CaptionLabelGrey}"/>
                                                                    </StackLayout>
                                                                    <Frame Grid.Row="0" Grid.Column="1"
                                                                            BackgroundColor="{Binding Status,Converter={StaticResource StringToColorConvertor}}"
                                                                            Padding="10,10,10,10" CornerRadius="14" WidthRequest="110"
                                                                            HeightRequest="20" Opacity=".2"
                                                                            HasShadow="False"   
                                                                            VerticalOptions="CenterAndExpand" HorizontalOptions="End" />
                                                                    <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalOptions="FillAndExpand"  HorizontalOptions="CenterAndExpand" >
                                                                        ~1~
                                                                        <Label Style="{StaticResource CaptionLabelBlack}" Text="{Binding Betrh}"
                                                                                TextColor="{Binding Status,Converter={StaticResource StringToColorConvertor}}"  HorizontalOptions="Center" VerticalOptions="CenterAndExpand">
                                                                        </Label>
                                                                                @1@
                                                                        <custom:CustomLabel Style="{StaticResource CaptionLabelBlack}"
                                                                            TextColor="{Binding Status,Converter={StaticResource StringToColorConvertor}}"   HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" >
