                                            </ViewCell>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>-->
                            </StackLayout>
                        </Grid>
                    </ListView.Footer>
                    <ListView.Header >
                        <StackLayout Orientation="Vertical" Spacing="-5" Grid.Row="0" FlowDirection="RightToLeft">

                            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" >
                                <custom:CustomLabel Text="{Binding SelectedTransactionTypeFilter.Txt30, Mode=OneWay}"  Style="{StaticResource SectionTitleBlack}">
                                    <custom:CustomLabel.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="btnTransactionTypePicker_Clicked"/>
                                    </custom:CustomLabel.GestureRecognizers>
                                </custom:CustomLabel>

                                <Image Source="arrowDropdown"   Margin="0,5,0,0" 
                                HorizontalOptions="Start" VerticalOptions="Center">

                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="btnTransactionTypePicker_Clicked">
                                        </TapGestureRecognizer>
                                    </Image.GestureRecognizers>

                                </Image>
                                <!--{Binding IsDownloadBtnVisile}-->
                                <Image Source="download" IsVisible="False"  Margin="5,5,5,0" HorizontalOptions="EndAndExpand" VerticalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DownloadBtnTapped}">
                                        </TapGestureRecognizer>
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>

                            <syncfusion:SfPicker  x:Name="TransactionTypePicker"  HeaderHeight="55"
                                         HeaderText="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}"
                                         HeaderTextColor="White" ShowColumnHeader="False" ColumnHeaderHeight="46"
                                         PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black"
                                         BackgroundColor="White" SelectedItemFontSize="15" ShowFooter="False"
                                         SelectedItemFontAttribute="Bold"
                                         SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralGreay}"
                                         ItemHeight="40" DisplayMemberPath="Txt30" ItemsSource="{Binding TransactionTypeFilter}"  Grid.Row="0" Grid.Column="0"
                                         Margin="10,0,10,0" PickerHeight="250" PickerWidth="300" ShowHeader="False" OKButtonTextColor="#006450"
                                         CancelButtonTextColor="#006450" OKButtonBackgroundColor="#EAF7CC"
                                         CancelButtonBackgroundColor="#EAF7CC" SelectedItem="{Binding SelectedTransactionTypeFilter}" >
                                <syncfusion:SfPicker.Behaviors>
                                    <customcontrol:SfPickerBehavior />
                                </syncfusion:SfPicker.Behaviors>
                            </syncfusion:SfPicker>

                            <!--{Binding IsYearsChipVisible}-->
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="{Binding IsYearsChipVisible}" HorizontalOptions="Start">
                                <buttons:SfChipGroup Margin="0,10,0,0" x:Name="ChipGroup_Years" Type="Choice" HorizontalOptions="Start"   ChipBackgroundColor="Transparent"
                                         ItemsSource="{Binding ChipDataFilterlistForYears}" SelectedChipBackgroundColor="#F9F0DF"  ChipBorderColor="{StaticResource NeutralLightGrey}"
                                         ChipBorderWidth="1" VerticalOptions="Center" SelectionChanged="yearChipGroup_SelectionChanged">
                                    <buttons:SfChipGroup.ItemTemplate>
                                        <DataTemplate >
                                            <StackLayout Margin="0" Orientation="Horizontal" Spacing="2" Padding="5,-2,5,-2"  >
                                                <Image Source="{Binding ImageSource}" HorizontalOptions="Center" HeightRequest="25"></Image>
                                                <custom:CustomLabel Text="{Binding Text}" HorizontalOptions="CenterAndExpand" Style="{StaticResource CaptionLabelBlack}"/>
                                            </StackLayout>
                                        </DataTemplate>
                                    </buttons:SfChipGroup.ItemTemplate>
                                </buttons:SfChipGroup>
                            </ScrollView>
                            
                            <!--Status Chips-->

                            <Grid VerticalOptions="Start" Margin="0,10,0,0" FlowDirection="RightToLeft" HorizontalOptions="Start">
                           <listView:SfListView 
                          SelectionMode="None"
                          ItemsSource="{Binding ChipDataFilterlistForStatus}"
                               Orientation="Horizontal"
                               HeightRequest="50"
                               IsScrollBarVisible="False"
                               ItemTapped="StatusList_Tapped" ItemSpacing="5"
                               HorizontalOptions="FillAndExpand" VerticalOptions="Start" AutoFitMode="Height" SelectionBackgroundColor="Transparent">

                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <ViewCell.View>
                                                <Grid >
                                                    <Frame Grid.Row="0" 
                                                           HorizontalOptions="FillAndExpand"
                                                    BackgroundColor="{Binding Status,Converter={StaticResource StringToColorConvertor}}"
                                                    Padding="10,10,10,10" CornerRadius="14"
                                                    HeightRequest="20" Opacity=".2"
                                                     HasShadow="False"    VerticalOptions="CenterAndExpand" 
                                                     >
                                                    </Frame>
                                                    <StackLayout Grid.Row="0"  Padding="10,0,10,0">
                                                            <!--TextColor="{Binding Status,Converter={StaticResource StringToColorConvertor}}" -->
                                                            <custom:CustomLabel Style="{StaticResource CaptionLabelBlack}"
                                                                             Text="{Binding StatusDesc}" HorizontalOptions="CenterAndExpand"  
                                                                                VerticalOptions="CenterAndExpand" >
                                                            
                                                        </custom:CustomLabel>
                                                    </StackLayout>
     

        </Grid>
                                            </ViewCell.View>
                                        </ViewCell>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>
                            </Grid>
                            <!--{Binding IsSortByVisible}-->
                            <Grid x:Name="SortByStackLayout"
                            ColumnSpacing="25" RowSpacing="0" IsVisible="False" Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ScrollView Grid.Column="1" HorizontalOptions="StartAndExpand" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"  >
                                    <StackLayout Orientation="Horizontal">
                                        <buttons:SfButton x:Name="Button_TransactionTypeFilter" Clicked="Button_TransactionTypeFilter_Clicked" HorizontalTextAlignment="Start" Style="{StaticResource CaptionButtonBlack}" ImageSource="ic_unpaid" ShowIcon="True" Text="{x:Static ResourceManager:AppResources.ASTransactionDate}" BorderColor="LightGray" BorderWidth="1" CornerRadius="20"  VerticalTextAlignment="Center" BackgroundColor="White" HorizontalOptions="Start">
                                            <buttons:SfButton.Triggers>
                                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding TransactionDateFilterItem}" Value="">
                                                    <Setter Property="ImageSource" Value="" />
                                                    <Setter Property="BackgroundColor" Value="White" />
                                                    <Setter Property="ShowIcon" Value="False" />
                                                </DataTrigger>

                                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding TransactionDateFilterItem}" Value="ascending">
                                                    <Setter Property="ImageSource" Value="ArrowUp" />
                                                    <Setter Property="BackgroundColor" Value="#F9F0DF" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>

                                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding TransactionDateFilterItem}" Value="descending">
                                                    <Setter Property="ImageSource" Value="Entry_DropDown" />
                                                    <Setter Property="BackgroundColor" Value="#F9F0DF" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>
                                            </buttons:SfButton.Triggers>
                                        </buttons:SfButton>
                                        <buttons:SfButton x:Name="Button_TaxPeriodFilter" Clicked="Button_TaxPeriodFilter_Clicked" HorizontalTextAlignment="Start"  Style="{StaticResource CaptionButtonBlack}" ImageSource="ic_unpaid" ShowIcon="True" Text="{x:Static ResourceManager:AppResources.ASTaxperiod}" BorderColor="LightGray" BorderWidth="1" CornerRadius="20"  VerticalTextAlignment="Center" BackgroundColor="White" HorizontalOptions="Start">
                                            <buttons:SfButton.Triggers>
                                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding TaxperiodFilterItem}" Value="">
                                                    <Setter Property="ImageSource" Value="" />
                                                    <Setter Property="BackgroundColor" Value="White" />
                                                    <Setter Property="ShowIcon" Value="False" />

                                                </DataTrigger>

                                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding TaxperiodFilterItem}" Value="ascending">
                                                    <Setter Property="ImageSource" Value="ArrowUp" />
                                                    <Setter Property="BackgroundColor" Value="#F9F0DF" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>

                                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding TaxperiodFilterItem}" Value="descending">
                                                    <Setter Property="ImageSource" Value="Entry_DropDown" />
                                                    <Setter Property="BackgroundColor" Value="#F9F0DF" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>
                                            </buttons:SfButton.Triggers>
                                        </buttons:SfButton>
                                        <buttons:SfButton  x:Name="Button_DueDateFilter" Clicked="Button_DueDateFilter_Clicked" HorizontalTextAlignment="Start"  Style="{StaticResource CaptionButtonBlack}" ImageSource="ic_unpaid" ShowIcon="True" Text="{x:Static ResourceManager:AppResources.ASDueDate}" BorderColor="LightGray" BorderWidth="1" CornerRadius="20"  VerticalTextAlignment="Center" BackgroundColor="White" HorizontalOptions="Start">
                                            <buttons:SfButton.Triggers>
                                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding DueDateFilterItem}" Value="">
                                                    <Setter Property="ImageSource" Value="" />
                                                    <Setter Property="BackgroundColor" Value="White" />
                                                    <Setter Property="ShowIcon" Value="False" />

                                                </DataTrigger>

                                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding DueDateFilterItem}" Value="ascending">
                                                    <Setter Property="ImageSource" Value="ArrowUp" />
                                                    <Setter Property="BackgroundColor" Value="#F9F0DF" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>

                                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding DueDateFilterItem}" Value="descending">
                                                    <Setter Property="ImageSource" Value="Entry_DropDown" />
                                                    <Setter Property="BackgroundColor" Value="#F9F0DF" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>
                                            </buttons:SfButton.Triggers>
                                        </buttons:SfButton>
                                        <buttons:SfButton x:Name="Button_BillDiscriptionFilter"  Clicked="Button_BillDiscriptionFilter_Clicked" HorizontalTextAlignment="Start"  Style="{StaticResource CaptionButtonBlack}" ImageSource="ic_unpaid" ShowIcon="True" Text="{x:Static ResourceManager:AppResources.ASBillDescription}" BorderColor="LightGray" BorderWidth="1" CornerRadius="20"  VerticalTextAlignment="Center" BackgroundColor="White" HorizontalOptions="Start">
                                            <buttons:SfButton.Triggers>
                                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding BillDescriptionFilterItem}" Value="">
                                                    <Setter Property="ImageSource" Value="" />
                                                    <Setter Property="BackgroundColor" Value="White" />
                                                    <Setter Property="ShowIcon" Value="False" />

                                                </DataTrigger>

                                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding BillDescriptionFilterItem}" Value="ascending">
                                                    <Setter Property="ImageSource" Value="ArrowUp" />
                                                    <Setter Property="BackgroundColor" Value="#F9F0DF" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>

                                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding BillDescriptionFilterItem}" Value="descending">
                                                    <Setter Property="ImageSource" Value="Entry_DropDown" />
                                                    <Setter Property="BackgroundColor" Value="#F9F0DF" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>
                                            </buttons:SfButton.Triggers>
                                        </buttons:SfButton>
                                        <buttons:SfButton x:Name="Button_BillAmountFilter" Clicked="Button_BillAmountFilter_Clicked" HorizontalTextAlignment="Start"  Style="{StaticResource CaptionButtonBlack}" ImageSource="ic_unpaid" ShowIcon="True" Text="{x:Static ResourceManager:AppResources.ASBillAmount}" BorderColor="LightGray" BorderWidth="1" CornerRadius="20"  VerticalTextAlignment="Center" BackgroundColor="White" HorizontalOptions="Start">
                                            <buttons:SfButton.Triggers>
                                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding BillAmountFilterItem}" Value="">
                                                    <Setter Property="ImageSource" Value="" />
                                                    <Setter Property="BackgroundColor" Value="White" />
                                                    <Setter Property="ShowIcon" Value="False" />

                                                </DataTrigger>

                                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding BillAmountFilterItem}" Value="ascending">
                                                    <Setter Property="ImageSource" Value="ArrowUp" />
                                                    <Setter Property="BackgroundColor" Value="#F9F0DF" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>

                                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding BillAmountFilterItem}" Value="descending">
                                                    <Setter Property="ImageSource" Value="Entry_DropDown" />
                                                    <Setter Property="BackgroundColor" Value="#F9F0DF" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>
                                            </buttons:SfButton.Triggers>
                                        </buttons:SfButton>
                                    </StackLayout>
                                </ScrollView>
                                <StackLayout Grid.Column="0" BackgroundColor="White" HorizontalOptions="Start">
                                    <custom:CustomLabel HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource CaptionLabelBlack}">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.SortBy}"/>
                                                <Span Text=":"></Span>
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>
                                </StackLayout>
                            </Grid>

                            <custom:CustomLabel Text="{Binding AmountLabel}" Style="{StaticResource CaptionLabelGrey}"/>

                            <StackLayout Margin="10">
                                <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}" IsVisible="false">
                                    <StackLayout Padding="0" Spacing="0">
                                        <Grid  Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-10">
                                                <Label  Text="{x:Static ResourceManager:AppResources.TotalOpeningBalance}" VerticalOptions="CenterAndExpand" Style="{StaticResource CaptionLabelGrey}"/>
                                            </StackLayout>

                                            <yummy:PancakeView Grid.Row="0" Grid.Column="1" BackgroundColor="{StaticResource Primary}" Padding="10,10,10,10" CornerRadius="14" WidthRequest="110"  HeightRequest="20" Opacity=".2"  BorderThickness="1"  VerticalOptions="CenterAndExpand" HorizontalOptions="End" >
                                                <yummy:PancakeView.Triggers>
                                                    <DataTrigger TargetType="yummy:PancakeView" Binding="{Binding IsOpeningBalancePositive}" Value="true">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="yummy:PancakeView" Binding="{Binding IsOpeningBalancePositive}" Value="false">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}" />
                                                    </DataTrigger>
                                                </yummy:PancakeView.Triggers>
                                            </yummy:PancakeView>
                                            <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalOptions="FillAndExpand" Spacing="2"  Margin="0,0,0,0" HorizontalOptions="FillAndExpand" >
                                                <custom:CustomLabel  TextColor="{StaticResource NewDarkGreenColor}"  Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" LineBreakMode="WordWrap">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding HeaderSet.D.OpeningAmount}"></Span>
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                    <custom:CustomLabel.Triggers>
                                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IsOpeningBalancePositive}" Value="true">
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IsOpeningBalancePositive}" Value="false">
                                                            <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
                                                        </DataTrigger>
                                                    </custom:CustomLabel.Triggers>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel  TextColor="{StaticResource NewDarkGreenColor}"  Style="{StaticResource CaptionLabelBlack}"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" LineBreakMode="WordWrap">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"></Span>
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                    <custom:CustomLabel.Triggers>
                                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IsOpeningBalancePositive}" Value="true">
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IsOpeningBalancePositive}" Value="false">
                                                            <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
                                                        </DataTrigger>
                                                    </custom:CustomLabel.Triggers>
                                                </custom:CustomLabel>

                                            </StackLayout>

                                        </Grid>
                                    </StackLayout>
                                </border:SfBorder>

                                <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}" >
                                    <Grid Padding="0" >
                                        <Frame BackgroundColor="{Binding TotalBalanceBackground}" Opacity="0.2" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand"></Frame>
                                        <Grid  Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>

                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-10">
                                                <Label  Text="{x:Static ResourceManager:AppResources.AccountStatementTotalBalance}" VerticalOptions="CenterAndExpand" Style="{StaticResource BodyLabelBlack}"/>
                                            </StackLayout>
                                            <StackLayout Grid.Row="0" Grid.Column="1"  VerticalOptions="FillAndExpand"  HorizontalOptions="FillAndExpand" >


                                                <!--<custom:CustomLabel Style="{StaticResource SectionTitleBlackBold}"
                                                                            TextColor="{Binding TotalBalanceBackground}"   HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" >
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{Binding HeaderSet.D.CloseAmount,Converter={StaticResource commaSeparatorConverter}}" TextColor="{Binding TotalBalanceBackground}" Style="{StaticResource SectionTitleBlackBold}" ></Span>
                                                                    <Span Text="&#160;" Style="{StaticResource CaptionLabelBlack}" ></Span>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.ZSAR} " TextColor="{Binding TotalBalanceBackground}"  Style="{StaticResource SectionTitleBlackBold}" ></Span>
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                   </custom:CustomLabel>-->


                                                <Label Style="{StaticResource SectionTitleBlackBold}" Text="{Binding HeaderSet.D.CloseAmount}" TextColor="{Binding TotalBalanceBackground}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding StatusDesc}"  Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </StackLayout>

                                        </Grid>
                                    </Grid>
                                </border:SfBorder>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                            </StackLayout>
                            <custom:CustomLabel Text="{Binding AmountLabel}" Style="{StaticResource CaptionLabelGrey}"/>
                        </StackLayout>
                    </ListView.Header>
                </ListView>
            </StackLayout>

            <Grid Grid.Row="0" Grid.Column="0"  IsVisible="{Binding IsLoading}" Margin="0,-20,0,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#D99A29"/>
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
