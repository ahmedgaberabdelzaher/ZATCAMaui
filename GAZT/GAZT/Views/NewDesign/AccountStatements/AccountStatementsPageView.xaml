<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EGAZT.Views.NewDesign.AccountStatements.AccountStatementsPageView"
              xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"

             xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:local="clr-namespace:EGAZT.CustomControl" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             ios:Page.UseSafeArea="true"
             FlowDirection="RightToLeft"
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>

                </ResourceDictionary>
                <ResourceDictionary>
                <DataTemplate x:Key="otherDataTemplate">
                    <ViewCell>
                    <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout Padding="0" Spacing="0">
                            <Grid  Padding="15" RowSpacing="0">
                                <Grid.RowDefinitions>   
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-10">
                                    <Label  Text="{Binding Desc}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                                    <Label Text="{Binding TaxtypeDesc}" Style="{StaticResource CaptionLabelGrey}"/>
                                </StackLayout>
                                 <yummy:PancakeView Grid.Row="0" Grid.Column="1" BackgroundColor="{StaticResource Secondary}" Padding="10,10,10,10" CornerRadius="14" WidthRequest="110"  HeightRequest="20" Opacity=".2"  BorderThickness="1"  VerticalOptions="CenterAndExpand" HorizontalOptions="End" >
                                    <yummy:PancakeView.Triggers>
                                            <DataTrigger TargetType="yummy:PancakeView" Binding="{Binding Status}" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </yummy:PancakeView.Triggers>
                                 </yummy:PancakeView>
                                <StackLayout Grid.Row="0" Grid.Column="1"  VerticalOptions="FillAndExpand"  HorizontalOptions="FillAndExpand" >
                                        <Label Style="{StaticResource CaptionLabelBlack}" Text="{Binding StatusDesc}" TextColor="{StaticResource Secondary}"   HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding StatusDesc}" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                </StackLayout>
                            </Grid>
                            <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />
                            <Grid Padding="10,10,10,10" RowSpacing="15" ColumnSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-5">
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ASBillAmount}" Style="{StaticResource CaptionLabelGrey}"  HorizontalOptions="StartAndExpand"/>
                                    <custom:CustomLabel  HorizontalOptions="StartAndExpand" Text="{Binding Betrh}" VerticalOptions="CenterAndExpand" Style="{StaticResource ValueLabelBlack}" >
                                    </custom:CustomLabel>
                                </StackLayout>
                                <StackLayout Grid.Row="0" Grid.Column="1" Spacing="-5">
                                    <Label Text="{x:Static ResourceManager:AppResources.ASTransactionDate}" HorizontalOptions="StartAndExpand" Style="{StaticResource CaptionLabelGrey}"/>
                                    <Label  Style="{StaticResource ValueLabelBlack}" HorizontalOptions="StartAndExpand">
                                            <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Bldat,StringFormat='{0:dd MMM yyyy}'}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </StackLayout>
                                <StackLayout Grid.Row="1" Grid.Column="1" Spacing="-5" >
                                    <Label Text="{x:Static ResourceManager:AppResources.ASDueDate}" Style="{StaticResource CaptionLabelGrey}"  HorizontalOptions="StartAndExpand"/>
                                    <Label Style="{StaticResource ValueLabelBlack}"  HorizontalOptions="StartAndExpand">
                                       <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding PeriodEndDt,StringFormat='{0:dd MMM yyyy}'}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </StackLayout>           
                                <StackLayout Grid.Row="1" Grid.Column="0" Spacing="-5">
                                    <Label Text="{x:Static ResourceManager:AppResources.ASTaxperiod}" Style="{StaticResource CaptionLabelGrey}"  HorizontalOptions="StartAndExpand"/>
                                   
                                        <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" StyleId="SingleLabel"  HorizontalOptions="Start" HorizontalTextAlignment="Start">
                                            <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding PeriodTxt}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </custom:CustomLabel>
                                    
                                    
                                </StackLayout>
                            </Grid>

                        </StackLayout>
                    </border:SfBorder >
                    </ViewCell>
                </DataTemplate>
                <DataTemplate x:Key="totalBalances">
                    <ViewCell>
                        <StackLayout>
                           <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                             <StackLayout Padding="0" Spacing="0">
                                <Grid  Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>   
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-10">
                                        <Label  Text="Total Debit" VerticalOptions="CenterAndExpand" Style="{StaticResource CaptionLabelGrey}"/>
                                    </StackLayout>
                                    <yummy:PancakeView Grid.Row="0" Grid.Column="1" BackgroundColor="{StaticResource NewDarkGreenColor}" Padding="10,10,10,10" CornerRadius="14" WidthRequest="110"  HeightRequest="20" Opacity=".2"  BorderThickness="1"  VerticalOptions="CenterAndExpand" HorizontalOptions="End" >
                                    </yummy:PancakeView>
                                    <StackLayout Grid.Row="0" Grid.Column="1"  VerticalOptions="FillAndExpand"  HorizontalOptions="FillAndExpand" >
                                            <Label Style="{StaticResource CaptionLabelBlack}" Text="{Binding HeaderSet.D.DebitAmount}" TextColor="{StaticResource NewDarkGreenColor}"   HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding StatusDesc}" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                    </StackLayout>

                                </Grid>
                              </StackLayout>
                         </border:SfBorder>
                         <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                             <StackLayout Padding="0" Spacing="0">
                                <Grid  Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>   
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-10">
                                        <Label  Text="Total Credit" VerticalOptions="CenterAndExpand" Style="{StaticResource CaptionLabelGrey}"/>
                                    </StackLayout>
                                    <yummy:PancakeView Grid.Row="0" Grid.Column="1" BackgroundColor="{StaticResource ErrorColor}" Padding="10,10,10,10" CornerRadius="14" WidthRequest="110"  HeightRequest="20" Opacity=".2"  BorderThickness="1"  VerticalOptions="CenterAndExpand" HorizontalOptions="End" >
                                    <yummy:PancakeView.Triggers>
                                            <DataTrigger TargetType="yummy:PancakeView" Binding="{Binding Status}" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </yummy:PancakeView.Triggers>
                                    </yummy:PancakeView>
                                    <StackLayout Grid.Row="0" Grid.Column="1"  VerticalOptions="FillAndExpand"  HorizontalOptions="FillAndExpand" >
                                    <Label Style="{StaticResource CaptionLabelBlack}" Text="{Binding HeaderSet.D.CreditAmount}" TextColor="{StaticResource ErrorColor}"   HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding StatusDesc}" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    </StackLayout>

                                </Grid>
                              </StackLayout>
                         </border:SfBorder>
                       <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                             <StackLayout Padding="0" Spacing="0">
                                <Grid  Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>   
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-10">
                                        <Label  Text="Total Balance" VerticalOptions="CenterAndExpand" Style="{StaticResource BodyLabelBlack}"/>
                                    </StackLayout>
                                    <StackLayout Grid.Row="0" Grid.Column="1"  VerticalOptions="FillAndExpand"  HorizontalOptions="FillAndExpand" >
                                    <Label Style="{StaticResource SectionTitleBlackBold}" Text="{Binding HeaderSet.D.Close}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding StatusDesc}" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    </StackLayout>

                                </Grid>
                              </StackLayout>
                         </border:SfBorder>
                        </StackLayout>

                    </ViewCell>
                </DataTemplate>
                <local:AccountStatementsLVDataTemplateSelector x:Key="lvDataTemplateSelector"
                    TotalBalanceTemplate="{StaticResource totalBalances}"
                   />
                     <!--OtherDataTemplate="{StaticResource otherDataTemplate}"-->
        </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>

                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.ASAccountStatementDashboardTileText}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand" Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}"/>
                            </Image.GestureRecognizers>
                        </Image>

                        <StackLayout Spacing="15" Orientation="Horizontal" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Grid.Row="0" Grid.Column="2">
                            <Image Source="search" IsVisible="{TemplateBinding BindingContext.IsSearchButtonVisible}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="searchButtonTapped"/>
                                </Image.GestureRecognizers>
                            </Image>
                            <Image Source="close" IsVisible="{TemplateBinding BindingContext.IsCloseButtonVisible}">
                                <Image.GestureRecognizers>
                                   <TapGestureRecognizer Tapped="CloseSearchButton_Tapped">

                                   </TapGestureRecognizer>
                               </Image.GestureRecognizers>
                            </Image>
                            <Image Source="filter">
                                 <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="filterButtonTapped"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                        <SearchBar Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" BackgroundColor="White" custom:RoundCornersEffect.CornerRadius="12" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0" TextChanged="SearchBar_TextChanged" IsVisible="{TemplateBinding BindingContext.IsCloseButtonVisible}">
                        </SearchBar>
                    </Grid>

                    <yummy:PancakeView  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" Padding="0,15,0,0" BackgroundColor="White" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Grid.Column="0" Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
<Grid>
   
        <StackLayout Padding="15" Orientation="Vertical">
            <!--<Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>-->
            
            <ListView x:Name="LvwContacts"
                      Margin="5"   
                      SeparatorVisibility="None"
                      IsGroupingEnabled="True"
                      BackgroundColor="White"
                      VerticalScrollBarVisibility="Never"
                      GroupDisplayBinding="{Binding Key}"        
                      ItemsSource="{Binding GroupedData}"  
                     
                      HasUnevenRows="True">  
                <ListView.ItemTemplate>  
                    <DataTemplate>
                        <ViewCell>
                            <ViewCell.View>
                                <StackLayout>

                        <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout Padding="0" Spacing="0">
                            <Grid  Padding="15" RowSpacing="0">
                                <Grid.RowDefinitions>   
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-10">
                                    <Label  Text="{Binding Desc}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleSmallMediumBlack}"/>
                                    <Label Text="{Binding TaxtypeDesc}" Style="{StaticResource CaptionLabelGrey}"/>
                                </StackLayout>
                                 <yummy:PancakeView Grid.Row="0" Grid.Column="1" BackgroundColor="{StaticResource Secondary}" Padding="10,10,10,10" CornerRadius="14" WidthRequest="110"  HeightRequest="20" Opacity=".2"  BorderThickness="1"  VerticalOptions="CenterAndExpand" HorizontalOptions="End" >
                                    <yummy:PancakeView.Triggers>
                                             <DataTrigger TargetType="yummy:PancakeView" Binding="{Binding Status}" Value="1">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="yummy:PancakeView" Binding="{Binding Status}" Value="2">
                                                <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}" />
                                            </DataTrigger>
                                        </yummy:PancakeView.Triggers>
                                 </yummy:PancakeView>
                                <StackLayout Grid.Row="0" Grid.Column="1"  VerticalOptions="FillAndExpand"  HorizontalOptions="FillAndExpand" >
                                        <Label Style="{StaticResource CaptionLabelBlack}" Text="{Binding StatusDesc}" TextColor="{StaticResource Secondary}"   HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                            <Label.Triggers>
                                                 <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="1">
                                                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                                 <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="2">
                                                    <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                </StackLayout>
                            </Grid>
                            <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />
                            <Grid Padding="10,10,10,10" RowSpacing="15" ColumnSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-5">
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ASBillAmount}" Style="{StaticResource CaptionLabelGrey}"  HorizontalOptions="StartAndExpand"/>

                                    <StackLayout Orientation="Horizontal" VerticalOptions="FillAndExpand" Spacing="2"  Margin="0,0,0,0" HorizontalOptions="StartAndExpand" >
                                            <custom:CustomLabel FlowDirection="LeftToRight" Style="{StaticResource ValueLabelBlack}"
                                                                 HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" LineBreakMode="WordWrap">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding BetrhAmount}"></Span>
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>

                                            <custom:CustomLabel  Style="{StaticResource ValueLabelBlack}"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" LineBreakMode="WordWrap">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"></Span>
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                    </StackLayout>

                                    <!--<custom:CustomLabel  HorizontalOptions="StartAndExpand" Text="{Binding BetrhAmount}" VerticalOptions="CenterAndExpand" Style="{StaticResource ValueLabelBlack}" >
                                    </custom:CustomLabel>-->
                                </StackLayout>
                                <StackLayout Grid.Row="0" Grid.Column="1" Spacing="-5">
                                    <Label Text="{x:Static ResourceManager:AppResources.ASTransactionDate}" HorizontalOptions="StartAndExpand" Style="{StaticResource CaptionLabelGrey}"/>
                                    <Label  Style="{StaticResource ValueLabelBlack}" HorizontalOptions="StartAndExpand">
                                            <Label.FormattedText>
                                            <FormattedString>
                                                <!--<Span Text="{Binding Bldat,StringFormat='{0:dd MMM yyyy}'}"/>-->
                                                      <Span Text="{Binding FormattedBldat}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </StackLayout>
                                <StackLayout Grid.Row="1" Grid.Column="1" Spacing="-5" >
                                    <Label Text="{x:Static ResourceManager:AppResources.ASDueDate}" Style="{StaticResource CaptionLabelGrey}"  HorizontalOptions="StartAndExpand"/>
                                    <Label Style="{StaticResource ValueLabelBlack}"  HorizontalOptions="StartAndExpand">
                                       <Label.FormattedText>
                                            <FormattedString>
                                                <!--<Span Text="{Binding PeriodEndDt,StringFormat='{0:dd MMM yyyy}'}"/>-->
                                                 <Span Text="{Binding FormattedBldat2}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </StackLayout>           
                                <StackLayout Grid.Row="1" Grid.Column="0" Spacing="-5">
                                    <Label Text="{x:Static ResourceManager:AppResources.ASTaxperiod}" Style="{StaticResource CaptionLabelGrey}"  HorizontalOptions="StartAndExpand"/>
                                   
                                        <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" StyleId="SingleLabel"  HorizontalOptions="Start" HorizontalTextAlignment="Start">
                                            <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding PeriodTxt}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </custom:CustomLabel>
                                    
                                    
                                </StackLayout>
                            </Grid>

                        </StackLayout>
                    </border:SfBorder >
                        </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                    </DataTemplate>  
                </ListView.ItemTemplate>
                  <ListView.GroupHeaderTemplate>
                      <DataTemplate>
                          <ViewCell>
                              <ViewCell.View>
                                  <Grid>
                                      <custom:CustomLabel Text="{Binding Key}"  Style="{StaticResource SectionTitleBlack}">
                          
                                      </custom:CustomLabel>

                                  </Grid>
                              </ViewCell.View>
                          </ViewCell>
                      </DataTemplate>
                  </ListView.GroupHeaderTemplate>
                <ListView.Footer>

                    <Grid>
                     <ListView Margin="5"  IsVisible="{Binding IsNormalStatementsViewVisible}" 
                  SeparatorVisibility="None"
                  VerticalScrollBarVisibility="Never"
                  ItemsSource="{Binding StatementsLineItems}"  
                  HasUnevenRows="True">  
                <ListView.ItemTemplate>  
                    <DataTemplate>
                        <ViewCell>
                            <ViewCell.View>
                                <StackLayout>

                        <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout Padding="0" Spacing="0">
                            <Grid  Padding="15" RowSpacing="0">
                                <Grid.RowDefinitions>   
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-10">
                                    <Label  Text="{Binding Desc}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleSmallMediumBlack}"/>
                                    <Label Text="{Binding TaxtypeDesc}" Style="{StaticResource CaptionLabelGrey}"/>
                                </StackLayout>
                                 <yummy:PancakeView Grid.Row="0" Grid.Column="1" BackgroundColor="{StaticResource Secondary}" Padding="10,10,10,10" CornerRadius="14" WidthRequest="110"  HeightRequest="20" Opacity=".2"  BorderThickness="1"  VerticalOptions="CenterAndExpand" HorizontalOptions="End" >
                                    <yummy:PancakeView.Triggers>
                                             <DataTrigger TargetType="yummy:PancakeView" Binding="{Binding Status}" Value="1">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="yummy:PancakeView" Binding="{Binding Status}" Value="2">
                                                <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}" />
                                            </DataTrigger>
                                        </yummy:PancakeView.Triggers>
                                 </yummy:PancakeView>
                                <StackLayout Grid.Row="0" Grid.Column="1"  VerticalOptions="FillAndExpand"  HorizontalOptions="FillAndExpand" >
                                        <Label Style="{StaticResource CaptionLabelBlack}" Text="{Binding StatusDesc}" TextColor="{StaticResource Secondary}"   HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                            <Label.Triggers>
                                                 <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="1">
                                                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                                 <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="2">
                                                    <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                </StackLayout>
                            </Grid>
                            <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />
                            <Grid Padding="10,10,10,10" RowSpacing="15" ColumnSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-5">
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ASBillAmount}" Style="{StaticResource CaptionLabelGrey}"  HorizontalOptions="StartAndExpand"/>

                                    <StackLayout Orientation="Horizontal" VerticalOptions="FillAndExpand" Spacing="2"  Margin="0,0,0,0" HorizontalOptions="StartAndExpand" >
                                            <custom:CustomLabel FlowDirection="LeftToRight" Style="{StaticResource ValueLabelBlack}"
                                                                 HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" LineBreakMode="WordWrap">
