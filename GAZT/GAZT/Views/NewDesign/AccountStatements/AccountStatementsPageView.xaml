<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.AccountStatements.AccountStatementsPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:local="clr-namespace:EGAZT.CustomControl"
    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:StringToColorConvertor x:Key="StringToColorConvertor" />
            <local:IntToBoolConverter x:Key="IntToBoolConverter" />
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>

                </ResourceDictionary>
                <ResourceDictionary>

                    <DataTemplate x:Key="otherDataTemplate">
                        <ViewCell>
                            <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0" Spacing="0">
                                    <Grid Padding="15" RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Spacing="-10">
                                            <Label
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{Binding Desc}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{Binding TaxtypeDesc}" />
                                        </StackLayout>
                                        <yummy:PancakeView
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Padding="10,10,10,10"
                                            BackgroundColor="{StaticResource Secondary}"
                                            CornerRadius="14"
                                            HeightRequest="20"
                                            HorizontalOptions="End"
                                            Opacity=".2"
                                            VerticalOptions="CenterAndExpand"
                                            WidthRequest="110">
                                            <yummy:PancakeView.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding Status}"
                                                    TargetType="yummy:PancakeView"
                                                    Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </yummy:PancakeView.Triggers>
                                            <yummy:PancakeView.Border>
                                                <yummy:Border Thickness="1" />
                                            </yummy:PancakeView.Border>
                                        </yummy:PancakeView>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Label
                                                HorizontalOptions="CenterAndExpand"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{Binding StatusDesc}"
                                                TextColor="{StaticResource Secondary}"
                                                VerticalOptions="CenterAndExpand">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding StatusDesc}"
                                                        TargetType="Label"
                                                        Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </StackLayout>
                                    </Grid>
                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />
                                    <Grid
                                        Padding="10,10,10,10"
                                        ColumnSpacing="5"
                                        RowSpacing="15">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Spacing="-5">
                                            <custom:CustomLabel
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ASBillAmount}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding Betrh}"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Spacing="-5">
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ASTransactionDate}" />
                                            <Label HorizontalOptions="StartAndExpand" Style="{StaticResource ValueLabelBlack}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Bldat, StringFormat='{0:dd MMM yyyy}'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Spacing="-5">
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ASDueDate}" />
                                            <Label HorizontalOptions="StartAndExpand" Style="{StaticResource ValueLabelBlack}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding PeriodEndDt, StringFormat='{0:dd MMM yyyy}'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Spacing="-5">
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ASTaxperiod}" />

                                            <custom:CustomLabel
                                                HorizontalOptions="Start"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="SingleLabel">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding PeriodTxt}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </custom:CustomLabel>
                                        </StackLayout>
                                    </Grid>
                                </StackLayout>
                            </border:SfBorder>
                        </ViewCell>
                    </DataTemplate>
                    <DataTemplate x:Key="totalBalances">
                        <ViewCell>
                            <StackLayout>
                                <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0" Spacing="0">
                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="-10">
                                                <Label
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ASAccountStatementTotalDebit}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <yummy:PancakeView
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="10,10,10,10"
                                                BackgroundColor="{StaticResource NewDarkGreenColor}"
                                                CornerRadius="14"
                                                HeightRequest="20"
                                                HorizontalOptions="End"
                                                Opacity=".2"
                                                VerticalOptions="CenterAndExpand"
                                                WidthRequest="110">
                                                <yummy:PancakeView.Border>
                                                    <yummy:Border Thickness="1" />
                                                </yummy:PancakeView.Border>
                                            </yummy:PancakeView>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="CenterAndExpand"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{Binding HeaderSet.D.DebitAmount}"
                                                    TextColor="{StaticResource NewDarkGreenColor}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding StatusDesc}"
                                                            TargetType="Label"
                                                            Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </StackLayout>
                                        </Grid>
                                    </StackLayout>
                                </border:SfBorder>
                                <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0" Spacing="0">
                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="-10">
                                                <Label
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ASAccountStatementTotalCredit}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <yummy:PancakeView
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="10,10,10,10"
                                                BackgroundColor="{StaticResource ErrorColor}"
                                                CornerRadius="14"
                                                HeightRequest="20"
                                                HorizontalOptions="End"
                                                Opacity=".2"
                                                VerticalOptions="CenterAndExpand"
                                                WidthRequest="110">
                                                <yummy:PancakeView.Border>
                                                    <yummy:Border Thickness="1" />
                                                </yummy:PancakeView.Border>
                                                <yummy:PancakeView.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding Status}"
                                                        TargetType="yummy:PancakeView"
                                                        Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                </yummy:PancakeView.Triggers>
                                            </yummy:PancakeView>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="CenterAndExpand"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{Binding HeaderSet.D.CreditAmount}"
                                                    TextColor="{StaticResource ErrorColor}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding StatusDesc}"
                                                            TargetType="Label"
                                                            Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </StackLayout>
                                        </Grid>
                                    </StackLayout>
                                </border:SfBorder>
                                <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0" Spacing="0">
                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="-10">
                                                <Label
                                                    Style="{StaticResource BodyLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.AccountStatementTotalBalance}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="CenterAndExpand"
                                                    IsVisible="{Binding IsTotalAmountVisible}"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{Binding HeaderSet.D.Close}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding StatusDesc}"
                                                            TargetType="Label"
                                                            Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </StackLayout>
                                        </Grid>
                                    </StackLayout>
                                </border:SfBorder>
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                    <local:AccountStatementsLVDataTemplateSelector x:Key="lvDataTemplateSelector" TotalBalanceTemplate="{StaticResource totalBalances}" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>
                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.ASAccountStatementDashboardTileText}" />
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="24"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding IsBackStepButtonVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="2"
                            HorizontalOptions="EndAndExpand"
                            Orientation="Horizontal"
                            Spacing="15"
                            VerticalOptions="CenterAndExpand">
                            <Image
                                HeightRequest="20"
                                IsVisible="{TemplateBinding BindingContext.IsSearchButtonVisible}"
                                Source="search"
                                WidthRequest="20">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="searchButtonTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Image
                                HeightRequest="20"
                                Source="filter"
                                WidthRequest="20">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="filterButtonTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                        <StackLayout
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            HorizontalOptions="FillAndExpand"
                            Orientation="Horizontal"
                            VerticalOptions="FillAndExpand">

                            <Grid HorizontalOptions="FillAndExpand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SearchBar
                                    Grid.Column="0"
                                    Margin="0"
                                    custom:RoundCornersEffect.CornerRadius="12"
                                    BackgroundColor="White"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{TemplateBinding BindingContext.IsCloseButtonVisible}"
                                    TextChanged="SearchBar_TextChanged"
                                    VerticalOptions="FillAndExpand" />
                                <Image
                                    Grid.Column="1"
                                    HeightRequest="24"
                                    IsVisible="{TemplateBinding BindingContext.IsCloseButtonVisible}"
                                    Source="close"
                                    WidthRequest="24">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="CloseSearchButton_Tapped" />
                                    </Image.GestureRecognizers>
                                </Image>

                            </Grid>
                        </StackLayout>
                    </Grid>
                    <yummy:PancakeView
                        Padding="0"
                        CornerRadius="14,14,0,0"
                        VerticalOptions="FillAndExpand">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,15,0,0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>

            <StackLayout Padding="15" Orientation="Vertical">
                <ListView
                    x:Name="LvwContacts"
                    Margin="5"
                    BackgroundColor="White"
                    HasUnevenRows="True"
                    IsGroupingEnabled="True"
                    ItemTapped="LvwContacts_ItemTapped"
                    ItemsSource="{Binding GroupedData}"
                    SelectionMode="None"
                    SeparatorVisibility="None"
                    VerticalScrollBarVisibility="Never">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <ViewCell.View>
                                    <StackLayout>
                                        <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                            <StackLayout Padding="0" Spacing="0">
                                                <Grid Padding="15" RowSpacing="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Spacing="-10">
                                                        <Label
                                                            Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                            Text="{Binding Desc}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            Margin="0,5,0,0"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{Binding FormattedBldat}" />
                                                    </StackLayout>




                                                    <Frame
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Padding="10,10,10,10"
                                                        BackgroundColor="{Binding Status, Converter={StaticResource StringToColorConvertor}}"
                                                        CornerRadius="14"
                                                        HasShadow="False"
                                                        HeightRequest="20"
                                                        HorizontalOptions="FillAndExpand"
                                                        Opacity=".2"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Padding="10,0,10,0"
                                                        HorizontalOptions="FillAndExpand"
                                                        VerticalOptions="FillAndExpand">
                                                        <!--<Label Style="{StaticResource CaptionLabelBlack}" Text="{Binding Betrh}"
                                               TextColor="{Binding Status,Converter={StaticResource StringToColorConvertor}}"   HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                                        </Label>-->



                                                        <custom:CustomLabel
                                                            HorizontalOptions="CenterAndExpand"
                                                            Style="{StaticResource CaptionLabelBlack}"
                                                            TextColor="{Binding Status, Converter={StaticResource StringToColorConvertor}}"
                                                            VerticalOptions="CenterAndExpand">
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span
                                                                        Style="{StaticResource CaptionLabelBlack}"
                                                                        Text="{Binding Betrh, Converter={StaticResource commaSeparatorConverter}}"
                                                                        TextColor="{Binding Status, Converter={StaticResource StringToColorConvertor}}" />
                                                                    <Span Style="{StaticResource CaptionLabelBlack}" Text="&#160;" />
                                                                    <Span
                                                                        Style="{StaticResource CaptionLabelBlack}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZSAR}"
                                                                        TextColor="{Binding Status, Converter={StaticResource StringToColorConvertor}}" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                    </StackLayout>
                                                </Grid>

                                            </StackLayout>
                                        </border:SfBorder>
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.GroupHeaderTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <ViewCell.View>

                                    <custom:CustomLabel Style="{StaticResource SectionTitleBlack}" Text="{Binding Key}" />

                                </ViewCell.View>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.GroupHeaderTemplate>
                    <ListView.Footer>
                        <Grid>
                            <StackLayout Orientation="Vertical">
                                <StackLayout IsVisible="{Binding IsNotHaveStatements}">
                                    <custom:CustomLabel
                                        Margin="0,50,0,0"
                                        HorizontalOptions="Center"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ASNoFinancialTransactions}"
                                        VerticalOptions="Center" />
                                </StackLayout>
                                <!--<ListView Margin="5"   IsVisible="{Binding IsNormalStatementsViewVisible}"
                                          SeparatorVisibility="None"
                                          VerticalScrollBarVisibility="Never"
                                          SelectionMode="None"
                                          ItemTapped="LVNormalStatements_ItemTapped"
                                          ItemsSource="{Binding StatementsLineItems}"
                                          HasUnevenRows="True" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <ViewCell.View>
                                                    <StackLayout>
                                                        <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                                            <StackLayout Padding="0" Spacing="0">
                                                                <Grid  Padding="15" RowSpacing="0">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="auto"/>
                                                                        <RowDefinition Height="auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-10">
                                                                        <Label  Text="{Binding Desc}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleSmallMediumBlack}"/>
                                                                        <Label Text="{Binding FormattedBldat}" Style="{StaticResource CaptionLabelGrey}"/>
                                                                    </StackLayout>
                                                                    <Frame Grid.Row="0" Grid.Column="1"
                                                                            BackgroundColor="{Binding Status,Converter={StaticResource StringToColorConvertor}}"
                                                                            Padding="10,10,10,10" CornerRadius="14" WidthRequest="110"
                                                                            HeightRequest="20" Opacity=".2"
                                                                            HasShadow="False"
                                                                            VerticalOptions="CenterAndExpand" HorizontalOptions="End" />
                                                                    <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalOptions="FillAndExpand"  HorizontalOptions="CenterAndExpand" >
                                                                        ~1~
                                                                        <Label Style="{StaticResource CaptionLabelBlack}" Text="{Binding Betrh}"
                                                                                TextColor="{Binding Status,Converter={StaticResource StringToColorConvertor}}"  HorizontalOptions="Center" VerticalOptions="CenterAndExpand">
                                                                        </Label>
                                                                                @1@
                                                                        <custom:CustomLabel Style="{StaticResource CaptionLabelBlack}"
                                                                            TextColor="{Binding Status,Converter={StaticResource StringToColorConvertor}}"   HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" >
                                                                            <custom:CustomLabel.FormattedText>
                                                                                <FormattedString>
                                                                                    <Span Text="{Binding Betrh,Converter={StaticResource commaSeparatorConverter}}" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                                                    <Span Text="&#160;" Style="{StaticResource ValueLabelBlack}" ></Span>
