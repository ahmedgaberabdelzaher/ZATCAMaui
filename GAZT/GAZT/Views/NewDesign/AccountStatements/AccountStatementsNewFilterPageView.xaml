<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="EGAZT.Views.NewDesign.AccountStatements.AccountStatementsNewFilterPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards1="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:custom1="clr-namespace:GAZT.CustomControl"
    xmlns:custom2="clr-namespace:EGAZT"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:local="clr-namespace:EGAZT"
    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>

                    <Style x:Key="FilterArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="FilterArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>



    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        CornerRadius="15,15,0,0">
                        <Grid
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Grid.Row="0" Padding="24,10,24,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.AccountStatementsFilterTitle}" />

                        <Image
                            Grid.Row="0"
                            Grid.Column="2"
                            HeightRequest="24"
                            HorizontalOptions="EndAndExpand"
                            Source="close"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.FilterCloseClick}" />
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <Grid>
            <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                <Grid
                    Margin="20,10,20,0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>



                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalOptions="FillAndExpand">
                        <custom:CustomLabel
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.TransactionAmount}" />
                        <border:SfBorder
                            BorderColor="#B1B1B1"
                            BorderWidth="1"
                            Style="{StaticResource GreyBorderFrame}">

                            <StackLayout
                                Padding="5,8,5,8"
                                HorizontalOptions="FillAndExpand"
                                Orientation="Horizontal">

                                <Grid HorizontalOptions="FillAndExpand">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <custom:BorderlessEntry
                                        x:Name="TxFromAmountEntry"
                                        Grid.Column="0"
                                        Keyboard="Numeric"
                                        Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementFrom}"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding FromAmount}"
                                        TextChanged="From_Amount_Changed"
                                        Unfocused="From_Amount_Unfocused" />





                                    <StackLayout
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        Orientation="Horizontal">


                                        <Image
                                            Margin="5,0"
                                            HeightRequest="24"
                                            HorizontalOptions="Center"
                                            Source="arrowRight"
                                            Style="{DynamicResource FilterArrow}"
                                            WidthRequest="24" />

                                    </StackLayout>

                                    <custom:BorderlessEntry
                                        x:Name="TxToAmountEntry"
                                        Grid.Column="2"
                                        Keyboard="Numeric"
                                        Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementTo}"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding ToAmount}"
                                        TextChanged="To_Amount_Changed"
                                        Unfocused="To_Amount_Unfocused" />


                                </Grid>
                            </StackLayout>

                        </border:SfBorder>
                    </StackLayout>

                    <StackLayout
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalOptions="FillAndExpand">
                        <custom:CustomLabel
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.ASDueDate}" />
                        <border:SfBorder
                            BorderColor="#B1B1B1"
                            BorderWidth="1"
                            Style="{StaticResource GreyBorderFrame}">

                            <StackLayout
                                Padding="5,8,5,8"
                                HorizontalOptions="FillAndExpand"
                                Orientation="Horizontal">


                                <Grid HorizontalOptions="FillAndExpand">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>


                                    <StackLayout
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">


                                        <custom:BorderlessEntry
                                            HorizontalOptions="FillAndExpand"
                                            IsEnabled="False"
                                            Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementFrom}"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding TxFromDate, StringFormat='{0:dd MMM yyyy}'}" />


                                        <StackLayout HorizontalOptions="End" Orientation="Horizontal">
                                            <Image Margin="5,0">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                        Size="24"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>
                                            </Image>

                                        </StackLayout>
                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TSDateStartDateClicked" />
                                        </StackLayout.GestureRecognizers>


                                    </StackLayout>
                                    <StackLayout
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">
                                        <Image
                                            Margin="5,0"
                                            HeightRequest="24"
                                            HorizontalOptions="Center"
                                            Source="arrowRight"
                                            Style="{DynamicResource FilterArrow}"
                                            WidthRequest="24" />

                                    </StackLayout>

                                    <StackLayout
                                        Grid.Column="2"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">

                                        <custom:BorderlessEntry
                                            HorizontalOptions="FillAndExpand"
                                            IsEnabled="False"
                                            Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementTo}"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding TxToDate, StringFormat='{0:dd MMM yyyy}'}" />
                                        <StackLayout HorizontalOptions="End" Orientation="Horizontal">
                                            <Image Margin="5,0">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                        Size="24"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>
                                            </Image>

                                        </StackLayout>

                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TSDateEndDateClicked" />
                                        </StackLayout.GestureRecognizers>

                                    </StackLayout>
                                </Grid>
                            </StackLayout>
                        </border:SfBorder>
                    </StackLayout>
                    <custom1:CustomDatePicker
                        x:Name="TxDateNormalCalendar"
                        Margin="2"
                        BackgroundColor="White"
                        BorderColor="Black"
                        CancelButtonBackgroundColor="White"
                        CancelButtonClicked="TxDateNormalCalendar_CancelButtonClicked"
                        CancelButtonTextColor="{StaticResource PrimaryColor}"
                        Closed="TxDateNormalCalendar_Closed"
                        ColumnHeaderBackgroundColor="White"
                        ColumnHeaderHeight="46"
                        FlowDirection="LeftToRight"
                        HeaderBackgroundColor="{StaticResource SecondaryNew}"
                        HeaderText="{x:Static ResourceManager:AppResources.VRStartDate}"
                        HorizontalOptions="FillAndExpand"
                        ItemHeight="36"
                        OKButtonBackgroundColor="White"
                        OKButtonTextColor="{StaticResource PrimaryColor}"
                        OkButtonClicked="TxDateNormalCalendar_OkButtonClicked"
                        PickerMode="Dialog"
                        SelectedItem="{Binding TodayDateNormal}"
                        SelectedItemFontSize="15"
                        SelectedItemTextColor="{StaticResource NeutralBlack}"
                        SelectionChanged="TxDateNormalCalendar_SelectionChanged"
                        ShowColumnHeader="True"
                        ShowFooter="True"
                        ShowHeader="False"
                        Style="{StaticResource PickerStyle}">

                        <custom1:CustomDatePicker.Behaviors>
                            <custom1:SfPickerBehavior />
                        </custom1:CustomDatePicker.Behaviors>
                    </custom1:CustomDatePicker>

                    <!--  HijriDatePicker  -->

                    <custom1:CustomHijriDatePicker
                        x:Name="TxDateHijriCalendar"
                        Margin="2"
                        BackgroundColor="White"
                        BorderColor="Black"
                        CancelButtonBackgroundColor="White"
                        CancelButtonClicked="TxDateNormalCalendar_CancelButtonClicked"
                        CancelButtonTextColor="{StaticResource PrimaryColor}"
                        Closed="TxDateNormalCalendar_Closed"
                        ColumnHeaderBackgroundColor="White"
                        ColumnHeaderHeight="46"
                        FlowDirection="LeftToRight"
                        HeaderBackgroundColor="{StaticResource SecondaryNew}"
                        HeaderText="{x:Static ResourceManager:AppResources.VREndDate}"
                        HorizontalOptions="FillAndExpand"
                        ItemHeight="36"
                        OKButtonBackgroundColor="White"
                        OKButtonTextColor="{StaticResource PrimaryColor}"
                        OkButtonClicked="TxDateNormalCalendar_OkButtonClicked"
                        PickerMode="Dialog"
                        SelectedItem="{Binding TodayDateinHijri}"
                        SelectedItemFontSize="15"
                        SelectedItemTextColor="{StaticResource NeutralBlack}"
                        SelectionChanged="TxDateNormalCalendar_SelectionChanged"
                        ShowColumnHeader="True"
                        ShowFooter="True"
                        ShowHeader="False"
                        Style="{StaticResource PickerStyle}" />
                    <StackLayout
                        Grid.Row="2"
                        Grid.Column="0"
                        HorizontalOptions="FillAndExpand">
                        <custom:CustomLabel
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.ASTaxperiod}" />
                        <border:SfBorder
                            BorderColor="#B1B1B1"
                            BorderWidth="1"
                            Style="{StaticResource GreyBorderFrame}">

                            <StackLayout Padding="5,8,5,8" Orientation="Horizontal">

                                <Grid HorizontalOptions="FillAndExpand">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>


                                    <StackLayout
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">


                                        <custom:BorderlessEntry
                                            HorizontalOptions="FillAndExpand"
                                            IsEnabled="False"
                                            Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementFrom}"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding TPFromDate, StringFormat='{0:dd MMM yyyy}'}" />

                                        <StackLayout HorizontalOptions="End" Orientation="Horizontal">
                                            <Image Margin="5,0">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                        Size="24"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>
                                            </Image>
                                        </StackLayout>
                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TaxPeriodStartDateClicked" />
                                        </StackLayout.GestureRecognizers>

                                    </StackLayout>

                                    <StackLayout
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">
                                        <Image
                                            Margin="5,0"
                                            HeightRequest="24"
                                            HorizontalOptions="Center"
                                            Source="arrowRight"
                                            Style="{DynamicResource FilterArrow}"
                                            WidthRequest="24" />

                                    </StackLayout>

                                    <StackLayout
                                        Grid.Column="2"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">

                                        <custom:BorderlessEntry
                                            HorizontalOptions="FillAndExpand"
                                            IsEnabled="False"
                                            Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementTo}"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding TPToDate, StringFormat='{0:dd MMM yyyy}'}" />
                                        <StackLayout HorizontalOptions="End" Orientation="Horizontal">
                                            <Image Margin="5,0">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                        Size="24"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>
                                            </Image>

                                        </StackLayout>

                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer x:Name="EndDate" Tapped="TaxPeriodEndDateClicked" />
                                        </StackLayout.GestureRecognizers>

                                    </StackLayout>
                                </Grid>
                            </StackLayout>
                        </border:SfBorder>
                    </StackLayout>
                    <custom1:CustomDatePicker
                        x:Name="TaxPeriodDateNormalCalendar"
                        Margin="2"
                        BackgroundColor="White"
                        BorderColor="Black"
                        CancelButtonBackgroundColor="White"
                        CancelButtonTextColor="{StaticResource PrimaryColor}"
                        ColumnHeaderBackgroundColor="White"
                        ColumnHeaderHeight="46"
                        FlowDirection="LeftToRight"
                        HeaderBackgroundColor="{StaticResource SecondaryNew}"
                        HeaderText="{x:Static ResourceManager:AppResources.VRStartDate}"
                        HorizontalOptions="FillAndExpand"
                        ItemHeight="36"
                        OKButtonBackgroundColor="White"
                        OKButtonTextColor="{StaticResource PrimaryColor}"
                        PickerMode="Dialog"
                        SelectedItem="{Binding TodayDateNormal}"
                        SelectedItemFontSize="15"
                        SelectedItemTextColor="{StaticResource NeutralBlack}"
                        SelectionChanged="TaxPeriodDateNormalCalendar_SelectionChanged"
                        ShowColumnHeader="True"
                        ShowFooter="True"
                        ShowHeader="False"
                        Style="{StaticResource PickerStyle}">

                        <custom1:CustomDatePicker.Behaviors>
                            <custom1:SfPickerBehavior />
                        </custom1:CustomDatePicker.Behaviors>
                    </custom1:CustomDatePicker>

                    <!--  HijriDatePicker  -->

                    <custom1:CustomHijriDatePicker
                        x:Name="TaxPeriodDateHijriCalendar"
                        Margin="2"
                        BackgroundColor="White"
                        BorderColor="Black"
                        CancelButtonBackgroundColor="White"
                        CancelButtonTextColor="{StaticResource PrimaryColor}"
                        ColumnHeaderBackgroundColor="White"
                        ColumnHeaderHeight="46"
                        FlowDirection="LeftToRight"
                        HeaderBackgroundColor="{StaticResource SecondaryNew}"
                        HeaderText="{x:Static ResourceManager:AppResources.VREndDate}"
                        HorizontalOptions="FillAndExpand"
                        ItemHeight="36"
                        OKButtonBackgroundColor="White"
                        OKButtonTextColor="{StaticResource PrimaryColor}"
                        PickerMode="Dialog"
                        SelectedItem="{Binding TodayDateinHijri}"
                        SelectedItemFontSize="15"
                        SelectedItemTextColor="{StaticResource NeutralBlack}"
                        SelectionChanged="TaxPeriodDateNormalCalendar_SelectionChanged"
                        ShowColumnHeader="True"
                        ShowFooter="True"
                        ShowHeader="False"
                        Style="{StaticResource PickerStyle}" />

                    <buttons:SfButton
                        x:Name="btnReasonContinue"
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,60,0,60"
                        Command="{Binding FilterBtnCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.ACFilterApply}"
                        VerticalOptions="End" />
                </Grid>

            </ScrollView>
            <!--  {Binding IsLoading}  -->
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,-20,0,0"
                HorizontalOptions="FillAndExpand"
                IsVisible="False"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="True"
                            TextColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>

    </ContentPage.Content>
</ContentPage>