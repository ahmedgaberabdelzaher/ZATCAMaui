<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
			 xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
			 xmlns:custom="clr-namespace:GAZT"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
			 xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
			 x:Class="EGAZT.Views.NewDesign.ForgotPasswordPages.ForgotPasswordPageView"
             BackgroundImageSource="partials_background.png">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <yummy:PancakeView CornerRadius="15,15,0,0" Padding="20,20,20,10" HasShadow="True" BackgroundColor="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*" />
                    <RowDefinition Height="80*" />
                    <RowDefinition Height="10*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="1" Source="ic_logo_gazt.png" WidthRequest="50" HeightRequest="50" VerticalOptions="Center" HorizontalOptions="Center"/>

                    <Label Grid.Column="0" x:Name="Image_backArrow" Grid.Row="0" Margin="10,0,10,0" HorizontalOptions="Start" VerticalOptions="Center"   Style="{StaticResource IconLabelStyle}" Text="{StaticResource Back}" Rotation="270"/>

                    <Image Grid.Column="2" IsVisible="False">
                        <Image.Source>
                            <FontImageSource Color="White" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Close}"/>
                        </Image.Source>
                    </Image>
                </Grid>
                <ScrollView Grid.Row="1">
                    <StackLayout >
                        <!-- Start Forgot Password View-->
                        <StackLayout >
                            <custom:CustomLabel Text="Forgot Username or Password" Style="{StaticResource SectionTitleBlack}" />
                            <custom:CustomLabel Text="Select the option and complete details" Style="{StaticResource BodyLabelGrey}"/>
                            <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1"/>

                            <Grid Padding="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <cards:SfCardView Grid.Column="0" HasShadow="True" BackgroundColor="White" CornerRadius="10" Padding="10">
                                    <StackLayout Padding="10,0,0,0">
                                        <Image Margin="0,30,0,0" HorizontalOptions="Start">
                                            <Image.Source>
                                                <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.FaceProfile}"/>
                                            </Image.Source>
                                        </Image>
                                        <custom:CustomLabel Text="Username" Style="{StaticResource CaptionLabelBlack}" />
                                    </StackLayout>
                                </cards:SfCardView>

                                <cards:SfCardView Grid.Column="1" HasShadow="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}" CornerRadius="10" Padding="10">
                                    <StackLayout Padding="10,0,0,0">
                                        <Image Margin="0,30,0,0" HorizontalOptions="Start" Rotation="-45">
                                            <Image.Source>
                                                <FontImageSource Color="White" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Key}"/>
                                            </Image.Source>
                                        </Image>
                                        <custom:CustomLabel Text="Password" Style="{StaticResource CaptionLabelBlack}" TextColor="White" />
                                    </StackLayout>
                                </cards:SfCardView>
                            </Grid>

                            <!--Starts Entry Fields-->

                            <StackLayout x:Name="ForgotUserName" IsVisible="False">
                                <custom:CustomLabel  Text="Taxpayer Type" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>

                                <Grid Padding="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <cards:SfCardView Grid.Column="0" HasShadow="True" BackgroundColor="White" CornerRadius="10" Padding="10">
                                        <StackLayout Padding="5,0,0,0">
                                            <custom:CustomLabel VerticalOptions="EndAndExpand" Text="Corporate" Style="{StaticResource CaptionLabelBlack}" />
                                        </StackLayout>
                                    </cards:SfCardView>

                                    <cards:SfCardView Grid.Column="1" HasShadow="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}" CornerRadius="10" Padding="10">
                                        <StackLayout Padding="5,0,0,0">
                                            <custom:CustomLabel VerticalOptions="EndAndExpand" Padding="0,20,0,0" Text="Individual or Personal Business" Style="{StaticResource CaptionLabelBlack}" TextColor="White" />
                                        </StackLayout>
                                    </cards:SfCardView>
                                </Grid>
                            </StackLayout>


                            <StackLayout Padding="0,10,0,0" Spacing="20" x:Name="ForgotPasswordEntryFields">
                                <StackLayout>
                                    <custom:CustomLabel  Text="ID Number" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry Placeholder="Type Your Id Number" TextColor="#bbbbbb" >
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                </StackLayout>


                                <StackLayout >
                                    <custom:CustomLabel  Text="USer Name" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry Placeholder="Enter Your Username" TextColor="#bbbbbb" >
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                </StackLayout>
                            </StackLayout>



                            <!--Ends Entry Fields-->
                        </StackLayout>
                        <!-- End Forgot Password View-->

                        <!--Start of Verification Code-->
                        <StackLayout >
                            <custom:CustomLabel Text="Verification Code" Style="{StaticResource SectionTitleBlack}" />
                            <custom:CustomLabel Text="Please enter the verification code sent to your mobile" Style="{StaticResource BodyLabelGrey}"/>
                            <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1"/>

                            <StackLayout Padding="0,15,0,0" >
                                <custom:CustomLabel Text="Mobile Number xxxxxxx388" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="Center" />

                                <Grid ColumnSpacing="20" Padding="30,20,30,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <inputLayout:SfTextInputLayout Grid.Column="0" Margin="0,-6,0,-6" ContainerType="Outlined" UnfocusedColor="#B1B1B1"	OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry IsPassword="True" MaxLength="1" TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                    <inputLayout:SfTextInputLayout Grid.Column="1" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry IsPassword="True" MaxLength="1" TextColor="#bbbbbb" >
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                    <inputLayout:SfTextInputLayout Grid.Column="2" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry IsPassword="True" MaxLength="1" TextColor="#bbbbbb" >
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                    <inputLayout:SfTextInputLayout Grid.Column="3" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry IsPassword="True" MaxLength="1" TextColor="#bbbbbb" >
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                </Grid>

                                <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                                    <Image>
                                        <Image.Source>
                                            <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Clock}"/>
                                        </Image.Source>
                                    </Image>
                                    <custom:CustomLabel Text="0:59" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="Center" />
                                </StackLayout>
                                <buttons:SfButton Text="Resend Verification Code" VerticalOptions="EndAndExpand" Margin="0,50,0,0" BackgroundColor="Transparent" TextColor="{StaticResource NewDarkBlueGreenColor}"/>
                            </StackLayout>

                        </StackLayout>
<!--                        End of Verification Code-->

                        <!--Start of Password View-->
                        <StackLayout >
                            <custom:CustomLabel Text="Password" Style="{StaticResource SectionTitleBlack}" />
                            <custom:CustomLabel Text="Create a Secure Password" Style="{StaticResource BodyLabelGrey}"/>
                            <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1"/>

                            <StackLayout Padding="0,20,0,0" Spacing="15">
                                <StackLayout>
                                    <custom:CustomLabel  Text="New Password" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90*"/>
                                                <ColumnDefinition Width="10*"/>
                                            </Grid.ColumnDefinitions>
                                        <custom:BorderlessEntry Grid.Column="0" Text="Abcd123" IsPassword="True">
                                        </custom:BorderlessEntry>
                                            <Image Grid.Column="1" HorizontalOptions="EndAndExpand">
                                                <Image.Source>
                                                    <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Passport}"/>
                                                </Image.Source>
                                            </Image>
                                        </Grid>
                                    </inputLayout:SfTextInputLayout>
                                </StackLayout>


                                <StackLayout >
                                    <custom:CustomLabel  Text="New Password" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90*"/>
                                                <ColumnDefinition Width="10*"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:BorderlessEntry Grid.Column="0" Text="Abcd123" IsPassword="True">
                                            </custom:BorderlessEntry>
                                            <Image Grid.Column="1" HorizontalOptions="EndAndExpand">
                                                <Image.Source>
                                                    <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Passport}"/>
                                                </Image.Source>
                                            </Image>
                                        </Grid>
                                    </inputLayout:SfTextInputLayout>
                                </StackLayout>
                            </StackLayout>

                            <StackLayout x:Name="PasswordChecks" Padding="0,15,0,0">
                                <StackLayout Orientation="Horizontal">
                                <Image>
                                    <Image.Source>
                                        <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Passport}"/>
                                    </Image.Source>
                                </Image>
                                <custom:CustomLabel Text="At least 8 Characters long" Style="{StaticResource CaptionLabelBlack}" Padding="5,0,0,0"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <Image>
                                    <Image.Source>
                                        <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Passport}"/>
                                    </Image.Source>
                                </Image>
                                <custom:CustomLabel Text="English Captial and small letters" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <Image>
                                    <Image.Source>
                                        <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Passport}"/>
                                    </Image.Source>
                                </Image>
                                <custom:CustomLabel Text="Not exceed 16 characters" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <Image>
                                    <Image.Source>
                                        <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Passport}"/>
                                    </Image.Source>
                                </Image>
                                <custom:CustomLabel Text="Numbers and Symbols" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                            </StackLayout>
                        </StackLayout>

                    </StackLayout>
                    <!--Ens of Password View-->


                    </StackLayout>
                </ScrollView>




                <StackLayout Grid.Row="2">
                    <buttons:SfButton x:Name="btnprimary" Text="Countinue" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackLayout>
            </Grid>
        </yummy:PancakeView>
	</ContentPage.Content>
</ContentPage>