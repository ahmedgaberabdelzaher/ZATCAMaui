<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.co/schemas/2014/forms/design"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true"
             mc:Ignorable="d"
              xmlns:ResourceManager="clr-namespace:EGAZT" xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms" xmlns:custom1="clr-namespace:GAZT.CustomControl" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.NewDesign.ForgotPasswordPages.GAZTNewDesignForgotPasswordPageView"
             BackgroundImageSource="partials_background.png">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <yummy:PancakeView CornerRadius="15,15,0,0" Padding="20,20,20,10" HasShadow="True" BackgroundColor="White">
            <Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="80*" />
                        <RowDefinition Height="10*" />
                    </Grid.RowDefinitions>

                    <ScrollView Grid.Row="1">
                        <StackLayout  Orientation="Vertical">
                            <!-- Start Forgot Password View-->
                            <StackLayout >
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ForgotPasswordORUseName}" Style="{StaticResource SectionTitleBlack}" />
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDSelectTheOptionAndCompleteDetails}" Style="{StaticResource BodyLabelGrey}"/>
                                <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1"/>

                                <Grid Padding="0,20,0,0" IsVisible="{Binding DefaultCardLayoutVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="136" />
                                    </Grid.RowDefinitions>
                                    <cards:SfCardView Grid.Column="0" HasShadow="True" BackgroundColor="{Binding UserNameCardBackgroundColor}"  CornerRadius="10" Padding="0">
                                        <RelativeLayout Padding="0" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDUsername}" Style="{StaticResource CaptionLabelBlack}" TextColor="{Binding UserNameTextColor}"
                                               RelativeLayout.WidthConstraint="{ConstraintExpression Type=RelativeToParent, Property=Width}" Padding="10,0,10,0"
                                               RelativeLayout.YConstraint="{ConstraintExpression Type=RelativeToParent, Property=Height, Factor=0.9, Constant=-20}" />
                                            <Image Margin="10"
                                               RelativeLayout.YConstraint="{ConstraintExpression Type=RelativeToParent, Property=Height, Factor=0.4}">
                                                <Image.Source>
                                                    <FontImageSource Color="{Binding UserNameTextColor}" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.FaceProfile}"/>
                                                </Image.Source>
                                            </Image>
                                            <RelativeLayout.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnUserNameCardClicked"></TapGestureRecognizer>
                                            </RelativeLayout.GestureRecognizers>
                                        </RelativeLayout>
                                    </cards:SfCardView>

                                    <cards:SfCardView Grid.Column="1" HasShadow="True" BackgroundColor="{Binding PasswordCardBackgroundColor}" CornerRadius="10" Padding="0">
                                        <RelativeLayout Padding="0" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.Password}" Style="{StaticResource CaptionLabelBlack}" TextColor="{Binding PasswordTextColor}"
                                               RelativeLayout.WidthConstraint="{ConstraintExpression Type=RelativeToParent, Property=Width}" Padding="10,0,10,0"
                                               RelativeLayout.YConstraint="{ConstraintExpression Type=RelativeToParent, Property=Height, Factor=0.9, Constant=-20}" />
                                            <Image Margin="10" RelativeLayout.YConstraint="{ConstraintExpression Type=RelativeToParent, Property=Height, Factor=0.4}">
                                                <Image.Source>
                                                    <FontImageSource Color="{Binding PasswordTextColor}" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Key}" />
                                                </Image.Source>
                                            </Image>
                                            <RelativeLayout.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPasswordCardClicked"></TapGestureRecognizer>
                                            </RelativeLayout.GestureRecognizers>
                                        </RelativeLayout>
                                    </cards:SfCardView>
                                </Grid>



                                <!--Starts Entry Fields-->

                                <StackLayout x:Name="ForgotUserName" IsVisible="{Binding ForgotUserNameCardLayoutVisibility}">
                                    <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.IDType}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>

                                    <Grid Padding="0,20,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!--<Grid.RowDefinitions>
                                        <RowDefinition Height="72" />
                                    </Grid.RowDefinitions>-->
                                        <cards:SfCardView Grid.Column="0" HasShadow="True" BackgroundColor="{Binding CorporateCardBackgroundColor}" CornerRadius="10" Padding="10">
                                            <StackLayout Padding="5,0,0,0" Orientation="Vertical">
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.Corporate}" VerticalOptions="CenterAndExpand" Padding="0" Style="{StaticResource CaptionLabelBlack}" TextColor="{Binding CorporateTextColor}" />
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OnCorporateCardClicked}"></TapGestureRecognizer>
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                        </cards:SfCardView>

                                        <cards:SfCardView Grid.Column="1" HasShadow="True" BackgroundColor="{Binding IndividualOrPersonalBusinessCardBackgroundColor}" CornerRadius="10" Padding="10">
                                            <StackLayout Padding="5,0,0,0" Orientation="Vertical">
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.Individual}" VerticalOptions="CenterAndExpand" Padding="0" Style="{StaticResource CaptionLabelBlack}" TextColor="{Binding IndividualOrPersonalBusinessTextColor}" />
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OnIndividualOrPersonalBusinessCardClicked}"></TapGestureRecognizer>
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                        </cards:SfCardView>
                                    </Grid>
                                </StackLayout>


                                <StackLayout Padding="0,10,0,0" Spacing="20" x:Name="ForgotPasswordEntryFields" >
                                    <StackLayout IsVisible="{Binding UserIDLayoutVisibility}">
                                        <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.IDNumber}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                        <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                            <custom:BorderlessEntry Text="{Binding IDNumber}" Placeholder="{x:Static ResourceManager:AppResources.NDTypeyourIDNumber}" TextColor="#bbbbbb" >
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>


                                    <StackLayout IsVisible="{Binding UserNameLayoutVisibility}">
                                        <custom:CustomLabel   Text="{x:Static ResourceManager:AppResources.UserName}"   Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                        <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                            <custom:BorderlessEntry  x:Name="Entry_UserName" Text="{Binding Email}" Unfocused="Entry_UserName_Unfocused" Placeholder="{x:Static ResourceManager:AppResources.NDEnterYourUsername}" TextColor="#bbbbbb" >
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>
                                    <Grid IsVisible="{Binding IsTinDopDownVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Grid.Row="0"  Text="{x:Static ResourceManager:AppResources.TINS}"   Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                        <inputLayout:SfTextInputLayout Grid.Row="1"  Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                            <custom:BorderlessEntry  Text="{Binding TxtTIN}" Unfocused="Entry_UserName_Unfocused" Placeholder="{x:Static ResourceManager:AppResources.TINS}" TextColor="#bbbbbb" >
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                        <custom:CustomButton x:Name="Btn_TinPicker" Grid.Row="1" Clicked="Btn_TinPicker_Clicked" FontSize="Small" BackgroundColor="Transparent" />

                                        <syncfusion:SfPicker x:Name="Picker_Tins" Grid.Row="1" 
                    HeaderHeight="55"
                    ShowHeader="False"
                   
HeaderTextColor="White"
                                             ShowColumnHeader="False"
                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"
                                            HeaderBackgroundColor="#006450"
                  
                    BorderColor="Black"
                     BackgroundColor="#EAF7CC"
                    UnSelectedItemTextColor="{StaticResource NeutralBlack}"
                                SelectedItemFontSize="15"
                                           
                   ItemHeight="40" SelectedItemTextColor="{StaticResource NeutralBlack}"
                     DisplayMemberPath="Tin" ItemsSource="{Binding TINs}"   Grid.Column="0" 
                   PickerHeight="250"
                    PickerWidth="300"
                                             HeaderFontSize="14"
                    OKButtonTextColor="#006450"
                    CancelButtonTextColor="#006450"
                        ShowFooter="False" SelectionChanged="Picker_Tins_SelectionChanged"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                             FooterHeight="46">
                                            <syncfusion:SfPicker.Behaviors>
                                                <custom1:SfPickerBehavior />
                                            </syncfusion:SfPicker.Behaviors>
                                        </syncfusion:SfPicker>

                                    </Grid>
                                </StackLayout>



                                <!--Ends Entry Fields-->
                            </StackLayout>
                            <!-- End Forgot Password View-->

                            <!--Start of Verification Code-->
                            <StackLayout IsVisible="{Binding VerificationCodeVisibility}">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VerificationCode}" Style="{StaticResource SectionTitleBlack}" />
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDPleaseEnterVerificationSenttomobile}" Style="{StaticResource BodyLabelGrey}"/>
                                <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1"/>

                                <StackLayout Padding="0,15,0,0" >
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDMoblieNumber}" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="Center" />

                                    <StackLayout Padding="0,100,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Row="0" ColumnSpacing="20" Padding="30,20,30,20">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <inputLayout:SfTextInputLayout Grid.Column="0" Margin="0,-6,0,-6" ContainerType="Outlined" UnfocusedColor="#B1B1B1"	OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry x:Name="OTPFirstDigit" Text="{Binding OTPFirstDigit}" IsPassword="True" MaxLength="1" TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                                <inputLayout:SfTextInputLayout Grid.Column="1" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry x:Name="OTPSecondDigit" Text="{Binding OTPSecondDigit}" IsPassword="True" MaxLength="1" TextColor="#bbbbbb" >
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                                <inputLayout:SfTextInputLayout Grid.Column="2" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry x:Name="OTPThirdDigit" Text="{Binding OTPThirdDigit}" IsPassword="True" MaxLength="1" TextColor="#bbbbbb" >
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                                <inputLayout:SfTextInputLayout Grid.Column="3" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry x:Name="OTPFourthDigit" Text="{Binding OTPFourthDigit}" IsPassword="True" MaxLength="1" TextColor="#bbbbbb" >
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>


                                            </Grid>
                                            <Editor TextChanged="Editor_TextChanged" Keyboard="Numeric" TextColor="Transparent" BackgroundColor="Transparent"  HorizontalOptions="FillAndExpand" Grid.Row="0"/>

                                        </Grid>
                                    </StackLayout>


                                    <!--<inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry Text="{Binding EnteredOTP}" Placeholder="Enter OTP" TextColor="#bbbbbb" >
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>-->


                                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                                        <Image Source="clock">
                                        </Image>
                                        <custom:CustomLabel  Text="{Binding LblCountDownTimer}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="Center" />
                                    </StackLayout>
                                    <buttons:SfButton  Command="{Binding OnResendOTPClicked}" IsEnabled="{Binding IsResendOTPEnabled}" Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}" VerticalOptions="EndAndExpand" Margin="0,50,0,0" BackgroundColor="Transparent" TextColor="{StaticResource NewDarkBlueGreenColor}"/>
                                </StackLayout>

                            </StackLayout>


                            <!--                        End of Verification Code-->


                            <!--Start of Password View-->
                            <StackLayout IsVisible="{Binding PasswordLayoutVisibility}">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.Password}" Style="{StaticResource SectionTitleBlack}" />
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.CreateASecurePassword}" Style="{StaticResource BodyLabelGrey}"/>
                                <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1"/>

                                <StackLayout Padding="0,20,0,0" Spacing="15">
                                    <StackLayout>
                                        <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.NDNewPassword}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                        <inputLayout:SfTextInputLayout LeadingViewPosition="Inside" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                            <inputLayout:SfTextInputLayout.LeadingView>

                                                <Image HorizontalOptions="Center" VerticalOptions="Center" >
                                                    <Image.Source>
                                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="20"
                                         Glyph="{x:Static FontImage:IconFonts.ContentCopy}"/>
                                                    </Image.Source>
                                                </Image>

                                            </inputLayout:SfTextInputLayout.LeadingView>
                                            <custom:BorderlessEntry Text="{Binding NewPassword}" Grid.Column="0"  IsPassword="True">
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>


                                    <StackLayout >
                                        <custom:CustomLabel   Text="{x:Static ResourceManager:AppResources.ZZConfirmpassword}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                        <inputLayout:SfTextInputLayout LeadingViewPosition="Inside" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">

                                            <inputLayout:SfTextInputLayout.LeadingView>

                                                <Image HorizontalOptions="Center" VerticalOptions="Center" >
                                                    <Image.Source>
                                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="20"
                                         Glyph="{x:Static FontImage:IconFonts.ContentCopy}"/>
                                                    </Image.Source>
                                                </Image>

                                            </inputLayout:SfTextInputLayout.LeadingView>

                                            <custom:BorderlessEntry Text="{Binding ConfirmPassword}" Grid.Column="0"  IsPassword="True">
                                            </custom:BorderlessEntry>

                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>
                                </StackLayout>

                                <StackLayout x:Name="PasswordChecks" Padding="0,15,0,0">
                                    <StackLayout Orientation="Horizontal">
                                        <Image>
                                            <Image.Source>
                                                <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Passport}"/>
                                            </Image.Source>
                                        </Image>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDAtleast8character}" Style="{StaticResource CaptionLabelBlack}" Padding="5,0,0,0"/>
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal">
                                        <Image>
                                            <Image.Source>
                                                <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Passport}"/>
                                            </Image.Source>
                                        </Image>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDEnglishcapitalandsmallletters}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal">
                                        <Image>
                                            <Image.Source>
                                                <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Passport}"/>
                                            </Image.Source>
                                        </Image>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZZNotexceed16characters}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal">
                                        <Image>
                                            <Image.Source>
                                                <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Passport}"/>
                                            </Image.Source>
                                        </Image>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDNumbersAndSymbols}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                                    </StackLayout>
                                </StackLayout>

                            </StackLayout>
                            <!--Ens of Password View-->


                        </StackLayout>
                    </ScrollView>




                    <StackLayout Grid.Row="2">
                        <buttons:SfButton Command="{Binding OnContinueClick}" x:Name="btnprimary" Text="{x:Static ResourceManager:AppResources.NDCountinue}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackLayout>
                    <Grid Grid.Row="0" BackgroundColor="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="1" Source="ic_logo_gazt.png" WidthRequest="50" HeightRequest="50" VerticalOptions="Center" HorizontalOptions="Center"/>

                        <Label Grid.Column="0" x:Name="Image_backArrow" Grid.Row="0" Margin="10,0,10,0" HorizontalOptions="Start" VerticalOptions="Center"   Style="{StaticResource IconLabelStyle}" Text="{StaticResource Back}" Rotation="270"/>

                        <Image Grid.Column="2" IsVisible="False">
                            <Image.Source>
                                <FontImageSource Color="White" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Close}"/>
                            </Image.Source>
                        </Image>
                    </Grid>

                    <StackLayout Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Padding="-20,-20,-20,-10" BackgroundColor="#005e4b" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsVisible="{Binding RecoverUserNameLayout}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15*" />
                                <RowDefinition Height="15*" />
                                <RowDefinition Height="10*" />
                                <RowDefinition Height="15*" />
                                <RowDefinition Height="26*" />
                                <RowDefinition Height="12*" />
                                <RowDefinition Height="7*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="icon.png" Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center">

                            </Image>
                            <custom:CustomLabel Grid.Row="2" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" Text="{x:Static ResourceManager:AppResources.RecoverUserName}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                            <custom:CustomLabel Grid.Row="3" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" Text="{x:Static ResourceManager:AppResources.UsernameSentToTheRegisteredEmailEndMobileNumber}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" Padding="5,0,0,0"/>
                            <buttons:SfButton Grid.Row="5" Grid.Column="0" Command="{Binding OnLogInClick}"  Text="{x:Static ResourceManager:AppResources.LogIn}"  Style="{StaticResource PrimaryButtonStyle}" Margin="25,0,25,0"/>
                            <custom:CustomLabel Grid.Row="6" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" Text="{x:Static ResourceManager:AppResources.CheckEmail}"  Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>

                        </Grid>
                    </StackLayout>


                    <StackLayout Padding="-20,-20,-20,-10" Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" BackgroundColor="#005e4b" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsVisible="{Binding RecoverPasswordLayout}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15*" />
                                <RowDefinition Height="15*" />
                                <RowDefinition Height="10*" />
                                <RowDefinition Height="10*" />
                                <RowDefinition Height="38*" />
                                <RowDefinition Height="12*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="icon.png" Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center">

                            </Image>
                            <custom:CustomLabel Grid.Row="2"  Grid.Column="0" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" Text="{x:Static ResourceManager:AppResources.RecoverPassword}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                            <custom:CustomLabel Grid.Row="3" Grid.Column="0" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" Text="{x:Static ResourceManager:AppResources.NewPasswordUpdatedSuccessfully}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                            <buttons:SfButton Grid.Row="5" Grid.Column="0" Command="{Binding OnLogInClick}" Text="{x:Static ResourceManager:AppResources.LogIn}"  Style="{StaticResource PrimaryButtonStyle}"/>

                        </Grid>
                    </StackLayout>


                </Grid>
                <Grid Grid.Row="0"    Grid.Column="0"   IsVisible="{Binding IsLoading}" >
                    <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                    </StackLayout>
                    <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="Center"
                                           IsBusy="{Binding IsLoading}"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#006450"/>
                        </StackLayout>
                        <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                    </StackLayout>
                </Grid>
            </Grid>
         
        </yummy:PancakeView>
	</ContentPage.Content>
</ContentPage>