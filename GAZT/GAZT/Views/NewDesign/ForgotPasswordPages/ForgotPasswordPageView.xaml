<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             mc:Ignorable="d"
             x:Class="EGAZT.Views.NewDesign.ForgotPasswordPages.GAZTNewDesignForgotPasswordPageView"
             BackgroundImageSource="partials_background.png">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <yummy:PancakeView CornerRadius="15,15,0,0" Padding="20,20,20,10" HasShadow="True" BackgroundColor="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*" />
                    <RowDefinition Height="80*" />
                    <RowDefinition Height="10*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="1" Source="ic_logo_gazt.png" WidthRequest="50" HeightRequest="50" VerticalOptions="Center" HorizontalOptions="Center"/>

                    <Label Grid.Column="0" x:Name="Image_backArrow" Grid.Row="0" Margin="10,0,10,0" HorizontalOptions="Start" VerticalOptions="Center"   Style="{StaticResource IconLabelStyle}" Text="{StaticResource Back}" Rotation="270"/>

                    <Image Grid.Column="2" IsVisible="False">
                        <Image.Source>
                            <FontImageSource Color="White" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Close}"/>
                        </Image.Source>
                    </Image>
                </Grid>
                <ScrollView Grid.Row="1">
                    <StackLayout  Orientation="Vertical">
                        <!-- Start Forgot Password View-->
                        <StackLayout >
                            <custom:CustomLabel Text="Forgot Username or Password" Style="{StaticResource SectionTitleBlack}" />
                            <custom:CustomLabel Text="Select the option and complete details" Style="{StaticResource BodyLabelGrey}"/>
                            <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1"/>

                            <Grid Padding="0,20,0,0" IsVisible="{Binding DefaultCardLayoutVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <cards:SfCardView Grid.Column="0" HasShadow="True" BackgroundColor="White" CornerRadius="10" Padding="10">
                                    <StackLayout Padding="10,0,0,0">
                                        <Image Margin="0,30,0,0" HorizontalOptions="Start">
                                            <Image.Source>
                                                <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.FaceProfile}"/>
                                            </Image.Source>
                                        </Image>
                                        <custom:CustomLabel Text="Username" Style="{StaticResource CaptionLabelBlack}">
                                             <custom:CustomLabel.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OnUserNameCardClicked}"></TapGestureRecognizer>
                </custom:CustomLabel.GestureRecognizers>
                                        </custom:CustomLabel>
                                    </StackLayout>
                                </cards:SfCardView>

                                <cards:SfCardView Grid.Column="1" HasShadow="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}" CornerRadius="10" Padding="10">
                                    <StackLayout Padding="10,0,0,0">
                                        <Image Margin="0,30,0,0" HorizontalOptions="Start" Rotation="-45">
                                            <Image.Source>
                                                <FontImageSource Color="White" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Key}"/>
                                            </Image.Source>
                                        </Image>
                                        <custom:CustomLabel Text="Password" Style="{StaticResource CaptionLabelBlack}" TextColor="White" >
                                            <custom:CustomLabel.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OnPasswordCardClicked}"></TapGestureRecognizer>
                </custom:CustomLabel.GestureRecognizers>
                                        </custom:CustomLabel>
                                    </StackLayout>
                                </cards:SfCardView>
                            </Grid>



                            <!--Starts Entry Fields-->

                            <StackLayout x:Name="ForgotUserName" IsVisible="{Binding ForgotUserNameCardLayoutVisibility}">
                                <custom:CustomLabel  Text="Taxpayer Type" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>

                                <Grid Padding="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <cards:SfCardView Grid.Column="0" HasShadow="True" BackgroundColor="White" CornerRadius="10" Padding="10">
                                        <StackLayout Padding="5,0,0,0">
                                            <custom:CustomLabel Text="Corporate" VerticalOptions="EndAndExpand"  Style="{StaticResource CaptionLabelBlack}">
                                                 <custom:CustomLabel.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OnCorporateCardClicked}"></TapGestureRecognizer>
                </custom:CustomLabel.GestureRecognizers>
                                            </custom:CustomLabel>
                                        </StackLayout>
                                    </cards:SfCardView>

                                    <cards:SfCardView Grid.Column="1" HasShadow="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}" CornerRadius="10" Padding="10">
                                        <StackLayout Padding="5,0,0,0">
                                            <custom:CustomLabel Text="Idivdual or personal business" VerticalOptions="EndAndExpand" Padding="0,20,0,0" Style="{StaticResource CaptionLabelBlack}" TextColor="White" >
                                                <custom:CustomLabel.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OnIndividualOrPersonalBusinessCardClicked}"></TapGestureRecognizer>
                </custom:CustomLabel.GestureRecognizers>
                                            </custom:CustomLabel>
                                        </StackLayout>
                                    </cards:SfCardView>
                                </Grid>
                            </StackLayout>


                            <StackLayout Padding="0,10,0,0" Spacing="20" x:Name="ForgotPasswordEntryFields" IsVisible="{Binding UserIDLayoutVisibility}">
                                <StackLayout>
                                    <custom:CustomLabel  Text="ID Number" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry Text="{Binding IDNumber}" Placeholder="Type Your Id Number" TextColor="#bbbbbb" >
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                </StackLayout>


                                <StackLayout IsVisible="{Binding UserNameLayoutVisibility}">
                                    <custom:CustomLabel  Text="USer Name" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry Text="{Binding Email}" Placeholder="Enter Your Username" TextColor="#bbbbbb" >
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                </StackLayout>
                            </StackLayout>



                            <!--Ends Entry Fields-->
                        </StackLayout>
                        <!-- End Forgot Password View-->

                        <!--Start of Verification Code-->
                        <StackLayout IsVisible="{Binding VerificationCodeVisibility}">
                            <custom:CustomLabel Text="Verification Code" Style="{StaticResource SectionTitleBlack}" />
                            <custom:CustomLabel Text="Please enter the verification code sent to your mobile" Style="{StaticResource BodyLabelGrey}"/>
                            <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1"/>

                            <StackLayout Padding="0,15,0,0" >
                                <custom:CustomLabel Text="Mobile Number xxxxxxx388" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="Center" />

                                <StackLayout Padding="0,100,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
                                <Grid Grid.Row="0" ColumnSpacing="20" Padding="30,20,30,20">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <inputLayout:SfTextInputLayout Grid.Column="0" Margin="0,-6,0,-6" ContainerType="Outlined" UnfocusedColor="#B1B1B1"	OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry x:Name="label1" Text="{Binding OTPFirstDigit}" IsPassword="True" MaxLength="1" TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                    <inputLayout:SfTextInputLayout Grid.Column="1" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry x:Name="label2" Text="{Binding OTPSecondDigit}" IsPassword="True" MaxLength="1" TextColor="#bbbbbb" >
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                    <inputLayout:SfTextInputLayout Grid.Column="2" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry x:Name="label3" Text="{Binding OTPThirdDigit}" IsPassword="True" MaxLength="1" TextColor="#bbbbbb" >
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                    <inputLayout:SfTextInputLayout Grid.Column="3" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry x:Name="label4" Text="{Binding OTPFourthDigit}" IsPassword="True" MaxLength="1" TextColor="#bbbbbb" >
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>


                                </Grid>
                                                            <Editor TextChanged="Editor_TextChanged" Keyboard="Numeric" TextColor="Transparent" BackgroundColor="Transparent"  HorizontalOptions="FillAndExpand" Grid.Row="0"/>

            </Grid>
                                     </StackLayout>


                                <!--<inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry Text="{Binding EnteredOTP}" Placeholder="Enter OTP" TextColor="#bbbbbb" >
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>-->


                                <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                                    <Image>
                                        <Image.Source>
                                            <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Clock}"/>
                                        </Image.Source>
                                    </Image>
                                    <custom:CustomLabel  Text="{Binding LblCountDownTimer}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="Center" />
                                </StackLayout>
                                <buttons:SfButton  Command="{Binding OnResendOTPClicked}" IsEnabled="{Binding IsResendOTPEnabled}" Text="Resend Verification Code" VerticalOptions="EndAndExpand" Margin="0,50,0,0" BackgroundColor="Transparent" TextColor="{StaticResource NewDarkBlueGreenColor}"/>
                            </StackLayout>

                        </StackLayout>


<!--                        End of Verification Code-->


                        <!--Start of Password View-->
                        <StackLayout IsVisible="{Binding PasswordLayoutVisibility}">
                            <custom:CustomLabel Text="Password" Style="{StaticResource SectionTitleBlack}" />
                            <custom:CustomLabel Text="Create a Secure Password" Style="{StaticResource BodyLabelGrey}"/>
                            <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1"/>

                            <StackLayout Padding="0,20,0,0" Spacing="15">
                                <StackLayout>
                                    <custom:CustomLabel  Text="New Password" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                    <inputLayout:SfTextInputLayout LeadingViewPosition="Inside" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <inputLayout:SfTextInputLayout.LeadingView>

                                            <Image HorizontalOptions="Center" VerticalOptions="Center" >
                            <Image.Source>
                                <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="20"
                                         Glyph="{x:Static FontImage:IconFonts.ContentCopy}"/>
                            </Image.Source>
                        </Image>

                    </inputLayout:SfTextInputLayout.LeadingView>
                                        <custom:BorderlessEntry Text="{Binding NewPassword}" Grid.Column="0"  IsPassword="True">
                                        </custom:BorderlessEntry>
                                                                               </inputLayout:SfTextInputLayout>
                                </StackLayout>


                                <StackLayout >
                                    <custom:CustomLabel   Text="Confirm Password" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                    <inputLayout:SfTextInputLayout LeadingViewPosition="Inside" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">

                                         <inputLayout:SfTextInputLayout.LeadingView>

                                            <Image HorizontalOptions="Center" VerticalOptions="Center" >
                            <Image.Source>
                                <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="20"
                                         Glyph="{x:Static FontImage:IconFonts.ContentCopy}"/>
                            </Image.Source>
                        </Image>

                    </inputLayout:SfTextInputLayout.LeadingView>

                                            <custom:BorderlessEntry Text="{Binding ConfirmPassword}" Grid.Column="0"  IsPassword="True">
                                            </custom:BorderlessEntry>
                                            
                                    </inputLayout:SfTextInputLayout>
                                </StackLayout>
                            </StackLayout>

                            <StackLayout x:Name="PasswordChecks" Padding="0,15,0,0">
                                <StackLayout Orientation="Horizontal">
                                <Image>
                                    <Image.Source>
                                        <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Passport}"/>
                                    </Image.Source>
                                </Image>
                                <custom:CustomLabel Text="At least 8 Characters long" Style="{StaticResource CaptionLabelBlack}" Padding="5,0,0,0"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <Image>
                                    <Image.Source>
                                        <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Passport}"/>
                                    </Image.Source>
                                </Image>
                                <custom:CustomLabel Text="English Captial and small letters" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <Image>
                                    <Image.Source>
                                        <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Passport}"/>
                                    </Image.Source>
                                </Image>
                                <custom:CustomLabel Text="Not exceed 16 characters" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <Image>
                                    <Image.Source>
                                        <FontImageSource Color="Black" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Passport}"/>
                                    </Image.Source>
                                </Image>
                                <custom:CustomLabel Text="Numbers and Symbols" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                            </StackLayout>
                        </StackLayout>

                    </StackLayout>
                    <!--Ens of Password View-->


                    </StackLayout>
                </ScrollView>




                <StackLayout Grid.Row="2">
                    <buttons:SfButton Command="{Binding OnContinueClick}" x:Name="btnprimary" Text="Countinue" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackLayout>

               <StackLayout Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Padding="-20,-20,-20,-10" BackgroundColor="#005e4b" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsVisible="{Binding RecoverUserNameLayout}">
                   <Grid>
 <Grid.RowDefinitions>
                    <RowDefinition Height="15*" />
                    <RowDefinition Height="15*" />
                    <RowDefinition Height="10*" />
      <RowDefinition Height="15*" />
                    <RowDefinition Height="26*" />
                    <RowDefinition Height="12*" />
     <RowDefinition Height="7*" />
                </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                       <Image Source="icon.png" Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center">

                       </Image>
                  <custom:CustomLabel Grid.Row="2" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" Text="Recover UserName" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                  <custom:CustomLabel Grid.Row="3" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" Text="Username sent to the registered email and mobile number" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" Padding="5,0,0,0"/>
                  <buttons:SfButton Grid.Row="5" Grid.Column="0" Command="{Binding OnLogInClick}"  Text="Log In" Style="{StaticResource PrimaryButtonStyle}" Margin="25,0,25,0"/>
                  <custom:CustomLabel Grid.Row="6" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" Text="Check Email" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>

                   </Grid>
               </StackLayout>


                 <StackLayout Padding="-20,-20,-20,-10" Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" BackgroundColor="#005e4b" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsVisible="{Binding RecoverPasswordLayout}">
                   <Grid>
 <Grid.RowDefinitions>
                    <RowDefinition Height="15*" />
                    <RowDefinition Height="15*" />
                    <RowDefinition Height="10*" />
      <RowDefinition Height="10*" />
                    <RowDefinition Height="38*" />
     <RowDefinition Height="12*" />
                </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                       <Image Source="icon.png" Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center">

                       </Image>
                  <custom:CustomLabel Grid.Row="2"  Grid.Column="0" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" Text="Recover Password" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                  <custom:CustomLabel Grid.Row="3" Grid.Column="0" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" Text="New Password updated successfully" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                  <buttons:SfButton Grid.Row="5" Grid.Column="0" Command="{Binding OnLogInClick}" Text="Log In" Style="{StaticResource PrimaryButtonStyle}"/>

                   </Grid>
               </StackLayout>


            </Grid>
        </yummy:PancakeView>
	</ContentPage.Content>
</ContentPage>