<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.co/schemas/2014/forms/design"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:PasswordBehaviour="clr-namespace:GAZT"
             xmlns:GAZTBehaviors="clr-namespace:EGAZT"
NavigationPage.HasNavigationBar="False"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:EGAZT.CustomControl"
              xmlns:ResourceManager="clr-namespace:EGAZT" xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms" xmlns:custom1="clr-namespace:GAZT.CustomControl" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.NewDesign.ForgotPasswordPages.GAZTNewDesignForgotPasswordPageView"
             BackgroundImageSource="partials_background.png">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <yummy:PancakeView CornerRadius="15,15,0,0" HasShadow="True" BackgroundColor="White">
            <Grid >
                <Grid  >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <ScrollView Grid.Row="1" Margin="20,20,20,10" VerticalScrollBarVisibility="Never">
                        <StackLayout  Orientation="Vertical">
                            <!-- Start Forgot Password View-->
                            <StackLayout >

                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ForgotPasswordORUseName}" Style="{StaticResource PageTitleBlack}" />
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDSelectTheOptionAndCompleteDetails}" Style="{StaticResource BodyLabelGrey}"/>
                                <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1"/>
                                <Grid Padding="0,20,0,0" IsVisible="{Binding DefaultCardLayoutVisibility}" HorizontalOptions="StartAndExpand">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    
                                    <Grid Grid.Column="0" HorizontalOptions="StartAndExpand">
                                        <Image Source="{Binding UserNameCardBackgroundImg}"/>
                                        <StackLayout Padding="16,0,0,16" VerticalOptions="EndAndExpand">
                                            <Image Source="{Binding UserIcon}" HorizontalOptions="Start"/>
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDUsername}" Style="{StaticResource ValueLabelBlackMedium}" TextColor="{Binding UserNameTextColor}"/>
                                        </StackLayout>

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnUserNameCardClicked"></TapGestureRecognizer>
                                        </Grid.GestureRecognizers>
                                    </Grid>

                                    <Grid Grid.Column="1" HorizontalOptions="StartAndExpand">
                                        <Image Source="{Binding PasswordCardBackgroundImg}"/>
                                        <StackLayout Padding="16,0,0,16" VerticalOptions="EndAndExpand">
                                            <Image Source="{Binding PasswordIcon}" HorizontalOptions="Start"/>
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.Password}" Style="{StaticResource ValueLabelBlackMedium}" TextColor="{Binding PasswordTextColor}"/>
                                        </StackLayout>

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPasswordCardClicked"></TapGestureRecognizer>
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                    
                                </Grid>



                                <!--Starts Entry Fields-->

                                <StackLayout x:Name="ForgotUserName" IsVisible="{Binding ForgotUserNameCardLayoutVisibility}">
                                    <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.IDType}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>

                                    <Grid Padding="0,20,0,0" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Grid Grid.Row="0" Grid.Column="0" HorizontalOptions="StartAndExpand">
                                            <Image Source="{Binding CorporateCardBackgroundImg}"/>

                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.Company}"  Style="{StaticResource ValueLabelBlackMedium}" TextColor="{Binding CorporateTextColor}" Padding="16,0,16,16" VerticalOptions="EndAndExpand"/>

                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnCorporateCardClicked}"></TapGestureRecognizer>
                                            </Grid.GestureRecognizers>
                                        </Grid>

                                        <Grid Grid.Row="0" Grid.Column="1" HorizontalOptions="StartAndExpand">

                                          <Image Source="{Binding IndividualOrPersonalBusinessCardBackgroundImg}"  />
                                            
                                         <Label Text="{x:Static ResourceManager:AppResources.Individual}"   WidthRequest="{OnIdiom Tablet=120,Default=120}" Style="{StaticResource ValueLabelBlackMedium}" Padding="16,0,16,16" TextColor="{Binding IndividualOrPersonalBusinessTextColor}"  VerticalOptions="EndAndExpand"/>
                                            
                                            


                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnIndividualOrPersonalBusinessCardClicked}"></TapGestureRecognizer>
                                            </Grid.GestureRecognizers>
                                        </Grid>
                                    </Grid>
                                </StackLayout>


                                <StackLayout Padding="0,10,0,0" Spacing="20" x:Name="ForgotPasswordEntryFields" >
                                    <StackLayout IsVisible="{Binding UserIDLayoutVisibility}">
                                        <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.IDNumber}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                        <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                            <custom:BorderlessEntry x:Name="IDNumberForForGotUserNmae" Keyboard="Numeric" Text="{Binding IDNumber}"  Style="{StaticResource DefaultEntry}" Placeholder="{x:Static ResourceManager:AppResources.IDNumber}" IsEnabled="{Binding SetIDNumberEnability}" TextChanged="OnIdNumberTextChanged">
                                                 <custom:BorderlessEntry.Behaviors>
                                                <custom1:OnlyNumericValuesBehaviour/>
                                            </custom:BorderlessEntry.Behaviors>
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>


                                    <StackLayout IsVisible="{Binding UserNameLayoutVisibility}">
                                        <custom:CustomLabel   Text="{Binding UserNameLabelText}"   Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                        <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                            <custom:BorderlessEntry  x:Name="Entry_UserName" Text="{Binding Email}" Unfocused="Entry_UserName_Unfocused" Placeholder="{Binding UserNameLabelText}" Style="{StaticResource DefaultEntry}" TextChanged="UserNameTextChanged">
                                            <custom:BorderlessEntry.Behaviors>
                                                <custom:AlphaNumericValidatorBehaviour/>
                                            </custom:BorderlessEntry.Behaviors>
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>


                                    <Grid IsVisible="{Binding IsTinDopDownVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Grid.Row="0"  Text="{x:Static ResourceManager:AppResources.IDNumber}"   Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                        <inputLayout:SfTextInputLayout Grid.Row="1"  Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                            <custom:BorderlessEntry IsEnabled="{Binding Enabled}" Text="{Binding TxtTIN}" Unfocused="Entry_UserName_Unfocused" Placeholder="{x:Static ResourceManager:AppResources.TINS}" TextColor="#bbbbbb" >
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                        <custom:CustomButton IsEnabled="{Binding Enabled}" x:Name="Btn_TinPicker" Grid.Row="1" Clicked="Btn_TinPicker_Clicked" FontSize="Small" BackgroundColor="Transparent" />

                                        <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="Picker_Tins" Grid.Row="1" 
                    HeaderHeight="55"
                    ShowHeader="False"
                   
HeaderTextColor="White"
                                             ShowColumnHeader="False"
                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"
                                            HeaderBackgroundColor="#006450"
                  
                    BorderColor="Black"
                     BackgroundColor="#EAF7CC"
                    UnSelectedItemTextColor="{StaticResource NeutralBlack}"
                                SelectedItemFontSize="15"
                                           
                   ItemHeight="40" SelectedItemTextColor="{StaticResource NeutralBlack}"
                     DisplayMemberPath="Tin" ItemsSource="{Binding TINs}"   Grid.Column="0" 
                   PickerHeight="250"
                    PickerWidth="300"
                                             HeaderFontSize="14"
                    OKButtonTextColor="#006450"
                    CancelButtonTextColor="#006450"
                        ShowFooter="False" SelectionChanged="Picker_Tins_SelectionChanged"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                             FooterHeight="46">
                                            <syncfusion:SfPicker.Behaviors>
                                                <custom1:SfPickerBehavior />
                                            </syncfusion:SfPicker.Behaviors>
                                        </syncfusion:SfPicker>

                                    </Grid>
                                </StackLayout>



                                <!--Ends Entry Fields-->
                            </StackLayout>
                            <!-- End Forgot Password View-->

                            <!--Start of Verification Code-->
                            <StackLayout IsVisible="{Binding VerificationCodeVisibility}">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VerificationCode}" Style="{StaticResource PageTitleBlack}" />
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDPleaseEnterVerificationSenttomobile}" Style="{StaticResource BodyLabelGrey}"/>
                                <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1"/>

                                <StackLayout Padding="0,15,0,0" >
                                    <custom:CustomLabel Text="{Binding OTPSentOnThisMobileNumber}" Style="{StaticResource BodyLabelGrey}" HorizontalOptions="Center"  HorizontalTextAlignment="Center"/>

                                    <StackLayout Padding="0,0,0,0" >
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Row="0" ColumnSpacing="20" Padding="30,20,30,20" FlowDirection="LeftToRight">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>


                                                <!--First OTP Digit Start-->
                                                <inputLayout:SfTextInputLayout
                                                    Grid.Column="0"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry
                                                        x:Name="OTPFirstEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPFirstDigit}"
                                                        TextChanged="OtpFirstEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                                        <custom:BorderlessEntry.Behaviors>
                                                            <local:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry"/>
                                                        </custom:BorderlessEntry.Behaviors>
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                                <!--First OTP Digit End-->

                                                <!--Second OTP Digit Start-->
                                                <inputLayout:SfTextInputLayout
                                                    Grid.Column="1"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry
                                                        x:Name="OTPSecondEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPSecondDigit}"
                                                        TextChanged="OtpSecondEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                                        <custom:BorderlessEntry.Behaviors>
                                                            <local:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry"/>
                                                        </custom:BorderlessEntry.Behaviors>
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                                <!--Second OTP Digit End-->

                                                <!--Third OTP Digit Start-->
                                                <inputLayout:SfTextInputLayout
                                                    Grid.Column="2"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry
                                                        x:Name="OTPThirdEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPThirdDigit}"
                                                        TextChanged="OtpThirdEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                                        <custom:BorderlessEntry.Behaviors>
                                                            <local:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry"/>
                                                        </custom:BorderlessEntry.Behaviors>
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                                <!--Third OTP Digit End-->

                                                <!--Fourth OTP Digit Start-->
                                                <inputLayout:SfTextInputLayout
                                                    Grid.Column="3"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry
                                                        x:Name="OTPFourthEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPFourthDigit}"
                                                        TextChanged="OtpFourthEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand"
                                                        Unfocused="OtpFourthEntry_Unfocused">
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                                <!--Fourth OTP Digit End-->

                                                <!--<inputLayout:SfTextInputLayout Grid.Column="0" Margin="0,-6,0,-6" ContainerType="Outlined" UnfocusedColor="#B1B1B1"	OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry x:Name="OTPFirstDigit" Text="{Binding OTPFirstDigit}" IsPassword="True" MaxLength="1" TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                                <inputLayout:SfTextInputLayout Grid.Column="1" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry x:Name="OTPSecondDigit" Text="{Binding OTPSecondDigit}" IsPassword="True" MaxLength="1" TextColor="#bbbbbb" >
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                                <inputLayout:SfTextInputLayout Grid.Column="2" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry x:Name="OTPThirdDigit" Text="{Binding OTPThirdDigit}" IsPassword="True" MaxLength="1" TextColor="#bbbbbb" >
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                                <inputLayout:SfTextInputLayout Grid.Column="3" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry x:Name="OTPFourthDigit" Text="{Binding OTPFourthDigit}" IsPassword="True" MaxLength="1" TextColor="#bbbbbb" >
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>-->


                                            </Grid>
                                            <!--<Editor TextChanged="Editor_TextChanged" Keyboard="Numeric" TextColor="Transparent" BackgroundColor="Transparent"  HorizontalOptions="FillAndExpand" Grid.Row="0"/>-->

                                        </Grid>
                                    </StackLayout>


                                    <!--<inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry Text="{Binding EnteredOTP}" Placeholder="Enter OTP" TextColor="#bbbbbb" >
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>-->


                                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                                        <Image Source="clock">
                                        </Image>
                                        <custom:CustomLabel  Text="{Binding LblCountDownTimer}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="Center" />
                                    </StackLayout>
                                    <custom:CustomLabel    Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}" HorizontalOptions="Center" HorizontalTextAlignment="Center" VerticalOptions="EndAndExpand" Margin="0,30,0,0" FontFamily="{StaticResource SSTArBold}"   TextColor="{Binding ResendOTPTextColor}">
                                          <custom:CustomLabel.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                         Command="{Binding OnResendOTPClicked}"
                                                            NumberOfTapsRequired="1">
                                                        </TapGestureRecognizer>
                                                    </custom:CustomLabel.GestureRecognizers>
                                    </custom:CustomLabel>
                                </StackLayout>
                                                                                  
                            </StackLayout>


                            <!--                        End of Verification Code-->


                           <!--Start of Password View-->
                            <StackLayout IsVisible="{Binding PasswordLayoutVisibility}">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.Password}" Style="{StaticResource PageTitleBlack}" />
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.CreateASecurePassword}" Style="{StaticResource BodyLabelGrey}"/>
                                <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1"/>

                                <StackLayout Padding="0,20,0,0" Spacing="15">
                                    <StackLayout>
                                        <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.NDNewPassword}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                        <inputLayout:SfTextInputLayout LeadingViewPosition="Inside" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                            <inputLayout:SfTextInputLayout.TrailingView>

                                                <Image x:Name="NewPasswordIcon" HorizontalOptions="Center" VerticalOptions="Center" Source="hidePassword.png" >
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Tapped="OnNewPasswordTapped"
                                                            NumberOfTapsRequired="1">
                                                        </TapGestureRecognizer>
                                                    </Image.GestureRecognizers>
                                                </Image>

                                            </inputLayout:SfTextInputLayout.TrailingView>
                                            <custom:BorderlessEntry x:Name="NewPassword"
                                                                    Text="{Binding NewPassword}"
                                                                    TextChanged="NewPassword_TextChanged"
                                                                    Grid.Column="0" MaxLength="16" IsPassword="True">
                                                  <custom:BorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:PasswordTextBehaviour />
                                                        </custom:BorderlessEntry.Behaviors>
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>


                                    <StackLayout >
                                        <custom:CustomLabel   Text="{x:Static ResourceManager:AppResources.ZZConfirmpassword}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                        <inputLayout:SfTextInputLayout LeadingViewPosition="Inside" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">

                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                <Image x:Name="ConfirmNewPasswordIcon" HorizontalOptions="Center" VerticalOptions="Center"  Source="hidePassword.png">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Tapped="OnConfirmNewPasswordTapped"
                                                            NumberOfTapsRequired="1">
                                                        </TapGestureRecognizer>
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </inputLayout:SfTextInputLayout.TrailingView>

                                            <custom:BorderlessEntry x:Name="ConfirmNewPassword"
                                                                    Text="{Binding ConfirmPassword}"
                                                                    Grid.Column="0" MaxLength="16" IsPassword="True">
                                                <custom:BorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:PasswordTextBehaviour />
                                                        </custom:BorderlessEntry.Behaviors>
                                            </custom:BorderlessEntry>

                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>
                                </StackLayout>

                                <StackLayout x:Name="PasswordChecks" Padding="0,15,0,0">
                                    <StackLayout Orientation="Horizontal">
                                        <Image Source="{Binding MinEight}">

                                        </Image>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDAtleast8character}" Style="{StaticResource CaptionLabelBlack}" Padding="5,0,0,0"/>
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal">
                                        <Image Source="{Binding CapsSmall}">

                                        </Image>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDEnglishcapitalandsmallletters}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal">
                                        <Image Source="{Binding MaxSixteen}">

                                        </Image>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZZNotexceed16characters}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal">
                                        <Image Source="{Binding NumSymbol}">

                                        </Image>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDNumbersAndSymbols}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                                    </StackLayout>
                                </StackLayout>

                            </StackLayout>
                            <!--End of Password View-->



                        </StackLayout>
                    </ScrollView>




                    <StackLayout Grid.Row="2" Margin="20,0,20,0"  Padding="0,8,0,0" BackgroundColor="White">
                        <buttons:SfButton Command="{Binding OnContinueClick}" x:Name="btnprimary" Text="{Binding ContinueORConfirmButtonText}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding ContinueButtonEnability}" Margin="0,0,0,10"/>
                    </StackLayout>

                    <Grid Grid.Row="0" Margin="20,0,20,0" BackgroundColor="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10*"/>
                            <ColumnDefinition Width="80*"/>
                            <ColumnDefinition Width="10*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="1" Source="ic_logo_gazt.png" WidthRequest="50" HeightRequest="50" VerticalOptions="Center" Margin="0,4,0,0" HorizontalOptions="Center"/>

                        <Image Grid.Column="0" Grid.Row="0" Source="arrowLeft.png"  HorizontalOptions="Start" VerticalOptions="CenterAndExpand"   Style="{DynamicResource BackButtonArrow}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTapped"/>
                            </Image.GestureRecognizers>
                        </Image>

                        <Image Grid.Column="2" Source="closeGrey.png" IsVisible="False">
                            
                        </Image>
                    </Grid>

                    <StackLayout Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Padding="-20,-20,-20,-10" BackgroundColor="#005e4b" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsVisible="{Binding RecoverUserNameLayout}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15*" />
                                <RowDefinition Height="15*" />
                                <RowDefinition Height="10*" />
                                <RowDefinition Height="15*" />
                                <RowDefinition Height="26*" />
                                <RowDefinition Height="12*" />
                                <RowDefinition Height="7*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="icon.png" Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center">

                            </Image>
                            <custom:CustomLabel Grid.Row="2" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" Text="{x:Static ResourceManager:AppResources.RecoverUserName}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                            <custom:CustomLabel Grid.Row="3" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" Text="{x:Static ResourceManager:AppResources.UsernameSentToTheRegisteredEmailEndMobileNumber}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" Padding="5,0,0,0"/>
                            <buttons:SfButton Grid.Row="5" Grid.Column="0" Command="{Binding OnLogInClick}"  Text="{x:Static ResourceManager:AppResources.LogIn}"  Style="{StaticResource PrimaryButtonStyle}" Margin="5,0,0,0"/>
                            <!--<custom:CustomLabel Grid.Row="6" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" Text="{x:Static ResourceManager:AppResources.CheckEmail}"  Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>-->

                        </Grid>
                    </StackLayout>


                    <StackLayout Padding="-20,-20,-20,-10" Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" BackgroundColor="#005e4b" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsVisible="{Binding RecoverPasswordLayout}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15*" />
                                <RowDefinition Height="15*" />
                                <RowDefinition Height="10*" />
                                <RowDefinition Height="10*" />
                                <RowDefinition Height="38*" />
                                <RowDefinition Height="12*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="icon.png" Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center">

                            </Image>
                            <custom:CustomLabel Grid.Row="2"  Grid.Column="0" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" Text="{x:Static ResourceManager:AppResources.RecoverPassword}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                            <custom:CustomLabel Grid.Row="3" Grid.Column="0" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" Text="{x:Static ResourceManager:AppResources.NewPasswordUpdatedSuccessfully}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                            <buttons:SfButton Grid.Row="5" Grid.Column="0" Command="{Binding OnLogInClick}" Text="{x:Static ResourceManager:AppResources.LogIn}"  Style="{StaticResource PrimaryButtonStyle}"/>

                        </Grid>
                    </StackLayout>


                </Grid>
                <Grid Grid.Row="0"    Grid.Column="0"   IsVisible="{Binding IsLoading}" Padding="-20,-20,-20,-10">
                    <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                    </StackLayout>
                    <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="Center"
                                           IsBusy="{Binding IsLoading}"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#006450"/>
                        </StackLayout>
                        <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                    </StackLayout>
                </Grid>
            </Grid>
         
        </yummy:PancakeView>
	</ContentPage.Content>
</ContentPage>