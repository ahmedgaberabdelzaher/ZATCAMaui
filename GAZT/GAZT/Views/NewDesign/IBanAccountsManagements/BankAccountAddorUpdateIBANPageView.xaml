<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:yummyy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             NavigationPage.HasNavigationBar="False"
             x:Name="IBanReg" 
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:custom="clr-namespace:GAZT" xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common" 
             xmlns:behaviors="clr-namespace:EGAZT.SyncFusionEnabledBehaviors.Behaviors"
             BackgroundImageSource="partials_background"
             x:Class="EGAZT.Views.NewDesign.IBanAccountsManagements.BankAccountAddorUpdateIBANPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>


            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.AddNewIban}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"
                               Source="arrowLeftwhite" x:Name="Image_BacKIcon"  Style="{DynamicResource BackButtonArrow}" >
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                    <yummyy:PancakeView  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,0,0,0" BackgroundColor="White" x:Name="VATRMainGrid">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummyy:PancakeView>
                </StackLayout>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <commonView:PageIndicatorView Margin="20,32,20,0" MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}" VerticalOptions="CenterAndExpand" DotSize="16"/>
                </Grid>
                <Grid Grid.Row="1" IsVisible="{Binding NewFormVisible}">
                    <Grid  BackgroundColor="Transparent" Margin="20,0,20,0"
                      HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" RowSpacing="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="80" />
                            <RowDefinition Height="80" />
                            <RowDefinition Height="80" />
                            <RowDefinition Height="80" />
                            <RowDefinition Height="80" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                            Text="{x:Static ResourceManager:AppResources.CRRequestDetails}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                            Text="{x:Static ResourceManager:AppResources.CRCompleteBelowDetails}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <Grid Grid.Row="1" WidthRequest="171">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>


                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"  Style="{StaticResource ValueLabelBlack}" HorizontalOptions="StartAndExpand">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.IBANAccName}"  />
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}">
                                <custom:BorderlessEntry x:Name="AccountOwnerName"
                                                    HorizontalOptions="FillAndExpand"
                                                            Text="{Binding AccountOwnerName}"
                                                            TextChanged="AccountOwnerNameTextChanged"
                                                            TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="15"/>
                            </border:SfBorder>

                        </Grid>


                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" >
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.IBANIdType}"  />
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding SelectedIDType}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />

                                    <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                         Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                        </Image.Source>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowIDTypePicker}"/>
                                        </Image.GestureRecognizers>
                                    </Image>


                                </Grid>
                            </border:SfBorder>

                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" >
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.IBANIdNumber}"  />
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding SelectedIDNumber}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />

                                    <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                         Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                        </Image.Source>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowIDNumberPicker}"/>
                                        </Image.GestureRecognizers>
                                    </Image>


                                </Grid>
                            </border:SfBorder>

                        </Grid>
                        <StackLayout Margin="0,0,0,15" Grid.Row="4">
                            <Frame BorderColor="#bbbbbb" BackgroundColor="White" CornerRadius="10" Padding="15,20,15,20" HasShadow="False">
                                <StackLayout>
                                    <Grid >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>

                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Style="{StaticResource SmallIcon}" HorizontalOptions="Start" Grid.Row="0" Grid.Column="0" VerticalOptions="Start">
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont" Color="#909090" Size="30"
                                                        Glyph="{x:Static FontImage:IconFonts.Information}"/>
                                            </Image.Source>
                                        </Image>
                                        <Label HorizontalTextAlignment="Start" Grid.Column="1" Grid.Row="0" Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.IBANRefundInfo}" />
                                    </Grid>
                                </StackLayout>
                            </Frame>
                        </StackLayout>

                        <Grid Grid.Row="5" WidthRequest="171">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>


                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"  Style="{StaticResource ValueLabelBlack}" HorizontalOptions="StartAndExpand">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.IBAN}"  />
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}">
                                <custom:BorderlessEntry x:Name="BankAccountIBAN"
                                                    HorizontalOptions="FillAndExpand"
                                                             TextChanged="IBANTextChanged"
                                                            Text="{Binding IBANValue}"
                                                            Unfocused="IBANFocusChnaged"
                                                            TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="15">
                                    <Entry.Behaviors>
                                        <behaviors:EntryLengthValidatorBehavior MaxLength="24"/>
                                    </Entry.Behaviors>
                                </custom:BorderlessEntry>
                            </border:SfBorder>

                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" >
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.IBANBankName}"  />
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding SelectedBankName}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />

                                    <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                         Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                        </Image.Source>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowBankNamePicker}"/>
                                        </Image.GestureRecognizers>
                                    </Image>


                                </Grid>
                            </border:SfBorder>

                        </Grid>
                        <Grid Grid.Row="7" IsVisible="{Binding OtherBanksVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"  Style="{StaticResource ValueLabelBlack}" HorizontalOptions="StartAndExpand">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="Other Bank Name"  />
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}">
                                <custom:BorderlessEntry 
                                                   x:Name="OtherBankName"
                                                    HorizontalOptions="FillAndExpand"
                                                             TextChanged="OtherBanksTextChanged"
                                                            Unfocused="OtherBanksFocusChnaged"
                                                            TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="15">
                                    <Entry.Behaviors>
                                        <behaviors:EntryLengthValidatorBehavior MaxLength="40"/>
                                    </Entry.Behaviors>
                                </custom:BorderlessEntry>
                            </border:SfBorder>
                        </Grid>

                        <Grid Grid.Row="8">

                            <buttons:SfButton  Margin="0,16,0,16" 
                                          Text="{x:Static ResourceManager:AppResources.CRContinue}"
                                          Style="{StaticResource PrimaryButtonStyle}"
                                           HeightRequest="48"
                                           WidthRequest="366"
                                          Command="{Binding ContinueButtonTapped}" />
                        </Grid>

                    </Grid>

                </Grid>

                <Grid Grid.Row="1" IsVisible="{Binding SummaryVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                      HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />

                    </Grid.RowDefinitions>

                    <StackLayout Orientation="Vertical" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">

                        <Grid Margin="0,5,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.CRSummary}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource PageTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                                Text="{x:Static ResourceManager:AppResources.CRReviewthebelowinformation}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <border:SfBorder Margin="0,16,0,10" HasShadow="False"
                                         Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Orientation="Vertical">

                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                           Opacity=".2" IsClippedToBounds="True"
                                           BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                           HasShadow="False" />
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                           Source="details" />
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                 Padding="8,0">
                                        <Label Text="{x:Static ResourceManager:AppResources.CRRequestDetails}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource SectionTitleBlackBold}" />
                                    </StackLayout>
                                    <StackLayout HorizontalOptions="Center" Grid.Row="0" Grid.Column="2" Padding="0,0">
                                        <Label 
                                               Text="{x:Static ResourceManager:AppResources.CREdit}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding GoBackToNewForm}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />


                                <Grid Padding="15,15,15,15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <StackLayout Grid.Row="0" Grid.Column="0">
                                        <Label Text="{x:Static ResourceManager:AppResources.NDBankAccOwnerName}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                    </StackLayout>
                                    <StackLayout Grid.Row="0" Grid.Column="1" >
                                        <Label Text="{Binding AccountOwnerName}" Style="{StaticResource SectionTitleSmallMediumBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                    </StackLayout>
                                    <StackLayout Grid.Row="1" Grid.Column="0">
                                        <Label Text="{x:Static ResourceManager:AppResources.NDBankAccIDType}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                    </StackLayout>
                                    <StackLayout Grid.Row="1" Grid.Column="1" >
                                        <Label Text="{Binding SelectedIDType}" Style="{StaticResource SectionTitleSmallMediumBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                    </StackLayout>
                                    <StackLayout Grid.Row="2" Grid.Column="0">
                                        <Label Text="{x:Static ResourceManager:AppResources.NDBankAccIdNumber}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                    </StackLayout>
                                    <StackLayout Grid.Row="2" Grid.Column="1" >
                                        <Label Text="{Binding SelectedIDNumber}" Style="{StaticResource SectionTitleSmallMediumBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                    </StackLayout>
                                    <StackLayout Grid.Row="3" Grid.Column="0">
                                        <Label Text="{x:Static ResourceManager:AppResources.NDBankAccIBAN}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                    </StackLayout>
                                    <StackLayout Grid.Row="3" Grid.Column="1" >
                                        <Label Text="{Binding IBANValue}" Style="{StaticResource SectionTitleSmallMediumBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                    </StackLayout>
                                    <StackLayout Grid.Row="4" Grid.Column="0">
                                        <Label Text="{x:Static ResourceManager:AppResources.NDBankAccBankName}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                    </StackLayout>
                                    <StackLayout Grid.Row="4" Grid.Column="1" >
                                        <Label Text="{Binding SelectedBankName}" Style="{StaticResource SectionTitleSmallMediumBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                    </StackLayout>
                                </Grid>

                            </StackLayout>

                        </border:SfBorder>
                        

                        <border:SfBorder Margin="0,16,0,10" Padding="0,0,0,16" HasShadow="False"
                                         Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Padding="15,15,15,0" VerticalOptions="FillAndExpand" BackgroundColor="White">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="340"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Row="0" Grid.Column="0">
                                        <Image >
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                                 Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                                            </Image.Source>

                                        </Image>
                                    </Grid>

                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <Label Text="{x:Static ResourceManager:AppResources.CRInformation}"
                                               HorizontalOptions="Start"
                                               Style="{StaticResource BodyLabelBlack}" />
                                    </Grid>

                                    <custom1:CheckboxCustom  Grid.Row="1" Grid.Column="0" IsChecked="{Binding IsInstrunctionChecked}" WidthRequest="32" HeightRequest="32"
                                                                        x:Name="chkDeclaration"  VerticalOptions="CenterAndExpand"/>
                                    <custom:CustomLabel Grid.Row="1" Grid.Column="1" x:Name="AckText" Style="{StaticResource BodyLabelGrey}"/>

                                </Grid>

                                
                        <!--<Label  x:Name="AckText" 
                                       HorizontalOptions="Start"
                                       VerticalOptions="Start"
                                       Style="{StaticResource BodyLabelGrey}" />-->
                                
                                

                            </StackLayout>

                        </border:SfBorder>

                        <buttons:SfButton  IsEnabled="{Binding IsContinueButtonEnable}" Margin="0,16,0,16"
                                          Text="{x:Static ResourceManager:AppResources.Confirm}"
                                          Style="{StaticResource PrimaryButtonStyle}"
                                          
                                          Command="{Binding SummaryConBtnTapped}"
                                          HeightRequest="48"
                                          WidthRequest="366"/>

                    </StackLayout>
                </Grid>

            </Grid>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>

