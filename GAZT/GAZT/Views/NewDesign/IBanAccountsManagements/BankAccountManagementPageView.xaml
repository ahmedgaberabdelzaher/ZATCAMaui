                                                            <DataTrigger TargetType="Frame" Binding="{Binding StatusText}" Value="Update">
                                                                <Setter Property="BackgroundColor" Value="Orange" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Frame" Binding="{Binding StatusText}" Value="Activate">
                                                                <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}" />
                                                            </DataTrigger>
                                                        </Frame.Triggers>-->
                                                            <StackLayout Grid.Row="0"  HorizontalOptions="CenterAndExpand" VerticalOptions="Center">
                                                                <!--TextColor="{Binding Status,Converter={StaticResource StringToColorConvertor}}" -->
                                                                <Label Style="{StaticResource CaptionLabelWhite}" 
                                                                             Text="{Binding StatusText}" HorizontalOptions="CenterAndExpand"  
                                                                                VerticalOptions="CenterAndExpand" >

                                                                </Label>
                                                            </StackLayout>
                                                        </Frame>


