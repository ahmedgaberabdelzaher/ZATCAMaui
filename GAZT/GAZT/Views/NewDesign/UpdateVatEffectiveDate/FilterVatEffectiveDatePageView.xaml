<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom2="clr-namespace:EGAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:local="clr-namespace:EGAZT"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:cards1="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             NavigationPage.HasNavigationBar="False" 
             BackgroundColor="#006450"
             x:Class="EGAZT.Views.NewDesign.UpdateVatEffectiveDate.FilterVatEffectiveDatePageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>

                    <Style x:Key="FilterArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="FilterArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>



    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0"
                              Padding="0,0,0,0">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand"
                                              Grid.Column="0"
                                              Grid.Row="0" BackgroundColor="White" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="24,10,24,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static ResourceManager:AppResources.AccountStatementsFilterTitle}"
                               Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center" />

                        <Image Grid.Row="0" Grid.Column="2"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand"
                               Source="close"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.FilterCloseClick}" />
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <Grid>
            <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                <Grid BackgroundColor="Transparent" Margin="20,10,20,0" HorizontalOptions="FillAndExpand"
                      VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120" />
                        <RowDefinition Height="120" />
                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" >
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.EffectUpdatedBy}"  />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding SelectedUpdatedSortText}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />

                                <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                         Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                    </Image.Source>
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowDateSortTypePicker}"/>
                                    </Image.GestureRecognizers>
                                </Image>


                            </Grid>
                        </border:SfBorder>

                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" >
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.SortEffectiveDateAUpdate}"  />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding SelectedDateSortText}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />

                                <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                         Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                    </Image.Source>
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowUpdatedByTypePicker}"/>
                                    </Image.GestureRecognizers>
                                </Image>


                            </Grid>
                        </border:SfBorder>

                    </Grid>



                    <buttons:SfButton Grid.Row="2" Grid.Column="0" VerticalOptions="End" Margin="0,60,0,60" x:Name="btnReasonContinue"
                                      Command="{Binding FilterBtnCommand}"
                                      Text="{x:Static ResourceManager:AppResources.ACFilterApply}"
                                      Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>

            </ScrollView>
            <!--{Binding IsLoading}-->
            <Grid Grid.Row="0" Grid.Column="0" IsVisible="False" Margin="0,-20,0,0"
                  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4"
                             VerticalOptions="FillAndExpand" />
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent"
                             Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding"
                                                       EnableAnimation="True"
                                                       AnimationType="SingleCircle"
                                                       HorizontalOptions="CenterAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                                       IsBusy="True"
                                                       ViewBoxWidth="70"
                                                       TitlePlacement="Bottom"
                                                       ViewBoxHeight="70"
                                                       TextColor="#D99A29" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>

    </ContentPage.Content>
</ContentPage>