<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:custom="clr-namespace:GAZT"
              xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             x:Class="EGAZT.Views.NewDesign.VATRefunds.VATRefundsNewRequestPageView"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" 
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms" 
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" 
             NavigationPage.HasNavigationBar="False"  BackgroundImageSource="partials_background.png" >
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>
                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.VATRefund}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                        <Image Grid.Row="0" Grid.Column="0" Style="{DynamicResource BackButtonArrow}" IsVisible="{Binding IsBackStepButtonVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand" Source="arrowLeftwhite">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <StackLayout  Grid.Row="0" Grid.Column="2">
                            <StackLayout Spacing="3" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Orientation="Horizontal" Rotation="90">
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                            </StackLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnMoreClicked}"/>
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                        <!--<Image Grid.Row="0" Grid.Column="2"  Source="close" IsVisible="{TemplateBinding BindingContext.IsVoidBtnVisible}" VerticalOptions="Center" HorizontalOptions="End">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="VoidButton_Tapped"/>
                            </Image.GestureRecognizers>
                        </Image>-->
                    </Grid>

                    <yummy:PancakeView  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" Padding="0" BackgroundColor="White" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Grid.Column="0" Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <ScrollView>
                <Grid>
                    <Grid IsVisible="true" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="40*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="1"/>
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VATRefundDetails}" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource SectionTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}"/>
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>
                        </Grid>

                        <StackLayout  Grid.Row="1" Grid.ColumnSpan="2" Spacing="15" Margin="0,0,0,7">

                            <StackLayout>
                                <Frame BorderColor="#bbbbbb" BackgroundColor="White" CornerRadius="10" Padding="15,15,15,15" HasShadow="False">
                                    <StackLayout Orientation="Horizontal" >
                                        <Image Source="ic_vat_info" VerticalOptions="StartAndExpand"/>
                                        <custom:CustomLabel  HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand" Text="{x:Static ResourceManager:AppResources.IBanRefundsInfo}" LineSpacing="1" VerticalOptions="EndAndExpand"   />
                                    </StackLayout>
                                </Frame>
                            </StackLayout>
                        </StackLayout>



                        <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="1"  Margin="0,16,0,0" IsEnabled="{Binding IsTypeEditable}" >
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZIDType}" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}" />
                            <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="0,0,0,10"  Style="{StaticResource GreyBorderFrame}">

                                <StackLayout Orientation="Horizontal"  Padding="5,15,5,15">

                                    <Label Text="{Binding SelectedIdtype}" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Start"/>
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                        <Image Grid.Row="0" Grid.Column="1" Source="arrowDropdown" Margin="5,0" WidthRequest="15" HeightRequest="15"
                                        HorizontalOptions="Start" VerticalOptions="Center">
                                        </Image>
                                    </StackLayout>

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding IbanIdTypeTapped}" ></TapGestureRecognizer>
                                    </StackLayout.GestureRecognizers>

                                </StackLayout>
                            </border:SfBorder >
                        </StackLayout>

                        <StackLayout Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="1"  Margin="0,16,0,0" IsEnabled="{Binding IsTypeEditable}">
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.IDNumber}" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}" />
                            <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="0,0,0,10"  Style="{StaticResource GreyBorderFrame}">

                                <StackLayout Orientation="Horizontal"  Padding="5,15,5,15">

                                    <Label Text="{Binding SelectedIdNumber}" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Start"/>
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                        <Image Grid.Row="0" Grid.Column="1" Source="arrowDropdown" Margin="5,0" WidthRequest="15" HeightRequest="15"
                                        HorizontalOptions="Start" VerticalOptions="Center">
                                        </Image>
                                    </StackLayout>

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding IbanIdNumberTapped}" ></TapGestureRecognizer>
                                    </StackLayout.GestureRecognizers>

                                </StackLayout>
                            </border:SfBorder >
                        </StackLayout>

                        <StackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,8" >
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VATRefundAccounts}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}" />
                            <border:SfBorder   Style="{StaticResource GreyBorderFrameWithShadow}" IsVisible="{Binding IsAddAccountVisisble}">
                                <StackLayout Orientation="Horizontal"  Padding="15,10,15,10" IsVisible="{Binding IsAddAccountVisisble}">
                                    <Image Source="add" HeightRequest="20" WidthRequest="20">
                                    </Image>
                                    <Label Margin="8,0,8,0" Text="{x:Static ResourceManager:AppResources.VATRefundsAddAccount}" Style="{StaticResource ValueLabelPrimary}" HorizontalOptions="Start"/>
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="NewAccount_Clicked">

                                        </TapGestureRecognizer>
                                    </StackLayout.GestureRecognizers>
                                </StackLayout>
                            </border:SfBorder >
                        </StackLayout>

                        <listView:SfListView x:Name="BankOptionsListView" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                          ItemsSource="{Binding IbanData}" SelectedItem="{Binding SelectedIbanData, Mode=TwoWay}"  SelectionMode="Single"
                                          SelectionBackgroundColor="Transparent" SelectionChanged="BankOptionsListView_SelectionChanged" >
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <cards:SfCardView HasShadow="False" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="136" WidthRequest="171">
                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="0" RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30*"/>
                                                <RowDefinition Height="70*"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Source="unselected171x136" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                            <StackLayout  Grid.Row="1" Grid.Column="0" Grid.RowSpan="4" Spacing="0" Margin="5,0,5,30">
                                                <Image Margin="15,0,15,15" IsVisible="false"  HeightRequest="32" WidthRequest="32"  Source="positive" Aspect="Fill" HorizontalOptions="End" VerticalOptions="Center"/>

                                                <Label  Text="" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="Start" VerticalOptions="End"
                                                                        Margin="20,0,20,0" TextColor="Black" HorizontalTextAlignment="Start" LineHeight="0.8">
                                                </Label>
                                                <Label Text="{Binding Iban}" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="EndAndExpand" VerticalOptions="EndAndExpand"
                                                                        Margin="20,0,20,0" TextColor="Black" HorizontalTextAlignment="Start" LineHeight="0.8">
                                                </Label>
                                            </StackLayout>

                                        </Grid>
                                    </cards:SfCardView>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                            <listView:SfListView.SelectedItemTemplate>
                                <DataTemplate>
                                    <cards:SfCardView HasShadow="False" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="136" WidthRequest="171">
                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="0" RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30*"/>
                                                <RowDefinition Height="70*"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Source="re_Tile_Background_S" Aspect="AspectFit" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                            <StackLayout Grid.Row="1" Grid.Column="0" Grid.RowSpan="4" Spacing="0" Margin="5,0,5,30">
                                                <Image Margin="15,0,15,15" IsVisible="false" HeightRequest="32" WidthRequest="32"  Source="negative" Aspect="Fill" HorizontalOptions="End" VerticalOptions="Center"/>

                                                <Label  Text="{Binding BankDetails.IBAN}" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="Start" VerticalOptions="End"
                                                                        Margin="20,0,20,0" TextColor="White" HorizontalTextAlignment="Start" LineHeight="0.8">
                                                </Label>
                                                <Label Text="{Binding Iban}" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="EndAndExpand" VerticalOptions="EndAndExpand"
                                                                        Margin="20,0,20,0" TextColor="White" HorizontalTextAlignment="Start" LineHeight="0.8">
                                                </Label>
                                            </StackLayout>

                                        </Grid>
                                    </cards:SfCardView>
                                </DataTemplate>
                            </listView:SfListView.SelectedItemTemplate>
                            <listView:SfListView.LayoutManager>
                                <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                            </listView:SfListView.LayoutManager>
                        </listView:SfListView>

                        <StackLayout  Grid.Row="5" Grid.ColumnSpan="2" Spacing="15" Margin="0,0,0,7">
                            <StackLayout>
                                <Frame BorderColor="#bbbbbb" BackgroundColor="White" CornerRadius="10" Padding="15,15,15,15" HasShadow="False">
                                    <StackLayout Orientation="Horizontal" >
                                        <Image Source="ic_vat_info"/>
                                        <custom:CustomLabel  HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand" LineSpacing="1" VerticalOptions="EndAndExpand"   >
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.PleaseGoToIBan}"/>
                                                    <Span Text="{x:Static ResourceManager:AppResources.VisitIBanManagement}" TextColor="#006450" >
                                                        <Span.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="IBANAccManagementTapped"></TapGestureRecognizer>
                                                        </Span.GestureRecognizers>
                                                    </Span>
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>
                                    </StackLayout>
                                </Frame>
                            </StackLayout>
                        </StackLayout>


                        <border:SfBorder Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" BorderColor="#B1B1B1" BorderWidth="1"  Margin="0,20,0,10"  Style="{StaticResource GreyBorderFrame}">
                            <StackLayout Margin="8">
                                <StackLayout Orientation="Horizontal" Spacing="0">
                                    <Image HeightRequest="24" WidthRequest="24" Source="information" HorizontalOptions="Start" VerticalOptions="Center"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.Information}" Margin="10,0,10,0"  HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource ValueLabelBlack}"/>
                                </StackLayout>
                                <Label Text="{x:Static ResourceManager:AppResources.ZVatRefundRequestUpdateIBANInfo}" HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}" />

                            </StackLayout>
                        </border:SfBorder>
                        <Frame HasShadow="False" Opacity="0.1"  Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="{StaticResource Primary}" Margin="0,16,0,8" CornerRadius="15" Padding="18" HeightRequest="24" HorizontalOptions="FillAndExpand">
                        </Frame>
                        <StackLayout Orientation="Horizontal" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2">
                            <StackLayout Orientation="Horizontal" HorizontalOptions="Start" VerticalOptions="Center" Padding="16,8,16,0">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VATRefundAmounts}" LineSpacing="0.8" Style="{StaticResource BodyLabelBlack}" />
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" HorizontalOptions="End" VerticalOptions="Center" Padding="16,8,16,0">
                                <custom:CustomLabel Style="{StaticResource SectionTitleBlackBold}" HorizontalOptions="EndAndExpand">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding VatRefundsDisplayDataModel.Rfamt,Converter={StaticResource commaSeparatorConverter}}" Style="{StaticResource SectionTitleBlackBold}" ></Span>
                                            <Span Text=" "/>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"/>
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                            </StackLayout>
                        </StackLayout>
                        <border:SfBorder Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" BorderColor="#B1B1B1" BorderWidth="1"  Margin="0,20,0,10"  Style="{StaticResource GreyBorderFrame}">
                            <StackLayout Margin="8">
                                <StackLayout Orientation="Horizontal" Spacing="0">
                                    <Image HeightRequest="24" WidthRequest="24" Source="information" HorizontalOptions="Start" VerticalOptions="Center"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.Information}" Margin="10,0,10,0"  HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource ValueLabelBlack}"/>
                                </StackLayout>
                                <Label Text="{x:Static ResourceManager:AppResources.ZVatRefundRequestConfirmationMessage}" HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}" />

                            </StackLayout>
                        </border:SfBorder>
                        <buttons:SfButton Grid.Row="11" Grid.Column="0" HeightRequest="48"
                                       Grid.ColumnSpan="2" Margin="0,0,0,16"  x:Name="btnReasonContinue" Clicked="ContinueButton_Tapped" Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                                    Style="{StaticResource PrimaryButtonStyle}"/>

                    </Grid>

                </Grid>
            </ScrollView>
            <Grid Grid.Row="0" Grid.Column="0"  IsVisible="{Binding IsLoading}" Margin="0,-20,0,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#D99A29"/>
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>

    </ContentPage.Content>
</ContentPage>
