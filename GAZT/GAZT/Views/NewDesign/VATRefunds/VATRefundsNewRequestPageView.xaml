<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             x:Class="EGAZT.Views.NewDesign.VATRefunds.VATRefundsNewRequestPageView"
             xmlns:ResourceManager="clr-namespace:EGAZT" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms" NavigationPage.HasNavigationBar="False"  BackgroundImageSource="partials_background.png" >
      <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>
                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.VATRefund}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand" Source="arrowLeftwhite">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}"/>
                            </Image.GestureRecognizers>
                        </Image>
                        
                    </Grid>

                    <yummy:PancakeView  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" Padding="0" BackgroundColor="White" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Grid.Column="0" Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
         <ScrollView>
                   <Grid IsVisible="true" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                     <RowDefinition Height="auto"/>
                     <RowDefinition Height="auto"/>
                     <RowDefinition Height="auto"/>
                     <RowDefinition Height="auto"/>
                     <RowDefinition Height="auto"/>
                     <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>
                 <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.RowDefinitions>
                     <RowDefinition Height="auto"/>
                     <RowDefinition Height="auto"/>
                     <RowDefinition Height="1"/>
                    </Grid.RowDefinitions>
                    <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VATRefundDetails}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}" />
                    <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
                    <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>
                </Grid>

            
                <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1"  Margin="0,16,0,0" >
                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZIDType}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}" />   
                    <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="0,0,0,10"  Style="{StaticResource GreyBorderFrame}">

                        <StackLayout Orientation="Horizontal"  Padding="5,15,5,15">
                                        
                            <Label Text="{x:Static ResourceManager:AppResources.ZZIDType}" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Start"/>
                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                    <Image Grid.Row="0" Grid.Column="1" Source="arrowDropdown" Margin="5,0" WidthRequest="15" HeightRequest="15"
                                    HorizontalOptions="Start" VerticalOptions="Center">
                                    </Image>
                            </StackLayout>

                            <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OnTinRegisrtationDateClicked}" ></TapGestureRecognizer>
                            </StackLayout.GestureRecognizers>

                        </StackLayout>
                    </border:SfBorder >
                </StackLayout>

                <StackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" Margin="0,16,0,0">
                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.IDNumber}" HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}" />     
                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
						ContainerType="Outlined" UnfocusedColor="#B1B1B1"
						OutlineCornerRadius="13" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                        <custom:BorderlessEntry Placeholder="{x:Static ResourceManager:AppResources.IDNumber}" FontSize="Small"  HorizontalTextAlignment="Start"
                                                VerticalTextAlignment="Start"
                                                TextColor="#bbbbbb" HorizontalOptions="StartAndExpand">
                        </custom:BorderlessEntry>
                    </inputLayout:SfTextInputLayout>
                </StackLayout>

                <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,8">
                    <custom:CustomLabel Text="Accounts" HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}" />   
                    <border:SfBorder   Style="{StaticResource GreyBorderFrameWithShadow}" >
                    <StackLayout Orientation="Horizontal"  Padding="15,10,15,10">
                        <Image Source="add" HeightRequest="20" WidthRequest="20">
                        </Image>
                        <Label Margin="8,0,8,0" Text="Add Account" Style="{StaticResource ValueLabelPrimary}" HorizontalOptions="Start"/>
                        <StackLayout.GestureRecognizers>
                           <TapGestureRecognizer Tapped="NewAccount_Clicked">

                           </TapGestureRecognizer>
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                </border:SfBorder >
                </StackLayout>
                

                <listView:SfListView x:Name="BankOptionsListView" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding VATRefundsModel}" SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"  SelectionMode="Single"
                                      SelectionBackgroundColor="Transparent" SelectionChanged="BankOptionsListView_SelectionChanged" >
                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
					                <cards:SfCardView HasShadow="False" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="136" WidthRequest="171">
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="0" RowSpacing="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30*"/>
                                                    <RowDefinition Height="70*"/>
                                                <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                 </Grid.ColumnDefinitions>
                                                <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Source="re_Tile_Background_White" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                <StackLayout Grid.Row="1" Grid.Column="0" Grid.RowSpan="4" Spacing="0" Margin="5,0,5,30">
                                                    <Image Margin="15,0,15,15" HeightRequest="32" WidthRequest="32"  Source="positive" Aspect="Fill" HorizontalOptions="End" VerticalOptions="Center"/>

                                                    <Label  Text="{Binding BankDetails.IBAN}" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="Start" VerticalOptions="End"
                                                                    Margin="20,0,20,0" TextColor="Black" HorizontalTextAlignment="Start" LineHeight="0.8">
                                                </Label>
                                                <Label Text="{Binding BankDetails.BankName}" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="Start" VerticalOptions="Start"
                                                                    Margin="20,0,20,0" TextColor="Black" HorizontalTextAlignment="Start" LineHeight="0.8">
                                                </Label>
                                                </StackLayout>

                                            </Grid>
                                    </cards:SfCardView>
			                </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                      <listView:SfListView.SelectedItemTemplate>
                            <DataTemplate>
					                <cards:SfCardView HasShadow="False" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="136" WidthRequest="171">
                                           <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="0" RowSpacing="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30*"/>
                                                    <RowDefinition Height="70*"/>
                                                <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                 </Grid.ColumnDefinitions>
                                                <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Source="re_Tile_Background_S" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                <StackLayout Grid.Row="1" Grid.Column="0" Grid.RowSpan="4" Spacing="0" Margin="5,0,5,30">
                                                    <Image Margin="15,0,15,15" HeightRequest="32" WidthRequest="32"  Source="negative" Aspect="Fill" HorizontalOptions="End" VerticalOptions="Center"/>

                                                    <Label  Text="{Binding BankDetails.IBAN}" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="Start" VerticalOptions="End"
                                                                    Margin="20,0,20,0" TextColor="White" HorizontalTextAlignment="Start" LineHeight="0.8">
                                                </Label>
                                                <Label Text="{Binding BankDetails.BankName}" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="Start" VerticalOptions="Start"
                                                                    Margin="20,0,20,0" TextColor="White" HorizontalTextAlignment="Start" LineHeight="0.8">
                                                </Label>
                                                </StackLayout>

                                            </Grid>
                                    </cards:SfCardView>
			                </DataTemplate>
                       </listView:SfListView.SelectedItemTemplate>
                        <listView:SfListView.LayoutManager>
                            <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                        </listView:SfListView.LayoutManager>
                 </listView:SfListView>

                <Frame HasShadow="False" Opacity="0.1"  Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="{StaticResource Primary}" Margin="0,16,0,8" CornerRadius="15" Padding="18" HeightRequest="24" HorizontalOptions="FillAndExpand">
                </Frame>
                <StackLayout Grid.Row="4" Grid.Column="0" Orientation="Horizontal" VerticalOptions="Center" Padding="16,8,16,0">
                     <custom:CustomLabel Text="Refund Amount" Style="{StaticResource BodyLabelBlack}" />
                </StackLayout>
                <StackLayout Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalOptions="Center" Padding="16,8,16,0">
                    <custom:CustomLabel Text="300.00 SAR" Style="{StaticResource SectionTitleBlackBold}" HorizontalOptions="EndAndExpand" />
                </StackLayout>
                <border:SfBorder Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" BorderColor="#B1B1B1" BorderWidth="1"  Margin="0,20,0,10"  Style="{StaticResource GreyBorderFrame}">
                    <StackLayout Margin="8">
                        <StackLayout Orientation="Horizontal" Spacing="0">
                            <Image HeightRequest="24" WidthRequest="24" Source="information" HorizontalOptions="Start" VerticalOptions="Center"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.Information}" Margin="10,0,0,0"  HorizontalOptions="StartAndExpand"
                                Style="{StaticResource ValueLabelBlack}"/>
                        </StackLayout>
                        <Label Text="{x:Static ResourceManager:AppResources.VATDeregistrationDeclarationAgreement}" HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}" />
                
                    </StackLayout>
                </border:SfBorder>
                <buttons:SfButton Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,16"  x:Name="btnReasonContinue" Clicked="ContinueButton_Tapped" Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                                Style="{StaticResource PrimaryButtonStyle}"/>

            </Grid>

         </ScrollView>

    </ContentPage.Content>
</ContentPage>
