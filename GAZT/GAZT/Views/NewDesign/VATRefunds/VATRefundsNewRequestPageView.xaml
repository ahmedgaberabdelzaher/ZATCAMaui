<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.VATRefunds.VATRefundsNewRequestPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>
                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.VATRefund}" />

                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding IsBackStepButtonVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <StackLayout Grid.Row="0" Grid.Column="2">
                            <StackLayout
                                HorizontalOptions="EndAndExpand"
                                Orientation="Horizontal"
                                Rotation="90"
                                Spacing="3"
                                VerticalOptions="CenterAndExpand">
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                            </StackLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnMoreClicked}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                        <!--<Image Grid.Row="0" Grid.Column="2"  Source="close" IsVisible="{TemplateBinding BindingContext.IsVoidBtnVisible}" VerticalOptions="Center" HorizontalOptions="End">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="VoidButton_Tapped"/>
                            </Image.GestureRecognizers>
                        </Image>-->
                    </Grid>

                    <yummy:PancakeView
                        Padding="0"
                        CornerRadius="14,14,0,0"
                        VerticalOptions="FillAndExpand">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <ScrollView VerticalOptions="FillAndExpand">
                <Grid VerticalOptions="Fill">
                    <Grid
                        Margin="20,10,20,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="true"
                        VerticalOptions="FillAndExpand">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="40*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource SectionTitleBlack}"
                                Text="{x:Static ResourceManager:AppResources.VATRefundDetails}" />
                            <custom:CustomLabel
                                Grid.Row="1"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource BodyLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />
                            <BoxView
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                        </Grid>


                        <StackLayout
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="1"
                            Margin="0,16,0,0">
                            <custom:CustomLabel
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                            <border:SfBorder
                                Margin="0,0,0,10"
                                BorderColor="#B1B1B1"
                                BorderWidth="1"
                                Style="{StaticResource GreyBorderFrame}">

                                <StackLayout Padding="5,15,5,15" Orientation="Horizontal">

                                    <Label
                                        FontFamily="{StaticResource SomarRegular}"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource GAZTSmallBlackLabel}"
                                        Text="{Binding SelectedIdtype}" />
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="5,0"
                                            HeightRequest="15"
                                            HorizontalOptions="Start"
                                            Source="arrowDropdown"
                                            VerticalOptions="Center"
                                            WidthRequest="15" />
                                    </StackLayout>

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding IbanIdTypeTapped}" />
                                    </StackLayout.GestureRecognizers>

                                </StackLayout>
                            </border:SfBorder>
                        </StackLayout>

                        <StackLayout
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="1"
                            Margin="0,16,0,0">
                            <custom:CustomLabel
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                            <border:SfBorder
                                Margin="0,0,0,10"
                                BorderColor="#B1B1B1"
                                BorderWidth="1"
                                Style="{StaticResource GreyBorderFrame}">

                                <StackLayout Padding="5,15,5,15" Orientation="Horizontal">

                                    <Label
                                        FontFamily="{StaticResource SomarRegular}"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource GAZTSmallBlackLabel}"
                                        Text="{Binding SelectedIdNumber}" />
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="5,0"
                                            HeightRequest="15"
                                            HorizontalOptions="Start"
                                            Source="arrowDropdown"
                                            VerticalOptions="Center"
                                            WidthRequest="15" />
                                    </StackLayout>

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding IbanIdNumberTapped}" />
                                    </StackLayout.GestureRecognizers>

                                </StackLayout>
                            </border:SfBorder>
                        </StackLayout>

                        <StackLayout
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,16,0,8">
                            <custom:CustomLabel
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.VATRefundAccounts}" />
                            <border:SfBorder IsVisible="{Binding IsAddAccountVisisble}" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="15,10,15,10"
                                    IsVisible="{Binding IsAddAccountVisisble}"
                                    Orientation="Horizontal">
                                    <Image
                                        HeightRequest="20"
                                        Source="add"
                                        WidthRequest="20" />
                                    <Label
                                        Margin="8,0,8,0"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource ValueLabelPrimary}"
                                        Text="{x:Static ResourceManager:AppResources.VATRefundsAddAccount}" />
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="NewAccount_Clicked" />
                                    </StackLayout.GestureRecognizers>
                                </StackLayout>
                            </border:SfBorder>
                        </StackLayout>


                        <listView:SfListView
                            x:Name="BankOptionsListView"
                            Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            AutoFitMode="Height"
                            HorizontalOptions="Center"
                            IsScrollBarVisible="False"
                            IsScrollingEnabled="False"
                            ItemSpacing="5"
                            ItemsSource="{Binding IbanData}"
                            SelectedItem="{Binding SelectedIbanData, Mode=TwoWay}"
                            SelectionBackgroundColor="Transparent"
                            SelectionChanged="BankOptionsListView_SelectionChanged"
                            SelectionMode="Single"
                            VerticalOptions="Center">
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <cards:SfCardView
                                        BackgroundColor="Transparent"
                                        CornerRadius="20"
                                        HasShadow="False"
                                        HeightRequest="136"
                                        WidthRequest="171">
                                        <Grid
                                            ColumnSpacing="0"
                                            HorizontalOptions="FillAndExpand"
                                            RowSpacing="10"
                                            VerticalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30*" />
                                                <RowDefinition Height="70*" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Row="0"
                                                Grid.RowSpan="3"
                                                Grid.Column="0"
                                                Aspect="Fill"
                                                HorizontalOptions="FillAndExpand"
                                                Source="vat_tile_listofsignup_W"
                                                VerticalOptions="FillAndExpand" />
                                            <StackLayout
                                                Grid.Row="1"
                                                Grid.RowSpan="2"
                                                Grid.Column="0"
                                                Margin="5,0,5,30"
                                                Spacing="0">
                                                <Image
                                                    Margin="15,0,15,15"
                                                    Aspect="Fill"
                                                    HeightRequest="32"
                                                    HorizontalOptions="End"
                                                    IsVisible="false"
                                                    Source="positive"
                                                    VerticalOptions="Center"
                                                    WidthRequest="32" />

                                                <Label
                                                    Margin="20,0,20,0"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text=""
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    VerticalOptions="End" />
                                                <Label
                                                    Margin="20,0,20,0"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{Binding Iban}"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    VerticalOptions="EndAndExpand" />
                                            </StackLayout>

                                        </Grid>
                                    </cards:SfCardView>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                            <listView:SfListView.SelectedItemTemplate>
                                <DataTemplate>
                                    <cards:SfCardView
                                        BackgroundColor="Transparent"
                                        CornerRadius="20"
                                        HasShadow="False"
                                        HeightRequest="136"
                                        WidthRequest="171">
                                        <Grid
                                            ColumnSpacing="0"
                                            HorizontalOptions="FillAndExpand"
                                            RowSpacing="10"
                                            VerticalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30*" />
                                                <RowDefinition Height="70*" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Row="0"
                                                Grid.RowSpan="3"
                                                Grid.Column="0"
                                                Aspect="Fill"
                                                HorizontalOptions="FillAndExpand"
                                                Source="vat_tile_listofsignup"
                                                VerticalOptions="FillAndExpand" />
                                            <StackLayout
                                                Grid.Row="1"
                                                Grid.RowSpan="2"
                                                Grid.Column="0"
                                                Margin="5,0,5,30"
                                                Spacing="0">
                                                <Image
                                                    Margin="15,0,15,15"
                                                    Aspect="Fill"
                                                    HeightRequest="32"
                                                    HorizontalOptions="End"
                                                    IsVisible="false"
                                                    Source="negative"
                                                    VerticalOptions="Center"
                                                    WidthRequest="32" />

                                                <Label
                                                    Margin="20,0,20,0"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{Binding BankDetails.IBAN}"
                                                    TextColor="White"
                                                    VerticalOptions="End" />
                                                <Label
                                                    Margin="20,0,20,0"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{Binding Iban}"
                                                    TextColor="White"
                                                    VerticalOptions="EndAndExpand" />
                                            </StackLayout>

                                        </Grid>
                                    </cards:SfCardView>
                                </DataTemplate>
                            </listView:SfListView.SelectedItemTemplate>
                            <listView:SfListView.LayoutManager>
                                <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                            </listView:SfListView.LayoutManager>
                        </listView:SfListView>
                        <border:SfBorder
                            Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,20,0,10"
                            BorderColor="#B1B1B1"
                            BorderWidth="1"
                            Style="{StaticResource GreyBorderFrame}">
                            <StackLayout Margin="8">
                                <StackLayout Orientation="Horizontal" Spacing="0">
                                    <Image
                                        HeightRequest="24"
                                        HorizontalOptions="Start"
                                        Source="ic_vat_info.png"
                                        VerticalOptions="Center"
                                        WidthRequest="24" />
                                    <custom:CustomLabel
                                        Margin="10,0,10,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.Information}" />
                                </StackLayout>
                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatRefundRequestUpdateIBANInfo}" />

                            </StackLayout>
                        </border:SfBorder>
                        <Frame
                            Grid.Row="5"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,16,0,8"
                            Padding="18"
                            BackgroundColor="{StaticResource Primary}"
                            CornerRadius="15"
                            HasShadow="False"
                            HeightRequest="24"
                            HorizontalOptions="FillAndExpand"
                            Opacity="0.1" />
                        <StackLayout
                            Grid.Row="5"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal">
                            <StackLayout
                                Padding="16,8,16,0"
                                HorizontalOptions="Start"
                                Orientation="Horizontal"
                                VerticalOptions="Center">
                                <custom:CustomLabel
                                    LineSpacing="0.8"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.VATRefundAmounts}" />
                            </StackLayout>
                            <StackLayout
                                Padding="16,8,16,0"
                                HorizontalOptions="End"
                                Orientation="Horizontal"
                                VerticalOptions="Center">
                                <custom:CustomLabel HorizontalOptions="EndAndExpand" Style="{StaticResource SectionTitleBlackBold}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource SectionTitleBlackBold}" Text="{Binding VatRefundsDisplayDataModel.Rfamt, Converter={StaticResource commaSeparatorConverter}}" />
                                            <Span Text=" " />
                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                            </StackLayout>
                        </StackLayout>
                        <border:SfBorder
                            Grid.Row="6"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,20,0,10"
                            BorderColor="#B1B1B1"
                            BorderWidth="1"
                            Style="{StaticResource GreyBorderFrame}">
                            <StackLayout Margin="8">
                                <StackLayout Orientation="Horizontal" Spacing="0">
                                    <Image
                                        HeightRequest="24"
                                        HorizontalOptions="Start"
                                        Source="ic_vat_info.png"
                                        VerticalOptions="Center"
                                        WidthRequest="24" />
                                    <custom:CustomLabel
                                        Margin="10,0,10,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.Information}" />
                                </StackLayout>
                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatRefundRequestConfirmationMessage}" />

                            </StackLayout>
                        </border:SfBorder>
                        <buttons:SfButton
                            x:Name="btnReasonContinue"
                            Grid.Row="8"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,16"
                            Clicked="ContinueButton_Tapped"
                            HeightRequest="48"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" />

                    </Grid>

                </Grid>
            </ScrollView>
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,-20,0,0"
                HorizontalOptions="FillAndExpand"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="True"
                            TextColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>

    </ContentPage.Content>
</ContentPage>
