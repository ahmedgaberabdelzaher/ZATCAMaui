<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:customcontrol="clr-namespace:GAZT.CustomControl" x:Class="EGAZT.Views.NewDesign.VATRefunds.VATRefundsListPageView"
             xmlns:ResourceManager="clr-namespace:EGAZT" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" BackgroundImageSource="partials_background.png" NavigationPage.HasNavigationBar="False">
     <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>

                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.NDRefunds}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand" Source="arrowLeftwhite">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}"/>
                            </Image.GestureRecognizers>
                        </Image>

                        <StackLayout Spacing="15" Orientation="Horizontal" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Grid.Row="0" Grid.Column="2">
                            <Image Source="search">
                            </Image>
                        </StackLayout>
                    </Grid>

                    <yummy:PancakeView  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" Padding="0" BackgroundColor="White" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Grid.Column="0" Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid Padding="16,16,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackLayout Spacing="0" Grid.Row="0">
                <custom:CustomLabel Text="Test" Style="{StaticResource PageTitleBlack}" HorizontalOptions="StartAndExpand">
                </custom:CustomLabel>
                <Label Margin="2,-10,2,16" Text="600000.00 SAR" Style="{StaticResource CaptionLabelGrey}"/>
                <border:SfBorder  Margin="0,10,0,5" Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout Orientation="Horizontal"  Padding="15,10,15,10">
                        <Image Source="add" HeightRequest="20" WidthRequest="20">
                        </Image>
                        <Label Margin="8,0,8,0" Text="{x:Static ResourceManager:AppResources.VATRefundsRequest}" Style="{StaticResource ValueLabelPrimary}" HorizontalOptions="Start"/>
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="NewRefundRequest_Tapped">
                                
                            </TapGestureRecognizer>
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                    
                </border:SfBorder >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                   
                </Grid>
                <custom:CustomLabel Text="{Binding AmountLabel}" Style="{StaticResource CaptionLabelGrey}"/>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <buttons:SfChipGroup x:Name="ChipGroup_statusFilter" Type="Choice"  HorizontalOptions="Start"  ChipBackgroundColor="Transparent"                                         ItemsSource="{Binding ChipDataFilterlist}" SelectedChipBackgroundColor="{StaticResource Primary}" VerticalOptions="Center" ChipPadding="1">
                        <buttons:SfChipGroup.ItemTemplate>
                            <DataTemplate >
                                <StackLayout Margin="0" Padding="0" Spacing="2">
                                    <buttons:SfChip HeightRequest="32"  BorderWidth="1" BorderColor="{StaticResource NeutralLightGrey}" Text="{Binding Text}" FontFamily="{StaticResource SSTArRoman}" FontSize="12" TextColor="{StaticResource NeutralBlack}"  BackgroundColor="White"  ImageSource="{Binding ImageSource}"  ShowCloseButton="False"  ImageAlignment="Left"  ShowSelectionIndicator="False" SelectionIndicatorColor="AliceBlue"  ShowIcon="True" CornerRadius="20" VerticalTextAlignment="Center" VerticalOptions="Center"/>
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfChipGroup.ItemTemplate>
                    </buttons:SfChipGroup>
                </ScrollView>
            </StackLayout>
                <listView:SfListView Grid.Row="1" ItemsSource="{Binding VATRefundsModel}" IsVisible="true" SelectionChanged="vatRefundDetailsListView_SelectionChanged" HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand" BackgroundColor="White" AutoFitMode="Height" x:Name="vatRefundsListView"> 
                    <listView:SfListView.ItemTemplate>
                        <DataTemplate>
                                <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0" Spacing="0">
                                        <Grid  Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-10">
                                                <Label  Text="{Binding Title}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                                                <Label Text="{Binding RefernceNumber}" Style="{StaticResource CaptionLabelGrey}"/>
                                            </StackLayout>
                                            <StackLayout Grid.Row="0" Grid.Column="1"  VerticalOptions="FillAndExpand"  HorizontalOptions="FillAndExpand">
                                                <yummy:PancakeView Padding="10,10,10,10" CornerRadius="14"  HeightRequest="20"  BorderThickness="1" BackgroundColor="#E5EFED"  VerticalOptions="CenterAndExpand" HorizontalOptions="End" >
                                                    <Label Style="{StaticResource CaptionLabelBlack}"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                                        <Label.Triggers>
                                                            <!--Text="{Binding statusMessage}" TextColor="{Binding statusColor}"-->
                                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusRefunded}">
                                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusRefunded}" />
                                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />

                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusInProcess}">
                                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusInProcess}" />
                                                                <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </yummy:PancakeView>
                                            </StackLayout>
                                        </Grid>
                                        <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />
                                        <Grid Padding="10,10,10,10" RowSpacing="15" >
                                            <Grid.RowDefinitions >
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="StartAndExpand" Text="{Binding TestDueAmount}" VerticalOptions="CenterAndExpand"  >
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding TotalOffset}" Style="{StaticResource SectionTitleBlackBold}" ></Span>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>

                                            </custom:CustomLabel>
                                            <StackLayout Grid.Row="1" Grid.Column="0" Spacing="-5">
                                                <Label Text="{x:Static ResourceManager:AppResources.VATRefundsReassesmentAmount}" Style="{StaticResource CaptionLabelGrey}"/>
                                                <Label Text="{Binding ReassesmentAmount}" Style="{StaticResource ValueLabelBlack}" />
                                            </StackLayout>
                                            <StackLayout Grid.Row="1" Grid.Column="1" Spacing="-5">
                                                <Label Text="{x:Static ResourceManager:AppResources.VATRefundsTotalOffset}" Style="{StaticResource CaptionLabelGrey}"/>
                                                <Label Text="{Binding TotalOffset}" Style="{StaticResource ValueLabelBlack}" />
                                            </StackLayout>
                                            <StackLayout Grid.Row="2" Grid.Column="0" Spacing="-5">
                                                <Label Text="{x:Static ResourceManager:AppResources.VATRefundsNetCreditBalance}" Style="{StaticResource CaptionLabelGrey}"/>
                                                <Label Text="{Binding NetCreditBalance}" Style="{StaticResource ValueLabelBlack}" />
                                            </StackLayout>
                                            <StackLayout Grid.Row="2" Grid.Column="1" Spacing="-5">
                                                <Label Text="{x:Static ResourceManager:AppResources.VATRefundsRequestDate}" Style="{StaticResource CaptionLabelGrey}"/>
                                                <Label Text="{Binding RequestDate}" Style="{StaticResource ValueLabelBlack}" />
                                            </StackLayout>
                                        </Grid>

                                    </StackLayout>
                                </border:SfBorder >
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                </listView:SfListView>

        </Grid>
    </ContentPage.Content>
</ContentPage>
