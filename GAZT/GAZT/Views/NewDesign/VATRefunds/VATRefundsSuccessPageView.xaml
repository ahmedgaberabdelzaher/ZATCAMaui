<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             x:Class="EGAZT.Views.NewDesign.VATRefunds.VATRefundsSuccessPageView"  xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true"
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        
    </ContentPage.Resources>
    <ContentPage.Content>
        <ScrollView>
                            <StackLayout IsVisible="{Binding IsAccountUnlockedSuccessViewVisible}" Margin="0" BackgroundColor="Transparent" >
                    <Grid HorizontalOptions="Start" IsVisible="true" BackgroundColor="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35*"/>
                            <ColumnDefinition Width="30*"/>
                            <ColumnDefinition Width="35*"/>
                        </Grid.ColumnDefinitions>

                    <Image Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Source="partials_background" Opacity="0" BackgroundColor="Transparent" HorizontalOptions="CenterAndExpand" VerticalOptions="Start"/>

                    <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"  Padding="40,120,40,40" VerticalOptions="Start">
                        <Image Source="Forget_ic_success.png"   Aspect="AspectFit"/>
                        <Label Text="{x:Static ResourceManager:AppResources.VATRefund}" Style="{StaticResource SectionTitleBlack}" TextColor="White" HorizontalTextAlignment="Center"/>
                        <Label Text="{x:Static ResourceManager:AppResources.VATRefundsRequestSuccess}"  Style="{StaticResource BodyLabelBlack}"
                               TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </StackLayout>

                    <yummy:PancakeView BackgroundColor="White" CornerRadius="15,15,0,0" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Padding="0"  Margin="0,8,0,0" VerticalOptions="End">
                        <StackLayout  HorizontalOptions="Center" VerticalOptions="End" Margin="30,60,30,40" >
                        <border:SfBorder   Margin="0,0,0,8"  Style="{StaticResource GreyBorderFrame}">
                   
                            <StackLayout Orientation="Horizontal" Padding="15,10,15,10">
                                <Label  Text="{x:Static ResourceManager:AppResources.ZZReferenceNumber}" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="Start" VerticalOptions="Center"/>
                                <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                <Label Text="{Binding VatNewReqSummaryData.Fbnumx}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>
                            </StackLayout>

                           </StackLayout>
                         </border:SfBorder>
                         <buttons:SfButton Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0"  x:Name="btnDownloadConfirmation" Clicked="btnRefunds_Clicked" Text="{x:Static ResourceManager:AppResources.NDRefunds}"
                                   Style="{StaticResource PrimaryButtonStyle}"/>
                        
                         <buttons:SfButton Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,16"  x:Name="btnGoToDasboard" Clicked="btnGoToDasboard_Clicked" Text="{x:Static ResourceManager:AppResources.ZZZZGotoDashboard}"
                                   Style="{StaticResource NoBackgroundButtonStyle}" TextColor="{StaticResource Primary}"/>
                    </StackLayout>
                    </yummy:PancakeView>
                    
                    </Grid>
                </StackLayout>

        </ScrollView>
    </ContentPage.Content>
</ContentPage>
