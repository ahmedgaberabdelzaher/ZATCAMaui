<?xml version="1.0" encoding="UTF-8"?>
<pages:PopupPage  xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup" xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:custom="clr-namespace:GAZT" xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
                 xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
                 x:Class="EGAZT.Views.NewDesign.VATRefunds.VATRefundsInstructionsPageView"  xmlns:ResourceManager="clr-namespace:EGAZT" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" xmlns:custom1="clr-namespace:GAZT.CustomControl"
                 NavigationPage.HasNavigationBar="False">
     <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <yummy:PancakeView  IsVisible="{Binding IsInstructionsVisible}"  Grid.Row="0" Grid.Column="0" BackgroundColor="White" CornerRadius="15,15,0,0"  HorizontalOptions="End" VerticalOptions="End" >
            <StackLayout  Grid.Row="0" Grid.Column="0" BackgroundColor="Transparent" HorizontalOptions="End" VerticalOptions="End" Margin="24,8,24,0">
            <BoxView Style="{StaticResource NeutralGrayBoxViewDrag}" HorizontalOptions="Center" VerticalOptions="Start"/>
            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZInstructions}" HorizontalOptions="StartAndExpand"
                            Style="{StaticResource SectionTitleBlackBold}" Margin="0,0,0,16"  />
            <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="0,0,0,10"  Style="{StaticResource GreyBorderFrame}">
                <ScrollView VerticalScrollBarVisibility="Never">
                    <StackLayout Margin="8">
                    <StackLayout Orientation="Horizontal" Spacing="0">
                       <Image HeightRequest="24" WidthRequest="24" Source="information" HorizontalOptions="Start" VerticalOptions="Center"/>
                       <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.VatRefundsConfirmationTit}" Margin="10,0,0,0"  HorizontalOptions="StartAndExpand"
                            Style="{StaticResource ValueLabelBlack}"/>
                    </StackLayout>
                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VatRefundsConfirmDetails}" HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}" />

                    <StackLayout Orientation="Horizontal" Spacing="0">
                       <Image HeightRequest="24" WidthRequest="24" Source="information" HorizontalOptions="Start" VerticalOptions="Center"/>
                       <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZInstructions}" Margin="10,0,0,0"  HorizontalOptions="StartAndExpand"
                            Style="{StaticResource ValueLabelBlack}"/>
                    </StackLayout>
                    <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.ZVatRefundInstructions}" HorizontalOptions="Start"
                            Style="{StaticResource CaptionLabelGrey}" />
                
                </StackLayout>
                </ScrollView>
            </border:SfBorder>
            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="End">

                <!--<CheckBox x:Name="chkDeclaration" Color="{StaticResource NewDarkBlueGreenColor}" VerticalOptions="CenterAndExpand" IsChecked="{Binding IsInstructionsChecked, Mode=TwoWay}">
                    <CheckBox.Triggers>
                        <DataTrigger TargetType="CheckBox" Binding="{Binding IsInstructionsChecked}"  Value="false">
                            <Setter Property="Color" Value="{StaticResource NewDarkBlueGreenColor}" />
                        </DataTrigger>
                    </CheckBox.Triggers>
                    
                </CheckBox>-->
                 <custom1:CheckboxCustom  Grid.Row="0" Grid.Column="0" IsChecked="{Binding IsInstructionsChecked}" 
                                                                             Style="{StaticResource CheckboxHeightWidth32}"/>
         

                <custom:CustomLabel  Margin="5,10,0,15" Style="{StaticResource GAZTMicroMediumGrayLabel}">
                    <custom:CustomLabel.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static ResourceManager:AppResources.ZVatDeclarationInstructions}"  />
                        </FormattedString>
                    </custom:CustomLabel.FormattedText>
                    <custom:CustomLabel.Triggers>
                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IsInstructionsChecked}" Value="True">
                                            <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IsInstructionsChecked}" Value="False">
                                            <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                </custom:CustomLabel>
           </StackLayout>
           <buttons:SfButton Grid.ColumnSpan="2"  Margin="0,24,0,24" IsEnabled="{Binding IsInstructionsChecked}"  x:Name="btnConfirmVATRefundInstructions" Clicked="VATRefundRequestInstructions_Tapped" Text="{x:Static ResourceManager:AppResources.VATRefundRequestTtitle}"
                                   Style="{StaticResource PrimaryButtonStyle}">
                <buttons:SfButton.Triggers>
                    <DataTrigger TargetType="buttons:SfButton" Binding="{Binding IsInstructionsChecked}"  Value="true">
                        <Setter Property="BackgroundColor" Value="#d49504" />
                    </DataTrigger>
                    <DataTrigger TargetType="buttons:SfButton" Binding="{Binding IsInstructionsChecked}"  Value="false">
                        <Setter Property="BackgroundColor" Value="{StaticResource NeutralGreay}" />
                    </DataTrigger>
                </buttons:SfButton.Triggers>
           </buttons:SfButton>
        </StackLayout>
    </yummy:PancakeView>

</pages:PopupPage>
