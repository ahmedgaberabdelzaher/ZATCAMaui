<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             x:Class="EGAZT.Views.NewDesign.VATRefunds.VATRefundDetailsPageView"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"   xmlns:custom="clr-namespace:GAZT"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:ResourceManager="clr-namespace:EGAZT" xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             BackgroundImageSource="partials_background"  NavigationPage.HasNavigationBar="False"
             xmlns:custom2="clr-namespace:EGAZT"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters" xmlns:custom1="clr-namespace:GAZT.CustomControl"
             x:Name="VATRefundDetails">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NegetiveToPositiveValueConverter x:Key="negetiveToPositiveValueConverter" />
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,0,0,0" x:Name="VATRMainGrid">

                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />

                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="0,10,0,10" Grid.Row="0" Margin="8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static ResourceManager:AppResources.VATRefundDetails}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="CenterAndExpand" VerticalOptions="Center"/>
                        <Image Grid.Row="0" Grid.Column="0" Style="{DynamicResource BackButtonArrow}" IsVisible="{TemplateBinding BindingContext.IsBackButtonVisible}" Source="arrowLeftwhite"  VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" ></TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>
                        <Image Grid.Row="0" Grid.Column="2"  Source="close"  VerticalOptions="Center" HorizontalOptions="End">
                            <Image.Triggers>
                                <DataTrigger TargetType="Image" Binding="{TemplateBinding BindingContext.IsNewReqSummary}" Value="true">
                                    <Setter Property="IsVisible" Value="true" />
                                </DataTrigger>
                                <DataTrigger TargetType="Image" Binding="{TemplateBinding BindingContext.IsNewReqSummary}" Value="false">
                                    <Setter Property="IsVisible" Value="false" />
                                </DataTrigger>
                            </Image.Triggers>
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="VoidButton_Tapped"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" VerticalScrollBarVisibility="Never" BackgroundColor="White">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid IsVisible="true" Grid.Row="0" BackgroundColor="Transparent" Padding="0" Margin="20,10,20,16" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*"/>
                            <ColumnDefinition Width="50*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsNewReqSummary}" Value="true">
                                    <Setter Property="IsVisible" Value="false" />
                                </DataTrigger>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsNewReqSummary}" Value="false">
                                    <Setter Property="IsVisible" Value="true" />
                                </DataTrigger>
                            </Grid.Triggers>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <Grid  Grid.Row="0" Grid.Column="0"  BackgroundColor="Transparent" HorizontalOptions="FillAndExpand" VerticalOptions="Fill">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <StackLayout Orientation="Vertical" Grid.Row="0" Grid.Column="0" BackgroundColor="Transparent">
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VATRefund}"  HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" />
                                    <Label Text="{x:Static ResourceManager:AppResources.VATRReviewInformation}" IsVisible="{Binding VatRefundsListResultModel.IsEditable}" Style="{StaticResource BodyLabelGrey}"
                                       HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                    <Label Text="{Binding VATRefundsHeaderSet.RefundFbnum}" Margin="5,-10,5,15" Style="{StaticResource CaptionLabelGrey}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding  VatRefundsListResultModel.IsEditable}" Value="false">
                                                <Setter Property="IsVisible" Value="true" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding  VatRefundsListResultModel.IsEditable}" Value="true">
                                                <Setter Property="IsVisible" Value="false" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                </StackLayout>
                                <yummy:PancakeView Grid.Row="0" Grid.Column="1" IsVisible="true" Padding="10,10,10,10" CornerRadius="14" 
                                               WidthRequest="80"  HeightRequest="20" Opacity=".2" BackgroundColor="{StaticResource Secondary}"  BorderThickness="1" VerticalOptions="Center" HorizontalOptions="EndAndExpand" >
                                    <yummy:PancakeView.Triggers>
                                        <!--Text="{Binding statusMessage}" TextColor="{Binding statusColor}"-->
                                        <DataTrigger TargetType="yummy:PancakeView" Binding="{Binding VATRefundsHeaderSet.Status}" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="yummy:PancakeView" Binding="{Binding  VatRefundsListResultModel.IsEditable}" Value="false">
                                            <Setter Property="IsVisible" Value="true" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="yummy:PancakeView" Binding="{Binding  VatRefundsListResultModel.IsEditable}" Value="true">
                                            <Setter Property="IsVisible" Value="false" />
                                        </DataTrigger>
                                    </yummy:PancakeView.Triggers>
                                </yummy:PancakeView>
                                <StackLayout Grid.Row="0" Grid.Column="1" IsVisible="true" VerticalOptions="Center"  HorizontalOptions="EndAndExpand"  Margin="15,0">
                                    <Label Style="{StaticResource CaptionLabelBlack}" Text="{Binding VATRefundsHeaderSet.Status}" TextColor="{StaticResource Secondary}" MaxLines="1"  HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                                        <Label.Triggers>
                                            <!--Text="{Binding statusMessage}" TextColor="{Binding statusColor}"-->
                                            <DataTrigger TargetType="Label" Binding="{Binding VATRefundsHeaderSet.Status}" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding  VatRefundsListResultModel.IsEditable}" Value="false">
                                                <Setter Property="IsVisible" Value="true" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding  VatRefundsListResultModel.IsEditable}" Value="true">
                                                <Setter Property="IsVisible" Value="false" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </StackLayout>
                            </Grid>

                            <border:SfBorder Margin="0,16,0,10" Grid.Row="1" Grid.Column="0" HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0">
                                    <Grid Padding="15" RowSpacing="0" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Frame Grid.Row="0" Grid.Column="0" HeightRequest="15" WidthRequest="15" CornerRadius="28" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                        </Frame>
                                        <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"  Aspect="AspectFit" Source="amount"/>
                                        <StackLayout Grid.Row="0" Grid.Column="1" Padding="8,0">
                                            <Label Text="{x:Static ResourceManager:AppResources.VATRefundAmounts}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                                        </StackLayout>
                                    </Grid>

                                    <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <Grid Padding="0" Margin="8,0,8,8" >
                                        <Grid.RowDefinitions >
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>
                                        <StackLayout Grid.Row="0" Grid.Column="0">
                                            <Label Text="{x:Static ResourceManager:AppResources.VATRefundsReassesmentAmount}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                        </StackLayout>
                                        <StackLayout Grid.Row="0" Grid.Column="1" >
                                            <Label Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding VATRefundsHeaderSet.ReassessAmt,Converter={StaticResource commaSeparatorConverter}}"/>
                                                        <Span Text=" "/>
                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                        <StackLayout Grid.Row="1" Grid.Column="0">
                                            <Label Text="{x:Static ResourceManager:AppResources.VATRefundsTotalOffset}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"></Label>
                                        </StackLayout>
                                        <StackLayout Grid.Row="1" Grid.Column="1">
                                            <Label Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding VATRefundsHeaderSet.OffsetTot,Converter={StaticResource commaSeparatorConverter}}"/>
                                                        <Span Text=" "/>
                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                        <StackLayout Grid.Row="2" Grid.Column="0">
                                            <Label Text="{x:Static ResourceManager:AppResources.VATRefundsNetCreditBalance}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                        </StackLayout>
                                        <StackLayout Grid.Row="2" Grid.Column="1">
                                            <Label Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding VATRefundsHeaderSet.NetCreditBal,Converter={StaticResource commaSeparatorConverter}}"/>
                                                        <Span Text=" "/>
                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                        <Frame HasShadow="False" Opacity="0.1"  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="{StaticResource Primary}" CornerRadius="0" Margin="-8,10,-8,-8" Padding="20" HeightRequest="24" HorizontalOptions="FillAndExpand">

                                        </Frame>
                                        <StackLayout Grid.Row="3" Grid.Column="0" Orientation="Horizontal" VerticalOptions="Center" Padding="0,10,0,0">
                                            <Label MaxLines="2" WidthRequest="90" Text="{x:Static ResourceManager:AppResources.VATRefundsRequestedAmount}" Style="{StaticResource BodyLabelBlack}" />
                                        </StackLayout>
                                        <StackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalOptions="Center" HorizontalOptions="End" Padding="0,10,0,0">
                                            <Label Style="{StaticResource SectionTitleBlackBold}" HorizontalOptions="End">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding VATRefundsHeaderSet.RequestedAmt,Converter={StaticResource commaSeparatorConverter}}"/>
                                                        <Span Text=" "/>
                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                    </Grid>
                                </StackLayout>
                            </border:SfBorder >
                            <border:SfBorder Margin="0,16,0,10" Grid.Row="2" Grid.Column="0" HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0">
                                    <Grid Padding="15" RowSpacing="0" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Frame Grid.Row="0" Grid.Column="0" HeightRequest="15" WidthRequest="15" CornerRadius="28" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                        </Frame>
                                        <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"  Aspect="AspectFit" Source="amount"/>
                                        <StackLayout Grid.Row="0" Grid.Column="1" Padding="8,0">
                                            <Label Text="{x:Static ResourceManager:AppResources.NAIBAN}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                                        </StackLayout>
                                    </Grid>

                                    <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <Grid Padding="0" Margin="8,0,8,8" >
                                        <Grid.RowDefinitions >
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>
                                        <StackLayout Grid.Row="0" Grid.Column="0">
                                            <Label Text="{x:Static ResourceManager:AppResources.VatDeregIDType}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                        </StackLayout>
                                        <StackLayout Grid.Row="0" Grid.Column="1" >
                                            <Label Text="{Binding SelectedIbanIdType}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                        </StackLayout>
                                        <StackLayout Grid.Row="1" Grid.Column="0" >
                                            <Label Text="{x:Static ResourceManager:AppResources.IDNumber}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                        </StackLayout>
                                        <StackLayout Grid.Row="1" Grid.Column="1">
                                            <Label Text="{Binding VatRefundsDisplayDataModel.Idnumber}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                        </StackLayout>
                                        <StackLayout Grid.Row="2" Grid.Column="0">
                                            <Label Text="{x:Static ResourceManager:AppResources.NAIBAN}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                        </StackLayout>
                                        <StackLayout Grid.Row="2" Grid.Column="1">
                                            <Label Text="{Binding VatRefundsDisplayDataModel.Iban}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                        </StackLayout>
                                    </Grid>
                                </StackLayout>
                            </border:SfBorder >


                            <listView:SfListView Margin="-3,0,-3,0"   Grid.Row="3" Grid.Column="0" ItemsSource="{Binding VATRefundsSubItemReturnsSet}" x:Name="summaryDeclarationListView" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="True"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <border:SfBorder Margin="0,16,0,40" HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow}">
                                            <StackLayout Padding="0">
                                                <Grid Padding="15" RowSpacing="0" >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto"/>
                                                        <ColumnDefinition Width="auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="15" WidthRequest="15" CornerRadius="28" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                    HasShadow="False">
                                                    </Frame>
                                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"  Aspect="AspectFit" Source="return_vatRefunds"/>
                                                    <StackLayout Grid.Row="0" Grid.Column="1" Padding="8,0">
                                                        <Label Text="{x:Static ResourceManager:AppResources.VatReturns}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                                                    </StackLayout>
                                                </Grid>

                                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                                <Grid Padding="0" Margin="8,0,8,8" >
                                                    <Grid.RowDefinitions >
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>

                                                    </Grid.ColumnDefinitions>
                                                    <StackLayout Grid.Row="0" Grid.Column="0">
                                                        <Label Text="{x:Static ResourceManager:AppResources.ASFBNum}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="0" Grid.Column="1" >
                                                        <Label Text="{Binding ReturnFbnum}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="1" Grid.Column="0">
                                                        <Label Text="{x:Static ResourceManager:AppResources.ReturnPeriod}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="1" Grid.Column="1" >
                                                        <Label Text="{Binding ReturnPeriod}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="2" Grid.Column="0" >
                                                        <Label Text="{x:Static ResourceManager:AppResources.ZVatRefundRequestDetailsCreditBalance}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="2" Grid.Column="1">
                                                        <Label Text="{Binding CreditBal,StringFormat='{0:0.00}', Converter={StaticResource negetiveToPositiveValueConverter}}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="3" Grid.Column="0">
                                                        <Label Text="{x:Static ResourceManager:AppResources.ZVatRefundRequestDetailsReassessedBalance}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="3" Grid.Column="1">
                                                        <Label Text="{Binding ReassessBal,Converter={StaticResource commaSeparatorConverter}}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="4" Grid.Column="0">
                                                        <Label Text="{x:Static ResourceManager:AppResources.ZVatRefundRequestDetailsOffset}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="4" Grid.Column="1" >
                                                        <Label Text="{Binding Offsets,Converter={StaticResource commaSeparatorConverter}}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="5" Grid.Column="0">
                                                        <Label Text="{x:Static ResourceManager:AppResources.VATRefundsNetCreditBalance}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="5" Grid.Column="1" >
                                                        <Label Text="{Binding NetCreditBal,Converter={StaticResource commaSeparatorConverter}}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="6" Grid.Column="0">
                                                        <Label Text="{x:Static ResourceManager:AppResources.ZStatus}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="6" Grid.Column="1" >
                                                        <Label Text="{Binding Status}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="7" Grid.Column="0">
                                                        <Label Text="{x:Static ResourceManager:AppResources.VATRefundsLastStatusChange}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="7" Grid.Column="1" >
                                                        <Label Text="{Binding LastStatusDate,StringFormat='{0:dd MMM yyyy}'}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                                    </StackLayout>
                                                </Grid>
                                            </StackLayout>

                                        </border:SfBorder >

                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>

                            <StackLayout Grid.Row="4" Margin="0,30">
                                <buttons:SfButton   x:Name="btnConfirm" HorizontalOptions="CenterAndExpand" VerticalOptions="EndAndExpand" IsVisible="{Binding VatRefundsListResultModel.IsEditable}" Clicked="ConfirmSummaryButton_Tapped" Text="{x:Static ResourceManager:AppResources.Confirm}"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackLayout>
                        </Grid>
                        <StackLayout IsVisible="{Binding IsNewReqSummary}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" Padding="0">
                            <StackLayout Orientation="Vertical" Grid.Row="0" Grid.Column="0" BackgroundColor="Transparent">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VatDeregSummaryTitle}" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" />
                                <Label Text="{x:Static ResourceManager:AppResources.VATRReviewInformation}" IsVisible="true" Style="{StaticResource BodyLabelGrey}"
                                       HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                            </StackLayout>
                            <!--#region TaxPayer Details-->

                            <border:SfBorder Margin="0,16,0,10" Grid.Row="1" Grid.Column="0" HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0">
                                    <Grid Padding="15" RowSpacing="0" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
