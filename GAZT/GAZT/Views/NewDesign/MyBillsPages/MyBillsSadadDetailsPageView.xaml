<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:control="clr-namespace:GAZT"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="partials_background.png"
             FlowDirection="LeftToRight"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.NewDesign.MyBillsPages.MyBillsSadadDetailsPageView">
   
    <ContentPage.Resources>
        <ResourceDictionary>
            
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    
     <ContentPage.ControlTemplate>
         <ControlTemplate>
            <Grid BackgroundColor="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0"
                              Padding="0,0,0,0">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand"
                                              Grid.Column="0"
                                              Grid.Row="0" BackgroundColor="White" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="24,10,24,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*" />
                            <ColumnDefinition Width="100*" />
                            <ColumnDefinition Width="0*" />
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="1" Grid.Row="0"  
                                              Source="ic_logo_gazt.png"
                                              WidthRequest="50"
                                              HeightRequest="50"
                                              VerticalOptions="Center"
                                              HorizontalOptions="Center"
                        />
                        
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid VerticalOptions="FillAndExpand" Grid.Row="0">
                <ScrollView VerticalOptions="FillAndExpand">
                    <StackLayout VerticalOptions="FillAndExpand" Padding="10">
                        <control:CustomLabel Text="{x:Static ResourceManager:AppResources.SADADDetailss}"
                                             Style="{StaticResource SectionTitleBlack}" />
                        <control:CustomLabel Text="{x:Static ResourceManager:AppResources.ReviewSADADBillDetailss}"
                                             Style="{StaticResource BodyLabelGrey}"/>
                       
                        <Grid VerticalOptions="FillAndExpand">
                         <Grid.RowDefinitions>
                             <RowDefinition Height="Auto" />
                             <RowDefinition Height="*" />
                         </Grid.RowDefinitions>

                        <StackLayout Grid.Row="0" Spacing="0">
                                <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrame}">
                                    <StackLayout Orientation="Horizontal"  Padding="15,10,15,10">

                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.SADADNumber}" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                            <custom:CustomLabel Text="{Binding ReferenceNumber}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>


                                        </StackLayout>
                                        <Image Source="zakat_copy.png">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnCopySADADNumberButtonClicked"/>
                                            </Image.GestureRecognizers>

                                        </Image>
                                    </StackLayout>
                                </border:SfBorder >

                                <border:SfBorder   Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrame}">
                                    <StackLayout Orientation="Horizontal"  Padding="15,10,15,10">

                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZSADADGAZTId}" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                            <custom:CustomLabel Text="020" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>
                                        </StackLayout>
                                    </StackLayout>
                                </border:SfBorder >

                             <Frame HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource SfStyleForZakatPlanGreen}" HasShadow="False" CornerRadius="12" Margin="0,10,0,0" Padding="10">
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="10,3,10,2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel  Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.TotalAmount}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" />
                                        <custom:CustomLabel  HorizontalOptions="EndAndExpand" Grid.Row="0" Grid.Column="1">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding TotalAmount,Converter={StaticResource commaSeparatorConverter}}" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                    <Span Text="&#160;" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                    <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"  Style="{StaticResource ValueLabelBlack}" ></Span>
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                    </Grid>
                                </Frame>
                               
                            </StackLayout>

                            <StackLayout Grid.Row="1" HorizontalOptions="FillAndExpand" VerticalOptions="End" Orientation="Vertical" Spacing="4" BackgroundColor="White" Padding="0,2,0,0">
                                <buttons:SfButton Text="{x:Static ResourceManager:AppResources.CRDone}"  Margin="0,0,0,2" Clicked="DoneClicked" Style="{StaticResource PrimaryButtonStyle}"></buttons:SfButton>
                       
                            </StackLayout>
                     </Grid>
                    </StackLayout>
                     
                </ScrollView>

            </Grid>
            
        </Grid>
     
    </ContentPage.Content>
    
</ContentPage>