<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:local="clr-namespace:EGAZT.CustomControl"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             mc:Ignorable="d" FlowDirection="RightToLeft"
             x:Class="EGAZT.Views.NewDesign.MyBillsPages.GAZTNewDesignMyBillsPageView" 
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png" >
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:StringToColor x:Key="StringToColor" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>
                <StackLayout>
                    <Grid Padding="24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="72"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.Bills}" Style="{StaticResource SectionTitleWhiteBold}" 
                               HorizontalOptions="Center" VerticalOptions="Center"/>

                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"
                               Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}"/>
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>

                    <yummy:PancakeView  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" Padding="0,-16,0,0" BackgroundColor="White" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Grid.Column="0" Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid Padding="24,32,24,5" RowSpacing="12" x:Name="pageBinder">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackLayout Spacing="-5" Grid.Row="0" BackgroundColor="Transparent" Padding="0">

                <StackLayout Orientation="Horizontal">
                    <custom:CustomLabel Text="{Binding FilterLabelText}" Style="{StaticResource PageTitleBlack}" HorizontalOptions="Start"
                                        VerticalOptions="CenterAndExpand">
                        <custom:CustomLabel.GestureRecognizers>
                            <TapGestureRecognizer Tapped="btn_Clicked"/>
                        </custom:CustomLabel.GestureRecognizers>
                    </custom:CustomLabel>
                    <Image Source="arrowDropdown"  Margin="0,8,0,0" HorizontalOptions="Start" VerticalOptions="CenterAndExpand">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="btn_Clicked"/>
                        </Image.GestureRecognizers>
                    </Image>
                </StackLayout>

                <custom:CustomLabel Padding="0,-16,0,0"  HorizontalOptions="StartAndExpand" VerticalOptions="Start" VerticalTextAlignment="Start">
                    <custom:CustomLabel.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static ResourceManager:AppResources.MyBillsTotalUnPaidAmount}" Style="{StaticResource CaptionLabelGrey}" ></Span>
                            <Span Text="&#160;" Style="{StaticResource SectionTitleBlackBold}"></Span>
                            <Span Text="{Binding AmountLabel}"  Style="{StaticResource CaptionLabelGrey}"></Span>
                        </FormattedString>
                    </custom:CustomLabel.FormattedText>
                </custom:CustomLabel>
                <!--<custom:CustomLabel Text="{Binding AmountLabel}" Style="{StaticResource CaptionLabelGrey}"/>-->
                <ScrollView BackgroundColor="Transparent" Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never" 
                            VerticalOptions="Center" Margin="0,24,0,0">
                    <buttons:SfChipGroup Margin="0" x:Name="ChipGroup_statusFilter" Type="Choice" 
                                         Padding="0"  HorizontalOptions="Start" 
                                         ChipBackgroundColor="Transparent" 
                                         ItemsSource="{Binding ChipDataFilterlist}" 
                                         HeightRequest="32" 
                                         IsClippedToBounds="True"
                                         ChipBorderColor="{StaticResource NeutralLightGrey}"  ChipBorderWidth="1" 
                                         SelectionChanged="chipgroup_SelectionChanged" VerticalOptions="Center" >
                        <buttons:SfChipGroup.ItemTemplate>
                            <DataTemplate >
                                <StackLayout Margin="-5,-10" Orientation="Horizontal" Spacing="2" Padding="5,-2" WidthRequest="70">
                                    <Image Source="{Binding ImageSource}"
                                           HorizontalOptions="Center"
                                           HeightRequest="25"
                                           VerticalOptions="Center"/>
                                    <custom:CustomLabel Text="{Binding Text}"
                                                        HorizontalOptions="CenterAndExpand" 
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        VerticalTextAlignment="Center"
                                                        VerticalOptions="Center"/>
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfChipGroup.ItemTemplate>
                    </buttons:SfChipGroup>
                </ScrollView>
            </StackLayout>
            <StackLayout Grid.Row="1" Padding="0">

                <ListView  x:Name="Bills" ItemsSource="{Binding MyBills,Mode=TwoWay}"
                           IsVisible="{Binding IsListVisible}" VerticalScrollBarVisibility="Never" HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand" HasUnevenRows="True" BackgroundColor="White"
                           SeparatorVisibility="None" ItemTapped="Bills_ItemTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <border:SfBorder   Margin="0,12" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Spacing="0">
                                        <Grid RowSpacing="3"  Padding="16,4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-10">
                                                <Label  Text="{Binding Abtypt}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                                                <Label  Text="{Binding Txt30}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand"   />
                                            </StackLayout>


                                            <border:SfBorder Grid.Row="0" Grid.Column="1" HorizontalOptions="EndAndExpand" 
                                                                     VerticalOptions="CenterAndExpand" Padding="12,0,12,0" 
                                                                     CornerRadius="20" HeightRequest="32" BorderColor="{StaticResource Primary}" BorderWidth="1">
                                                <StackLayout BindingContext="{Binding .}"  Orientation="Horizontal" HorizontalOptions="CenterAndExpand">
                                                    <Image Source="ic_iconpay" HeightRequest="16" WidthRequest="16" 
                                                                   Margin="0,0,5,0" VerticalOptions="CenterAndExpand"/>
                                                    <custom:CustomLabel FontFamily="{StaticResource SSTArRoman}" Text="{x:Static ResourceManager:AppResources.PaymentMethodPayNow}" FontSize="12" TextColor="{StaticResource Primary}" VerticalOptions="CenterAndExpand"/>
                                                    <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer CommandParameter="" Tapped="payNow_Tapped" />
                                                    </StackLayout.GestureRecognizers>
                                                </StackLayout>
                                                
                                            </border:SfBorder>
                                            <!--</StackLayout>-->
                                        </Grid>
                                        <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="{StaticResource NeutralLightGrey}" />
                                        <Grid Padding="16,8,16,4" RowSpacing="0">
                                            <Grid.RowDefinitions >
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>

                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="StartAndExpand" Spacing="-5" Margin="0,0,0,14">
                                                <Label Text="{x:Static ResourceManager:AppResources.NDInvoiceDueamount}" Style="{StaticResource CaptionLabelGrey}"
                                                       HorizontalOptions="StartAndExpand"/>
                                                <custom:CustomLabel  HorizontalOptions="StartAndExpand">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding TestDueAmount}" Style="{StaticResource SectionTitleBlackBold}" ></Span>
                                                            <Span Text="&#160;" Style="{StaticResource SectionTitleBlackBold}" ></Span>
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"  Style="{StaticResource SectionTitleBlackBold}" ></Span>
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>
                                            </StackLayout>

                                            <StackLayout Grid.Row="1" Grid.Column="0" Spacing="-5"
                                                          Grid.ColumnSpan="2"
                                                          IsVisible="{Binding IsPeriodVisible}"  Margin="0,0,0,14" >
                                                <Label Text="{x:Static ResourceManager:AppResources.NDPeriod}" Style="{StaticResource CaptionLabelGrey}"/>
                                                <!--<Label Text="{Binding Period}" Style="{StaticResource ValueLabelBlack}" />-->
                                                <StackLayout Orientation="Horizontal">
                                                    <custom:CustomLabel Text="{Binding PeriodPart1}" Style="{StaticResource ValueLabelBlack}" />
                                                    <custom:CustomLabel Text="-" Style="{StaticResource ValueLabelBlack}" />
                                                    <custom:CustomLabel HorizontalOptions="StartAndExpand" Text="{Binding PeriodPart2}" Style="{StaticResource ValueLabelBlack}" />
                                                </StackLayout>
                                            </StackLayout>

                                            <StackLayout Grid.Row="2" Grid.Column="0"  IsVisible="{Binding IsPartiallyPaidVisibile}"  
                                                         HorizontalOptions="StartAndExpand" Spacing="-5"  Margin="0,0,0,14">
                                                <StackLayout.Triggers>
                                                    <DataTrigger TargetType="StackLayout"
                                                                 Binding="{Binding IsPartiallyPaidVisibile}"
                                                                 Value="false">
                                                        <Setter Property="HeightRequest" Value="0" />
                                                    </DataTrigger>
                                                </StackLayout.Triggers>
                                                <Label Text="{x:Static ResourceManager:AppResources.MyBillsPaidAmount}" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand"/>
                                                <custom:CustomLabel  HorizontalOptions="StartAndExpand">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding TotalPaidAmt}" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                            <Span Text="&#160;" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"  Style="{StaticResource ValueLabelBlack}" ></Span>
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>
                                            </StackLayout>

                                            <StackLayout Grid.Row="2" Grid.Column="1" IsVisible="{Binding IsPartiallyPaidVisibile}"
                                                         HorizontalOptions="StartAndExpand" Spacing="-5"  Margin="0,0,0,14">
                                                <StackLayout.Triggers>
                                                    <DataTrigger TargetType="StackLayout"
                                                                 Binding="{Binding IsPartiallyPaidVisibile}"
                                                                 Value="false">
                                                        <Setter Property="HeightRequest" Value="0" />
                                                    </DataTrigger>
                                                </StackLayout.Triggers>
                                                <Label Text="{x:Static ResourceManager:AppResources.MyBillsRemainingAmount}" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand"/>
                                                <custom:CustomLabel  HorizontalOptions="StartAndExpand">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding TotalRemainingAmount}" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                            <Span Text="&#160;" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"  Style="{StaticResource ValueLabelBlack}" ></Span>
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>
                                            </StackLayout>

                                            <StackLayout Grid.Row="3" Grid.Column="0" Spacing="-5"  Margin="0,0,0,14">
                                                <Label Text="{x:Static ResourceManager:AppResources.SADADNumber}" Style="{StaticResource CaptionLabelGrey}"/>
                                                <Label Text="{Binding VTRE2}" Style="{StaticResource ValueLabelBlack}" />
                                            </StackLayout>



                                            <StackLayout Grid.Row="3" Grid.Column="1" Spacing="-5">
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.DueDate}" Style="{StaticResource CaptionLabelGrey}"/>
                                                <StackLayout HorizontalOptions="Start">
                                                    <custom:CustomLabel Text="{Binding FormatedFaedn}" Style="{StaticResource ValueLabelBlack}"/>
                                                </StackLayout>

                                            </StackLayout>

                                        </Grid>

                                    </StackLayout>
                                </border:SfBorder >
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <custom:CustomLabel Margin="0,20,0,0"  Text="{x:Static ResourceManager:AppResources.NoBillsAvailable}" Style="{StaticResource CaptionLabelGrey}"  HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding isNoDataLableVisible}"/>

            </StackLayout>

        </Grid>

    </ContentPage.Content>
</ContentPage>