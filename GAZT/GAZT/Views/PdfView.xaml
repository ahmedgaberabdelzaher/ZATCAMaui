<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GAZT.Views.PdfView"
             xmlns:controls="clr-namespace:pdfjs.Controls">
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="100*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>
         <!--<StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">-->

            <controls:PdfWebView x:Name="PdfViewForCertificate" IsVisible="{Binding IsVisiblePdfView}"  Source="{Binding PathOfPdf}"  VerticalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7"/>


        <!--</StackLayout>-->
            <ActivityIndicator IsVisible="{Binding IsLoading}" Grid.Row="0" Grid.Column="0" IsRunning="{Binding IsLoading}" VerticalOptions="Center" HorizontalOptions="Center" Grid.ColumnSpan="7" BackgroundColor="Transparent"></ActivityIndicator>

        </Grid>
    </ContentPage.Content>
</ContentPage>