<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GAZT.Views.PdfView"
             xmlns:controls="clr-namespace:pdfjs.Controls">
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="37.46*" />
                <RowDefinition Height="62.54*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*" />
            </Grid.ColumnDefinitions>
               <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56*"/>
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="6*" />
                    <RowDefinition Height="3*" />

                    <!--<RowDefinition Height="76.22*" />
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="6*" />
                    <RowDefinition Height="3*" />-->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="29*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="29*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="29*" />
                    <ColumnDefinition Width="4*" />
                    <!--itemtemplate height 11.62 and separator height 1.75-->
                </Grid.ColumnDefinitions>
                
                <controls:PdfWebView x:Name="PdfViewForCertificate" Source="{Binding PathOfPdf}"  VerticalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7"/>
                <!--<WebView x:Name="Webview"  
                 HeightRequest="200"  
                 WidthRequest="200"              
                 VerticalOptions="FillAndExpand"
                         Source="https://tstdg1as1.mygazt.gov.sa:8080/sap/opu/odata/SAP/ZDP_IT_CORRES_MOB_NEW_SRV/corr_dataSet(Cokey='C4346B23F48E1ED982858E704178C406',Cotyp='ZVT3')/$value"
                         Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="7" />-->
                <BoxView Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="0.5" BackgroundColor="#d5d5d5" />
                <Image Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" Source="ic_home.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" >
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnHomeIconClicked}" />
                    </Image.GestureRecognizers>
                </Image>
                <Image Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Source="ic_question.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                <Image Grid.Row="2" Grid.RowSpan="2" Grid.Column="5" Source="ic_user_2.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" >
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnMyTaxPayerProfileClicked}" />
                    </Image.GestureRecognizers>
                </Image>
                <ActivityIndicator IsVisible="{Binding IsLoading}" IsRunning="{Binding IsLoading}" VerticalOptions="Center" HorizontalOptions="Center" Grid.ColumnSpan="7"></ActivityIndicator>

            </Grid>

        </Grid>
        <!--<StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <controls:PdfWebView x:Name="PdfViewControl" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" />

            <BoxView Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="0.5" BackgroundColor="#d5d5d5" />
            <Image Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" Source="ic_home.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" >
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OnHomeIconClicked}" />
                </Image.GestureRecognizers>
            </Image>
            <Image Grid.Row="6" Grid.RowSpan="2" Grid.Column="1" Source="ic_question.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
            <Image Grid.Row="6" Grid.RowSpan="2" Grid.Column="5" Source="ic_user_2.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" >
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OnMyTaxPayerProfileClicked}" />
                </Image.GestureRecognizers>
            </Image>

        </StackLayout>-->
    </ContentPage.Content>
</ContentPage>