<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="GAZT.GaztEntry"  xmlns:local1="clr-namespace:GAZT">
    <ContentView.Content>
        <Grid HorizontalOptions="FillAndExpand" ColumnSpacing="0" VerticalOptions="FillAndExpand" Padding="0,0,0,0">
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15*" />
                <ColumnDefinition Width="85*" />
            </Grid.ColumnDefinitions>
            <Frame Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource FrameStyle}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0,0,0,0">
            </Frame>
            <local1:BorderlessEntry x:Name="EntryField" Text="{Binding Text, Mode=TwoWay}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="15,1,15,1" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="CenterAndExpand" BackgroundColor="White">
            </local1:BorderlessEntry>
              <Label x:Name="EntryLabelText"  Text="{Binding LabelText, Mode=TwoWay}" Style="{StaticResource MiniGoldLabelStyle}" Grid.Row="0" Grid.Column="0" Margin="15,-13,15,0" Grid.ColumnSpan="2"  HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="White" >
 </Label>
      
       </Grid>
    </ContentView.Content>
</ContentView>
