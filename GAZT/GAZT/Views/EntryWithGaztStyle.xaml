<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="GAZT.EntryWithGaztStyle" xmlns:local1="clr-namespace:GAZT" xmlns:Control="clr-namespace:GAZT.CustomControl">
    <ContentView.Content>
<StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0" Padding="0">
                         <Frame Style="{StaticResource FrameStyle}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
        <Grid HorizontalOptions="FillAndExpand" ColumnSpacing="0" VerticalOptions="FillAndExpand"  Padding="-20">
            <Grid.RowDefinitions>
                <RowDefinition Height="100*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*" />
                <ColumnDefinition Width="80*" />
                 <ColumnDefinition Width="10*" />
            </Grid.ColumnDefinitions>
                        <Control:CustomImage x:Name="ImageSourceOne" Source="{Binding SourceOne, Mode=TwoWay}" Grid.Row="0" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="FillAndExpand" Margin="0,10,0,10" />
            <local1:BorderlessEntry x:Name="EntryField" Text="{Binding Text, Mode=TwoWay}" Grid.Row="0" Grid.Column="1" Margin="2,1,2,1" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" BackgroundColor="White">
            </local1:BorderlessEntry>
            <Control:CustomImage x:Name="ImageSource" Source="{Binding Source, Mode=TwoWay}" Grid.Row="0" Grid.Column="2" HorizontalOptions="Center" VerticalOptions="FillAndExpand" Margin="0,10,0,10" />
             <Label x:Name="EntryLabelText" Text="{Binding LabelText, Mode=TwoWay}" Style="{StaticResource MiniGoldLabelStyle}" Grid.Row="0" Grid.Column="0" Margin="20,-10,20,0" Grid.ColumnSpan="2" HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="White">
            </Label>
        </Grid>
            </Frame>
    </StackLayout>
         <!--<StackLayout Spacing="2">
        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Horizontal">
         <Control:CustomImage x:Name="ImageSourceOne" Source="{Binding SourceOne, Mode=TwoWay}" HorizontalOptions="Start" VerticalOptions="CenterAndExpand" Margin="10,0,10,0" />
            <local1:BorderlessEntry x:Name="EntryField" Text="{Binding Text, Mode=TwoWay}"  Margin="2,1,2,1" HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" BackgroundColor="Blue">
            </local1:BorderlessEntry>
          <Control:CustomImage x:Name="ImageSource" Source="{Binding Source, Mode=TwoWay}" HorizontalOptions="End" VerticalOptions="CenterAndExpand" Margin="10,0,10,0" />
            </StackLayout>
        </StackLayout>-->
    </ContentView.Content>
</ContentView>
