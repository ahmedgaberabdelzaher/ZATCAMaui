<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="GAZT.Views.MyCertificate" xmlns:skia="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms" xmlns:cards="clr-namespace:PanCardView;assembly=PanCardView" xmlns:proc="clr-namespace:PanCardView.Processors;assembly=PanCardView" xmlns:local="clr-namespace:GAZT;assembly:GAZT" xmlns:local1="clr-namespace:GAZT" FlowDirection="RightToLeft">
    <ContentPage.ToolbarItems>
        <ToolbarItem Icon="ic_bell.png" Order="Primary" Priority="0" Command="{Binding OnBellClicked}" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="37.46*" />
                <RowDefinition Height="62.54*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*" />
            </Grid.ColumnDefinitions>
            <skia:SKCanvasView Margin="0,-2,0,0" Grid.Row="0" Grid.Column="0" PaintSurface="OnCanvasViewPaintSurface" />
            <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.64*" />
                    <RowDefinition Height="4.06*" />
                    <RowDefinition Height="6.08*" />
                    <RowDefinition Height="76.22*" />
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="6*" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="29*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="29*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="29*" />
                    <ColumnDefinition Width="4*" />
                    <!--itemtemplate height 11.62 and separator height 1.75-->
                </Grid.ColumnDefinitions>
                <local1:CustomLabel Text="My certificate" Style="{StaticResource MyCertificateSmallMiniWhiteLabelStyle}" Grid.Row="1" Grid.ColumnSpan="7" HorizontalOptions="Center" VerticalOptions="Center">
                </local1:CustomLabel>


                <ListView Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="7" x:Name="CertificateList" HasUnevenRows="true" SeparatorVisibility="None" BackgroundColor="Transparent" Margin="9,0,9,0">
                    <x:Arguments>
                        <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                    </x:Arguments>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Frame VerticalOptions="Fill" HorizontalOptions="FillAndExpand" Padding="0" IsClippedToBounds="true" CornerRadius="5" HeightRequest="50" Margin="4" BorderColor="#D5D5D5" BackgroundColor="#FCFCFC">
                                    <Frame.HeightRequest>
                                        <OnIdiom x:TypeArguments="x:Double" Phone="50" Tablet="72" />
                                    </Frame.HeightRequest>
                                    <Frame   HeightRequest="50" VerticalOptions="FillAndExpand" HorizontalOptions="Fill" Padding="0" IsClippedToBounds="true" CornerRadius="5" BorderColor="#D5D5D5" BackgroundColor="#FCFCFC">
                                        <Frame.HeightRequest>
                                            <OnIdiom x:TypeArguments="x:Double" Phone="50" Tablet="72" />
                                        </Frame.HeightRequest>
                                        <StackLayout HorizontalOptions="Fill" VerticalOptions="FillAndExpand" Orientation="Horizontal" Padding="0" Spacing="0">
                                            <local1:CustomLabel Text="VAT registration certificate" Style="{StaticResource MiniBlackLabelStyle}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Margin="10" HorizontalTextAlignment="Start">
                                            </local1:CustomLabel>
                                            <Image Grid.Row="0" Source="ic_envelop.png" Aspect="AspectFit" HorizontalOptions="End" VerticalOptions="CenterAndExpand" Margin="10,0,10,0" />
                                        </StackLayout>
                                    </Frame>
                                </Frame>

                                 <!--<Frame VerticalOptions="Fill" HorizontalOptions="FillAndExpand" Padding="0" IsClippedToBounds="true" CornerRadius="5" HeightRequest="50" Margin="4" BorderColor="#D5D5D5" BackgroundColor="#FCFCFC">
                                    <Frame.HeightRequest>
                                        <OnIdiom x:TypeArguments="x:Double" Phone="50" Tablet="72" />
                                    </Frame.HeightRequest>
                                    <Frame   HeightRequest="50" VerticalOptions="FillAndExpand" HorizontalOptions="Fill" Padding="0" IsClippedToBounds="true" CornerRadius="5" BorderColor="#D5D5D5" BackgroundColor="#FCFCFC">
                                        <Frame.HeightRequest>
                                            <OnIdiom x:TypeArguments="x:Double" Phone="50" Tablet="72" />
                                        </Frame.HeightRequest>
                                        <StackLayout HorizontalOptions="Fill" VerticalOptions="FillAndExpand" Orientation="Horizontal" Padding="0" Spacing="0">
                                            <local1:CustomLabel Text="Registration Certificate" Style="{StaticResource MiniBlackLabelStyle}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Margin="10" HorizontalTextAlignment="Start">
                                            </local1:CustomLabel>
                                            <Image Grid.Row="0" Source="ic_envelop.png" Aspect="AspectFit" HorizontalOptions="End" VerticalOptions="CenterAndExpand" Margin="10,0,10,0" />
                                        </StackLayout>
                                    </Frame>
                                </Frame>-->

                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <BoxView Grid.Row="4" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="0.5" BackgroundColor="#d5d5d5" />
                <Image Grid.Row="4" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" Source="ic_home.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                <Image Grid.Row="5" Grid.RowSpan="2" Grid.Column="1" Source="ic_question.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                <Image Grid.Row="5" Grid.RowSpan="2" Grid.Column="5" Source="ic_user_2.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>