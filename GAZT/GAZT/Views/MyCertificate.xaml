<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="GAZT.Views.MyCertificate" xmlns:skia="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms" xmlns:cards="clr-namespace:PanCardView;assembly=PanCardView" xmlns:proc="clr-namespace:PanCardView.Processors;assembly=PanCardView" xmlns:local="clr-namespace:GAZT;assembly:GAZT" xmlns:local1="clr-namespace:GAZT" FlowDirection="RightToLeft" xmlns:controls="clr-namespace:pdfjs.Controls" xmlns:RC="clr-namespace:Tavant.XToolkit.RoundedCornerView;assembly=Tavant.XToolkit.RoundedCornerView"  xmlns:effects="clr-namespace:GAZT;assembly:GAZT">
    <ContentPage.ToolbarItems>
        <ToolbarItem Icon="ic_bell.png" Order="Primary" Priority="0" Command="{Binding OnBellClicked}" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="37.46*" />
                <RowDefinition Height="62.54*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*" />
            </Grid.ColumnDefinitions>
            <skia:SKCanvasView Margin="0,-2,0,0" Grid.Row="0" Grid.Column="0" PaintSurface="OnCanvasViewPaintSurface" />
            <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.64*" />
                    <RowDefinition Height="6.06*" />
                    <RowDefinition Height="3.08*" />
                    <RowDefinition Height="21.22*" />
                    <RowDefinition Height="56*" />
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="6*" />
                    <RowDefinition Height="3*" />

                    <!--original
                     <RowDefinition Height="2.64*" />
                    <RowDefinition Height="6.06*" />
                    <RowDefinition Height="4.08*" />
                    <RowDefinition Height="20.22*" />
                    <RowDefinition Height="56*" />
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="6*" />
                    <RowDefinition Height="3*" />-->
                    <!--<RowDefinition Height="76.22*" />
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="6*" />
                    <RowDefinition Height="3*" />-->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="29*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="29*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="29*" />
                    <ColumnDefinition Width="4*" />
                    <!--itemtemplate height 11.62 and separator height 1.75-->
                </Grid.ColumnDefinitions>
                <local1:CustomLabel Text="{x:Static local:AppResources.MyCertificate}" Style="{StaticResource MyCertificateSmallMiniWhiteLabelStyle}" Grid.Row="1" Grid.ColumnSpan="7" HorizontalOptions="Center" VerticalOptions="Center">
                </local1:CustomLabel>

                <StackLayout  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="7" Grid.RowSpan="2" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="10,0,10,0" >
                    <cards:CarouselView  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" x:Name="CardView">
                        <cards:CarouselView.ItemTemplate>
                            <DataTemplate>
                                <ContentView>
                                    <Frame  VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Padding="0" HasShadow="true" IsClippedToBounds="true" CornerRadius="4" BorderColor="#B1B1B1" BackgroundColor="White">
                                        <Image Source="{Binding Source}" />
                                    </Frame>
                                </ContentView>
                            </DataTemplate>
                        </cards:CarouselView.ItemTemplate>
                    </cards:CarouselView>
                </StackLayout>

                <StackLayout  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="7" Grid.RowSpan="2" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0" Orientation="Vertical" Spacing="0" BackgroundColor="Transparent">
                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                 <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                 <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                 <RowDefinition Height="Auto" />

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*" />
            </Grid.ColumnDefinitions>

                    <local1:CustomLabel  Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsVATCertificateAvailable}" Text="{x:Static local:AppResources.VATCertificates}" Style="{StaticResource MiniBlackLabelStyle}"  HorizontalOptions="Start" VerticalOptions="Center" Margin="20,20,20,0">
                    </local1:CustomLabel>

                    <ListView  Grid.Row="1" Grid.Column="0"  Margin="20,0,20,0" HeightRequest="100" IsVisible="{Binding IsVATCertificateAvailable}" ItemsSource ="{Binding VATCertificateList}" VerticalOptions="Fill" x:Name="VATCertificateList" HasUnevenRows="true" SelectedItem="{Binding SelectedZAKATCertificate}" BackgroundColor="Transparent" SeparatorVisibility="None">
                        <!--<x:Arguments>
                            <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                        </x:Arguments>-->
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0,2,0,8">
                                        <StackLayout local1:RoundCornersEffect.CornerRadius="10" HorizontalOptions="Fill" VerticalOptions="FillAndExpand" Padding="1" Spacing="10"  BackgroundColor="#c49b2d"  HeightRequest="50">

                                            <StackLayout local1:RoundCornersEffect.CornerRadius="10" HorizontalOptions="Fill" VerticalOptions="FillAndExpand" Orientation="Horizontal" Padding="1" Spacing="0"  BackgroundColor="White" HeightRequest="50">

                                                <local1:CustomLabel Text="{Binding Descript}" Style="{StaticResource MiniBlackLabelStyle}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Margin="10" HorizontalTextAlignment="Start">

                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding OnZakatCertificateClicked}" />
                                                    </Label.GestureRecognizers>

                                                </local1:CustomLabel>
                                                <Image Grid.Row="0" Source="ic_pdf.png" Aspect="AspectFit" HorizontalOptions="End" VerticalOptions="CenterAndExpand" Margin="10,0,10,0">

                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding OnZakatCertificateClicked}" />
                                                    </Image.GestureRecognizers>
                                                </Image>


                                            </StackLayout>
                                        </StackLayout>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <BoxView  Grid.Row="2" Grid.Column="0" IsVisible="{Binding IsZAKATCertificateAvailable}"  HorizontalOptions="FillAndExpand" VerticalOptions="End" HeightRequest="0.5"  BackgroundColor="#c7c7c7" Margin="10,0,10,0" />
                    <local1:CustomLabel  Grid.Row="3" Grid.Column="0"  IsVisible="{Binding IsZAKATCertificateAvailable}" Text="{x:Static local:AppResources.ZakatCertificates}" Style="{StaticResource MiniBlackLabelStyle}"  HorizontalOptions="StartAndExpand" VerticalOptions="Start"  Margin="20,10,20,0">
                    </local1:CustomLabel>

                    <ListView  Grid.Row="4" Grid.Column="0"  Margin="20,0,20,0" HeightRequest="100" IsVisible="{Binding IsZAKATCertificateAvailable}" ItemsSource ="{Binding ZAKATCertificateList}" VerticalOptions="FillAndExpand" x:Name="ZAKATCertificateList" HasUnevenRows="true" SelectedItem="{Binding SelectedZAKATCertificate}" BackgroundColor="Transparent" SeparatorVisibility="None">
                        <!--<x:Arguments>
                            <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                        </x:Arguments>-->
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0,2,0,8">
                                        <StackLayout local1:RoundCornersEffect.CornerRadius="10" HorizontalOptions="Fill" VerticalOptions="FillAndExpand" Padding="1" Spacing="10"  BackgroundColor="#c49b2d"  HeightRequest="50">

                                            <StackLayout local1:RoundCornersEffect.CornerRadius="10" HorizontalOptions="Fill" VerticalOptions="FillAndExpand" Orientation="Horizontal" Padding="1" Spacing="0"  BackgroundColor="White" HeightRequest="50">

                                                <local1:CustomLabel Text="{Binding Descript}" Style="{StaticResource MiniBlackLabelStyle}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Margin="10" HorizontalTextAlignment="Start">

                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding OnZakatCertificateClicked}" />
                                                    </Label.GestureRecognizers>

                                                </local1:CustomLabel>
                                                <Image Grid.Row="0" Source="ic_pdf.png" Aspect="AspectFit" HorizontalOptions="End" VerticalOptions="CenterAndExpand" Margin="10,0,10,0">

                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding OnZakatCertificateClicked}" />
                                                    </Image.GestureRecognizers>
                                                </Image>


                                            </StackLayout>
                                        </StackLayout>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <BoxView  Grid.Row="5" IsVisible="{Binding IsEXISECertificateAvailable}" Grid.Column="0"  HorizontalOptions="FillAndExpand" VerticalOptions="End" HeightRequest="0.5"  BackgroundColor="#c7c7c7" Margin="10,0,10,0"/>
                    <local1:CustomLabel Grid.Row="6" Grid.Column="0" IsVisible="{Binding IsEXISECertificateAvailable}" Text="{x:Static local:AppResources.ExciseCertificates}" Style="{StaticResource MiniBlackLabelStyle}"  HorizontalOptions="Start" VerticalOptions="Center" Margin="20,10,20,0">
                    </local1:CustomLabel>

                        <ListView Grid.Row="7" Grid.Column="0" Margin="20,0,20,0" HeightRequest="100"  IsVisible="{Binding IsEXISECertificateAvailable}" ItemsSource ="{Binding EXICISECertificateList}" VerticalOptions="FillAndExpand" x:Name="EXISECertificateList" HasUnevenRows="true" SelectedItem="{Binding SelectedEXCISECertificate}" BackgroundColor="Transparent" SeparatorVisibility="None">
                        <!--<x:Arguments>
                            <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                        </x:Arguments>-->
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0,2,0,3">

                                        <StackLayout local1:RoundCornersEffect.CornerRadius="10" HorizontalOptions="Fill" VerticalOptions="FillAndExpand" Padding="1" Spacing="10"  BackgroundColor="#c49b2d"  HeightRequest="50">

                                            <StackLayout local1:RoundCornersEffect.CornerRadius="10" HorizontalOptions="Fill" VerticalOptions="FillAndExpand" Orientation="Horizontal" Padding="1" Spacing="0"  BackgroundColor="White" HeightRequest="50">

                                                <local1:CustomLabel Text="{Binding Descript}" Style="{StaticResource MiniBlackLabelStyle}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Margin="10" HorizontalTextAlignment="Start">
                                                </local1:CustomLabel>
                                                <Image Grid.Row="0" Source="ic_pdf.png" Aspect="AspectFit" HorizontalOptions="End" VerticalOptions="CenterAndExpand" Margin="10,0,10,0">
                                                </Image>
                                            </StackLayout>
                                        </StackLayout>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                                            <BoxView  Grid.Row="8" Grid.Column="0"  HorizontalOptions="FillAndExpand" VerticalOptions="End" HeightRequest="0.5"  BackgroundColor="#c7c7c7" Margin="10,0,10,10"/>

</Grid>
                </StackLayout>
                <BoxView Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="0.5" BackgroundColor="#d5d5d5" />
                <Image Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" Source="ic_home.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnHomeIconClicked}" />
                    </Image.GestureRecognizers>
                </Image>
                <Image Grid.Row="6" Grid.RowSpan="2" Grid.Column="1" Source="ic_question.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                <Image Grid.Row="6" Grid.RowSpan="2" Grid.Column="5" Source="ic_user_2.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
 <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTaxPayerClicked" />
                </Image.GestureRecognizers>
                </Image>
                <ActivityIndicator IsVisible="{Binding IsLoading}" IsRunning="{Binding IsLoading}" VerticalOptions="Center" HorizontalOptions="Center" Grid.ColumnSpan="3"></ActivityIndicator>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>