                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.ZTERReportDetailName}"  />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Frame x:Name="FrmName" Grid.Row="1"    Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTFrameStyleForEntry}">
                        </Frame>

                        <custom:GAZTBorderlessEntry  Grid.Row="1"  Grid.Column="0"  Grid.ColumnSpan="2"   Style="{StaticResource GAZTTextBoxStyleForEntry}" x:Name="TName" Unfocused="TName_Unfocused" Text="{Binding TName}">
                            <custom:GAZTBorderlessEntry.Behaviors>
                                <custom1:OnlyAlphabatesBehaviour/>
                            </custom:GAZTBorderlessEntry.Behaviors>
                        </custom:GAZTBorderlessEntry>
                        <Label Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="2"   Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start"  >
                            <Label.FormattedText>
                                <FormattedString>
