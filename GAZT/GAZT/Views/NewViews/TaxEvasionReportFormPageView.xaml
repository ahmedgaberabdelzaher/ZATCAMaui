                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.ZTERReportDetailFacilityName}"  />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Frame  Grid.Row="8"    Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTFrameStyleForEntry}" x:Name="FrmFName">
                        </Frame>

                        <custom:GAZTBorderlessEntry  Grid.Row="8"  Grid.Column="0"  Grid.ColumnSpan="2"    Style="{StaticResource GAZTTextBoxStyleForEntry}" Text="{Binding TFaciName}" x:Name="TFaciName" Placeholder="{x:Static local:AppResources.ZTERReportFormEnterFN}">
