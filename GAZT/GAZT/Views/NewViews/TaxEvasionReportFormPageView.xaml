                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.ZTERReportDetailFDAddress}"  />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Frame  Grid.Row="18"    Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTFrameStyleForEntry}" x:Name="FrmFDAddress">
