                        <custom:GAZTBorderlessEntry      Keyboard="Telephone" Style="{StaticResource GAZTTextBoxStyleForEntry}" x:Name="TMobNumber" Unfocused="TMobNumber_Unfocused"  Text="{Binding TMobNumber}" MaxLength="8">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <custom1:OnlyNumericValuesBehaviour/>
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>
                        </StackLayout>

