<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:GAZT;assembly:GAZT"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             Title="{x:Static local:AppResources.ZZCorrespondence}"
             x:Class="GAZT.Views.NewViews.CorrespondenceDetailsPageView"
             NavigationPage.HasNavigationBar="False"
             >
    <!--<ContentPage.ToolbarItems>
        <ToolbarItem Icon="{Binding FavIcon}" Order="Primary" Priority="0" Command="{Binding OnFavClicked}" />
    </ContentPage.ToolbarItems>-->
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\SyncFusionEnabledViews\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <controls:TitleView Title="{x:Static local:AppResources.ZZCorrespondence}"  FontSize="14"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.GoBackClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="#006450"
                            Style="{StaticResource IconButtonStyle}"
                             Text="{DynamicResource StyleReverseBack}"
                            
                             />

                    </controls:TitleView.LeadingView>
                    <controls:TitleView.TrailingView>
                        <Image Source="{TemplateBinding BindingContext.FavIcon}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnFavClicked}"></TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>

                    </controls:TitleView.TrailingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        
        <StackLayout VerticalOptions="FillAndExpand">
            <Grid  RowSpacing="0" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="70*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Frame Grid.Row="0" Grid.Column="0"   Style="{StaticResource GAZTFrameStyleEntryForLableBackground}"  Grid.ColumnSpan="2" >
                </Frame>
                <Label Text="{Binding CorrespondenceTitle}"   VerticalOptions="Center" HorizontalOptions="CenterAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                </Label>
                <WebView x:Name="CorWebView" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="560" WidthRequest="1000"/>



                <Frame Grid.Row="2" Grid.Column="0"    VerticalOptions="End" Style="{StaticResource GAZTFrameStyleEntryForLableBackground}"  Grid.ColumnSpan="2" >
                    </Frame>
                <Label Text="{x:Static local:AppResources.Attachment}" x:Name="Attachment_Label"  VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" IsEnabled="{Binding IsAttachmentEnable}">
                        <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnAttachmentClick}" ></TapGestureRecognizer>
                        </Label.GestureRecognizers>
                    </Label>
                
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>