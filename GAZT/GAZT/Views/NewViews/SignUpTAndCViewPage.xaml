<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
            
              xmlns:local="clr-namespace:GAZT;assembly:GAZT" xmlns:local1="clr-namespace:GAZT"
               Title="{x:Static local:AppResources.ZVatTermsAndConditions}"
             x:Class="GAZT.Views.NewViews.SignUpTAndCViewPage">
    <ContentPage.Content>
        <StackLayout>
            
                <WebView x:Name="TCWebView" HeightRequest="900" WidthRequest="1000" />
            <StackLayout HeightRequest="30" WidthRequest="1000" Orientation="Horizontal" VerticalOptions="CenterAndExpand">
                <CheckBox x:Name="chkTAndC"   IsChecked="{Binding IschkTAndC}"  Margin="10,0,0,0" VerticalOptions="Center">

                    </CheckBox>
                <local1:CustomLabel Text="{x:Static local:AppResources.ZZIagreeontermsAndconditions}"  HorizontalOptions="Start" VerticalOptions="Center"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" Margin="0,0,10,0"/>

                </StackLayout>
            <StackLayout HeightRequest="70" WidthRequest="1000">
                <!--<Button Text="" Command="{Binding OnSubmitClicked}" Style="{StaticResource GAZTVerifyButton}"  IsEnabled="{Binding IsButtonEnabled}" VerticalOptions="CenterAndExpand" ></Button>-->
                <Button  Text="{x:Static local:AppResources.Submit}" IsEnabled="{Binding IsButtonEnabled}"  Command="{Binding OnSubmitClicked}"  Style="{StaticResource GAZTVerifyButton}" BackgroundColor="{Binding VerifyButtonDisableColor}"></Button>

            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>