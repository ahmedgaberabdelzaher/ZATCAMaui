<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
                 xmlns:custom="clr-namespace:GAZT"
              xmlns:local="clr-namespace:GAZT;assembly:GAZT"
             xmlns:local1="clr-namespace:GAZT"
             Title="{x:Static local:AppResources.ZZakatReturnListing}"
             x:Class="GAZT.Views.NewViews.ZakatReturnListPageView">
    <ContentPage.Content>
        <StackLayout Margin="10,10,10,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
            <ListView  x:Name="ZakatReturns" 
           ItemsSource="{Binding MyZakatReturns}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                      
            SeparatorVisibility="None"
            >
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <ContentView>
                                <Frame OutlineColor="#C9C9C9"
                                       Margin="0,0,0,15"
                                       Padding="10,10,10,10"
                                       CornerRadius="5"
                                       
                               >

                                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Margin="0,0,0,5" Padding="0" >
                                        <Grid Style="{DynamicResource GridStyle}" ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30*" />
                                                <ColumnDefinition Width="70*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Label Text="{x:Static local:AppResources.FiscalYear}" Margin="0" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                                    Grid.Row="0"
                                   Grid.Column="0"
                                   />

                                            <Label Text="{Binding FiscalYear}" 
                                                  Margin="0"
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                  />

                                            <Label Text="{x:Static local:AppResources.ReturnPeriod}" Margin="0" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                                    Grid.Row="1"
                                   Grid.Column="0"
                                   />

                                            <Label Text="{Binding ReturnPeriod}" 
                                                  Margin="0"
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                  />



                                        </Grid>
                                    </StackLayout>

                                </Frame>
                            </ContentView>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackLayout>

    </ContentPage.Content>
</ContentPage>