                                                           Grid.Row="0"
                                                            Grid.Column="0"
                                                            Grid.RowSpan="10"
                                                            Margin="0,0,0,0"
                                                            BackgroundColor="{Binding BorderColour}"
                                                            VerticalOptions="Fill"
                                                            HorizontalOptions="Fill"
                                                            WidthRequest="2"/>-->


                                                        <!--<BoxView  
                                                         Grid.Row="0"
                                                            Grid.Column="3"
                                                            Grid.RowSpan="10"
                                                            Margin="0,0,0,0"
                                                            BackgroundColor="Gray"
                                                            VerticalOptions="Fill"
                                                            HorizontalOptions="Start"
                                                            WidthRequest="1"/>-->


                                                    </Grid>
