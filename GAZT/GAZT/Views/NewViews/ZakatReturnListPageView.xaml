                                                           VerticalOptions="CenterAndExpand"
                                                           Grid.Row="2"
                                                           Grid.Column="1"
                                                                 Grid.ColumnSpan="4"/>

                                                        <local1:CustomLabel Text="{Binding Period}" FontFamily="{StaticResource SSTArBold}"
                                                                             Margin="8,0,8,0" 
                                                                             Style="{StaticResource MiniGrayLabelStyle}"
                                                                             HorizontalOptions="StartAndExpand"
                                                                             VerticalOptions="CenterAndExpand"
                                                                             Grid.Row="3"
                                                                             Grid.Column="1"
                                                                             Grid.ColumnSpan="4" />

                                                        <Label Text="{x:Static local:AppResources.DueDate}" Margin="8,0,8,0" 
                                                                Style="{StaticResource MiniGoldLabelStyle}"
                                                                HorizontalOptions="StartAndExpand"
                                                                VerticalOptions="CenterAndExpand"
                                                                Grid.Row="4"
                                                                Grid.Column="1"
                                                                 Grid.ColumnSpan="4"/>

                                                        <Label Text="{Binding DueDtC}" FontFamily="{StaticResource SSTArBold}"
                                                  
                                                               Margin="8,0,8,0" 
                                                               Style="{StaticResource MiniGrayLabelStyle}"
                                                               HorizontalOptions="StartAndExpand"
                                                               VerticalOptions="CenterAndExpand"
                                                               Grid.Row="5"
                                                               Grid.Column="1"
                                                               Grid.ColumnSpan="4" />

                                                        <Label Text="{x:Static local:AppResources.ZStatus}" Margin="8,0,8,0" 
                                                               Style="{StaticResource MiniGoldLabelStyle}"
                                                               HorizontalOptions="StartAndExpand"
                                                               VerticalOptions="CenterAndExpand"
                                                               Grid.Row="6"
                                                               Grid.Column="1"
                                                               Grid.ColumnSpan="4"/>

                                                        <Label Text="{Binding Status}" FontFamily="{StaticResource SSTArBold}"
                                                                Margin="8,0,8,0" 
                                                                Style="{StaticResource MiniGrayLabelStyle}"
                                                                HorizontalOptions="StartAndExpand"
                                                                VerticalOptions="CenterAndExpand"
                                                                Grid.Row="7"
                                                                Grid.Column="1"
                                                                Grid.ColumnSpan="4" />

                                                        <custom:CustomLabel
                                                            Text="{x:Static local:AppResources.ZReferenceNumber}"
                                                            Grid.Row="8"
                                                            Margin="8,0,8,0"
