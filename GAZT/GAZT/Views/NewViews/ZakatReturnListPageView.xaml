        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" x:Name="ParentGrid"  ColumnSpacing="10" RowSpacing="10" Margin="0" Padding="0,0,0,10" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="12*" />
                    <RowDefinition Height="88*" />

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="30*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="30*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="18*" />
                    <ColumnDefinition Width="14*" />


                    <!--<ColumnDefinition Width="15*" />
                <ColumnDefinition Width="15*" />
                <ColumnDefinition Width="15*" />
                <ColumnDefinition Width="55*" />-->

                </Grid.ColumnDefinitions>

                <Frame Grid.Row="0"  Margin="10,13,10,0" Padding="13" VerticalOptions="CenterAndExpand" Grid.Column="0" Grid.ColumnSpan="7"  Style="{StaticResource GAZTFrameStyleForEntry}"   >
                    <custom:GAZTBorderlessPicker x:Name="BPicker" Margin="0"  VerticalOptions="CenterAndExpand" Style="{StaticResource GAZTDropdownStyle}"  IsEnabled="true"    SelectedItem="{Binding SelectedICRStatus}" ItemsSource="{Binding ICRStatusList}" ItemDisplayBinding="{Binding Value}" SelectedIndex="{Binding SelectedIndex}"  Grid.Row="0"   Grid.Column="0" Grid.ColumnSpan="7"  ></custom:GAZTBorderlessPicker>

                </Frame>
                <Image Grid.Row="0"  Grid.Column="6"  Margin="0,13,0,0"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Source="ic_dropdownOne.png" >
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="onDropdownButtonClicked" />
                    </Image.GestureRecognizers>
                </Image>





                <ListView  x:Name="ZakatICRList" 
                               Grid.Column="0" Grid.Row="1"  Grid.ColumnSpan="7"
           ItemsSource="{Binding MyZakatReturns}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="Fill"
            HasUnevenRows="True"
             BackgroundColor="White"

                               ItemTapped="Bills_ItemTapped"
                 SelectedItem="{Binding SelectedZakatReturn}"     
            SeparatorVisibility="None"
            >
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <cards:SfCardView HasShadow="True" Margin="10" Opacity=".9" BorderWidth=".05" BorderColor="#5d6770" ShadowColor="#5d6770" BackgroundColor="White" CornerRadius="3"  IndicatorColor="{Binding BorderColour}" IndicatorPosition="Left" IndicatorThickness="5">

                                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Margin="10,10,0,10" Padding="10" >

                                        <Grid  ColumnSpacing="0" RowSpacing="0"  HorizontalOptions="FillAndExpand" BackgroundColor="White" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90*" />
                                                <ColumnDefinition Width="10*" />
                                           
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                        
                                            </Grid.RowDefinitions>
                                            <Label Text="{Binding FbtText}" 
                                                       Style="{StaticResource MicroGrayLabelStyleNew}"
                                                     
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="StartAndExpand"
                                                       Grid.Row="0"
                                                       Grid.Column="0"
                                                       Grid.ColumnSpan="0"/>

                                            <Label Text="{Binding TaxPeriod}"  Margin="0" 
                                                       Style="{StaticResource MicroGrayLabelStyleNew}"
                                                     
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                                       Grid.Row="1"
                                                       Grid.Column="0"
                                                       Grid.ColumnSpan="0"/>



                                            <Label  Margin="0" 
                                  
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                                                        Grid.ColumnSpan="0"
                                                           >
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.ReturnPeriod}"></Span>
                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                        <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding Period}"></Span>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label  Margin="0" 
                                  
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                                                        Grid.ColumnSpan="0"
                                                           >
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.DueDate}"></Span>
                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                        <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding DueDtC}"></Span>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label  Margin="0" 
                                  
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="4"
                                   Grid.Column="0"
                                                                        Grid.ColumnSpan="0"
                                                           >
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.ZStatus}"></Span>
                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                        <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding Status}"></Span>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label  Margin="0" 
                                  
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="5"
                                   Grid.Column="0"
                                                                        Grid.ColumnSpan="0"
                                                           >
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.ZReferenceNumber}"></Span>
                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                        <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding Fbnum}"></Span>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>


                                            <Image  Grid.Row="0"
                                                                Grid.Column="1"
                                                                Grid.ColumnSpan="0"
                                                                Grid.RowSpan="0"
                                                                Source="{Binding StatusImage}"
                                                                HorizontalOptions="CenterAndExpand"
                                                                VerticalOptions="StartAndExpand"/>


                                        </Grid>
                                    </StackLayout>
                                    

                                </cards:SfCardView>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!--<local1:CustomLabel Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" Text="{x:Static local:AppResources.Nodataavailable}" Style="{StaticResource MiniBlackLabelStyle}"  HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding SetNoDataLabelVisibility}">
                </local1:CustomLabel>-->
                <!--<BoxView Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="0.5" BackgroundColor="#d5d5d5" />
            <Image Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" Source="ic_home.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OnHomeIconClicked}" />
                </Image.GestureRecognizers>
            </Image>
            <Image Grid.Row="6" Grid.RowSpan="2" Grid.Column="1" Source="ic_question.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
            <Image Grid.Row="6" Grid.RowSpan="2" Grid.Column="5" Source="ic_user_2.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                 <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTaxPayerClicked" />
                </Image.GestureRecognizers>
            </Image>-->

                <local1:CustomLabel Grid.Row="1"  Grid.Column="0" Grid.ColumnSpan="7" Text="{x:Static local:AppResources.ZZZReturnsNotFound}" Style="{StaticResource MiniBlackLabelStyle}"  HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding SetNoDataLabelVisibility}">
                </local1:CustomLabel>
            </Grid>

            <!-- Acticity indicator layout start -->
            <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.7" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <ActivityIndicator IsVisible="true" IsRunning="true" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Color="White" />
                        <Label Text="{x:Static local:AppResources.ActivityIndicatorTitle}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" />
                    </StackLayout>
                </StackLayout>
            </Grid>
            <!-- Acticity indicator layout end -->
        </Grid>



    </ContentPage.Content>
</ContentPage>