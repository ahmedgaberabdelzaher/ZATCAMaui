                                                            HorizontalOptions="StartAndExpand"
                                                            VerticalOptions="CenterAndExpand"
                                                            Style="{StaticResource MiniGoldLabelStyle}"
                                                            Grid.Column="1"
                                                            Grid.ColumnSpan="4" />

