<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
               xmlns:custom="clr-namespace:GAZT"
                FlowDirection="RightToLeft"
               xmlns:local="clr-namespace:GAZT;assembly:GAZT"
             Title="{x:Static local:AppResources.ZZCreateYourGAZTAccount}"
              xmlns:local1="clr-namespace:GAZT"
             
             x:Class="GAZT.Views.NewViews.CreateGaztAccountPageView">
    <ContentPage.Content>
        <StackLayout>
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"   Margin="0" Padding="0,10,0,10" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="90*" />
                    <RowDefinition Height="10*" />

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <ScrollView Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" >
                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"   Margin="0" Padding="0,10,0,10" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0"  Grid.Column="0" Grid.ColumnSpan="2"   Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start"  >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.ZZEmailAddress}"  />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Frame  Grid.Row="1"    Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTFrameStyleForEntry}">
                        </Frame>

                        <custom:GAZTBorderlessEntry  Grid.Row="1"  Grid.Column="0"  Grid.ColumnSpan="2"   Style="{StaticResource GAZTTextBoxStyleForEntry}" IsEnabled="False"  Placeholder="{Binding TxtEmailAddress}"></custom:GAZTBorderlessEntry>

                        <Label Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="2"   Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start"  >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.ZZConfirmationcodesenttoemailaddress}"  />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Frame  Grid.Row="3" IsEnabled="{Binding IsOTPEntryEnable}" x:Name="frmEmailCode"  Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTFrameStyleForEntry}">
                        </Frame>

                        <custom:GAZTBorderlessEntry Keyboard="Numeric" Grid.Row="3"  Grid.Column="0"  Grid.ColumnSpan="2"   Style="{StaticResource GAZTTextBoxStyleForEntry}"  Text="{Binding TxtEmailCode}">
                            <local:GAZTBorderlessEntry.Behaviors>
                                <local:NumericValidationBehavior/>
                            </local:GAZTBorderlessEntry.Behaviors>
                        </custom:GAZTBorderlessEntry>

                        <Label Grid.Row="4"  Grid.Column="0" Grid.ColumnSpan="2"   Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start"  >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.ZZMobileNumber}"  />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Frame  Grid.Row="5"    Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTFrameStyleForEntry}">
                        </Frame>

                        <custom:GAZTBorderlessEntry  Grid.Row="5"  Grid.Column="0"  Grid.ColumnSpan="2"   Style="{StaticResource GAZTTextBoxStyleForEntry}" IsEnabled="False" Placeholder="{Binding TxtMobileNumber}"></custom:GAZTBorderlessEntry>

                        <Label Grid.Row="6"  Grid.Column="0" Grid.ColumnSpan="2"   Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start"  >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.ZZConfirmationcodesenttoMobileNumber}"  />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Frame  Grid.Row="7" IsEnabled="{Binding IsOTPEntryEnable}"   x:Name="frmMobileCode"  Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTFrameStyleForEntry}">
                        </Frame>

                        <custom:GAZTBorderlessEntry   Keyboard="Numeric"  Grid.Row="7" IsPassword="True" Grid.Column="0"  Grid.ColumnSpan="2"   Style="{StaticResource GAZTTextBoxStyleForEntry}"  Text="{Binding TxtMobileNumberCode}">
                            <local:GAZTBorderlessEntry.Behaviors>
                                <local:NumericValidationBehavior/>
                            </local:GAZTBorderlessEntry.Behaviors>
                        </custom:GAZTBorderlessEntry>


                        <Label Grid.Row="8"  Grid.Column="0" Grid.ColumnSpan="2"   Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start"  >
                            <Label.FormattedText>
                                <FormattedString>

                                    <Span  Text="{x:Static local:AppResources.ZZPasswordregulationsforSignup}" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label Grid.Row="9"  Grid.Column="0" Grid.ColumnSpan="2"   Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start"  >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.Password}"  />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Frame  Grid.Row="10"  x:Name="frmPass"   Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTFrameStyleForEntry}">
                        </Frame>

                        <custom:GAZTBorderlessEntry  x:Name="EntryPass" Grid.Row="10"  Grid.Column="0" IsPassword="True"  Grid.ColumnSpan="2"   Style="{StaticResource GAZTTextBoxStyleForEntry}" Text="{Binding TxtPassword}"></custom:GAZTBorderlessEntry>

                        <Label Grid.Row="11"  Grid.Column="0" Grid.ColumnSpan="2"   Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start"  >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.ZZConfirmpassword}"  />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Frame  Grid.Row="12"   x:Name="frmCfrmPass"  Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTFrameStyleForEntry}">
                        </Frame>

                        <custom:GAZTBorderlessEntry x:Name="EntryCfrmPass" TextChanged="EntryCfrmPass_TextChanged" Grid.Row="12"  Grid.Column="0" IsPassword="True" Grid.ColumnSpan="2"   Style="{StaticResource GAZTTextBoxStyleForEntry}" Text="{Binding TxtConfirmPassword}"></custom:GAZTBorderlessEntry>
                        <Label Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="StartAndExpand"  Margin="10,0,10,0">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span  Text="{x:Static local:AppResources.ZZThecodewillbeexpiredwithin}"  Style="{StaticResource InformationGrayColorLabel}"   />
                                    <Span  Text="{Binding OTPValidDuration}" FontFamily="{StaticResource SSTArBold}" Style="{StaticResource InformationRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Button Text="{x:Static local:AppResources.ZZResendtheverificationcode}"  Command="{Binding OnResendOTPClicked}" VerticalOptions="StartAndExpand"  Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTVerifyButton}" BackgroundColor="{Binding ButtonDisableColor}" IsEnabled="{Binding IsResendOTPEnabled}"></Button>

                    </Grid>
                </ScrollView>
                <StackLayout Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"  Margin="0,0,0,-15"  BackgroundColor="White">
                    <Button Text="{x:Static local:AppResources.ZZSubmit}"  Style="{StaticResource GAZTVerifyButton}" VerticalOptions="Center" x:Name="btnSubmit" Clicked="btnSubmit_Clicked" IsEnabled="{Binding IsVerifyOTPEnabled}" BackgroundColor="{Binding VerifyButtonDisableColor}"></Button>

                </StackLayout>
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>