<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:GAZT;assembly:GAZT"
             xmlns:local1="clr-namespace:GAZT"
             FlowDirection="RightToLeft"
                xmlns:custom="clr-namespace:GAZT"
             xmlns:local2="clr-namespace:GAZT.CustomControl"
             Title="{x:Static local:AppResources.ZZCorrespondence}"
             x:Class="GAZT.Views.NewViews.CorrespondancePageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <local2:MonthConverter x:Key="MonthConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" x:Name="ParentGrid"  ColumnSpacing="10" RowSpacing="10" Margin="0" Padding="0,0,0,10" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="12*" />
                    <RowDefinition Height="12*" />
                    <RowDefinition Height="76*" />

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="90*" />
                  
                </Grid.ColumnDefinitions>
           

                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0"   BackgroundColor="#005e4b">
                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.ColumnSpan="7"    Margin="10,10,10,0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5.08*" />
                          
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="23*"/>
                            <ColumnDefinition Width="23*"/>
                            <ColumnDefinition Width="23*"/>
                          
                        </Grid.ColumnDefinitions>
                        <local1:CustomLabel Text="{Binding ZakatCountDisplay}"   Style="{DynamicResource searchBarStyleForZakat}"  Grid.Row="0" Grid.Column="0" Margin="5,0,5,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">


                            <local1:CustomLabel.GestureRecognizers>

                                <TapGestureRecognizer Tapped="ClickGestureRecognizer_ClickedForZakat" Command="{Binding onZakatLabelClicked}" />
                            </local1:CustomLabel.GestureRecognizers>
                        </local1:CustomLabel>

                        <local1:CustomLabel Text="{Binding VATCountDisplay}"  Style="{DynamicResource searchBarStyleForVAT}" Grid.Row="0" Grid.Column="1"  >
                            <local1:CustomLabel.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ClickGestureRecognizer_ClickedForVAT" Command="{Binding onVATLabelClicked}" />
                            </local1:CustomLabel.GestureRecognizers>
                        </local1:CustomLabel>
                        <local1:CustomLabel Text="{Binding ETCountDisplay}"  Style="{DynamicResource searchBarStyleForET}" Grid.Row="0" Grid.Column="2"  >
                            <local1:CustomLabel.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ClickGestureRecognizer_ClickedForET" Command="{Binding onETLabelClicked}" />
                            </local1:CustomLabel.GestureRecognizers>
                        </local1:CustomLabel>

                       


                    </Grid>

                </StackLayout>

                <Frame Grid.Row="1"  Margin="10,13,10,0" Padding="13" VerticalOptions="FillAndExpand" Grid.Column="0"   Style="{StaticResource GAZTFrameStyleForEntry}"  >

                </Frame>
                <custom:GAZTBorderlessPicker  x:Name="FPicker" Margin="15,13,15,0" SelectedIndex="{Binding SetSelectedIndex}" VerticalOptions="CenterAndExpand" Style="{StaticResource GAZTDropdownStyle}" IsEnabled="true" SelectedItem="{Binding SelectedFilter,Mode=TwoWay}" ItemsSource="{Binding CorresFilter}" ItemDisplayBinding="{Binding Filter}" Grid.Row="1" Grid.Column="0" ></custom:GAZTBorderlessPicker>

                <Image Grid.Row="1"  Grid.Column="0"  Margin="10,13,10,0"  HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" Source="ic_dropdownOne.png" >
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                    </Image.GestureRecognizers>
                </Image>


                <StackLayout Margin="10,0,10,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Column="0" Grid.Row="2" IsVisible="{Binding IsZakatVisible}">
                    <ListView  
           ItemsSource="{Binding ListZAKATCorrespondance}"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                      ItemTapped="ListView_ItemTapped"
            SeparatorVisibility="None"
            >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                  
                                    <ContentView>
                                        <Frame OutlineColor="#C9C9C9"
                                       Margin="0,0,0,10"
                                       Padding="10,5,10,5"
                                       CornerRadius="5"
                                       
                               >
                                            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Margin="0,0,0,5" Padding="0" >
                                                <Grid ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White" >
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="93*" />
                                                       
                                                        <ColumnDefinition Width="7*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />                                                      
                                                    </Grid.RowDefinitions>

                                                    <Label Text="{x:Static local:AppResources.ZZTitle}" Margin="0" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                           />

                                                    <Label Text="{Binding Title}" 
                                                  
                                  Margin="0" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                                           />


                                                    <Label 
                                                 Style="{StaticResource MiniGoldLabelStyle}"
                                  
                                                HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                             
                                   Grid.Column="0"
                                                        Grid.ColumnSpan="4"
                                                         Text="{x:Static local:AppResources.ZZReferenceNumber}"
                                   >
                                                     
                                                    </Label>

                                                    <Label Text="{Binding RefNumber}" 
                                                 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                                           />

                                                    <Label Text="{x:Static local:AppResources.ZZDateandTime}" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="4"
                                   Grid.Column="0"
                                                          
                                   />
                                                    <Label  
                                     
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                    HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="5"
                                   Grid.Column="0"
                                                         Text="{Binding DateAndTime}">

                                                       
                                                    </Label>

                                                    <Image  Grid.Row="0"  Grid.Column="1"   Source="{Binding FavImg}" HorizontalOptions="StartAndExpand" VerticalOptions="StartAndExpand"/>
                                                    <!--<StackLayout Grid.Row="1"  BackgroundColor="AliceBlue" Grid.Column="3" Grid.ColumnSpan="2" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.RowSpan="4" ></StackLayout>-->
                                                    <!--<Image  Grid.Row="1"  Grid.Column="3" Grid.ColumnSpan="1" Grid.RowSpan="10"  Source="{Binding StatusImage}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                                                    <BoxView  
                     Grid.Row="0" Grid.Column="2" Grid.RowSpan="10" Margin="0" BackgroundColor="Gray" VerticalOptions="Fill" HorizontalOptions="Center" WidthRequest="1"/>-->


                                                </Grid>
                                            </StackLayout>
                                        </Frame>
                                    </ContentView>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackLayout>
                <StackLayout Margin="10,0,10,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Column="0" Grid.Row="2" IsVisible="{Binding IsVATVisible}">
                    <ListView 
           ItemsSource="{Binding ListVATCorrespondance}"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                      ItemTapped="ListView_ItemTapped_1"
            SeparatorVisibility="None"
                         GroupDisplayBinding="{Binding DateAndTime, Converter={StaticResource MonthConverter}}"
        IsGroupingEnabled="True"
                        
            >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <ContentView>
                                        <Frame OutlineColor="#C9C9C9"
                                       Margin="0,0,0,10"
                                       Padding="10,5,10,5"
                                       CornerRadius="5"
                                       
                               >
                                            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Margin="0,0,0,5" Padding="0" >
                                                <Grid ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White" >
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="93*" />
                                                        <ColumnDefinition Width="7*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Label Text="{x:Static local:AppResources.ZZTitle}" Margin="0" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                           />

                                                    <Label Text="{Binding Title}" 
                                                  
                                  Margin="0" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                                           />


                                                    <Label 
                                                 Style="{StaticResource MiniGoldLabelStyle}"
                                  
                                                HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                             
                                   Grid.Column="0"
                                                       
                                                         Text="{x:Static local:AppResources.ZZReferenceNumber}"
                                   >

                                                    </Label>

                                                    <Label Text="{Binding RefNumber}" 
                                                 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                                           />

                                                    <Label Text="{x:Static local:AppResources.ZZDateandTime}" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="4"
                                   Grid.Column="0"
                                                           
                                   />
                                                    <Label  
                                     
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                    HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="5"
                                   Grid.Column="0"
                                                         Text="{Binding DateAndTime}">


                                                    </Label>

                                                    <Image  Grid.Row="0"  Grid.Column="1"   Source="{Binding FavImg}" HorizontalOptions="StartAndExpand" VerticalOptions="StartAndExpand"/>
                                                    <!--<StackLayout Grid.Row="1"  BackgroundColor="AliceBlue" Grid.Column="3" Grid.ColumnSpan="2" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.RowSpan="4" ></StackLayout>-->
                                                    <!--<Image  Grid.Row="1"  Grid.Column="3" Grid.ColumnSpan="1" Grid.RowSpan="10"  Source="{Binding StatusImage}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                                                    <BoxView  
                     Grid.Row="0" Grid.Column="2" Grid.RowSpan="10" Margin="0" BackgroundColor="Gray" VerticalOptions="Fill" HorizontalOptions="Center" WidthRequest="1"/>-->


                                                </Grid>
                                            </StackLayout>
                                        </Frame>
                                    </ContentView>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    
                    
                </StackLayout>
                <StackLayout Margin="10,0,10,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Column="0" Grid.Row="2" IsVisible="{Binding IsETVisible}">
                    <ListView 
           ItemsSource="{Binding ListETCorrespondance}"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                      ItemTapped="ListView_ItemTapped_2"
            SeparatorVisibility="None"
            >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <ContentView>
                                        <Frame OutlineColor="#C9C9C9"
                                       Margin="0,0,0,10"
                                       Padding="10,5,10,5"
                                       CornerRadius="5"
                                       
                               >
                                            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Margin="0,0,0,5" Padding="0" >
                                                <Grid ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White" >
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90*" />
                                                        <ColumnDefinition Width="10*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Label Text="{x:Static local:AppResources.ZZTitle}" Margin="0" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                           />

                                                    <Label Text="{Binding Title}" 
                                                  
                                  Margin="0" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                                           />


                                                    <Label 
                                                 Style="{StaticResource MiniGoldLabelStyle}"
                                  
                                                HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                             
                                   Grid.Column="0"
                                                       
                                                         Text="{x:Static local:AppResources.ZZReferenceNumber}"
                                   >

                                                    </Label>

                                                    <Label Text="{Binding RefNumber}" 
                                                 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                                           />

                                                    <Label Text="{x:Static local:AppResources.ZZDateandTime}" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="4"
                                   Grid.Column="0"
                                                          
                                   />
                                                    <Label  
                                     
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                    HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="5"
                                   Grid.Column="0"
                                                        Text="{Binding DateAndTime}">


                                                    </Label>


                                                    <!--<StackLayout Grid.Row="1"  BackgroundColor="AliceBlue" Grid.Column="3" Grid.ColumnSpan="2" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.RowSpan="4" ></StackLayout>-->
                                                    <Image  Grid.Row="0"  Grid.Column="1"   Source="{Binding FavImg}" HorizontalOptions="StartAndExpand" VerticalOptions="StartAndExpand"/>
                                                    <!--<BoxView  
                     Grid.Row="0" Grid.Column="2" Grid.RowSpan="10" Margin="0" BackgroundColor="Gray" VerticalOptions="Fill" HorizontalOptions="Center" WidthRequest="1"/>-->


                                                </Grid>
                                            </StackLayout>
                                        </Frame>
                                    </ContentView>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackLayout>
                <local1:CustomLabel Grid.Row="2" Grid.RowSpan="2" Grid.Column="0" Text="{x:Static local:AppResources.NoBillsAvailable}" Style="{StaticResource MiniBlackLabelStyle}"  HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False">
                </local1:CustomLabel>
                <!--<BoxView Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="0.5" BackgroundColor="#d5d5d5" />
            <Image Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" Source="ic_home.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OnHomeIconClicked}" />
                </Image.GestureRecognizers>
            </Image>
            <Image Grid.Row="6" Grid.RowSpan="2" Grid.Column="1" Source="ic_question.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
            <Image Grid.Row="6" Grid.RowSpan="2" Grid.Column="5" Source="ic_user_2.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                 <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTaxPayerClicked" />
                </Image.GestureRecognizers>
            </Image>-->


            </Grid>
            <!-- Acticity indicator layout start -->
            <Grid Grid.Row="0" Grid.Column="0" IsVisible="False">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.7" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <ActivityIndicator IsVisible="true" IsRunning="true" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Color="White" />
                        <Label Text="{x:Static local:AppResources.ActivityIndicatorTitle}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" />
                    </StackLayout>
                </StackLayout>
            </Grid>
            <!-- Acticity indicator layout end -->
        </Grid>
    </ContentPage.Content>
</ContentPage>