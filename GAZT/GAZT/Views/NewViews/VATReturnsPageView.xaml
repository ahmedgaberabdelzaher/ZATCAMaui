        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" x:Name="MainGrid">
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"     ColumnSpacing="10" RowSpacing="0" Margin="0" Padding="0,0,0,10" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="12*" />
                    <RowDefinition Height="78*" />
                    <RowDefinition Height="auto" />

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="30*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="30*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="30*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />


                </Grid.ColumnDefinitions>


                <StackLayout HorizontalOptions="FillAndExpand" x:Name="TabInstruction"  IsVisible="{Binding IsVisibleInstrunction}"  VerticalOptions="FillAndExpand" Grid.Row="1" Margin="0,0,0,0" Grid.Column="0" Grid.ColumnSpan="8" >
                    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  >
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="0" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="15*"/>
                                <ColumnDefinition Width="85*"/>
                            </Grid.ColumnDefinitions>
                            <Frame Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"   Style="{StaticResource GAZTFrameStyleEntryForLableBackground}"   >
                            </Frame>
                            <Label Text="{x:Static local:AppResources.ZInstructions}"   VerticalOptions="Center" HorizontalOptions="CenterAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" >
                            </Label>

                            <Label Text="{x:Static local:AppResources.ZVatReadInstructions}"  Grid.Row="1" Grid.Column="0"  Grid.ColumnSpan="2"  HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"/>


                            <local1:CustomLabel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGreenLabelStyleForDashboardIcon}">
                                <local1:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="1."/>
                                        <Span Text="{x:Static local:AppResources.ZZPleasefilltherequestedinformationforeachstep}"/>
                                    </FormattedString>
                                </local1:CustomLabel.FormattedText>
                            </local1:CustomLabel>


                            <local1:CustomLabel  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2"  HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGreenLabelStyleForDashboardIcon}">
                                <local1:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="2."/>
                                        <Span Text="{x:Static local:AppResources.ZVatSubmittedInstructions}"/>
                                    </FormattedString>
                                </local1:CustomLabel.FormattedText>
                            </local1:CustomLabel>

                            <local1:CustomLabel  Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGreenLabelStyleForDashboardIcon}">
                                <local1:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="3."/>
                                        <Span Text="{x:Static local:AppResources.ZVatDateInstructions}"/>
                                    </FormattedString>
                                </local1:CustomLabel.FormattedText>
                            </local1:CustomLabel>

                            <local1:CustomLabel  Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGreenLabelStyleForDashboardIcon}">
                                <local1:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="4."/>
                                        <Span Text="{x:Static local:AppResources.ZVatFaqSectionInstructions}"/>
                                        <!--<Span Text="{x:Static local:AppResources.ZVatClickFaqInstructions}" >
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"></TapGestureRecognizer>
                                            </Span.GestureRecognizers>
                                        </Span>-->
                                    </FormattedString>
                                </local1:CustomLabel.FormattedText>
                            </local1:CustomLabel>

                            <Label Grid.Row="6" Text="{x:Static local:AppResources.ZVatClickFaqInstructions}" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGreenLabelStyleForDashboardIcon}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.onFaqSectionClicked}"></TapGestureRecognizer>
                                </Label.GestureRecognizers>
                            </Label>


                            <CheckBox x:Name="chkDeclaration" IsChecked="{Binding IsDeclarationCheckedForInstruction}" IsEnabled="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsDeclarationCheckEnabled}"  Grid.Row="7" Margin="10,0,10,0" Grid.Column="0">
                                <CheckBox.Triggers>
                                    <DataTrigger TargetType="CheckBox" Binding="{Binding Source={x:Reference chkDeclaration}, Path=IsChecked}" Value="false">
                                        <Setter Property="Color" Value="#ff0000" />
                                    </DataTrigger>
                                </CheckBox.Triggers>
                            </CheckBox>


                            <local:CustomLabel  Grid.Row="7" Grid.Column="1"   HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}">
                                <local:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static local:AppResources.ZVatDeclarationInstructions}"/>
                                    </FormattedString>
                                </local:CustomLabel.FormattedText>
                            </local:CustomLabel>

                            <!--<Label Text="00000000000.00" Grid.Row="2" Grid.Column="1"    HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"   Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>

                            <Label Text="Zakat Amount" Grid.Row="3" Grid.Column="0"  HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"/>

                            <Label Text="SAR 00000000000.00" Grid.Row="3" Grid.Column="1"    HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"   Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>

                            <Label Text="By Paying the invoice,GAZT Zakat Certificate will be issued to you automatically in case there are no other outstanding obligation,paying the invoice means you conform the correctness of the return information." Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"  HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand" Margin="10"  Style="{StaticResource GAZTGreenLabelStyleForDashboardIcon}"/>

                            <Button Text="Copy SADAD Payment Number" Command="{Binding OnCopySadadNumberButtonClicked}" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GAZTVerifyButton}"></Button>

                            <Button Text="Pay by MADA" Command="{Binding OnPayByMadaButtonClicked}" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTVerifyButton}"></Button>-->



                        </Grid>
                    </ScrollView>
                </StackLayout>


                <ScrollView  Orientation="Vertical" Grid.Row="1" Margin="0,0,0,0" x:Name="TabTaxPayerDetails"   Grid.Column="0" Grid.ColumnSpan="8" IsVisible="{Binding IsVisibleTaxPayerDetails}"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                    <Grid BindingContext="{Binding ResponseVATDeclarationD}" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="15*"/>
                            <ColumnDefinition Width="90*"/>
                        </Grid.ColumnDefinitions>

                        <Frame Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"    Style="{StaticResource GAZTFrameStyleEntryForLableBackground}"   >
                        </Frame>
                        <Label Text="{x:Static local:AppResources.ZVatTaxReturnDetails}"   VerticalOptions="Center" HorizontalOptions="CenterAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" >
                        </Label>


                        <Label Text="{x:Static local:AppResources.ZVatReturnType}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" >
                        </Label>
                        <Frame Grid.Row="2" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                        </Frame>
                        <custom:GAZTBorderlessEntry  Grid.Row="2" Text="{Binding Incotext}"  IsEnabled="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsTaxPayerControlEnabled}"  Grid.Column="0"  Grid.ColumnSpan="2" Style="{StaticResource GAZTTextBoxStyleForEntry}">

                        </custom:GAZTBorderlessEntry>



                        <Label Text="{x:Static local:AppResources.ZVatReturn}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" >
                        </Label>
                        <Frame Grid.Row="4" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                        </Frame>
                        <custom:GAZTBorderlessEntry  Grid.Row="4" Grid.ColumnSpan="2" IsEnabled="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsTaxPayerControlEnabled}" Grid.Column="0"  Text="{Binding Vrtaxret}"  Style="{StaticResource GAZTTextBoxStyleForEntry}">

                        </custom:GAZTBorderlessEntry>





                        <Label Text="{x:Static local:AppResources.ZVatReturnReferenceNo}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" >
                        </Label>
                        <Frame Grid.Row="6" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                        </Frame>
                        <custom:GAZTBorderlessEntry  Grid.Row="6"  Grid.Column="0" IsEnabled="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsTaxPayerControlEnabled}" Grid.ColumnSpan="2"  Text="{Binding Fbnum}"  Style="{StaticResource GAZTTextBoxStyleForEntry}">

                        </custom:GAZTBorderlessEntry>

                        <Label Text="{x:Static local:AppResources.ZTaxPeriod}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" >
                        </Label>
                        <Frame Grid.Row="8" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                        </Frame>
                        <custom:GAZTBorderlessEntry  Grid.Row="8"   Grid.Column="0" IsEnabled="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsTaxPayerControlEnabled}" Grid.ColumnSpan="2" Text="{Binding Perslt}"  Style="{StaticResource GAZTTextBoxStyleForEntry}">

                        </custom:GAZTBorderlessEntry>


                        <Label Text="{x:Static local:AppResources.ZVatPeriodFrom}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" >
                        </Label>
                        <Frame Grid.Row="10" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                        </Frame>
                        <custom:GAZTBorderlessEntry  Grid.Row="10" IsEnabled="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsTaxPayerControlEnabled}"  Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.TaxpayerPeriodFromDate}"  Style="{StaticResource GAZTTextBoxStyleForEntry}">

                        </custom:GAZTBorderlessEntry>

                        <Label Text="{x:Static local:AppResources.ZVatPeriodTo}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" >
                        </Label>
                        <Frame Grid.Row="12" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                        </Frame>
                        <custom:GAZTBorderlessEntry  Grid.Row="12"  IsEnabled="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsTaxPayerControlEnabled}" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.TaxpayerPeriodToDate}"  Style="{StaticResource GAZTTextBoxStyleForEntry}">

                        </custom:GAZTBorderlessEntry>



                        <Frame Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2"   Style="{StaticResource GAZTFrameStyleEntryForLableBackground}"   >
                        </Frame>
                        <Label Text="{x:Static local:AppResources.ZTaxpayerInformation}"   VerticalOptions="Center" HorizontalOptions="CenterAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" >
                        </Label>


                        <Label Text="{x:Static local:AppResources.TIN}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2" >
                        </Label>
                        <Frame Grid.Row="15" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                        </Frame>
                        <custom:GAZTBorderlessEntry  Grid.Row="15" IsEnabled="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsTaxPayerControlEnabled}"  Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Gpart}"  Style="{StaticResource GAZTTextBoxStyleForEntry}">

                        </custom:GAZTBorderlessEntry>


                        <Label Text="{x:Static local:AppResources.ZVATAccountNumber}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2" >
                        </Label>
                        <Frame Grid.Row="17" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                        </Frame>
                        <custom:GAZTBorderlessEntry  Grid.Row="17"  IsEnabled="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsTaxPayerControlEnabled}" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Fin}"  Style="{StaticResource GAZTTextBoxStyleForEntry}">

                        </custom:GAZTBorderlessEntry>

                        <Label Text="{x:Static local:AppResources.ZVatIdentificationNumber}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2" >
                        </Label>
                        <Frame Grid.Row="19" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                        </Frame>
                        <custom:GAZTBorderlessEntry  Grid.Row="19"  IsEnabled="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsTaxPayerControlEnabled}" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Idnumber}"  Style="{StaticResource GAZTTextBoxStyleForEntry}">

                        </custom:GAZTBorderlessEntry>

                        <Label Text="{x:Static local:AppResources.ZVatTaxpayersName}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="20" Grid.Column="0" Grid.ColumnSpan="2" >
                        </Label>
                        <Frame Grid.Row="21" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                        </Frame>
                        <custom:GAZTBorderlessEntry  Grid.Row="21"  IsEnabled="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsTaxPayerControlEnabled}" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Tpnm}"  Style="{StaticResource GAZTTextBoxStyleForEntry}">

                        </custom:GAZTBorderlessEntry>


                        <Label Text="{x:Static local:AppResources.ZVatAddress}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="22" Grid.Column="0" Grid.ColumnSpan="2" >
                        </Label>
                        <Frame Grid.Row="23" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2" HeightRequest="100">
                        </Frame>
                        <custom:GAZTBorderlessEditor Placeholder="Enter address here" HeightRequest="100"  Grid.Row="23"  IsEnabled="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsTaxPayerControlEnabled}" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.FullAddress}"  Style="{StaticResource GAZTTextBoxStyleForEntry}" Margin="12,3,12,3">

                        </custom:GAZTBorderlessEditor>



                        <CheckBox x:Name="chkClearification" CheckedChanged="chkClearification_CheckedChanged" IsEnabled="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsTaxPayerCheckEnabled}" IsChecked="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsCheckedTaxPayerDetailsInfo}" Grid.Row="24" Margin="10,0,10,0" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                            <CheckBox.Triggers>
                                <DataTrigger TargetType="CheckBox" Binding="{Binding Source={x:Reference chkClearification}, Path=IsChecked}" Value="false">
                                    <Setter Property="Color" Value="#ff0000" />
                                </DataTrigger>
                            </CheckBox.Triggers>
                        </CheckBox>

                        <local1:CustomLabel Text="{x:Static local:AppResources.ZVatConfirmMessage}"  Style="{DynamicResource searchBarStyleForClearificationChb}" Grid.Row="24" Grid.Column="1"  >
                        </local1:CustomLabel>

                        <!--<Label  Grid.Row="24" Grid.Column="1"   HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{DynamicResource searchBarStyleForDeclarationChb}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Kindly confirm that the above information is correct before proceeding."/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label-->


                        <!--<local1:CustomLabel  Grid.Row="25" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,0" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGreenLabelStyleForDashboardIcon}">
                            <local1:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.ZVatNote}" FontAttributes="Bold"/>
                                    <Span Text=":" />
                                    <Span Text="{x:Static local:AppResources.ZVatNoteDetail}"/>
                                    --><!--<Span Text="Change of registration form."/>--><!--
                                </FormattedString>
                            </local1:CustomLabel.FormattedText>
                        </local1:CustomLabel>-->

                    </Grid>



                </ScrollView>


                <ScrollView Orientation="Vertical" x:Name="TabVatReturn"  Grid.Row="1" Margin="0,0,0,0" Grid.Column="0" Grid.ColumnSpan="8"  IsVisible="{Binding IsVisibleVatReturnForm}"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                    <Grid BindingContext="{Binding ResponseVATDeclarationD}" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86*"/>
                            <ColumnDefinition Width="14*"/>
                        </Grid.ColumnDefinitions>

                        <Frame Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"   Style="{StaticResource GAZTFrameStyleEntryForLableBackground}"   >
                        </Frame>
                        <Label Text="{x:Static local:AppResources.ZVatOnSales}"   VerticalOptions="Center" HorizontalOptions="CenterAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" >
                        </Label>

                        <Label Text="{x:Static local:AppResources.ZVatStandardRatedSales}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" >
                        </Label>

                        <Frame Grid.Row="2" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                            <Frame.Triggers>
                                <DataTrigger TargetType="Frame" Binding="{Binding Source={x:Reference EntryVatAmount}, Path=Text.Length}" Value="0">
                                    <Setter Property="BorderColor" Value="#ff0000" />
                                </DataTrigger>

                            </Frame.Triggers>

                        </Frame>
                        <custom:GAZTBorderlessEntry x:Name="EntryVatAmount"  Unfocused="EntryVatAmount_Unfocused" IsEnabled="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsControlEnabled}" Keyboard="Numeric" TextChanged="ClickGestureRecognizer_ClickedForVatAmount" Placeholder="{x:Static local:AppResources.ZVatAmountWithSAR}" Grid.ColumnSpan="2" Grid.Row="2" Text="{Binding StdsalesAmt}"    Grid.Column="0"   Style="{StaticResource GAZTTextBoxStyleForEntry}">
                            <!--<custom:GAZTBorderlessEntry.Behaviors>
                                <custom1:DecimalPlacesConverter/>
                            </custom:GAZTBorderlessEntry.Behaviors>-->
                             <custom:GAZTBorderlessEntry.Behaviors>
                                    <custom:ElevenDotTwoDecimalPlacesAndNoNegativeValue Max="17" numberOfDigitAfterDecimal="2" numberOfDigitBeforDecimal="14"/>
                                </custom:GAZTBorderlessEntry.Behaviors>
                            <!--<custom:GAZTBorderlessEntry.GestureRecognizers>
                                <TapGestureRecognizer  Command="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.onStandardRatedSalesVatAmountTapped}" />
                            </custom:GAZTBorderlessEntry.GestureRecognizers>-->
                        </custom:GAZTBorderlessEntry>
                        <Image Grid.Row="2"  Grid.Column="1"  Margin="0,0,0,0" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_info.png"  >
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnStandardRatedSalesAmountClicked" />
                            </Image.GestureRecognizers>
                        </Image>

                        <Frame Grid.Row="3" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                            <Frame.Triggers>
                                <DataTrigger TargetType="Frame" Binding="{Binding Source={x:Reference EntryVatAdjustmentWithSAR}, Path=Text.Length}" Value="0">
                                    <Setter Property="BorderColor" Value="#ff0000" />
                                </DataTrigger>
