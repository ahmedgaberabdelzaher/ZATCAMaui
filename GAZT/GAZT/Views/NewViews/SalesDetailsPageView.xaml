<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="GAZT.Views.NewViews.SalesDetailsPageView"
             FlowDirection="LeftToRight"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:local="clr-namespace:GAZT;assembly:GAZT"
             Title="{x:Static local:AppResources.ZSalesDetails}">
    <ContentPage.Content>

        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="67*"/>
                    <RowDefinition Height="auto"/>
               
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>

                <Label Text="FiscalYear" Grid.Row="0"   HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Grid.Column="0"  Style="{StaticResource GAZTSmallBlackLabelStyle}"/>

                <Label Text="2019-2010" Grid.Row="0" Grid.Column="1"    HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"   Style="{StaticResource GAZTGrayLabelStyleForSmallFont}"/>

                <Label Text="Financial Period From"  Grid.Row="1" HorizontalOptions="StartAndExpand"  VerticalOptions="CenterAndExpand" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GAZTSmallBlackLabelStyle}"/>

                <Label Text="13 جمادى 1441 هـ - 13 جمادى 1441 هـ"  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"   Style="{StaticResource GAZTGrayLabelStyleForSmallFont}"/>

                <BoxView  Grid.Row="3" Margin="0,5,0,5"  Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTBoxViewStyle}" ></BoxView>


                <Label Text="Estimated Sales For Ficsal Year" Margin="10,0,10,0"   Grid.Row="4" Grid.Column="0"   HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGreenLabelStyleForDashboardIcon}"/>

                <Label Text="SAR 1800000.000" Margin="10,0,10,0"  Grid.Row="4" Grid.Column="1"   HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForSmallFont}"/>

                <BoxView  Grid.Row="5" Margin="0,5,0,5"  Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTBoxViewStyle}" ></BoxView>


                <ListView  x:Name="SalesDetails" 
           ItemsSource="{Binding SalesDetailsList}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                           
                      Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
            SeparatorVisibility="Default"
            >
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55*"/>
                                            <ColumnDefinition Width="45*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label  Text="{Binding SalesType}" Margin="10,-40,10,-20" Grid.Row="3"  Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}">
                                        </Label>
                                        <Label  Text="Information from releated parties" Margin="10,-40,10,-30"  Grid.Row="4" Grid.Column="0" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGreenLabelStyleForMicro}">
                                        </Label>
                                        <Label  Text="Estimate Sales" Grid.Row="4" Grid.Column="1" Margin="10,-40,10,-30" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGreenLabelStyleForMicro}">
                                        </Label>
                                        <Label Text="{Binding InformationFromPartie}" Margin="10,-10,10,3"  Grid.Row="5" Grid.Column="0"   HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>
                                        <Label Text="{Binding EstimateSales}" Margin="10,-10,10,3"  Grid.Row="5" Grid.Column="1"   HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>
                                    </Grid>
                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackLayout Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="White" Padding="0,40,0,40" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                    
                </StackLayout>
                
                <Button Text="Accept Return" HorizontalOptions="FillAndExpand" VerticalOptions="Center" Grid.Row="7" Grid.Column="0" Command="{Binding OnChangeEmailSubmitButtonClicked}"  Style="{StaticResource GAZTVerifyButton}"></Button>

                <Button Text="AmendReturn" HorizontalOptions="FillAndExpand" VerticalOptions="Center" Grid.Row="7" Grid.Column="1" Command="{Binding OnChangeEmailSubmitButtonClicked}"   Style="{StaticResource GAZTVerifyButton}"></Button>

            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>