<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
               xmlns:custom="clr-namespace:GAZT"
           
               xmlns:local1="clr-namespace:GAZT"
               xmlns:local="clr-namespace:GAZT"
               xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
              
             Title="{x:Static local:AppResources.ZZFormBundleStatus}"
                          xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
              NavigationPage.HasNavigationBar="False"
             x:Class="GAZT.Views.NewViews.FormBundleStatusPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary Source="..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <!--  Title View  -->
                <controls:TitleView Title="{x:Static local:AppResources.ZZFormBundleStatus}"  FontFamily="{StaticResource GESSTwoBold}" BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.BackButtonClicked}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="#006450"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{StaticResource Back}"
                            
                            
                             />
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>


    <ContentPage.Content>
        
        
        <StackLayout>
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White">
                <!--Padding="10,20,10,0"-->
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"    Margin="0" Padding="10,20,10,10" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />

                        <RowDefinition Height="auto" />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="auto" />




                    </Grid.ColumnDefinitions>

                    <!--SelectedIndex="{Binding IDTypeIndex}" Margin="10,-6,10,-6" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"  Padding="10,20,10,0"-->
                    
                    <inputLayout:SfTextInputLayout  Margin="10,-6,10,-6"  
    Hint="{x:Static local:AppResources.ZZPleaseselectFormBundleType}"  Grid.Row="0" Grid.Column="0"
    ContainerType="Outlined" x:Name="FrmIDType"  UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                        <custom:BorderlessEntry Text="{Binding TxtFBtype}" FontSize="Small">
                        </custom:BorderlessEntry>
                    </inputLayout:SfTextInputLayout>
                    <custom:CustomButton x:Name="btn" Clicked="TapGestureRecognizer_Tapped" FontSize="Small" BackgroundColor="Transparent" Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" >
                    </custom:CustomButton>
                    <syncfusion:SfPicker x:Name="DDlIDType"
                    HeaderHeight="50"
                    ShowHeader="true"
                    HeaderText="{x:Static local:AppResources.ZZPleaseselectFormBundleType}"
                    ShowColumnHeader="True"
                    
                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"
                                SelectedItemFontSize="15"               
                   ItemHeight="40"
                    SelectedItem="{Binding SelectedFormBindleFbtyp,Mode=TwoWay }" DisplayMemberPath="Txt50" ItemsSource="{Binding FormBundleList}" CancelButtonClicked="DDlIDType_CancelButtonClicked"  OkButtonClicked="DDlIDType_OkButtonClicked"  Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" SelectionChanged="DDlIDType_SelectionChanged" 
                    PickerHeight="280"
                    PickerWidth="350"
                    ShowFooter="True" FooterHeight="46">
                        <syncfusion:SfPicker.Behaviors>
                            <custom1:SfPickerBehavior />
                        </syncfusion:SfPicker.Behaviors>
                    </syncfusion:SfPicker>
                    <!--SelectedItem="{Binding SelectedSignUpUsing,Mode=TwoWay}"-->





                    <!--pickere 1 new-->

                        <!--<Frame Grid.Row="0"  Margin="10,13,10,0" Padding="13" VerticalOptions="FillAndExpand" Grid.Column="0" Grid.ColumnSpan="7"  Style="{StaticResource GAZTFrameStyleForEntry}"    >

                    </Frame>

                    <custom:GAZTBorderlessPicker x:Name="BPicker" Margin="10,13,10,0" Title="{x:Static local:AppResources.ZZPleaseselectFormBundleType}" VerticalOptions="CenterAndExpand" Style="{StaticResource GAZTDropdownStyle}"  IsEnabled="true"   ItemsSource="{Binding FormBundleList}" ItemDisplayBinding="{Binding Txt50}"   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="5" SelectedItem="{Binding SelectedFormBindleFbtyp }" ></custom:GAZTBorderlessPicker>

                    <Image Grid.Row="0"  Grid.Column="6"  x:Name="BPicker_imgtap" Margin="0,13,0,0"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Source="ic_dropdownOne.png" >
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                        </Image.GestureRecognizers>
                    </Image>-->


 




                    <!--HDHBHFBDBV-->
                    
                    
                    <inputLayout:SfTextInputLayout  Margin="10,-6,10,-6"  
    Hint="{x:Static local:AppResources.ZZPleaseselectFormBundleNumber}"  Grid.Row="1" Grid.Column="0" 
    ContainerType="Outlined" x:Name="FrmIDType1"  UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                        <custom:BorderlessEntry Text="{Binding TxtFBnum}" FontSize="Small">
                        </custom:BorderlessEntry>
                    </inputLayout:SfTextInputLayout>
                    <custom:CustomButton x:Name="btn1" Clicked="TapGestureRecognizer_Tapped_1" FontSize="Small" BackgroundColor="Transparent" Grid.Row="1" Grid.Column="0" Margin="10,0,10,0" >
                    </custom:CustomButton>
                    <syncfusion:SfPicker x:Name="CPicker"
                    HeaderHeight="40"
                    ShowHeader="true"
                    HeaderText="{x:Static local:AppResources.ZZPleaseselectFormBundleNumber}"
                    ShowColumnHeader="True"
                    
                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"
                                               
                   ItemHeight="40"
                   SelectedItem="{Binding SelectedFormBindleFbnum}" DisplayMemberPath="Fbnum" ItemsSource="{Binding FormBundleApplicatioNumberList}"     Grid.Row="1" Grid.Column="0" Margin="10,0,10,0"
                    PickerHeight="280" SelectionChanged="CPicker_SelectionChanged" OkButtonClicked="CPicker_OkButtonClicked"
                    PickerWidth="350" IsEnabled="True"
                    ShowFooter="True" FooterHeight="46">
                        <syncfusion:SfPicker.Behaviors>
                            <custom1:SfPickerBehavior />
                        </syncfusion:SfPicker.Behaviors>
                    </syncfusion:SfPicker>
                    
                    
                    
                    
                    
                    
                    
                    <!--<Frame Grid.Row="1"  Margin="10,13,10,0" Padding="13" VerticalOptions="FillAndExpand" Grid.Column="0" Grid.ColumnSpan="7"  Style="{StaticResource GAZTFrameStyleForEntry}"   >

                    </Frame>
                    <custom:GAZTBorderlessPicker x:Name="CPicker" Title="{x:Static local:AppResources.ZZPleaseselectFormBundleNumber}" Margin="10,13,10,0" VerticalOptions="CenterAndExpand" Style="{StaticResource GAZTDropdownStyle}"   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"  ItemsSource="{Binding FormBundleApplicatioNumberList}" ItemDisplayBinding="{Binding Fbnum}"  SelectedItem="{Binding SelectedFormBindleFbnum}" IsEnabled="{Binding IsCPickerEnable}"></custom:GAZTBorderlessPicker>

                    <Image Grid.Row="1"  Grid.Column="6"  x:Name="CPicker_imgtap"  Margin="0,13,0,0"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Source="ic_dropdownOne.png" >
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer  Tapped="TapGestureRecognizer_Tapped_1" />
                        </Image.GestureRecognizers>
                    </Image>-->

