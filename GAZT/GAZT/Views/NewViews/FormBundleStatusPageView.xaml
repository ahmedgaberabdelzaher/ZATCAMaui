<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
               xmlns:custom="clr-namespace:GAZT"
             FlowDirection="RightToLeft"
               xmlns:local1="clr-namespace:GAZT"
               xmlns:local="clr-namespace:GAZT"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             Title="{x:Static local:AppResources.ZZFormBundleStatus}"
                          xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             x:Class="GAZT.Views.NewViews.FormBundleStatusPageView">
    <ContentPage.Content>
        <StackLayout>
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White">

                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  ColumnSpacing="10" RowSpacing="10" Margin="0" Padding="0,0,0,10" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="10*" />
                        
                        <RowDefinition Height="70*" />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="30*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="30*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="18*" />
                        <ColumnDefinition Width="14*" />




                    </Grid.ColumnDefinitions>

                    <!--SelectedIndex="{Binding IDTypeIndex}"-->
                    <inputLayout:SfTextInputLayout  Margin="10,-6,10,-6"   Padding="13"
    Hint="{x:Static local:AppResources.ZZPleaseselectFormBundleType}"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7"
    ContainerType="Outlined" x:Name="FrmIDType"  UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                        <custom:BorderlessEntry Text="{Binding TxtFBtype}" FontSize="Small">
                        </custom:BorderlessEntry>
                    </inputLayout:SfTextInputLayout>
                    <custom:CustomButton x:Name="btn" Clicked="TapGestureRecognizer_Tapped" FontSize="Small" BackgroundColor="Transparent" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" Margin="10,0,10,0" >
                    </custom:CustomButton>
                    <syncfusion:SfPicker x:Name="DDlIDType"
                    HeaderHeight="40"
                    ShowHeader="true"
                    HeaderText="{x:Static local:AppResources.ZZPleaseselectFormBundleType}"
                    ShowColumnHeader="True"
                    
                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"
                                               
                   ItemHeight="40"
                    SelectedItem="{Binding SelectedFormBindleFbtyp,Mode=TwoWay }" DisplayMemberPath="Txt50" ItemsSource="{Binding FormBundleList}"    Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" Margin="10,0,10,0" SelectionChanged="DDlIDType_SelectionChanged"
                    PickerHeight="280"
                    PickerWidth="270"
                    ShowFooter="True" FooterHeight="46">
                        <syncfusion:SfPicker.Behaviors>
                            <custom1:SfPickerBehavior />
                        </syncfusion:SfPicker.Behaviors>
                    </syncfusion:SfPicker>
                    <!--SelectedItem="{Binding SelectedSignUpUsing,Mode=TwoWay}"-->





                    <!--pickere 1 new-->

                        <!--<Frame Grid.Row="0"  Margin="10,13,10,0" Padding="13" VerticalOptions="FillAndExpand" Grid.Column="0" Grid.ColumnSpan="7"  Style="{StaticResource GAZTFrameStyleForEntry}"    >

                    </Frame>

                    <custom:GAZTBorderlessPicker x:Name="BPicker" Margin="10,13,10,0" Title="{x:Static local:AppResources.ZZPleaseselectFormBundleType}" VerticalOptions="CenterAndExpand" Style="{StaticResource GAZTDropdownStyle}"  IsEnabled="true"   ItemsSource="{Binding FormBundleList}" ItemDisplayBinding="{Binding Txt50}"   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="5" SelectedItem="{Binding SelectedFormBindleFbtyp }" ></custom:GAZTBorderlessPicker>

                    <Image Grid.Row="0"  Grid.Column="6"  x:Name="BPicker_imgtap" Margin="0,13,0,0"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Source="ic_dropdownOne.png" >
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                        </Image.GestureRecognizers>
                    </Image>-->


 




                    <!--HDHBHFBDBV-->
                    
                    
                    <inputLayout:SfTextInputLayout  Margin="10,-6,10,-6"   Padding="13"
    Hint="{x:Static local:AppResources.ZZPleaseselectFormBundleNumber}"  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7"
    ContainerType="Outlined" x:Name="FrmIDType1"  UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                        <custom:BorderlessEntry Text="{Binding TxtFBnum}" FontSize="Small">
                        </custom:BorderlessEntry>
                    </inputLayout:SfTextInputLayout>
                    <custom:CustomButton x:Name="btn1" Clicked="TapGestureRecognizer_Tapped_1" FontSize="Small" BackgroundColor="Transparent" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" Margin="10,0,10,0" >
                    </custom:CustomButton>
                    <syncfusion:SfPicker x:Name="CPicker"
                    HeaderHeight="40"
                    ShowHeader="true"
                    HeaderText="{x:Static local:AppResources.ZZPleaseselectFormBundleNumber}"
                    ShowColumnHeader="True"
                    
                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"
                                               
                   ItemHeight="40"
                   SelectedItem="{Binding SelectedFormBindleFbnum}" DisplayMemberPath="Fbnum" ItemsSource="{Binding FormBundleApplicatioNumberList}"     Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" Margin="10,0,10,0"
                    PickerHeight="280" SelectionChanged="CPicker_SelectionChanged" OkButtonClicked="CPicker_OkButtonClicked"
                    PickerWidth="270" IsEnabled="True"
                    ShowFooter="True" FooterHeight="46">
                        <syncfusion:SfPicker.Behaviors>
                            <custom1:SfPickerBehavior />
                        </syncfusion:SfPicker.Behaviors>
                    </syncfusion:SfPicker>
                    
                    
                    
                    
                    
                    
                    
                    <!--<Frame Grid.Row="1"  Margin="10,13,10,0" Padding="13" VerticalOptions="FillAndExpand" Grid.Column="0" Grid.ColumnSpan="7"  Style="{StaticResource GAZTFrameStyleForEntry}"   >

                    </Frame>
                    <custom:GAZTBorderlessPicker x:Name="CPicker" Title="{x:Static local:AppResources.ZZPleaseselectFormBundleNumber}" Margin="10,13,10,0" VerticalOptions="CenterAndExpand" Style="{StaticResource GAZTDropdownStyle}"   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"  ItemsSource="{Binding FormBundleApplicatioNumberList}" ItemDisplayBinding="{Binding Fbnum}"  SelectedItem="{Binding SelectedFormBindleFbnum}" IsEnabled="{Binding IsCPickerEnable}"></custom:GAZTBorderlessPicker>

                    <Image Grid.Row="1"  Grid.Column="6"  x:Name="CPicker_imgtap"  Margin="0,13,0,0"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Source="ic_dropdownOne.png" >
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer  Tapped="TapGestureRecognizer_Tapped_1" />
                        </Image.GestureRecognizers>
                    </Image>-->

                    <!--<ListView  x:Name="fblist" 
           ItemsSource="{Binding ListFormBudles}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                           Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="7"
                              Margin="10,13,10,0"
                               
                 
            SeparatorVisibility="None"
            >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout>
                                        <Label Text="{Binding Fbnum}"></Label>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>-->

                    <StackLayout Margin="10,0,10,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="7" >
                        <ListView  
           ItemsSource="{Binding ListFormBudles}"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                               BackgroundColor="White"
                            ItemTapped="ListView_ItemTapped"
            SeparatorVisibility="None"
            >
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>

                                        <cards:SfCardView HasShadow="True" Margin="10" Opacity=".9" BorderWidth=".05" BorderColor="#5d6770"  ShadowColor="#5d6770" BackgroundColor="White" CornerRadius="8"  IndicatorColor="{Binding Colorcode}" IndicatorPosition="Left" IndicatorThickness="5" >
                                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Margin="1,1,1,1" Padding="0,0,0,0" BackgroundColor="White" local1:RoundCornersEffect.CornerRadius="10">

                                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Margin="5,0,5,5" Padding="0" >
                                                    <Grid ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White" >
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />

                                                           
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                           
                                                        </Grid.RowDefinitions>

                                                        <Label Text="{x:Static local:AppResources.ZStatus}" Margin="0" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                           />

                                                        <Label Text="{Binding FbStatus}" 
                                                  
                                  Margin="0" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                                           />


                                                        <Label 
                                                 Style="{StaticResource MiniGoldLabelStyle}"
                                  
                                                HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                             
                                   Grid.Column="0"
                                                        Grid.ColumnSpan="4"
                                                         Text="{x:Static local:AppResources.ZZDescriptionForFormBundle}"
                                   >

                                                        </Label>

                                                                <Label Text="{Binding FbDesc}" 
                                                 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                                           />


                                                            </Grid>
                                                </StackLayout>
                                         </StackLayout>
                                        
                                        </cards:SfCardView>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackLayout>

                </Grid>

            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>