           ItemsSource="{Binding ListFormBudles}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                           Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="7"
                              Margin="10,13,10,0"
                               
                 
            SeparatorVisibility="None"
            >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
