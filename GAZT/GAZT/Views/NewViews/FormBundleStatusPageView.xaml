                    </ListView>-->

                    <!--<StackLayout Margin="10,0,10,0" HorizontalOptions="FillAndExpand"  Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="7" >-->
                        <ListView    Grid.Row="2"  Grid.Column="0"
           ItemsSource="{Binding ListFormBudles}"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="Start"
            HasUnevenRows="True"
                               BackgroundColor="White"
                            ItemTapped="ListView_ItemTapped"
            SeparatorVisibility="None"
            >
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>

                                        <cards:SfCardView HasShadow="True" Margin="10" Opacity=".9" BorderWidth=".05" BorderColor="#5d6770"  ShadowColor="#5d6770" BackgroundColor="White" CornerRadius="8"  IndicatorColor="{Binding Colorcode}" IndicatorPosition="Left" IndicatorThickness="5" >
                                                
                                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Margin="0" Padding="10" >
                                                    <Grid ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand"  BackgroundColor="White" >
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />

                                                           
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />

                                                           
                                                        </Grid.RowDefinitions>

                                                        <Label  Margin="0" 
                                  
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0" 
                                                           >
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.ZStatus}"></Span>
                                                                    <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                                    <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding FbStatus}"></Span>
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>




                                                        <!--<Label Text="{x:Static local:AppResources.ZStatus}" Margin="0" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                           />

                                                        <Label Text="{Binding FbStatus}" 
                                                  
                                  Margin="0" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                                           />-->


                                                        <Label  Margin="0" 
                                  
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0" 
                                                           >
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.ZZDescriptionForFormBundle}"></Span>
                                                                    <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                                    <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding FbDesc}"></Span>
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>



                                                        <!--<Label 
                                                 Style="{StaticResource MiniGoldLabelStyle}"
                                  
                                                HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                             
                                   Grid.Column="0"
                                                        Grid.ColumnSpan="4"
                                                         Text="{x:Static local:AppResources.ZZDescriptionForFormBundle}"
                                   >

                                                        </Label>

                                                                <Label Text="{Binding FbDesc}" 
                                                 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                                           />-->


                                                            </Grid>
                                                </StackLayout>
                                     
                                        </cards:SfCardView>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    <!--</StackLayout>-->

                </Grid>

            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>