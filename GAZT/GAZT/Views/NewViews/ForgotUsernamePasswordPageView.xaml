<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="GAZT.Views.NewViews.ForgotUsernamePasswordPageView"   xmlns:cards="clr-namespace:PanCardView;assembly=PanCardView"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms"
             xmlns:local1="clr-namespace:GAZT"
             xmlns:local="clr-namespace:GAZT"
             FlowDirection="RightToLeft">
    <ContentPage.Content>
         <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
           
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="10" >
                <Grid Grid.Row="0" Grid.Column="0" RowSpacing="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88*" />
                        <RowDefinition Height="10*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*" />
                    </Grid.ColumnDefinitions>
                    <!--<skia:SKCanvasView Margin="0,-2,0,0" x:Name="canvasView" Grid.Row="0" Grid.Column="0" PaintSurface="OnCanvasViewPaintSurface" />-->
                    <Grid Grid.Row="0" Grid.Column="0" RowSpacing="5" Padding="0" ColumnSpacing="5 " HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*" />
                            <ColumnDefinition Width="50*" />
                        </Grid.ColumnDefinitions>

                        <!--  forgot userName with Corporate-->
                        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"  Margin="0,0,0,0" Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start" >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.SelectPasswordUserName}" />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Frame  Grid.Row="1"   Grid.Column="0" Grid.ColumnSpan="2"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="0,0,0,0" >
                        </Frame>
                        <StackLayout    Grid.Row="1"  Grid.Column="0" Grid.ColumnSpan="2"    HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5"  >
                            <local1:GAZTBorderlessPicker Style="{StaticResource PickerStyle}"    Grid.Row="1"      FontSize="10"  Title="{x:Static local:AppResources.SelectPasswordUserName}" IsEnabled="true" TextColor="Black"  SelectedItem="{Binding SelectedForgotType, Mode=TwoWay}" ItemsSource="{Binding ForgotTypeList}" ItemDisplayBinding="{Binding CredentialType}" Margin="0,0,0,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                        </StackLayout>
                       <Image Source="ic_dropdownOne.png"  Margin="9,0,9,0" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"  HorizontalOptions="End" VerticalOptions="CenterAndExpand"/>


                        <Label Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0" Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start" IsVisible="{Binding IsIDTypeVisible}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.IDType}"  />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Frame  Grid.Row="3"   Grid.Column="0" Grid.ColumnSpan="2"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="0,0,0,0" IsVisible="{Binding IsIDTypeVisible}">
                        </Frame>
                        <StackLayout Grid.Row="3"    Grid.Column="0" Grid.ColumnSpan="2"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5"  IsVisible="{Binding IsIDTypeVisible}" >
                            <local1:GAZTBorderlessPicker Style="{StaticResource PickerStyle}" Grid.Row="3"     FontSize="10"  Title="{x:Static local:AppResources.IDType}"  TextColor="Black" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" SelectedItem="{Binding SelectedTaxPayerType, Mode=TwoWay}" ItemsSource="{Binding TaxpayerTypeList}" ItemDisplayBinding="{Binding TaxPayerType}"  Margin="0,0,0,0" IsEnabled="{Binding IsTaxPayerTypeEnable}" IsVisible="{Binding IsIDTypeVisible}"/>
                        </StackLayout>
                        <Image Source="ic_dropdownOne.png"  Margin="0,0,0,0" Grid.Row="3"    Grid.Column="0" Grid.ColumnSpan="2"  HorizontalOptions="End" VerticalOptions="CenterAndExpand" IsVisible="{Binding IsIDTypeVisible}"/>


                        <Label Grid.Row="4"  Grid.Column="0" Grid.ColumnSpan="2"  Margin="0,0,0,0" Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start"  >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding IDNumberOrCorporateIDOrUserName}"  />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Frame  Grid.Row="5"    Grid.Column="0" Grid.ColumnSpan="2"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="0,0,0,0" >
                        </Frame>
                        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0,0,0,0"  Grid.Row="5"    Grid.Column="0" Grid.ColumnSpan="2"   >
                            <local1:GAZTBorderlessEntry  Text="{Binding IDNumber}" Unfocused="OnUserNameUnFocussed" Focused="OnUserNAmeFocused" TextChanged="OnIDNumberTextChanged" x:Name="UserName"  Placeholder="{Binding IDNumberOrCorporateIDOrUserName}" Style="{StaticResource GAZTTextBoxStyleForEntry}" Grid.Row="5"     Margin="5" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" BackgroundColor="White" >
                            </local1:GAZTBorderlessEntry>
                        </StackLayout>

                        <Label Grid.Row="6"  Grid.Column="0" Grid.ColumnSpan="2"  Margin="0,0,0,0" Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start" IsVisible="{Binding IsVisibleTinIds}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.TINS}" />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Frame  Grid.Row="7"   Grid.Column="0" Grid.ColumnSpan="2"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="0,0,0,0" IsVisible="{Binding IsVisibleTinIds}">
                        </Frame>
                        <StackLayout Grid.Row="7"   Grid.Column="0" Grid.ColumnSpan="2"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5"  IsVisible="{Binding IsVisibleTinIds}" >
                            <local1:GAZTBorderlessPicker Style="{StaticResource PickerStyle}" Grid.Row="7"  Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsVisibleTinIds}" SelectedItem="{Binding SelectedTinId, Mode=TwoWay}" ItemsSource="{Binding TINs}" TextColor="Black" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ItemDisplayBinding="{Binding Tin}"  Margin="10,0,10,0" ></local1:GAZTBorderlessPicker >
                        </StackLayout>
                        <Image Source="ic_dropdownOne.png"  Margin="0,0,0,0" Grid.Row="7"  Grid.Column="0" Grid.ColumnSpan="2"  HorizontalOptions="End" VerticalOptions="CenterAndExpand" IsVisible="{Binding IsVisibleTinIds}"/>


                        <Frame Grid.Row="9"   Grid.Column="1"    HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="0,0,0,0">
                        </Frame>
                        <Label  Text="{Binding Captcha}" Style="{StaticResource MiniGoldLabelStyle}" Grid.Row="9"   Grid.Column="1"    HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="White">

                        </Label>
                        <!--<StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="15,0,15,0"  Grid.Row="9"  Grid.Column="1"   >

                        <local1:GAZTBorderlessEntry Text="{Binding Captcha}" Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="9"   Grid.Column="1"   Margin="2,1,2,1" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" BackgroundColor="White">
                        </local1:GAZTBorderlessEntry>
                    </StackLayout>-->
                        <Image Grid.Row="9"  Grid.Column="1"   Source="ic_sync_captcha.png" Aspect="AspectFit" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,0,0">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnCaptchaRegenerateClicked}" />
                            </Image.GestureRecognizers>
                        </Image>

                        <Label Grid.Row="8"  Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,0,10,0" Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start" >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.Captcha}" />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Frame  Grid.Row="9"  Grid.Column="0"     HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="0,0,0,0">
                        </Frame>

                        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5"  Grid.Row="9"  Grid.Column="0"   >

                            <local1:GAZTBorderlessEntry Text="{Binding EnteredCaptchaValue}" Placeholder="{x:Static local:AppResources.Captcha}" Style="{StaticResource GAZTTextBoxStyleForEntry}" Grid.Row="9"   Grid.Column="0"   Margin="5" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" BackgroundColor="White">
                            </local1:GAZTBorderlessEntry>
                        </StackLayout>

                    </Grid>
                    <Frame HorizontalOptions="FillAndExpand" IsEnabled="{Binding IsLoginEnabled}" VerticalOptions="FillAndExpand" Grid.Row="1"  Grid.Column="0" Grid.ColumnSpan="2" HasShadow="false" CornerRadius="4" BackgroundColor="#005e4b" Margin="0,0,0,0">
                    </Frame>
                    <Label   Text="{x:Static local:AppResources.Submit}" IsEnabled="True" Style="{StaticResource SmallWhiteLabelStyle}"  Grid.Row="1" Grid.Column="0"  HorizontalTextAlignment="Center" VerticalOptions="Center" VerticalTextAlignment="Center" Margin="0,0,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnSubmitClicked}" />
                        </Label.GestureRecognizers>
                    </Label>

                </Grid>
                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Spacing="10"  IsVisible="{Binding NewPasswordLayoutVisibility}" BackgroundColor="White" Margin="0,0,0,0">

                    <Grid Grid.Row="0" Grid.Column="0" RowSpacing="5" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />

                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0"   Text="{x:Static local:AppResources.PasswordGuidelineText}" Margin="0,0,0,0" Style="{StaticResource InformationRedColorLabel}"  HorizontalOptions="Start"  HorizontalTextAlignment="Start">
                        </Label>

                        <Label Grid.Row="1" Grid.Column="0"    Margin="0,0,0,0" Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start" >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span  Text="{x:Static local:AppResources.EnterNewpassword}"   />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>

                        </Label>
                        <Frame  Grid.Row="2"  Grid.Column="0"     HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="0,0,0,0" >
                        </Frame>
                        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5"  Grid.Row="2"  Grid.Column="0"  Grid.ColumnSpan="2"    >
                            <local1:GAZTBorderlessEntry Text="{Binding NewPassword}"   Style="{StaticResource GAZTTextBoxStyleForEntry}" Grid.Row="2"  IsPassword="{Binding NewPasswordVisibility}"   Margin="0" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" BackgroundColor="White" TextColor="Black" FontSize="10">
                            </local1:GAZTBorderlessEntry>
                        </StackLayout>

                        <Image Grid.Row="2"  Grid.Column="0"    Source="ic_TIN_Status.png" Aspect="AspectFit" HorizontalOptions="End" VerticalOptions="Center" Margin="10,0,10,0">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNewPasswordEyeClicked" />
                    </Image.GestureRecognizers>
                    </Image>

                        <Label Grid.Row="3" Grid.Column="0"    Margin="10,0,10,0" Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start" >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.EnterConfirmpassword}"   />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Frame  Grid.Row="4"  Grid.Column="0"    HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="0" >
                        </Frame>
                        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5"  Grid.Row="4"  Grid.Column="0"   >
                            <local1:GAZTBorderlessEntry Text="{Binding ConfirmPassword}" IsPassword="{Binding ConfirmPasswordVisibility}"  Style="{StaticResource GAZTTextBoxStyleForEntry}" Grid.Row="4"     Margin="0" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" BackgroundColor="White" TextColor="Black" FontSize="10">
                            </local1:GAZTBorderlessEntry>
                        </StackLayout>
                          <Image Grid.Row="4"  Grid.Column="0"    Source="ic_TIN_Status.png" Aspect="AspectFit" HorizontalOptions="End" VerticalOptions="Center" Margin="10,0,10,0">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnConfirmPasswordEyeClicked" />
                    </Image.GestureRecognizers>
                    </Image>
                        <Frame HorizontalOptions="FillAndExpand"  VerticalOptions="CenterAndExpand" Grid.Row="5" Grid.Column="0" HasShadow="false" CornerRadius="4" BackgroundColor="#005e4b" Margin="0,0,0,0">
                        </Frame>
                        <Label   Text="{x:Static local:AppResources.ChangePassword}" Style="{StaticResource SmallWhiteLabelStyle}"  Grid.Row="5" Grid.Column="0"  HorizontalTextAlignment="Center" VerticalOptions="CenterAndExpand" VerticalTextAlignment="Center" Margin="0,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnChangePasswordSubmitClicked}" />
                            </Label.GestureRecognizers>
                        </Label>

                    </Grid>
                </StackLayout>

                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical" Spacing="10" Padding="0"  IsVisible="{Binding OTPLayoutVisibility}" BackgroundColor="White" >
                    <Grid Grid.Row="0" Grid.Column="0" RowSpacing="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />

                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*" />
                            <ColumnDefinition Width="50*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0"  Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static local:AppResources.UserName}" Style="{StaticResource GAZTSmallGreenLabelStyle}" HorizontalOptions="Start" VerticalOptions="Center" BackgroundColor="White" Margin="0">
                        </Label>
                        <Frame Grid.Row="1"  Grid.Column="0" Grid.ColumnSpan="2"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="0">
                        </Frame>
                        <Label Grid.Row="1"  Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding IDNumber}" Style="{StaticResource ForgotPasswordTextColor}" HorizontalOptions="Start" VerticalOptions="Center" BackgroundColor="White" Margin="5">
                        </Label>

                        <Label Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static local:AppResources.MobileNumber}" Style="{StaticResource GAZTSmallGreenLabelStyle}" HorizontalOptions="Start" VerticalOptions="Center" BackgroundColor="White" Margin="0">
                        </Label>
                        <Frame Grid.Row="3"  Grid.Column="0" Grid.ColumnSpan="2"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="0">
                        </Frame>
                        <Label Grid.Row="3"  Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding MobileNumber}" Style="{StaticResource ForgotPasswordTextColor}" HorizontalOptions="Start" VerticalOptions="Center" BackgroundColor="White" Margin="5">
                        </Label>

                        <Label Grid.Row="4" Grid.Column="0"  Grid.ColumnSpan="2"  HorizontalOptions="Start" Margin="0" Style="{StaticResource GAZTSmallGreenLabelStyle}" >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span  Text="{x:Static local:AppResources.VarificationCode}"   />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Frame  Grid.Row="5"  Grid.Column="0"  Grid.ColumnSpan="2"    HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="0" >
                        </Frame>
                        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5"  Grid.Row="5"  Grid.Column="0"  Grid.ColumnSpan="2"    >
                            <local1:GAZTBorderlessEntry Text="{Binding EnteredOTP}" x:Name="EnteredOTP" TextChanged="OnOTPEntered" Keyboard="Numeric" Placeholder="{Binding VarificationCode}" Style="{StaticResource GAZTTextBoxStyleForEntry}" Grid.Row="5"     Margin="0" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" BackgroundColor="White" TextColor="Black" FontSize="10" IsEnabled="{Binding IsOTPEntryEnable}">
                            </local1:GAZTBorderlessEntry>
                        </StackLayout>

                        <Label Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static local:AppResources.TheaccountwillbelockedafterThreefailedverificationcodeattempts}" Margin="0" Style="{StaticResource InformationRedColorLabel}"  HorizontalOptions="Start" >
                        </Label>

                        <Label Grid.Row="7" Grid.Column="0"  Margin="0" HorizontalOptions="CenterAndExpand"  >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span  Text="{x:Static local:AppResources.TheAccountwillbelockedwithinTwomin}"  Style="{StaticResource InformationGrayColorLabel}"   />
                                    <Span  Text="{Binding OTPValidDuration}" Style="{StaticResource InformationRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Frame HorizontalOptions="FillAndExpand" IsEnabled="{Binding IsResendOTPEnabled}" VerticalOptions="CenterAndExpand" Grid.Row="7" Grid.Column="1"  HasShadow="false" CornerRadius="4" BackgroundColor="{Binding ButtonDisableColor}" Margin="5">
                        </Frame>
                        <Label   Text="{x:Static local:AppResources.ResendOTP}" IsEnabled="{Binding IsResendOTPEnabled}" Style="{StaticResource SmallWhiteLabelStyle}"  Grid.Row="7" Grid.Column="1" HorizontalTextAlignment="Center" VerticalOptions="CenterAndExpand" VerticalTextAlignment="Center" Margin="5">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnResendOTPClicked}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Frame HorizontalOptions="FillAndExpand"  VerticalOptions="FillAndExpand" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"  HasShadow="false" CornerRadius="4" BackgroundColor="#005e4b" Margin="5,0,5,0">
                        </Frame>
                        <Label   Text="{x:Static local:AppResources.Submit}" IsEnabled="{Binding IsResendButtonEnabled}" Style="{StaticResource SmallWhiteLabelStyle}"  Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"  HorizontalTextAlignment="Center" VerticalOptions="Center" VerticalTextAlignment="Center" Margin="5">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnValidateOTPClicked}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <!--<Label Text="{x:Static local:AppResources.VarificationCode}"></Label>
                <Entry Text="{Binding EnteredOTP}" HorizontalOptions="FillAndExpand"></Entry>
                <Label Text="{x:Static local:AppResources.ResendOTP}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnResendOTPClicked}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Button Text="{x:Static local:AppResources.Submit}" Command="{Binding OnValidateOTPClicked}" HorizontalOptions="FillAndExpand"></Button>-->


                    </Grid>



                </StackLayout>

                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical" Spacing="10" Padding="0,100,0,100"  IsVisible="{Binding NavigateToLoginLinkVisibility}" BackgroundColor="White" >
                    <Grid Grid.Row="0" Grid.Column="0" RowSpacing="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*" />
                        </Grid.ColumnDefinitions>
                        <StackLayout  local1:RoundCornersEffect.CornerRadius="10"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Padding="1"  BackgroundColor="#c49b2d" >

                            <StackLayout local1:RoundCornersEffect.CornerRadius="10" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"  BackgroundColor="White" Padding="1">
                                <Image Source="ic_check_circle_24px" HorizontalOptions="Center" Margin="0"></Image>
                                <Label   Text="{Binding ForgotPasswordUserNameChangedMessage}"  Style="{StaticResource ForgotPasswordTextColor}"    HorizontalTextAlignment="Center" VerticalTextAlignment="Start" Margin="0,0,0,0">
                                </Label>
                                <Label   Text="{x:Static local:AppResources.Clickhereforlogin}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" HorizontalOptions="FillAndExpand"   HorizontalTextAlignment="Center" VerticalTextAlignment="Start" Margin="0">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnLoginPageLinkClicked}"/>
                                    </Label.GestureRecognizers>
                                </Label>

                            </StackLayout>
                        </StackLayout>
                    </Grid>
                </StackLayout>



            </Grid>
            <!-- Acticity indicator layout start -->
            <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.7" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="0,0">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <ActivityIndicator IsVisible="true" IsRunning="true" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Color="White" />
                        <Label TextDecorations="Underline" Text="{x:Static local:AppResources.ActivityIndicatorTitle}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" />
                    </StackLayout>
                </StackLayout>
            </Grid>
            <!-- Acticity indicator layout end -->

        </Grid>
            </ScrollView>
    </ContentPage.Content>
</ContentPage>
