<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:GAZT"
             xmlns:custom="clr-namespace:GAZT"
             Title="{x:Static local:AppResources.ZDeclaration}"
             xmlns:local1="clr-namespace:GAZT"
             x:Class="GAZT.Views.NewViews.ICRListPageView">
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White">
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" x:Name="ParentGrid"  ColumnSpacing="10" RowSpacing="10" Margin="0" Padding="0,0,0,10" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*" />
                    <RowDefinition Height="90*" />

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="30*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="30*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="18*" />
                    <ColumnDefinition Width="14*" />




                </Grid.ColumnDefinitions>

                <Frame Grid.Row="0"  Margin="10,13,10,0" Padding="13" VerticalOptions="FillAndExpand" Grid.Column="0" Grid.ColumnSpan="7"  Style="{StaticResource GAZTFrameStyleForEntry}"   >

                </Frame>
                <custom:GAZTBorderlessPicker x:Name="BPicker" Margin="10,13,10,0" VerticalOptions="CenterAndExpand" Style="{StaticResource GAZTDropdownStyle}"  IsEnabled="true"   SelectedItem="{Binding SelectedICRStatus,Mode=TwoWay}" ItemsSource="{Binding ICRStatusList}" ItemDisplayBinding="{Binding Txt30}"  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="5"  ></custom:GAZTBorderlessPicker>

                <Image Grid.Row="0"  Grid.Column="6"  Margin="0,13,0,0"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Source="ic_dropdownOne.png" >
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="onDropdownButtonClicked" />
                    </Image.GestureRecognizers>
                </Image>

                <StackLayout Margin="10,0,10,0" BackgroundColor="White" IsVisible="{Binding IsICRListVisible}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Column="0" Grid.Row="1"  Grid.ColumnSpan="7">
                    <ListView  x:Name="ICRList" 
           ItemsSource="{Binding ICRList}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                              
                               BackgroundColor="White"
                 SelectedItem="{Binding SelectedICR}"     
            SeparatorVisibility="None"
            >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <ContentView>
                                        <StackLayout local1:RoundCornersEffect.CornerRadius="10" HorizontalOptions="Fill" VerticalOptions="FillAndExpand" Padding="0,0,0,10" Spacing="10"  BackgroundColor="White">

                                            <StackLayout local1:RoundCornersEffect.CornerRadius="10" HorizontalOptions="Fill" VerticalOptions="FillAndExpand" Padding="1" Spacing="10"  BackgroundColor="#BEC2C6">

                                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Margin="1,1,1,1" Padding="0,0,0,0" BackgroundColor="White" local1:RoundCornersEffect.CornerRadius="10">
                                                    <Grid Style="{DynamicResource GridStyle}" ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  >
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="35*" />
                                                            <ColumnDefinition Width="54*" />
                                                            <ColumnDefinition Width="3*" />
                                                            <ColumnDefinition Width="7*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Label Text="{x:Static local:AppResources.ZVATReturnForm}" Margin="8,0,8,-5" 
                                 
                                                       Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="Start"
                                                       VerticalOptions="CenterAndExpand"
                                                       TextColor="#005e4b"
                                   Grid.Row="0"
                                   Grid.Column="1"/>

                                                        <Label Text="{Binding Incotext}" 
                                                  
                                 Margin="8,0,8,-5"
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="1" Grid.ColumnSpan="4" />

                                                        <Label x:Name="Fbnumber" Text="{Binding FormBundleNumber}" 
                                                
                                 Margin="8,0,8,-5"
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                   Grid.Column="1" Grid.ColumnSpan="4" >
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label"
                                                                             Binding="{Binding FormBundleNumber}" Value="">
                                                                    <Setter Property="IsVisible" Value="False"></Setter>
                                                                   
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>

                                                        <Label 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                                          Margin="8,0,8,-5" 
                                   Grid.Row="3"
                                   Grid.Column="1" Grid.ColumnSpan="4">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static local:AppResources.ZTaxPeriod}"/>
                                                                    <!--<Span Text="      "/>-->
                                                                    <!--<Span Text="{Binding StatusTxt}" TextColor="{Binding BorderColour}"/>-->
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>

                                                        <Label Text="{Binding FormatTaxPeriod}" 
                                                  
                                  Margin="8,0,8,-5" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="4"
                                   Grid.Column="1" Grid.ColumnSpan="4"/>

                                                        <Label Text="Stauts" Margin="8,0,8,-5" 
                                 
                                                       Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="Start"
                                                       VerticalOptions="CenterAndExpand"
                                                       
                                   Grid.Row="5"
                                   Grid.Column="1"/>


                                                        <Label Text="{Binding StatusTxt}" 
                                                  TextColor="{Binding BorderColour}"
                                  Margin="8,0,8,-5"
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="6"
                                   Grid.Column="1" Grid.ColumnSpan="4" />


                                                     

                                                        <Label Text="{x:Static local:AppResources.ZReturnPeriod}" Margin="8,0,8,-5" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="7"
                                   Grid.Column="1"/>

                                                        <Label Text="{Binding FormatedDate}" 
                                                  
                                  Margin="8,0,8,-5"
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="8"
                                   Grid.Column="1" Grid.ColumnSpan="4" />

                                                        <Label Text="{x:Static local:AppResources.DueDate}" Margin="8,0,8,-5" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="9"
                                   Grid.Column="1"/>

                                                        <Label Text="{Binding FormatedSingleDueDate}" 
                                                  
                                 Margin="8,0,8,0" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="10"
                                   Grid.Column="1" Grid.ColumnSpan="4" />



                                                        <!--<StackLayout Grid.Row="1"  BackgroundColor="AliceBlue" Grid.Column="3" Grid.ColumnSpan="2" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.RowSpan="4" ></StackLayout>-->
                                                        <Image  Grid.Row="1"  Grid.Column="3" Grid.ColumnSpan="2" Grid.RowSpan="11"  Source="{Binding StatusImage}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                                                        <BoxView  
                     Grid.Row="0" Grid.Column="0" Grid.RowSpan="11" Margin="0,0,0,-2"  BackgroundColor="{Binding BorderColour}" VerticalOptions="Fill" HorizontalOptions="Fill" WidthRequest="2"/>


                                                        <BoxView  
                     Grid.Row="0" Grid.Column="3" Grid.RowSpan="11" Margin="0,0,0,-2" BackgroundColor="Gray" VerticalOptions="Fill" HorizontalOptions="Start" WidthRequest="1"/>


                                                    </Grid>
                                                </StackLayout>
                                            </StackLayout>

                                        </StackLayout>
                                    </ContentView>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackLayout>
                <!--<local1:CustomLabel Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" Text="{x:Static local:AppResources.Nodataavailable}" Style="{StaticResource MiniBlackLabelStyle}"  HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding SetNoDataLabelVisibility}">
                </local1:CustomLabel>-->
                <!--<BoxView Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="0.5" BackgroundColor="#d5d5d5" />
            <Image Grid.Row="5" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" Source="ic_home.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OnHomeIconClicked}" />
                </Image.GestureRecognizers>
            </Image>
            <Image Grid.Row="6" Grid.RowSpan="2" Grid.Column="1" Source="ic_question.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
            <Image Grid.Row="6" Grid.RowSpan="2" Grid.Column="5" Source="ic_user_2.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                 <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTaxPayerClicked" />
                </Image.GestureRecognizers>
            </Image>-->


                <local1:CustomLabel Text="{x:Static local:AppResources.Nodataavailable}" IsVisible="{Binding IsNoDataLabelVisible}" Grid.Column="0" Grid.Row="1"  Grid.ColumnSpan="7" Style="{StaticResource GAZTGrayLabelStyleForSmallFont}"  HorizontalOptions="Center" VerticalOptions="Center" >
                </local1:CustomLabel>
            </Grid>
            <!-- Acticity indicator layout start -->
            <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.7" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <ActivityIndicator IsVisible="true" IsRunning="true" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Color="White" />
                        <Label Text="{x:Static local:AppResources.ActivityIndicatorTitle}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" />
                    </StackLayout>
                </StackLayout>
            </Grid>
            <!-- Acticity indicator layout end -->
        </Grid>
    </ContentPage.Content>
</ContentPage>