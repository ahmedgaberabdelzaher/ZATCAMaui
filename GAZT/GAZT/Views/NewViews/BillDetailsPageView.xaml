             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:local="clr-namespace:GAZT;assembly:GAZT"
