<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
              xmlns:custom="clr-namespace:GAZT"
              xmlns:local="clr-namespace:GAZT;assembly:GAZT"
             x:Class="GAZT.Views.DashboardPageView"
             
          Title="{x:Static local:AppResources.Dashoboard}"
             >
    <ContentPage.ToolbarItems>
        <ToolbarItem Icon="ic_Dashboard_User.png" Order="Primary" Priority="0" Command="{Binding OnMyTaxPayerProfileClicked}">
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand"  ColumnSpacing="0" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="89*"/>
                <RowDefinition Height="11*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="35*"/>
                <ColumnDefinition Width="35*"/>
                <ColumnDefinition Width="30*" />
            </Grid.ColumnDefinitions>
            <ScrollView Orientation="Vertical"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid HorizontalOptions="FillAndExpand" ColumnSpacing="20" RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40*"/>
                        <ColumnDefinition Width="35*"/>
                        <ColumnDefinition Width="25*" />
                    </Grid.ColumnDefinitions>
                    <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" BackgroundColor="#c49b2d" >
                    </StackLayout>
                    <Label Text="{Binding StartDate}" VerticalTextAlignment="Center" HeightRequest="{Binding CalendarHeightRequest}" HorizontalOptions="StartAndExpand" Margin="5,1,0,1" FontSize="Small" FontFamily="{StaticResource SSTArBold}" BackgroundColor="#c49b2d" TextColor="#FFFFFF" VerticalOptions="Center" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    </Label>
                    <Label Text="{Binding EndDate}" VerticalTextAlignment="Center" HeightRequest="{Binding CalendarHeightRequest}" HorizontalOptions="StartAndExpand" Margin="5,1,0,1" FontSize="Small" FontFamily="{StaticResource SSTArBold}" BackgroundColor="#c49b2d" TextColor="#FFFFFF" VerticalOptions="Center" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
                    </Label>
                    <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" BackgroundColor="#F4FCFD"></StackLayout>
                    <Label Style="{StaticResource GAZTGreenLabelStyleForDashboardIcon}" HorizontalOptions="Start" BackgroundColor="#F4FCFD"   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"  Margin="5,5,5,1" TextDecorations="Underline" VerticalOptions="CenterAndExpand" >
                        <Label.FormattedText>
                            <FormattedString>
                                <Span  Text="{x:Static local:AppResources.Returns}"  />
                                <Span  Text=" (" TextDecorations="None"/>
                                <Span  Text="{x:Static local:AppResources.TotalNoofReturns}" TextDecorations="None"  />
                                <Span Text=":-" TextDecorations="None"/>
                                <Span Text="{Binding TotalNoOfReturns}" TextDecorations="None"/>
                                <Span Text=")" TextDecorations="None"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <CollectionView   ItemsSource="{Binding BillReturn}" x:Name="BillReturnCollectionView"  ItemsLayout="HorizontalList" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"   Margin="0"  BackgroundColor="#F4FCFD" HeightRequest="{Binding HeightRequestForCollectionView}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <StackLayout Padding="10,0,10,0"   Margin="0">
                                    <Grid Style="{DynamicResource GridStyle}"  ColumnSpacing="3" RowSpacing="0" VerticalOptions="Center" Padding="0,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100*" />
                                            <!--<ColumnDefinition Width="50*" />-->
                                        </Grid.ColumnDefinitions>
                                        <StackLayout Grid.Column="0" Grid.Row="0"  Orientation="Horizontal" HorizontalOptions="Center">
                                            <Image Source="{Binding ImagePath}" VerticalOptions="CenterAndExpand" HorizontalOptions="End"></Image>
                                            <Label Text="{Binding ReturnCount}" Margin="0"   Padding="0" HorizontalOptions="Start" FontFamily="{StaticResource SSTArBold}" VerticalOptions="CenterAndExpand" FontSize="Title" TextColor="#065E49" FontAttributes="Bold"/>
                                            
                                        </StackLayout>
                                        <!--<StackLayout Grid.Column="1" Grid.Row="0" >
                                            <Label Text="{Binding ReturnCount}" Margin="0"   Padding="0" HorizontalOptions="Start" FontFamily="{StaticResource SSTArBold}" VerticalOptions="CenterAndExpand" FontSize="Title" TextColor="#065E49" FontAttributes="Bold"/>
                                        </StackLayout>-->
                                        <StackLayout Grid.Row="1" Grid.Column="0" Margin="0,-6,0,0"  Padding="0"  VerticalOptions="End"  HorizontalOptions="CenterAndExpand">
                                            <Label Text="{Binding ReturnTypeName}"  Style="{StaticResource GAZTGreenLabelStyleForDashboardIcon}"/>
                                        </StackLayout>
                                    </Grid>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <BoxView BackgroundColor="#065E49" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" HeightRequest="1" ></BoxView>
                    <StackLayout Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" BackgroundColor="#FEF5EF"></StackLayout>
                    <Label Text="{x:Static local:AppResources.Bills}" Style="{StaticResource GAZTGreenLabelStyleForDashboardIcon}" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" BackgroundColor="#FEF5EF"  Margin="5,5,5,1" HorizontalOptions="Start"    TextDecorations="Underline" FontAttributes="Bold" >
                    </Label>
                    <CollectionView ItemsSource="{Binding BillPaid}" BackgroundColor="#FEF8F4" x:Name="BillPaidCollectionView" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" ItemsLayout="HorizontalList"  HeightRequest="{Binding HeightRequestForCollectionView}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <StackLayout Padding="10,0,10,0"  Margin="0">
                                    <Grid Style="{DynamicResource GridStyle}" ColumnSpacing="3" RowSpacing="0" HorizontalOptions="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100*" />
                                           
                                        </Grid.ColumnDefinitions>
                                        <StackLayout Grid.Column="0" Grid.Row="0" Orientation="Horizontal" HorizontalOptions="Center">
                                            <Image Source="{Binding ImagePath}" VerticalOptions="CenterAndExpand" HorizontalOptions="End"></Image>
                                            <Label Text="{Binding BillCount}" HorizontalOptions="Start" FontFamily="{StaticResource SSTArBold}" FontSize="Title" TextColor="#065E49" VerticalOptions="CenterAndExpand" FontAttributes="Bold"/>
                                        </StackLayout>
                                        <!--<StackLayout Grid.Column="1" Grid.Row="0" >
                                            <Label Text="{Binding BillCount}" HorizontalOptions="Start" FontFamily="{StaticResource SSTArBold}" FontSize="Title" TextColor="#065E49" VerticalOptions="CenterAndExpand" FontAttributes="Bold"/>
                                        </StackLayout>-->
                                        <StackLayout Grid.Row="1" Grid.Column="0" Margin="0,-6,0,0"  VerticalOptions="CenterAndExpand"  HorizontalOptions="CenterAndExpand">
                                            <Label Text="{Binding BillTypeName}" Margin="0,0,0,-7" Style="{StaticResource GAZTGreenLabelStyleForDashboardIcon}"/>
                                            <Label Margin="0"  Style="{StaticResource GAZTGreenLabelStyleForDashboardIcon}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="(SAR "></Span>
                                                        <Span Text="{Binding BillAmount}"/>
                                                        <Span Text=")"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                        </StackLayout>
                                    </Grid>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <BoxView BackgroundColor="#065E49" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" HeightRequest="1" Margin="0,0,0,0"></BoxView>
                    <StackLayout Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" BackgroundColor="White"></StackLayout>
                    <Label Text="{x:Static local:AppResources.EServices}" Style="{StaticResource GAZTGreenLabelStyleForDashboardIcon}" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" BackgroundColor="White"  Margin="5,5,5,1" HorizontalOptions="Start"    TextDecorations="Underline" FontAttributes="Bold" >
                    </Label>
                    <StackLayout Grid.Row="8" Grid.Column="0"  Grid.ColumnSpan="3"  Margin="0,10,0,0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="0" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="33*"/>
                                <ColumnDefinition Width="33*"/>
                                <ColumnDefinition Width="33*" />
                            </Grid.ColumnDefinitions>
                            <StackLayout Grid.Row="0" Grid.Column="0">
                                <Image Source="ic_Estimate_zakat.png" HeightRequest="80" WidthRequest="80"></Image>
                                <Label Text="{x:Static local:AppResources.EstimateZakat}"  Style="{StaticResource GAZTGreenLabelStyleForEservicesIcon}" Margin="0,0,0,5">
                                    
                                </Label>
                            </StackLayout>
                            <StackLayout Grid.Row="0" Grid.Column="1">
                                <Image Source="ic_certificate.png"  HeightRequest="80" WidthRequest="80">

                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnMyCertificateClicked}" />
                                    </Image.GestureRecognizers>

                                </Image>
                                <Label Text="{x:Static local:AppResources.MyCertificate}"  Style="{StaticResource GAZTGreenLabelStyleForEservicesIcon}" Margin="0,0,0,5">

                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnMyCertificateClicked}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </StackLayout>
                            <StackLayout Grid.Row="0" Grid.Column="2">
                                <Image Source="ic_Mybills.png"  HeightRequest="80" WidthRequest="80">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnMyBillsClicked}" />
                                    </Image.GestureRecognizers>
                                    
                                </Image>
                                <Label Text="{x:Static local:AppResources.MyBills}"  Style="{StaticResource GAZTGreenLabelStyleForEservicesIcon}" Margin="0,0,0,5">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnMyBillsClicked}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="0">
                                <Image Source="ic_vat_lookup_1.png" HeightRequest="80" WidthRequest="80"></Image>
                                <Label Text="{x:Static local:AppResources.VATLookup}"  Style="{StaticResource GAZTGreenLabelStyleForEservicesIcon}" Margin="0,0,0,5">
                                </Label>
                            </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="1">
                                <Image Source="ic_correspondance_1.png" HeightRequest="80" WidthRequest="80"></Image>
                                <Label Text="{x:Static local:AppResources.Correspondance}"  Style="{StaticResource GAZTGreenLabelStyleForEservicesIcon}" Margin="0,0,0,5">
                                </Label>
                            </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="2">
                                <Image Source="ic_vat_declaration_1.png" HeightRequest="80" WidthRequest="80"></Image>
                                <Label Text="{x:Static local:AppResources.VATDeclaration}"  Style="{StaticResource GAZTGreenLabelStyleForEservicesIcon}" Margin="0,0,0,5">
                                </Label>
                            </StackLayout>
                            <StackLayout Grid.Row="2" Grid.Column="0">
                                <Image Source="ic_vat_lookup_1.png" HeightRequest="80" WidthRequest="80"></Image>
                                <Label Text="{x:Static local:AppResources.VATLookup}"  Style="{StaticResource GAZTGreenLabelStyleForEservicesIcon}" Margin="0,0,0,5">
                                </Label>
                            </StackLayout>
                            <StackLayout Grid.Row="2" Grid.Column="1">
                                <Image Source="ic_correspondance_1.png" HeightRequest="80" WidthRequest="80"></Image>
                                <Label Text="{x:Static local:AppResources.Correspondance}"  Style="{StaticResource GAZTGreenLabelStyleForEservicesIcon}"  Margin="0,0,0,5">
                                </Label>
                            </StackLayout>
                            <StackLayout Grid.Row="2" Grid.Column="2">
                                <Image Source="ic_vat_declaration_1.png" HeightRequest="80" WidthRequest="80"></Image>
                                <Label Text="{x:Static local:AppResources.VATDeclaration}"  Style="{StaticResource GAZTGreenLabelStyleForEservicesIcon}" Margin="0,0,0,5">
                                </Label>
                            </StackLayout>
                        </Grid>
                    </StackLayout>
                </Grid>
            </ScrollView>
            <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" BackgroundColor="White">
            </StackLayout>
            <Grid Grid.Row="1" Grid.Column="1"  BackgroundColor="White" VerticalOptions="CenterAndExpand"  HorizontalOptions="CenterAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35*"/>
                    <ColumnDefinition Width="35*"/>
                    <ColumnDefinition Width="30*"/>
                </Grid.ColumnDefinitions>
                <Image Source="ic_chat.png" BackgroundColor="White" Grid.Row="0" Grid.Column="0" HorizontalOptions="Start"></Image>
                <Image Source="ic_social.png" BackgroundColor="White" Grid.Row="0" Grid.Column="1" HorizontalOptions="Start"></Image>
                <Image Source="ic_help.png" BackgroundColor="White" Grid.Row="0" Grid.Column="2" HorizontalOptions="Start"></Image>
            </Grid>
            <Image Source="ic_footer_img.png" BackgroundColor="White" Grid.Row="1" Grid.Column="2" HorizontalOptions="End"></Image>
        </Grid>
    </ContentPage.Content>
</ContentPage>