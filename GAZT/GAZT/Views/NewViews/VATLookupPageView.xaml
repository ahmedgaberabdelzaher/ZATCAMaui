<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="GAZT.Views.NewViews.VATLookupPageView"
             xmlns:local="clr-namespace:GAZT;assembly:GAZT"
             xmlns:custom="clr-namespace:GAZT"
             FlowDirection="RightToLeft"
             Title="{x:Static local:AppResources.VATLookup}"
             >
    <ContentPage.Content>
        <StackLayout>
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <ScrollView Orientation="Vertical" Grid.Row="0" Grid.Column="0"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                    <Grid Grid.Row="0" Grid.Column="0" RowSpacing="5" Padding="0" ColumnSpacing="5 " HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*" />
                            <ColumnDefinition Width="50*" />
                        </Grid.ColumnDefinitions>

                        <Label Text="{x:Static local:AppResources.ZSearchParameter}" Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>

                        <Frame  Grid.Row="1"   Grid.Column="0" Grid.ColumnSpan="2"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource GAZTFrameStyleForEntry}"  >
                        </Frame>
                        <StackLayout    Grid.Row="1"  Grid.Column="0" Grid.ColumnSpan="2"    HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5"  >
                            <custom:GAZTBorderlessPicker Style="{StaticResource PickerStyle}"    Grid.Row="1"      FontSize="10"   IsEnabled="true" TextColor="Black"    HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ItemsSource="{Binding ParameterTypeList}" SelectedItem="{Binding SelectedParameterType, Mode=TwoWay}" ItemDisplayBinding="{Binding ParameterType}">
                               
                            </custom:GAZTBorderlessPicker>
                        </StackLayout>
                        <!--<Image Source="ic_dropdownOne.png"  Margin="15,0,9,0" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"  HorizontalOptions="End" VerticalOptions="CenterAndExpand"/>-->





                        <Label Text="{x:Static local:AppResources.ZPleaseenterthecorrespondingnumber}" Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"/>
                        <Frame  Grid.Row="3"   Grid.Column="0" Grid.ColumnSpan="2"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource GAZTFrameStyleForEntry}"  IsVisible="{Binding IsIDTypeVisible}">
                        </Frame>
                        <custom:GAZTBorderlessEntry x:Name="entryNumber" Text="{Binding LookupNumber}"  Placeholder="{Binding VATACCOrCRNOOrVATCER}"  Style="{StaticResource GAZTTextBoxStyleForEntry}" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"></custom:GAZTBorderlessEntry>

                        <Frame Grid.Row="5"   Grid.Column="1"    HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource GAZTFrameStyleForEntry}" >
                        </Frame>
                        <Label  Text="{Binding Captcha}" Style="{StaticResource MiniGoldLabelStyle}" Grid.Row="5"   Grid.Column="1"    HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="White">

                        </Label>
                        <!--<StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="15,0,15,0"  Grid.Row="9"  Grid.Column="1"   >

                        <local1:GAZTBorderlessEntry Text="{Binding Captcha}" Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="9"   Grid.Column="1"   Margin="2,1,2,1" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" BackgroundColor="White">
                        </local1:GAZTBorderlessEntry>
                    </StackLayout>-->
                        <Image Grid.Row="5"  Grid.Column="1"   Source="ic_sync_captcha.png" Aspect="AspectFit" HorizontalOptions="End" VerticalOptions="Center" Margin="10,0,10,0">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnCaptchaRegenerateClicked}" />
                            </Image.GestureRecognizers>
                        </Image>

                        <Label Grid.Row="4"  Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start" >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.Captcha}" />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Frame  Grid.Row="5"  Grid.Column="0"     HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource GAZTFrameStyleForEntry}">
                        </Frame>

                        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5"  Grid.Row="5"  Grid.Column="0"   >

                            <custom:GAZTBorderlessEntry Text="{Binding EnteredCaptchaValue}" Placeholder="{x:Static local:AppResources.Captcha}" Style="{StaticResource GAZTTextBoxStyleForEntry}" Grid.Row="9"   Grid.Column="0"    HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" >
                                 <custom:GAZTBorderlessEntry.Behaviors>
                              <custom:CaptchaValidatorBehaviour/>
                            </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>
                        </StackLayout>
                        <Button Text="Search"  x:Name="btnSearch" Style="{StaticResource GAZTVerifyButton}" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" VerticalOptions="CenterAndExpand" Command="{Binding OnSubmitClicked}"></Button>


                        <Label Text="{Binding FinalResult}"  x:Name="lbResult" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"/>


                    </Grid>
                </ScrollView>
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>