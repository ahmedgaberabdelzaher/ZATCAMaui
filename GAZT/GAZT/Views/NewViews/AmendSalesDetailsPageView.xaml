<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
               xmlns:custom="clr-namespace:GAZT"
             xmlns:local="clr-namespace:GAZT;assembly:GAZT"
              xmlns:local1="clr-namespace:GAZT"
             x:Class="GAZT.Views.NewViews.AmendSalesDetailsPageView"
             Title="{x:Static local:AppResources.ZAmendSalesDetails}"
             FlowDirection="RightToLeft">
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="90*"/>
                    <RowDefinition Height="10*"/>

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>

                </Grid.ColumnDefinitions>
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <ScrollView Orientation="Vertical" Grid.Row="0" Grid.Column="0"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >

                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86*"/>
                                <ColumnDefinition Width="14*"/>
                            </Grid.ColumnDefinitions>


                            <Label x:Name="SalesType" Text="{Binding SalesType}" Grid.Row="0" IsEnabled="False"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Grid.Column="0"  Style="{StaticResource GAZTGoldLabelStyleForSmallFont}">
                               
                            </Label>

                            <Label Text="{x:Static local:AppResources.OldValue}" IsEnabled="False" Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" >
                            </Label>
                            <Frame Grid.Row="2" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                            </Frame>
                            <custom:GAZTBorderlessEntry  Grid.Row="2" Text="{Binding OldValue}" IsEnabled="False"   Grid.Column="0"   Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <custom:AlphaNumericValidatorBehaviour/>
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>



                            <Label Text="{x:Static local:AppResources.ZNewValue}"   Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" >
                            </Label>
                            <Frame Grid.Row="4" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                            </Frame>
                            <custom:GAZTBorderlessEntry x:Name="NewValue" Grid.Row="4" Text="{Binding NewValue}" Keyboard="Numeric"  Grid.Column="0"   Style="{StaticResource GAZTTextBoxStyleForEntry}">
                               
                            </custom:GAZTBorderlessEntry>
                            <!--<Image Grid.Row="1"  Grid.Column="1"  Margin="0,0,0,0" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_TIN_Status.png"  >
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPasswordVisibilityClickedForOldPassword" />
                        </Image.GestureRecognizers>
                    </Image>-->


                            <Label Text="{x:Static local:AppResources.ZChangeReason}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" >
                            </Label>
                            <Frame Grid.Row="6" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                            </Frame>
                            <custom:GAZTBorderlessEntry Text="{Binding ChangeReason}" Grid.Row="6"   Grid.Column="0"  Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <custom:AlphaNumericValidatorBehaviour/>
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>
                            <!--<Image Grid.Row="3"  Grid.Column="1"  Margin="0,0,0,0" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_TIN_Status.png"  >
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPasswordVisibilityClickedForNewPassword" />
                        </Image.GestureRecognizers>
                    </Image>-->




                            <Label Text="{x:Static local:AppResources.Attachments}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" >
                            </Label>
                            <Frame Grid.Row="12" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                            </Frame>
                            <custom:GAZTBorderlessEntry Text="{Binding AttachmentName}" Grid.Row="12"  Grid.Column="0"    Style="{StaticResource GAZTTextBoxStyleForEntry}">

                            </custom:GAZTBorderlessEntry>
                            <Image Grid.Row="12"  Grid.Column="1"  Margin="0,0,0,0" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_attachment.png">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OnAttachmentClick}" />
                                </Image.GestureRecognizers>
                            </Image>

                            <Label Text="{x:Static local:AppResources.ZNote}" Grid.Row="8"   HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Grid.Column="0"  Style="{StaticResource GAZTGoldLabelStyleForSmallFont}"/>

                            <Label Text="{x:Static local:AppResources.ZFilesizeshouldnotbemorethan5MB}"  Grid.Row="9" Grid.Column="0"  Grid.ColumnSpan="2"  HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>

                            <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="10" Grid.Column="0"  Grid.ColumnSpan="2">
                                <local:CustomLabel Text="{x:Static local:AppResources.ZZChooseonlyfilewithextensionForZAKAT}" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>
                            </StackLayout>

                            <Label Text="{x:Static local:AppResources.ZMaximumnoof5attachmentscanbeuploaded}"  Grid.Row="11" Grid.Column="0"  Grid.ColumnSpan="2"  HorizontalOptions="StartAndExpand" VerticalOptions="Start"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>


                            <!--<Label Grid.Row="7"  Grid.Column="0" Grid.ColumnSpan="2"   HorizontalOptions="Start" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" >
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static local:AppResources.ZNote}"  Style="{StaticResource GAZTGoldLabelStyleForSmallFont}"/>
                                        <Span Text="{x:Static x:Environment.NewLine}" />
                                        <Span  Text="{x:Static local:AppResources.ZFilesizeshouldnotbemorethan5MB}" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" />
                                        <Span Text="{x:Static x:Environment.NewLine}" />
                                        <Span  Text="{x:Static local:AppResources.ZChooseonlyfilewithextension}" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" />
                                        <Span Text="{x:Static x:Environment.NewLine}" />
                                        <Span  Text="{x:Static local:AppResources.ZMaximumnoof5attachmentscanbeuploaded}" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>-->



                            <!--<StackLayout HorizontalOptions="FillAndExpand" IsVisible="True" VerticalOptions="FillAndExpand" Grid.Row="8"  Margin="0,0,0,0" Grid.Column="0" Grid.ColumnSpan="2" >
                                <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  >
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86*"/>
                                            <ColumnDefinition Width="14*"/>
                                        </Grid.ColumnDefinitions>-->






                            <StackLayout Grid.Row="13"  Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,0,10,0"  HorizontalOptions="FillAndExpand" VerticalOptions="Fill"  >
                                <ListView  x:Name="Attachmentlist" 
           ItemsSource="{Binding ZakatReturnAttachmentsList}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                      ItemTapped="Attachmentlist_ItemTapped"
            SeparatorVisibility="None"
            >
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <ContentView>
                                                    <StackLayout local1:RoundCornersEffect.CornerRadius="10" HorizontalOptions="Fill" VerticalOptions="FillAndExpand" Padding="0,0,0,10" Spacing="10"  BackgroundColor="White" HeightRequest="50">

                                                        <StackLayout local1:RoundCornersEffect.CornerRadius="10" HorizontalOptions="Fill" VerticalOptions="FillAndExpand" Padding="1" Spacing="10"  BackgroundColor="#BEC2C6">

                                                            <StackLayout local1:RoundCornersEffect.CornerRadius="10" HorizontalOptions="Fill" VerticalOptions="FillAndExpand" Padding="1" Spacing="10"  BackgroundColor="White">

                                                                <Grid Style="{DynamicResource GridStyle}" ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" BackgroundColor="White" Margin="0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="8*" />
                                                                        <ColumnDefinition Width="52*" />
                                                                        <ColumnDefinition Width="10*" />
                                                                        <ColumnDefinition Width="15*" />
                                                                        <ColumnDefinition Width="15*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />

                                                                    </Grid.RowDefinitions>



                                                                    <Label Text="{Binding aa}" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0" 
                                   />

                                                                    <Label Text="{Binding Filename}" 
                                                                       Margin="3,0,3,0"
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                                                           LineBreakMode="CharacterWrap"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                                           Grid.ColumnSpan="4"
                                   />

                                                                    <!--<Label  
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="2" 
                                   >
                                                                        <Label.FormattedText>
                                                                            <FormattedString>
                                                                                <Span Text="{Binding Size}"/>
                                                                                <Span Text="MB"/>
                                                                            </FormattedString>
                                                                        </Label.FormattedText>
                                                                    </Label>-->

                                                                    <!--<Image Grid.Row="0"  Grid.Column="3"   HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_file_download.png"  >

                                                                    </Image>-->

                                                                    <Image Grid.Row="0"  Grid.Column="4" Aspect="AspectFit"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Source="ic_delete.png"  >
                                                                        <Image.GestureRecognizers>
                                                                            <TapGestureRecognizer
                Tapped="OnDeleteAttachmentClickedTapped"
                NumberOfTapsRequired="1" />
                                                                        </Image.GestureRecognizers>
                                                                    </Image>
                                                                </Grid>
                                                            </StackLayout>
                                                        </StackLayout>
                                                    </StackLayout>
                                                </ContentView>
                                            </ViewCell>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackLayout>
                        </Grid>
                    </ScrollView>
                </Grid>

                <Button Text="{x:Static local:AppResources.Save}" Command="{Binding OnZakatReturnDataUpdateClicked}" Grid.Row="1" Grid.Column="0"  Style="{StaticResource GAZTVerifyButton}"></Button>

            </Grid>
            <!-- Acticity indicator layout start -->

            <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.7" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <ActivityIndicator IsVisible="true" IsRunning="true" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Color="White" />
                        <Label Text="{x:Static local:AppResources.ActivityIndicatorTitle}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" />
                    </StackLayout>
                </StackLayout>
            </Grid>
            <!-- Acticity indicator layout end -->
        </Grid>
    </ContentPage.Content>
</ContentPage>