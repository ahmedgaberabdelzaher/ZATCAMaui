                                                    <Label Text="{Binding Idnumber}"  Padding="0" Grid.Row="0" Grid.Column="1"   HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>
                                                    <Label Text="{Binding StatusText}" Padding="0" Grid.Row="1" Grid.Column="1"   HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>
                                                    <Label Text="{Binding Actnm}"   Grid.Row="2" Padding="0" Grid.Column="1"   HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>-->
                        
                        
                        
                        
                                                    <!--<BoxView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" HeightRequest="0.5" BackgroundColor="#7D858D" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"/>-->
                                                <!--</Grid>
                                            </Grid>
                                                        </StackLayout>
                                                    </StackLayout>
                                                  </StackLayout>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>-->
                    </Grid>
            
                </ScrollView>
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>