                                       ItemTapped="ListTINStatus_ItemTapped"
                             IsVisible="{Binding IsVisibleListItems}"    
                      Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2"
            SeparatorVisibility="None"
                                       BackgroundColor="White"
            >
                                <ListView.ItemTemplate>
                                    <DataTemplate>
