                                                <StackLayout local:RoundCornersEffect.CornerRadius="10" HorizontalOptions="Fill" VerticalOptions="FillAndExpand" Padding="1" Spacing="10"  BackgroundColor="#BEC2C6">

                                                    <StackLayout local:RoundCornersEffect.CornerRadius="10" HorizontalOptions="Fill" VerticalOptions="FillAndExpand" Padding="1" Spacing="10"  BackgroundColor="White">


                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0,5,0,5">
