                    <Label Grid.Row="2" Grid.Column="1" Text="Q1234567" Style="{StaticResource GAZTMicroMediumBlackLabelForHorizontalEnd}"/>

                    <Label Grid.Row="3" Grid.Column="0" Text="Taxpayer Name" Style="{StaticResource GAZTMicroMediumGrayLabelForHorizontalStart}"/>
                    <Label Grid.Row="3" Grid.Column="1" Text="Zaed" Style="{StaticResource GAZTMicroMediumBlackLabelForHorizontalEnd}"/>

                    <Label Grid.Row="4" Grid.Column="0" Text="Address" Style="{StaticResource GAZTMicroMediumGrayLabelForHorizontalStart}"/>
                    <Label Grid.Row="4" Grid.Column="1" Text="Olya Street,Al Wurud,Riyadh 12253" Style="{StaticResource GAZTMicroMediumBlackLabelForHorizontalEnd}"/>
                </Grid>
            </StackLayout>
