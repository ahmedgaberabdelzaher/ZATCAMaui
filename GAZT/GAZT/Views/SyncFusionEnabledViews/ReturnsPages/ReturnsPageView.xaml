                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="StartAndExpand"
                                                       Grid.Row="2"
                                                       Grid.Column="0"
                                                       >
                                                                                    <Label.Triggers>
                                                                                        <DataTrigger TargetType="Label"
                                                                             Binding="{Binding FormBundleNumber}" Value="">
                                                                                            <Setter Property="IsVisible" Value="False"></Setter>

                                                                                        </DataTrigger>
                                                                                    </Label.Triggers>
                                                                                </Label>


