                                                                                    <Label.FormattedText>
                                                                                        <FormattedString>
                                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.ZTaxPeriod}"></Span>
                                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding FormatTaxPeriod}"></Span>
                                                                                        </FormattedString>
                                                                                    </Label.FormattedText>
                                                                                </Label>





