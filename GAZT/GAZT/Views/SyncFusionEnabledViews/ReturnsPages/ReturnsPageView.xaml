                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="6"
                                   Grid.Column="1" Grid.ColumnSpan="4" />




                                                                            <Label Text="{x:Static local:AppResources.ZReturnPeriod}" Margin="8,0,8,0" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="7"
                                   Grid.Column="1"/>

                                                                            <Label Text="{Binding FormatedDate}" 
                                                  
