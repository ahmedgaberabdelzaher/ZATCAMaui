<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:custom2="clr-namespace:EGAZT"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms" xmlns:custom1="clr-namespace:GAZT.CustomControl" xmlns:local="clr-namespace:EGAZT.CustomControl"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.UnlockAccount.UnlockAccountTINPageView"
                CloseWhenBackgroundIsClicked="False" >
    <ContentPage.Resources>
        <ResourceDictionary>
           <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10"/>
                <Setter Property="WidthRequest" Value="10"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
       <yummy:PancakeView x:Name="mainContentView" BackgroundColor="Transparent" VerticalOptions="FillAndExpand"  CornerRadius="22,22,0,0" HasShadow="False">
        <StackLayout>
                <ScrollView VerticalOptions="FillAndExpand" IsVisible="{Binding IsTinContentViewVisible}" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
                  <StackLayout Padding="0,0,0,0" BackgroundColor="Transparent" Margin="0,0,0,0" VerticalOptions="FillAndExpand" IsVisible="{Binding IsTinContentViewVisible}">
                   <yummy:PancakeView VerticalOptions="EndAndExpand" BackgroundColor="White" CornerRadius="22,22,0,0" HasShadow="False">
                       <StackLayout Margin="15,10,15,0" VerticalOptions="EndAndExpand" BackgroundColor="Transparent">
                        <Grid VerticalOptions="EndAndExpand" BackgroundColor="Transparent" IsVisible="{Binding IsTinContentViewVisible}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35*"/>
                            <ColumnDefinition Width="30*"/>
                            <ColumnDefinition Width="35*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" IsVisible="true" Margin="0" Rotation="270" Style="{StaticResource IconLabelStyle}" Text="{DynamicResource Back}"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer  Tapped="TappedOnTinContentBackButton"></TapGestureRecognizer>
                                </Label.GestureRecognizers>
                        </Label>

                        <Image Source="ic_logo_gazt.png" Grid.Row="0" Grid.Column="1" WidthRequest="40" HeightRequest="40" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"/>

                        <custom:CustomLabel Margin="0,25,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" BackgroundColor="Transparent"
                                            Text="{x:Static ResourceManager:AppResources.UnlockAccountResetPassword}" Style="{StaticResource SectionTitleBlack}" />
                        <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDSelectTheOptionAndCompleteDetails}" Style="{StaticResource BodyLabelGrey}"/>-->

                        <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,0">
                                                            <!--<Label Text="{x:Static custom2:AppResources.ZZZVATRFirstName}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Padding="0,0,0,0"/>-->
                                                            <custom:CustomLabel Margin="0,20,0,0" Grid.Row="0"  Style="{StaticResource CaptionLabelGrey}">
                                                                <custom:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                        <Span  Text="{x:Static custom2:AppResources.TIN}" />
                                                                    </FormattedString>
                                                                </custom:CustomLabel.FormattedText>
                                                            </custom:CustomLabel>
                                                         <inputLayout:SfTextInputLayout x:Name="FrmTIN"  LeadingViewPosition="Inside" TrailingViewPosition="Inside"  Margin="0,-6,0,-6"
                                                            HorizontalOptions="FillAndExpand" HasError="False" 
                                                                ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020">
                                                            <custom:BorderlessEntry x:Name="EntryTIN" Text="{Binding TxtTIN}" MaxLength="10" Placeholder="{x:Static custom2:AppResources.TIN}" FontSize="Small" TextColor="{StaticResource PrimaryColor}"
                                                                                    PlaceholderColor="Gray" Keyboard="Numeric" IsSpellCheckEnabled="False" TextChanged="EntryTINNumber_TextChanged"  Unfocused="FrmTIN_Unfocused"
                                                                                    Focused="FrmTIN_Focused">
                                                                 <Entry.Behaviors>
                                                                    <custom1:OnlyNumericValuesBehaviour/>
                                                                </Entry.Behaviors>

                                                            </custom:BorderlessEntry>
                                                        </inputLayout:SfTextInputLayout>
                                                            <!--<inputLayout:SfTextInputLayout  Margin="0,10,0,10" 
                                        ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                        OutlineCornerRadius="12" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020" HasError="False" >
                                                                <custom:BorderlessEntry  BackgroundColor="Green"  
                                                                                         Style="{StaticResource GAZTEntry}"  TextColor="#bbbbbb"
                                                                  >
                                                                
                                                                </custom:BorderlessEntry>
                                                            </inputLayout:SfTextInputLayout>-->
                                                        </StackLayout>
                    </Grid>
                
                    <buttons:SfButton x:Name="btnVerify" Text="{x:Static custom2:AppResources.UnlockAccountVerify}" Clicked="btnVerify_Clicked"  CornerRadius="10" VerticalOptions="End"
                                      FontAttributes="Bold" HeightRequest="48" Margin="0,60,0,60" FontSize="15" TextColor="{DynamicResource Gray-White}" FontFamily="{StaticResource SomarSemiBold}" 
                    BackgroundColor="{StaticResource Secondary}" BorderWidth="0"/>
                   </StackLayout>
                   </yummy:PancakeView>
                </StackLayout>
                </ScrollView>
                <ScrollView VerticalOptions="FillAndExpand" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never" IsVisible="{Binding IsOTPContentViewVisible}">
                    <StackLayout Padding="0,0,0,0" BackgroundColor="Transparent" Margin="0,0,0,0" VerticalOptions="FillAndExpand" IsVisible="{Binding IsOTPContentViewVisible}">
                    <yummy:PancakeView VerticalOptions="EndAndExpand" BackgroundColor="White" CornerRadius="22,22,0,0" HasShadow="False">
                    <StackLayout Padding="0,0,0,0" Margin="15,10,15,0" VerticalOptions="End" IsVisible="{Binding IsOTPContentViewVisible}">
                    <Grid HorizontalOptions="CenterAndExpand" VerticalOptions="End" IsVisible="{Binding IsOTPContentViewVisible}" ColumnSpacing="0" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35*"/>
                            <ColumnDefinition Width="30*"/>
                            <ColumnDefinition Width="35*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" IsVisible="true" Margin="0"   Rotation="270" Style="{StaticResource IconLabelStyle}" Text="{DynamicResource Back}"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer  Tapped="TappedOnTinContentBackButton"></TapGestureRecognizer>
                                </Label.GestureRecognizers>
                        </Label>

                        <Image Source="ic_logo_gazt.png" Grid.Row="0" Grid.Column="1" WidthRequest="40" HeightRequest="40" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"/>

                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VerificationCode}" Style="{StaticResource SectionTitleBlack}" Margin="0,25,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"  />
                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.EnterVerificationCodeSentToMobile}" Style="{StaticResource BodyLabelGrey}"
                                            Margin="0" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"/>

                        <BoxView Style="{StaticResource lineSeperator}" Margin="0,10,0,25" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"/>
                        <StackLayout Orientation="Horizontal" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4" HorizontalOptions="Center">
                               <Label Text="{x:Static ResourceManager:AppResources.MobileNumber}" Margin="0" HorizontalOptions="CenterAndExpand" Style="{StaticResource GAZTDarkGrayLabelStyle}"/>
                               <Label Text="{Binding MobileNumberMasked}" Margin="0" HorizontalOptions="CenterAndExpand" FlowDirection="LeftToRight" Style="{StaticResource GAZTDarkGrayLabelStyle}" />
                        </StackLayout>

                        <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" HorizontalOptions="CenterAndExpand" RowSpacing="0" ColumnSpacing="20" 
                                    VerticalOptions="CenterAndExpand" Margin="20" x:Name="OtpEntryGrid" FlowDirection="LeftToRight">
                         <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                                <inputLayout:SfTextInputLayout  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1"
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="12" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020" HasError="False" >
                                    <custom:BorderlessEntry WidthRequest="8" HorizontalTextAlignment="Center" IsEnabled="{Binding IsOTPEntryEnable}" x:Name="OtpFirstEntry" MaxLength="1" ReturnType="Next" Keyboard="Numeric"
                                                            FontAttributes="Bold" 
                                                            FontSize="Small" TextChanged="OtpFirstEntry_TextChanged"
                                                    HorizontalOptions="Center" Text="{Binding OtpFirstDigit}"  IsPassword="True" Style="{StaticResource GAZTOTPEntry}"  TextColor="#bbbbbb" >
                                                    <custom:BorderlessEntry.Behaviors>
                                                        <local:EntryFocusBehaviour NextFocusElementName="OtpSecondEntry"/>
                                                        </custom:BorderlessEntry.Behaviors>
                                </custom:BorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                                
                        <inputLayout:SfTextInputLayout Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1"
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1" 
                                    OutlineCornerRadius="12" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020" HasError="False" >
                                <custom:BorderlessEntry WidthRequest="8" HorizontalTextAlignment="Center" x:Name="OtpSecondEntry" IsEnabled="{Binding IsOTPEntryEnable}" Keyboard="Numeric" MaxLength="1" ReturnType="Next" FontAttributes="Bold"
                                                        FontSize="Small" TextChanged="OtpSecondEntry_TextChanged"
                                                        HorizontalOptions="Center" Text="{Binding OtpSecondDigit}" IsPassword="True" Style="{StaticResource GAZTOTPEntry}"
                                                        TextColor="#bbbbbb">
                                    <custom:BorderlessEntry.Behaviors>
                                                        <local:EntryFocusBehaviour NextFocusElementName="OtpThirdEntry"/>
                                                        </custom:BorderlessEntry.Behaviors>
                                    </custom:BorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                                
                        <inputLayout:SfTextInputLayout Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="1"
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1" 
                                    OutlineCornerRadius="12" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020" HasError="False" >
                                <custom:BorderlessEntry WidthRequest="8" HorizontalTextAlignment="Center" x:Name="OtpThirdEntry" IsEnabled="{Binding IsOTPEntryEnable}"   MaxLength="1" ReturnType="Next" FontAttributes="Bold" FontSize="Small" TextChanged="OtpThirdEntry_TextChanged"
                                                        Keyboard="Numeric"  Text="{Binding OtpThirdDigit}" HorizontalOptions="Center" IsPassword="True" Style="{StaticResource GAZTOTPEntry}"  TextColor="#bbbbbb">
                                    <custom:BorderlessEntry.Behaviors>
                                                        <local:EntryFocusBehaviour NextFocusElementName="OtpFourthEntry"/>
                                                        </custom:BorderlessEntry.Behaviors>
                                    </custom:BorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                                
                        <inputLayout:SfTextInputLayout  Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="1"
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1" x:Name="OtpFourthEntry"
                                    OutlineCornerRadius="12" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020" HasError="False">
                            <custom:BorderlessEntry WidthRequest="8" HorizontalTextAlignment="Center" x:Name="OtpGAZTDarkGrayLabelStyleFourthEntry" IsEnabled="{Binding IsOTPEntryEnable}"   MaxLength="1" FontAttributes="Bold"
                                                    FontSize="Small"  Text="{Binding OtpFourthDigit}" TextChanged="OtpGAZTDarkGrayLabelStyleFourthEntry_TextChanged" 
                                                    Keyboard="Numeric" IsPassword="True" HorizontalOptions="Center" Style="{StaticResource GAZTOTPEntry}"  TextColor="#bbbbbb">
                                </custom:BorderlessEntry> 
                        </inputLayout:SfTextInputLayout>
                       
                        </Grid>  
                        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" VerticalOptions="Center"  Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                                     Margin="0,-10,0,0" Spacing="0">

                            <Image  HorizontalOptions="CenterAndExpand" VerticalOptions="End" Source="unlockaccount_clock.png" HeightRequest="24" WidthRequest="24" Aspect="AspectFit"/>
                            <Label  Text ="{Binding OTPValidDuration}" Margin="10,0,10,0" Padding="0"
                                    Style="{StaticResource GAZTDarkGrayLabelStyle}" LineHeight="1"/>

                        </StackLayout>
                        <!--<StackLayout Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3">
                            
                        </StackLayout>-->
                    </Grid>
                     <buttons:SfButton IsVisible="false"  x:Name="btnResendVerificationCode" Text="{x:Static custom2:AppResources.ResendVerificationCode}"
                                          Command="{Binding OnResendOTPClicked}" CornerRadius="10" Margin="0,60,0,0"
                                              VerticalOptions="End" FontAttributes="Bold" IsEnabled="{Binding IsResendOTPEnabled}"
                            HeightRequest="48" FontSize="15" TextColor="{DynamicResource Gray-White}" FontFamily="{StaticResource SomarSemiBold}" 
                            BackgroundColor="{Binding ButtonDisableColor}" BorderWidth="0"/>

                     <buttons:SfButton  Command="{Binding OnResendOTPClicked}" IsEnabled="{Binding IsResendOTPEnabled}" Text="{x:Static ResourceManager:AppResources.ResendVerificationCode}"
                                        VerticalOptions="EndAndExpand" Margin="0,50,0,50" BackgroundColor="Transparent" TextColor="{Binding ButtonDisableColor}"/>

                    <buttons:SfButton IsVisible="false"  x:Name="btnConfirmOtp" Text="{x:Static custom2:AppResources.UnlockAccountVerify}" Command="{Binding ConfirmOtpBtnClicked}"  CornerRadius="10"
                                        VerticalOptions="End" FontAttributes="Bold" IsEnabled="{Binding IsVerifyOTPEnabled}" 
                    HeightRequest="48" Margin="0,30,0,60" FontSize="15" TextColor="{DynamicResource Gray-White}" FontFamily="{StaticResource SomarSemiBold}" 
                    BackgroundColor="{Binding VerifyButtonDisableColor}" BorderWidth="0"/>
                </StackLayout >

                        </yummy:PancakeView>
                    </StackLayout>

                </ScrollView>
                <ScrollView VerticalOptions="FillAndExpand" IsVisible="{Binding IsChangePasswordViewVisible}" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
                  <StackLayout Padding="0,0,0,0" BackgroundColor="Transparent" Margin="0,0,0,0" VerticalOptions="FillAndExpand" IsVisible="{Binding IsChangePasswordViewVisible}">
                   <yummy:PancakeView VerticalOptions="EndAndExpand" BackgroundColor="White" CornerRadius="22,22,0,0" HasShadow="False">
                                       <StackLayout x:Name="ChangePasswordView" Padding="0,0,0,0" Margin="15,10,15,0" IsVisible="{Binding IsChangePasswordViewVisible}">
                    <Grid HorizontalOptions="CenterAndExpand" IsVisible="{Binding IsChangePasswordViewVisible}" ColumnSpacing="0" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35*"/>
                            <ColumnDefinition Width="30*"/>
                            <ColumnDefinition Width="35*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" IsVisible="true" Margin="0"   Rotation="270" Style="{StaticResource IconLabelStyle}" Text="{DynamicResource Back}"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer  Tapped="TappedOnTinContentBackButton"></TapGestureRecognizer>
                                </Label.GestureRecognizers>
                        </Label>

                        <Image Source="ic_logo_gazt.png" Grid.Row="0" Grid.Column="1" WidthRequest="40" HeightRequest="40" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"/>

                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.UnlockAccountResetPassword}" Style="{StaticResource SectionTitleBlack}" Margin="0,25,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"  />
                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.UnlockAccountCreateNewPassword}" Style="{StaticResource BodyLabelGrey}"
                                            Margin="0" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"/>

                        <BoxView Style="{StaticResource lineSeperator}" Margin="0,10,0,25" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"/>

                        <StackLayout Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                                            <!--<Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{x:Static local:AppResources.NewPassword}"  Padding="0,0,0,0"/>-->

                                           <custom:CustomLabel   Text="{x:Static ResourceManager:AppResources.NDNewPassword}"   Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                           <inputLayout:SfTextInputLayout HasError="{Binding FramePasswordError}"  LeadingViewPosition="Inside" TrailingViewPosition="Inside"  Margin="0,-6,0,-6"
                                                            HorizontalOptions="FillAndExpand"
                                                                ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020">
                                                            <custom:BorderlessEntry Text="{Binding Password}" IsPassword="{Binding IsPasswordEncripted}"
                                                                                    FontSize="Small" TextColor="{StaticResource PrimaryColor}"
                                                                                    PlaceholderColor="Gray" Keyboard="Default" IsSpellCheckEnabled="False" MaxLength="16"
                                                                                    Placeholder="{x:Static custom2:AppResources.NDNewPassword}" TextChanged="NewPassword_TextChanged" >
                                                                 
                                                            </custom:BorderlessEntry>
                                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                                <Image HorizontalOptions="Center" x:Name="ImageSeePassword">
                                                                    <Image.Source>
                                                    <FontImageSource FontFamily="UserIconFont"
                                                                     Color="{StaticResource SecondaryNew}" Size="25"
                                                                                 Glyph="{x:Static FontImage:IconFonts.Eye}"/>
                                                                    </Image.Source>
                                                                    <Image.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="ImageSeePassword_Tapped"/>
                                                                    </Image.GestureRecognizers>
                                                                </Image>
                                                            </inputLayout:SfTextInputLayout.TrailingView>

                                            </inputLayout:SfTextInputLayout>
                          </StackLayout>

                        <StackLayout Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3">
                            <!--<Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{x:Static local:AppResources.ZZZZRepeatPassword}"  Padding="0,0,0,0"/>-->
                            <custom:CustomLabel   Text="{x:Static ResourceManager:AppResources.ZZZZRepeatPassword}"   Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                            <inputLayout:SfTextInputLayout HasError="{Binding FrameConfirmPasswordError}"  LeadingViewPosition="Inside" TrailingViewPosition="Inside"  Margin="0,-6,0,-6"
                                                            HorizontalOptions="FillAndExpand"
                                                                ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020">
                                                            <custom:BorderlessEntry x:Name="EntryConfirmPassword" Text="{Binding ConfirmPassword}" IsPassword="{Binding IsConfirmPasswordEncripted}"
                                                                                    FontSize="Small" TextColor="{StaticResource PrimaryColor}" TextChanged="EntryConfirmPassword_TextChanged"
                                                                                    PlaceholderColor="Gray" Keyboard="Default" IsSpellCheckEnabled="False" MaxLength="16"
                                                                                    Placeholder="{x:Static custom2:AppResources.ZZZZRepeatPassword}">
                                                                 
                                                            </custom:BorderlessEntry>
                                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                                <Image HorizontalOptions="Center" x:Name="ImageSeeConfirmPassword">
                                                                    <Image.Source>
                                                    <FontImageSource FontFamily="UserIconFont"
                                                                     Color="{StaticResource SecondaryNew}" Size="25"
                                                                                 Glyph="{x:Static FontImage:IconFonts.Eye}"/>
                                                                    </Image.Source>
                                                                    <Image.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="ImageSeeConfirmPassword_Tapped"/>
                                                                    </Image.GestureRecognizers>
                                                                </Image>
                                                            </inputLayout:SfTextInputLayout.TrailingView>

                            </inputLayout:SfTextInputLayout>
                        </StackLayout>
                        <StackLayout x:Name="PasswordChecks" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
                                    <StackLayout Orientation="Horizontal">
                                        <Image Source="{Binding MinEight}">

                                        </Image>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDAtleast8character}" Style="{StaticResource CaptionLabelBlack}" Padding="5,0,0,0"/>
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal">
                                        <Image Source="{Binding CapsSmall}">

                                        </Image>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDEnglishcapitalandsmallletters}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal">
                                        <Image Source="{Binding MaxSixteen}">

                                        </Image>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZZNotexceed16characters}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal">
                                        <Image Source="{Binding NumSymbol}">

                                        </Image>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDNumbersAndSymbols}" Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" Padding="5,0,0,0"/>
                                    </StackLayout>
                                </StackLayout>
                    </Grid>
                
                    <buttons:SfButton x:Name="btnConfirmNewPassword" Text="{x:Static custom2:AppResources.Submit}" Command="{Binding ConfirmPasswordBtnClicked}"  CornerRadius="10"
                                      VerticalOptions="End" FontAttributes="Bold" 
                    HeightRequest="48" Margin="0,16,0,60" FontSize="15" TextColor="{DynamicResource Gray-White}" FontFamily="{StaticResource SomarSemiBold}" 
                    BackgroundColor="{StaticResource Secondary}" BorderWidth="0"/>
                </StackLayout>

                   </yummy:PancakeView>
                </StackLayout>
                </ScrollView>
                
                <StackLayout IsVisible="{Binding IsAccountUnlockedSuccessViewVisible}" Margin="-10" >
                    <Grid HorizontalOptions="CenterAndExpand" IsVisible="{Binding IsAccountUnlockedSuccessViewVisible}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35*"/>
                            <ColumnDefinition Width="30*"/>
                            <ColumnDefinition Width="35*"/>
                        </Grid.ColumnDefinitions>


                    <Image Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Source="partials_background" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>

                    <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"  Padding="40" VerticalOptions="CenterAndExpand">
                        <Image Source="vat_ic_success.png"   Aspect="AspectFit"/>
                        <Label Text="{x:Static custom2:AppResources.AccountUnlocked}" FontFamily="{StaticResource SomarBold}"  FontSize="Large" TextColor="White" HorizontalTextAlignment="Center"/>
                        <Label Text="{Binding PasswordChangedSuccessfully}"  FontFamily="{StaticResource SomarSemiBold}"
                               TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" HorizontalOptions="Center" VerticalOptions="End" Margin="30,60,30,80" >
                        <buttons:SfButton x:Name="btnLogin" Text="{x:Static custom2:AppResources.LogIn}"  CornerRadius="10"
                                      VerticalOptions="End" FontAttributes="Bold" Clicked="TappedOnTinContentBackButton"
                    HeightRequest="48" FontSize="15" TextColor="{DynamicResource Gray-White}" FontFamily="{StaticResource SomarSemiBold}" 
                    BackgroundColor="{StaticResource Secondary}" BorderWidth="0"/>
                    </StackLayout>
                    </Grid>
                </StackLayout>
        </StackLayout>
        </yummy:PancakeView>
</pages:PopupPage>