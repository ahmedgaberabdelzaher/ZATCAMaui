<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
              xmlns:custom="clr-namespace:GAZT"
             xmlns:local="clr-namespace:GAZT;assembly:GAZT"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:core="clr-namespace:Syncfusion.XForms.Core;assembly=Syncfusion.Core.XForms"
             xmlns:converter="clr-namespace:GAZTeServicesApp.Converters"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:gradient="clr-namespace:Syncfusion.XForms.Graphics;assembly=Syncfusion.Core.XForms"
             xmlns:local1="clr-namespace:GAZT.SyncFusionEnabledConverters"
             x:Class="GAZT.Views.NewViews.ChangeEmailPageView"
             Title="{x:Static local:AppResources.ChangeEmail}"
               Style="{StaticResource ContentPageStyle}"
              NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="{core:OnPlatformOrientationStringValue Default=sf_LoginBackground.png,
                                                                  iOSPhoneLandscape=sf_LoginBackground-Landscape.png,
                                                                  iOSTabletLandscape=sf_LoginBackground-Landscape.png}"
             >
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:BooleanToColorConverter x:Key="ColorConverter" />
            <local1:BooleanToForwardArrowIconStringConverter x:Key="forwardConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid x:Name="ParentContainerForEmail">




            <custom:CustomLabel
                x:Name="BackLabel"
                       VerticalOptions="StartAndExpand"
                HorizontalOptions="StartAndExpand"
                        Margin="8,10,8,0"
                        Style="{StaticResource IconLabelStyle}"
                         TextColor="#ffffff"
                        Text="{DynamicResource StyleReverseBack}"
               
                >
                <custom:CustomLabel.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackButtonClicked}"></TapGestureRecognizer>
                </custom:CustomLabel.GestureRecognizers>
            </custom:CustomLabel>


            <gradient:SfGradientView Style="{StaticResource SfGradientViewStyle}" />


            <StackLayout   Margin="{core:OnPlatformOrientationThickness PhonePortrait='20,32',
                                                                 PhoneLandscape='150,32',
                                                                 TabletPortrait='200,50',
                                                                 TabletLandscape='300,50',
                                                                 Desktop='30'}"  WidthRequest="{OnPlatform Default='-1',
                                              UWP='350'}" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" Orientation="Vertical"  IsVisible="{Binding OTPLayoutVisibility}" BackgroundColor="Transparent" Padding="0,10,0,0">
                <ScrollView HorizontalOptions="Center">
                    <ScrollView.VerticalOptions>
                        <OnIdiom
                        x:TypeArguments="LayoutOptions"
                        Default="CenterAndExpand"
                        Phone="FillAndExpand" />
                    </ScrollView.VerticalOptions>
                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="93*"/>
                                <ColumnDefinition Width="7*"/>
                            </Grid.ColumnDefinitions>

                            <!--<Label Text="{x:Static local:AppResources.ZCurrentEmail}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" >
                    </Label>
                    <Frame Grid.Row="1" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                    </Frame>
                    <custom:GAZTBorderlessEntry  Grid.Row="1" Placeholder="{Binding OldEmail}" PlaceholderColor= "#7D858D"  IsEnabled="False" Grid.Column="0"  Grid.ColumnSpan="2" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                        <custom:GAZTBorderlessEntry.Behaviors>
                            <custom:AlphaNumericValidatorBehaviour/>
                        </custom:GAZTBorderlessEntry.Behaviors>
                    </custom:GAZTBorderlessEntry>-->

                            <Label Text="{x:Static local:AppResources.ChangeEmail}" TextColor="#ffffff" Style="{StaticResource LabelStyle}" FontFamily="{StaticResource GAZT_FONT_BOLD}" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>


                            <inputLayout:SfTextInputLayout   x:Name="CurrentEmailLayout"  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                                <custom:GAZTBorderlessEntry Placeholder="{Binding OldEmail}" PlaceholderColor="White" IsEnabled="False" x:Name="CurrentEmail"     FontSize="Small" TextColor="White"  >
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <custom:NumericValidationBehavior/>
                                    </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>


                            <!--<Label Text="{x:Static local:AppResources.NewEmail}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" >
                    </Label>
                    <Frame Grid.Row="3" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                    </Frame>
                    <custom:GAZTBorderlessEntry Text="{Binding NewEmail}"  Grid.Row="3" IsEnabled="{Binding IsEnabledNewEmail}"  Grid.Column="0"  Grid.ColumnSpan="2" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                        <custom:GAZTBorderlessEntry.Behaviors>
                            <custom:AlphaNumericValidatorBehaviour/>
                        </custom:GAZTBorderlessEntry.Behaviors>
                    </custom:GAZTBorderlessEntry>-->

                            <inputLayout:SfTextInputLayout   x:Name="NewEmailLayout"  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.NewEmail}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                                <custom:GAZTBorderlessEntry Text="{Binding NewEmail}"  x:Name="NewEmail" IsEnabled="{Binding IsEnabledNewEmail}"    FontSize="Small" TextColor="White"  >
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                    <custom:AlphaNumericValidatorBehaviour/>
                                </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>


                            <!--<Label Text="{x:Static local:AppResources.RetypeEmail}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" >
                    </Label>
                    <Frame Grid.Row="5" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                    </Frame>
                    <custom:GAZTBorderlessEntry Text="{Binding RetypeEmail}" IsEnabled="{Binding IsEnabledRetypeEmail}" Grid.Row="5"  Grid.Column="0"  Grid.ColumnSpan="2" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                        <custom:GAZTBorderlessEntry.Behaviors>
                            <custom:AlphaNumericValidatorBehaviour/>
                        </custom:GAZTBorderlessEntry.Behaviors>
                    </custom:GAZTBorderlessEntry>-->
                            <inputLayout:SfTextInputLayout   x:Name="RetypeEmailLayout"  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.RetypeEmail}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                                <custom:GAZTBorderlessEntry Text="{Binding RetypeEmail}"  x:Name="RetypeEmail" IsEnabled="{Binding IsEnabledRetypeEmail}"    FontSize="Small" TextColor="White"  >
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                    <custom:AlphaNumericValidatorBehaviour/>
                                </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>

                            <!--<Button Text="{x:Static local:AppResources.ZUpdateEmail}" VerticalOptions="EndAndExpand" Command="{Binding OnVerifyEmailButtonClicked}" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GAZTVerifyButton}"></Button>-->


                        </Grid>






                </ScrollView>
            </StackLayout>


            <StackLayout  VerticalOptions="EndAndExpand" Margin="0" Padding="0"  Orientation="Vertical">
                <buttons:SfButton
                    Margin="0"
                    VerticalOptions="EndAndExpand"
                HorizontalOptions="FillAndExpand"
                   BackgroundColor="#D99A29"
                   FontFamily="{StaticResource GAZT_FONT_BOLD}"
                    HeightRequest="56"
                    CornerRadius="0"
                  Command="{Binding OnVerifyEmailButtonClicked}"
                    IsEnabled="{Binding IsVerifyOTPEnabled}"
                    Text="{x:Static local:AppResources.ZUpdateEmail}"
                    TextColor="{DynamicResource Gray-White}"
                     />
            </StackLayout>
            <!-- Acticity indicator layout start -->
            <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.7" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <ActivityIndicator IsVisible="true" IsRunning="true" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Color="White" />
                        <Label Text="{x:Static local:AppResources.ActivityIndicatorTitle}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" />
                    </StackLayout>
                </StackLayout>
            </Grid>
            <!-- Acticity indicator layout end -->
        </Grid>
          
    </ContentPage.Content>
</ContentPage>