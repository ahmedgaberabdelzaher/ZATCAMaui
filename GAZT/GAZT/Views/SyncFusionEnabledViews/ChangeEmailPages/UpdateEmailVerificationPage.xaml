<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:local="clr-namespace:EGAZT;assembly:GAZT"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:converter="clr-namespace:GAZTeServicesApp.Converters"
    xmlns:core="clr-namespace:Syncfusion.XForms.Core;assembly=Syncfusion.Core.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:gradient="clr-namespace:Syncfusion.XForms.Graphics;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    x:Class="EGAZT.Views.SyncFusionEnabledViews.ChangeEmailPages.UpdateEmailVerificationPage"
    Title="{x:Static local:AppResources.EnterVerificationCodeTitle}"
    NavigationPage.HasNavigationBar="False" BackgroundColor="White"
   >
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:BooleanToColorConverter x:Key="ColorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content >
                <Grid x:Name="ParentContainerForOTP">
            <Grid.RowDefinitions>
                <RowDefinition Height="100*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackLayout Grid.Row="0" Grid.Column="0">
                <custom:CustomLabel
                x:Name="BackLabel"
                       VerticalOptions="StartAndExpand"
                HorizontalOptions="StartAndExpand"
                        Margin="8,10,8,0"
                        Style="{StaticResource IconLabelStyle}"
                         TextColor="#ffffff"
                        Text="{DynamicResource StyleReverseBack}"
                >
                    <custom:CustomLabel.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackButtonClicked}">

                        </TapGestureRecognizer>
                    </custom:CustomLabel.GestureRecognizers>
                </custom:CustomLabel>
               <gradient:SfGradientView Style="{StaticResource SfGradientViewStyle}"  />
               
                <StackLayout WidthRequest="{OnPlatform Default='-1',
                 UWP='350'}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
                             Orientation="Vertical"
                             IsVisible="{Binding OTPLayoutVisibility}"
                             BackgroundColor="Transparent" Padding="0,10,0,0">
                    <ScrollView HorizontalOptions="Center">
                        <ScrollView.VerticalOptions>
                            <OnIdiom
                        x:TypeArguments="LayoutOptions"
                        Default="StartAndExpand"
                        Phone="FillAndExpand" />
                        </ScrollView.VerticalOptions>
          <Grid Grid.Row="0" Grid.Column="0" RowSpacing="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand"
                              VerticalOptions="CenterAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
          <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" RowSpacing="0" ColumnSpacing="0"
                                  VerticalOptions="StartAndExpand">
                 <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto " />
                                    <RowDefinition Height="Auto " />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*" />
                                    <ColumnDefinition Width="50*" />
                                </Grid.ColumnDefinitions>
        <Label Text="{x:Static local:AppResources.EnterVerificationCodeTitle}" Style="{StaticResource LabelStyle}" FontFamily="{StaticResource GAZT_FONT_BOLD}" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>
                                <Label Text="{Binding OTPSentOnThisText}" Style="{StaticResource LabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center"  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"/>
                               
                           
          <inputLayout:SfTextInputLayout   x:Name="enterOtp"  Grid.Row="2"  Grid.Column="0"
                                                                 Grid.ColumnSpan="2" Margin="10,-6,10,-6"
                                           HorizontalOptions="CenterAndExpand"
                                    Hint="{x:Static local:AppResources.VarificationCode}" 
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020"
                                           HasError="False" >

          <custom:GAZTBorderlessEntry Text="{Binding EnteredOTP}"  x:Name="EnteredOTP"
           TextChanged="OnOTPEntered" Keyboard="Numeric"
           Placeholder="{Binding VarificationCode}"  FontSize="Small" TextColor="White"
           IsPassword="True" IsEnabled="{Binding IsOTPEntryEnable}" >
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <custom:NumericValidationBehavior/>
                                        </custom:GAZTBorderlessEntry.Behaviors>
                                    </custom:GAZTBorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                            
   <Label Grid.Row="5" x:Name="NumberOfAttemptsText" Grid.Column="0" IsVisible="{Binding IsNumberOfAttemptTextVisible}" Grid.ColumnSpan="2" TextColor="#D99A29"   Style="{StaticResource InformationRedColorLabel}" FontFamily="{StaticResource SSTArBold}" HorizontalOptions="CenterAndExpand" Margin="10,0,10,0">
                                </Label>
                                <Label Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="CenterAndExpand" VerticalOptions="EndAndExpand" Margin="10,0,10,0">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span  Text="{x:Static local:AppResources.TheAccountwillbelockedwithinTwomin}" TextColor="#7D858D"   Style="{StaticResource MicroGrayLabelStyleNewEn}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}" />
                                            <Span  Text="{Binding OTPValidDuration}" TextColor="#D99A29" FontFamily="{StaticResource SSTArBold}" Style="{StaticResource InformationRedColorLabel}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                 
                                     <buttons:SfButton
                                        Grid.Row="7"
                            Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="10,16,10,50"
                                         VerticalOptions="EndAndExpand"
                HorizontalOptions="FillAndExpand"
                    BackgroundColor="{Binding ButtonDisableColor}"
                          
                   FontFamily="{StaticResource GAZT_FONT_BOLD}"
                    HeightRequest="36"
                    CornerRadius="0"
                Command="{Binding OnResendOTPClicked}"
                            IsEnabled="{Binding IsResendOTPEnabled}"
                            Text="{x:Static local:AppResources.ResendOTP}"
                    TextColor="{DynamicResource Gray-White}"
                     >
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Property="TextColor" Value="gray" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="TextColor" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </buttons:SfButton>

                       
                            <Label  Text="{x:Static local:AppResources.ChangePassword}" Margin="0,0,0,3" TextColor="#ffffff"  VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center"  Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"/>
                            <inputLayout:SfTextInputLayout
                                x:Name="CurrentPasswordLayout" EnablePasswordVisibilityToggle="True"
                                Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
     Hint="{x:Static local:AppResources.CurrentPassword}"
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                <custom:GAZTBorderlessEntry
                                    Placeholder="{x:Static local:AppResources.CurrentPassword}"
                                    Text="{Binding CurrentPassword}" Focused="OnPasswordFocused"
                                    IsPassword="{Binding PasswordVisibilityForOldPassword}"  x:Name="Password"     FontSize="Small" TextColor="White"  >
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <custom:AlphaNumericValidatorBehaviour/>
                                    </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                     
                            <inputLayout:SfTextInputLayout
                                x:Name="NewPasswordLayout" EnablePasswordVisibilityToggle="True"
                                Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.NewPassword}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                <custom:GAZTBorderlessEntry
                                    Placeholder="{x:Static local:AppResources.NewPassword}"  Focused="OnPasswordFocused"
                                    IsPassword="{Binding PasswordVisibilityForNewPassword}"
                                    IsEnabled="{Binding IsEnabledNewPasswordForEmail}"
                                    Text="{Binding NewPasswordForEmail}"
                                    x:Name="NewPassword" FontSize="Small" TextColor="White"  >
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <custom:AlphaNumericValidatorBehaviour/>
                                    </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                            
                            <inputLayout:SfTextInputLayout
                                x:Name="RetypePasswordLayout" EnablePasswordVisibilityToggle="True"
                                Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.RetypePassword}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                <custom:GAZTBorderlessEntry
                                    Placeholder="{x:Static local:AppResources.RetypePassword}"  Focused="OnPasswordFocused"
                                    IsPassword="{Binding PasswordVisibilityForRetypePassword}"
                                    IsEnabled="{Binding IsEnabledRetypePasswordForEmail}"
                                    Text="{Binding RetypePasswordForEmail}"
                                    x:Name="RetypePasswordForEmail" FontSize="Small" TextColor="White"  >
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <custom:AlphaNumericValidatorBehaviour/>
                                    </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>
               
                            </Grid>
                        </Grid>

                    </ScrollView>
                </StackLayout>
                 <StackLayout></StackLayout>
                <StackLayout  VerticalOptions="FillAndExpand" Margin="0" Padding="0"  Orientation="Vertical">
                                   <buttons:SfButton
       Margin="0"
                          BackgroundColor="#D99A29"

                                     Command="{Binding OnSubmitClicked}"
                    IsEnabled="{Binding IsVerifyOTPEnabled}"
                    Text="{x:Static local:AppResources.Verify}"
                     Style="{StaticResource SfButtonStyle}"

                           >
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Property="TextColor" Value="gray" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="TextColor" Value="White" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </buttons:SfButton>
      
                </StackLayout>
       
            </StackLayout>
            <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="FillAndExpand" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="FillAndExpand" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                      AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="FillAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                        
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#d99a29"/>
                        <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
