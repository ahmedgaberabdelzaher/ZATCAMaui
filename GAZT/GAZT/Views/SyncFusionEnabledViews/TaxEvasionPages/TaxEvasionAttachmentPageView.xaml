<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"  
             xmlns:custom="clr-namespace:GAZT"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             Title="{x:Static local:AppResources.ZTERReportFormPageTittle}"
              xmlns:local1="clr-namespace:GAZT"
               xmlns:local="clr-namespace:EGAZT"
             NavigationPage.HasNavigationBar="False"
             xmlns:maps="clr-namespace:Xamarin.Forms.Maps;assembly=Xamarin.Forms.Maps"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" 
             x:Class="EGAZT.Views.SyncFusionEnabledViews.TaxEvasionPages.TaxEvasionAttachmentPageView" BackgroundColor="White"
                 xmlns:gmaps="clr-namespace:Xamarin.Forms.GoogleMaps;assembly=Xamarin.Forms.GoogleMaps">
  <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <controls:TitleView Title="{x:Static local:AppResources.ZTERReportFormPageTittle}"  FontSize="14"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.BackButtonClicked}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="#006450"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource StyleReverseBack}"/>
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
       
          <Grid HorizontalOptions="StartAndExpand" VerticalOptions="Start" ColumnSpacing="0" RowSpacing="1" BackgroundColor="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                              <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                <local1:CustomLabel Grid.Row="0"  Grid.Column="0" Grid.ColumnSpan="2"   FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start"  >
                            <local1:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.ZTEReportAttachmentTitle}"  />
                                </FormattedString>
                            </local1:CustomLabel.FormattedText>
                        </local1:CustomLabel>
                              <!--Report Location-->
                            <local1:CustomLabel Grid.Row="1"  Grid.Column="0" Grid.ColumnSpan="2"   FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start"  >
                            <local1:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.ZTERReportDetailReportDetailRLocation}"  />
                                </FormattedString>
                            </local1:CustomLabel.FormattedText>
                        </local1:CustomLabel>
                        <Frame Grid.Row="2" BackgroundColor="White"   Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTFrameStyleForEntry}" x:Name="FrmReportLocation">
                            <gmaps:Map MapType="Street" x:Name="mapView" MapClicked="mapView_MapClicked" Margin="-12" HeightRequest="200" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"/>
                            <!--<maps:Map  MapType="Street" x:Name="mapView" MapClicked="mapView_MapClicked" HeightRequest="200" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" />-->
                        </Frame>
                        <!--Attachment-->
                            <local1:CustomLabel Grid.Row="3" x:Name="Attachment_Label"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"  Grid.Column="0" Grid.ColumnSpan="2"   Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start"  >
                            <local1:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.ZTERReportDetailAttachment}"  />
                                    <!--<Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />-->
                                </FormattedString>
                            </local1:CustomLabel.FormattedText>
                        </local1:CustomLabel>
             
               <Frame Grid.Row="4"  x:Name="Attachment_Frm" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
    <StackLayout  Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4"  Margin="10,0,10,0" >
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OnAttachmentClick}"/>
                </StackLayout.GestureRecognizers>
        
            <Image x:Name="Attachment_Tmg" Grid.Row="4"  Grid.Column="1"  Margin="0,0,0,0" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Source="ic_attachment.png">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnAttachmentClick}" />
                            </Image.GestureRecognizers>
                        </Image>
            </StackLayout>
                   </Frame>
            
                        <!--HasUnevenRows="True"
                                                 SeparatorVisibility="None"-->
                        <!--<StackLayout Margin="10,0,10,0" HorizontalOptions="FillAndExpand"  Grid.Row="23"  Grid.Column="0" Grid.ColumnSpan="2" VerticalOptions="Start">-->
                        <listView:SfListView  AutoFitMode="DynamicHeight" 
           ItemsSource="{Binding UploadedDocumentsListObj}" SelectionBackgroundColor="White"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="Start"
                                                   Grid.Row="5"  Grid.Column="0" Grid.ColumnSpan="2"
                               BackgroundColor="White"
            >
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <ContentView>
                                            <StackLayout local1:RoundCornersEffect.CornerRadius="10" HorizontalOptions="Fill" VerticalOptions="Start" Margin="10,0,10,0" Padding="0,0,0,10" Spacing="10"  BackgroundColor="White">
                                                <StackLayout local1:RoundCornersEffect.CornerRadius="10" HorizontalOptions="Fill" VerticalOptions="Start" Padding="1" Spacing="10"  BackgroundColor="#BEC2C6">
                                                    <StackLayout Orientation="Horizontal" HorizontalOptions="Fill" Margin="1,1,1,1" Padding="0,0,0,0" BackgroundColor="White" local1:RoundCornersEffect.CornerRadius="10">
                                                        <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Margin="5,0,5,5" Padding="0" >
                                                            <Grid ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand"  BackgroundColor="White" >
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="80*" />
                                                                    <ColumnDefinition Width="20*" />
                                                                    
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto" />
                                                                    <RowDefinition Height="auto" />
                                                                </Grid.RowDefinitions>
                                                                <local1:CustomLabel Text="{x:Static local:AppResources.ZTERReportDetailAttachment}" Margin="0" 
                                   Style="{StaticResource MiniGoldLabelStyle}"  FontFamily="{StaticResource SSTArabicMedium}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                           />
                                                                    <local1:CustomLabel Text="{Binding FileNameWithExtension}" FontFamily="{StaticResource SSTArabicMedium}" 
                                  Margin="0" TextColor="Black"
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                                           />
                                                                <Image Grid.Row="0"  Grid.Column="1" Grid.RowSpan="2"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_delete.png"   >
                                                                    <Image.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="OnDeleteAttachmentClicked" />
                                                                    </Image.GestureRecognizers>
                                                                </Image>
                                                            </Grid>
                                                        </StackLayout>
                                                    </StackLayout>
                                                </StackLayout>
                                            </StackLayout>
                                        </ContentView>
                                    </ViewCell>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                        </listView:SfListView>
                    <StackLayout Grid.Column="0" Grid.Row="8" Grid.ColumnSpan="2"  Margin="0,0,0,0"  BackgroundColor="White">
                    <buttons:SfButton Text="{x:Static local:AppResources.ZTEReportCategorySubmitBtn}" HeightRequest="56"  x:Name="submit_btnmane" IsEnabled="{Binding IsSubmitButtonEnable}" Style="{StaticResource SfButtonStyle}" Margin="0" Padding="0" CornerRadius="0" VerticalOptions="Start" Command="{Binding SubmitReportClicked}"   BackgroundColor="#006450" ></buttons:SfButton>
                </StackLayout>
            
             
              <!-- Acticity indicator layout start -->
              <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Horizontal" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                      AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="Center"
                                           IsBusy="True"
                                       ViewBoxWidth = "70"        
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                        TextColor="#006450"/>
                    </StackLayout>
                </StackLayout>
                </Grid> 
            </Grid>
     </ContentPage.Content>

</ContentPage>
