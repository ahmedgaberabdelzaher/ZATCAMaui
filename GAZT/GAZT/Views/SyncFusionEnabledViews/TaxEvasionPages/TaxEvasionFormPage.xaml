<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
            
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             
             xmlns:maps="clr-namespace:Xamarin.Forms.Maps;assembly=Xamarin.Forms.Maps"
              xmlns:custom="clr-namespace:GAZT"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             Title="{x:Static local:AppResources.ZTERReportFormPageTittle}"
              xmlns:local1="clr-namespace:GAZT"
               xmlns:local="clr-namespace:EGAZT"
             NavigationPage.HasNavigationBar="False"
                 xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
   
             
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
            
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.TaxEvasionPages.TaxEvasionFormPage">
   <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary Source="..\Common\Styles.xaml" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <!--  Title View  -->
                <controls:TitleView Title="{x:Static local:AppResources.ZTERReportFormPageTittle}"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.BackButtonClicked}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="#006450"
                            Style="{StaticResource IconButtonStyle}"
                             Text="{DynamicResource StyleReverseBack}"
                             />
                    </controls:TitleView.LeadingView>
                             <!--      <controls:TitleView.TrailingView>
                        <Button Text="Next"
                                x:Name="nextButton"
                                Command="{TemplateBinding BindingContext.NextButtonClicked}"
                                 CommandParameter="{x:Reference nextButton}"
                            CornerRadius="4"
                            TextColor="#006450">
                           
                        </Button>
                    </controls:TitleView.TrailingView>-->
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
            <Grid x:Name="MainLayout" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid HorizontalOptions="FillAndExpand" x:Name="TaxEvasionMainGrid" VerticalOptions="FillAndExpand"    Padding="0,0,0,0" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="80*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <ScrollView Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"  HorizontalOptions="FillAndExpand" BackgroundColor="White">
                    <Grid>
                        
                 
                    <Grid Grid.Row="0" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" RowSpacing="15"  BackgroundColor="White" Margin="0" Padding="0,10,0,10" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>
                        <inputLayout:SfTextInputLayout x:Name="FrmCategory"   Grid.Row="0"  Grid.Column="0"  Grid.ColumnSpan="2"    Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZTERReportDetailName}"
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"  
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <controls:BorderlessEntry  x:Name="TCategory" IsSpellCheckEnabled="False" FontSize="Small"  Text="{Binding TCategory}">
                                <Entry.Behaviors>
                                    <custom1:AlphabetandArabicCharacters/>
                                </Entry.Behaviors>
                            </controls:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                         <inputLayout:SfTextInputLayout x:Name="FrmVAT"   Grid.Row="1"  Grid.Column="0"  Grid.ColumnSpan="2"    Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZTERReportDetailVATNumber}"
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <custom:GAZTBorderlessEntry   IsSpellCheckEnabled="False" Text="{Binding TVatNumber}" x:Name="TVatNumber" MaxLength="15" Unfocused="TVatNumber_Unfocused" Placeholder="{x:Static local:AppResources.ZTERReportFormEnterVATno}" Keyboard="Numeric"></custom:GAZTBorderlessEntry>
                        </inputLayout:SfTextInputLayout>

                    <inputLayout:SfTextInputLayout x:Name="FrmFName"   Grid.Row="2"  Grid.Column="0"  Grid.ColumnSpan="2"    Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZTERReportDetailFacilityName}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <custom:BorderlessEntry  x:Name="TFaciName" IsSpellCheckEnabled="False" FontSize="Small"   Text="{Binding TFaciName}"  Unfocused="TFaciName_Unfocused">
                                <Entry.Behaviors>
                                    <custom1:AlphabetandArabicCharacters/>
                                </Entry.Behaviors>
                            </custom:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                     
                            <!--Report Location-->
                           <local1:CustomLabel Grid.Row="3"  Grid.Column="0" Grid.ColumnSpan="2"   FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start"  >
                            <local1:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.ZTERReportDetailReportDetailRLocation}"  />
                                </FormattedString>
                            </local1:CustomLabel.FormattedText>
                        </local1:CustomLabel>
                        <Frame  Grid.Row="3" BackgroundColor="White"   Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTFrameStyleForEntry}" x:Name="FrmReportLocation">
                            <maps:Map Grid.Row="3"    Grid.Column="0" Grid.ColumnSpan="2"  MapType="Street" x:Name="mapView" MapClicked="mapView_MapClicked" HeightRequest="200" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" />
                        </Frame>
                        <inputLayout:SfTextInputLayout  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZTERReportDetailRegion}"  x:Name="frmRegionPicker"
    ContainerType="Outlined" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <controls:BorderlessEntry Text="{Binding TxtReportDetailRegion}" x:Name="Region_entry" IsSpellCheckEnabled="False" FontSize="Small">
                            </controls:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                        <custom:CustomButton x:Name="btnTxtReportDetailRegion" Clicked="btnTxtReportDetailRegion_Clicked" FontSize="Small"  BackgroundColor="Transparent" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,0" >
                        </custom:CustomButton>
                        <syncfusion:SfPicker
                    HeaderHeight="40"
                    ShowHeader="True"
                    HeaderText="{x:Static local:AppResources.ZTERReportDetailRegion}"
HeaderTextColor="White"

                    ShowColumnHeader="False"
                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"                                              
                   ItemHeight="40"
                                HeaderBackgroundColor="#006450"
                    SelectedItemTextColor="#006450"
                    BorderColor="Black"
                            OKButtonTextColor="#006450"  CancelButtonTextColor="#006450"
                                             BackgroundColor="#EAF7CC"
                           OkButtonClicked="RegionPicker_OkButtonClicked"
                            CancelButtonClicked="RegionPicker_CancelButtonClicked"
                    x:Name="RegionPicker"  ItemsSource="{Binding RList}" DisplayMemberPath="Name"  IsVisible="{Binding IsVisiblePickerEn}" IsEnabled="{Binding IsVisiblePickerEn}"    Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,0"
                    PickerHeight="200"
                    PickerWidth="270"
                    ShowFooter="True"
                     OKButtonBackgroundColor="#EAF7CC"
                                    CancelButtonBackgroundColor="#EAF7CC" FooterHeight="46">
                            <syncfusion:SfPicker.Behaviors>
                                <custom1:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>
                        </syncfusion:SfPicker>
                        <syncfusion:SfPicker
                    HeaderHeight="40"
                    ShowHeader="true"
                    HeaderText="{x:Static local:AppResources.ZTERReportDetailRegion}"
                            HeaderTextColor="White"

                    ShowColumnHeader="False"
                               HeaderBackgroundColor="#006450"
                    SelectedItemTextColor="#006450"
                    BorderColor="Black"
                            OKButtonTextColor="#006450"  CancelButtonTextColor="#006450"
                                             BackgroundColor="#EAF7CC"
                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"
                            OkButtonClicked="RegionPickerAR_OkButtonClicked"
                            CancelButtonClicked="RegionPickerAR_CancelButtonClicked"
                   ItemHeight="40"
                   x:Name="RegionPickerAR"  ItemsSource="{Binding RList}" DisplayMemberPath="Name"  IsVisible="{Binding IsVisiblePickerAr}" IsEnabled="{Binding IsVisiblePickerAr}"    Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,0"
                    PickerHeight="200"
                    PickerWidth="270"
                     ShowFooter="True"
                     OKButtonBackgroundColor="#EAF7CC"
                                    CancelButtonBackgroundColor="#EAF7CC" FooterHeight="46">
                            <syncfusion:SfPicker.Behaviors>
                                <custom1:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>
                        </syncfusion:SfPicker>
                          <inputLayout:SfTextInputLayout  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZTERReportDetailCity}"  x:Name="FrmCity" 
    ContainerType="Outlined" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <custom:BorderlessEntry IsSpellCheckEnabled="False" Text="{Binding TxtReportDetailCity}" FontSize="Small"  x:Name="City_entry">
                            </custom:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                        <custom:CustomButton x:Name="btnReportDetailCity" Clicked="btnReportDetailCity_Clicked" FontSize="Small" BackgroundColor="Transparent" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,0" >
                        </custom:CustomButton>
                        <syncfusion:SfPicker
                        HeaderHeight="40"
                        ShowHeader="true"
                        HeaderText="{x:Static local:AppResources.ZTERReportDetailCity}"
                                HeaderTextColor="White"

                        ShowColumnHeader="False"
                        ColumnHeaderHeight="46"
                        PickerMode="Dialog"                                              
                       ItemHeight="40"
                                OKButtonTextColor="#006450"  CancelButtonTextColor="#006450"
                                OkButtonClicked="CityPicker_OkButtonClicked"
                                CancelButtonClicked="CityPicker_CancelButtonClicked"
                                  HeaderBackgroundColor="#006450"
                        SelectedItemTextColor="#006450"
                        BorderColor="Black"
                                                 BackgroundColor="#EAF7CC"
                       x:Name="CityPicker"    ItemsSource="{Binding CList}" DisplayMemberPath="Name" IsVisible="{Binding IsVisiblePickerEn}" IsEnabled="{Binding IsVisiblePickerEn}"   Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,0"
                        PickerHeight="200"
                        PickerWidth="270"
                         ShowFooter="True"
                         OKButtonBackgroundColor="#EAF7CC"
                                        CancelButtonBackgroundColor="#EAF7CC" FooterHeight="46">
                                <!--SelectedItem="{Binding SelectLCType,Mode=TwoWay}"-->
                                <syncfusion:SfPicker.Behaviors>
                                    <custom1:SfPickerBehavior />
                                </syncfusion:SfPicker.Behaviors>
                        </syncfusion:SfPicker>
                       <!--SelectedItem="{Binding SelectLCType,Mode=TwoWay}"-->
                        <syncfusion:SfPicker
                    HeaderHeight="40"
                    ShowHeader="true"
                    HeaderText="{x:Static local:AppResources.ZTERReportDetailCity}"
                            HeaderTextColor="White"

                    ShowColumnHeader="False"
                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"
                               HeaderBackgroundColor="#006450"
                    SelectedItemTextColor="#006450"
                    BorderColor="Black"
                            OKButtonTextColor="#006450"  CancelButtonTextColor="#006450"
                            OkButtonClicked="CityPickerAR_OkButtonClicked"
                            CancelButtonClicked="CityPickerAR_CancelButtonClicked"
                                             BackgroundColor="#EAF7CC"
                   ItemHeight="40"
                   x:Name="CityPickerAR"  ItemsSource="{Binding CList}" DisplayMemberPath="Name" IsVisible="{Binding IsVisiblePickerAr}" IsEnabled="{Binding IsVisiblePickerAr}"    Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,0"
                    PickerHeight="200"
                    PickerWidth="270"
                    ShowFooter="True"
                     OKButtonBackgroundColor="#EAF7CC"
                                    CancelButtonBackgroundColor="#EAF7CC" FooterHeight="46">
                            <syncfusion:SfPicker.Behaviors>
                                <custom1:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>
                        </syncfusion:SfPicker>
                         <inputLayout:SfTextInputLayout x:Name="FrmFSAddress"   Grid.Row="6"  Grid.Column="0"  Grid.ColumnSpan="2"    Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZTERReportDetailFSAddress}"
    ContainerType="Outlined" UnfocusedColor="#B1B1B1" 
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <custom:BorderlessEntry  x:Name="TFSAddress" FontSize="Small" IsSpellCheckEnabled="False" Unfocused="TFSAddress_Unfocused"  Text="{Binding TFSAddress}"  MaxLength="100">
                            </custom:BorderlessEntry>
                            <!--FontAttributes="Bold"-->
                        </inputLayout:SfTextInputLayout>
                       
                

           <inputLayout:SfTextInputLayout x:Name="FrmTIN"   Grid.Row="8"  Grid.Column="0"  Grid.ColumnSpan="2"    Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZZTIN}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1" 
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                    <custom:GAZTBorderlessEntry  Grid.Row="0"  Grid.Column="0"  Grid.ColumnSpan="2"
                                                                 MaxLength="10"   Text="{Binding TxtTIN}" x:Name="TxtTIN" Unfocused="TxtTIN_Unfocused"
                                                                 IsSpellCheckEnabled="False" Keyboard="Numeric" ></custom:GAZTBorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                     </Grid>
                         </Grid>
                    
                    </ScrollView>
                         <StackLayout Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"  Margin="0,0,0,0"  BackgroundColor="White">
                    <buttons:SfButton Text="{x:Static local:AppResources.ZTEReportCategorySubmitBtn}" HeightRequest="56"  x:Name="submit_btnmane" IsEnabled="{Binding IsSubmitButtonEnable}" Style="{StaticResource SfButtonStyle}" Margin="0" Padding="0" CornerRadius="0" VerticalOptions="EndAndExpand" Command="{Binding SubmitReportClicked}" Clicked="Button_Clicked" BackgroundColor="#006450" Opacity="0.7" ></buttons:SfButton>
                </StackLayout>
                </Grid>
                </Grid>
    </ContentPage.Content>
</ContentPage>
