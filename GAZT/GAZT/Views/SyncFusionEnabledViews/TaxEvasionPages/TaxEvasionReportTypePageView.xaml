<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
              xmlns:local="clr-namespace:EGAZT"
             xmlns:local1="clr-namespace:GAZT"
                xmlns:custom="clr-namespace:GAZT"
             NavigationPage.HasNavigationBar="False"
                 xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:tabview="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.TaxEvasionReportType.TaxEvasionReportTypePageView"
             BackgroundColor="White" Title="{x:Static local:AppResources.ZTERReportCategoryPageTittle}">
    <!--<ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary Source="..\Common\Styles.xaml" />
        </ResourceDictionary>
    </ContentPage.Resources>-->
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary Source="..\Common\Styles.xaml" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <!--  Title View  -->
                <controls:TitleView Title="{x:Static local:AppResources.ZTERReportCategoryPageTittle}"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Clicked="BackButtonClicked"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="#006450"
                            Style="{StaticResource IconButtonStyle}"
                             Text="{DynamicResource StyleReverseBack}"
                             />
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
             <Grid Grid.Row="0" x:Name="MainLayout" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
             <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Grid.Row="0"  Margin="0" Padding="0,10,0,0"  RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*" />
                    <RowDefinition Height="10*" />
                    <RowDefinition Height="60*" />
                    <RowDefinition Height="20*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

            <Label Text="{x:Static local:AppResources.ZTERReportPageHeadingText}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                   VerticalOptions="Center"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" Grid.Row="0" Grid.Column="0"
                   Grid.ColumnSpan="2" HorizontalTextAlignment="Center" BackgroundColor="White">
            </Label>
            <Label Text="{x:Static local:AppResources.ZTERChooseReportCategory}"  FontFamily="{StaticResource GAZT_FONT_BOLD}"
                   VerticalOptions="Center"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="1" Grid.Column="0"
                   Grid.ColumnSpan="2" TextColor="#d99a29" HorizontalOptions="Center" />
         
            <ListView x:Name="ReportTypesListView" SeparatorColor="Transparent" SeparatorVisibility="None" ItemsSource="{Binding ReportTypes}" SelectionMode="Single"  BackgroundColor="Transparent" 
                      Grid.Row="2" Grid.Column="0" Margin="15,0,15,0"  Grid.ColumnSpan="2" ItemSelected="ListView_ItemSelected"  HasUnevenRows="true" SelectedItem="{Binding SelectedReportTypeListItem}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                             <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Grid.Row="0"  Margin="0" Padding="0,10,0,0"  RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80*"/>
                                    <ColumnDefinition Width="20*"/>
                                </Grid.ColumnDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" Text="{Binding Title}" Margin="15,5,0,5" MaxLines="5" 
                                             FontFamily="{StaticResource GAZT_FONT_MEDIUM}" FontSize="14"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                             HorizontalOptions="StartAndExpand" VerticalOptions="Center">
                                    </Label>
                                    <Image x:Name="CheckBoxSelection" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1"  HorizontalOptions="EndAndExpand" Margin="0,5,0,0" 
                                           VerticalOptions="CenterAndExpand">
                                     <Image.Triggers>

                                      <DataTrigger TargetType="Image" Binding="{Binding IsTypeSelected}" Value="True">
                                         <Setter Property="IsVisible" Value="True"></Setter>
                                        <Setter Property="Source" Value="ic_Check_Golden_TES.png" />

                                         </DataTrigger>
                                        <DataTrigger TargetType="Image" Binding="{Binding IsTypeSelected}" Value="False">
                                         <Setter Property="IsVisible" Value="False"></Setter>
                                        </DataTrigger>
                                     </Image.Triggers>
                                    </Image>
                                    <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Gray"  HeightRequest="1"></BoxView>
                                </Grid>
                            </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackLayout Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2"  Margin="0,0,0,0"  BackgroundColor="White">
                        <buttons:SfButton Text="{x:Static local:AppResources.ZTEReportCategoryNextBtn}" VerticalOptions="EndAndExpand" Margin="0" HeightRequest="56" CornerRadius="0" Command="{Binding OnNextClicked}"  IsEnabled="{Binding IsnextbuttonEnable}"  BackgroundColor="{Binding NextbuttonDisableColor}" Style="{StaticResource SfButtonStyle}"  Opacity="0.7" ></buttons:SfButton>
            </StackLayout>
            </Grid>
            </Grid>
            <Grid Grid.Row="0"  Grid.Column="0" IsVisible="{Binding IsLoading}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="Black" Opacity="0.4">
                <StackLayout Grid.Row="0"  Grid.RowSpan="2" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#006450"/>
                        <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
