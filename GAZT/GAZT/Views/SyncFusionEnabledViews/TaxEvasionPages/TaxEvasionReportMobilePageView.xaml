<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:local1="clr-namespace:EGAZT;assembly:GAZT"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms" xmlns:control="clr-namespace:GAZTeServicesApp.Controls" xmlns:local="clr-namespace:GAZTeServicesApp.Views.Common" 
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms" xmlns:core="clr-namespace:Syncfusion.XForms.Core;assembly=Syncfusion.Core.XForms" 
             xmlns:custom="clr-namespace:GAZT" 
             xmlns:gradient="clr-namespace:Syncfusion.XForms.Graphics;assembly=Syncfusion.Core.XForms"
             mc:Ignorable="d"
    xmlns:converter="clr-namespace:GAZTeServicesApp.Converters"
        xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:custom1="clr-namespace:GAZT.CustomControl" xmlns:maskededit="clr-namespace:Syncfusion.XForms.MaskedEdit;assembly=Syncfusion.SfMaskedEdit.XForms"
    FlowDirection="LeftToRight"
    NavigationPage.HasNavigationBar="False"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.TaxEvasionReportMobile.TaxEvasionReportMobilePageView"
             BackgroundColor="White">
    <!-- Style="{StaticResource ContentPageStyle}"
    BackgroundImageSource="{core:OnPlatformOrientationStringValue Default=sf_LoginBackground.png,
                                                                  iOSPhoneLandscape=sf_LoginBackground-Landscape.png,
                                                                  iOSTabletLandscape=sf_LoginBackground-Landscape.png}"-->
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:BooleanToColorConverter x:Key="ColorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid x:Name="MainLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"></RowDefinition>
                <RowDefinition Height="90*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                x:Name="BackLabel"
                       VerticalOptions="Start"
                HorizontalOptions="Start"
                        Margin="8,10,8,0"
  Style="{StaticResource IconLabelStyle}"
                         TextColor="White"
                        Text="{DynamicResource StyleReverseBack}">
                    <custom:CustomLabel.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackButtonClicked}"></TapGestureRecognizer>
                    </custom:CustomLabel.GestureRecognizers>
                </custom:CustomLabel>
                <gradient:SfGradientView Style="{StaticResource SfGradientViewStyle}" />
                <ScrollView Grid.Row="1" Grid.Column="0" HorizontalOptions="CenterAndExpand" VerticalOptions="Fill">
                     <Grid RowSpacing="0" VerticalOptions="Center" Margin="0,-80,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--  Label to display the title of this page  -->
                            <Label
                            FontFamily="{StaticResource GAZT_FONT_BOLD}"
                            FontSize="20"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource LabelStyle}"
                            Text="{x:Static local1:AppResources.ZZZWelcome}" />
                            <!--  Label to display the description of this page  -->
                            <Label
                            Grid.Row="1"
                            Margin="0,8"
                            FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource LabelStyle}"
                            Text="{x:Static local1:AppResources.ZZZPleaseenteryourmobilenumbertoproceedfurther}" />
                            <!--Entry to get email ID from user-->
                            <!--ZTERReportDetailNumber-->
                                <Grid FlowDirection="LeftToRight"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
                                       Grid.Row="2" Margin="10,5,10,0" x:Name="StacklayoutEn">
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto" />
                                     </Grid.RowDefinitions>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="20*" />
                                          <ColumnDefinition Width="80*" />
                                     </Grid.ColumnDefinitions>
                                    <Frame FlowDirection="LeftToRight" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderColor="White" HasShadow="False"/>
                                    <Label FlowDirection="LeftToRight" Margin="0,10,-20,0" x:Name="mobileNumberPrefix" Grid.Row="0" Grid.Column="0"  Text="+966"  TextColor="#D99A29"
                                           FontSize="Medium"  VerticalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center"
                                           HorizontalTextAlignment="Center"></Label>
                                    <inputLayout:SfTextInputLayout FlowDirection="LeftToRight" Grid.Row="0" Grid.Column="1" Margin="0,0,10,0"
                                    Hint="{x:Static local1:AppResources.ZTERReportDetailNumber}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"
                                    ContainerType="None" x:Name="frmMobile" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020"   >
                                        <control:BorderlessEntry FlowDirection="LeftToRight" x:Name="Mobile_Entry" Text="{Binding MobileNumber}"  Unfocused="Mobile_Entry_Unfocused" FontSize="Medium" TextColor="White"  PlaceholderColor="Gray" Keyboard="Telephone" MaxLength="9">
                                            <Entry.Behaviors>
                                                <custom1:OnlyNumericValuesBehaviour/>
                                            </Entry.Behaviors>
                                        </control:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                </Grid>
                            <!--  Login button  -->

                            <buttons:SfButton
                            Grid.Row="3"
                            Margin="10,16,10,16"
                            BackgroundColor="#D99A29"
                            Opacity="0.7"
                                IsEnabled="{Binding IsVerifyEnable}"
                                Command="{Binding VerifyCommand}"
                            Style="{StaticResource SfButtonStyle}"
                            Text="{x:Static local1:AppResources.Verify}"/>

                            <buttons:SfButton IsVisible="false"
                            Grid.Row="4"
                            Margin="10,16,10,16"
                            BackgroundColor="#D99A29"
                            Opacity="0.7"
                                Command="{Binding RegisterCommand}"
                            Style="{StaticResource SfButtonStyle}"
                            Text="{x:Static local1:AppResources.ZTERNewAccount}"/>
                            <!--Command="{Binding LoginCommand}"-->
                        </Grid>

                    
                </ScrollView>
            <!--<busyindicator:SfBusyIndicator x:Name="BusyIndicator" 
                                       AnimationType="HorizontalPulsingBox" 
                                       ViewBoxWidth = "150" 
                                       ViewBoxHeight="150" 
                                       TextColor="DarkGreen" 
                                       IsBusy="{Binding IsLoading}"/>-->
            <!-- Acticity indicator layout start -->
            <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                      AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                       
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                        TextColor="#006450"/>
                    </StackLayout>
                </StackLayout>
            </Grid>
            <!--Title="{x:Static local1:AppResources.ActivityIndicatorTitle}" Acticity indicator layout end -->
        </Grid>
    </ContentPage.Content>
</ContentPage>
