<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:local1="clr-namespace:GAZT;assembly:GAZT"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms" xmlns:control="clr-namespace:GAZTeServicesApp.Controls" xmlns:local="clr-namespace:GAZTeServicesApp.Views.Common" 
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms" xmlns:core="clr-namespace:Syncfusion.XForms.Core;assembly=Syncfusion.Core.XForms" 
             xmlns:custom="clr-namespace:GAZT" 
             xmlns:gradient="clr-namespace:Syncfusion.XForms.Graphics;assembly=Syncfusion.Core.XForms"
             mc:Ignorable="d"
                 
    xmlns:converter="clr-namespace:GAZTeServicesApp.Converters"
        xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    

    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:custom1="clr-namespace:GAZT.CustomControl"
    FlowDirection="LeftToRight"
    NavigationPage.HasNavigationBar="False"
    
             x:Class="GAZT.Views.SyncFusionEnabledViews.TaxEvasionPages.TaxEvasionReportMobilePageView">

    <!-- Style="{StaticResource ContentPageStyle}"
    BackgroundImageSource="{core:OnPlatformOrientationStringValue Default=sf_LoginBackground.png,
                                                                  iOSPhoneLandscape=sf_LoginBackground-Landscape.png,
                                                                  iOSTabletLandscape=sf_LoginBackground-Landscape.png}"-->

    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:BooleanToColorConverter x:Key="ColorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>


    <ContentPage.Content>



        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackLayout>
                <custom:CustomLabel
                x:Name="BackLabel"
                       VerticalOptions="Start"
                HorizontalOptions="Start"
                        Margin="8,10,8,0"
  Style="{StaticResource IconLabelStyle}"
                         TextColor="White"
                        Text="{DynamicResource StyleReverseBack}"
                >
                    <custom:CustomLabel.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackButtonClicked}"></TapGestureRecognizer>
                    </custom:CustomLabel.GestureRecognizers>
                </custom:CustomLabel>

                <gradient:SfGradientView Style="{StaticResource SfGradientViewStyle}" />
                <ScrollView HorizontalOptions="Center" VerticalOptions="CenterAndExpand">
                    <ScrollView.VerticalOptions>
                        <OnIdiom
                        x:TypeArguments="LayoutOptions"
                        Default="CenterAndExpand"
                        Phone="FillAndExpand" />
                    </ScrollView.VerticalOptions>
                    <!--Margin="{core:OnPlatformOrientationThickness PhonePortrait='20,32',
                                                                 PhoneLandscape='150,32',
                                                                 TabletPortrait='200,50',
                                                                 TabletLandscape='300,50',
                                                                 Desktop='30'}"-->

                    <StackLayout

                    Spacing="0"
                    VerticalOptions="FillAndExpand"
                    WidthRequest="{OnPlatform Default='-1',
                                              UWP='350'}">

                        <Grid RowSpacing="0" VerticalOptions="Center">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Label to display the title of this page  -->
                            <Label
                            FontFamily="{StaticResource GAZT_FONT_BOLD}"
                            FontSize="20"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource LabelStyle}"
                            Text="{x:Static local1:AppResources.ZZZWelcome}" />

                            <!--  Label to display the description of this page  -->
                            <Label
                            Grid.Row="1"
                            Margin="0,8"
                            FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource LabelStyle}"
                            Text="{x:Static local1:AppResources.ZZZPleaseenteryourmobilenumbertoproceedfurther}" />

                            <!--Entry to get email ID from user-->
                            <!--ZTERReportDetailNumber-->
                            <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="2"   Orientation="Horizontal" Margin="10,5,10,0" x:Name="StacklayoutEn">
                                <Label  Text="+9665"  TextColor="#D99A29" FontSize="Medium"  VerticalTextAlignment="Center" HorizontalOptions="Start" VerticalOptions="Center" HorizontalTextAlignment="Center"></Label>
                                <inputLayout:SfTextInputLayout   Margin="10,-6,10,-6" 
    Hint="{x:Static local1:AppResources.ZTERReportDetailNumber}" HorizontalOptions="FillAndExpand"
    ContainerType="Outlined" x:Name="frmMobile" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020"   >
                                    <control:BorderlessEntry x:Name="Mobile_Entry"  Text="{Binding MobileNumber}"  Unfocused="Mobile_Entry_Unfocused"    FontSize="Small" TextColor="White"  PlaceholderColor="Gray" Keyboard="Telephone" MaxLength="8">
                                        <Entry.Behaviors>

                                            <custom1:OnlyNumericValuesBehaviour/>

                                        </Entry.Behaviors>
                                    </control:BorderlessEntry>

                                </inputLayout:SfTextInputLayout>
                            </StackLayout>
                            <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="2"   Orientation="Horizontal" x:Name="StackLayoutAr" Margin="10,5,10,0">

                                <inputLayout:SfTextInputLayout   Margin="10,-6,10,-6" 
    Hint="{x:Static local1:AppResources.ZTERReportDetailNumber}" HorizontalOptions="FillAndExpand"
    ContainerType="Outlined" x:Name="frmMobileAr" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020"   >
                                    <control:BorderlessEntry x:Name="Mobile_EntryAr"  Text="{Binding MobileNumber}"  Unfocused="Mobile_Entry_Unfocused"    FontSize="Small" TextColor="White"  PlaceholderColor="Gray" Keyboard="Telephone" MaxLength="8">
                                        <Entry.Behaviors>

                                            <custom1:OnlyNumericValuesBehaviour/>

                                        </Entry.Behaviors>
                                    </control:BorderlessEntry>

                                </inputLayout:SfTextInputLayout>
                                <Label x:Name="Arabic_mobCountycode" Text="+9665"  TextColor="#D99A29" FontSize="Medium"  VerticalTextAlignment="Center" HorizontalOptions="Start" VerticalOptions="Center" HorizontalTextAlignment="Center"></Label>
                            </StackLayout>


                            <!--  Login button  -->
                            <buttons:SfButton
                          
                            Grid.Row="3"
                            Margin="10,16,10,16"
                            BackgroundColor="#D99A29"
                            Opacity="0.7"
                                IsEnabled="{Binding IsVerifyEnable}"
                                
                                Command="{Binding VerifyCommand}"
                            
                            Style="{StaticResource SfButtonStyle}"
                            Text="{x:Static local1:AppResources.Verify}" />
                            <!--Command="{Binding LoginCommand}"-->



                        </Grid>



                    </StackLayout>
                </ScrollView>
            </StackLayout>
            <!--<busyindicator:SfBusyIndicator x:Name="BusyIndicator" 
                                       AnimationType="HorizontalPulsingBox" 
                                       ViewBoxWidth = "150" 
                                       ViewBoxHeight="150" 
                                       TextColor="DarkGreen" 
                                       IsBusy="{Binding IsLoading}"/>-->

            <!-- Acticity indicator layout start -->

            <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.7" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                      AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                       Title="{x:Static local1:AppResources.ActivityIndicatorTitle}"
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                        TextColor="#006450"/>
                    </StackLayout>
                </StackLayout>
            </Grid>
            <!-- Acticity indicator layout end -->
        </Grid>
    </ContentPage.Content>

</ContentPage>
