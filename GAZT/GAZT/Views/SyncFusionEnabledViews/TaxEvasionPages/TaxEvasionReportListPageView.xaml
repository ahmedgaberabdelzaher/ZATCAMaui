                            <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="10,0,10,0">
                                <ListView   IsVisible="{Binding IsCertificateAvailable}" Margin="0,10,0,0" ItemsSource ="{Binding TERListReportbymobnoClosed}" VerticalOptions="Fill" x:Name="CertificateLstClosed" HasUnevenRows="true" ItemTapped="CertificateLstClosed_ItemTapped" SelectedItem="{Binding SelectedTaxEvasionListItem}" BackgroundColor="Transparent" SeparatorVisibility="None">
                                    <x:Arguments>
                                        <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                                    </x:Arguments>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>

                                                <cards:SfCardView HasShadow="True" BorderWidth=".05" BorderColor="#5d6770"  ShadowColor="#5d6770" BackgroundColor="White" Margin="0,6,0,6" CornerRadius="8" IndicatorColor="DarkGreen" IndicatorPosition="Left" IndicatorThickness="5" >


                                                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Padding="12" >
                                                        <Grid ColumnSpacing="0" RowSpacing="0"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White" >
