                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                                           >
                                                                <local1:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}" FontSize="12" Text="{x:Static local:AppResources.ZTEReportReportStatus}"></Span>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}" FontSize="12" Text=" : "></Span>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" FontSize="12" Text="{Binding ReportStatusMessageNewTObIND}"></Span>
                                                                    </FormattedString>
                                                                </local1:CustomLabel.FormattedText>
                                                            </local1:CustomLabel>
                                                        </Grid>
                                                    </StackLayout>
                                                </cards:SfCardView>
                                            </ViewCell>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackLayout>
                                    <local1:CustomLabel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Text="{x:Static local:AppResources.Nodataavailable}" Style="{StaticResource MiniBlackLabelStyle}"  HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding SetNoDataLabelVisibilityforClose}">
                            </local1:CustomLabel>
                        </Grid>
                    </tabview:SfTabItem.Content>
                </tabview:SfTabItem>
            </tabview:SfTabView.Items>
        </tabview:SfTabView>
</Grid>
<Grid Grid.Row="0"  Grid.Column="0" IsVisible="{Binding IsLoading}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="Black" Opacity="0.7">
                <StackLayout Grid.Row="0"  Grid.RowSpan="2" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                        Title="{x:Static local:AppResources.ActivityIndicatorTitle}"
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#006450"/>
                    </StackLayout>
                </StackLayout>
            </Grid>
