<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:GAZT;assembly:GAZT" 
             xmlns:local1="clr-namespace:GAZT" 
              xmlns:tabview="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms"
             Title="{x:Static local:AppResources.ZTEReportReportScreenTitle}"
              xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:core="clr-namespace:Syncfusion.XForms.Core;assembly=Syncfusion.Core.XForms"
             x:Class="GAZT.Views.NewViews.TaxEvasionReportListPageView"
             
                 xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
            ><!--NavigationPage.HasNavigationBar="False"-->
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="ic_add1.png"  
                Priority="2" Order="Primary" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <tabview:SfTabView Margin="0,0,0,2" x:Name="simTab" VisibleHeaderCount="2" >
            <tabview:SfTabView.SelectionIndicatorSettings>
                <tabview:SelectionIndicatorSettings
                    Color="DarkGreen" 
                    Position="Bottom" 
                    StrokeThickness="2"/>
            </tabview:SfTabView.SelectionIndicatorSettings>
            <tabview:SfTabView.Items>
                <tabview:SfTabItem Title="{x:Static local:AppResources.ZTEReportReportOpen}"   
                             TitleFontSize="14"
                            SelectionColor="Black"
                             FontIconFontColor="#FF00AFF0"
                                   
                             TitleFontColor="Gray">
                   
                    <tabview:SfTabItem.Content>
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="12*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="33*" />
                                <ColumnDefinition Width="34*" />
                                <ColumnDefinition Width="33*" />
                            </Grid.ColumnDefinitions>
                            <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="10,0,10,0">
                                <ListView Margin="0,10,0,0"  IsVisible="{Binding IsCertificateAvailable}" ItemsSource ="{Binding TERListReportbymobno}" VerticalOptions="Fill" x:Name="CertificateLst" ItemTapped="CertificateLst_ItemTapped" HasUnevenRows="true" SelectedItem="{Binding SelectedTaxEvasionListItem}" BackgroundColor="Transparent" SeparatorVisibility="None">
                                    <x:Arguments>
                                        <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                                    </x:Arguments>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <cards:SfCardView HasShadow="True" Opacity=".9" BorderWidth=".05" BorderColor="#5d6770"  ShadowColor="#5d6770" BackgroundColor="White" Margin="0,6,0,6" CornerRadius="8"  IndicatorColor="Red" IndicatorPosition="Left" IndicatorThickness="5" >
                                              
                                                            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Padding="12" >
                                                                <Grid ColumnSpacing="0" RowSpacing="0"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White" >
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="auto" />
                                                                        <ColumnDefinition Width="auto" />


                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="auto" />
                                                                        <RowDefinition Height="auto" />
                                                                        <RowDefinition Height="auto" />
                                                                        <RowDefinition Height="auto" />

                                                                    </Grid.RowDefinitions>

                                                            <Label  Margin="0" 
                                  
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                           >
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.ZTEReportReportNumber}"></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding ReportNumber}" FontAttributes="None"></Span> 
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>


                                                            <Label  Margin="0" 
                                  
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                                           >
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}"   Text="{x:Static local:AppResources.ZTEReportReportDate}"></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text=" : "></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNewEn}"  Text="{Binding ReceivedDate}"></Span>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>


                                                  

                                                            <Label  Margin="0" 
                                  
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                                           >
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span  Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.ZTERReportDetailFacilityName}"></Span>
                                                                        <Span  Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding CompanyName}"></Span>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                    
                                                            <Label  Margin="0" 
                                  
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                                           >
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.ZTEReportReportStatus}"></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding ReportStatusMessage}"></Span>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                          


                                                                </Grid>
                                                            </StackLayout>
                                                        
                                            </cards:SfCardView>
                                                </ViewCell>
                                        <!--
                                            

                                                <ContentView>
                                                   

                                                </ContentView>
                                            -->
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackLayout>
                            <local1:CustomLabel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="{x:Static local:AppResources.Nodataavailable}" Style="{StaticResource MiniBlackLabelStyle}"  HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding SetNoDataLabelVisibility}">
                            </local1:CustomLabel>







                        </Grid>
                    </tabview:SfTabItem.Content>
                </tabview:SfTabItem>
