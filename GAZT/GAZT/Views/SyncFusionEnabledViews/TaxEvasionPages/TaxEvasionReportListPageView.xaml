<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:EGAZT;assembly:GAZT" 
             xmlns:local1="clr-namespace:GAZT" 
              xmlns:tabview="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms"
             Title="{x:Static local:AppResources.ZTEReportReportScreenTitle}"
              xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:core="clr-namespace:Syncfusion.XForms.Core;assembly=Syncfusion.Core.XForms"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.TaxEvasionReportList.TaxEvasionReportListPageView"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
                 xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
               NavigationPage.HasNavigationBar="False"
            BackgroundColor="White"><!--NavigationPage.HasNavigationBar="False"-->
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <controls:TitleView Title="{x:Static local:AppResources.ZTEReportReportScreenTitle}"  FontSize="14"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.GoBackClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="#006450"
                            Style="{StaticResource IconButtonStyle}"
                             Text="{DynamicResource StyleReverseBack}"
                             />
                    </controls:TitleView.LeadingView>
                    <controls:TitleView.TrailingView>
                        <Image Source="{TemplateBinding BindingContext.AddIcon}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.AddButtonClicked}"></TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>
                    </controls:TitleView.TrailingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <!--<ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="ic_add1.png"  
                Priority="2" Order="Primary" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>-->
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <tabview:SfTabView Margin="0,0,0,2" x:Name="simTab" VisibleHeaderCount="2" >
            <tabview:SfTabView.SelectionIndicatorSettings>
                <tabview:SelectionIndicatorSettings
                    Color="DarkGreen" 
                    Position="Bottom" 
                    StrokeThickness="2"/>
            </tabview:SfTabView.SelectionIndicatorSettings>
            <tabview:SfTabView.Items>
                <tabview:SfTabItem Title="{x:Static local:AppResources.ZTEReportReportOpen}"   
                             TitleFontSize="14"
                            SelectionColor="DarkGreen"
                             FontIconFontColor="#FF00AFF0"
                                    TitleFontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                             TitleFontColor="Gray">
                    <tabview:SfTabItem.Content>
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0" RowSpacing="10" x:Name="MainLayout">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="12*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="33*" />
                                <ColumnDefinition Width="34*" />
                                <ColumnDefinition Width="33*" />
                            </Grid.ColumnDefinitions>
                            <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                                <ListView Margin="0,10,0,0"  IsVisible="{Binding IsCertificateAvailable}" ItemsSource ="{Binding TERListReportbymobno}" VerticalOptions="FillAndExpand" x:Name="CertificateLst" ItemTapped="CertificateLst_ItemTapped" HasUnevenRows="true" SelectedItem="{Binding SelectedTaxEvasionListItem}" BackgroundColor="Transparent" SeparatorVisibility="None">
                                    <x:Arguments>
                                        <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                                    </x:Arguments>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <cards:SfCardView HasShadow="True" Opacity=".9" BorderWidth=".05" BorderColor="#5d6770"  ShadowColor="#5d6770" BackgroundColor="White" Margin="10" CornerRadius="8"  IndicatorColor="#AA0C19" IndicatorPosition="Left" IndicatorThickness="5" >
                                                            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Padding="12"  >
                                                                <Grid ColumnSpacing="0" RowSpacing="0"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White" >
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="auto" />
                                                                        <ColumnDefinition Width="auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="auto" />
                                                                        <RowDefinition Height="auto" />
                                                                        <RowDefinition Height="auto" />
                                                                        <RowDefinition Height="auto" />
                                                                    </Grid.RowDefinitions>
                                                            <local1:CustomLabel  Margin="0" 
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                           >
                                                                <local1:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}" 
 FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
  Text="{x:Static local:AppResources.ZTEReportReportNumber}"></Span>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}"
 FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
 Text=" : "></Span>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNewEn}"   FontFamily="{StaticResource SSTArabicMedium}" Text="{Binding ReportNumber}" FontAttributes="None"></Span>
                                                                    </FormattedString>
                                                                </local1:CustomLabel.FormattedText>
                                                            </local1:CustomLabel>
                                                            <local1:CustomLabel  Margin="0" 
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                                           >
                                                                <local1:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}" 
 FontFamily="{StaticResource GAZT_FONT_MEDIUM }"
  Text="{x:Static local:AppResources.ZTEReportReportDate}"></Span>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}" 
 FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
 Text=" : "></Span>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNewEn}"  FontFamily="{StaticResource SSTArabicMedium}" Text="{Binding ReceivedDate}"></Span>
                                                                    </FormattedString>
                                                                </local1:CustomLabel.FormattedText>
                                                            </local1:CustomLabel>
                                                            <local1:CustomLabel  Margin="0" 
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                                           >
                                                                <local1:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                                <Span  Style="{StaticResource MicroGrayLabelStyleNew}" 
 FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
  Text="{x:Static local:AppResources.ZTERReportDetailFacilityName}"></Span>
                                                                                <Span  Style="{StaticResource MicroGrayLabelStyleNew}" 
 FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
 Text=" : "></Span>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNewEn}"  FontFamily="{StaticResource SSTArabicMedium}" Text="{Binding CompanyName}"></Span>
                                                                    </FormattedString>
                                                                </local1:CustomLabel.FormattedText>
                                                            </local1:CustomLabel>
                                                            <local1:CustomLabel  Margin="0" 
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                                           >
                                                                <local1:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Text="{x:Static local:AppResources.ZTEReportReportStatus}"></Span>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Text=" : "></Span>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNewEn}"  FontFamily="{StaticResource SSTArabicMedium}" Text="{Binding ReportStatusMessageNewTObIND}"></Span>
                                                                    </FormattedString>
                                                                </local1:CustomLabel.FormattedText>
                                                            </local1:CustomLabel>
                                                                </Grid>
                                                            </StackLayout>
                                            </cards:SfCardView>
                                                </ViewCell>
                                        <!--
                                                <ContentView>
                                                </ContentView>
                                            -->
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackLayout>
                                    <local1:CustomLabel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Text="{x:Static local:AppResources.Nodataavailable}" Style="{StaticResource MiniBlackLabelStyle}"  HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding SetNoDataLabelVisibilityforOpen}">
                            </local1:CustomLabel>
                        </Grid>
                    </tabview:SfTabItem.Content>
                </tabview:SfTabItem>
                <tabview:SfTabItem Title="{x:Static local:AppResources.ZTEReportReportClosed}"   
