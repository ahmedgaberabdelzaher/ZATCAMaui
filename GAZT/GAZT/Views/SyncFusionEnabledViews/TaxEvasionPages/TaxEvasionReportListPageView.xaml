                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                           >
                                                                <local1:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}"   FontSize="12" Text="{x:Static local:AppResources.ZTEReportReportNumber}"></Span>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}"  FontSize="12" Text=" : "></Span>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" FontSize="12" Text="{Binding ReportNumber}" FontAttributes="None"></Span>
                                                                    </FormattedString>
                                                                </local1:CustomLabel.FormattedText>
                                                            </local1:CustomLabel>
                                                            <local1:CustomLabel  Margin="0" 
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                                           >
                                                                <local1:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}" FontSize="12"   Text="{x:Static local:AppResources.ZTEReportReportDate}"></Span>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}" FontSize="12" Text=" : "></Span>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" FontSize="12" Text="{Binding ReceivedDate}"></Span>
                                                                    </FormattedString>
                                                                </local1:CustomLabel.FormattedText>
