            </local1:CustomLabel>-->
                            <!--<StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" BackgroundColor="#005e4b">
                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="10" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="33*" />
                                        <ColumnDefinition Width="34*" />
                                        <ColumnDefinition Width="33*" />
                                    </Grid.ColumnDefinitions>
                                    <StackLayout Grid.Row="0" Grid.Column="0" HorizontalOptions="CenterAndExpand" VerticalOptions="Start" Spacing="0">
                                        -->
                            <!--<Image Source="ic_checkbox.png" HorizontalOptions="Center" >
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnVATCertificateClicked}" />
                    </Image.GestureRecognizers>
                </Image>-->
                            <!--
                                        <local1:CustomLabel Text="{x:Static local:AppResources.ZTEReportReportOpen}" Style="{DynamicResource searchBarStyleForZakat}"  HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" VerticalOptions="FillAndExpand" VerticalTextAlignment="Start">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="TapGestureRecognizer_ForOpenReports" Command="{Binding OnOpenClicked_Tapped}" />
                                            </Label.GestureRecognizers>
                                        </local1:CustomLabel>
                                    </StackLayout>
                                    <StackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="CenterAndExpand" VerticalOptions="Start" Spacing="0">
                                        -->
                            <!--<Image Source="ic_checkbox.png" HorizontalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnZakatCertificateClicked}" />
                    </Image.GestureRecognizers>
                </Image>-->
                            <!--
                                        <local1:CustomLabel  Text="{x:Static local:AppResources.ZTEReportReportClosed}" Style="{DynamicResource searchBarStyleForVAT}"  HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" VerticalOptions="FillAndExpand" VerticalTextAlignment="Start">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="TapGestureRecognizer_ForClosedReports" Command="{Binding OnCloseClicked_Tapped}" />
                                            </Label.GestureRecognizers>
                                        </local1:CustomLabel>
                                    </StackLayout>
                                    -->
                            <!--<StackLayout Grid.Row="0" Grid.Column="2" HorizontalOptions="CenterAndExpand" VerticalOptions="Start" Spacing="0">
                        -->
                            <!--<Image Source="ic_checkbox.png" HorizontalOptions="Center">
                     <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnExciseCertificateClicked}" />
                    </Image.GestureRecognizers>
                </Image>-->
                            <!--<local1:CustomLabel  Text="{x:Static local:AppResources.ExciseCertificates}" Style="{DynamicResource searchBarStyleForExcise}"  HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" VerticalOptions="FillAndExpand" VerticalTextAlignment="Start">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer   Command="{Binding OnExciseCertificateClicked}" />
                            </Label.GestureRecognizers>
                        </local1:CustomLabel>-->
