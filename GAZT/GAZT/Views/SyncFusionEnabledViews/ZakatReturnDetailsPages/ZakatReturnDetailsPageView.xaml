<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
              xmlns:custom="clr-namespace:GAZT"
              xmlns:local="clr-namespace:EGAZT;assembly:GAZT"
             xmlns:local1="clr-namespace:GAZT"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:converter="clr-namespace:GAZTeServicesApp.Converters"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.ZakatReturnDetails_View.ZakatReturnDetailsPageView"
              Title="{x:Static local:AppResources.ZZakatReturnDetails}"
            FlowDirection="RightToLeft"
             NavigationPage.HasNavigationBar="False"
            BackgroundColor="White" >
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:BooleanToColorConverter x:Key="ColorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <controls:TitleView Title="{x:Static local:AppResources.ZZakatReturnDetails}"  FontSize="14"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.GoBackClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="#006450"
                            Style="{StaticResource IconButtonStyle}"
                             Text="{DynamicResource StyleReverseBack}"
                             />
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <!--<ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">-->
           <ScrollView>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                 <Grid.RowDefinitions>
                        <RowDefinition Height="70*"/>
                        <RowDefinition Height="30*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White">
                <Grid BindingContext="{Binding ZakatReturnDetail}" Grid.Row="0" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40*"/>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="10*"/>
                    </Grid.ColumnDefinitions>
                    <Frame Grid.Row="0" Grid.Column="0"  Style="{StaticResource GAZTFrameStyleEntryForLableBackground}"  Grid.ColumnSpan="3" >
                    </Frame>
                    <Label Text="{x:Static local:AppResources.ZSummaryofZakatcalculation}"   VerticalOptions="Center" HorizontalOptions="CenterAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" >
                    </Label>
                        <Label Text="{x:Static local:AppResources.FiscalYear}"  Grid.Row="1"   HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}" FontFamily="{StaticResource GAZT_FONT_BOLD}"/>
                    <Label Text="{Binding Persl}" FontFamily="{StaticResource SSTArBold}" Grid.Row="2" Grid.Column="0"   Grid.ColumnSpan="2" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"   Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" />
                    <Label Text="{x:Static local:AppResources.FinancialPeriodFrom}" Grid.Row="3" HorizontalOptions="StartAndExpand"  VerticalOptions="CenterAndExpand" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}" FontFamily="{StaticResource GAZT_FONT_BOLD}"/>


                    <StackLayout  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">

                        <!--<Label x:Name="date" FontFamily="{StaticResource SSTArBold}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"   Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>-->

                        <local1:CustomLabel
                                   Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                                   VerticalOptions="CenterAndExpand"
                                                        HorizontalOptions="StartAndExpand"
                                                    Margin="10,0,10,0"
                                                    FlowDirection="LeftToRight"
                                                        LineBreakMode="CharacterWrap"
                                                           FontFamily="{StaticResource SSTArabicMedium}"
                                                 x:Name="date"
                                                          >
                                                    </local1:CustomLabel>
                    </StackLayout>


                     



                    <Label Text="{x:Static local:AppResources.ZReturnReferenceNumber}"  Grid.Row="5" HorizontalOptions="StartAndExpand"  VerticalOptions="CenterAndExpand" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}" FontFamily="{StaticResource GAZT_FONT_BOLD}"/>
                    <Label Text="{Binding Fbnum}" FontFamily="{StaticResource SSTArBold}" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"   Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>
                    <BoxView  Grid.Row="7"  Grid.Column="0" Grid.ColumnSpan="3"  Style="{StaticResource GAZTBoxViewStyle}" ></BoxView>
                        <local1:CustomLabel Text="{x:Static local:AppResources.ZZEstimatedSalesForFiscalYear}" Grid.Row="8" Grid.Column="0"  HorizontalOptions="StartAndExpand" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center"   Style="{StaticResource GAZTGoldLabelStyleForSmallFont}" FontFamily="{StaticResource GAZT_FONT_BOLD}">
                    </local1:CustomLabel>
                    <Label  Grid.Row="8" Grid.Column="1" FontFamily="{StaticResource SSTArBold}"   HorizontalOptions="StartAndExpand" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center"   Style="{StaticResource GAZTGrayLabelStyleForSmallFont}">
                        <Label.FormattedText>
                                    <FormattedString>
                                      <Span Text="{Binding Estsl}"/>
                                          <Span Text=" "/>
                                        <Span Text="{x:Static local:AppResources.ZSAR}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                    </Label>
                    <!--<Image Source="ic_info.png" Grid.Column="2" Grid.Row="8" HorizontalOptions="Start" VerticalOptions="Center">
                        <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                Tapped="OnInformationMessageClickedOne"
                NumberOfTapsRequired="1" />
                                                </Image.GestureRecognizers>
                    </Image>-->
                        <Label
                       Grid.Column="2" Grid.Row="8"
                        Margin="0,0,0,2"
                        Style="{StaticResource IconLabelStyleVAT}"
                         TextColor="#005e4b"
                        Text="{StaticResource Help}" >
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInformationMessageClickedOne" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="{x:Static local:AppResources.Capital}" Grid.Row="9" Grid.Column="0"  HorizontalOptions="StartAndExpand" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center"   Style="{StaticResource GAZTGoldLabelStyleForSmallFont}" FontFamily="{StaticResource GAZT_FONT_BOLD}"/>
                    <Label Text="{Binding Cpamt}" FontFamily="{StaticResource SSTArBold}" Grid.Row="9" Grid.Column="1"    HorizontalOptions="Start" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center"    Style="{StaticResource GAZTGrayLabelStyleForSmallFont}">
                        <Label.FormattedText>
                                    <FormattedString>
                                      <Span Text="{Binding Cpamt}" />
                                          <Span Text=" "/>
                                        <Span Text="{x:Static local:AppResources.ZSAR}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                    </Label>
                    <!--<Image Source="ic_info.png" Grid.Column="2" Grid.Row="9" HorizontalOptions="Start" VerticalOptions="Center">
                         <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                Tapped="OnInformationMessageClickedTwo"
                NumberOfTapsRequired="1" />
                                                </Image.GestureRecognizers>
                    </Image>-->
                        <Label
                       Grid.Column="2" Grid.Row="9"
                        Margin="0,0,0,2"
                        Style="{StaticResource IconLabelStyleVAT}"
                         TextColor="#005e4b"
                        Text="{StaticResource Help}" >
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInformationMessageClickedTwo" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="{x:Static local:AppResources.ZakatBase}" Grid.Row="10" Grid.Column="0"  HorizontalOptions="StartAndExpand" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center"  Style="{StaticResource GAZTGoldLabelStyleForSmallFont}" FontFamily="{StaticResource GAZT_FONT_BOLD}"/>
                    <Label Text="{Binding Zbamt}" FontFamily="{StaticResource SSTArBold}" Grid.Row="10" Grid.Column="1"    HorizontalOptions="StartAndExpand" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center"   Style="{StaticResource GAZTGrayLabelStyleForSmallFont}">
                         <Label.FormattedText>
                                    <FormattedString>
                                      <Span Text="{Binding Zbamt}"/>
                                          <Span Text=" "/>
                                        <Span Text="{x:Static local:AppResources.ZSAR}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                    </Label>
                    <!--<Image Source="ic_info.png" Grid.Column="2" Grid.Row="10" HorizontalOptions="Start" VerticalOptions="Center">
                         <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                Tapped="OnInformationMessageClickedThree"
                NumberOfTapsRequired="1" />
                                                </Image.GestureRecognizers>
                    </Image>-->
                        <Label
                       Grid.Column="2" Grid.Row="10"
                        Margin="0,0,0,2"
                        Style="{StaticResource IconLabelStyleVAT}"
                         TextColor="#005e4b"
                        Text="{StaticResource Help}" >
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInformationMessageClickedThree" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="{x:Static local:AppResources.ZakatAmount}" Grid.Row="11" Grid.Column="0"  HorizontalOptions="StartAndExpand" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center"   Style="{StaticResource GAZTGoldLabelStyleForSmallFont}" FontFamily="{StaticResource GAZT_FONT_BOLD}"/>
                    <Label Text="{Binding Zkamt}" FontFamily="{StaticResource SSTArBold}" Grid.Row="11" Grid.Column="1"    HorizontalOptions="StartAndExpand" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center"   Style="{StaticResource GAZTGrayLabelStyleForSmallFont}">
                         <Label.FormattedText>
                                    <FormattedString>
                                      <Span Text="{Binding Zkamt}"/>
                                          <Span Text=" "/>
                                        <Span Text="{x:Static local:AppResources.ZSAR}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                    </Label>
                    <!--<Image Source="ic_info.png" Grid.Column="2" Grid.Row="11" HorizontalOptions="Start" VerticalOptions="Center">
                         <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                Tapped="OnInformationMessageClickedFour"
                NumberOfTapsRequired="1" />
                                                </Image.GestureRecognizers>
                    </Image>-->
                        <Label
                       Grid.Column="2" Grid.Row="11"
                        Margin="0,0,0,2"
                        Style="{StaticResource IconLabelStyleVAT}"
                         TextColor="#005e4b"
                        Text="{StaticResource Help}" >
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInformationMessageClickedFour" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
 </ScrollView>
                <!--<StackLayout Orientation="Horizontal"  Grid.Row="1" Grid.Column="0"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0,5,0,5" Padding="0" >
                        <Grid Style="{DynamicResource GridStyle}" ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" BackgroundColor="White" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Text="{x:Static local:AppResources.SalesDetails}" Command="{Binding OnSalesDetailsClicked}" Grid.Row="0" Grid.Column="0" Style="{StaticResource GAZTVerifyButton}" IsVisible="{Binding SalesDetailsAndReleaseButtonVisibility}"  ></Button> --><!--Command="{Binding OnSalesDetailsClicked}"--><!--
                            <Button Text="{Binding ReleaseOrBillDetailsButtonText}" Clicked="OnBillsButtonClicked" Grid.Row="0" Grid.Column="1"  Style="{StaticResource GAZTVerifyButton}" IsVisible="{Binding SalesDetailsAndReleaseButtonVisibility}" ></Button> --><!--Command="{Binding OnBillsButtonClicked}"--><!--
                        </Grid>
                    </StackLayout>-->
                    <StackLayout Grid.Column="0" Grid.Row="1" Orientation="Vertical" VerticalOptions="EndAndExpand" Spacing="1">
                        <buttons:SfButton Text="{x:Static local:AppResources.SalesDetails}" Command="{Binding OnSalesDetailsClicked}"  Style="{StaticResource SfButtonStyle}" Margin="0" CornerRadius="0" Padding="0" HeightRequest="56" IsVisible="{Binding SalesDetailsAndReleaseButtonVisibility}" BackgroundColor="#006450"
                     FontFamily="{StaticResource GAZT_FONT_BOLD}" FontSize="14"></buttons:SfButton>

                        <buttons:SfButton Text="{x:Static local:AppResources.ChangeFromEstimateToAccountingBasis}" Command="{Binding OnChangeFromEstimateToAccountingBasisButtonClicked}"  Style="{StaticResource SfButtonStyle}" Margin="0" CornerRadius="0" Padding="0" HeightRequest="56"  BackgroundColor="#006450"
                     FontFamily="{StaticResource GAZT_FONT_BOLD}" FontSize="14" IsVisible="{Binding ChangeFromEstimateTAccountringBasisButtonVisibility}"></buttons:SfButton>


                       

                        <!--Command="{Binding OnSalesDetailsClicked}"-->
                        <buttons:SfButton Text="{Binding ReleaseOrBillDetailsButtonText}" Clicked="OnBillsButtonClicked"   Style="{StaticResource SfButtonStyle}" Margin="0" CornerRadius="0" Padding="0" HeightRequest="56" IsVisible="{Binding SalesDetailsAndReleaseButtonVisibility}" BackgroundColor="#006450"
                      FontFamily="{StaticResource GAZT_FONT_BOLD}" FontSize="14"></buttons:SfButton>
                        <!--Command="{Binding OnBillsButtonClicked}"-->
                         <buttons:SfButton Text="{x:Static local:AppResources.AmendReturn}" HorizontalOptions="FillAndExpand" VerticalOptions="Center"  Command="{Binding OnAmendReturnButtonClicked}"   Style="{StaticResource SfButtonStyle}" IsVisible="{Binding AmedmentButtonVisibility}" Margin="0" CornerRadius="0" Padding="0" HeightRequest="56"  BackgroundColor="#006450"
                      FontFamily="{StaticResource GAZT_FONT_BOLD}" FontSize="14"></buttons:SfButton>
                    </StackLayout>
                </Grid>
             <!-- Acticity indicator layout start -->
                <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}" VerticalOptions="FillAndExpand">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                     AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                       
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#006450"/>
                    </StackLayout>
                        <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                    </StackLayout>
            </Grid>
                <!-- Acticity indicator layout End -->
       </Grid>
            </ScrollView>
    </ContentPage.Content>
</ContentPage>