<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
               xmlns:custom="clr-namespace:GAZT"
             xmlns:local="clr-namespace:EGAZT;assembly:GAZT"
             xmlns:core="clr-namespace:Syncfusion.XForms.Core;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:converter="clr-namespace:GAZTeServicesApp.Converters"
             xmlns:gradient="clr-namespace:Syncfusion.XForms.Graphics;assembly=Syncfusion.Core.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class=" EGAZT.Views.SyncFusionEnabledViews.ChangePassword.ChangePasswordPageView"
             Title="{x:Static local:AppResources.ChangePassword}"
             Style="{StaticResource ContentPageStyle}"
              NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">
    <!--
                 Style="{StaticResource ContentPageStyle}"
    BackgroundImageSource="{core:OnPlatformOrientationStringValue Default=sf_LoginBackground.png,
                                                                  iOSPhoneLandscape=sf_LoginBackground-Landscape.png,
                                                                  iOSTabletLandscape=sf_LoginBackground-Landscape.png}"-->
    <ContentPage.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary>
                <ResourceDictionary Source="..\CommonStyle\Styles.xaml" />
            </ResourceDictionary>-->
            <converter:BooleanToColorConverter x:Key="ColorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid x:Name="ParentContainerForPassword">
            <Grid.RowDefinitions>
                <RowDefinition Height="100*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackLayout Grid.Row="0" Grid.Column="0">
                <custom:CustomLabel
                x:Name="BackLabel"
                       VerticalOptions="StartAndExpand"
                HorizontalOptions="StartAndExpand"
                        Margin="8,10,8,0"
                        Style="{StaticResource IconLabelStyle}"
                         TextColor="#ffffff"
                        Text="{DynamicResource StyleReverseBack}"
                >
                    <custom:CustomLabel.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackButtonClicked}"></TapGestureRecognizer>
                    </custom:CustomLabel.GestureRecognizers>
                </custom:CustomLabel>
                <gradient:SfGradientView Style="{StaticResource SfGradientViewStyle}" />
                <!--Margin="{core:OnPlatformOrientationThickness PhonePortrait='20,32',
                                                                 PhoneLandscape='150,32',
                                                                 TabletPortrait='200,50',
                                                                 TabletLandscape='300,50',
                                                                 Desktop='30'}"-->
                <StackLayout     WidthRequest="{OnPlatform Default='-1',
                                              UWP='350'}" HorizontalOptions="FillAndExpand" VerticalOptions="Center" Orientation="Vertical"  IsVisible="{Binding OTPLayoutVisibility}" BackgroundColor="Transparent" Padding="0,10,0,0">
                    <ScrollView HorizontalOptions="Center">
                        <ScrollView.VerticalOptions>
                            <OnIdiom
                        x:TypeArguments="LayoutOptions"
                        Default="CenterAndExpand"
                        Phone="FillAndExpand" />
                        </ScrollView.VerticalOptions>
                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86*"/>
                                <ColumnDefinition Width="14*"/>
                            </Grid.ColumnDefinitions>
                            <!--<Label Text="{x:Static local:AppResources.CurrentPassword}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" >
                    </Label>
                    <Frame Grid.Row="1" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                    </Frame>
                    <custom:GAZTBorderlessEntry x:Name="Password"  Grid.Row="1" Text="{Binding CurrentPassword}" Focused="OnPasswordFocused"  IsPassword="{Binding PasswordVisibilityForOldPassword}" TextColor="#7D858D"    Grid.Column="0"   Style="{StaticResource GAZTTextBoxStyleForEntry}">
                        <custom:GAZTBorderlessEntry.Behaviors>
                            <custom:AlphaNumericValidatorBehaviour/>
                        </custom:GAZTBorderlessEntry.Behaviors>
                    </custom:GAZTBorderlessEntry>
                    <Image Grid.Row="1"  Grid.Column="1"  Margin="0,0,0,0" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_TIN_Status.png"  >
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPasswordVisibilityClickedForOldPassword" />
                        </Image.GestureRecognizers>
                    </Image>-->
                            <Label Text="{x:Static local:AppResources.ChangePassword}" Margin="0,0,0,3" TextColor="#ffffff" Style="{StaticResource LabelStyle}" FontFamily="{StaticResource GAZT_FONT_BOLD}" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>
                            <inputLayout:SfTextInputLayout   x:Name="CurrentPasswordLayout" EnablePasswordVisibilityToggle="True" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
     Hint="{x:Static local:AppResources.CurrentPassword}"
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                <custom:GAZTBorderlessEntry Placeholder="{x:Static local:AppResources.CurrentPassword}" Text="{Binding CurrentPassword}" Focused="OnPasswordFocused" IsPassword="{Binding PasswordVisibilityForOldPassword}"  x:Name="Password"     FontSize="Small" TextColor="White"  >
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <custom:AlphaNumericValidatorBehaviour/>
                                    </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                            <!--<custom:CustomLabel
                      Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        HorizontalOptions="End" VerticalOptions="CenterAndExpand"
                        Margin="13,2,13,1"
                        Style="{StaticResource IconLabelStyle}"
                         TextColor="#005e4b"
                        Text="{StaticResource Edit}" >
                        <custom:CustomLabel.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPasswordVisibilityClickedForOldPassword"></TapGestureRecognizer>
                        </custom:CustomLabel.GestureRecognizers>
                    </custom:CustomLabel>-->
                            <!--<Label Text="{x:Static local:AppResources.NewPassword}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" >
                    </Label>
                    <Frame Grid.Row="3" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                    </Frame>
                    <custom:GAZTBorderlessEntry  Grid.Row="3" IsPassword="{Binding PasswordVisibilityForNewPassword}"  Grid.Column="0" IsEnabled="{Binding IsEnabledNewPasswordForEmail}" Text="{Binding NewPasswordForEmail}"  Style="{StaticResource GAZTTextBoxStyleForEntry}">
                        <custom:GAZTBorderlessEntry.Behaviors>
                            <custom:AlphaNumericValidatorBehaviour/>
                        </custom:GAZTBorderlessEntry.Behaviors>
                    </custom:GAZTBorderlessEntry>
                    <Image Grid.Row="3"  Grid.Column="1"  Margin="0,0,0,0" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_TIN_Status.png"  >
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPasswordVisibilityClickedForNewPassword" />
                        </Image.GestureRecognizers>
                    </Image>-->
                            <inputLayout:SfTextInputLayout   x:Name="NewPasswordLayout" EnablePasswordVisibilityToggle="True" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.NewPassword}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                <custom:GAZTBorderlessEntry IsPassword="{Binding PasswordVisibilityForNewPassword}"  Text="{Binding NewPasswordForEmail}"  x:Name="NewPassword" FontSize="Small" TextColor="White"  >
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <custom:AlphaNumericValidatorBehaviour/>
                                    </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                            <!--<custom:CustomLabel
                      Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        HorizontalOptions="End" VerticalOptions="CenterAndExpand"
                        Margin="13,2,13,1"
                        Style="{StaticResource IconLabelStyle}"
                         TextColor="#005e4b"
                        Text="{StaticResource Edit}" >
                        <custom:CustomLabel.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPasswordVisibilityClickedForNewPassword"></TapGestureRecognizer>
                        </custom:CustomLabel.GestureRecognizers>
                    </custom:CustomLabel>-->
                            <!--<Label Text="{x:Static local:AppResources.RetypePassword}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" >
                    </Label>
                    <Frame Grid.Row="5" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                    </Frame>
                    <custom:GAZTBorderlessEntry  Grid.Row="5" IsPassword="{Binding PasswordVisibilityForRetypePassword}"  Grid.Column="0" IsEnabled="{Binding IsEnabledRetypePasswordForEmail}" Text="{Binding RetypePasswordForEmail}"  Style="{StaticResource GAZTTextBoxStyleForEntry}">
                        <custom:GAZTBorderlessEntry.Behaviors>
                            <custom:AlphaNumericValidatorBehaviour/>
                        </custom:GAZTBorderlessEntry.Behaviors>
                    </custom:GAZTBorderlessEntry>
                    <Image Grid.Row="5"  Grid.Column="1"  Margin="0,0,0,0" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_TIN_Status.png">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPasswordVisibilityClickedForRetypePassword" />
                        </Image.GestureRecognizers>
                    </Image>-->
                            <inputLayout:SfTextInputLayout   x:Name="RetypePasswordLayout" EnablePasswordVisibilityToggle="True" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.RetypePassword}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                <custom:GAZTBorderlessEntry IsPassword="{Binding PasswordVisibilityForRetypePassword}"  Text="{Binding RetypePasswordForEmail}"  x:Name="RetypePasswordForEmail" FontSize="Small" TextColor="White"  >
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <custom:AlphaNumericValidatorBehaviour/>
                                    </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                            <!--<custom:CustomLabel
                      Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                        HorizontalOptions="End" VerticalOptions="CenterAndExpand"
                        Margin="13,2,13,1"
                        Style="{StaticResource IconLabelStyle}"
                         TextColor="#005e4b"
                        Text="{StaticResource Edit}" >
                        <custom:CustomLabel.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPasswordVisibilityClickedForRetypePassword"></TapGestureRecognizer>
                        </custom:CustomLabel.GestureRecognizers>
                    </custom:CustomLabel>-->
                            <!--<Button Text="{x:Static local:AppResources.Verify}" VerticalOptions="EndAndExpand" Command="{Binding OnChangeEmailSubmitButtonClicked}" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GAZTVerifyButton}"></Button>-->
                        </Grid>
                    </ScrollView>
                </StackLayout>
                <StackLayout  VerticalOptions="EndAndExpand" Margin="0" Padding="0"  Orientation="Vertical">
                    <buttons:SfButton
                    Margin="0"
                    VerticalOptions="EndAndExpand"
                HorizontalOptions="FillAndExpand"
                   BackgroundColor="#D99A29"
                   FontFamily="{StaticResource GAZT_FONT_BOLD}"
                    HeightRequest="56"
                    CornerRadius="0"
                  Command="{Binding OnChangeEmailSubmitButtonClicked}"
                    IsEnabled="{Binding IsVerifyOTPEnabled}"
                    Text="{x:Static local:AppResources.Verify}"
                    TextColor="{DynamicResource Gray-White}"
                     />
                </StackLayout>
                <!-- Acticity indicator layout start -->
                <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.7" VerticalOptions="FillAndExpand">
                    </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <ActivityIndicator IsVisible="true" IsRunning="true" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Color="White" />
                            <Label Text="{x:Static local:AppResources.ActivityIndicatorTitle}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" />
                        </StackLayout>
                    </StackLayout>
                </Grid>
                <!-- Acticity indicator layout End -->
            </StackLayout>
            <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                      AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                       
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                     TextColor="#d99a29"/>

                        <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>