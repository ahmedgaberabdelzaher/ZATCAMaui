<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="GAZT.Views.NewViews.VATLookupPageView"
             xmlns:local="clr-namespace:GAZT;assembly:GAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             Title="{x:Static local:AppResources.VATLookup}"
             >
    <ContentPage.Content>
        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                    <Grid Grid.Row="0" Grid.Column="0" RowSpacing="5" Padding="0,15,0,0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="90*"/>
                            <RowDefinition Height="10*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0" RowSpacing="5" Padding="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                               
                            </Grid.ColumnDefinitions>
                                <custom:CustomLabel  Margin="10,5,10,5" Grid.Row="0" Grid.Column="0"  HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static local:AppResources.ZStepsTitle}" Style="{StaticResource MicroGrayLabelStyleNew}"></Span>
                                            <Span Text="&#10;"/>
                                            <Span Text="{x:Static local:AppResources.ZStepOne}" Style="{StaticResource MicroGrayLabelStyleNewEn}"></Span>
                                            <Span Text="&#10;"/>
                                            <Span Text="{x:Static local:AppResources.ZStepTwo}" Style="{StaticResource MicroGrayLabelStyleNewEn}"></Span>
                                            <Span Text="&#10;"/>
                                            <Span Text="{x:Static local:AppResources.ZStepThree}" Style="{StaticResource MicroGrayLabelStyleNewEn}"></Span>
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                            
                         

                            <inputLayout:SfTextInputLayout  Margin="10,-6,10,0" 
    Hint="{x:Static local:AppResources.ZSearchParameter}" HelperText="{x:Static local:AppResources.ZZZRequired}"
    ContainerType="Outlined"  Grid.Row="1" Grid.Column="0"  UnfocusedColor="#B1B1B1" x:Name="frmSearchParameter"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                                <custom:BorderlessEntry Text="{Binding TxtSearchParameter}" Focused="OnParameterTypeEntryEntryFocussed" IsEnabled="False" IsSpellCheckEnabled="False" FontSize="Small">
                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                            <custom:CustomButton x:Name="PPicker_btn" Clicked="PPicker_btn_Clicked" FontSize="Small" BackgroundColor="Transparent" Grid.Row="1" Grid.Column="0"  Grid.ColumnSpan="2" Margin="10,0,10,0"  >
                            </custom:CustomButton>
                            <syncfusion:SfPicker x:Name="PPicker"
                    HeaderHeight="40"
                    ShowHeader="true"
                    HeaderText="{x:Static local:AppResources.ZSearchParameter}"
                    ShowColumnHeader="True"
                   
                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"
                                SelectedItemFontSize="12"               
                   ItemHeight="40"
                    ItemsSource="{Binding ParameterTypeList}" OkButtonClicked="SelectedParametes_OkayButtonClicked" Focused="OnParameterTypeEntryEntryFocussed"  DisplayMemberPath="ParameterType"   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,0"
                    PickerHeight="280"
                    PickerWidth="270"
                    ShowFooter="True" FooterHeight="46">
                                <syncfusion:SfPicker.Behaviors>
                                    <custom1:SfPickerBehavior />
                                </syncfusion:SfPicker.Behaviors>
                            </syncfusion:SfPicker>
                             <!--<custom:CustomButton x:Name="btn1" Clicked="btn1_Clicked" FontSize="Small" BackgroundColor="Transparent" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,0" >
                            </custom:CustomButton>-->
                           
                            <inputLayout:SfTextInputLayout  Grid.Row="2" Grid.Column="0" Margin="10,-6,10,0" 
    Hint="{x:Static local:AppResources.ZPleaseenterthecorrespondingnumber}" x:Name="frmLookupNumner"
    ContainerType="Outlined" UnfocusedColor="#B1B1B1" 
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False"    HelperText="{x:Static local:AppResources.ZZZRequired}">
                                <custom:BorderlessEntry x:Name="entryNumber" Text="{Binding LookupNumber}" FontSize="Small"     MaxLength="{Binding MaxDigids}">
                                    <Entry.Behaviors>

                                        <custom1:OnlyNumericValuesBehaviour/>

                                    </Entry.Behaviors>
                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>




                            <!--<Label Grid.Row="5"  Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start" >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.Captcha}" />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>


                    
                     



                        <Grid Grid.Row="6"   Grid.Column="0"  Grid.ColumnSpan="2" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>

                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>
                            <Frame  Grid.Row="0"   Grid.Column="0"    Style="{StaticResource GAZTFrameStyleForEntry}">
                            </Frame>
                            <Frame  Grid.Row="0"   Grid.Column="1"    Style="{StaticResource GAZTFrameStyleForEntry}">
                            </Frame>

                            <custom:GAZTBorderlessEntry  Grid.Row="0"  Grid.Column="0" Text="{Binding EnteredCaptchaValue}" Placeholder="{x:Static local:AppResources.Captcha}"  Style="{StaticResource GAZTTextBoxStyleForEntry}"  HorizontalTextAlignment="Center" >
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <custom:CaptchaValidatorBehaviour/>
                                </custom:GAZTBorderlessEntry.Behaviors>

                            </custom:GAZTBorderlessEntry>
                            <Label  Grid.Row="0"  Grid.Column="1" Text="{Binding Captcha}" HorizontalOptions="CenterAndExpand" Style="{StaticResource MediumGoldLabelStyle}" VerticalOptions="CenterAndExpand" ></Label>
                            <Image Grid.Row="0"  Grid.Column="1"   Source="ic_sync_captcha.png" Aspect="AspectFit" HorizontalOptions="End" VerticalOptions="Center" Margin="13,0,13,0">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OnCaptchaRegenerateClicked}" />
                                </Image.GestureRecognizers>
                            </Image>

                        </Grid>-->

                            <!--<Grid   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>


                            <Frame  Grid.Row="1"   Grid.Column="1"    Style="{StaticResource GAZTFrameStyleForEntry}" CornerRadius="9" Margin="5,2,10,10">
                            </Frame>


                            <inputLayout:SfTextInputLayout  Grid.Row="1"  Grid.Column="0" Margin="10,-6,5,-6"
    Hint="{x:Static local:AppResources.Captcha}"  
    ContainerType="Outlined" x:Name="FrmEnteredCaptcha" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                                <Entry Text="{Binding EnteredCaptchaValue}" FontSize="Small">
                                    <Entry.Behaviors>
                                        <custom:CaptchaValidatorBehaviour/>
                                    </Entry.Behaviors>
                                </Entry>
                            </inputLayout:SfTextInputLayout>
                            <Label  Grid.Row="1"  Grid.Column="1" Text="{Binding Captcha}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Style="{StaticResource MediumGoldLabelStyle}" Margin="0,0,0,5" ></Label>


                            <Image Grid.Row="1"  Grid.Column="1"   Source="ic_sync_captcha.png" Aspect="AspectFit" HorizontalOptions="End" VerticalOptions="Center" Margin="13,0,13,0">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OnCaptchaRegenerateClicked}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>-->


                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="Start" Grid.Row="3" Grid.Column="0"  Orientation="Horizontal" HeightRequest="50" Padding="0,10,0,0">

                                <Grid Grid.Row="0" Grid.Column="0" RowSpacing="5" Padding="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>

                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50*"/>
                                        <ColumnDefinition Width="50*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Text="{x:Static local:AppResources.Name}"  Margin="10,0,10,0" Style="{StaticResource MicroGrayLabelStyleNew}"  HorizontalOptions="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center">
                                    </Label>
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Name}" HorizontalOptions="Start" Style="{StaticResource GAZTSmallGreenLabelStyleForSteps}"  x:Name="lbResult"  Margin="10,0,10,0" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center"/>

                                </Grid>

                            </StackLayout>
                        </Grid>
                        <Button Text="{x:Static local:AppResources.ZSearch}" x:Name="btnSubmit" Clicked="btnSubmit_Clicked" Style="{StaticResource GAZTVerifyButton}" Grid.Row="1" Grid.Column="0" CornerRadius="0" Margin="0" Padding="0"  VerticalOptions="EndAndExpand" ></Button>

                    </Grid>

                    <!-- Acticity indicator layout start -->
                    <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                        <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.7" VerticalOptions="FillAndExpand">
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                <ActivityIndicator IsVisible="true" IsRunning="true" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Color="White" />
                                <Label Text="{x:Static local:AppResources.ActivityIndicatorTitle}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" />
                            </StackLayout>
                        </StackLayout>
                    </Grid>

                    <!-- Acticity indicator layout end -->
                </Grid>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>