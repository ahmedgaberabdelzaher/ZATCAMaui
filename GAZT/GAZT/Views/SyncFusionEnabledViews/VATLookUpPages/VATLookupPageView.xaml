<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
               xmlns:custom="clr-namespace:GAZT"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:local="clr-namespace:EGAZT;assembly:GAZT"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:local1="clr-namespace:GAZT" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             Title="{x:Static local:AppResources.VATLookup}"
              x:Class="EGAZT.Views.SyncFusionEnabledViews.VATLookup.VATLookupPageView"
              NavigationPage.HasNavigationBar="False"
     BackgroundColor="#005e4b">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <!--<StackLayout Spacing="0" BackgroundColor="White">
                --><!--  Title View VATLookup ZZZVatLookUpTitleTextNew--><!--
                <controls:TitleView Title="{x:Static local:AppResources.ZZZVatLookUpTitleTextNew}"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="Transparent">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.OnBackButtonClicked}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="#006450"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                             />
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>-->
            <Grid>
                <StackLayout>
                    <Grid Padding="0,5,0,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static local:AppResources.ZZZVatLookUpTitleTextNew}" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" FontSize="Large" />
                        <Label Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}"  Style="{StaticResource IconLabelStyle}" Text="{DynamicResource StyleReverseBack}" TextColor="White" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer      Command="{TemplateBinding BindingContext.BackButtonClicked}" ></TapGestureRecognizer>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <yummy:PancakeView  BackgroundColor="Black" CornerRadius="32,32,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,15,0,0" BackgroundColor="White" x:Name="VATRMainGrid">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="10*" />
                                <RowDefinition Height="90*" />

                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="1" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content >
        <Grid BackgroundColor="White" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" RowSpacing="0" x:Name="MainLayout" >
            <Grid.RowDefinitions>
                <RowDefinition Height="90*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <StackLayout VerticalOptions="FillAndExpand" Grid.Row="0" Spacing="0" BackgroundColor="White">
                <ScrollView BackgroundColor="White" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                    <Grid  RowSpacing="5" Padding="0,5,0,0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <custom:CustomLabel  Margin="10,5,10,5" Grid.Row="0" Grid.Column="0"  HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <!--<Span Text="{x:Static local:AppResources.ZStepsTitleScan}" Style="{StaticResource MicroGrayLabelStyleNew}"></Span>-->
                                    <Span Text="{x:Static local:AppResources.ZStepsTitleScanNew}" Style="{StaticResource MicroGrayLabelStyleNew}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></Span>
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <!--<Label Text="{x:Static local:AppResources.ZZZIndividualInformation}"   Margin="10,5,10,5" VerticalOptions="Center"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="0" Grid.Column="0"  />-->
                        <buttons:SfButton
                    Margin="10,5,10,0"
                 CornerRadius="0"
                            x:Name="ScanCode_btn"
                            Clicked="ScanCode_btn_Clicked"
                            Grid.Row="1" Grid.Column="0"
                    HeightRequest="56"
                    HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center"
                    Style="{StaticResource SfButtonStyle}" BackgroundColor="#006450" Opacity="0.7"
                  Text="{x:Static local:AppResources.ZQRScanner}"
                   />
                        <!--<Label Text="{x:Static local:AppResources.ZZZIndividualInformation}"   VerticalOptions="Center"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />-->
                        <StackLayout Grid.Row="2" Grid.Column="0">
                            <custom:CustomLabel  Margin="10,5,10,0"   HorizontalOptions="Center" HorizontalTextAlignment="Start">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static local:AppResources.ZOR}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Style="{StaticResource MicroGrayLabelStyleNew}" LineHeight="{OnPlatform Android=1.25, Default = 1.25}"></Span>
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <custom:CustomLabel  Margin="10,5,10,5"   HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        
                            <!--<Span Text="{x:Static local:AppResources.ZOR}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Style="{StaticResource MicroGrayLabelStyleNew}" LineHeight="{OnPlatform Android=1.25, Default = 1.25}"></Span>-->
                            

                                        <Span Text="{x:Static local:AppResources.ZZZStepsTitleNew}" FontFamily="{StaticResource SSTArabicMedium}" Style="{StaticResource MicroGrayLabelStyleNew}" LineHeight="{OnPlatform Android=1.25, Default = 1.25}"></Span>
                                        <Span Text="&#10;"/>
                                        <Span Text="1. " Style="{StaticResource MicroGrayLabelStyleNewEn}" FontFamily="{StaticResource SSTArabicMedium}" LineHeight="{OnPlatform Android=1.25, Default = 1.25}"></Span>
                                        <Span Text="{x:Static local:AppResources.ZZZStepOneNew}" Style="{StaticResource MicroGrayLabelStyleNewEn}" FontFamily="{StaticResource SSTArabicMedium}" LineHeight="{OnPlatform Android=1.25, Default = 1.25}"></Span>
                                        <Span Text="&#10;"/>
                                        <Span Text="2. " Style="{StaticResource MicroGrayLabelStyleNewEn}" FontFamily="{StaticResource SSTArabicMedium}" LineHeight="{OnPlatform Android=1.25, Default = 1.25}"></Span>
                                        <Span Text="{x:Static local:AppResources.ZZZStepTwoNew}" FontFamily="{StaticResource SSTArabicMedium}" Style="{StaticResource MicroGrayLabelStyleNewEn}" LineHeight="{OnPlatform Android=1.25, Default = 1.25}"></Span>
                                        <Span Text="&#10;"/>
                                        <Span Text="3. " Style="{StaticResource MicroGrayLabelStyleNewEn}" FontFamily="{StaticResource SSTArabicMedium}" LineHeight="{OnPlatform Android=1.25, Default = 1.25}"></Span>
                                        <Span Text="{x:Static local:AppResources.ZZZStepThreeNew}" Style="{StaticResource MicroGrayLabelStyleNewEn}" FontFamily="{StaticResource SSTArabicMedium}" LineHeight="{OnPlatform Android=1.25, Default = 1.25}"></Span>
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <!--<custom:CustomLabel  Margin="10,5,10,5"   HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        --><!--<Span Text="{x:Static local:AppResources.ZOR}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Style="{StaticResource MicroGrayLabelStyleNew}" LineHeight="{OnPlatform Android=1.25, Default = 1.25}"></Span>-->
                                        <!--<Span Text="&#10;"/>--><!--
                                        <Span Text="{x:Static local:AppResources.ZStepsTitle}" FontFamily="{StaticResource SSTArabicMedium}" Style="{StaticResource MicroGrayLabelStyleNew}" LineHeight="{OnPlatform Android=1.25, Default = 1.25}"></Span>
                                        <Span Text="&#10;"/>
                                        <Span Text="{x:Static local:AppResources.ZStepOne}" Style="{StaticResource MicroGrayLabelStyleNewEn}" FontFamily="{StaticResource SSTArabicMedium}" LineHeight="{OnPlatform Android=1.25, Default = 1.25}"></Span>
                                        <Span Text="&#10;"/>
                                        <Span Text="{x:Static local:AppResources.ZStepTwo}" FontFamily="{StaticResource SSTArabicMedium}" Style="{StaticResource MicroGrayLabelStyleNewEn}" LineHeight="{OnPlatform Android=1.25, Default = 1.25}"></Span>
                                        <Span Text="&#10;"/>
                                        <Span Text="{x:Static local:AppResources.ZStepThree}" Style="{StaticResource MicroGrayLabelStyleNewEn}" FontFamily="{StaticResource SSTArabicMedium}" LineHeight="{OnPlatform Android=1.25, Default = 1.25}"></Span>
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>-->

                        </StackLayout>
                        <inputLayout:SfTextInputLayout  Margin="10,-6,10,0" 
    Hint="{x:Static local:AppResources.ZSearchParameter}" HelperText="{x:Static local:AppResources.ZZZRequired}"
    ContainerType="Outlined"  Grid.Row="3" Grid.Column="0"  UnfocusedColor="#B1B1B1" x:Name="frmSearchParameter"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <custom:BorderlessEntry x:Name="SearchParameterEnter" FontFamily="{StaticResource SSTArabicMedium}"  FontAttributes="Bold" Text="{Binding TxtSearchParameter}" Focused="OnParameterTypeEntryEntryFocussed" IsEnabled="False" IsSpellCheckEnabled="False" FontSize="Small">
                            </custom:BorderlessEntry>
                            <inputLayout:SfTextInputLayout.HintLabelStyle>
                                <inputLayout:LabelStyle >
                                    <inputLayout:LabelStyle.FontFamily>
                                        <OnPlatform x:TypeArguments="x:String" iOS="{StaticResource SSTArabicMedium}" Android="{StaticResource SSTArabicMedium}" WinPhone="{StaticResource SSTArabicMedium}" />
                                    </inputLayout:LabelStyle.FontFamily>
                                </inputLayout:LabelStyle>
                            </inputLayout:SfTextInputLayout.HintLabelStyle>
                        </inputLayout:SfTextInputLayout>
                        
                        <custom:CustomButton x:Name="PPicker_btn" Clicked="PPicker_btn_Clicked" FontSize="Small" BackgroundColor="Transparent" Grid.Row="3" Grid.Column="0"  Grid.ColumnSpan="2" Margin="10,0,10,0"  >
                        </custom:CustomButton>
                        <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="PPicker"
                    HeaderHeight="40"
                    ShowHeader="true"
                                             HeaderTextColor="White"
                    HeaderText="{x:Static local:AppResources.ZSearchParameter}"
                                       
                   HeaderBackgroundColor="#006450"
                    SelectedItemTextColor="#006450"
                    BorderColor="Black"
                                             ShowColumnHeader="False"
                                              ShowFooter="True"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                             BackgroundColor="#EAF7CC"
                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"
                                     OKButtonTextColor="#006450"      
                                             CancelButtonTextColor="#006450"
                                SelectedItemFontSize="12"               
                   ItemHeight="40"
                                             CancelButtonClicked="PPicker_CancelButtonClicked"
                    ItemsSource="{Binding ParameterTypeList}" OkButtonClicked="SelectedParametes_OkayButtonClicked" DisplayMemberPath="ParameterType"   Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,0"
                    PickerHeight="200"
                    PickerWidth="270"
                     FooterHeight="46">
                            <syncfusion:SfPicker.Behaviors>
                                <custom1:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>
                        </syncfusion:SfPicker>
                        <inputLayout:SfTextInputLayout  Grid.Row="4" Grid.Column="0" Margin="10,-6,10,0" 
    Hint="{x:Static local:AppResources.ZPleaseenterthecorrespondingnumber}" x:Name="frmLookupNumner" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1" 
    OutlineCornerRadius="8" FocusedColor="#005e4b"  ErrorColor="#B00020" HasError="False"    HelperText="{x:Static local:AppResources.ZZZRequired}">
                            <custom:BorderlessEntry  FontFamily="{StaticResource SSTArabicMedium}" x:Name="entryNumber" Text="{Binding LookupNumber}" FontSize="Small"     MaxLength="{Binding MaxDigids}">
                                <Entry.Behaviors>
                                    <custom1:OnlyNumericValuesBehaviour/>
                                </Entry.Behaviors>
                            </custom:BorderlessEntry>
                            <inputLayout:SfTextInputLayout.HintLabelStyle>
                                <inputLayout:LabelStyle FontSize="14">
                                    <inputLayout:LabelStyle.FontFamily>
                                        <OnPlatform x:TypeArguments="x:String" iOS="{StaticResource SSTArabicMedium}" Android="{StaticResource SSTArabicMedium}" WinPhone="{StaticResource SSTArabicMedium}" />
                                    </inputLayout:LabelStyle.FontFamily>
                                </inputLayout:LabelStyle>
                            </inputLayout:SfTextInputLayout.HintLabelStyle>
                            <inputLayout:SfTextInputLayout.TrailingView >
                                <Label HorizontalOptions="End" IsEnabled="{Binding IsTooltipEnableVisible}"
                                           IsVisible="{Binding IsTooltipEnableVisible}"
                        Margin="0,0,0,4" FontSize="Title"   VerticalOptions="Center"
                       Style="{StaticResource IconLabelStyle}"
                         TextColor="#005e4b"
                        Text="{StaticResource Help}"  >
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </inputLayout:SfTextInputLayout>
                        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="Start" Grid.Row="5" Grid.Column="0"  Orientation="Horizontal" HeightRequest="50" Padding="0,10,0,0">
                            <Grid Grid.Row="0" Grid.Column="0" RowSpacing="5" Padding="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*"/>
                                    <ColumnDefinition Width="50*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Text="{x:Static local:AppResources.Name}"  Margin="10,0,10,0" Style="{StaticResource MicroGrayLabelStyleNew}"  HorizontalOptions="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}">
                                </Label>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Name}" HorizontalOptions="Start" Style="{StaticResource GAZTSmallGreenLabelStyleForSteps}"  x:Name="lbResult"  Margin="10,0,10,0" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                            </Grid>
                        </StackLayout>
                    </Grid>
                </ScrollView>
            </StackLayout>
            <!--</ScrollView>-->
            <!--<Button Text="" Command="{Binding OnSubmitClicked}" Style="{StaticResource GAZTVerifyButton}"  IsEnabled="{Binding IsButtonEnabled}" VerticalOptions="CenterAndExpand" ></Button>-->
            <!--<Button  Text="{x:Static local:AppResources.ZZProceedtoindivisualSignup}"  IsEnabled="{Binding IsButtonEnabled}" HeightRequest="56" Command="{Binding OnSubmitClicked}"  Style="{StaticResource GAZTVerifyButton}" BackgroundColor="{Binding VerifyButtonDisableColor}" VerticalOptions="EndAndExpand" Margin="0" CornerRadius="0"></Button>-->
            <StackLayout Grid.Row="1" HeightRequest="56" VerticalOptions="FillAndExpand"  WidthRequest="1000" BackgroundColor="White">
                <buttons:SfButton
                    Margin="0"
                 CornerRadius="0"
                    HeightRequest="56"
                    HorizontalOptions="End"
                    Style="{StaticResource SfButtonStyle}" BackgroundColor="#006450" 
                    Text="{x:Static local:AppResources.ZSearch}"
                                x:Name="btnSubmit" 
                                Clicked="btnSubmit_Clicked"
                     />
            </StackLayout>
            <!-- Acticity indicator layout start -->
            <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <!--<ActivityIndicator IsVisible="true" IsRunning="true" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Color="White" />
                        <Label Text="{x:Static local:AppResources.ActivityIndicatorTitle}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" />-->
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                                     
                                        
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#006450"/>
                    </StackLayout>
                    <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                </StackLayout>
            </Grid>
            <!-- Acticity indicator layout end -->
        </Grid>
    </ContentPage.Content>
</ContentPage>