<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
               xmlns:custom="clr-namespace:GAZT"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:local="clr-namespace:GAZT;assembly:GAZT"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
            
             xmlns:local1="clr-namespace:GAZT"
            
             Title="{x:Static local:AppResources.VATLookup}"
              x:Class="GAZT.Views.NewViews.VATLookupPageView"
            
              NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
      
            <ControlTemplate>
                <StackLayout Spacing="0">
                    <!--  Title View  -->
                    <controls:TitleView Title="{x:Static local:AppResources.VATLookup}"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="{DynamicResource Gray-White} ">
                        <controls:TitleView.LeadingView>
                            <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.OnBackButtonClicked}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="#006450"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                           
                           
                             />
                        </controls:TitleView.LeadingView>
                    </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
                </StackLayout>
            </ControlTemplate>
        </ContentPage.ControlTemplate>
        <ContentPage.Content >
        <Grid BackgroundColor="White" >
            <Grid.RowDefinitions>
                <RowDefinition Height="90*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>


            <StackLayout VerticalOptions="FillAndExpand" Grid.Row="0" Spacing="0" BackgroundColor="White">

                <ScrollView BackgroundColor="White" >
                    <Grid  RowSpacing="5" Padding="0,5,0,0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>

                        </Grid.ColumnDefinitions>
                        <custom:CustomLabel  Margin="10,5,10,5" Grid.Row="0" Grid.Column="0"  HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.ZStepsTitleScan}" Style="{StaticResource MicroGrayLabelStyleNew}"></Span>
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <!--<Label Text="{x:Static local:AppResources.ZZZIndividualInformation}"   Margin="10,5,10,5" VerticalOptions="Center"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="0" Grid.Column="0"  />-->
                        <buttons:SfButton
                    Margin="10,5,10,5"
                 CornerRadius="0"
                            x:Name="ScanCode_btn"
                            Clicked="ScanCode_btn_Clicked"

                            Grid.Row="1" Grid.Column="0"
                    HeightRequest="56"
                    HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center"
                    Style="{StaticResource SfButtonStyle}" BackgroundColor="#006450" Opacity="0.7"
                  Text="{x:Static local:AppResources.ZQRScanner}"
                   
                   />


                        <!--<Label Text="{x:Static local:AppResources.ZZZIndividualInformation}"   VerticalOptions="Center"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />-->
                        <custom:CustomLabel  Margin="10,5,10,5" Grid.Row="2" Grid.Column="0"  HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static local:AppResources.ZOR}" Style="{StaticResource MicroGrayLabelStyleNew}"></Span>
                                    <Span Text="&#10;"/>
                                    <Span Text="&#10;"/>
                                    <Span Text="{x:Static local:AppResources.ZStepsTitle}" Style="{StaticResource MicroGrayLabelStyleNew}"></Span>
                                    <Span Text="&#10;"/>
                                    <Span Text="{x:Static local:AppResources.ZStepOne}" Style="{StaticResource MicroGrayLabelStyleNewEn}"></Span>
                                    <Span Text="&#10;"/>
                                    <Span Text="{x:Static local:AppResources.ZStepTwo}" Style="{StaticResource MicroGrayLabelStyleNewEn}"></Span>
                                    <Span Text="&#10;"/>
                                    <Span Text="{x:Static local:AppResources.ZStepThree}" Style="{StaticResource MicroGrayLabelStyleNewEn}"></Span>
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>




                        <inputLayout:SfTextInputLayout  Margin="10,-6,10,0" 
    Hint="{x:Static local:AppResources.ZSearchParameter}" HelperText="{x:Static local:AppResources.ZZZRequired}"
    ContainerType="Outlined"  Grid.Row="3" Grid.Column="0"  UnfocusedColor="#B1B1B1" x:Name="frmSearchParameter"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <custom:BorderlessEntry x:Name="SearchParameterEnter" FontAttributes="Bold" Text="{Binding TxtSearchParameter}" Focused="OnParameterTypeEntryEntryFocussed" IsEnabled="False" IsSpellCheckEnabled="False" FontSize="Small">
                            </custom:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                        <custom:CustomButton x:Name="PPicker_btn" Clicked="PPicker_btn_Clicked" FontSize="Small" BackgroundColor="Transparent" Grid.Row="3" Grid.Column="0"  Grid.ColumnSpan="2" Margin="10,0,10,0"  >
                        </custom:CustomButton>
                        <syncfusion:SfPicker x:Name="PPicker"
                    HeaderHeight="40"
                    ShowHeader="true"
                    HeaderText="{x:Static local:AppResources.ZSearchParameter}"
                   HeaderBackgroundColor="#006450"
                    SelectedItemTextColor="#006450"
                    BorderColor="Black"
                                             ShowColumnHeader="False"
                                              ShowFooter="True"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                             BackgroundColor="#EAF7CC"

                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"
                                            
                                             SelectedItem="{Binding SelectedParameterType,Mode=TwoWay}"
                                SelectedItemFontSize="12"               
                   ItemHeight="40"
                                             CancelButtonClicked="PPicker_CancelButtonClicked"
                    ItemsSource="{Binding ParameterTypeList}" OkButtonClicked="SelectedParametes_OkayButtonClicked" Focused="OnParameterTypeEntryEntryFocussed"  DisplayMemberPath="ParameterType"   Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,0"
                    PickerHeight="200"
                    PickerWidth="270"
                     FooterHeight="46">
                            <syncfusion:SfPicker.Behaviors>
                                <custom1:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>
                        </syncfusion:SfPicker>
                      

                        <inputLayout:SfTextInputLayout  Grid.Row="4" Grid.Column="0" Margin="10,-6,10,0" 
    Hint="{x:Static local:AppResources.ZPleaseenterthecorrespondingnumber}" x:Name="frmLookupNumner" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1" 
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False"    HelperText="{x:Static local:AppResources.ZZZRequired}">
                            <custom:BorderlessEntry x:Name="entryNumber" Text="{Binding LookupNumber}" FontSize="Small"     MaxLength="{Binding MaxDigids}">
                                <Entry.Behaviors>

                                    <custom1:OnlyNumericValuesBehaviour/>

                                </Entry.Behaviors>
                            </custom:BorderlessEntry>
                            <inputLayout:SfTextInputLayout.HintLabelStyle>
                                <inputLayout:LabelStyle FontSize="15">
                                </inputLayout:LabelStyle>
                            </inputLayout:SfTextInputLayout.HintLabelStyle>
                            <inputLayout:SfTextInputLayout.TrailingView>
                                <Label IsEnabled="{Binding IsTooltipEnableVisible}"
                                           IsVisible="{Binding IsTooltipEnableVisible}"
                       
                        Margin="0,0,0,2"
                        Style="{StaticResource IconLabelStyleVAT}"
                         TextColor="#005e4b"
                        Text="{StaticResource Help}" >
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </inputLayout:SfTextInputLayout>

                        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="Start" Grid.Row="5" Grid.Column="0"  Orientation="Horizontal" HeightRequest="50" Padding="0,10,0,0">

                            <Grid Grid.Row="0" Grid.Column="0" RowSpacing="5" Padding="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>

                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*"/>
                                    <ColumnDefinition Width="50*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Text="{x:Static local:AppResources.Name}"  Margin="10,0,10,0" Style="{StaticResource MicroGrayLabelStyleNew}"  HorizontalOptions="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center">
                                </Label>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Name}" HorizontalOptions="Start" Style="{StaticResource GAZTSmallGreenLabelStyleForSteps}"  x:Name="lbResult"  Margin="10,0,10,0" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center"/>

                            </Grid>

                        </StackLayout>

                    </Grid>


                </ScrollView>
            </StackLayout>
            <!--</ScrollView>-->


            <!--<Button Text="" Command="{Binding OnSubmitClicked}" Style="{StaticResource GAZTVerifyButton}"  IsEnabled="{Binding IsButtonEnabled}" VerticalOptions="CenterAndExpand" ></Button>-->
            <!--<Button  Text="{x:Static local:AppResources.ZZProceedtoindivisualSignup}"  IsEnabled="{Binding IsButtonEnabled}" HeightRequest="56" Command="{Binding OnSubmitClicked}"  Style="{StaticResource GAZTVerifyButton}" BackgroundColor="{Binding VerifyButtonDisableColor}" VerticalOptions="EndAndExpand" Margin="0" CornerRadius="0"></Button>-->
            <StackLayout Grid.Row="1" HeightRequest="56" VerticalOptions="FillAndExpand"  WidthRequest="1000" BackgroundColor="White">
                <buttons:SfButton
                    Margin="0"
                 CornerRadius="0"
                    HeightRequest="56"
                    HorizontalOptions="End"
                    Style="{StaticResource SfButtonStyle}" BackgroundColor="#006450" Opacity="0.7"
                    Text="{x:Static local:AppResources.ZSearch}"
                    
                                x:Name="btnSubmit" 
                                Clicked="btnSubmit_Clicked"
                   
  
                     />

            </StackLayout>
            <!-- Acticity indicator layout start -->
            <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.7" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <ActivityIndicator IsVisible="true" IsRunning="true" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Color="White" />
                        <Label Text="{x:Static local:AppResources.ActivityIndicatorTitle}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" />
                    </StackLayout>
                </StackLayout>
            </Grid>

            <!-- Acticity indicator layout end -->
        </Grid>
        
    </ContentPage.Content>
</ContentPage>