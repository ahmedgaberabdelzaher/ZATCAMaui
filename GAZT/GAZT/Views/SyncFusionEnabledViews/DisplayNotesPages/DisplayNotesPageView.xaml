<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
              xmlns:local="clr-namespace:EGAZT;assembly:GAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:local1="clr-namespace:GAZT"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.DisplayNotes.DisplayNotesPageView"
               NavigationPage.HasNavigationBar="False"
           FlowDirection="RightToLeft"
            BackgroundColor="White" >
    <ContentPage.Resources>
        <ResourceDictionary>
            <custom1:DataMarkerConverter x:Key="converter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <controls:TitleView Title=""  FontSize="13"   BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.GoBackClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="{StaticResource Primary}"
                            Style="{StaticResource IconButtonStyle}"
                             Text="{DynamicResource StyleReverseBack}"
                             />
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <StackLayout>
            <StackLayout Margin="10,10,10,0"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White">
                <ListView  x:Name="DisplayNotes" 
           ItemsSource="{Binding NoteList}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                      IsVisible="{Binding IsDisplayNoteVisible}"
            SeparatorVisibility="None"
                           BackgroundColor="White"
            >
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <ContentView>
                                    <Frame OutlineColor="#C9C9C9"
                                       Margin="0,0,0,10"
                                       Padding="0,0,0,0"
                                       CornerRadius="0"
                               >
                                        <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Margin="1,2,1,2" Padding="0" >
                                            <Grid Style="{DynamicResource GridStyle}" ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White" >
                                                
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Label Text="{Binding Sect}"  
                                                       Margin="10,0,10,-7"
                                   Style="{StaticResource GAZTCaptionGreenLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                                        FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                   Grid.Row="0"
                                   Grid.Column="0" />
                                                <Label Text="{Binding Strline}" 
                                                       Margin="10,0,10,-3"
                                   Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                                          FontFamily="{StaticResource SomarSemiBold}"
                                                       FontSize="11"
                                   Grid.Row="1"
                                   Grid.Column="0" />
                                                <Label Text="{Binding Namez}" 
                                                       Margin="10,0,10,-8"
                                   Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                                       FontSize="11"
                                                         FontFamily="{StaticResource SomarSemiBold}"
                                   Grid.Row="2"
                                   Grid.Column="0" />
                                                <Label 
                                   Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                                       HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start"
                                                       VerticalOptions="CenterAndExpand"
                                                   
                                   Grid.Row="3"
                                   Grid.Column="0">
                                                    <Label.FormattedText >
                                                        <FormattedString>
                                                            <Span Text="{Binding Strdt}"   FontFamily="{StaticResource SomarSemiBold}" FontSize="11"/>
                                                            <Span Text="  " />
                                                            <Span Text="{Binding Strtime}" FontFamily="{StaticResource SomarSemiBold}" FontSize="11"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Grid>
                                        </StackLayout>
                                    </Frame>
                                </ContentView>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <local1:CustomLabel Text="{x:Static local:AppResources.Nodataavailable}" IsVisible="{Binding IsNoDataLabelVisible}" Style="{StaticResource GAZTGrayLabelStyleForSmallFont}"  HorizontalOptions="Center" VerticalOptions="Center"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}">
                </local1:CustomLabel>
            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>