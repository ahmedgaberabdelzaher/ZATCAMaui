<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             mc:Ignorable="d" 
              BackgroundImageSource="partials_background.png"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:custom="clr-namespace:GAZT"
              xmlns:custom2="clr-namespace:EGAZT"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" xmlns:custom1="clr-namespace:GAZT.CustomControl"
             Title="{x:Static custom2:AppResources.ZVatTermsAndConditions}"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.VATIndividualSignupTnCPageView"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10"/>
                <Setter Property="WidthRequest" Value="10"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
        <ContentPage.ControlTemplate>
        <ControlTemplate>
        
            <StackLayout Spacing="0">
                <controls:SignUpTitle  Title="{x:Static custom2:AppResources.ZZTermsAndConditions}"  FontSize="13"   FontFamily="{x:StaticResource GAZT_FONT_BOLD}" BackgroundColor="Transparent">
     
                    <controls:SignUpTitle.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.BackButtonClicked}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="White"
                            Style="{StaticResource IconButtonStyle}"
                             Text="{DynamicResource StyleReverseBack}"
                             />
                    </controls:SignUpTitle.LeadingView>
                                     
                </controls:SignUpTitle>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid Margin="0,-6,0,0" BackgroundColor="{StaticResource Primary}">
        <yummy:PancakeView BackgroundColor="Transparent" CornerRadius="32,32,0,0" Padding="0" Margin="0,0,0,0">
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,15,0,0" BackgroundColor="White">

                <Grid.RowDefinitions>
                    <RowDefinition Height="10*" />
                    <RowDefinition Height="80*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="1" Grid.Column="0"  Margin="0" 
                  Padding="15,15,15,0" BackgroundColor="White" RowSpacing="0" >
                    <Grid.RowDefinitions >
                        <RowDefinition Height="100*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <WebView x:Name="TCWebView" HeightRequest="880" WidthRequest="1000" HorizontalOptions="FillAndExpand" />
                </Grid>
               
                <StackLayout Grid.Row="2" Grid.Column="0"  Margin="0,0,0,0" VerticalOptions="End" HorizontalOptions="FillAndExpand"  BackgroundColor="White" >
                    <!--<CheckBox x:Name="chkTAndC"   IsChecked="{Binding IschkTAndC}"  Margin="10,0,0,0" VerticalOptions="Center">
                    </CheckBox>
                    <custom:CustomLabel Text="{x:Static custom2:AppResources.ZZIagreeontermsAndconditions}"   FontFamily="{StaticResource GAZT_FONT_MEDIUM}" HorizontalOptions="Start" VerticalOptions="Center"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" Margin="0,0,10,0"/>-->
                    <StackLayout BackgroundColor="White" HeightRequest="70" Margin="0,0,0,0" WidthRequest="1000" Orientation="Horizontal" VerticalOptions="Center">
                        <!--<buttons:SfCheckBox x:Name="checkBox"  VerticalOptions="Center" IsChecked="{Binding IschkTAndC}" LineBreakMode="WordWrap" Text="{x:Static local:AppResources.ZZIagreeontermsAndconditions}" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" />-->
                        <!--<CheckBox x:Name="chkTAndC"   IsChecked="{Binding IschkTAndC}"  Margin="10,0,0,0" VerticalOptions="Center">
                        </CheckBox>-->
                        <custom1:CheckboxCustom  IsChecked="{Binding IschkTAndC}" Style="{StaticResource CheckboxHeightWidth32}"
                                                                        x:Name="chkTAndC"  VerticalOptions="CenterAndExpand"/>
                        <custom:CustomLabel Text="{x:Static custom2:AppResources.ZZIagreeontermsAndconditions}"
                                            FontFamily="{StaticResource GAZT_FONT_MEDIUM}" HorizontalOptions="Start" HorizontalTextAlignment="Center" VerticalOptions="Center"
                                            Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" Margin="0,0,10,0"/>
                    </StackLayout>
                    <buttons:SfButton x:Name="MainButtonName" HorizontalOptions="FillAndExpand" FontFamily="{StaticResource SomarSemiBold}"   Margin="0"
                 CornerRadius="0"
                    HeightRequest="56"
                    
                    Style="{StaticResource SfButtonStyle}" 
                    Text="{x:Static custom2:AppResources.ZZProceedtoindividualSignup}"
                    IsEnabled="{Binding IsButtonEnabled}"
                    Command="{Binding OnSubmitClicked}" 
                      VerticalOptions="End" FontAttributes="Bold" 
                                      FontSize="15"   Grid.ColumnSpan="2"  BackgroundColor="{StaticResource Secondary}" /> <!--Clicked="btnContinue_Clicked"-->
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" BackgroundColor="White" Padding="0" Margin="15,-15,15,0">
                    <Grid Margin="0,7,0,0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="ic_logo_gazt.png" Grid.Row="0" Grid.Column="1" WidthRequest="50" HeightRequest="50" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"/>
                    </Grid>
                </StackLayout>
                
            </Grid>
        </yummy:PancakeView>
            <Grid Grid.Row="0"    Grid.Column="0"   IsVisible="{Binding IsLoading}" >
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="Center"
                                           IsBusy="{Binding IsLoading}"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="{StaticResource Primary}"/>
                    </StackLayout>
                    <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
