<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:custom2="clr-namespace:EGAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
                 xmlns:cards1="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
                 x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.FileAttachmentPopUpPageView">
    <yummy:PancakeView CornerRadius="22,22,0,0" HasShadow="True" VerticalOptions="End" BackgroundColor="White">
        <StackLayout Padding="0,0,0,0" Margin="10,0,10,0">

            <!--<Grid   HorizontalOptions="CenterAndExpand" IsVisible="{Binding IsImpoterAndExporter}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35*"/>
                    <ColumnDefinition Width="30*"/>
                    <ColumnDefinition Width="35*"/>
                </Grid.ColumnDefinitions>
                <Label Text="Importer" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End" VerticalOptions="Center"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="0" Grid.Column="0">
                </Label>


                --><!--<Switch Margin="10,0,10,0" x:Name="SwitchOfRefund1" Grid.Row="0" Grid.Column="1" Toggled="Switch_Toggled"    HorizontalOptions="StartAndExpand" VerticalOptions="LayoutOptions.CenterAndExpand"  IsToggled="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsSwichButtonEnable}" IsEnabled="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsSwichButtonEnableToTap}"  />
                                            <custom:CustomButton x:Name="btnForSwitch1" IsEnabled="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsSwichButtonEnableToTap}" Clicked="btnSwitch_ClickedForNewVATChange" FontSize="13" BackgroundColor="Transparent" Margin="10,0,10,0" Grid.Row="0" Grid.Column="1"  >
                                            </custom:CustomButton>--><!--

                <Switch HorizontalOptions="CenterAndExpand"  VerticalOptions="CenterAndExpand"  Grid.Row="0" Grid.Column="1" IsToggled="{Binding IsSwitchToggled}" IsEnabled="{Binding IsEnableSwitchToggled}"></Switch>
                <custom:CustomButton x:Name="btnForNewChange"  WidthRequest="15" HeightRequest="15" IsEnabled="{Binding IsEnableSwitchToggledForButton}" Clicked="btnSwitch_ClickedForNewVATChange" FontSize="13" BackgroundColor="Transparent" Grid.Row="0" Grid.Column="1">
                </custom:CustomButton>

                <Label HorizontalOptions="StartAndExpand" VerticalOptions="Center" HorizontalTextAlignment="Start" Text="Exporter"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="0" Grid.Column="2">
                </Label>
            </Grid>-->

            <Label Text="{x:Static custom2:AppResources.ZZZZVATRAttachmentNote1}" Margin="0,8,0,0" TextColor="#005e4b"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
            <Label Text="{x:Static custom2:AppResources.ZZZZVATRAttachmentNote2}" Margin="0,8,0,0" TextColor="#005e4b"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
            <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,15"/>

            <!--<ListView ItemsSource="{Binding AttachmentList}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
            HasUnevenRows="True" x:Name="List" BackgroundColor="White" ItemTapped="Attachmentlist_ItemTapped"
            SeparatorVisibility="None" >-->


                <ListView   
           ItemsSource="{Binding AttachmentList}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                                x:Name="List"
                             HeightRequest="300"       
            ItemTapped="Attachmentlist_ItemTapped"
            SeparatorVisibility="None"
            >
                    <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <ContentView>
                                <cards1:SfCardView HasShadow="True" Margin="10" Opacity=".9" BorderWidth=".05" BorderColor="#5d6770"  ShadowColor="#5d6770" BackgroundColor="White" CornerRadius="8"  IndicatorColor="#005e4b" IndicatorPosition="Left" IndicatorThickness="5" >
                                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"  Padding="10" >
                                        <Grid Style="{DynamicResource GridStyle}" ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="Center" BackgroundColor="White" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70*" />
                                                <ColumnDefinition Width="15*" />
                                                <ColumnDefinition Width="15*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                            </Grid.RowDefinitions>
                                            <Label Text="{Binding Filename}" 
                                                                 LineBreakMode="TailTruncation"     
                                   Style="{StaticResource MicroGrayLabelStyleNew}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                                                           FontFamily="{StaticResource SSTArBold}"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   />
                                            <Image Grid.Row="0"  Grid.Column="1" Grid.RowSpan="2"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_file_download.png"  >
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnDownloadAttachmentClicked" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                            <Image Grid.Row="0"  Grid.Column="2" Grid.RowSpan="2"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_delete.png"  >
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnDeleteAttachmentClicked" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                            <Label Text="{Binding Erfdt}" 
                                                                       Margin="3,0,3,-5"
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                                                   FlowDirection="LeftToRight"
                                   Grid.Row="1"
                                   Grid.Column="0" Grid.ColumnSpan="2" 
                                                                   FontFamily="{StaticResource SSTArBold}"
                                   />
                                        </Grid>
                                    </StackLayout>
                                </cards1:SfCardView>
                            </ContentView>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>

                <!--<ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80*"/>
                                    <ColumnDefinition Width="20*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Text="{Binding Filename}" Style="{StaticResource MicroGrayLabelStyleNew}" 
                                       LineBreakMode="TailTruncation" FontFamily="{StaticResource SSTArBold}"/>

                                <Image Grid.Column="1"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_delete.png">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDeleteAttachmentClicked" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>-->
            </ListView>
            <buttons:SfButton x:Name="btnAddAttachment" Text="Add Attachment" CornerRadius="10" VerticalOptions="End" FontAttributes="Bold" 
                              HeightRequest="56" Margin="0,0,0,20" FontSize="16" TextColor="{DynamicResource Gray-White}" FontFamily="{StaticResource Montserrat-SemiBold}" 
                              BackgroundColor="#d49504" BorderWidth="0" Command="{Binding OnAttachmentClick}"/>
        </StackLayout>
    </yummy:PancakeView>
</pages:PopupPage>