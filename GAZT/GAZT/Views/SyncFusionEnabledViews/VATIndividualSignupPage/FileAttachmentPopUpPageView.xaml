<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:custom2="clr-namespace:EGAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
                 xmlns:cards1="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
                 x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.FileAttachmentPopUpPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
                <ResourceDictionary Source="..\CommonStyle\StylesNewUI.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <yummy:PancakeView CornerRadius="22,22,0,0" HasShadow="False" VerticalOptions="End" BackgroundColor="White">
        <Grid>
            <StackLayout Padding="0,0,0,0" Margin="10,0,10,0">

                <!--<Label Margin="10,0,10,0" HorizontalOptions="End" VerticalOptions="Center" Style="{StaticResource IconLabelStyle}" Text="{StaticResource Close}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoButtonClick}"/>
                </Label.GestureRecognizers>
            </Label>-->
                <!--<Image HorizontalOptions="EndAndExpand" Margin="15,15,15,1" >
                    <Image.Source>
                        <FontImageSource FontFamily="UserIconFont" Color="LightGray" Size="25" Glyph="{x:Static FontImage:IconFonts.Close}"/>
                    </Image.Source>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoButtonClick}"/>
                    </Image.GestureRecognizers>
                </Image>-->

                <Grid   HorizontalOptions="CenterAndExpand" IsVisible="{Binding IsImpoterAndExporter}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35*"/>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="35*"/>
                    </Grid.ColumnDefinitions>

                    <Label HorizontalTextAlignment="Center" Text="{x:Static custom2:AppResources.VATRUploadingDocumentsFor}" HorizontalOptions="Center" VerticalOptions="Center" Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" />

                    <Label Text="{x:Static custom2:AppResources.FAPImporter}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End" VerticalOptions="Center" Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="1" Grid.Column="0"  >
                    </Label>

                    <Switch HorizontalOptions="CenterAndExpand"  VerticalOptions="CenterAndExpand"  Grid.Row="1" Grid.Column="1" IsToggled="{Binding IsSwitchToggled}" ></Switch>

                    <custom:CustomButton x:Name="btnForNewChange"  WidthRequest="15" HeightRequest="15"  Clicked="btnSwitch_ClickedForNewVATChange" FontSize="13" BackgroundColor="Transparent" Grid.Row="1" Grid.Column="1">
                    </custom:CustomButton>

                    <Label HorizontalOptions="StartAndExpand" VerticalOptions="Center" HorizontalTextAlignment="Start" Text="{x:Static custom2:AppResources.FAPExporter}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="1" Grid.Column="2">
                    </Label>
                </Grid>

                <Label HorizontalTextAlignment="Start" Text="{x:Static custom2:AppResources.ZZZZVATRAttachmentNote1}" Margin="5,10,5,0" Style="{StaticResource BodyLabelGrey}" FontSize="11"/>
                <Label HorizontalTextAlignment="Start" Text="{x:Static custom2:AppResources.ZZZZVATRAttachmentNote2}" Margin="5,0,5,0" Style="{StaticResource BodyLabelGrey}" FontSize="11"/>
                <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,10"/>

                <ListView ItemsSource="{Binding AttachmentList}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" HasUnevenRows="True" x:Name="List" HeightRequest="300"  ItemTapped="Attachmentlist_ItemTapped" SeparatorVisibility="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <ContentView>
                                    <cards1:SfCardView HasShadow="False" Margin="10" Opacity=".9" BorderWidth=".05" BorderColor="{StaticResource EntryTextColor}"  ShadowColor="{StaticResource EntryTextColor}" BackgroundColor="White" CornerRadius="8"  IndicatorColor="{StaticResource Primary}" IndicatorPosition="Left" IndicatorThickness="5" >
                                        <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"  Padding="10" >
                                            <Grid Style="{DynamicResource GridStyle}" ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="Center" BackgroundColor="White" >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70*" />
                                                    <ColumnDefinition Width="15*" />
                                                    <ColumnDefinition Width="15*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30" />
                                                    <RowDefinition Height="30" />
                                                </Grid.RowDefinitions>
                                                <Label Text="{Binding Filename}" LineBreakMode="TailTruncation" Style="{StaticResource MicroGrayLabelStyleNew}"
                                                   HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" FontFamily="{StaticResource SomarBold}" Grid.Row="0" Grid.Column="0"/>
                                                <!--<Image Grid.Row="0"  Grid.Column="1" Grid.RowSpan="2"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_file_download.png"  >
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnDownloadAttachmentClicked" />
                                                </Image.GestureRecognizers>
                                            </Image>-->
                                                <Image Grid.Row="0"  Grid.Column="2" Grid.RowSpan="2"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_delete.png"  >
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnDeleteAttachmentClicked" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                <Label Text="{Binding Erfdt}" Margin="3,0,3,-5" Style="{StaticResource MiniGrayLabelStyle}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" FlowDirection="LeftToRight" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" FontFamily="{StaticResource SomarBold}"/>
                                            </Grid>
                                        </StackLayout>
                                    </cards1:SfCardView>
                                </ContentView>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <buttons:SfButton x:Name="btnAddAttachment" Text="{x:Static custom2:AppResources.FAPAddAttachment}" CornerRadius="14" VerticalOptions="End" FontAttributes="Bold" 
                HeightRequest="48" Margin="0,0,0,10" FontSize="15" TextColor="{DynamicResource Gray-White}" FontFamily="{StaticResource SomarSemiBold}" 
                BackgroundColor="{StaticResource Secondary}" BorderWidth="0" Command="{Binding OnAttachmentClick}"/>
                <buttons:SfButton x:Name="btnDone" Text="{x:Static custom2:AppResources.ZZZZDone}" CornerRadius="14" VerticalOptions="End" FontAttributes="Bold" 
                HeightRequest="48" Margin="0,0,0,20" FontSize="15" TextColor="{DynamicResource Gray-White}" FontFamily="{StaticResource SomarSemiBold}" 
                BackgroundColor="{StaticResource Secondary}" BorderWidth="0" Command="{Binding GoButtonClick}"/>
            </StackLayout>

            <Grid Grid.Row="0"    Grid.Column="0"  IsVisible="{Binding IsLoading}" >
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="Center"
                                           IsBusy="{Binding IsLoading}"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="{StaticResource Primary}"/>
                    </StackLayout>
                    <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                </StackLayout>
            </Grid>
        </Grid>
        
    </yummy:PancakeView>
</pages:PopupPage>