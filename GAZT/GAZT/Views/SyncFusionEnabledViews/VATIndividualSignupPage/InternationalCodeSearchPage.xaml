<?xml version="1.0" encoding="UTF-8"?>
<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:cards1="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:custom="clr-namespace:GAZT"
                            xmlns:FontImage="clr-namespace:MVP.FontIcons"
                          xmlns:local="clr-namespace:EGAZT"
                     xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
             NavigationPage.HasNavigationBar="False"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:local1="clr-namespace:GAZT"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.InternationalCodeSearchPage">
    <ScrollView>
        <yummy:PancakeView CornerRadius="22,22,0,0" HasShadow="True" VerticalOptions="EndAndExpand" BackgroundColor="White" Margin="0,100,0,0">

            <Grid>

                <StackLayout Padding="22,22,22,0">
 <Label Text="Country"  VerticalOptions="Start" FontSize="Medium" TextColor="Black" FontFamily="{StaticResource SSTArBold}" />

                                    <Image HorizontalOptions="EndAndExpand" Margin="15,10,15,0" >
                    <Image.Source>
                        <FontImageSource FontFamily="UserIconFont" Color="LightGray" Size="25"
                                                    Glyph="{x:Static FontImage:IconFonts.Close}"/>
                    </Image.Source>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Close_Tapped"/>
                    </Image.GestureRecognizers>
                </Image>

        <SearchBar x:Name="searchBar"
                   HorizontalOptions="Fill"
                   VerticalOptions="CenterAndExpand"
                   Placeholder="Search"
                   CancelButtonColor="Blue"         
                   PlaceholderColor="Gray"
                   HorizontalTextAlignment="Start"
                   TextChanged="OnTextChanged"/>
        <ListView x:Name="searchResults"
           ItemsSource="{Binding MobileCodes}"
                  ItemTapped="List_ItemTapped"
                  HorizontalOptions="Fill"
                  VerticalOptions="CenterAndExpand" >
      <ListView.ItemTemplate>
        <DataTemplate>
            <ViewCell>
                <Frame HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0" HasShadow="False">
                    <Grid Margin="20, 0, 20, 0">
                           <Grid.RowDefinitions>
                             <RowDefinition Height="auto"/>
                          </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                     <StackLayout Orientation="Horizontal" Grid.Row="0" Spacing="10"  >
                                      <local1:CustomLabel Text="{Binding Landx}" Margin="10,0,30,0" LineBreakMode="WordWrap"  Style="{StaticResource MicroGrayLabelStyleNewEn}" FontFamily="{StaticResource GAZT_FONT_MEDIUM }" FontSize="Small"
                                 HorizontalTextAlignment="Start" TextColor="Black"   />
             <local1:CustomLabel Text="{Binding Telefto}"  Margin="80,0,60,0" HorizontalOptions="FillAndExpand" Style="{StaticResource MicroGrayLabelStyleNewEn}" FontFamily="{StaticResource GAZT_FONT_MEDIUM }" FontSize="Small"
                                 HorizontalTextAlignment="ENd" VerticalOptions="FillAndExpand" TextColor="Black" />

                         </StackLayout>
                    </Grid>
                </Frame>
            </ViewCell>
        </DataTemplate>
    </ListView.ItemTemplate>
        </ListView>
    
      </StackLayout>        
            </Grid>
        </yummy:PancakeView>
       
   
</ScrollView>
</pages:PopupPage>
