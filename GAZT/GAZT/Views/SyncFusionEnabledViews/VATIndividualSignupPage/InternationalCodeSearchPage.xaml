<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:cards1="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:custom="clr-namespace:GAZT"
                          xmlns:local="clr-namespace:EGAZT"

             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:local1="clr-namespace:GAZT"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.InternationalCodeSearchPage">
  

     <Grid>
        <yummy:PancakeView CornerRadius="22,22,0,0" HasShadow="True" VerticalOptions="End" BackgroundColor="White">
            <Grid>
                 <StackLayout>
        <SearchBar x:Name="searchBar"
                   HorizontalOptions="Fill"
                   VerticalOptions="CenterAndExpand"
                   Placeholder="Country"
                   CancelButtonColor="Blue"         
                   PlaceholderColor="Gray"
                   HorizontalTextAlignment="Start"
                   TextChanged="OnTextChanged"/>
        <ListView x:Name="searchResults"
           ItemsSource="{Binding MobileCodes}"
                  ItemTapped="List_ItemTapped"
                  HorizontalOptions="Fill"
                  VerticalOptions="CenterAndExpand" >
      <ListView.ItemTemplate>
        <DataTemplate>
            <ViewCell>
                <Frame HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0" HasShadow="False">
                    <Grid Margin="20, 0, 20, 0">
                           <Grid.RowDefinitions>
                             <RowDefinition Height="auto"/>
                          </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                     <StackLayout Orientation="Horizontal" Grid.Row="0">
             <local1:CustomLabel Text="{Binding Telefto}" LineBreakMode="WordWrap" Margin="10,0,10,0" Style="{StaticResource MicroGrayLabelStyleNewEn}" FontFamily="{StaticResource GAZT_FONT_MEDIUM }" FontSize="Small"
                                 HorizontalTextAlignment="Start"  TextColor="Black" />
             <local1:CustomLabel Text="{Binding Landx}" Margin="30,0,30,0" LineBreakMode="WordWrap"  Style="{StaticResource MicroGrayLabelStyleNewEn}" FontFamily="{StaticResource GAZT_FONT_MEDIUM }" FontSize="Small"
                                 HorizontalTextAlignment="Start" TextColor="Black"   />
                         </StackLayout>
                    </Grid>
                </Frame>
            </ViewCell>
        </DataTemplate>
    </ListView.ItemTemplate>
        </ListView>
    </StackLayout>
               
            </Grid>
        </yummy:PancakeView>
       
    </Grid>

</ContentPage>
