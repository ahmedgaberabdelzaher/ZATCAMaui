                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <StackLayout Grid.Row="0">
                                        <Label Text="{x:Static custom2:AppResources.ZZZZVATREInstructionsandConditions}" FontFamily="{StaticResource GAZT_FONT_BOLD}"  VerticalOptions="Center" FontSize="Large" TextColor="Black" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
                                        <!--<Label Text="Complete the Below Details" FontFamily="{StaticResource SSTArBold}"/>
                                        <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,15"/>-->
                                    </StackLayout>
