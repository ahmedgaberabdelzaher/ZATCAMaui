<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:EGAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
		     xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"             
             BackgroundColor="#005e4b"
             xmlns:custom2="clr-namespace:EGAZT"
             Title="VAT Registration"
             xmlns:local1="clr-namespace:GAZT"
            FlowDirection="RightToLeft"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.VATRegistrationPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10"/>
                <Setter Property="WidthRequest" Value="10"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SSTArBold}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SSTArBold}"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <yummy:PancakeView BackgroundColor="Black" CornerRadius="32,32,0,0" Padding="0">
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,15,0,0" BackgroundColor="White">

                <Grid.RowDefinitions>
                    <RowDefinition Height="10*" />
                    <RowDefinition Height="80*" />
                    <RowDefinition Height="10*" />
                </Grid.RowDefinitions>
      

                <!--    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="15,15,15,10" BackgroundColor="White" RowSpacing="0" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*" />
                    <RowDefinition Height="80*" />
                    <RowDefinition Height="10*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>-->
              
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="1" Grid.Column="0"  Margin="0" 
                  Padding="15,15,15,0" BackgroundColor="White" RowSpacing="0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88*" />
                        <RowDefinition Height="12*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <ScrollView Grid.Row="0" Grid.Column="0" HorizontalOptions="FillAndExpand">
                        <StackLayout BackgroundColor="White">

                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,15,0,10" BackgroundColor="White" RowSpacing="0" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="100*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100*"/>
                                </Grid.ColumnDefinitions>


                                <!--Instrunction Details-->
                                <Grid Grid.Row="0" Grid.Column="0"  Padding="0,10,0,0" 
                                      IsVisible="{Binding IsInstrunctionVisible}"
                          x:Name="InstrunctionView">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <StackLayout Grid.Row="0">
                                        <Label Text="Instrunctions and Conditions Details"  VerticalOptions="Center" FontSize="Large" TextColor="Black" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
                                        <!--<Label Text="Complete the Below Details" FontFamily="{StaticResource SSTArBold}"/>
                                        <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,15"/>-->
                                    </StackLayout>
                                    <ScrollView Grid.Row="1">
                                        <Grid Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" 
                              ColumnSpacing="0" RowSpacing="15" BackgroundColor="White">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="15*"/>
                                                <ColumnDefinition Width="85*"/>
                                            </Grid.ColumnDefinitions>
                                            <!--Start Of Read Only or pre-populated-->
                                            <Label Text="Please fill the requested information for each step. This application cannot be successfully submitted until all of the mandatory fields and attachments have been completed. Applicants should ensure that their existing taxpayer details are completed and accurate before registering for VAT."  Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="2"  HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                                            <Label Text="Please refer to the  VAT FAQ  section in the GAZT website before filling out this application form."  Grid.Row="1" Grid.Column="0"  Grid.ColumnSpan="2"  HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>

                                            <custom:CustomLabel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="1."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                        <Span Text="For applications on behalf of a company, this form should be completed by an official contact person of the company and signed by a person who has authority to sign of on behalf of the company. If the provided information is incorrect or incomplete then penalties are added as per Value Added Tax Law without interfering with any penalties applied by other regulations in the Kingdom of Saudi Arabia"  FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <custom:CustomLabel  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2"  HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="2."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                        <Span Text="GAZT reserves the right to obtain financial statements and business records of the company and review them." FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <custom:CustomLabel   Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="3."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                        <Span Text="GAZT reserves the right to obtain financial statements and business records to the owner and review them." FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <custom:CustomLabel  Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="4."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                        <Span Text="A VAT registration may be cancelled in accordance to the cases listed as per the VAT Law." FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <custom:CustomLabel  Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="5."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                        <Span Text="The person registered in VAT tax system must notify GAZT of changing any of the information provided in the registration form, a change or cessation of business activity, or any major changes that affects liability to be VAT registered, in accordance with the VAT Regulations." FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <custom:CustomLabel  Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="6."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                        <Span Text="Businesses with 2018 annual taxable supplies that do not exceed SAR 1 million may select an effective registration date up to 1/1/2019." FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <custom:CustomLabel  Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="7."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                        <Span Text="I admit my compliance to meet all the requirements and procedures prescribed in the VAT Law and its Implementing Regulations including without limits the below. In the case of non-restriction of VAT system, the General Authority for Zakat and Tax (GAZT) has the full right to apply the proper procedures in accordance with the rules and regulations.* Registration during the specified period, according to the VAT Law and its Regulations.* Submitting VAT filing on time based on the annual revenues.* Paying VAT payments and any related penalties within the specified period, according to the Regulations* Providing all the information, documents and records requested by the GAZT within the specified period, according to the Regulations.* Not issue a tax invoice without being effectively registered for VAT purposes.* Keeping tax invoices, records and accounting documents within the period which were stipulated by the Regulations* GAZT has the right to reassess the submitted filings in accordance with the VAT Law and its Regulations* GAZT has the right to reassess the non-submitted filing in accordance with the VAT Law and its Regulations" FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <!--<Span Text="{x:Static custom2:AppResources.ZVatClickFaqInstructions}" >
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"></TapGestureRecognizer>
                                            </Span.GestureRecognizers>
                                        </Span>--><!--
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <Label Grid.Row="6" Text="{x:Static custom2:AppResources.ZVatClickFaqInstructions}" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"  FontFamily="{StaticResource GAZT_FONT_REGULAR}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.onFaqSectionClicked}"></TapGestureRecognizer>
                                                </Label.GestureRecognizers>
                                            </Label>-->
                                            <CheckBox x:Name="chkDeclaration"  VerticalOptions="CenterAndExpand"   Grid.Row="9" Margin="10,0,10,0" Grid.Column="0">
                                                <CheckBox.Triggers>
                                                    <DataTrigger TargetType="CheckBox"  Value="false">
                                                        <Setter Property="Color" Value="#ff0000" />
                                                    </DataTrigger>
                                                </CheckBox.Triggers>
                                            </CheckBox>
                                            <custom:CustomLabel  Grid.Row="9" Grid.Column="1"  Margin="0,0,0,5"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="I agree with these conditions and proceed further."  FontFamily="{StaticResource GAZT_FONT_MEDIUM}" FontSize="12"/>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>


                                        </Grid>
                                    </ScrollView>
                                </Grid>

                                <!--TaxPayers Details-->
                                <Grid Grid.Row="0" Grid.Column="0"  Padding="0,10,0,0" IsVisible="{Binding IsTaxPayersVisible}"
                          x:Name="TaxPayersDetailsView">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <StackLayout Grid.Row="0">
                                        <Label Text="TaxPayers Details"  VerticalOptions="Center" FontSize="Large" TextColor="Black" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
                                        <Label Text="Complete the Below Details" FontFamily="{StaticResource SSTArBold}"/>
                                        <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,15"/>
                                    </StackLayout>
                                    <ScrollView Grid.Row="1">
                                        <Grid Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" 
                              ColumnSpacing="0" RowSpacing="15" BackgroundColor="White">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <!--Start Of Read Only or pre-populated-->
                                            <StackLayout Grid.Row="0">
                                                <Label  Text="TIN" Padding="15,0,15,0"/>
                                                <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry Text="123456124" FontSize="Small" IsReadOnly="True"
                                                            Placeholder="ID Number" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                        <Entry.Behaviors>
                                                            <custom1:OnlyNumericValuesBehaviour/>
                                                        </Entry.Behaviors>
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                            </StackLayout>
                                            <StackLayout Grid.Row="1">
                                                <Label Text="Name" Padding="15,0,15,0"/>
                                                <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry Text="xyz abc" FontSize="Small" IsReadOnly="True" Placeholder="ID Number" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                        <Entry.Behaviors>
                                                            <custom1:OnlyNumericValuesBehaviour/>
                                                        </Entry.Behaviors>
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                            </StackLayout>
                                            <StackLayout Grid.Row="2">
                                                <Label Text="Main Outlet CR/License" Padding="15,0,15,0"/>
                                                <inputLayout:SfTextInputLayout Margin="0,-6,0,-6" 
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry Text="4545687912" FontSize="Small" Placeholder="ID Number" 
                                                            IsReadOnly="True" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                        <Entry.Behaviors>
                                                            <custom1:OnlyNumericValuesBehaviour/>
                                                        </Entry.Behaviors>
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                                <inputLayout:SfTextInputLayout Margin="0,-6,0,-6" 
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry Text="4545687912" FontSize="Small" Placeholder="ID Number" 
                                                            IsReadOnly="True" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                        <Entry.Behaviors>
                                                            <custom1:OnlyNumericValuesBehaviour/>
                                                        </Entry.Behaviors>
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                            </StackLayout>
                                            <StackLayout Grid.Row="3">
                                                <Label Text="Business Start Date" Padding="15,0,15,0"/>
                                                <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <StackLayout Orientation="Horizontal">
                                                        <custom:BorderlessEntry Text="dd/mm/yyyy" FontSize="Small" Placeholder="ID Number" 
                                                            IsReadOnly="True" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                        </custom:BorderlessEntry>
                                                        <Image HorizontalOptions="EndAndExpand" Rotation="270">
                                                            <Image.Source>
                                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="25"
                                                    Glyph="{x:Static FontImage:IconFonts.LessThan}"/>
                                                            </Image.Source>
                                                        </Image>
                                                    </StackLayout>
                                                </inputLayout:SfTextInputLayout>
                                            </StackLayout>
                                            <StackLayout Grid.Row="4">
                                                <Label Text="Address" Padding="15,0,15,0"/>
                                                <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry Text="21" FontSize="Small" Placeholder="ID Number" 
                                                            IsReadOnly="True" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                                <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry Text="abc Region" FontSize="Small" Placeholder="ID Number" 
                                                            IsReadOnly="True" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                            </StackLayout>
                                            <!--End Of Read Only or pre-populated-->
                                            <!--Start Of Additional Information-->
                                            <StackLayout Grid.Row="5">
                                                <Label Text="Additional Information"  VerticalOptions="Center" FontSize="Large" TextColor="Black"/>
                                                <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,15"/>
                                            </StackLayout>

                                            <StackLayout Grid.Row="6">
                                                <Label Text="Importer or Exporter" Padding="15,0,15,0"/>
                                                <StackLayout Orientation="Horizontal" Padding="15,0,15,0">
                                                    <Label Text="Importer" TextColor="Black" />
                                                    <Switch x:Name="ImporterSwitch"/>
                                                    <Button x:Name="btnImporter" Text="Attachment" Clicked="btnImporter_Clicked" BackgroundColor="#d49504"
                                                    TextColor="White" Padding="10" CornerRadius="8"/>
                                                </StackLayout>
                                                <StackLayout Orientation="Horizontal" Padding="15,0,15,0">
                                                    <Label Text="Exporter" TextColor="Black"/>
                                                    <Switch x:Name="ExporterSwitch"/>
                                                    <Button x:Name="btnExporter" Text="Attachment" Clicked="btnExporter_Clicked" BackgroundColor="#d49504"
                                                    TextColor="White" Padding="10" CornerRadius="8"/>
                                                </StackLayout>
                                            </StackLayout>

                                            <StackLayout Grid.Row="7">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Label Grid.Row="0" Text="Account" Padding="15,0,15,0"/>
                                                    <inputLayout:SfTextInputLayout Grid.Row="1" Margin="10,-6,10,-6"
                                            ContainerType="Outlined" x:Name="FrmNewAccount" UnfocusedColor= "#B1B1B1"
                                            OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                                        <StackLayout Orientation="Horizontal" Padding="5,5,5,5">
                                                            <Image>
                                                                <Image.Source>
                                                                    <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="25"
                                                    Glyph="{x:Static FontImage:IconFonts.PlusCircleOutline}"/>
                                                                </Image.Source>
                                                            </Image>

                                                            <Label Text="New Account" TextColor="DarkGreen" VerticalTextAlignment="Center"/>
                                                            <Image HorizontalOptions="EndAndExpand">
                                                                <Image.Source>
                                                                    <FontImageSource FontFamily="UserIconFont" Color="LightGray" Size="20"
                                                    Glyph="{x:Static FontImage:IconFonts.Close}"/>
                                                                </Image.Source>
                                                            </Image>
                                                        </StackLayout>
                                                    </inputLayout:SfTextInputLayout>
                                                    <Button Grid.Row="1" x:Name="NewAccount" BackgroundColor="Transparent" Clicked="NewAccount_Clicked" Margin="0,0,0,0" />
                                                </Grid>
                                            </StackLayout>

                                            <StackLayout Grid.Row="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50*"/>
                                                        <ColumnDefinition Width="50*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <cards:SfCardView Grid.Column="0" HasShadow="True"  Margin="3" Padding="0" ShadowColor="#5d6770" 
                                                          BackgroundColor="DarkGreen" CornerRadius="3" HorizontalOptions="FillAndExpand">
                                                        <StackLayout Padding="10">
                                                            <Image HorizontalOptions="EndAndExpand">
                                                                <Image.Source>
                                                                    <FontImageSource FontFamily="UserIconFont" Color="White" Size="20"
                                                    Glyph="{x:Static FontImage:IconFonts.BoxShadow}"/>
                                                                </Image.Source>
                                                            </Image>
                                                            <Label Text="...1234" TextColor="White"/>
                                                            <Label Text="Inma Bank" TextColor="White"/>
                                                        </StackLayout>
                                                    </cards:SfCardView>
                                                    <cards:SfCardView Grid.Column="1" HasShadow="True"  Margin="3" Padding="0" ShadowColor="#5d6770" 
                                                          BackgroundColor="White" CornerRadius="3" HorizontalOptions="FillAndExpand">
                                                        <StackLayout Padding="10">
                                                            <Image HorizontalOptions="EndAndExpand">
                                                                <Image.Source>
                                                                    <FontImageSource FontFamily="UserIconFont" Color="Black" Size="20"
                                                    Glyph="{x:Static FontImage:IconFonts.BoxShadow}"/>
                                                                </Image.Source>
                                                            </Image>
                                                            <Label Text="...1234" TextColor="Black"/>
                                                            <Label Text="Inma Bank" TextColor="Black"/>
                                                        </StackLayout>
                                                    </cards:SfCardView>
                                                </Grid>
                                            </StackLayout>

                                            <StackLayout Grid.Row="9">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Label Grid.Row="0" Text="VAT Eligible Start Date" Padding="15,0,15,0"/>
                                                    <inputLayout:SfTextInputLayout Grid.Row="1" Margin="10,-6,10,-6"
                                            ContainerType="Outlined" x:Name="FrmEStartDate" UnfocusedColor= "#B1B1B1"
                                            OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                                        <StackLayout Orientation="Horizontal">
                                                            <custom:BorderlessEntry  x:Name="DateEntry" Focused="DateEntry_Focused"  IsEnabled="False" Unfocused="DateEntry_Unfocused" Placeholder="yyyy/MM/dd" FontSize="Small">
                                                            </custom:BorderlessEntry>
                                                            <Image HorizontalOptions="EndAndExpand">
                                                                <Image.Source>
                                                                    <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="25"
                                                    Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"/>
                                                                </Image.Source>
                                                            </Image>
                                                        </StackLayout>
                                                    </inputLayout:SfTextInputLayout>
                                                    <Button Grid.Row="1" x:Name="btn1" BackgroundColor="Transparent" Clicked="btn1_Clicked" Margin="0,0,0,0" />
                                                    <custom1:CustomDatePicker Grid.Row="1"
								ShowHeader="false"
								Margin="2" 
