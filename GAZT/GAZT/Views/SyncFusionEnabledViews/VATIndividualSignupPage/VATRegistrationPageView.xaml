<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:EGAZT"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
		     xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#005e4b"
             xmlns:system="clr-namespace:System;assembly=netstandard"
             xmlns:custom2="clr-namespace:EGAZT"
             NavigationPage.BackButtonTitle = ""
              Title="{x:Static custom2:AppResources.ZZZZVatRegistrationTile}"
             xmlns:local1="clr-namespace:GAZT"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             FlowDirection="RightToLeft"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.VATRegistrationPageView"
             BackgroundImageSource="partials_background.png">
    <!--ZZZZVatRegistrationTile-->
    <ContentPage.Resources>
        <ResourceDictionary>
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
                <ResourceDictionary Source="..\CommonStyle\StylesNewUI.xaml" />
          
            </ResourceDictionary.MergedDictionaries>
            
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            
             <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10"/>
                <Setter Property="WidthRequest" Value="10"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SSTArBold}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SSTArBold}"/>
            </Style>
            
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <yummy:PancakeView Grid.Row="1" CornerRadius="15,15,0,0" Padding="0">
                      <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,15,0,0" BackgroundColor="White" x:Name="VATRMainGrid">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="90*" />
                        <!--<RowDefinition Height="10*" />-->
                    </Grid.RowDefinitions>

                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="1" Grid.Column="0"  Margin="0" 
                  Padding="15,5,15,0" BackgroundColor="White" RowSpacing="0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="98*" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollView Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Never" HorizontalOptions="FillAndExpand">
                            <StackLayout BackgroundColor="White">

                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,0,0,10" BackgroundColor="White" RowSpacing="0" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid IsVisible="{Binding IsInstrunctionVisible}"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0"  Margin="0" Padding="15" BackgroundColor="White" RowSpacing="0" >
                                        <ScrollView HorizontalOptions="FillAndExpand" VerticalScrollBarVisibility="Never">
                                            <StackLayout BackgroundColor="White">

                                                <Label HorizontalTextAlignment="Start" Text="{x:Static custom2:AppResources.ZZZZVATREInstructionsandConditions}" Style="{StaticResource GAZTMediumBlackLabel}" Margin="0"/>

                                                <Label HorizontalTextAlignment="Start" TextColor="#d49504" Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditionsFirst}"  Style="{StaticResource GAZTSmallGoldLabel}" Margin="0"/>


                                                <custom:CustomLabel HorizontalOptions="Start" HorizontalTextAlignment="Start" Style="{StaticResource CaptionLabelBlack}"  Margin="0">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{x:Static custom2:AppResources.ZZZZVATRFAQ1}" TextColor="{StaticResource Secondary}">
                                                            </Span>
                                                            <Span Text="&#160;"/>
                                                            <Span Text="{x:Static custom2:AppResources.ZZZZVATRFAQ2}"  TextColor="#005e4b">
                                                                <Span.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="VATFaqTapped"></TapGestureRecognizer>
                                                                </Span.GestureRecognizers>
                                                            </Span>
                                                            <Span Text="&#160;"/>
                                                            <Span Text="{x:Static custom2:AppResources.ZZZZVATRFAQ3}" TextColor="{StaticResource NeutralGreay}"/>
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>
                                                <custom:CustomLabel HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand" HorizontalTextAlignment="Start"  Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="1."  />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions1}"  />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="2."   FontSize="11"/>
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions2}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel  VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="3." />
                                                            <Span  Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions3}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel  Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="4."  />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions4}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel  VerticalOptions="EndAndExpand" Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="5." />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions5}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel  Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="6."  />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions6}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel  Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="7."  />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions7}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <StackLayout Orientation="Horizontal">
                                                       <custom1:CheckboxCustom  IsChecked="{Binding IsInstrunctionChecked}" Style="{StaticResource CheckboxHeightWidth32}"
                                                                        x:Name="chkDeclaration"  VerticalOptions="CenterAndExpand"/>
                                                    <custom:CustomLabel   Style="{StaticResource GAZTMicroMediumGrayLabel}">
                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditionsAgreeCondition}"  />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                    </custom:CustomLabel>
                                                </StackLayout>

                                            </StackLayout>
                                        </ScrollView>
                                    </Grid>


                                    <!--TaxPayers Details-->
                                    <Grid Grid.Row="0" Grid.Column="0"  Padding="0,0,0,0" IsVisible="{Binding IsTaxPayersVisible}"
                          x:Name="TaxPayersDetailsView">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <StackLayout Grid.Row="0">
                                            <Label Text="{x:Static custom2:AppResources.ZZTaxPayerDetails}" Style="{StaticResource SectionTitleBlackBold}" VerticalOptions="Center"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontSize="28"/>
                                            <Label Text="{x:Static custom2:AppResources.ZZZZCompletethebelowdetails}" Style="{StaticResource BodyLabelGrey}"/>
                                            <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,15"/>
                                        </StackLayout>
                                        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never" >

                                            <Grid Padding="0" HorizontalOptions="FillAndExpand" BindingContext="{Binding VATRegistrationDetailsData.d}" VerticalOptions="FillAndExpand" 
                              ColumnSpacing="0" RowSpacing="15" BackgroundColor="White">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="20*"/>
                                                </Grid.RowDefinitions>
                                                <!--Start Of Read Only or pre-populated-->

                                                <StackLayout Grid.Row="0">
                                                    <Label  Text="{x:Static custom2:AppResources.TIN}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
                                        ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020"                                                                  
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0">
                                                        <custom:BorderlessEntry Text="{Binding Gpartz}"  IsReadOnly="True" Style="{StaticResource DefaultEntry}"
                                                            Placeholder="{x:Static custom2:AppResources.TINS}" TextColor="#bbbbbb" >
                                                            <Entry.Behaviors>
                                                                <custom1:OnlyNumericValuesBehaviour/>
                                                            </Entry.Behaviors>
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="1">
                                                    <Label Text="{x:Static custom2:AppResources.ZZName}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
                                        ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020"                                                                  
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0">
                                                        <custom:BorderlessEntry Text="{Binding TinNm}" Style="{StaticResource DefaultEntry}" IsReadOnly="True" >
                                                       </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="2">
                                                    <Label Text="{x:Static custom2:AppResources.ZZZVATRMainOutlet}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                                    <inputLayout:SfTextInputLayout Margin="0,-6,0,-6" 
                                        ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020"                                                                  
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0">
                                                        <custom:BorderlessEntry Text="{Binding CrNo}" Style="{StaticResource DefaultEntry}"
                                                            IsReadOnly="True" >
                                                            <Entry.Behaviors>
                                                                <custom1:OnlyNumericValuesBehaviour/>
                                                            </Entry.Behaviors>
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>

                                                    <inputLayout:SfTextInputLayout Margin="0,-6,0,-6" 
                                         ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020"                                                                  
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0">
                                                        <custom:BorderlessEntry Text="{Binding CrNm}" TextColor="#bbbbbb" FontSize="Small"  
                                                            IsReadOnly="True" Style="{StaticResource DefaultEntry}">
                                                      </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="3">
                                                    <Label Text="{x:Static custom2:AppResources.ZZZZVATRStartDate}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
                                       ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020"                                                                  
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0">
                                                        <StackLayout Orientation="Horizontal">
                                                            <!--Text="{Binding CrStdt}" StartdateToshow Text="{Binding StartdateToshow}"-->
                                                            <custom:BorderlessEntry x:Name="Entry_CrStdt" Style="{StaticResource DefaultEntry}" Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.StartdateToshow}"
                                                            IsReadOnly="True"  Margin="0">
                                                            </custom:BorderlessEntry>
                                                            <!--<Image HorizontalOptions="EndAndExpand" Rotation="270">
                                                            <Image.Source>
                                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="25"
                                                    Glyph="{x:Static FontImage:IconFonts.LessThan}"/>
                                                            </Image.Source>
                                                        </Image>-->
                                                        </StackLayout>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="4">
                                                    <Label Text="{x:Static custom2:AppResources.ZVatAddress}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6"      ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020"                                                                  
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0">
                                                        <custom:BorderlessEntry Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.AddressLineOne}"  
                                                            IsReadOnly="True" Style="{StaticResource DefaultEntry}">
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6"      ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020"                                                                  
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0">
                                                        <custom:BorderlessEntry Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.AddressLineTwo}"  Style="{StaticResource DefaultEntry}"
                                                            IsReadOnly="True" >
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="5">
                                                    <Label Text="{x:Static custom2:AppResources.ZZZVATRSource}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
                                        ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020"                                                                  
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0">
                                                        <custom:BorderlessEntry Text="{Binding Source}" Style="{StaticResource DefaultEntry}" IsReadOnly="True"  >
                                                            <!--<Entry.Behaviors>
                                                            <custom1:OnlyNumericValuesBehaviour/>
                                                        </Entry.Behaviors>-->
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Margin="0,0,0,15" Grid.Row="6">
                                                    <!-- <BoxView Style="{StaticResource lineSeperator}" Margin="0,5,0,20"/> -->
                                                    <!--<Label Text="Additional Information" TextColor="Black" Style="{StaticResource GAZTCaptionBlackLabel}"/>-->




                                                    <Label Text="{x:Static custom2:AppResources.VATRAdditionalInformation}"  Style="{StaticResource SectionTitleBlackBold}" FontSize="28"/>
                                                   
                                                    <Frame BorderColor="#bbbbbb" BackgroundColor="White" CornerRadius="10" Padding="15,20,15,20" HasShadow="False">
                                                        <StackLayout>

                                                            <Grid >
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto"/>

                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="20"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Image HorizontalOptions="Center" Grid.Row="0" Grid.Column="0" VerticalOptions="Start">
                                                                    <Image.Source>
                                                                        <FontImageSource FontFamily="UserIconFont" Color="#909090" Size="30"
                                                        Glyph="{x:Static FontImage:IconFonts.Information}"/>
                                                                    </Image.Source>
                                                                </Image>
                                                                <StackLayout Grid.Column="1" Grid.Row="0" Spacing="0" VerticalOptions="Start">
                                                                  <Label Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsFirstLine}" HorizontalOptions="Start" HorizontalTextAlignment="Start"  TextColor="Black" FontSize="11" FontFamily="{StaticResource GAZT_FONT_REGULAR}"/>
                                                                   <Label Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsSecondLine}" HorizontalOptions="Start" HorizontalTextAlignment="Start"  TextColor="Black" FontSize="11" FontFamily="{StaticResource GAZT_FONT_REGULAR}"/>

                                                                  <Label Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsThirdLine}" HorizontalOptions="Start" HorizontalTextAlignment="Start"  TextColor="Black" FontSize="11" FontFamily="{StaticResource GAZT_FONT_REGULAR}"/>

                                                                  <Label Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsFourthLine}" HorizontalOptions="Start" HorizontalTextAlignment="Start"  TextColor="Black" FontSize="11" FontFamily="{StaticResource GAZT_FONT_REGULAR}"/>

                                                                   <Label Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsFifthLine}" HorizontalOptions="Start" HorizontalTextAlignment="Start"  TextColor="Black" FontSize="11" FontFamily="{StaticResource GAZT_FONT_REGULAR}"/>
                                                                    
                                                                </StackLayout>
                                                            </Grid>
                                                        </StackLayout>

                                                    </Frame>

                                                </StackLayout>

                                                <StackLayout Grid.Row="7">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <!--<Label Grid.Row="0" Text="{x:Static custom2:AppResources.VATREligibleStartDate}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Style="{StaticResource GAZTSmallGrayLabelStyle}" Padding="0,0,0,0"/>-->
                                                        <custom:CustomLabel  Grid.Row="0"   Padding="0,0,0,0" HorizontalOptions="Start" Style="{StaticResource CaptionLabelGrey}">

                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span  Text="{x:Static custom2:AppResources.VATREligibleStartDate}"  />
                                                                    <Span  Text="*" TextColor="#ff0000"/>
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                        <inputLayout:SfTextInputLayout Grid.Row="1" Margin="0,-6,0,-6"
                                            ContainerType="Outlined" x:Name="FrmEStartDate"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020"                                                                  
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0" >
                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:BorderlessEntry  x:Name="DateEntry" Focused="DateEntry_Focused"  TextChanged="DateEntry_TextChanged_1" IsEnabled="False"
                                                                                         Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.VatEligibleStartDate}"
                                                                                         Unfocused="DateEntry_Unfocused"   Placeholder="DD/MM/YYYY" Style="{StaticResource DefaultEntry}"
                                                                                         >
                                                                </custom:BorderlessEntry>
                                                                <Image HorizontalOptions="EndAndExpand">
                                                                    <Image.Source>
                                                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="20"
                                                    Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"/>
                                                                    </Image.Source>
                                                                </Image>
                                                            </StackLayout>
                                                        </inputLayout:SfTextInputLayout>
                                                        <Button Grid.Row="1" x:Name="btn1" BackgroundColor="Transparent" Clicked="btn1_Clicked" Margin="0,0,0,0" />
                                                        <custom1:CustomDatePicker  FlowDirection="RightToLeft"  Grid.Row="1"
								ShowHeader="false"
								Margin="2" 
                              BackgroundColor="White"
                                OKButtonBackgroundColor="#EAF7CC"
                                CancelButtonBackgroundColor="#EAF7CC"
                                     HeaderBackgroundColor="White"
                                        SelectedItemTextColor="{StaticResource NeutralBlack}"
                                        BorderColor="Black"
								ShowFooter="False"
								 ShowColumnHeader="True"
                                             ColumnHeaderBackgroundColor="White"
								ColumnHeaderHeight="50"
                                PickerMode="Dialog"
								HeaderText="Date of Birth"
								x:Name="DpEStartDate"
                                       SelectionChanged="DpEStartDate_SelectionChanged"
                                     OKButtonTextColor="#006450" 
                                
                                             CancelButtonTextColor="#006450"
                            Closed="DpEStartDate_Closed"
                            SelectedItem="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.TodayDate}"
                            HorizontalOptions="FillAndExpand"
                                OkButtonClicked="DpEStartDate_OkButtonClicked"
                                CancelButtonClicked="DpEStartDate_CancelButtonClicked"
								ItemHeight="45" >
                                                            <custom1:CustomDatePicker.Behaviors>
                                                                <custom1:SfPickerBehavior />
                                                            </custom1:CustomDatePicker.Behaviors>
                                                        </custom1:CustomDatePicker>
                                                    </Grid>
                                                </StackLayout>

                                                <StackLayout Grid.Row="8">
                                                    <Label Text="{x:Static custom2:AppResources.VATRImportExport}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50*"/>
