                                            <Label Text=""  Grid.Row="1" Grid.Column="0"  Grid.ColumnSpan="2"  HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{x:Static custom2:AppResources.ZZZZVATRFAQ1}"/>
                                                        <Span Text="&#160;"/>
                                                        <Span Text="{x:Static custom2:AppResources.ZZZZVATRFAQ2}" TextColor="#005e4b">
                                                            <Span.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="VATFaqTapped"></TapGestureRecognizer>
                                                            </Span.GestureRecognizers>
                                                        </Span>
                                                        <Span Text="&#160;"/>
                                                        <Span Text="{x:Static custom2:AppResources.ZZZZVATRFAQ3}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <custom:CustomLabel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="1."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                        <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions1}"  FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <custom:CustomLabel  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2"  HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="2."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                        <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions2}" FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <custom:CustomLabel   Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="3."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                        <Span  Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions3}" FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <custom:CustomLabel  Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="4."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                        <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions4}" FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <custom:CustomLabel  Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="5."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                        <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions5}" FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <custom:CustomLabel  Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="6."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                        <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions6}" FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <custom:CustomLabel  Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="7."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                        <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions7}" FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <!--<Span Text="{x:Static custom2:AppResources.ZVatClickFaqInstructions}" >
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"></TapGestureRecognizer>
                                            </Span.GestureRecognizers>
                                        </Span>--><!--
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <Label Grid.Row="6" Text="{x:Static custom2:AppResources.ZVatClickFaqInstructions}" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"  FontFamily="{StaticResource GAZT_FONT_REGULAR}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.onFaqSectionClicked}"></TapGestureRecognizer>
                                                </Label.GestureRecognizers>
                                            </Label>-->
                                            <CheckBox x:Name="chkDeclaration"  VerticalOptions="CenterAndExpand" IsChecked="{Binding IsInstrunctionChecked}"  Grid.Row="9" Margin="10,0,10,0" Grid.Column="0">
                                                <CheckBox.Triggers>
                                                    <DataTrigger TargetType="CheckBox"  Value="false">
                                                        <Setter Property="Color" Value="#ff0000" />
                                                    </DataTrigger>
                                                </CheckBox.Triggers>
                                            </CheckBox>
                                            <custom:CustomLabel  Grid.Row="9" Grid.Column="1"  Margin="0,0,0,5"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditionsAgreeCondition}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}" FontSize="12"/>
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>


                                        </Grid>
                                    </ScrollView>
                                </Grid>

                                <!--TaxPayers Details-->
                                <Grid Grid.Row="0" Grid.Column="0"  Padding="0,10,0,0" IsVisible="{Binding IsTaxPayersVisible}"
                          x:Name="TaxPayersDetailsView">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <StackLayout Grid.Row="0">
                                        <Label Text="{x:Static custom2:AppResources.ZZTaxPayerDetails}" FontFamily="{StaticResource GAZT_FONT_BOLD}"  VerticalOptions="Center" FontSize="Large" TextColor="Black" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
                                        <Label Text="{x:Static custom2:AppResources.ZZZZCompletethebelowdetails}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                                        <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,15"/>
                                    </StackLayout>
                                    <ScrollView Grid.Row="1">

                                        <Grid Padding="0" HorizontalOptions="FillAndExpand" BindingContext="{Binding VATRegistrationDetailsData.d}" VerticalOptions="FillAndExpand" 
                              ColumnSpacing="0" RowSpacing="15" BackgroundColor="White">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="20*"/>
                                            </Grid.RowDefinitions>
                                            <!--Start Of Read Only or pre-populated-->
                                            <StackLayout Margin="0,0,0,15" Grid.Row="0">
                                                <Frame BorderColor="#bbbbbb" BackgroundColor="White" CornerRadius="10" Padding="15,20,15,20">
                                                    <StackLayout>

                                                        <Grid >
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto"/>

                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="20"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image HorizontalOptions="Center" Grid.Row="0" Grid.Column="0" VerticalOptions="Start">
                                                                <Image.Source>
                                                                    <FontImageSource FontFamily="UserIconFont" Color="#909090" Size="30"
                                                        Glyph="{x:Static FontImage:IconFonts.Information}"/>
                                                                </Image.Source>
                                                            </Image>
                                                            <StackLayout Grid.Column="1" Grid.Row="0" Spacing="0" VerticalOptions="Start">
                                                                <Label  TextColor="Black" FontSize="11" FontFamily="{StaticResource GAZT_FONT_REGULAR}">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <!--<Span Text="-"></Span>-->
                                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsFirstLine}"></Span>
                                                                            <Span Text="{x:Static system:Environment.NewLine}"/>
                                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsSecondLine}"></Span>
                                                                            <Span Text="{x:Static system:Environment.NewLine}"/>
                                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsThirdLine}"></Span>
                                                                            <Span Text="{x:Static system:Environment.NewLine}"/>
                                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsFourthLine}"></Span>
                                                                            <Span Text="{x:Static system:Environment.NewLine}"/>
                                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsFifthLine}"></Span>
                                                                            <Span Text="{x:Static system:Environment.NewLine}"/>
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </Label>
                                                                <!--<Label  TextColor="Black" FontFamily="{StaticResource GAZT_FONT_REGULAR}">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            --><!--<Span Text="-"></Span>--><!--
                                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsSecondLine}"></Span>
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </Label>
                                                                <Label  TextColor="Black" FontFamily="{StaticResource GAZT_FONT_REGULAR}">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            --><!--<Span Text="-"></Span>--><!--
                                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsThirdLine}"></Span>
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </Label>
                                                                <Label  FontFamily="{StaticResource GAZT_FONT_REGULAR}" TextColor="Black">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            --><!--<Span Text="-"></Span>--><!--
                                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsFourthLine}"></Span>
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </Label>
                                                                <Label  FontFamily="{StaticResource GAZT_FONT_REGULAR}" TextColor="Black">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            --><!--<Span Text="-"></Span>--><!--
                                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsFifthLine}"></Span>
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </Label>-->
                                                            </StackLayout>
                                                        </Grid>
                                                    </StackLayout>

                                                </Frame>

                                            </StackLayout>
                                            <StackLayout Grid.Row="1">
                                                <Label  Text="{x:Static custom2:AppResources.TIN}" Padding="0,0,0,0" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                                                <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry Text="{Binding Gpartz}" FontSize="Small" IsReadOnly="True" TextColor="#c7c7c7"
                                                            Placeholder="ID Number" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                        <Entry.Behaviors>
                                                            <custom1:OnlyNumericValuesBehaviour/>
                                                        </Entry.Behaviors>
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                            </StackLayout>
                                            <StackLayout Grid.Row="2">
                                                <Label Text="{x:Static custom2:AppResources.ZZName}" Padding="0,0,0,0" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                                                <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry Text="{Binding TinNm}" TextColor="#c7c7c7" FontSize="Small" IsReadOnly="True" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                        <!--<Entry.Behaviors>
                                                            <custom1:OnlyNumericValuesBehaviour/>
                                                        </Entry.Behaviors>-->
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                            </StackLayout>
                                            <StackLayout Grid.Row="3">
                                                <Label Text="{x:Static custom2:AppResources.ZZZVATRMainOutlet}" Padding="0,0,0,0" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                                                <inputLayout:SfTextInputLayout Margin="0,-6,0,-6" 
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry Text="{Binding CrNo}" TextColor="#c7c7c7" FontSize="Small" 
                                                            IsReadOnly="True" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                        <Entry.Behaviors>
                                                            <custom1:OnlyNumericValuesBehaviour/>
                                                        </Entry.Behaviors>
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                                <inputLayout:SfTextInputLayout Margin="0,-6,0,-6" 
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry Text="{Binding CrNm}" TextColor="#c7c7c7" FontSize="Small"  
                                                            IsReadOnly="True" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                        <!--<Entry.Behaviors>
                                                            <custom1:OnlyNumericValuesBehaviour/>
                                                        </Entry.Behaviors>-->
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                            </StackLayout>
                                            <StackLayout Grid.Row="4">
                                                <Label Text="{x:Static custom2:AppResources.ZZZZVATRStartDate}" Padding="0,0,0,0" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                                                <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <StackLayout Orientation="Horizontal"><!--Text="{Binding CrStdt}"-->
                                                        <custom:BorderlessEntry x:Name="Entry_CrStdt"  Text="{Binding StartdateToshow}" TextColor="#c7c7c7" FontSize="Small" 
                                                            IsReadOnly="True" Style="{StaticResource GAZTTextBoxStyleForEntry}" Margin="0">
                                                        </custom:BorderlessEntry>
                                                        <!--<Image HorizontalOptions="EndAndExpand" Rotation="270">
                                                            <Image.Source>
                                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="25"
                                                    Glyph="{x:Static FontImage:IconFonts.LessThan}"/>
                                                            </Image.Source>
                                                        </Image>-->
                                                    </StackLayout>
                                                </inputLayout:SfTextInputLayout>
                                            </StackLayout>
                                            <StackLayout Grid.Row="5">
                                                <Label Text="{x:Static custom2:AppResources.ZVatAddress}" Padding="0,0,0,0" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                                                <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.AddressLineOne}" TextColor="#c7c7c7" FontSize="Small" Placeholder="ID Number" 
                                                            IsReadOnly="True" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                                <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.AddressLineTwo}" TextColor="#c7c7c7" FontSize="Small" Placeholder="ID Number" 
                                                            IsReadOnly="True" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                            </StackLayout>

                                            <StackLayout Grid.Row="6">
                                                <Label Text="{x:Static custom2:AppResources.ZZZVATRSource}" Padding="0,0,0,0" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                                                <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                    <custom:BorderlessEntry Text="{Binding Source}" TextColor="#c7c7c7" FontSize="Small" IsReadOnly="True"  Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                        <!--<Entry.Behaviors>
                                                            <custom1:OnlyNumericValuesBehaviour/>
                                                        </Entry.Behaviors>-->
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
