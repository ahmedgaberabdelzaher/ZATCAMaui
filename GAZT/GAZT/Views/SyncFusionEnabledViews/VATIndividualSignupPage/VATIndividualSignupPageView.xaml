<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:EGAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.VATIndividualSignupPageView"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             NavigationPage.HasNavigationBar="False"
            BackgroundImageSource="partials_background.png" >  <!--BackgroundColor="DarkGreen"-->
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
        <yummy:PancakeView Grid.Row="0" BackgroundColor="White" CornerRadius="32,32,0,0" Padding="0">
            <StackLayout Padding="20">
                <Grid HorizontalOptions="FillAndExpand">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="Image_backArrow" Grid.Row="0" Grid.Column="0" HorizontalOptions="Start" VerticalOptions="Start" IsVisible="{Binding BackArrowVisible}"  Style="{StaticResource IconLabelStyle}" Text="{StaticResource Back}" >
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <!--<Image HorizontalOptions="Start">-->
                           
                            <!--<Image.Source>
                        <FontImageSource Color="Black" 
                                 FontFamily="UserIconFont"
                                 Glyph="{x:Static FontImage:IconFonts.ArchiveArrowDown}"
                            />
                    </Image.Source>-->
                <!--</Image>-->
                        <Image Source="ic_logo_gazt.png" Grid.Row="0" Grid.Column="1" WidthRequest="50" HeightRequest="50" VerticalOptions="Start" HorizontalOptions="CenterAndExpand">
                         
                        </Image>
                    </Grid>
                    <Label Text="{x:Static local:AppResources.ZTERNewAccount}"  FontSize="22" TextColor="{StaticResource PrimaryColor}" 
                       FontFamily="{StaticResource SomarBold}"/>
                    <Label  Text="{x:Static local:AppResources.ZZZZSelectthetypeofEntity}" FontSize="15" FontFamily="{StaticResource SomarBold}"/>
                <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,25"/>
                    <Grid Padding="0"><!--BackgroundColor="DarkGreen"-->
                        <Image x:Name="image_individual_tile" Grid.Row="0" Grid.Column="0"  Source="{Binding ImageIndividualTile}" Aspect="AspectFill"/>
                        <Frame Margin="5" CornerRadius="5" BackgroundColor="Transparent" HeightRequest="100">
                            <!--Text="Individual Registration"-->

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="70*"/>
                                    <RowDefinition Height="30*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30*"/>
                                    <ColumnDefinition Width="70*"/>
                                </Grid.ColumnDefinitions>

                                <Image x:Name="image_individual_icon" Grid.Row="0" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Source="{Binding ImageIndividualIcon }" Aspect="AspectFit"/>
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static local:AppResources.ZZZZIndividualSignupinVAT}"  TextColor="{Binding IndividualTileColor}"
                           VerticalOptions="End" FontSize="13" FontFamily="{StaticResource SomarBold}"/>
                            </Grid>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding IndividualRegistrationCommand}"/>
                            </Frame.GestureRecognizers>
                        </Frame>
                    </Grid>
                
                
               <!--Establishment signup block-->
                    <Grid Padding="0">
                       
                        <Image x:Name="image_estimated_tile" Grid.Row="0" Grid.Column="0"   Source="{Binding ImageEstimatedTile}" Aspect="AspectFill"/>
                        <Frame CornerRadius="5" Margin="5" BackgroundColor="Transparent"  HeightRequest="100">
                       
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="70*"/>
                                    <RowDefinition Height="30*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30*"/>
                                    <ColumnDefinition Width="70*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Row="0"  Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Source="{Binding ImageEstimatedIcon}" Aspect="AspectFit"/>
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static local:AppResources.ZZZZestablishmentsignup}"  TextColor="{Binding EstimatedTileColor}"
                           VerticalOptions="End" FontSize="13" FontFamily="{StaticResource SomarBold}"/>
                            </Grid>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EstablishmentSignupCommand}"/>
                            </Frame.GestureRecognizers>
                          
                        </Frame>
                            
                    </Grid>
                    <!--Establishment signup block-->
                </StackLayout>
        </yummy:PancakeView>
            <Grid Grid.Row="0"    Grid.Column="0"   IsVisible="{Binding IsLoading}" >
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="Center"
                                           IsBusy="{Binding IsLoading}"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="{StaticResource Primary}"/>
                    </StackLayout>
                    <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>