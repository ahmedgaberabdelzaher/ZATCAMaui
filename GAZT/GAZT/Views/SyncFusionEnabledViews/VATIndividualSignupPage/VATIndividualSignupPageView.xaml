<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:EGAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.VATIndividualSignupPageView"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="DarkGreen">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
        <yummy:PancakeView Grid.Row="0" BackgroundColor="White" CornerRadius="32,32,0,0" Padding="0">
            <StackLayout Padding="20">
                <StackLayout Orientation="Horizontal">
                <Image HorizontalOptions="Start">
                    <Image.Source>
                        <FontImageSource Color="Black" 
                                 FontFamily="UserIconFont"
                                 Glyph="{x:Static FontImage:IconFonts.ArchiveArrowDown}"
                            />
                    </Image.Source>
                </Image>
                        <Image Source="ic_logo_gazt.png" WidthRequest="50" HeightRequest="50" VerticalOptions="Start" HorizontalOptions="CenterAndExpand"/>
                </StackLayout>
                    <Label Text="{x:Static local:AppResources.ZTERNewAccount}"  FontSize="Large" TextColor="Black" 
                       FontFamily="{StaticResource SSTArBold}"/>
                    <Label  Text="{x:Static local:AppResources.ZZZZSelectthetypeofEntity}" FontFamily="{StaticResource SSTArBold}"/>
                <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,25"/>
                <StackLayout Padding="5">
                        <Frame CornerRadius="5" BackgroundColor="DarkGreen" HeightRequest="100"><!--Text="Individual Registration"-->
                            <Label  Text="{x:Static local:AppResources.ZZZZIndividualRegistration}" TextColor="{StaticResource WhiteTextColor}"
                           VerticalOptions="End" FontFamily="{StaticResource SSTArBold}"/>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding IndividualRegistrationCommand}"/>
                    </Frame.GestureRecognizers>
                </Frame>
                </StackLayout>
            </StackLayout>
        </yummy:PancakeView>
            <Grid Grid.Row="0"    Grid.Column="0"   IsVisible="{Binding IsLoading}" >
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="Center"
                                           IsBusy="{Binding IsLoading}"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#006450"/>
                    </StackLayout>
                    <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>