<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:EGAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.VATIndividualSignupPageView"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="DarkGreen">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <yummy:PancakeView BackgroundColor="White" CornerRadius="32,32,0,0" Padding="0">
            <StackLayout Padding="20">
                <StackLayout Orientation="Horizontal">
                <Image HorizontalOptions="Start">
                    <Image.Source>
                        <FontImageSource Color="Black" 
                                 FontFamily="UserIconFont"
                                 Glyph="{x:Static FontImage:IconFonts.ArchiveArrowDown}"
                            />
                    </Image.Source>
                </Image>
                <Image Source="icon.png" WidthRequest="50" HeightRequest="50" VerticalOptions="Start" HorizontalOptions="CenterAndExpand"/>
                </StackLayout>
                <Label Text="New Account" FontSize="Large" TextColor="Black" 
                       FontFamily="{StaticResource SSTArBold}"/>
                <Label Text="Select Entity Type" FontFamily="{StaticResource SSTArBold}"/>
                <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,25"/>
                <StackLayout Padding="5">
                <Frame CornerRadius="5" BackgroundColor="DarkGreen" HeightRequest="100">
                        <Label Text="Individual Registration" TextColor="{StaticResource WhiteTextColor}"
                           VerticalOptions="End" FontFamily="{StaticResource SSTArBold}"/>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding IndividualRegistrationCommand}"/>
                    </Frame.GestureRecognizers>
                </Frame>
                </StackLayout>
            </StackLayout>
        </yummy:PancakeView>
    </ContentPage.Content>
</ContentPage>