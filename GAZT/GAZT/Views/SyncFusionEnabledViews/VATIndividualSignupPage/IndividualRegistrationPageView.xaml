                                    <Grid Grid.Row="0" Grid.Column="0"  Padding="0,10,0,0"
                              x:Name="NationalAddressView" IsVisible="{Binding NationalAddressView}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <StackLayout Grid.Row="0">
                                            <Label Style="{StaticResource GAZTMediumBoldBlackLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}"  Text="{x:Static local:AppResources.ZZZZNationalAddress}"  VerticalOptions="Center"  TextColor="Black" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
                                            <Label Style="{StaticResource GAZTMediumGrayLabelStyle}" Text="{x:Static local:AppResources.ZZZZCompletethebelowdetails}" />
                                            <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,15"/>
                                        </StackLayout>
                                        <StackLayout Grid.Row="1">
                                            <ScrollView IsVisible="{Binding NationalAddressView}">
                                                <Grid Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
