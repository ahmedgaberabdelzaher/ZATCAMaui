                                                                <custom:CustomLabel Text="{x:Static local:AppResources.NDGregorian}"  HorizontalOptions="Start" Style="{StaticResource CaptionLabelBlack}"/>
                                                                <Switch x:Name="HijriCalSwitch" HorizontalOptions="CenterAndExpand" IsToggled="{Binding IsHijriCal}" Toggled="HijriCalSwitch_Toggled" />
                                                                <custom:CustomLabel  Text="{x:Static local:AppResources.NDHijri}" HorizontalOptions="End" Style="{StaticResource CaptionLabelBlack}"/>
                                                            </StackLayout>-->

                                                            <buttons:SfChipGroup Margin="0,10,0,0" x:Name="ChipGroup_statusFilter" Type="Choice"  HorizontalOptions="Start"  ChipBackgroundColor="Transparent"                                         ItemsSource="{Binding ChipDataFilterlist}" SelectedChipBackgroundColor="#F9F0DF"  ChipBorderColor="{StaticResource NeutralLightGrey}"  ChipBorderWidth="1" SelectionChanged="ChipGroup_statusFilter_SelectionChanged" VerticalOptions="Center" >
                                                                <buttons:SfChipGroup.ItemTemplate>
                                                                    <DataTemplate >
                                                                        <StackLayout WidthRequest="80" >
                                                                            <custom:CustomLabel Text="{Binding Text}" StyleId="OnBoardText" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" Style="{StaticResource CaptionLabelBlack}" />
                                                                        </StackLayout>
                                                                    </DataTemplate>
                                                                </buttons:SfChipGroup.ItemTemplate>
                                                            </buttons:SfChipGroup>

                                                        </StackLayout>
                                                        
                                                        <inputLayout:SfTextInputLayout Grid.Row="1" Margin="0,-6,0,-6"
                                        ContainerType="Outlined" x:Name="FrmDBO" UnfocusedColor= "#B1B1B1"
                                        OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="{Binding FrameDOBError}" >
                                                         
                                                                <custom:BorderlessEntry  x:Name="DateEntry"  FontFamily="{StaticResource SSTArLight}" Text ="{Binding DOBddyymm}" Focused="OnDateEntryFocussed"  IsEnabled="False" Unfocused="DatePicker_Unfocused" TextChanged="DateEntry_TextChanged" Placeholder="dd/MM/yyyy" FontSize="Small" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                                </custom:BorderlessEntry> <!--Placeholder="yyyy/MM/dd"-->
                                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                                <Image Source="calendar.png">
                                                                </Image>
                                                   </inputLayout:SfTextInputLayout.TrailingView>
                                                        </inputLayout:SfTextInputLayout>

                                                        <Button Grid.Row="1" x:Name="btn4" BackgroundColor="Transparent" Clicked="btnDate_Clicked" Margin="0,0,0,0" />

                                                        <custom1:CustomDatePicker  FlowDirection="RightToLeft"   Grid.Row="1"
								ShowHeader="false"
								Margin="2" 
                              BackgroundColor="White"

                                OKButtonBackgroundColor="#EAF7CC"
                                CancelButtonBackgroundColor="#EAF7CC"
                                     HeaderBackgroundColor="White"
                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                    BorderColor="Black"
                                                                                  
								ShowFooter="False"
								 ShowColumnHeader="True"
                                             ColumnHeaderBackgroundColor="White"
								ColumnHeaderHeight="50"
                                PickerMode="Dialog"
								HeaderText="Date of Birth"
								x:Name="SignUpDOB"
                          
                             OKButtonTextColor="#006450" 
Closed="SignUpDOB_Closed"                                
                                             CancelButtonTextColor="#006450"
                           
                            SelectedItem="{Binding TodayDate}"
                            HorizontalOptions="FillAndExpand"
                                OkButtonClicked="DOB_OkButtonClicked"
                                CancelButtonClicked="DOB_CancelButtonClicked"
								ItemHeight="45" >
                                                            <custom1:CustomDatePicker.Behaviors>
                                                                <custom1:SfPickerBehavior />
                                                            </custom1:CustomDatePicker.Behaviors>
                                                        </custom1:CustomDatePicker>
                                                        <custom1:CustomHijriDatePicker  FlowDirection="RightToLeft"   Grid.Row="1"
								ShowHeader="false"
								Margin="2" 
                              BackgroundColor="White"

                                OKButtonBackgroundColor="#EAF7CC"
                                CancelButtonBackgroundColor="#EAF7CC"
                                     HeaderBackgroundColor="White"
                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                    BorderColor="Black"
                                                                                  
								ShowFooter="False"
								 ShowColumnHeader="True"
                                             ColumnHeaderBackgroundColor="White"
								ColumnHeaderHeight="50"
                                PickerMode="Dialog"
								HeaderText="Date of Birth"
								x:Name="SignUpDOBHijri"
                          
                             OKButtonTextColor="#006450" 
Closed="SignUpDOB_Closed"                                
                                             CancelButtonTextColor="#006450"
                           
                            SelectedItem="{Binding TodayDateinHijri}"
                            HorizontalOptions="FillAndExpand"
                                OkButtonClicked="DOB_OkButtonClicked"
                                CancelButtonClicked="DOB_CancelButtonClicked"
								ItemHeight="45" >
                                                        </custom1:CustomHijriDatePicker>

                                                        

                                                    </Grid>
                                                </StackLayout>
                                                <StackLayout Grid.Row="3" Grid.Column="0" >

                                                    <custom:CustomLabel Style="{StaticResource GAZTSmallGrayLabelStyle}" Grid.Row="0"   Padding="0,0,0,0" HorizontalOptions="Start" >

                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{x:Static local:AppResources.ZZName}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" />
                                                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                    </custom:CustomLabel>

                                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
                                    ContainerType="Outlined" x:Name="FrmName" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="{Binding FrameNameError}" >
                                                        <custom:BorderlessEntry x:Name="EntryName" Unfocused="EntryName_Unfocused" TextChanged="EntryName_TextChanged" Text="{Binding Name}"  FontFamily="{StaticResource SSTArLight}"  IsSpellCheckEnabled="False"
                                                            FontSize="Small" Placeholder="{x:Static local:AppResources.ZZName}" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                            <Entry.Behaviors>
                                                                <custom1:AlphabetandArabicCharacters/>
                                                            </Entry.Behaviors>
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>
                                            </Grid>
                                        </ScrollView>
                                    </Grid>

