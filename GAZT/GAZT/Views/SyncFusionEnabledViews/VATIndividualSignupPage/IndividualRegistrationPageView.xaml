                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="1" Grid.Column="0" Text="Email"/>
                                            <Label Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="1" Grid.Column="1" Text="Test@gazt.gov.sa" TextColor="Black"/>


                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="2" Grid.Column="0" Text="Name"/>
                                            <Label Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="2" Grid.Column="1" Text="Name Name" TextColor="Black"/>

                                        </Grid>
                                    </StackLayout>
                                </Frame>
                            </StackLayout>
                        </Grid>
                        <!--Password-->
                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Padding="0,10,0,0"
                              x:Name="PasswordView" IsVisible="{Binding PasswordView}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <StackLayout Grid.Row="0">
                                <Label Style="{StaticResource GAZTMediumBoldBlackLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Text="Password"  VerticalOptions="Center"  TextColor="Black" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
                                <Label Style="{StaticResource GAZTMediumGrayLabelStyle}" Text="Create a Secure Password" />
                                <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,15"/>
                            </StackLayout>
                            <StackLayout Grid.Row="1">
                               
                                <Grid Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" 
                                        ColumnSpacing="0" RowSpacing="15" BackgroundColor="White">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="New Password" Padding="0,0,0,0"/>
                                        <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" ErrorColor="#B00020" HasError="False"
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b">
                                            <StackLayout Orientation="Horizontal">
                                                <custom:BorderlessEntry Text="{Binding Password}" FontSize="Small" WidthRequest="128" MaxLength="16"
                                                                Placeholder="New Password" IsPassword="True" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                </custom:BorderlessEntry>
                                                <Image HorizontalOptions="EndAndExpand">
                                                    <Image.Source>
                                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="25"
                                         Glyph="{x:Static FontImage:IconFonts.Eye}"/>
                                                    </Image.Source>
                                                </Image>
                                            </StackLayout>
                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>
                                    <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="Repeat Password" Padding="0,0,0,0"/>
                                        <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" ErrorColor="#B00020" HasError="False"
                                            ContainerType="Outlined" UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b">
                                            <StackLayout Orientation="Horizontal">
                                                <custom:BorderlessEntry Text="{Binding ConfirmPassword}" FontSize="Small" WidthRequest="128" MaxLength="16"
                                                                Placeholder="Repeat Password" IsPassword="True" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                </custom:BorderlessEntry>
                                                <Image HorizontalOptions="EndAndExpand">
                                                    <Image.Source>
                                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="25"
                                         Glyph="{x:Static FontImage:IconFonts.Eye}"/>
                                                    </Image.Source>
                                                </Image>
                                            </StackLayout>
                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>
                                    <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" >
                                        <StackLayout Orientation="Horizontal">
                                            <Image HorizontalOptions="EndAndExpand">
                                                <Image.Source>
                                                    <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="20"
                                                Glyph="{x:Static FontImage:IconFonts.CheckboxMarkedCircle}"/>
                                                </Image.Source>
                                            </Image>
                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="At least 8 Characters long"/>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <Image HorizontalOptions="EndAndExpand">
                                                <Image.Source>
                                                    <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="20"
                                                Glyph="{x:Static FontImage:IconFonts.CheckboxMarkedCircle}"/>
                                                </Image.Source>
                                            </Image>
                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="English Capital and small letters"/>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <Image HorizontalOptions="EndAndExpand">
                                                <Image.Source>
                                                    <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="20"
                                                Glyph="{x:Static FontImage:IconFonts.CheckboxMarkedCircle}"/>
                                                </Image.Source>
                                            </Image>
                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="Not exceed 16 Characters"/>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <Image HorizontalOptions="EndAndExpand">
                                                <Image.Source>
                                                    <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="20"
                                                Glyph="{x:Static FontImage:IconFonts.CheckboxMarkedCircle}"/>
                                                </Image.Source>
                                            </Image>
                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="Numbers and symbols"/>
                                        </StackLayout>
                                    </StackLayout>
                                </Grid>
                                <!--Verification Code-->
                                <Grid Padding="0,10,0,0" x:Name="VerificationCodeView">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <StackLayout Grid.Row="0">
                                        <Label Style="{StaticResource GAZTMediumBoldBlackLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Text="Verification Code"  VerticalOptions="Center"  TextColor="Black" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
                                        <Label Style="{StaticResource GAZTMediumGrayLabelStyle}" Text="Please enter Verification Code sent to your mobile" />
                                        <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,15"/>
                                    </StackLayout>
                                    <StackLayout Grid.Row="1">
                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="Mobile Number xxxxxx3388"/>

                                        <StackLayout Orientation="Horizontal">
                                            <Image>
                                                <Image.Source>
                                                    <FontImageSource Color="DarkGreen" FontFamily="UserIconFont" Size="20"
                                         Glyph="{x:Static FontImage:IconFonts.TimerOutline}"/>
                                                </Image.Source>
                                            </Image>
                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="0:59"/>
                                        </StackLayout>
                                    </StackLayout>
                                </Grid>
                            </StackLayout>
                        </Grid>
                        </Grid>
                    </StackLayout>
                </ScrollView>
                <!--</Grid>-->
                     <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0" VerticalOptions="End"  BackgroundColor="White" >
                            <buttons:SfButton x:Name="btnContinue" Text="Continue" CornerRadius="10" VerticalOptions="End" 
                                  HeightRequest="56" Command="{Binding OnContinueButtonClick}"    FontSize="15"   Grid.ColumnSpan="2" Style="{StaticResource SfButtonStyle}" BackgroundColor="#d49504" />
                        </StackLayout>
                    </Grid>
            </StackLayout>
        </yummy:PancakeView>
