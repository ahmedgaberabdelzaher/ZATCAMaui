<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:EGAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
		     xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.IndividualRegistrationPageView"
             BackgroundColor="#005e4b"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10"/>
                <Setter Property="WidthRequest" Value="10"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SSTArBold}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SSTArBold}"/>
            </Style>


        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <yummy:PancakeView Grid.Row="0" Grid.Column="0" BackgroundColor="White" CornerRadius="32,32,0,0" Padding="0,20,0,0">


                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="10,0,10,10" BackgroundColor="White">

                    <!-- Dot Images -->
                    <StackLayout >
                        <StackLayout Orientation="Horizontal">
                            <Image x:Name="Image_backArrow" HorizontalOptions="Start" VerticalOptions="Start" IsVisible="{Binding BackArrowVisible}" ><!--Rotation="270"-->
                                <Image.Source>
                                    <FontImageSource Color="Gray" FontFamily="UserIconFont" Size="20"
                                     Glyph="{x:Static FontImage:IconFonts.LessThan}"/>
                                </Image.Source>
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer  Command="{Binding OnBackButtonClick}"/>
                                </Image.GestureRecognizers>
                            </Image>
                            <Image Source="ic_logo_gazt.png" WidthRequest="50" HeightRequest="50" VerticalOptions="Start" HorizontalOptions="CenterAndExpand"/>
                            <Image HorizontalOptions="End" VerticalOptions="Start">
                                <Image.Source>
                                    <FontImageSource Color="Gray" FontFamily="UserIconFont" Size="20"
                                     Glyph="{x:Static FontImage:IconFonts.Close}"/>
                                </Image.Source>
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoButtonClick}"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>

                        <StackLayout Orientation="Horizontal" Padding="10,0,0,10">
                            <BoxView x:Name="BoxOne" CornerRadius="25" BackgroundColor="{Binding BoxColorOne}"/>
                            <BoxView x:Name="BoxTwo" CornerRadius="25" BackgroundColor="{Binding BoxColorTwo}"/>
                            <BoxView x:Name="BoxThree" CornerRadius="25" BackgroundColor="{Binding BoxColorThree}"/>
                            <BoxView x:Name="BoxFour" CornerRadius="25" BackgroundColor="{Binding BoxColorFour}"/>
                            <BoxView x:Name="BoxFive" CornerRadius="25" BackgroundColor="{Binding BoxColorFive}"/>
                        </StackLayout>
                    </StackLayout>
                    <!-- Dot Images End-->

                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  BackgroundColor="White" RowSpacing="0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="88*" />
                            <RowDefinition Height="12*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>




                        <ScrollView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="FillAndExpand">
                            <StackLayout BackgroundColor="White" Spacing="0" Padding="0" Margin="0">

                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,15,0,10" BackgroundColor="White" RowSpacing="0" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>


                                    <!--Individual Registration-->
                                    <Grid Grid.Row="0" Grid.Column="0"  Padding="0,10,0,0" Margin="0" 
                          x:Name="IndividualRegistrationView" IsVisible="{Binding IndividualRegistrationView}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackLayout Grid.Row="0">
                                            <Label Style="{StaticResource GAZTMediumBoldBlackLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Text="{x:Static local:AppResources.ZZZZIndividualRegistration}"  VerticalOptions="Center"  TextColor="Black" Grid.Row="0" Grid.Column="0" />
                                            <Label Style="{StaticResource GAZTMediumGrayLabelStyle}" Text="{x:Static local:AppResources.ZZZZCompletethebelowdetails}"  />
                                            <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,15"/>
                                        </StackLayout>

                                        <ScrollView Grid.Row="1">
                                            <Grid Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" 
                              ColumnSpacing="0" RowSpacing="15" BackgroundColor="White">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackLayout Grid.Column="0" Grid.Row="0" >
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <custom:CustomLabel Style="{StaticResource GAZTSmallGrayLabelStyle}" Grid.Row="0"   Padding="0,0,0,0" HorizontalOptions="Start" >

                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static local:AppResources.ZZIDType}"  />
                                                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                        <inputLayout:SfTextInputLayout Grid.Row="1" Margin="0,-6,0,-6" 
                                ContainerType="Outlined" x:Name="FrmIDType"  UnfocusedColor="#B1B1B1"
                                OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:BorderlessEntry Text="{Binding TxtIDType}" FontSize="Small" 
                                                        Placeholder="{x:Static local:AppResources.ZZIDType}" IsSpellCheckEnabled="False" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                                </custom:BorderlessEntry>
                                                                <Image HorizontalOptions="EndAndExpand" Rotation="270" ><!--Rotation="270"-->
                                                                    <Image.Source>
                                                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="20"
                                     Glyph="{x:Static FontImage:IconFonts.LessThan}"/>
                                                                    </Image.Source>
                                                                </Image>
                                                            </StackLayout>
                                                        </inputLayout:SfTextInputLayout>
                                                        <custom:CustomButton  Grid.Row="1" x:Name="btn1" Clicked="btn1_Clicked" FontSize="Small" BackgroundColor="Transparent" Margin="0,0,0,0"  >
                                                        </custom:CustomButton>

                                                        <syncfusion:SfPicker x:Name="DDlIDType" Grid.Row="1"
                                    HeaderHeight="40" ShowHeader="true" HeaderText="{x:Static local:AppResources.ZZIDType}"
                                    HeaderTextColor="White"
                                    UnSelectedItemFontSize="14" SelectedIndex="{Binding IDTypeIndex}"
                                    ColumnHeaderHeight="46"
                                    PickerMode="Dialog"
                              HeaderBackgroundColor="#006450"
                        SelectedItemTextColor="#006450"
                        BorderColor="Black"
                                                         
                                                 OKButtonTextColor="#006450"      
                                                 CancelButtonTextColor="#006450"
                                                 ShowColumnHeader="False"
                                                 ShowFooter="True"
                                                 OKButtonBackgroundColor="#EAF7CC"
                                                 CancelButtonBackgroundColor="#EAF7CC"
                                                 BackgroundColor="#EAF7CC"
                       ItemHeight="40"
                         DisplayMemberPath="Name" ItemsSource="{Binding IdTypeList}"  SelectionChanged="IDType_SelectedIndexChanged" Margin="0,0,0,0"
                        PickerHeight="200"
                        PickerWidth="270"
                         FooterHeight="46" OkButtonClicked="DDlIDType_OkayButtonClicked"  CancelButtonClicked="IDType_CancelButtonClicked">
                                                            <syncfusion:SfPicker.Behaviors>
                                                                <custom1:SfPickerBehavior />
                                                            </syncfusion:SfPicker.Behaviors>
                                                        </syncfusion:SfPicker>
                                                        <!--SelectedItem="{Binding SelectedSignUpUsing,Mode=TwoWay}"-->
                                                    </Grid>
                                                </StackLayout>

                                                <StackLayout Grid.Row="1" Grid.Column="0">

                                                    <custom:CustomLabel Style="{StaticResource GAZTSmallGrayLabelStyle}" Grid.Row="0"   Padding="0,0,0,0" HorizontalOptions="Start" >

                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{x:Static local:AppResources.IDNumber}"  />
                                                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                    </custom:CustomLabel>
                                                    <inputLayout:SfTextInputLayout  x:Name="FrmIDNumber" Margin="0,-6,0,-6" 
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="{Binding FrameIDError}">
                                                        <custom:BorderlessEntry Text="{Binding IdNumber}" x:Name="EntryIDNumber" Keyboard="Numeric" FontSize="Small" Unfocused="EntryIDNumber_Unfocused"  MaxLength="{Binding MaxLengthID}" IsSpellCheckEnabled="False"
                                                            TextChanged="GAZTBorderlessEntry_TextChanged" Placeholder="{x:Static local:AppResources.IDNumber}" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                            <!--<Entry.Behaviors>
                                            <custom1:OnlyNumericValuesBehaviour/>
                                        </Entry.Behaviors>-->
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="2" Grid.Column="0">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>

                                                        <custom:CustomLabel Style="{StaticResource GAZTSmallGrayLabelStyle}" Grid.Row="0"   Padding="0,0,0,0" HorizontalOptions="Start" >

                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static local:AppResources.ZZDateofBirth}"  />
                                                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>



                                                        <inputLayout:SfTextInputLayout Grid.Row="1" Margin="0,-6,0,-6"
                                        ContainerType="Outlined" x:Name="FrmDBO" UnfocusedColor= "#B1B1B1"
                                        OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="{Binding FrameDOBError}" >
                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:BorderlessEntry  x:Name="DateEntry" Text ="{Binding DOB}" Focused="OnDateEntryFocussed"  IsEnabled="False" Unfocused="DatePicker_Unfocused" TextChanged="DateEntry_TextChanged" Placeholder="yyyy/MM/dd" FontSize="Small" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                                </custom:BorderlessEntry>
                                                                <Image HorizontalOptions="EndAndExpand">
                                                                    <Image.Source>
                                                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="20"
                                                    Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"/>
                                                                    </Image.Source>
                                                                </Image>
                                                            </StackLayout>
                                                        </inputLayout:SfTextInputLayout>

                                                        <Button Grid.Row="1" x:Name="btn4" BackgroundColor="Transparent" Clicked="btnDate_Clicked" Margin="0,0,0,0" />

                                                        <custom1:CustomDatePicker Grid.Row="1"
								ShowHeader="false"
								Margin="2" 
                              BackgroundColor="#EAF7CC"
                                OKButtonBackgroundColor="#EAF7CC"
                                CancelButtonBackgroundColor="#EAF7CC"
                                     HeaderBackgroundColor="#006450"
                    SelectedItemTextColor="#006450"
                    BorderColor="Black"
								ShowFooter="True"
								 ShowColumnHeader="True"
                                             ColumnHeaderBackgroundColor="#EAF7CC"
								ColumnHeaderHeight="50"
                                PickerMode="Dialog"
								HeaderText="Date of Birth"
								x:Name="SignUpDOB"
                          
                             OKButtonTextColor="#006450" 
                                
                                             CancelButtonTextColor="#006450"
                           
                            SelectedItem="{Binding TodayDate}"
                            HorizontalOptions="FillAndExpand"
                                OkButtonClicked="DOB_OkButtonClicked"
                                CancelButtonClicked="DOB_CancelButtonClicked"
								ItemHeight="45" >
                                                            <custom1:CustomDatePicker.Behaviors>
                                                                <custom1:SfPickerBehavior />
                                                            </custom1:CustomDatePicker.Behaviors>
                                                        </custom1:CustomDatePicker>
                                                    </Grid>
                                                </StackLayout>
                                                <StackLayout Grid.Row="3" Grid.Column="0" >

                                                    <custom:CustomLabel Style="{StaticResource GAZTSmallGrayLabelStyle}" Grid.Row="0"   Padding="0,0,0,0" HorizontalOptions="Start" >

                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{x:Static local:AppResources.ZZName}"  />
                                                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                    </custom:CustomLabel>

                                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
                                    ContainerType="Outlined" x:Name="FrmName" UnfocusedColor="#B1B1B1"
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="{Binding FrameNameError}" >
                                                        <custom:BorderlessEntry x:Name="EntryName" Unfocused="EntryName_Unfocused" TextChanged="EntryName_TextChanged" Text="{Binding Name}" IsSpellCheckEnabled="False"
                                                            FontSize="Small" Placeholder="{x:Static local:AppResources.ZZName}" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                            <Entry.Behaviors>
                                                                <custom1:AlphabetandArabicCharacters/>
                                                            </Entry.Behaviors>
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>
                                            </Grid>
                                        </ScrollView>
                                    </Grid>

                                    <!--National Address-->
