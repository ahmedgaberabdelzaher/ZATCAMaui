                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="0" Grid.Column="0" Text="{x:Static local:AppResources.ZZIDType}" />
                                                        <Label Text="{Binding TxtIDType}" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="0" Grid.Column="1"  TextColor="Black"/>


                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="1" Grid.Column="0"  Text="{x:Static local:AppResources.IDNumber}"/>
                                                        <Label Text="{Binding IdNumber}" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="1" Grid.Column="1" TextColor="Black"/>


                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="2" Grid.Column="0" Text="{x:Static local:AppResources.ZZName}"  />
                                                        <Label Text="{Binding Name}" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="2" Grid.Column="1"  TextColor="Black"/>

                                                    </Grid>
                                                </StackLayout>
                                            </Frame>
                                            <!--National Address-->
                                            <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" Margin="0,20,0,0">
                                                <StackLayout>
                                                    <StackLayout Orientation="Horizontal" Padding="10,5,10,10" HeightRequest="30">
                                                        <Image VerticalOptions="Center">
                                                            <Image.Source>
                                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="30"
                                                        Glyph="{x:Static FontImage:IconFonts.CrosshairsGps}"/>
                                                            </Image.Source>
                                                        </Image>
                                                        <Label Style="{StaticResource GAZTMediumBoldBlackLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" VerticalOptions="Center" Text="{x:Static local:AppResources.ZZZZNationalAddress}"    FontSize="Medium" TextColor="Black"/>
                                                    </StackLayout>
                                                    <BoxView Style="{StaticResource lineSeperator}"/>
                                                    <Grid Padding="10,5,10,10">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40*"/>
                                                            <ColumnDefinition Width="50*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="0" Grid.Column="0" Text="{x:Static local:AppResources.ZZZZCity}" />
                                                        <Label Text="{Binding CityName}" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="0" Grid.Column="1"  TextColor="Black"/>


                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="1" Grid.Column="0" Text="{x:Static local:AppResources.ZZZZNeighborhood}"   />
                                                        <Label Text="{Binding Neighborhood}" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="1" Grid.Column="1"  TextColor="Black"/>


                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="2" Grid.Column="0" Text="{x:Static local:AppResources.ZZZZPostalCode}"  />
                                                        <Label Text="{Binding PostalCode}" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="2" Grid.Column="1"  TextColor="Black"/>


                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="3" Grid.Column="0" Text="{x:Static local:AppResources.ZZZZBuildingNumber}"  />
                                                        <Label Text="{Binding BuildingNumber}" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="3" Grid.Column="1"  TextColor="Black"/>


                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="4" Grid.Column="0" Text="{x:Static local:AppResources.ZZZZUnitNumber}" />
                                                        <Label Text="{Binding UnitNumber}" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="4" Grid.Column="1"  TextColor="Black"/>

                                                    </Grid>
                                                </StackLayout>
                                            </Frame>
                                            <!--Contact Information-->
                                            <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" Margin="0,20,0,0">
                                                <StackLayout>
                                                    <StackLayout Orientation="Horizontal" Padding="10,5,10,10" HeightRequest="30">
                                                        <Image VerticalOptions="Center">
                                                            <Image.Source>
                                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="30"
                                                        Glyph="{x:Static FontImage:IconFonts.Phone}"/>
                                                            </Image.Source>
                                                        </Image>
                                                        <Label Style="{StaticResource GAZTMediumBoldBlackLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" VerticalOptions="Center" Text="{x:Static local:AppResources.ZZZContactInformation}"   FontSize="Medium" TextColor="Black"/>
                                                    </StackLayout>
                                                    <BoxView Style="{StaticResource lineSeperator}"/>
                                                    <Grid Padding="10,5,10,10">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40*"/>
                                                            <ColumnDefinition Width="50*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="0" Grid.Column="0" Text="{x:Static local:AppResources.ZZMobileNumber}" />
                                                        <Label Text="{Binding MobileNumber}"  Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="0" Grid.Column="1" TextColor="Black"/>


                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="1" Grid.Column="0" Text="{x:Static local:AppResources.Email}" />
                                                        <Label Text="{Binding Email}"  Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="1" Grid.Column="1"  TextColor="Black"/>


                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="2" Grid.Column="0" Text="{x:Static local:AppResources.ZZName}"/>
                                                        <Label Text="{Binding Name}" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="2" Grid.Column="1" TextColor="Black"/>

                                                    </Grid>
                                                </StackLayout>
                                            </Frame>
                                        </StackLayout>
                                    </Grid>
                                    <!--Password-->
                                    <Grid Grid.Row="0" Grid.Column="0"  Padding="0,10,0,0"
                              x:Name="PasswordView" IsVisible="{Binding PasswordView}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <StackLayout Grid.Row="0">
                                            <Label Style="{StaticResource GAZTMediumBoldBlackLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}"   Text="{x:Static local:AppResources.Password}"  VerticalOptions="Center"  TextColor="Black" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
                                            <Label Style="{StaticResource GAZTMediumGrayLabelStyle}" Text="{x:Static local:AppResources.ZZZZCreateasecurePassword}"   />
                                            <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,15"/>
                                        </StackLayout>
                                        <StackLayout Grid.Row="1">
                                            <ScrollView>
                                                <StackLayout>
                                                    <Grid Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" 
                                        ColumnSpacing="0" RowSpacing="15" BackgroundColor="White">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!--Text="OTP"-->
                                                        <!--<StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{x:Static local:AppResources.EnterOTP}"   Padding="0,0,0,0"/>
                                                        <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" ErrorColor="#B00020" HasError="{Binding FrameOTPError}"
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b">
                                            <StackLayout Orientation="Horizontal">
                                                <custom:BorderlessEntry Text="{Binding OTP}" FontSize="Small" WidthRequest="128" MaxLength="16"
                                                                Placeholder="{x:Static local:AppResources.EnterOTP}" IsPassword="{Binding IsOTPEncripted}" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                </custom:BorderlessEntry>
                                                <Image HorizontalOptions="EndAndExpand" x:Name="ImageSeeOtp">
                                                    <Image.Source>
                                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="25"
                                         Glyph="{x:Static FontImage:IconFonts.Eye}"/>
                                                    </Image.Source>
                                                                    <Image.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="ImageSeeOtp_Tapped"/>
                                                                    </Image.GestureRecognizers>
                                                                </Image>
                                            </StackLayout>
                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>-->


                                                        <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{x:Static local:AppResources.NewPassword}"  Padding="0,0,0,0"/>
                                                            <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" ErrorColor="#B00020" HasError="{Binding FramePasswordError}"
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b">
                                                                <StackLayout Orientation="Horizontal">
                                                                    <custom:BorderlessEntry Text="{Binding Password}" FontSize="Small" WidthRequest="128" MaxLength="16"
                                                                Placeholder="{x:Static local:AppResources.NewPassword}" IsPassword="{Binding IsPasswordEncripted}" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                                    </custom:BorderlessEntry>
                                                                    <Image HorizontalOptions="EndAndExpand" x:Name="ImageSeePassword">
                                                                        <Image.Source>
                                                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="25"
                                         Glyph="{x:Static FontImage:IconFonts.Eye}"/>
                                                                        </Image.Source>
                                                                        <Image.GestureRecognizers>
                                                                            <TapGestureRecognizer Tapped="ImageSeePassword_Tapped"/>
                                                                        </Image.GestureRecognizers>
                                                                    </Image>
                                                                </StackLayout>
                                                            </inputLayout:SfTextInputLayout>
                                                        </StackLayout>

                                                        <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{x:Static local:AppResources.ZZZZRepeatPassword}"  Padding="0,0,0,0"/>
                                                            <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" ErrorColor="#B00020" HasError="{Binding FrameConfirmPasswordError}"
                                            ContainerType="Outlined" UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b">
                                                                <StackLayout Orientation="Horizontal">
                                                                    <custom:BorderlessEntry x:Name="EntryConfirmPassword" Text="{Binding ConfirmPassword}" FontSize="Small" WidthRequest="128" MaxLength="16" TextChanged="EntryConfirmPassword_TextChanged"
                                                                        
                                                                Placeholder="{x:Static local:AppResources.ZZZZRepeatPassword}" IsPassword="{Binding IsConfirmPasswordEncripted}" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                                    </custom:BorderlessEntry>
                                                                    <Image HorizontalOptions="EndAndExpand" x:Name="ImageSeeConfirmPassword" >
                                                                        <Image.Source>
                                                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="25"
                                         Glyph="{x:Static FontImage:IconFonts.Eye}"/>
                                                                        </Image.Source>
                                                                        <Image.GestureRecognizers>
                                                                            <TapGestureRecognizer Tapped="ImageSeeConfirmPassword_Tapped"/>
                                                                        </Image.GestureRecognizers>

                                                                    </Image>
                                                                </StackLayout>
                                                            </inputLayout:SfTextInputLayout>
                                                        </StackLayout>

                                                        <StackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" >
                                                            <StackLayout Orientation="Horizontal">
                                                                <Image HorizontalOptions="Start">
                                                                    <Image.Source>
                                                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="20"
                                                Glyph="{x:Static FontImage:IconFonts.CheckboxMarkedCircle}"/>
                                                                    </Image.Source>
                                                                </Image>
                                                                <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{x:Static local:AppResources.ZZZZAtleast8characterslong}" />
                                                            </StackLayout>
                                                            <StackLayout Orientation="Horizontal">
                                                                <Image HorizontalOptions="Start">
                                                                    <Image.Source>
                                                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="20"
                                                Glyph="{x:Static FontImage:IconFonts.CheckboxMarkedCircle}"/>
                                                                    </Image.Source>
                                                                </Image>
                                                                <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{x:Static local:AppResources.ZZZZEnglishcapitalandsmallletters}" />
                                                            </StackLayout>
                                                            <StackLayout Orientation="Horizontal">
                                                                <Image HorizontalOptions="Start">
                                                                    <Image.Source>
                                                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="20"
                                                Glyph="{x:Static FontImage:IconFonts.CheckboxMarkedCircle}"/>
                                                                    </Image.Source>
                                                                </Image>
                                                                <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{x:Static local:AppResources.ZZZZNotexceed16characters}" />
                                                            </StackLayout>

                                                            <StackLayout Orientation="Horizontal">
                                                                <Image HorizontalOptions="Start">
                                                                    <Image.Source>
                                                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="20"
                                                Glyph="{x:Static FontImage:IconFonts.CheckboxMarkedCircle}"/>
                                                                    </Image.Source>
                                                                </Image>
                                                                <Label Style="{StaticResource GAZTSmallGrayLabelStyle}"   Text="{x:Static local:AppResources.ZZZZNumbersandsymbols}"/>
                                                            </StackLayout>
                                                        </StackLayout>
                                                    </Grid>
                                                    <!--Verification Code-->
                                                    <Grid Padding="0,10,0,0" x:Name="VerificationCodeView">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <StackLayout Grid.Row="0">
                                                            <Label Style="{StaticResource GAZTMediumBoldBlackLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}"   Text="{x:Static local:AppResources.VerificationCode}"  VerticalOptions="Center"  TextColor="Black" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
                                                            <Label Style="{StaticResource GAZTMediumGrayLabelStyle}"  Text="{x:Static local:AppResources.EnterVerificationCode}"   />
                                                            <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,15"/>
                                                        </StackLayout>
                                                        <StackLayout Grid.Row="1">
                                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{Binding EncriptedMobileNumber}"/>

                                                            <StackLayout Orientation="Horizontal">
                                                                <Image>
                                                                    <Image.Source>
                                                                        <FontImageSource Color="DarkGreen" FontFamily="UserIconFont" Size="20"
                                         Glyph="{x:Static FontImage:IconFonts.TimerOutline}"/>
                                                                    </Image.Source>
                                                                </Image>
                                                                <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{Binding OTPValidDuration}"/>
                                                            </StackLayout>
                                                        </StackLayout>
                                                        <StackLayout Grid.Row="2" Grid.Column="0" >
                                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{x:Static local:AppResources.EnterOTP}"   Padding="0,0,0,0"/>
                                                            <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" ErrorColor="#B00020" HasError="{Binding FrameOTPError}"
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b">
                                                                <StackLayout Orientation="Horizontal">
                                                                    <custom:BorderlessEntry Text="{Binding OTP}" FontSize="Small" WidthRequest="128" MaxLength="16"
                                                                Placeholder="{x:Static local:AppResources.EnterOTP}" IsPassword="{Binding IsOTPEncripted}" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                                    </custom:BorderlessEntry>
                                                                    <Image HorizontalOptions="EndAndExpand" x:Name="ImageSeeOtp">
                                                                        <Image.Source>
                                                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="25"
                                         Glyph="{x:Static FontImage:IconFonts.Eye}"/>
                                                                        </Image.Source>
                                                                        <Image.GestureRecognizers>
                                                                            <TapGestureRecognizer Tapped="ImageSeeOtp_Tapped"/>
                                                                        </Image.GestureRecognizers>
                                                                    </Image>
                                                                </StackLayout>
                                                            </inputLayout:SfTextInputLayout>
                                                        </StackLayout>

                                                    </Grid>
                                                </StackLayout>
                                            </ScrollView>
                                        </StackLayout>
                                    </Grid>
                                </Grid>
                            </StackLayout>
                        </ScrollView>
                        <!--</Grid>-->
                        <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0" VerticalOptions="End"  BackgroundColor="White" >
                            <buttons:SfButton x:Name="btnContinue" Text="{Binding ContinueButtonText}"   CornerRadius="10" VerticalOptions="End" 
                                  HeightRequest="56" Command="{Binding OnContinueButtonClick}"    FontSize="15"   Grid.ColumnSpan="2" Style="{StaticResource SfButtonStyle}" BackgroundColor="#d49504" />
                        </StackLayout>
                    </Grid>
                </StackLayout>
            </yummy:PancakeView>


            <Grid Grid.Row="0"    Grid.Column="0"   IsVisible="{Binding IsLoading}" >
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="Center"
                                           IsBusy="{Binding IsLoading}"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#006450"/>
                    </StackLayout>
                    <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                </StackLayout>
            </Grid>
        </Grid>
      
    </ContentPage.Content>
</ContentPage>