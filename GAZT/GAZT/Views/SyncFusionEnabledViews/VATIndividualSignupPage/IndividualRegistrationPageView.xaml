                                                        <Label Text="{Binding CityName}" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SomarSemiBold}" Grid.Row="1" Grid.Column="1"  TextColor="{StaticResource PrimaryColor}"/>


                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SomarSemiBold}" Grid.Row="2" Grid.Column="0" Text="{x:Static local:AppResources.ZZZZNeighborhood}"   />
                                                        <Label Text="{Binding Neighborhood}" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SomarSemiBold}" Grid.Row="2" Grid.Column="1"  TextColor="{StaticResource PrimaryColor}"/>


                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SomarSemiBold}" Grid.Row="3" Grid.Column="0" Text="{x:Static local:AppResources.ZZZZPostalCode}"  />
                                                        <Label Text="{Binding PostalCode}" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SomarSemiBold}" Grid.Row="3" Grid.Column="1"  TextColor="{StaticResource PrimaryColor}"/>


                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SomarSemiBold}" Grid.Row="4" Grid.Column="0" Text="{x:Static local:AppResources.ZZZZBuildingNumber}"  />
                                                        <Label Text="{Binding BuildingNumber}" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SomarSemiBold}" Grid.Row="4" Grid.Column="1"  TextColor="{StaticResource PrimaryColor}"/>


                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SomarSemiBold}" Grid.Row="5" Grid.Column="0" Text="{x:Static local:AppResources.ZZZZUnitNumber}" />
                                                        <Label Text="{Binding UnitNumber}" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SomarSemiBold}" Grid.Row="5" Grid.Column="1"  TextColor="{StaticResource PrimaryColor}"/>

                                                    </Grid>
                                                </StackLayout>
                                            </border:SfBorder>
                                            <!--Contact Information-->
                                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}" HasShadow="False"  Padding="0,0,0,15" Margin="0,20,0,0">
                                                <StackLayout Margin="0,5,0,5">
                                                    <Grid  Padding="10,0,10,0"  >
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Image Grid.Row="0" Grid.Column="0" Source="vat_new_Iconawesomephonealt.png" Aspect="AspectFit" HeightRequest="30"/>
                                                        <Label Grid.Row="0" Grid.Column="1"  Margin="0,5,0,5" Style="{StaticResource GAZTMediumBoldBlackLabelStyle}" FontFamily="{StaticResource SomarSemiBold}" VerticalOptions="Center" Text="{x:Static local:AppResources.ZZZContactInformation}"  FontSize="Medium" TextColor="{StaticResource PrimaryColor}"/>
                                                        <buttons:SfButton  Grid.Row="0" Grid.Column="2" x:Name="Btn_Edit_ContactInformation" Style="{StaticResource NoBackgroundButtonStylePrimary}" Text="{x:Static local:AppResources.NDEdit}" Clicked="Btn_Edit_ContactInformation_Clicked"  HorizontalOptions="End"/>
                                                    </Grid>
                                                    <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray"/>
                                                    <Grid Padding="10,5,10,10" VerticalOptions="FillAndExpand" >
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40*"/>
                                                            <ColumnDefinition Width="60*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SomarSemiBold}" Grid.Row="0" Grid.Column="0" Text="{x:Static local:AppResources.ZZMobileNumber}" />
                                                        <Label Text="{Binding MobileNumber}" HorizontalOptions="Start" FlowDirection="LeftToRight" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SomarSemiBold}" Grid.Row="0" Grid.Column="1" TextColor="{StaticResource PrimaryColor}">
                                                            <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{Binding TxtCountryCode}"  />
                                                                        <Span  Text="{Binding MobileNumber}"  />
                                                                    </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>


                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SomarSemiBold}" Grid.Row="1" Grid.Column="0" Text="{x:Static local:AppResources.Email}" />
                                                        <Label Text="{Binding Email}" FontSize="13" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SomarSemiBold}" Grid.Row="1" Grid.Column="1"  TextColor="{StaticResource PrimaryColor}"/>


                                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SomarSemiBold}" Grid.Row="2" Grid.Column="0" Text="{x:Static local:AppResources.ZZName}"/>
                                                        <Label Text="{Binding Name}" Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SomarSemiBold}" Grid.Row="2" Grid.Column="1" TextColor="{StaticResource PrimaryColor}"/>

                                                    </Grid>
                                                </StackLayout>
                                            </border:SfBorder>
                                        </StackLayout>
                                    </Grid>
                                    <!--Password-->
                                    <Grid Grid.Row="0" Grid.Column="0"  Padding="0,10,0,0"
                              x:Name="PasswordView" IsVisible="{Binding PasswordView}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <StackLayout Grid.Row="0">
                                            <Label Style="{StaticResource GAZTMediumBoldBlackLabelStyle}"   Text="{x:Static local:AppResources.Password}" Margin="10,0,10,0" FontFamily="{StaticResource SomarBold}" FontSize="22"  VerticalOptions="Center"  TextColor="{StaticResource PrimaryColor}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
                                            <Label Style="{StaticResource GAZTMediumGrayLabelStyle}" Margin="10,0,10,0" FontSize="15" FontFamily="{StaticResource SomarSemiBold}" Text="{x:Static local:AppResources.ZZZZCreateasecurePassword}"   />
                                            <BoxView Style="{StaticResource lineSeperator}" Margin="10,0,10,15"/>
                                        </StackLayout>
                                        <StackLayout Grid.Row="1">
                                            <ScrollView Padding="10,0,10,0">
                                                <StackLayout>
                                                    <Grid Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" 
                                        ColumnSpacing="0" RowSpacing="15" BackgroundColor="White">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                           <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                                            <custom:CustomLabel Style="{StaticResource GAZTSmallGrayLabelStyle}"   Padding="0,0,0,0" HorizontalOptions="Start" >

                                                                <custom:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                          <Span Text="{x:Static local:AppResources.NewPassword}" FontFamily="{StaticResource SomarSemiBold}" />
                                                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                                    </FormattedString>
                                                                </custom:CustomLabel.FormattedText>
                                                            </custom:CustomLabel>
                                                            <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" HasError="{Binding FramePasswordError}"
                                                            ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
                                                            OutlineCornerRadius="8" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020"                                                                  
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0">
                                                                <custom:BorderlessEntry x:Name="EntryPassword" Text="{Binding Password}"  WidthRequest="128" MaxLength="16" TextChanged="EntryPassword_TextChanged"
                                                                                        Placeholder="{x:Static local:AppResources.NewPassword}" IsPassword="{Binding IsPasswordEncripted}"
                                                                                        Style="{StaticResource DefaultEntry}">

                                                                    <custom:BorderlessEntry.Behaviors>
                                                                        <local:PasswordTextBehaviour/>
                                                                    </custom:BorderlessEntry.Behaviors>
                                                                </custom:BorderlessEntry>
                                                               <inputLayout:SfTextInputLayout.TrailingView>
                                                                    <Image x:Name="ImageSeePassword" Source="hidePassword.png">
                                                                        
                                                                        <Image.GestureRecognizers>
                                                                            <TapGestureRecognizer Tapped="ImageSeePassword_Tapped"/>
                                                                        </Image.GestureRecognizers>

                                                                    </Image>
                                                               </inputLayout:SfTextInputLayout.TrailingView>    
                                                            </inputLayout:SfTextInputLayout>
                                                        </StackLayout>
                                                        <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                                            <!--<Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{x:Static local:AppResources.ZZZZRepeatPassword}"  Padding="0,0,0,0"/>-->
                                                            <custom:CustomLabel Style="{StaticResource GAZTSmallGrayLabelStyle}"   Padding="0,0,0,0" HorizontalOptions="Start" >

                                                                <custom:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{x:Static local:AppResources.ZZZZRepeatPassword}" FontFamily="{StaticResource SomarSemiBold}" />
                                                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                                    </FormattedString>
                                                                </custom:CustomLabel.FormattedText>
                                                            </custom:CustomLabel>
                                                            <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" ErrorColor="#B00020" HasError="{Binding FrameConfirmPasswordError}"
                                                 ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="{StaticResource Primary}"                                                                  
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0">
                                                                <custom:BorderlessEntry x:Name="EntryConfirmPassword" Style="{StaticResource DefaultEntry}" Text="{Binding ConfirmPassword}" FontSize="Small" WidthRequest="128" MaxLength="16" TextChanged="EntryConfirmPassword_TextChanged"
                                                                        
                                                                Placeholder="{x:Static local:AppResources.ZZZZRepeatPassword}" IsPassword="{Binding IsConfirmPasswordEncripted}" >
                                                                    <custom:BorderlessEntry.Behaviors>
                                                                        <local:PasswordTextBehaviour/>
                                                                    </custom:BorderlessEntry.Behaviors>
                                                                </custom:BorderlessEntry>
                                                               <inputLayout:SfTextInputLayout.TrailingView>
                                                                    <Image  x:Name="ImageSeeConfirmPassword" Source="hidePassword.png">
                                                                        
                                                                        <Image.GestureRecognizers>
                                                                            <TapGestureRecognizer Tapped="ImageSeeConfirmPassword_Tapped"/>
                                                                        </Image.GestureRecognizers>

                                                                    </Image>
                                                               </inputLayout:SfTextInputLayout.TrailingView>    
                                                            </inputLayout:SfTextInputLayout>
                                                        </StackLayout>

                                                        <StackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" >
                                                            <StackLayout Orientation="Horizontal">
                                                                <Image Source="{Binding MinEight}" HorizontalOptions="Start">
                                                                   
                                                                </Image>
                                                                <Label  FontFamily="{StaticResource SomarSemiBold}" Text="{x:Static local:AppResources.ZZZZAtleast8characterslong}" TextColor="#010101"/>
                                                            </StackLayout>
                                                            <StackLayout Orientation="Horizontal">
                                                                <Image Source="{Binding CapsSmall}" HorizontalOptions="Start">
                                                                    
                                                                </Image>
                                                                <Label FontFamily="{StaticResource SomarSemiBold}" Text="{x:Static local:AppResources.ZZZZEnglishcapitalandsmallletters}" TextColor="#010101"  />
                                                            </StackLayout>
                                                            <StackLayout Orientation="Horizontal">
                                                                <Image Source="{Binding MaxSixteen}" HorizontalOptions="Start">
                                                                    
                                                                </Image>
                                                                <Label FontFamily="{StaticResource SomarSemiBold}" Text="{x:Static local:AppResources.ZZZZNotexceed16characters}" TextColor="#010101"  />
                                                            </StackLayout>

                                                            <StackLayout Orientation="Horizontal">
                                                                <Image Source="{Binding NumSymbol}" HorizontalOptions="Start">
                                                                    
                                                                </Image>
                                                                <Label  FontFamily="{StaticResource SomarSemiBold}"  Text="{x:Static local:AppResources.ZZZZNumbersandsymbols}" TextColor="#010101" />
                                                            </StackLayout>
                                                        </StackLayout>
                                                    </Grid>
                                                    <!--Verification Code-->
                                                    <Grid Padding="0,10,0,0" x:Name="VerificationCodeView">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <StackLayout Grid.Row="0">
                                                            <Label Style="{StaticResource GAZTMediumBoldBlackLabelStyle}"    Text="{x:Static local:AppResources.VerificationCode}" Margin="10,0,10,0" FontFamily="{StaticResource SomarBold}" FontSize="22"  VerticalOptions="Center"  TextColor="{StaticResource PrimaryColor}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
                                                            <Label Style="{StaticResource GAZTMediumGrayLabelStyle}" FontSize="15" FontFamily="{StaticResource SomarSemiBold}"  Text="{x:Static local:AppResources.EnterVerificationCode}"   />
                                                            <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,15"/>
                                                        </StackLayout>
                                                        <StackLayout Grid.Row="1">
                                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{Binding EncriptedMobileNumber}"/>

                                                            <StackLayout Orientation="Horizontal">
                                                                <Image Source="clock.png">
                                                                    
                                                                </Image>
                                                                <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{Binding OTPValidDuration}"/>
                                                            </StackLayout>
                                                        </StackLayout>

                                                        <StackLayout Grid.Row="2" Grid.Column="0" >
                                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{x:Static local:AppResources.EnterOTP}" FontFamily="{StaticResource SomarSemiBold}"  Padding="0,0,0,0"/>

                                                            <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" HasError="{Binding FrameOTPError}"
                                         ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020"                                                                  
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0">
                                                                    <custom:BorderlessEntry Keyboard="Numeric" HorizontalOptions="StartAndExpand" FontFamily="{StaticResource SomarLight}" Text="{Binding OTP}" FontSize="Small" MaxLength="4"
                                                                Placeholder="{x:Static local:AppResources.EnterOTP}" WidthRequest="128" IsPassword="{Binding IsOTPEncripted}"
                                                                                            Style="{StaticResource DefaultEntry}">
                                                                    </custom:BorderlessEntry>
                                                              <!--<inputLayout:SfTextInputLayout.TrailingView>
                                                              <Image HorizontalOptions="EndAndExpand" x:Name="ImageSeeOtp">
                                                                        <Image.Source>
                                                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="25"
                                         Glyph="{x:Static FontImage:IconFonts.Eye}"/>
                                                                        </Image.Source>
                                                                        <Image.GestureRecognizers>
                                                                            <TapGestureRecognizer Tapped="ImageSeeOtp_Tapped"/>
                                                                        </Image.GestureRecognizers>
                                                                    </Image>
                                                              </inputLayout:SfTextInputLayout.TrailingView>-->
                                                            </inputLayout:SfTextInputLayout>
                                                            <!--ResendOTP-->
                                                            <buttons:SfButton x:Name="btnResendOtp" Text="{x:Static local:AppResources.ResendOTP}"   FontFamily="{StaticResource GAZT_FONT_BOLD}"  CornerRadius="0" VerticalOptions="End" 
                                  HeightRequest="56" Command="{Binding OnResendButtonClick}"    FontSize="15"  Style="{StaticResource SfButtonStyle}" BackgroundColor="{Binding ButtonDisableColor}"  />
                                                        </StackLayout>

                                                    </Grid>
                                                </StackLayout>
                                            </ScrollView>
                                        </StackLayout>
                                    </Grid>
                                </Grid>
                            </StackLayout>
                        </ScrollView>
                        <!--</Grid> VerifyButtonDisableTextColor BackgroundColor="{StaticResource Secondary}"-->
                        <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="White" Padding="20,8,20,10">
                            <!--<buttons:SfButton x:Name="btnContinue" Text="{Binding ContinueButtonText}"  FontFamily="{StaticResource GAZT_FONT_BOLD}"  CornerRadius="0" VerticalOptions="End" 
                                  HeightRequest="56" Command="{Binding OnContinueButtonClick}"    FontSize="15"   Grid.ColumnSpan="2" Style="{StaticResource SfButtonStyle}" BackgroundColor="{Binding VerifyButtonDisableColor}"  />-->
                            <buttons:SfButton  x:Name="btnContinue" Text="{Binding ContinueButtonText}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OnContinueButtonClick}"/>
                        </StackLayout>
                    </Grid>
                        
                        <StackLayout BackgroundColor="White" Grid.Row="0" >
                       
                        <Grid Padding="15,0,15,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20*"/>
                                <ColumnDefinition Width="60*"/>
                                <ColumnDefinition Width="20*"/>
                            </Grid.ColumnDefinitions>
                            <StackLayout Grid.Column="0" Padding="0,8,0,0">
                                <Image Source="arrowLeft.png" HorizontalOptions="Start" IsVisible="{Binding BackArrowVisible}" Style="{DynamicResource BackButtonArrow}">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnBackButtonClick}"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>
                            <StackLayout Grid.Column="1">
                                <Image HeightRequest="40" WidthRequest="34" Source="ic_logo_gazt.png">

                                </Image>
                            </StackLayout>
                            <StackLayout Grid.Column="2" Padding="0,8,0,0">
                                <Image Source="close.png" HorizontalOptions="End" IsVisible="{Binding BackArrowVisible}">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoButtonClick}"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>
                        </Grid>


                        <commonView:PageIndicatorView Padding="10,0,0,0" Margin="10,0,10,0" MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" DotSize="12" HorizontalOptions="End"/>
                    </StackLayout>
                        
                    </Grid>
                <!--</StackLayout>-->
            </yummy:PancakeView>


            <Grid Grid.Row="0"    Grid.Column="0"   IsVisible="{Binding IsLoading}" >
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="Center"
                                           IsBusy="{Binding IsLoading}"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="{StaticResource Primary}"/>
                    </StackLayout>
                    <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                </StackLayout>
            </Grid>
        </Grid>
      
    </ContentPage.Content>
</ContentPage>