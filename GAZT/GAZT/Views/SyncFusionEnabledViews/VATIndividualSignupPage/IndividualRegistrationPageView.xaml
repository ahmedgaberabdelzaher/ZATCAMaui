                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackLayout Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="2" IsVisible="{Binding SetCountryVisibility}">
                                                        <!--{Binding SetCountryVisibility}-->
                                                        <Grid >
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto"/>
                                                                <RowDefinition Height="auto"/>
                                                            </Grid.RowDefinitions>
                                                            <custom:CustomLabel Style="{StaticResource GAZTSmallGrayLabelStyle}" Grid.Row="0"   Padding="0,0,0,0" HorizontalOptions="Start" >

                                                                <custom:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{x:Static local:AppResources.ZZZZCountry}"  />
                                                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                                    </FormattedString>
                                                                </custom:CustomLabel.FormattedText>
                                                            </custom:CustomLabel>

                                                            <inputLayout:SfTextInputLayout Grid.Row="1" Margin="0,-6,0,-6"
                                ContainerType="Outlined" x:Name="Frame_Country"  UnfocusedColor="#B1B1B1"
                                OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                                                <StackLayout Orientation="Horizontal">
                                                                    <custom:BorderlessEntry Text="{Binding CountryName}" FontSize="Small"
                                                        Placeholder="{x:Static local:AppResources.ZZZZCountry}" IsSpellCheckEnabled="False" Style="{StaticResource GAZTTextBoxStyleForEntry}" IsEnabled="{Binding SetEnabilityToCountryList}" >

                                                                    </custom:BorderlessEntry>
