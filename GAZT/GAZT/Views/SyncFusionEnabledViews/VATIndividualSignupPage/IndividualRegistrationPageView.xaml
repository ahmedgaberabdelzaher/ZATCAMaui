<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:EGAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
		     xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:custom2="clr-namespace:EGAZT.CustomControl"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.IndividualRegistrationPageView"
             BackgroundImageSource="partials_background.png"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
                <ResourceDictionary Source="..\CommonStyle\StylesNewUI.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10"/>
                <Setter Property="WidthRequest" Value="10"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}"/>
            </Style>


        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <yummy:PancakeView Grid.Row="0" Grid.Column="0" BackgroundColor="White" CornerRadius="14,14,0,0" Padding="0,20,0,0">


                <!--<StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  BackgroundColor="White">-->
                    <Grid HorizontalOptions="FillAndExpand" ColumnSpacing="0" BackgroundColor="White" VerticalOptions="FillAndExpand" Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                    <Grid Grid.Row="1"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  BackgroundColor="White" RowSpacing="0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="88*" />
                            <RowDefinition Height="12*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <ScrollView Grid.Row="0"  Padding="10,0,10,10" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="FillAndExpand" >
                            <StackLayout BackgroundColor="White" Spacing="0" Padding="0" Margin="0">

                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,15,0,10" BackgroundColor="White" RowSpacing="0" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>


                                    <!--Individual Registration-->
                                    <Grid Grid.Row="0" Grid.Column="0"  Padding="0,10,0,0" Margin="0" 
                          x:Name="IndividualRegistrationView" IsVisible="{Binding IndividualRegistrationView}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackLayout Grid.Row="0">
                                            <Label Margin="10,0,10,0" FontFamily="{StaticResource SomarBold}" Style="{StaticResource GAZTMediumBoldBlackLabelStyle}" FontSize="22"  Text="{x:Static local:AppResources.ZZZZIndividualRegistration}"  VerticalOptions="Center"  TextColor="{StaticResource PrimaryColor}"  />
                                            <Label Margin="10,0,10,0" Style="{StaticResource GAZTMediumGrayLabelStyle}" FontSize="15"  Text="{x:Static local:AppResources.ZZZZCompletethebelowdetails}" FontFamily="{StaticResource SomarSemiBold}" />
                                            <BoxView  Style="{StaticResource lineSeperator}" Margin="10,0,10,15"/>
                                        </StackLayout>

                                        <ScrollView Grid.Row="1" Padding="10,0,10,0">
                                            <Grid Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" 
                              ColumnSpacing="0" RowSpacing="15" BackgroundColor="White">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackLayout Grid.Column="0" Grid.Row="0" >
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <custom:CustomLabel Style="{StaticResource CardLabelBlack}" Grid.Row="0"   Padding="0,0,0,0" HorizontalOptions="Start" >

                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span  Text="{x:Static local:AppResources.ZZIDType}"  />
                                                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                        <inputLayout:SfTextInputLayout Grid.Row="1" Margin="0,-6,0,-6"  TrailingViewPosition="Inside"
                                                                ContainerType="Outlined" x:Name="FrmIDType"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020" HasError="False"                                                                       
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0">
                                                     <custom:BorderlessEntry Text="{Binding TxtIDType}" FontFamily="{StaticResource SomarLight}" FontSize="Small" 
                                                        Placeholder="{x:Static local:AppResources.ZZIDType}"  IsSpellCheckEnabled="False" Style="{StaticResource DefaultEntry}">
                                                                </custom:BorderlessEntry>
                                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                                <Image Source="arrowDropdown.png"/>

                                                            </inputLayout:SfTextInputLayout.TrailingView>
                                                        </inputLayout:SfTextInputLayout>
                                                        <custom:CustomButton  Grid.Row="1" x:Name="btn1" Clicked="btn1_Clicked" FontSize="Small" BackgroundColor="Transparent" Margin="0,0,0,0"  >
                                                        </custom:CustomButton>

                                                        <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="DDlIDType" Grid.Row="1"
                                    HeaderHeight="40" ShowHeader="False" HeaderText="{x:Static local:AppResources.ZZIDType}"
                                    HeaderTextColor="White"
                                    UnSelectedItemFontSize="13" SelectedIndex="{Binding IDTypeIndex}" 
                                    ColumnHeaderHeight="46"
                                    PickerMode="Dialog"
                              HeaderBackgroundColor="{StaticResource Primary}"
                        
                        BorderColor="Black"
                             SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralGreay}"                            
                                                 OKButtonTextColor="{StaticResource Primary}"      
                                                 CancelButtonTextColor="{StaticResource Primary}"
                                                 ShowColumnHeader="False"
                                                 ShowFooter="False"
                                                 OKButtonBackgroundColor="#EAF7CC"
                                                 CancelButtonBackgroundColor="#EAF7CC"
                                                 BackgroundColor="White"
                       ItemHeight="40"
                         DisplayMemberPath="Name" ItemsSource="{Binding IdTypeList}"  SelectionChanged="IDType_SelectedIndexChanged" Margin="0,0,0,0"
                        PickerHeight="200"
                        PickerWidth="270"
                         FooterHeight="46" OkButtonClicked="DDlIDType_OkayButtonClicked"  CancelButtonClicked="IDType_CancelButtonClicked">
                                                            <syncfusion:SfPicker.Behaviors>
                                                                <custom1:SfPickerBehavior />
                                                            </syncfusion:SfPicker.Behaviors>
                                                        </syncfusion:SfPicker>
                                                        <!--SelectedItem="{Binding SelectedSignUpUsing,Mode=TwoWay}"-->
                                                    </Grid>
                                                </StackLayout>

                                                <StackLayout Grid.Row="1" Grid.Column="0">

                                                    <custom:CustomLabel Style="{StaticResource CaptionLabelBlack}" Grid.Row="0"   Padding="0,0,0,0" HorizontalOptions="Start" >

                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{x:Static local:AppResources.IDNumber}"  />
                                                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                    </custom:CustomLabel>
                                                    <inputLayout:SfTextInputLayout  x:Name="FrmIDNumber" Margin="0,-6,0,-6" 
                                     ContainerType="Outlined"   UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020"                                                                       
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0" HasError="{Binding FrameIDError}">
                                                        <custom:BorderlessEntry Text="{Binding IdNumber}" FontFamily="{StaticResource SomarLight}" x:Name="EntryIDNumber" Keyboard="Numeric" FontSize="Small" Unfocused="EntryIDNumber_Unfocused"  MaxLength="{Binding MaxLengthID}" IsSpellCheckEnabled="False"
                                                            TextChanged="GAZTBorderlessEntry_TextChanged" Placeholder="{x:Static local:AppResources.IDNumber}" Style="{StaticResource DefaultEntry}">
                                                            <Entry.Behaviors>
                                                                <custom1:OnlyNumericValuesBehaviour/>
                                                            </Entry.Behaviors>
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="2" Grid.Column="0">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <StackLayout Grid.Row="0">
                                                            <custom:CustomLabel Style="{StaticResource CaptionLabelBlack}"    Padding="0,0,0,0" HorizontalOptions="Start" >

                                                                <custom:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{x:Static local:AppResources.ZZDateofBirth}"  />
                                                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                                    </FormattedString>
                                                                </custom:CustomLabel.FormattedText>
                                                            </custom:CustomLabel>
                                                            <!--<StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel Text="{x:Static local:AppResources.NDGregorian}"  HorizontalOptions="Start" Style="{StaticResource CaptionLabelBlack}"/>
                                                                <Switch x:Name="HijriCalSwitch" HorizontalOptions="CenterAndExpand" IsToggled="{Binding IsHijriCal}" Toggled="HijriCalSwitch_Toggled" />
                                                                <custom:CustomLabel  Text="{x:Static local:AppResources.NDHijri}" HorizontalOptions="End" Style="{StaticResource CaptionLabelBlack}"/>
                                                            </StackLayout>-->

                                                            <buttons:SfChipGroup Margin="0,10,0,0" x:Name="ChipGroup_statusFilter" Type="Choice"  HorizontalOptions="Start"  ChipBackgroundColor="Transparent"    ItemsSource="{Binding ChipDataFilterlist}" SelectedChipBackgroundColor="{StaticResource PartialBg}"  ChipBorderColor="{StaticResource NeutralLightGrey}"  ChipBorderWidth="1" SelectionChanged="ChipGroup_statusFilter_SelectionChanged" VerticalOptions="Center" >
                                                                <buttons:SfChipGroup.ItemTemplate>
                                                                    <DataTemplate >
                                                                        <StackLayout WidthRequest="80" >
                                                                            <custom:CustomLabel Text="{Binding Text}" StyleId="OnBoardText" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" Style="{StaticResource CaptionLabelBlack}" />
                                                                        </StackLayout>
                                                                    </DataTemplate>
                                                                </buttons:SfChipGroup.ItemTemplate>
                                                            </buttons:SfChipGroup>

                                                        </StackLayout>
                                                        
                                                        <inputLayout:SfTextInputLayout Grid.Row="1" Margin="0,-6,0,-6"
                                        ContainerType="Outlined" x:Name="FrmDBO"    UnfocusedColor="#B1B1B1" 
                                                                OutlineCornerRadius="8" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020"                                                                        
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside" 

                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0" HasError="{Binding FrameDOBError}">
                                                         
                                                                <custom:BorderlessEntry  x:Name="DateEntry"  FontFamily="{StaticResource SomarLight}" Text ="{Binding DOBddyymm}"
                                                                                         Focused="OnDateEntryFocussed" Unfocused="DatePicker_Unfocused"
                                                                                         TextChanged="DateEntry_TextChanged" Placeholder="dd/MM/yyyy" FontSize="Small" Style="{StaticResource DefaultEntry}" TextColor="{StaticResource Primary}">
                                                                </custom:BorderlessEntry> <!--Placeholder="yyyy/MM/dd"-->
                                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                                <Image Source="calendar.png">
                                                                </Image>
                                                   </inputLayout:SfTextInputLayout.TrailingView>
                                                        </inputLayout:SfTextInputLayout>

                                                        <Button Grid.Row="1" x:Name="btn4" BackgroundColor="Transparent" Clicked="btnDate_Clicked" Margin="0,0,0,0" />

                                                        <custom1:CustomDatePicker  FlowDirection="RightToLeft"   Grid.Row="1"
								ShowHeader="false"
								Margin="2" 
                              BackgroundColor="White"

                                OKButtonBackgroundColor="#EAF7CC"
                                CancelButtonBackgroundColor="#EAF7CC"
                                     HeaderBackgroundColor="White"
                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                                                                                   HeaderTextColor="{StaticResource NeutralBlack}"
                    BorderColor="Black"
                                                                                  
								ShowFooter="False"
								 ShowColumnHeader="True"
                                             ColumnHeaderBackgroundColor="White"
								ColumnHeaderHeight="50"
                                PickerMode="Dialog"
								HeaderText="Date of Birth"
								x:Name="SignUpDOB"
                          
                             OKButtonTextColor="{StaticResource Primary}" 
Closed="SignUpDOB_Closed"                                
                                             CancelButtonTextColor="{StaticResource Primary}"
                           
                            SelectedItem="{Binding TodayDate}"
                            HorizontalOptions="FillAndExpand"
                                OkButtonClicked="DOB_OkButtonClicked"
                                CancelButtonClicked="DOB_CancelButtonClicked"
								ItemHeight="45" >
                                                            <custom1:CustomDatePicker.Behaviors>
                                                                <custom1:SfPickerBehavior />
                                                            </custom1:CustomDatePicker.Behaviors>
                                                        </custom1:CustomDatePicker>
                                                        <custom1:CustomHijriDatePicker  FlowDirection="RightToLeft"   Grid.Row="1"
								ShowHeader="false"
								Margin="2" 
                              BackgroundColor="White"

                                OKButtonBackgroundColor="#EAF7CC"
                                CancelButtonBackgroundColor="#EAF7CC"
                                     HeaderBackgroundColor="White"
                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                    BorderColor="Black"
                                                                                  
								ShowFooter="False"
								 ShowColumnHeader="True"
                                             ColumnHeaderBackgroundColor="White"
								ColumnHeaderHeight="50"
                                PickerMode="Dialog"
								HeaderText="Date of Birth"
								x:Name="SignUpDOBHijri"
                          
                             OKButtonTextColor="{StaticResource Primary}" 
Closed="SignUpDOB_Closed"                                
                                             CancelButtonTextColor="{StaticResource Primary}"
                           
                            SelectedItem="{Binding TodayDateinHijri}"
                            HorizontalOptions="FillAndExpand"
                                OkButtonClicked="DOB_OkButtonClicked"
                                CancelButtonClicked="DOB_CancelButtonClicked"
								ItemHeight="45" >
                                                        </custom1:CustomHijriDatePicker>

                                                        

                                                    </Grid>
                                                </StackLayout>
                                                <StackLayout Grid.Row="3" Grid.Column="0" >

                                                    <custom:CustomLabel Style="{StaticResource CaptionLabelBlack}" Grid.Row="0"   Padding="0,0,0,0" HorizontalOptions="Start" >

                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{x:Static local:AppResources.ZZName}"  />
                                                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                    </custom:CustomLabel>

                                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
                                    ContainerType="Outlined" x:Name="FrmName"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020"                                                                       
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0" HasError="{Binding FrameNameError}" >
                                                        <custom:BorderlessEntry x:Name="EntryName" Unfocused="EntryName_Unfocused" TextChanged="EntryName_TextChanged" Text="{Binding Name}"
                                                                                FontFamily="{StaticResource SomarLight}"  IsSpellCheckEnabled="False"
                                                            FontSize="Small" Placeholder="{x:Static local:AppResources.ZZName}" Style="{StaticResource DefaultEntry}">
                                                            <Entry.Behaviors>
                                                                <custom1:AlphabetandArabicCharacters/>
                                                            </Entry.Behaviors>
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>
                                            </Grid>
                                        </ScrollView>
                                    </Grid>

                                    <!--National Address-->
                             
                                    <Grid Grid.Row="0" Grid.Column="0"  Padding="0,10,0,0"
                              x:Name="NationalAddressView" IsVisible="{Binding NationalAddressView}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <StackLayout Grid.Row="0">
                                            <Label Style="{StaticResource GAZTMediumBoldBlackLabelStyle}" Margin="10,0,10,0" FontFamily="{StaticResource SomarBold}" FontSize="22"  Text="{x:Static local:AppResources.ZZZZNationalAddress}"  VerticalOptions="Center"  TextColor="{StaticResource PrimaryColor}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
                                            <Label Margin="10,0,10,0" FontSize="15" Style="{StaticResource GAZTMediumGrayLabelStyle}" FontFamily="{StaticResource SomarSemiBold}" Text="{x:Static local:AppResources.ZZZZCompletethebelowdetails}" />
                                            <BoxView Style="{StaticResource lineSeperator}" Margin="10,0,10,15"/>
                                        </StackLayout>
                                        <StackLayout Grid.Row="1">
                                            <ScrollView IsVisible="{Binding NationalAddressView}"  Padding="10,0,10,0">
                                                <Grid Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
                                        ColumnSpacing="0" RowSpacing="0" BackgroundColor="White">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackLayout Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="2" IsVisible="{Binding SetCountryVisibility}">
                                                        <!--{Binding SetCountryVisibility}-->
                                                        <Grid >
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto"/>
                                                                <RowDefinition Height="auto"/>
                                                            </Grid.RowDefinitions>
                                                            <custom:CustomLabel Style="{StaticResource CaptionLabelBlack}" Grid.Row="0"   Padding="0,0,0,0" HorizontalOptions="Start" >

                                                                <custom:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{x:Static local:AppResources.ZZZZCountry}"  />
                                                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                                    </FormattedString>
                                                                </custom:CustomLabel.FormattedText>
                                                            </custom:CustomLabel>

                                                            <inputLayout:SfTextInputLayout Grid.Row="1" Margin="0,-6,0,-6"
                                                            ContainerType="Outlined" x:Name="Frame_Country"  UnfocusedColor="#B1B1B1"
                                                            OutlineCornerRadius="8" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020" HasError="False"                                                                       
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0" >

                                                                    <custom:BorderlessEntry    Text="{Binding CountryName}" 
                                                        Placeholder="{x:Static local:AppResources.ZZZZCountry}"
                                                                                               IsSpellCheckEnabled="False" Style="{StaticResource DefaultEntry}"
                                                                                               IsEnabled="{Binding SetEnabilityToCountryList}" >

                                                                    </custom:BorderlessEntry>
                                                                <inputLayout:SfTextInputLayout.TrailingView>
                                                               <Image Source="arrowDropdown.png">
                                                                        
                                                                    </Image>
                                                  </inputLayout:SfTextInputLayout.TrailingView>
                                                            </inputLayout:SfTextInputLayout>
                                                        </Grid>
                                                    </StackLayout>


                                                    <StackLayout Grid.Row="0" Margin="0,15,0,0" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding SetGCCCountryVisibility}">
                                                        <Grid >
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto"/>
                                                                <RowDefinition Height="auto"/>
                                                            </Grid.RowDefinitions>
                                                            <custom:CustomLabel  Style="{StaticResource GAZTSmallGrayLabelStyle}" Grid.Row="0"   Padding="0,0,0,0" HorizontalOptions="Start" >

                                                                <custom:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                        <Span  Text="{x:Static local:AppResources.ZZZZCountry}" />
                                                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                                    </FormattedString>
                                                                </custom:CustomLabel.FormattedText>
                                                            </custom:CustomLabel>

                                                            <inputLayout:SfTextInputLayout Grid.Row="1" Margin="0,-6,0,-6"
                                ContainerType="Outlined" x:Name="GCCFrame_Country"  UnfocusedColor="#B1B1B1"
                                                                OutlineCornerRadius="8" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020"                                                                  
                                                            HorizontalOptions="FillAndExpand"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            InputViewPadding="16,0,16,0" HasError="{Binding FrameGccCountyError}" >
                                                                
                                                                    <custom:BorderlessEntry  x:Name="GccCountryName" Text="{Binding CountryName}" FontSize="Small"
                                                        Placeholder="{x:Static local:AppResources.ZZZZCountry}" IsSpellCheckEnabled="False" Style="{StaticResource DefaultEntry}"
                                                                                             IsEnabled="{Binding SetEnabilityToCountryList}"
                                                                                             TextChanged="GccCountryName_TextChanged">
                                                                    </custom:BorderlessEntry>
                                                                <inputLayout:SfTextInputLayout.TrailingView>
                                                                    <Image Source="arrowDropdown.png">
                                                                        
                                            </Image>
                                                </inputLayout:SfTextInputLayout.TrailingView>
                                                            </inputLayout:SfTextInputLayout>
                                                            <custom:CustomButton  Grid.Row="1" x:Name="GCCPickerBtn_Country" Clicked="GCCPickerBtn_Country_Clicked" FontSize="Small" BackgroundColor="Transparent" Margin="0,0,0,0"  >
                                                            </custom:CustomButton>

                                                            <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="GCCPicker_Country" Grid.Row="1" IsEnabled="{Binding SetEnabilityToCountryList}" IsVisible="{Binding SetGCCCountryVisibility}"
                                    HeaderHeight="40" ShowHeader="False" HeaderText="{x:Static local:AppResources.ZZZZCountry}"
                                    HeaderTextColor="White"
                                    UnSelectedItemFontSize="13" SelectedIndex="{Binding SelectedGCCCountryIndex}"
                                    ColumnHeaderHeight="46"
                                    PickerMode="Dialog"
                              HeaderBackgroundColor="{StaticResource Primary}"
                        
                        BorderColor="Black"                                                       SelectedItemTextColor="{StaticResource NeutralBlack}"
UnSelectedItemTextColor="{StaticResource NeutralGreay}"
                                                  OKButtonTextColor="{StaticResource Primary}"      
                                                 CancelButtonTextColor="{StaticResource Primary}"
                                                 ShowColumnHeader="False"
                                                 ShowFooter="False"
                                                 OKButtonBackgroundColor="#EAF7CC"
                                                 CancelButtonBackgroundColor="#EAF7CC"
                                                 BackgroundColor="White"
                       ItemHeight="40"
                         DisplayMemberPath="CountryName" ItemsSource="{Binding GCCCountryList}"  SelectionChanged="GCCPicker_Country_SelectionChanged" Margin="0,0,0,0"
                        PickerHeight="200"
                        PickerWidth="270"
                         FooterHeight="46" OkButtonClicked="GCCCountry_OkayButtonClicked"  CancelButtonClicked="GCCCountry_CancelButtonClicked">
                                                                <syncfusion:SfPicker.Behaviors>
                                                                    <custom1:SfPickerBehavior />
                                                                </syncfusion:SfPicker.Behaviors>
                                                            </syncfusion:SfPicker>
                                                        </Grid>
                                                    </StackLayout>

                                                    <StackLayout Grid.Row="1" Margin="0,15,0,0" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding SetStateListVisibility}" >
                                                        <Grid IsVisible="{Binding SetStateListVisibility}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto"/>
                                                                <RowDefinition Height="auto"/>
                                                            </Grid.RowDefinitions>
                                                            <custom:CustomLabel Style="{StaticResource CaptionLabelBlack}" Grid.Row="0"   Padding="0,0,0,0" HorizontalOptions="Start" IsVisible="{Binding SetStateListVisibility}" >

                                                                <custom:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{x:Static local:AppResources.ZZZZProvinceRegion}" />
                                                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                                    </FormattedString>
                                                                </custom:CustomLabel.FormattedText>
                                                            </custom:CustomLabel>
