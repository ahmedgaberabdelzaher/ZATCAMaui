                                            <Label Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="2" Grid.Column="1" Text="Name Name" TextColor="Black"/>

                                        </Grid>
                                    </StackLayout>
                            </Frame>
                                <!--National Address-->
                                <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" Margin="0,20,0,0">
                                    <StackLayout>
                                        <StackLayout Orientation="Horizontal" Padding="10,5,10,10" HeightRequest="30">
                                            <Image VerticalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="30"
                                                        Glyph="{x:Static FontImage:IconFonts.CrosshairsGps}"/>
                                                </Image.Source>
                                            </Image>
                                            <Label Style="{StaticResource GAZTMediumBoldBlackLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" VerticalOptions="Center" Text="National Address" FontSize="Medium" TextColor="Black"/>
                                        </StackLayout>
                                        <BoxView Style="{StaticResource lineSeperator}"/>
                                        <Grid Padding="10,5,10,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40*"/>
                                                <ColumnDefinition Width="50*"/>
                                            </Grid.ColumnDefinitions>

                                                <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="0" Grid.Column="0" Text="City"/>
                                                <Label Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="0" Grid.Column="1" Text="National ID" TextColor="Black"/>


                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="1" Grid.Column="0" Text="Neighborhood"/>
                                            <Label Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="1" Grid.Column="1" Text="123456789" TextColor="Black"/>


                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="2" Grid.Column="0" Text="Postal Code"/>
                                            <Label Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="2" Grid.Column="1" Text="Name Name" TextColor="Black"/>


                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="3" Grid.Column="0" Text="Building Number"/>
                                            <Label Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="3" Grid.Column="1" Text="Name Name" TextColor="Black"/>


                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="4" Grid.Column="0" Text="Unit Number"/>
                                            <Label Style="{StaticResource GAZTSmallBlackLabel}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="4" Grid.Column="1" Text="Name Name" TextColor="Black"/>

                                        </Grid>
                                    </StackLayout>
                                </Frame>
                                <!--Contact Information-->
                                <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" Margin="0,20,0,0">
                                    <StackLayout>
                                        <StackLayout Orientation="Horizontal" Padding="10,5,10,10" HeightRequest="30">
                                            <Image VerticalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="30"
                                                        Glyph="{x:Static FontImage:IconFonts.Phone}"/>
                                                </Image.Source>
                                            </Image>
                                            <Label Style="{StaticResource GAZTMediumBoldBlackLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" VerticalOptions="Center" Text="Contact Information" FontSize="Medium" TextColor="Black"/>
                                        </StackLayout>
                                        <BoxView Style="{StaticResource lineSeperator}"/>
                                        <Grid Padding="10,5,10,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40*"/>
                                                <ColumnDefinition Width="50*"/>
                                            </Grid.ColumnDefinitions>

                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" Grid.Row="0" Grid.Column="0" Text="Mobile Number"/>
