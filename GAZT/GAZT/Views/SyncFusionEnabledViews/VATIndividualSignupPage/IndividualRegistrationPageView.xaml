<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:EGAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
		     xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:custom2="clr-namespace:EGAZT.CustomControl"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.IndividualRegistrationPageView"
             BackgroundColor="#005e4b"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
                <ResourceDictionary Source="..\CommonStyle\StylesNewUI.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10"/>
                <Setter Property="WidthRequest" Value="10"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SSTArBold}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SSTArBold}"/>
            </Style>


        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <yummy:PancakeView Grid.Row="0" Grid.Column="0" BackgroundColor="White" CornerRadius="14,14,0,0" Padding="0,20,0,0">


                <!--<StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  BackgroundColor="White">-->
                    <Grid HorizontalOptions="FillAndExpand" ColumnSpacing="0" BackgroundColor="White" VerticalOptions="FillAndExpand" Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                    <Grid Grid.Row="1"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  BackgroundColor="White" RowSpacing="0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="88*" />
                            <RowDefinition Height="12*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <ScrollView Grid.Row="0"  Padding="10,0,10,10" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="FillAndExpand" >
                            <StackLayout BackgroundColor="White" Spacing="0" Padding="0" Margin="0">

                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,15,0,10" BackgroundColor="White" RowSpacing="0" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>


                                    <!--Individual Registration-->
                                    <Grid Grid.Row="0" Grid.Column="0"  Padding="0,10,0,0" Margin="0" 
                          x:Name="IndividualRegistrationView" IsVisible="{Binding IndividualRegistrationView}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackLayout Grid.Row="0">
                                            <Label Margin="10,0,10,0" FontFamily="{StaticResource SSTArBold}" Style="{StaticResource GAZTMediumBoldBlackLabelStyle}" FontSize="22"  Text="{x:Static local:AppResources.ZZZZIndividualRegistration}"  VerticalOptions="Center"  TextColor="Black"  />
                                            <Label Margin="10,0,10,0" Style="{StaticResource GAZTMediumGrayLabelStyle}" FontSize="16"  Text="{x:Static local:AppResources.ZZZZCompletethebelowdetails}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" />
                                            <BoxView  Style="{StaticResource lineSeperator}" Margin="10,0,10,15"/>
                                        </StackLayout>

                                        <ScrollView Grid.Row="1" Padding="10,0,10,0">
                                            <Grid Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" 
                              ColumnSpacing="0" RowSpacing="15" BackgroundColor="White">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackLayout Grid.Column="0" Grid.Row="0" >
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <custom:CustomLabel Style="{StaticResource GAZTSmallGrayLabelStyle}" Grid.Row="0"   Padding="0,0,0,0" HorizontalOptions="Start" >

                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Text="{x:Static local:AppResources.ZZIDType}"  />
                                                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                        <inputLayout:SfTextInputLayout Grid.Row="1" Margin="0,-6,0,-6"  TrailingViewPosition="Inside"
                                ContainerType="Outlined" x:Name="FrmIDType"  UnfocusedColor="#B1B1B1"
                                OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                                            
                                                                <custom:BorderlessEntry Text="{Binding TxtIDType}" FontFamily="{StaticResource SSTArLight}" FontSize="Small" 
                                                        Placeholder="{x:Static local:AppResources.ZZIDType}"  IsSpellCheckEnabled="False" Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                                                </custom:BorderlessEntry>
                                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                                <Image Source="arrowDropdown.png"/>

                                                            </inputLayout:SfTextInputLayout.TrailingView>
                                                        </inputLayout:SfTextInputLayout>
                                                        <custom:CustomButton  Grid.Row="1" x:Name="btn1" Clicked="btn1_Clicked" FontSize="Small" BackgroundColor="Transparent" Margin="0,0,0,0"  >
                                                        </custom:CustomButton>

                                                        <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="DDlIDType" Grid.Row="1"
                                    HeaderHeight="40" ShowHeader="False" HeaderText="{x:Static local:AppResources.ZZIDType}"
                                    HeaderTextColor="White"
                                    UnSelectedItemFontSize="14" SelectedIndex="{Binding IDTypeIndex}" 
                                    ColumnHeaderHeight="46"
                                    PickerMode="Dialog"
                              HeaderBackgroundColor="#006450"
                        
                        BorderColor="Black"
                             SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralGreay}"                            
                                                 OKButtonTextColor="#006450"      
                                                 CancelButtonTextColor="#006450"
                                                 ShowColumnHeader="False"
                                                 ShowFooter="False"
                                                 OKButtonBackgroundColor="#EAF7CC"
                                                 CancelButtonBackgroundColor="#EAF7CC"
                                                 BackgroundColor="White"
                       ItemHeight="40"
                         DisplayMemberPath="Name" ItemsSource="{Binding IdTypeList}"  SelectionChanged="IDType_SelectedIndexChanged" Margin="0,0,0,0"
                        PickerHeight="200"
                        PickerWidth="270"
                         FooterHeight="46" OkButtonClicked="DDlIDType_OkayButtonClicked"  CancelButtonClicked="IDType_CancelButtonClicked">
                                                            <syncfusion:SfPicker.Behaviors>
                                                                <custom1:SfPickerBehavior />
                                                            </syncfusion:SfPicker.Behaviors>
                                                        </syncfusion:SfPicker>
                                                        <!--SelectedItem="{Binding SelectedSignUpUsing,Mode=TwoWay}"-->
                                                    </Grid>
                                                </StackLayout>

                                                <StackLayout Grid.Row="1" Grid.Column="0">

                                                    <custom:CustomLabel Style="{StaticResource GAZTSmallGrayLabelStyle}" Grid.Row="0"   Padding="0,0,0,0" HorizontalOptions="Start" >

                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{x:Static local:AppResources.IDNumber}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" />
                                                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                    </custom:CustomLabel>
                                                    <inputLayout:SfTextInputLayout  x:Name="FrmIDNumber" Margin="0,-6,0,-6" 
