<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             NavigationPage.HasNavigationBar="False"             
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             BackgroundColor="#006450"
             xmlns:custom2="clr-namespace:EGAZT"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.VATRegistrationSuccessfullPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10"/>
                <Setter Property="WidthRequest" Value="10"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SSTArBold}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SSTArBold}"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout>
            <StackLayout Padding="40" VerticalOptions="CenterAndExpand">
                <!--<Image Source="confirmnew.jpg" BackgroundColor="Transparent" Aspect="AspectFit" HeightRequest="100" HorizontalOptions="CenterAndExpand"></Image>-->
                
                <Image x:Name="imgCheck" HorizontalOptions="CenterAndExpand">
                    <Image.Source>
                        <FontImageSource FontFamily="UserIconFont" Color="White" Size="100"
                                         Glyph="{x:Static FontImage:IconFonts.CheckboxMarkedCircle}"/>
                    </Image.Source>
                </Image>
                <Label Text="VAT Registration Successful" FontSize="Large" TextColor="White" HorizontalTextAlignment="Center"/>
                <Label Text="You have successfully Registered to VAT Services."
                       TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </StackLayout>
            <ScrollView>
            <yummy:PancakeView BackgroundColor="White" CornerRadius="20,20,0,0" Padding="20" VerticalOptions="EndAndExpand">          
                <StackLayout>
                    <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" Margin="0,20,0,0">
                        <StackLayout Orientation="Horizontal" Padding="10">
                            <Label Text="Name" HorizontalOptions="StartAndExpand"/>
                            <Label Text="Ahmad Hassan" TextColor="Black" HorizontalOptions="EndAndExpand"/>
                        </StackLayout>
                    </Frame>
                    <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" Margin="0,20,0,0">
                        <StackLayout Orientation="Horizontal" Padding="10">
                            <Label Text="Application Number" HorizontalOptions="StartAndExpand"/>
                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                <Label Text="1234567890" TextColor="Black"/>
                                <Image>
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.ContentCopy}"/>
                                    </Image.Source>
                                </Image>
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" Margin="0,20,0,10">
                        <StackLayout Orientation="Horizontal" Padding="10">
                                <Label Text="{x:Static custom2:AppResources.Date}" HorizontalOptions="StartAndExpand"/>
                            <Label Text="17 March 2020" TextColor="Black" HorizontalOptions="EndAndExpand"/>
                        </StackLayout>
                    </Frame>
                    <buttons:SfButton x:Name="btnDashboard" Text="Go To Dashboard" CornerRadius="10" VerticalOptions="End" FontAttributes="Bold" 
                                      HeightRequest="46" Clicked="btnDashboard_Clicked"   Margin="10,0,10,0" FontSize="15"   Grid.ColumnSpan="2" 
                                      Style="{StaticResource SfButtonStyle}" BackgroundColor="#d49504" TextColor="White" />
                </StackLayout>
            </yummy:PancakeView>
            </ScrollView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>