<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             NavigationPage.HasNavigationBar="False"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"             
             x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.RegistrationSuccessfulPageView"
             BackgroundColor="DarkGreen">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10"/>
                <Setter Property="WidthRequest" Value="10"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SSTArBold}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SSTArBold}"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout>
            <StackLayout Padding="40" VerticalOptions="CenterAndExpand">
                <Image x:Name="imgCheck" HorizontalOptions="CenterAndExpand">
                    <Image.Source>
                        <FontImageSource FontFamily="UserIconFont" Color="White" Size="100"
                                         Glyph="{x:Static FontImage:IconFonts.CheckboxMarkedCircle}"/>
                    </Image.Source>
                </Image>
                <Label Text="Registration Successful" FontSize="Large" TextColor="White" HorizontalTextAlignment="Center"/>
                <Label Text="You have successfully Registered to GAZT Services. Use the Following TIN number to login with GAZT"
                       TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </StackLayout>
            <yummy:PancakeView BackgroundColor="White" CornerRadius="20,20,0,0" Padding="20" VerticalOptions="EndAndExpand">
                <StackLayout>
                    <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" Margin="0,20,0,0">
                        <StackLayout Orientation="Horizontal" Padding="10">
                            <Label Text="TIN Nimber" HorizontalOptions="StartAndExpand"/>
                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                <Label Text="{Binding TINnumber}" TextColor="Black"/>
                                <Image>
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.ContentPaste}"/>
                                    </Image.Source>
                                </Image>
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <buttons:SfButton x:Name="btnVATRegistration" Text="Register in VAT Now" CornerRadius="10" VerticalOptions="End" FontAttributes="Bold" 
                                      HeightRequest="56" Clicked="btnVATRegistration_Clicked"   Margin="10,10,10,0" FontSize="15"   Grid.ColumnSpan="2" 
                                      Style="{StaticResource SfButtonStyle}" BackgroundColor="#d49504" />
                    <buttons:SfButton x:Name="btnDashboard" Text="Go To Dashboard" CornerRadius="10" VerticalOptions="End" FontAttributes="Bold" 
                                      HeightRequest="46" Clicked="btnVATRegistration_Clicked"   Margin="10,0,10,0" FontSize="15"   Grid.ColumnSpan="2" 
                                      Style="{StaticResource SfButtonStyle}" BackgroundColor="Transparent" TextColor="#d49504" />
                </StackLayout>
            </yummy:PancakeView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>