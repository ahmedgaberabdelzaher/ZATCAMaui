<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             NavigationPage.HasNavigationBar="False"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"             
            xmlns:local="clr-namespace:EGAZT"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.RegistrationSuccessfulPageView"
             BackgroundColor="DarkGreen">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10"/>
                <Setter Property="WidthRequest" Value="10"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SSTArBold}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SSTArBold}"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout>
            <StackLayout Padding="40" VerticalOptions="CenterAndExpand">
                <Image x:Name="imgCheck" HorizontalOptions="CenterAndExpand">
                    <Image.Source>
                        <FontImageSource FontFamily="UserIconFont" Color="White" Size="100"
                                         Glyph="{x:Static FontImage:IconFonts.CheckboxMarkedCircle}"/>
                    </Image.Source>
                </Image>
                <!--ZZZZRegistrationSuccessful Text="Registration Successful" Text="You have successfully Registered to GAZT Services. Use the Following TIN number to login with GAZT"-->
                <Label Text="{x:Static local:AppResources.ZZZZRegistrationSuccessful}" FontFamily="{StaticResource SSTArBold}"  FontSize="Large" TextColor="White" HorizontalTextAlignment="Center"/>
                <Label Text="{x:Static local:AppResources.ZZZZYouhavesuccessfullyregisteredtoGAZTServices}"  FontFamily="{StaticResource SSTArabicMedium}"
                       TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </StackLayout>
            <yummy:PancakeView BackgroundColor="White" CornerRadius="20,20,0,0" Padding="20" VerticalOptions="EndAndExpand">
                <StackLayout>
                    <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" Margin="0,20,0,0">
                        <StackLayout Orientation="Horizontal" Padding="10">
                            <Label   Text="{x:Static local:AppResources.TINS}" FontFamily="{StaticResource SSTArabicMedium}" HorizontalOptions="StartAndExpand"/>
                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                <Label x:Name="Label_Tin" FontFamily="{StaticResource SSTArabicMedium}" Text="{Binding TINnumber}" TextColor="Black"/>
                                <Image x:Name="Image_Copy">
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.ContentPaste}"/>
                                    </Image.Source>
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Image_Copy_Tapped"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <buttons:SfButton x:Name="btnVATRegistration" FontFamily="{StaticResource SSTArabicMedium}" Text="{x:Static local:AppResources.ZZZZRegisterinVATNow}"  CornerRadius="10" VerticalOptions="End" FontAttributes="Bold" 
                                      HeightRequest="56" Clicked="btnVATRegistration_Clicked"   Margin="10,10,10,0" FontSize="15"   Grid.ColumnSpan="2" 
                                      Style="{StaticResource SfButtonStyle}" BackgroundColor="#d49504" />
                    <buttons:SfButton x:Name="btnDashboard"   Text="{x:Static local:AppResources.ZZZZGotoDashboard}" CornerRadius="10" VerticalOptions="End" FontAttributes="Bold" 
                                      HeightRequest="46" Clicked="btnVATRegistration_Clicked"  FontFamily="{StaticResource SSTArabicMedium}"  Margin="10,0,10,0" FontSize="15"   Grid.ColumnSpan="2" 
                                      Style="{StaticResource SfButtonStyle}" BackgroundColor="Transparent" TextColor="#d49504" />
                </StackLayout>
            </yummy:PancakeView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>