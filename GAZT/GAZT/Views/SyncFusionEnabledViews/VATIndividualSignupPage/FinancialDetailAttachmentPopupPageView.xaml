<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:custom2="clr-namespace:EGAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms" xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms" xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms" xmlns:custom1="clr-namespace:GAZT.CustomControl" xmlns:cards1="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
                 x:Class="EGAZT.Views.SyncFusionEnabledViews.VATIndividualSignupPage.FinancialDetailAttachmentPopupPageView">
    <Grid>
        <yummy:PancakeView CornerRadius="22,22,0,0" HasShadow="False" VerticalOptions="End" BackgroundColor="White">
            <Grid>


                <StackLayout Padding="0,0,0,0" Margin="10,0,10,0">

                    <!--<Label Text="{x:Static custom2:AppResources.ZZZZVATRAttachmentNote1}" Margin="0,8,0,0" TextColor="{StaticResource Primary}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
            <Label Text="{x:Static custom2:AppResources.ZZZZVATRAttachmentNote2}" Margin="0,8,0,0" TextColor="{StaticResource Primary}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
            <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,15"/>
            -->
                    <!--ItemTapped="Attachmentlist_ItemTapped"-->
                    <!--
            <ListView ItemsSource="{Binding FileAttachments}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
            HasUnevenRows="True" x:Name="List" BackgroundColor="White"
            SeparatorVisibility="None" HeightRequest="300">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80*"/>
                                    <ColumnDefinition Width="20*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Text="{Binding .}" Style="{StaticResource MicroGrayLabelStyleNew}" 
                                       LineBreakMode="TailTruncation" FontFamily="{StaticResource SomarBold}"/>

                                <Image Grid.Column="1"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_delete.png">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer /> -->
                    <!--Tapped="OnDeleteAttachmentClicked"-->
                    <!--
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <buttons:SfButton x:Name="btnAddAttachment" Text="Add Attachment" CornerRadius="10" VerticalOptions="End" FontAttributes="Bold" 
                              HeightRequest="56" Margin="0,0,0,20" FontSize="15" TextColor="{DynamicResource Gray-White}" FontFamily="{StaticResource SomarSemiBold}" 
                              BackgroundColor="{StaticResource Secondary}" BorderWidth="0" Command="{Binding OnAttachmentClick}"/>-->

                    














                    <StackLayout>

                        <StackLayout Padding="22,22,22,0">
                            <!--<Image HorizontalOptions="EndAndExpand" >
                                <Image.Source>
                                    <FontImageSource FontFamily="UserIconFont" Color="LightGray" Size="25"
                                                    Glyph="{x:Static FontImage:IconFonts.Close}"/>
                                </Image.Source>
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Close_Tapped"/>
                                </Image.GestureRecognizers>
                            </Image>-->
                            <!--VATRMPAttachments-->
                           <!-- Divya created a new label and setting visibility when vat amend/reactivation selected -->
                            <Label  Text="{Binding AttachmentHeaderTitle}" IsVisible="{Binding TitleIsVisible}" HorizontalOptions="Center" VerticalOptions="Center" Style="{StaticResource GAZTSmallGreenLabelStyle}"/>

                            <Label  Text="{x:Static custom2:AppResources.VATRMPAttachments}" IsVisible="{Binding RegAttachmentTitle}" HorizontalOptions="Center"   VerticalOptions="Center" FontSize="Large" TextColor="{StaticResource PrimaryColor}" FontFamily="{StaticResource SomarBold}" />
                            <StackLayout Grid.Row="2">

                            </StackLayout>
                            <!--<Label Text="type of document that you are submitting to prove whether or not eligible." HorizontalOptions="Center" FontFamily="{StaticResource SomarBold}"/>-->
                        </StackLayout>
                        <StackLayout Padding="15,0,15,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Label Text="{x:Static custom2:AppResources.VATRAttachmentCategory}"  Grid.Row="0" Padding="0,0,0,0" FontFamily="{StaticResource SomarBold}"/>
                                <inputLayout:SfTextInputLayout Grid.Row="1" Margin="0,-6,0,-6" 
                                ContainerType="Outlined" x:Name="FrmIDType"  UnfocusedColor="#B1B1B1"
                                OutlineCornerRadius="8" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020" HasError="False" >
                                    <StackLayout Orientation="Horizontal">
                                        <custom:BorderlessEntry Text="{Binding AttachmentTypeTxt}"  FontSize="Small" 
                                                        TextColor="{StaticResource PrimaryColor}"  IsSpellCheckEnabled="False" HorizontalOptions="FillAndExpand" >
                                        </custom:BorderlessEntry>
                                        <!--<Image HorizontalOptions="EndAndExpand" Rotation="270" >
                                            --><!--Rotation="270"--><!--
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont" Color="Black" Size="20"
                                     Glyph="{x:Static FontImage:IconFonts.LessThan}"/>
                                            </Image.Source>
                                        </Image>-->
                                        <Image Source="arrowDropdown.png"/>

                                    </StackLayout>
                                </inputLayout:SfTextInputLayout>
                                <custom:CustomButton  Grid.Row="1" x:Name="btn1" Clicked="btn1_Clicked" FontSize="Small" BackgroundColor="Transparent" Margin="0,0,0,0"  >
                                </custom:CustomButton>
                                <!--SelectedIndex="{Binding IDTypeIndex}"-->
                                <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="AttachmentTypePicker" Grid.Row="1"
                                    HeaderHeight="40" HeaderText="{x:Static custom2:AppResources.VATRAttachmentCategory}"
                                    HeaderTextColor="White"
                                    UnSelectedItemFontSize="13" 
                                    ColumnHeaderHeight="46"
                                    PickerMode="Dialog"
                              HeaderBackgroundColor="{StaticResource Primary}"
                        SelectedItemTextColor="{StaticResource Primary}"
                        BorderColor="Black"
                                                       SelectedIndex="{Binding SelectedAttachmentType}"
                                                    
                                                       
                                                 OKButtonTextColor="{StaticResource Primary}"      
                                                 CancelButtonTextColor="{StaticResource Primary}"
                                                 ShowColumnHeader="False"
                                               
                                                 OKButtonBackgroundColor="#EAF7CC"
                                                 CancelButtonBackgroundColor="#EAF7CC"
                                                 BackgroundColor="White"
                       ItemHeight="40"
                         DisplayMemberPath="Txt50" ItemsSource="{Binding ResultsItemForDOCSet}"  SelectionChanged="DDlIDTypee_OkButtonClicked" Margin="0,0,0,0"
                        PickerHeight="200"
                        PickerWidth="270"
                                    ShowHeader="False" ShowFooter="False"                 
                         FooterHeight="46" >
                                    <syncfusion:SfPicker.Behaviors>
                                        <custom1:SfPickerBehavior />
                                    </syncfusion:SfPicker.Behaviors>
                                </syncfusion:SfPicker>
                                <!--OkButtonClicked="DDlIDType_OkButtonClicked"  CancelButtonClicked="DDlIDType_CancelButtonClicked"-->
                                <StackLayout Grid.Row="2" IsVisible="{Binding IsAttachmentVisibile}">
                                    <Label  Text="{x:Static custom2:AppResources.Attachment}"  Grid.Row="2"  FontFamily="{StaticResource SomarBold}"/>
                                    <inputLayout:SfTextInputLayout Grid.Row="3" Margin="0,-6,0,-6"
                                            ContainerType="Outlined" x:Name="FrmAttachmentOptional" UnfocusedColor= "#bbbbbb"
                                            OutlineCornerRadius="8" FocusedColor="#bbbbbb" ErrorColor="#B00020" HasError="False" >
                                        <StackLayout Orientation="Horizontal" x:Name="ExploreAttachmentLayout">
                                            <custom:BorderlessEntry  x:Name="EntryExploreAttachment"  IsEnabled="False" FontFamily="{StaticResource SomarBold}" Placeholder="{x:Static custom2:AppResources.ZZExplore}" FontSize="Small">
                                            </custom:BorderlessEntry>
                                            <Image HorizontalOptions="EndAndExpand" Rotation="270">
                                                <Image.Source>
                                                    <FontImageSource FontFamily="UserIconFont"
                                                                     Color="{StaticResource SecondaryNew}" Size="25"
                                                    Glyph="{x:Static FontImage:IconFonts.Attachment}" />
                                                </Image.Source>
                                            </Image>
                                            <StackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnAttachmentClick}">

                                                </TapGestureRecognizer>
                                            </StackLayout.GestureRecognizers>
                                        </StackLayout>
                                    </inputLayout:SfTextInputLayout>
                                </StackLayout>

                            </Grid>
                        </StackLayout>
                        <ListView   
           ItemsSource="{Binding AttachmentList}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                                x:Name="List"
                             HeightRequest="300"       
            ItemTapped="List_ItemTapped"
            SeparatorVisibility="None"
            >
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <ContentView>
                                            <cards1:SfCardView HasShadow="False" Margin="10" Opacity=".9" BorderWidth=".05" BorderColor="{StaticResource EntryTextColor}"  ShadowColor="{StaticResource EntryTextColor}" BackgroundColor="White" CornerRadius="8"  IndicatorColor="{StaticResource Primary}" IndicatorPosition="Left" IndicatorThickness="5" >
                                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"  Padding="10" >
                                                    <Grid Style="{DynamicResource GridStyle}" ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="Center" BackgroundColor="White" >
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70*" />
                                                            <ColumnDefinition Width="15*" />
                                                            <ColumnDefinition Width="15*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="30" />
                                                            <RowDefinition Height="30" />
                                                        </Grid.RowDefinitions>
                                                        <Label Text="{Binding Filename}" 
                                                                 LineBreakMode="TailTruncation"     
                                   Style="{StaticResource MicroGrayLabelStyleNew}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                                                           FontFamily="{StaticResource SomarBold}"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   />
                                                        <!--<Image Grid.Row="0"  Grid.Column="1" Grid.RowSpan="2"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_file_download.png"  >
                                                            <Image.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnDownloadAttachmentClicked" />
                                                            </Image.GestureRecognizers>
                                                        </Image>-->
                                                        <Image Grid.Row="0"  Grid.Column="2" Grid.RowSpan="2"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_delete.png"  >
                                                            <Image.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnDeleteAttachmentClicked" />
                                                            </Image.GestureRecognizers>
                                                        </Image>
                                                        <Label Text="{Binding Erfdt}" 
                                                                       Margin="3,0,3,-5"
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                                                   FlowDirection="LeftToRight"
                                   Grid.Row="1"
                                   Grid.Column="0" Grid.ColumnSpan="2" 
                                                                   FontFamily="{StaticResource SomarBold}"
                                   />
                                                    </Grid>
                                                </StackLayout>
                                            </cards1:SfCardView>
                                        </ContentView>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <buttons:SfButton x:Name="btnDone" Text="{x:Static custom2:AppResources.ZZZZDone}" CornerRadius="14" VerticalOptions="End" FontAttributes="Bold" 
                                  HeightRequest="48" Margin="10,0,10,20" FontSize="15" TextColor="{DynamicResource Gray-White}" FontFamily="{StaticResource SomarSemiBold}" 
                              BackgroundColor="{StaticResource Secondary}" Clicked="Close_Tapped" BorderWidth="0" />


                    </StackLayout>


                </StackLayout>
                <Grid Grid.Row="0"    Grid.Column="0"  IsVisible="{Binding IsLoading}" >
                    <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                    </StackLayout>
                    <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="Center"
                                           IsBusy="{Binding IsLoading}"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="{StaticResource Primary}"/>
                        </StackLayout>
                        <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                    </StackLayout>
                </Grid>
            </Grid>
        </yummy:PancakeView>
       
    </Grid>

</pages:PopupPage>
