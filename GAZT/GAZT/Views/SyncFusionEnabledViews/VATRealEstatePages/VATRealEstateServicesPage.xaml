                                                </Label>
                                            </StackLayout>
                                        </Grid>
                                    </cards:SfCardView.Content>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                       
                        <listView:SfListView.LayoutManager>
                            <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=3, Tablet=4, Desktop=5}" />
