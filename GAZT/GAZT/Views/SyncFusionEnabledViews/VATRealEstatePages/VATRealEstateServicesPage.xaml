                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTappedTest"></TapGestureRecognizer>
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                <Label HorizontalTextAlignment="Center" TextColor="#006450"  Style="{StaticResource LabelStyleFromCommonGrayStyle}" FontSize="8.5" >
                                                    <Label.FormattedText >
                                                        <FormattedString>
                                                            <Span Text="{Binding eServiceName}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTappedTest"></TapGestureRecognizer>
