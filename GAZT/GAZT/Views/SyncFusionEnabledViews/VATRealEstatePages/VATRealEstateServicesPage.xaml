<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:xaml="http://xamarin.com/schemas/2014/forms/design"
              xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
                  x:Class="EGAZT.Views.SyncFusionEnabledViews.VATRealEstatePages.VATRealEstateServicesPage"
                          xmlns:local="clr-namespace:EGAZT;assembly:GAZT"
              xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
                  xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" xmlns:local1="clr-namespace:GAZT"
               BackgroundColor="#006450" 
              NavigationPage.HasNavigationBar="False"

>
            <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
        <yummy:PancakeView Grid.Row="0" VerticalOptions="Fill"  BackgroundColor="White" Margin="0,10,0,-40" CornerRadius="22,22,0,0" Padding="0">
            <StackLayout Padding="20" >
                <Grid HorizontalOptions="FillAndExpand">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>
                        <Label x:Name="Image_backArrow" Grid.Row="0" Grid.Column="0" Margin="0,-5,0,0" HorizontalOptions="Start" VerticalOptions="Start" IsVisible="{Binding BackArrowVisible}"  Style="{StaticResource IconLabelStyle}" Text="{StaticResource Back}" >
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <!--<Image HorizontalOptions="Start">-->
                           
                            <!--<Image.Source>
                        <FontImageSource Color="Black" 
                                 FontFamily="UserIconFont"
                                 Glyph="{x:Static FontImage:IconFonts.ArchiveArrowDown}"
                            />
                    </Image.Source>-->
                <!--</Image>-->
                        <Image Source="ic_logo_gazt.png" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,-10,0,0" WidthRequest="50" HeightRequest="50" VerticalOptions="Center" HorizontalOptions="Center">
                         
                        </Image>
                    </Grid>
            
                   <Label Text="{x:Static local:AppResources.ZRealEstateServiceDetailTitle}" Grid.ColumnSpan="2"  FontSize="Medium" TextColor="Black" 
                       FontFamily="{StaticResource SSTArBold}"/> 
                  <Label Text="{x:Static local:AppResources.ZRealEstateServiceIndividualTitle}" Grid.ColumnSpan="2"  FontSize="Small" TextColor="Gray" 
                       FontFamily="{StaticResource SSTArabicMedium}"/>
                <BoxView Style="{StaticResource lineSeperator}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"  Margin="0,0,0,25"/>

                <Grid ColumnSpacing="0">
                    <StackLayout Grid.Row="0" Grid.ColumnSpan="2" Padding="5" HorizontalOptions="FillAndExpand"><!--BackgroundColor="DarkGreen"-->
                        <Frame BackgroundColor="Transparent" Padding="0" Margin="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                           
                           <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Image x:Name="re_Property_Tile"  Source="{Binding ImagePropertyTile}" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"

                               />
                                <Image x:Name= "re_Property_Registration" Source="{Binding ImagePropertyIcon}"  HorizontalOptions="Start" Margin="20,-20,20,0"/>
                            <Label Text="{x:Static local:AppResources.ZVATRealEstatePropertyRegistration}" Margin="20,50,20,0" TextColor="{Binding PropertyTileColor}"
                           HorizontalOptions="Start" VerticalOptions="Center" FontSize="10"  Style="{StaticResource LabelStyleFromCommonGrayStyle}" FontFamily="{StaticResource SSTArabicMedium}"/>
                              </Grid>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PropertyRegistrationCommand}"/>
                    </Frame.GestureRecognizers>
                </Frame>
                </StackLayout>
                    <StackLayout  Grid.Row="1"  Grid.Column="0" Padding="0" Grid.ColumnSpan="1" HorizontalOptions="FillAndExpand" >
                      
                        <Frame BackgroundColor="Transparent"  Padding="0" Margin="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                           
               <Grid HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                        <Image x:Name="re_Request_Tile"  Source="{Binding ImageRequestTile}" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" />
                                <Image x:Name="re_Request_Icon"  Source="{Binding ImageRequestIcon}"  HorizontalOptions="Start" Margin="20,-15,20,0"/>
                            <Label Text="{x:Static local:AppResources.ZVATRealEstateRequestVerification}" Margin="20,50,20,0"  TextColor="{Binding RequestTileColor}"
                           HorizontalOptions="Start" VerticalOptions="Center" HorizontalTextAlignment="Center" Style="{StaticResource LabelStyleFromCommonGrayStyle}" FontSize="10"  FontFamily="{StaticResource SSTArabicMedium}"/>
                              </Grid>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RequestVerificationCommand}"/>
                    </Frame.GestureRecognizers>
                </Frame>
                    </StackLayout>
                 <StackLayout Padding="0" Grid.Row="1" Grid.Column="1" HorizontalOptions="FillAndExpand">
                       
               <Frame BackgroundColor="Transparent"  Padding="0" Margin="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                   
               <Grid HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                        <Image x:Name="re_Termination_Tile" Source="{Binding ImageTerminationTile}" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" />
                                <Image x:Name="re_Termination_Icon"  Source="{Binding ImageTerminationIcon}" HorizontalOptions="Start" Margin="20,-15,20,0"/>
                         <Label HorizontalTextAlignment="Start" Text="{x:Static local:AppResources.ZVATRealEstateTerminationOfRequest}" Margin="20,55,20,0"  TextColor="{Binding TerminateTileColor}"
                           HorizontalOptions="Start" VerticalOptions="Center" FontSize="10" LineBreakMode="NoWrap"  Style="{StaticResource LabelStyleFromCommonGrayStyle}" FontFamily="{StaticResource SSTArabicMedium}"/>
                
                              </Grid>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TerminateRequestCommand}"/>
                    </Frame.GestureRecognizers>
                </Frame>
                    </StackLayout>
                    </Grid>
                </StackLayout>
       
        </yummy:PancakeView>

          <Grid Grid.Row="0"    Grid.Column="0"   IsVisible="{Binding IsLoading}" >
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="Center"
                                           IsBusy="{Binding IsLoading}"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#006450"/>
                    </StackLayout>
                    <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                </StackLayout>
              </Grid>
         <!-- <Grid x:Name="ParentContainer" BackgroundColor="White" >
            <Grid.RowDefinitions>
                <RowDefinition  Height="26*"/>
                <RowDefinition  Height="74*"/>                   
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>
                   <ScrollView Grid.Row="1" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
