                        Grid.Column="0"
                        Margin="16,0,16,0"
                        Style="{StaticResource IconLabelStyle}"
                         TextColor="#005e4b"
                        Text="{StaticResource Account}" />
                        <!--  Edit profile label  -->
                        <Label
