                                                            </FormattedString>
                                                        </local1:CustomLabel.FormattedText>
                                                    </local1:CustomLabel>
                                                    <local1:CustomLabel
                                   Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                                   VerticalOptions="CenterAndExpand"
                                                        HorizontalOptions="StartAndExpand"
                                                    Margin="0"
                                                    FlowDirection="LeftToRight"
                                                        LineBreakMode="CharacterWrap"
                                                           FontFamily="{StaticResource SSTArabicMedium}"
                                                 Text="{Binding DueDtC}"
                                                          >
                                                    </local1:CustomLabel>
                                                </StackLayout>

