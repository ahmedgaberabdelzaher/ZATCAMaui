<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:custom2="clr-namespace:EGAZT"
             xmlns:local1="clr-namespace:GAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:cards1="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             mc:Ignorable="d"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.AttachmentPage.AttachmentPageView"
             NavigationPage.HasNavigationBar="False"
           BackgroundColor="White" >
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <StackLayout HorizontalOptions="FillAndExpand"  VerticalOptions="FillAndExpand"   Margin="0,0,0,0"  Grid.Row="0">
                <ScrollView  x:Name="ScrollViewContainer"  HorizontalOptions="FillAndExpand" VerticalOptions="Fill" BackgroundColor="White" >
                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="0">
 <Grid.RowDefinitions>
                            <RowDefinition Height="40*"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="10"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                                           
                    <Grid Grid.Row="0" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>
                        <Frame Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"   Style="{StaticResource GAZTFrameStyleEntryForLableBackground}"   >
                        </Frame>
                        <local1:CustomLabel Text="{x:Static custom2:AppResources.ZVatAttachments}"   VerticalOptions="Center" HorizontalOptions="CenterAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" >
                        </local1:CustomLabel>
                        <local1:CustomLabel Text="{x:Static custom2:AppResources.ZVatAttachmentSizeNotfication}"  Grid.Row="1" Grid.Column="0"  Grid.ColumnSpan="2"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Padding="0" FontFamily="{StaticResource SSTArBold}" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>
                        <local1:CustomLabel Text="{x:Static custom2:AppResources.ZVatAttachmentTypeNotfication}"  Grid.Row="2" Grid.Column="0"  Grid.ColumnSpan="2"  HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand" Padding="0" FontFamily="{StaticResource SSTArBold}" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>
                        <local1:CustomLabel  Text="{x:Static custom2:AppResources.ZVatAttachmentMaxSizeNotfication}"  Grid.Row="3" Grid.Column="0"  Grid.ColumnSpan="2"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Padding="0" FontFamily="{StaticResource SSTArBold}" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>
                        <!--<Frame Grid.Row="4" IsVisible="{Binding AttachmentSizeVisibility}" CornerRadius="8" Margin="20,0,20,0" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                        </Frame>-->
                        <local1:CustomLabel  IsVisible="{Binding AttachmentSizeVisibility}" FontFamily="{StaticResource SSTArBold}"   Grid.Row="4" Grid.Column="0" Padding="0" VerticalOptions="CenterAndExpand" Grid.ColumnSpan="2" Margin="10,0,10,0"   Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" HorizontalOptions="Start" HorizontalTextAlignment="Start">
                            <local1:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding TotalAttachmentSize}"  />
                                    <Span Text="     "/>
                                    <Span Text="{x:Static custom2:AppResources.OfText}"/>
                                    <Span Text="     "/>
                                    <Span Text="300 MB"/>
                                </FormattedString>
                            </local1:CustomLabel.FormattedText>
                        </local1:CustomLabel>
                        <local1:CustomLabel Text="{x:Static custom2:AppResources.ZVatAttachments}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" >
                        </local1:CustomLabel>
                        <!--<Frame Grid.Row="6" Style="{StaticResource GAZTFrameStyleForEntry}" CornerRadius="8" Margin="10,0,10,0"  Grid.Column="0" Grid.ColumnSpan="2">
                        </Frame>
                        <custom:GAZTBorderlessEntry  Grid.Row="6" Text="{Binding AttachmentName}" Margin="20,0,20,0"   Grid.Column="0"   Style="{StaticResource GAZTTextBoxStyleForEntry}" IsEnabled="False">
                        </custom:GAZTBorderlessEntry>-->
                         <inputLayout:SfTextInputLayout    Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"    Margin="10,0,10,-6"
        Hint="{x:Static custom2:AppResources.ZZAttachment}"
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <custom:GAZTBorderlessEntry   Text="{Binding AttachmentName}" Margin="20,0,20,0"   Grid.Column="0"   Style="{StaticResource GAZTTextBoxStyleForEntry}" IsReadOnly="True">
                        </custom:GAZTBorderlessEntry>
                    </inputLayout:SfTextInputLayout>
                        <Image Grid.Row="6"  Grid.Column="1"  Margin="20,0,20,0" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_attachment.png" IsVisible="{Binding IsShowAttachmentButton}" >
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnAttachmentClick}" />
                            </Image.GestureRecognizers>
                        </Image>
                     
                        </Grid>

                                               <StackLayout x:Name="AttachmentList" Grid.Row="1"  Grid.Column="0"  HorizontalOptions="FillAndExpand" VerticalOptions="Start"  >
                            <ListView   
           ItemsSource="{Binding AttachmentList}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                                x:Name="List"
                                    BackgroundColor="White"
            ItemTapped="Attachmentlist_ItemTapped"
            SeparatorVisibility="None"
            >
                                <x:Arguments>
                                    <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                                </x:Arguments>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <ContentView>
                                                <cards1:SfCardView HasShadow="True" Margin="10" Opacity=".9" BorderWidth=".05" BorderColor="#5d6770"  ShadowColor="#5d6770" BackgroundColor="White" CornerRadius="8"  IndicatorColor="#005e4b" IndicatorPosition="Left" IndicatorThickness="5" >
                                                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"  Padding="10" >
                                                        <Grid Style="{DynamicResource GridStyle}" ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="Center" BackgroundColor="White" >
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70*" />                                                               
                                                                <ColumnDefinition Width="15*" />
                                                                <ColumnDefinition Width="15*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="30" />
                                                                <RowDefinition Height="30" />
                                                            </Grid.RowDefinitions>
                                                            <Label Text="{Binding Filename}" 
                                                                 LineBreakMode="TailTruncation"     
                                   Style="{StaticResource MicroGrayLabelStyleNew}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                                                           FontFamily="{StaticResource SSTArBold}"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   />
                                                            <Image Grid.Row="0"  Grid.Column="1" Grid.RowSpan="2"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_file_download.png"  >
                                                                <Image.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnDownloadAttachmentClicked" />
                                                                </Image.GestureRecognizers>
                                                            </Image>
                                                            <Image Grid.Row="0"  Grid.Column="2" Grid.RowSpan="2"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="{Binding DeleteImageSource}"   >
                                                                <Image.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnDeleteAttachmentClicked" />
                                                                </Image.GestureRecognizers>
                                                            </Image>
                                                            <Label Text="{Binding Erfdt}" 
                                                                       Margin="3,0,3,-5"
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                                                   FlowDirection="LeftToRight"
                                   Grid.Row="1"
                                   Grid.Column="0" Grid.ColumnSpan="2" 
                                                                   FontFamily="{StaticResource SSTArBold}"
                                   />
                                                        </Grid>
                                                    </StackLayout>
                                                </cards1:SfCardView>                       
                                            </ContentView>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackLayout>

                    </Grid>
                </ScrollView>
            </StackLayout>
            <!-- Acticity indicator layout start -->
            <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                         <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                       
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#006450"/>
                        <!--Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"-->
                    </StackLayout>
                </StackLayout>
            </Grid>
            <!-- Acticity indicator layout end -->
        </Grid>
    </ContentPage.Content>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <controls:TitleView Title=""  FontSize="14"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.GoBackClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="#006450"
                            Style="{StaticResource IconButtonStyle}"
                             Text="{DynamicResource StyleReverseBack}"
                             />
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
</ContentPage>