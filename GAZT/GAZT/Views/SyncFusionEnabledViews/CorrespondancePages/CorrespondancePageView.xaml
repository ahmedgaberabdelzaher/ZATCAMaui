                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : " FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></Span>
                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding RefNumber}" FontFamily="{StaticResource SSTArabicMedium}"></Span>
                                                                        </FormattedString>
