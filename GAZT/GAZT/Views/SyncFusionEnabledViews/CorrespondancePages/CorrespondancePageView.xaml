                                                           >
                                                                    <local:CustomLabel.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static custom2:AppResources.ZZTitle}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
></Span>
                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
></Span>
                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding Title}"  FontFamily="{StaticResource SSTArabicMedium}"></Span>
                                                                        </FormattedString>
                                                                    </local:CustomLabel.FormattedText>
                                                                </local:CustomLabel>
                                                                <!--<Label 
                                                 Style="{StaticResource MiniGoldLabelStyle}"
                                                HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                                         Text="{x:Static custom2:AppResources.ZZReferenceNumber}"
                                   >
                                                                                </Label>
