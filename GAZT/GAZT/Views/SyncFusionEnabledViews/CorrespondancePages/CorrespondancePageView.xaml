<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             xmlns:custom="clr-namespace:GAZT;clr-namespace:GAZT.CustomControl"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:local="clr-namespace:GAZT"
              xmlns:custom2="clr-namespace:EGAZT"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:tabView="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             Title="{x:Static custom2:AppResources.ZZCorrespondence}"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.Correspondance.CorrespondancePageView"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary Source="..\Common\Styles.xaml" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <!--  Title View 1  -->
                <controls:TitleView Title="{x:Static custom2:AppResources.ZZCorrespondence}"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.OnBackButtonClicked}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="#006450"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                             />
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" RowSpacing="0" Margin="0">
            <Grid HorizontalOptions="FillAndExpand" x:Name="ParentGrid"  ColumnSpacing="10"  Margin="0" RowSpacing="0"  Padding="0,0,0,-10" BackgroundColor="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>
                <tabView:SfTabView BackgroundColor="White" SelectionChanged="tabView_SelectionChanged" VerticalOptions="FillAndExpand"  x:Name="tabView" Grid.ColumnSpan="2" Grid.Row="0" Grid.Column="0"   VisibleHeaderCount="{Binding HeaderCount}" >
                    <tabView:SfTabView.SelectionIndicatorSettings>
                        <tabView:SelectionIndicatorSettings
                    Color="DarkGreen"
                    Position="Bottom"
                    StrokeThickness="2"/>
                    </tabView:SfTabView.SelectionIndicatorSettings>
                    <tabView:SfTabItem  IsVisible="{Binding IsZakatTabVisible}" Title="{Binding ZakatCountDisplay}"
                                        TitleFontSize="12"
                            SelectionColor="DarkGreen"
                             FontIconFontColor="#FF00AFF0"
                             TitleFontColor="Gray">
                        <tabView:SfTabItem.Content>
                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" x:Name="ParentGridZakat"  ColumnSpacing="10" RowSpacing="10" Margin="0,5,0,0" Padding="0,0,0,0" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="12*" />
                                    <RowDefinition Height="88*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <inputLayout:SfTextInputLayout Grid.Row="0" Grid.Column="0"   Margin="10,5,10,0"
    Hint="{x:Static custom2:AppResources.ZZSort}"
    ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                    <local:BorderlessEntry IsSpellCheckEnabled="False" Text="{Binding TxtSelectedStatusZakat}" FontSize="Small" FontAttributes="Bold">
                                    </local:BorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                                <local:CustomButton x:Name="BPickerButtonZakat" Clicked="BPickerButtonZakat_Clicked"  BackgroundColor="Transparent" Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" >
                                </local:CustomButton>
                                <syncfusion:SfPicker FlowDirection="RightToLeft"  
                   HeaderText="{x:Static custom2:AppResources.ZZSort}"
                    HeaderHeight="40"
                                    HeaderTextColor="White"
                    ShowHeader="true"
                    ShowColumnHeader="False"
                x:Name="FPickerZakat"
                   BackgroundColor="#EAF7CC"
                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"
                    HeaderBackgroundColor="#006450"
                    SelectedItemTextColor="#006450"
                    BorderColor="Black"
                    UnSelectedItemTextColor="#006450"
                             SelectedItemFontSize="14"     
                   ItemHeight="40"
                    OKButtonTextColor="#006450"  CancelButtonTextColor="#006450"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                    OkButtonClicked="FPickerZakat_OkButtonClicked"
                                    CancelButtonClicked="FPickerZakat_CancelButtonClicked"
                 SelectedIndex="{Binding SetSelectedIndexZakat}"  IsEnabled="true"  ItemsSource="{Binding CorresFilterZakat}" DisplayMemberPath="Filter" Grid.Row="0" Grid.Column="0"
                    PickerHeight="200"
                    PickerWidth="270"
                    ShowFooter="True" FooterHeight="46">
                                    <!--SelectedItem="{Binding SelectedFilterZakat,Mode=TwoWay}"-->
                                    <syncfusion:SfPicker.Behaviors>
                                        <custom:SfPickerBehavior />
                                    </syncfusion:SfPicker.Behaviors>
                                </syncfusion:SfPicker>
                                <StackLayout Margin="10,0,10,0" Padding="0"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Column="0" Grid.Row="1" >
                                    <ListView  IsVisible="{Binding IsZakatVisible}" ItemsSource="{Binding ListZAKATCorrespondance}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" HasUnevenRows="True" ItemTapped="ListView_ItemTapped" BackgroundColor="White" SeparatorVisibility="None">
                                        <x:Arguments>
                                            <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                                        </x:Arguments>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <ViewCell>
                                                    <cards:SfCardView HasShadow="True"  Margin="0,10,0,10" Opacity=".9" BorderWidth=".05" BorderColor="#5d6770"  ShadowColor="#5d6770" BackgroundColor="White" CornerRadius="4"  IndicatorColor="#005e4b" IndicatorPosition="Left" IndicatorThickness="5" >
                                                        <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Margin="5,0,5,0" Padding="10" >
                                                            <Grid ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White" >
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="90*" />
                                                                    <ColumnDefinition Width="10*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <!--<Label Text="{x:Static custom2:AppResources.ZZTitle}" Margin="0" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                           />
                                                                                <Label Text="{Binding Title}" 
                                  Margin="0" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                                           />-->
                                                                <local:CustomLabel  Margin="0" 
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                               Grid.ColumnSpan="2"                                         
                                                           >
                                                                    <local:CustomLabel.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static custom2:AppResources.ZZTitle}"></Span>
                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding Title}"></Span>
                                                                        </FormattedString>
                                                                    </local:CustomLabel.FormattedText>
                                                                </local:CustomLabel>
                                                                <!--<Label 
                                                 Style="{StaticResource MiniGoldLabelStyle}"
                                                HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                                         Text="{x:Static custom2:AppResources.ZZReferenceNumber}"
                                   >
                                                                                </Label>
                                                                                <Label Text="{Binding RefNumber}" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                                           />-->
                                                                <local:CustomLabel  Margin="0" 
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                                        Grid.ColumnSpan="2"               
                                                           >
                                                                    <local:CustomLabel.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static custom2:AppResources.ZZReferenceNumber}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}" FontSize="11"></Span>
                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "   FontFamily="{StaticResource GAZT_FONT_MEDIUM}" FontSize="11"></Span>
                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNewEn}"  FontFamily="{StaticResource SSTArabicMedium}" Text="{Binding RefNumber}"></Span>
                                                                        </FormattedString>
                                                                    </local:CustomLabel.FormattedText>
                                                                </local:CustomLabel>
                                                                <!--<Label Text="{x:Static custom2:AppResources.ZZDateandTime}" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="4"
                                   Grid.Column="0"
                                   />
                                                                                <Label  
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                    HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="5"
                                   Grid.Column="0"
                                                        Text="{Binding DateAndTime}">
                                                                                </Label>-->
                                                                <StackLayout   Grid.Row="3"
                                   Grid.Column="0"
                                                    Grid.ColumnSpan="2"  Margin="0" Orientation="Horizontal" >
                                                                    <local:CustomLabel
                                   Style="{StaticResource MicroGrayLabelStyleNew}"  
                                                   VerticalOptions="CenterAndExpand"
                                                    Margin="0,0,0,0"
                                  FontFamily="{StaticResource SSTArLight}"
                                                          >
                                                                        <local:CustomLabel.FormattedText>
                                                                            <FormattedString>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static custom2:AppResources.ZZDateandTime}"   FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></Span>
                                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : " FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></Span>
                                                                            </FormattedString>
                                                                        </local:CustomLabel.FormattedText>
                                                                    </local:CustomLabel>
                                                                    <Label
                                                   VerticalOptions="CenterAndExpand"
                                                    Margin="-5,0,-5,0"
                                                    FlowDirection="LeftToRight"
                                                        Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                                   Text="{Binding DateAndTime}"
 FontFamily="{StaticResource SSTArabicMedium}"
                                                          >
                                                                    </Label>
                                                                </StackLayout>
                                                                <!--<local:CustomLabel  Margin="0" 
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                                    Grid.ColumnSpan="2"                   
                                                           >
                                                                    <local:CustomLabel.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static custom2:AppResources.ZZDateandTime}"></Span>
                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding DateAndTime}"></Span>
                                                                        </FormattedString>
                                                                    </local:CustomLabel.FormattedText>
                                                                </local:CustomLabel>-->
                                                                <!--<StackLayout Grid.Row="1"  BackgroundColor="AliceBlue" Grid.Column="3" Grid.ColumnSpan="2" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.RowSpan="4" ></StackLayout>-->
                                                                <Image  Grid.Row="0"  Grid.Column="1"   Source="{Binding FavImg}" HorizontalOptions="StartAndExpand" VerticalOptions="StartAndExpand"/>
                                                                <!--<BoxView  
                     Grid.Row="0" Grid.Column="2" Grid.RowSpan="10" Margin="0" BackgroundColor="Gray" VerticalOptions="Fill" HorizontalOptions="Center" WidthRequest="1"/>-->
                                                            </Grid>
                                                        </StackLayout>
                                                    </cards:SfCardView>
                                                </ViewCell>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <local:CustomLabel  Margin="0,20,0,0" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" Text="{x:Static custom2:AppResources.Nodataavailable}" Style="{StaticResource MiniBlackLabelStyle}"  HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsZakatVisibleLabel}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}">
                                    </local:CustomLabel>
                                </StackLayout>
                            </Grid>
                        </tabView:SfTabItem.Content>
                    </tabView:SfTabItem>
                    <tabView:SfTabItem   IsVisible="{Binding IsVATTabVisible}" Title="{Binding VATCountDisplay}"  TitleFontSize="12"
                            SelectionColor="DarkGreen"
                             FontIconFontColor="#FF00AFF0"
                             TitleFontColor="Gray">
                        <tabView:SfTabItem.Content>
                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" x:Name="ParentGridVAT"  ColumnSpacing="10" RowSpacing="10" Margin="0,5,0,0" Padding="0,0,0,10" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="12*" />
                                    <RowDefinition Height="88*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <inputLayout:SfTextInputLayout Grid.Row="0" Grid.Column="0"   Margin="10,5,10,-6"
        Hint="{x:Static custom2:AppResources.ZZSort}"
    ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                    <local:BorderlessEntry IsSpellCheckEnabled="False" Text="{Binding TxtSelectedStatusVAT}" FontSize="Small" FontAttributes="Bold">
                                    </local:BorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                                <local:CustomButton x:Name="BPickerButtonVAT" Clicked="BPickerButtonVAT_Clicked" BackgroundColor="Transparent" Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" >
                                </local:CustomButton>
                                <syncfusion:SfPicker
                                    HeaderTextColor="White"
                    HeaderHeight="40"
                    ShowHeader="true"
                    ShowColumnHeader="False"
                x:Name="FPickerVAT"
                   BackgroundColor="#EAF7CC"
                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"
                    HeaderBackgroundColor="#006450"
                    SelectedItemTextColor="#006450"
                    BorderColor="Black"
                    OKButtonTextColor="#006450"  CancelButtonTextColor="#006450"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    CancelButtonBackgroundColor="#EAF7CC"
                    UnSelectedItemTextColor="#006450"
                             SelectedItemFontSize="14"     
                   ItemHeight="40"
                    OkButtonClicked="FPickerVAT_OkButtonClicked"
                                    CancelButtonClicked="FPickerVAT_CancelButtonClicked"
                 SelectedIndex="{Binding SetSelectedIndexVAT}"  IsEnabled="true"  ItemsSource="{Binding CorresFilterVAT}" DisplayMemberPath="Filter" Grid.Row="0" Grid.Column="0"
                    PickerHeight="200"
                    PickerWidth="270"
                    ShowFooter="True" FooterHeight="46">
