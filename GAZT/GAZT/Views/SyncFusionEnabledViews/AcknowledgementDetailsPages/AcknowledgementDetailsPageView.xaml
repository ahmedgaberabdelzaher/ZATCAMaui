<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             mc:Ignorable="d"
              xmlns:local="clr-namespace:EGAZT;assembly:GAZT"
              xmlns:local1="clr-namespace:GAZT"
              xmlns:custom="clr-namespace:GAZT"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:converter="clr-namespace:GAZTeServicesApp.Converters"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.AcknowledgementDetails.AcknowledgementDetailsPageView"
             NavigationPage.HasNavigationBar="False"
           BackgroundColor="White" >
    <!--<ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="ic_home.png"  
                Priority="0" Order="Primary" Command="{Binding OnHomeClick}" />
    </ContentPage.ToolbarItems>-->
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:BooleanToColorConverter x:Key="ColorConverter" />
            <ResourceDictionary.MergedDictionaries>
               <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <controls:TitleView Title="{x:Static local:AppResources.Acknowlwdgement}"  FontSize="13"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.GoBackClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="{StaticResource Primary}"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                             />
                    </controls:TitleView.LeadingView>
                    <controls:TitleView.TrailingView>
                        <buttons:SfButton
                            x:Name="HomeButton"
                            Command="{TemplateBinding BindingContext.GoHomeClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="{StaticResource Primary}"
                            Style="{StaticResource IconButtonStyle}"
                             Text="{DynamicResource Home}"
                             />
                    </controls:TitleView.TrailingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid x:Name="ParentContainerForChangeMobileNumber" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
            <Grid.RowDefinitions>
                <RowDefinition Height="100*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackLayout Grid.Row="0" Grid.Column="0" BackgroundColor="White">
                <ScrollView BackgroundColor="White">
                    <StackLayout VerticalOptions="FillAndExpand" BackgroundColor="White">
                        <StackLayout  VerticalOptions="FillAndExpand" BackgroundColor="White">
                            <Label Text="{x:Static local:AppResources.ZVatAcknowledgmentReceiptText}"    HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Padding="0" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" FontFamily="{StaticResource GAZT_FONT_BOLD}"/>
                            <Label Text="{x:Static local:AppResources.ZZName}"    HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}" FontFamily="{StaticResource GAZT_FONT_BOLD}"></Label>
                            <Label Text="{Binding TPName}"   HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Padding="0" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" FontFamily="{StaticResource GAZT_FONT_BOLD}"/>
                            <Label Text="{x:Static local:AppResources.ZVatReturnReferenceNumber}"    HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}" FontFamily="{StaticResource GAZT_FONT_BOLD}"/>
                            <Label Text="{Binding ReturnReferenceNumber}" FontFamily="{StaticResource SomarSemiBold}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Padding="0" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>
                            <Label Text="{x:Static local:AppResources.ZZPleaseretainthisnumberforfuturereferenceandcommunucation}"     HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Padding="0" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" FontFamily="{StaticResource GAZT_FONT_BOLD}"/>
                            <Label Text="{x:Static local:AppResources.ZVatTaxablePeriod}"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}" FontFamily="{StaticResource GAZT_FONT_BOLD}"/>
                            <Label Text="{Binding TaxablePeriod}" FontFamily="{StaticResource SomarSemiBold}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Padding="0" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" />
                            <Label Text="{x:Static local:AppResources.ZVatReceiptDate}"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}" FontFamily="{StaticResource GAZT_FONT_BOLD}"/>
                            <Label Text="{Binding ReceiptDate}" FlowDirection="LeftToRight"  FontFamily="{StaticResource SomarSemiBold}"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Padding="0" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>
                            <Label Text="{x:Static local:AppResources.ZSadadNumber}"    HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}" IsVisible="{Binding IsSadadNumberVisible}" FontFamily="{StaticResource GAZT_FONT_BOLD}"/>
                            <Label Text="{Binding SadadNumber}" FontFamily="{StaticResource SomarSemiBold}"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Padding="0" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" IsVisible="{Binding IsSadadNumberVisible}"/>
                            <Label Text="{x:Static local:AppResources.ZAmountPayable}"   HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}" IsVisible="{Binding IsSadadNumberVisible}" FontFamily="{StaticResource GAZT_FONT_BOLD}"/>
                            <local1:CustomLabel  Grid.Row="14"  HorizontalOptions="StartAndExpand" FontFamily="{StaticResource SomarSemiBold}" VerticalOptions="CenterAndExpand" Padding="0" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" IsVisible="{Binding IsSadadNumberVisible}">
                                <local1:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding AmountPayable}"  FontFamily="{StaticResource SomarBold}"/>
                                        <Span Text="&#160;&#160;"/>
                                        <Span Text="{x:Static local:AppResources.ZSAR}" FontFamily="{StaticResource GAZT_FONT_BOLD}"/>
                                    </FormattedString>
                                </local1:CustomLabel.FormattedText>
                            </local1:CustomLabel>
                            <local1:CustomLabel Text="{x:Static local:AppResources.ZVatAcknowledgmentWaitingText}" FontFamily="{StaticResource SomarSemiBold}"   HorizontalOptions="StartAndExpand" Padding="0" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" IsVisible="{Binding IsSadadNoteVisible}"/>
                            <local1:CustomLabel Text="{x:Static local:AppResources.BreakDownLabel}"    HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" IsVisible="{Binding BreakdownAmountVisibility}" FontFamily="{StaticResource GAZT_FONT_BOLD}"/>
                            <local1:CustomLabel Text="{x:Static local:AppResources.ZVatAcknowledgmentHelpText}" Padding="0" FontFamily="{StaticResource SomarSemiBold}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>
                            <!--<Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}" Grid.ColumnSpan="2">
                        <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.7" VerticalOptions="FillAndExpand">
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                <ActivityIndicator IsVisible="true" IsRunning="true" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Color="White" />
                                <Label Text="{x:Static local:AppResources.ActivityIndicatorTitle}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" />
                            </StackLayout>
                        </StackLayout>
                    </Grid>-->
                        </StackLayout>
                        <StackLayout VerticalOptions="EndAndExpand">
                            <buttons:SfButton Text="{x:Static local:AppResources.ZVatRefresh}" IsVisible="{Binding IsRefreshButtonVisible}" Clicked="OnVATRefreshButtonClicked" Margin="0" CornerRadius="0" Padding="0" HeightRequest="56"  Style="{StaticResource SfButtonStyle}" BackgroundColor="{StaticResource Primary}"  VerticalOptions="EndAndExpand"></buttons:SfButton>
                            <buttons:SfButton Text="{x:Static local:AppResources.DownloadAcknowlwdgement}" IsVisible="{Binding IsAcknowledgementButtonVisible}" Command="{Binding OnAcknowlwdgementClicked}" Margin="0" CornerRadius="0" Padding="0" HeightRequest="56" Style="{StaticResource SfButtonStyle}" BackgroundColor="{StaticResource Primary}"  VerticalOptions="EndAndExpand"></buttons:SfButton>
                            <buttons:SfButton Text="{x:Static local:AppResources.ZDownloadForm}" IsVisible="{Binding IsButtonVisible}" Command="{Binding OnDownloadFormClicked}" Margin="0" CornerRadius="0" Padding="0" HeightRequest="56" Style="{StaticResource SfButtonStyle}" BackgroundColor="{StaticResource Primary}"  VerticalOptions="EndAndExpand"></buttons:SfButton>
                        </StackLayout>
                    </StackLayout>
                </ScrollView>
            </StackLayout>
            <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                       
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="{StaticResource Primary}"/>
                        <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>