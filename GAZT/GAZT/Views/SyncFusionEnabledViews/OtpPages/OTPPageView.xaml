<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:EGAZT;assembly:GAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:converter="clr-namespace:GAZTeServicesApp.Converters"
             xmlns:core="clr-namespace:Syncfusion.XForms.Core;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:gradient="clr-namespace:Syncfusion.XForms.Graphics;assembly=Syncfusion.Core.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.OTPPage.OTPPageView"
             Title="{x:Static local:AppResources.EnterVerificationCodeTitle}"
              NavigationPage.HasNavigationBar="False"
          BackgroundColor="White" >
    <!--Style="{StaticResource ContentPageStyle}"-->
    <!--BackgroundImageSource="{core:OnPlatformOrientationStringValue Default=sf_LoginBackground.png,
                                                                  iOSPhoneLandscape=sf_LoginBackground-Landscape.png,
                                                                  iOSTabletLandscape=sf_LoginBackground-Landscape.png}"-->
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:BooleanToColorConverter x:Key="ColorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid x:Name="ParentContainerForOTP">
            <Grid.RowDefinitions>
                <RowDefinition Height="100*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackLayout Grid.Row="0" Grid.Column="0">
                <custom:CustomLabel
                x:Name="BackLabel"
                       VerticalOptions="StartAndExpand"
                HorizontalOptions="StartAndExpand"
                        Margin="8,10,8,0"
                        Style="{StaticResource IconLabelStyle}"
                         TextColor="#ffffff"
                        Text="{DynamicResource StyleReverseBack}">
                    <custom:CustomLabel.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackButtonClicked}"></TapGestureRecognizer>
                    </custom:CustomLabel.GestureRecognizers>
                </custom:CustomLabel>
                <gradient:SfGradientView Style="{StaticResource SfGradientViewStyle}" />
                <!--Margin="{core:OnPlatformOrientationThickness PhonePortrait='20,32',
                                                                 PhoneLandscape='150,32',
                                                                 TabletPortrait='200,50',
                                                                 TabletLandscape='300,50',
                                                                 Desktop='30'}"-->
                <StackLayout WidthRequest="{OnPlatform Default='-1',
                                              UWP='350'}" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" Orientation="Vertical"
                             IsVisible="{Binding OTPLayoutVisibility}" Padding="0,10,0,0">
                    <ScrollView HorizontalOptions="Center">
                        <ScrollView.VerticalOptions>
                            <OnIdiom
                        x:TypeArguments="LayoutOptions"
                        Default="CenterAndExpand"
                        Phone="FillAndExpand" />
                        </ScrollView.VerticalOptions>
                        <Grid Grid.Row="0" Grid.Column="0" RowSpacing="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" RowSpacing="0" ColumnSpacing="0"  VerticalOptions="CenterAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto " />
                                    <RowDefinition Height="Auto " />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*" />
                                    <ColumnDefinition Width="50*" />
                                </Grid.ColumnDefinitions>
                                <Label Text="{x:Static local:AppResources.EnterVerificationCodeTitle}" Margin="0,0,0,30" Style="{StaticResource LabelStyle}"
                                       FontFamily="{StaticResource GAZT_FONT_BOLD}" VerticalOptions="CenterAndExpand"
                                       HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center"  Grid.Row="0" Grid.Column="0"
                                       Grid.ColumnSpan="2"/>
                                <Label Text="{Binding OTPSentOnThisText}" Style="{StaticResource LabelStyle}" FontFamily="{StaticResource SSTArabicMedium}" VerticalOptions="CenterAndExpand"
                                       HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center"  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"/>
                                <!--<Label Grid.Row="1"  Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static local:AppResources.UserName}" Style="{StaticResource GAZTSmallGreenLabelStyle}" HorizontalOptions="Start" VerticalOptions="Center" >
                        </Label>
                        <Frame Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="2"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource GAZTFrameStyleForEntry}" >
                        </Frame>
                        <Label  Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="2" FontFamily="{StaticResource SSTArBold}" Text="{Binding TinNumber}" TextColor="#7D858D" Style="{StaticResource ForgotPasswordTextColor}" HorizontalOptions="Start" VerticalOptions="Center" IsEnabled="False">
                        </Label>-->
                                <!--<inputLayout:SfTextInputLayout   x:Name="UsernameLayout"  Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.UserName}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                <custom:GAZTBorderlessEntry Text="{Binding TinNumber}" IsReadOnly="True"  TextColor="#7D858D" x:Name="Username"  FontSize="Small" >
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>-->
                                <!--<Label Grid.Row="3"  Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding EmailOrMobileNumber}" Style="{StaticResource GAZTSmallGreenLabelStyle}" HorizontalOptions="Start" VerticalOptions="Center" >
                        </Label>
                        <Frame Grid.Row="4"  Grid.Column="0" Grid.ColumnSpan="2"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource GAZTFrameStyleForEntry}" >
                        </Frame>
                        <Label Grid.Row="4"  Grid.Column="0" Grid.ColumnSpan="2" FontFamily="{StaticResource SSTArBold}" Text="{Binding MobileNumber}" TextColor="#7D858D" Style="{StaticResource ForgotPasswordTextColor}" HorizontalOptions="Start" VerticalOptions="Center" IsEnabled="False">
                        </Label>-->
                                <!--<inputLayout:SfTextInputLayout   x:Name="EmailOrMobileLayout"  Grid.Row="3"  Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{Binding EmailOrMobileNumber}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                <custom:GAZTBorderlessEntry Text="{Binding MobileNumber}" x:Name="EmailOrMobile" IsReadOnly="True"  TextColor="#7D858D" FontSize="Small"  >
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>-->
                                <!--<Label Grid.Row="5" Grid.Column="0"  Grid.ColumnSpan="2"  HorizontalOptions="Start" Style="{StaticResource GAZTSmallGreenLabelStyle}" >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span  Text="{x:Static local:AppResources.VarificationCode}"   />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>-->
                                <inputLayout:SfTextInputLayout   x:Name="enterOtp"  Grid.Row="2"  Grid.Column="0"  Grid.ColumnSpan="2" WidthRequest="100"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.VarificationCode}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                                    <custom:GAZTBorderlessEntry Text="{Binding EnteredOTP}"  x:Name="EnteredOTP" TextChanged="OnOTPEntered" Keyboard="Numeric" Placeholder="{Binding VarificationCode}"  FontSize="Small" TextColor="White" IsPassword="True" IsEnabled="{Binding IsOTPEntryEnable}" >
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <custom:NumericValidationBehavior/>
                                        </custom:GAZTBorderlessEntry.Behaviors>
                                    </custom:GAZTBorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                                <!--<Frame  Grid.Row="6"  Grid.Column="0"  Grid.ColumnSpan="2"    HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource GAZTFrameStyleForEntry}" BorderColor="{Binding FrmColour}" >
                        </Frame>
                            <local:GAZTBorderlessEntry  Text="{Binding EnteredOTP}" Grid.Row="6"  Grid.Column="0" Grid.ColumnSpan="2" x:Name="EnteredOTP"  TextChanged="OnOTPEntered" Keyboard="Numeric" Placeholder="{Binding VarificationCode}" Style="{StaticResource GAZTTextBoxStyleForEntry}"      IsEnabled="{Binding IsOTPEntryEnable}" IsPassword="True">
                            <local:GAZTBorderlessEntry.Behaviors>
                              <local:NumericValidationBehavior/>
                            </local:GAZTBorderlessEntry.Behaviors>
                            </local:GAZTBorderlessEntry>-->
                                <Label Grid.Row="5" x:Name="NumberOfAttemptsText" Grid.Column="0" IsVisible="{Binding IsNumberOfAttemptTextVisible}" Grid.ColumnSpan="2" TextColor="#D99A29"   Style="{StaticResource InformationRedColorLabel}" FontFamily="{StaticResource SSTArBold}" HorizontalOptions="CenterAndExpand" Margin="10,0,10,0">
                                </Label>
                                <Label Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="CenterAndExpand" VerticalOptions="EndAndExpand" Margin="10,0,10,0">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span  Text="{x:Static local:AppResources.TheAccountwillbelockedwithinTwomin}" TextColor="#7D858D"   Style="{StaticResource MicroGrayLabelStyleNewEn}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}" />
                                            <Span  Text="{Binding OTPValidDuration}" TextColor="#D99A29" FontFamily="{StaticResource SSTArBold}" Style="{StaticResource InformationRedColorLabel}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <buttons:SfButton x:Name="BtnVerify"
                            Grid.Row="7"
                            Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="10,16,10,50"
                          BackgroundColor="{Binding VerifyButtonDisableColor}"
                                     Command="{Binding OnSubmitClicked}"
                    IsEnabled="{Binding IsVerifyOTPEnabled}"
                    Text="{x:Static local:AppResources.Verify}"
                            Style="{StaticResource SfButtonStyle}"
                           >
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Property="TextColor" Value="gray" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="TextColor" Value="White" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </buttons:SfButton>
                                <!--<StackLayout Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2">  
       <Button Text="Pick File" Clicked="Button_Clicked" HorizontalOptions="Center"  
               VerticalOptions="Center"/>  
       <Label Text="File Is :" x:Name="lbl"/>  
   </StackLayout>-->
                            </Grid>
                        </Grid>
                    </ScrollView>
                </StackLayout>
                <StackLayout  VerticalOptions="EndAndExpand" Margin="0" Padding="0"  Orientation="Vertical">
                    <buttons:SfButton
                    Margin="0"
                    VerticalOptions="EndAndExpand"
                HorizontalOptions="FillAndExpand"
                    BackgroundColor="{Binding ButtonDisableColor}"
                            Opacity="0.7"
                   FontFamily="{StaticResource GAZT_FONT_BOLD}"
                    HeightRequest="56"
                    CornerRadius="0"
                Command="{Binding OnResendOTPClicked}"
                            IsEnabled="{Binding IsResendOTPEnabled}"
                            Text="{x:Static local:AppResources.ResendOTP}"
                    TextColor="{DynamicResource Gray-White}"
                     >
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Property="TextColor" Value="gray" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="TextColor" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </buttons:SfButton>
                </StackLayout>
                <!-- Acticity indicator layout start -->
                <!--<Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
            <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.7" VerticalOptions="FillAndExpand">
            </StackLayout>
            <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" >
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <ActivityIndicator IsVisible="true" IsRunning="true" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Color="White" />
                    <Label Text="{x:Static local:AppResources.ActivityIndicatorTitle}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" />
                </StackLayout>
            </StackLayout>
        </Grid>-->
                <!-- Acticity indicator layout end -->
            </StackLayout>
            <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                      AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                        
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#d99a29"/>
                        <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>