<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:GAZT;assembly:GAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:converter="clr-namespace:GAZTeServicesApp.Converters"
             x:Class="GAZT.Views.NewViews.OTPPageView"
             Title="{x:Static local:AppResources.EnterVerificationCodeTitle}"
            
             FlowDirection="RightToLeft">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:BooleanToColorConverter x:Key="ColorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
          
                 <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical"  IsVisible="{Binding OTPLayoutVisibility}" BackgroundColor="White" >
                    <Grid Grid.Row="0" Grid.Column="0" RowSpacing="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto " />
                            <RowDefinition Height="Auto " />

                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*" />
                            <ColumnDefinition Width="50*" />
                        </Grid.ColumnDefinitions>


                       <Label  Style="{StaticResource LabelStyle}" FontFamily="{StaticResource SSTArBold}" VerticalOptions="CenterAndExpand" HorizontalOptions="Start" HorizontalTextAlignment="Center"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"   >
            </Label>

                        <!--<Label
                           Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="0,8"
                            FontFamily="{StaticResource SSTArBold}"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource LabelStyle}"
                            Text="{Binding OTPSentOnThisText}" />-->


                        <!--<Label Grid.Row="1"  Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static local:AppResources.UserName}" Style="{StaticResource GAZTSmallGreenLabelStyle}" HorizontalOptions="Start" VerticalOptions="Center" >
                        </Label>
                        <Frame Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="2"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource GAZTFrameStyleForEntry}" >
                        </Frame>
                        <Label  Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="2" FontFamily="{StaticResource SSTArBold}" Text="{Binding TinNumber}" TextColor="#7D858D" Style="{StaticResource ForgotPasswordTextColor}" HorizontalOptions="Start" VerticalOptions="Center" IsEnabled="False">
                        </Label>-->

                        <inputLayout:SfTextInputLayout   x:Name="UsernameLayout"  Grid.Row="1"  Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.UserName}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                            <local:GAZTBorderlessEntry Text="{Binding TinNumber}" x:Name="Username"  FontSize="Small" IsEnabled="False" >
                               
                            </local:GAZTBorderlessEntry>
                        </inputLayout:SfTextInputLayout>


                        <!--<Label Grid.Row="3"  Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding EmailOrMobileNumber}" Style="{StaticResource GAZTSmallGreenLabelStyle}" HorizontalOptions="Start" VerticalOptions="Center" >
                        </Label>
                        <Frame Grid.Row="4"  Grid.Column="0" Grid.ColumnSpan="2"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource GAZTFrameStyleForEntry}" >
                        </Frame>
                        <Label Grid.Row="4"  Grid.Column="0" Grid.ColumnSpan="2" FontFamily="{StaticResource SSTArBold}" Text="{Binding MobileNumber}" TextColor="#7D858D" Style="{StaticResource ForgotPasswordTextColor}" HorizontalOptions="Start" VerticalOptions="Center" IsEnabled="False">
                        </Label>-->


                        <inputLayout:SfTextInputLayout   x:Name="EmailOrMobileLayout"  Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{Binding EmailOrMobileNumber}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                            <local:GAZTBorderlessEntry Text="{Binding MobileNumber}" x:Name="EmailOrMobile"  FontSize="Small" IsEnabled="False" >
                             
                            </local:GAZTBorderlessEntry>
                        </inputLayout:SfTextInputLayout>

                        <!--<Label Grid.Row="5" Grid.Column="0"  Grid.ColumnSpan="2"  HorizontalOptions="Start" Style="{StaticResource GAZTSmallGreenLabelStyle}" >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span  Text="{x:Static local:AppResources.VarificationCode}"   />
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>-->

                        <inputLayout:SfTextInputLayout   x:Name="enterOtp"  Grid.Row="3"  Grid.Column="0"  Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.VarificationCode}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                            <local:GAZTBorderlessEntry Text="{Binding EnteredOTP}" x:Name="EnteredOTP" TextChanged="OnOTPEntered" Keyboard="Numeric" Placeholder="{Binding VarificationCode}"  FontSize="Small" IsPassword="True" IsEnabled="{Binding IsOTPEntryEnable}" >
                                <local:GAZTBorderlessEntry.Behaviors>
                                    <local:NumericValidationBehavior/>
                                </local:GAZTBorderlessEntry.Behaviors>
                            </local:GAZTBorderlessEntry>
                        </inputLayout:SfTextInputLayout>


                        <!--<Frame  Grid.Row="6"  Grid.Column="0"  Grid.ColumnSpan="2"    HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource GAZTFrameStyleForEntry}" BorderColor="{Binding FrmColour}" >
                        </Frame>
                            <local:GAZTBorderlessEntry  Text="{Binding EnteredOTP}" Grid.Row="6"  Grid.Column="0" Grid.ColumnSpan="2" x:Name="EnteredOTP"  TextChanged="OnOTPEntered" Keyboard="Numeric" Placeholder="{Binding VarificationCode}" Style="{StaticResource GAZTTextBoxStyleForEntry}"      IsEnabled="{Binding IsOTPEntryEnable}" IsPassword="True">
                            <local:GAZTBorderlessEntry.Behaviors>
                              <local:NumericValidationBehavior/>
                            </local:GAZTBorderlessEntry.Behaviors>
                            </local:GAZTBorderlessEntry>-->

                        <Label Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding AccountWillBeBlocked}"  Style="{StaticResource InformationRedColorLabel}"  HorizontalOptions="Start" Margin="10,0,10,0">
                        </Label>

                        <Label Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="StartAndExpand"  Margin="10,0,10,0">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span  Text="{x:Static local:AppResources.TheAccountwillbelockedwithinTwomin}"  Style="{StaticResource InformationGrayColorLabel}"   />
                                    <Span  Text="{Binding OTPValidDuration}" FontFamily="{StaticResource SSTArBold}" Style="{StaticResource InformationRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Button Text="{x:Static local:AppResources.ResendOTP}"  Command="{Binding OnResendOTPClicked}" VerticalOptions="StartAndExpand"  Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTVerifyButton}" BackgroundColor="{Binding ButtonDisableColor}" IsEnabled="{Binding IsResendOTPEnabled}"></Button>

                        <Button Text="{x:Static local:AppResources.Verify}"  Command="{Binding OnSubmitClicked}" VerticalOptions="StartAndExpand"  Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTVerifyButton}" BackgroundColor="{Binding VerifyButtonDisableColor}" IsEnabled="{Binding IsVerifyOTPEnabled}"></Button>


                         <!--<StackLayout Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2">  
       <Button Text="Pick File" Clicked="Button_Clicked" HorizontalOptions="Center"  
               VerticalOptions="Center"/>  
       <Label Text="File Is :" x:Name="lbl"/>  
   </StackLayout>-->
                    </Grid>
                </StackLayout>
                </ScrollView>
            <!-- Acticity indicator layout start -->
        <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
            <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.7" VerticalOptions="FillAndExpand">
            </StackLayout>
            <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" >
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <ActivityIndicator IsVisible="true" IsRunning="true" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Color="White" />
                    <Label Text="{x:Static local:AppResources.ActivityIndicatorTitle}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" />
                </StackLayout>
            </StackLayout>
        </Grid>
        <!-- Acticity indicator layout end -->
        </Grid>
    </ContentPage.Content>
</ContentPage>