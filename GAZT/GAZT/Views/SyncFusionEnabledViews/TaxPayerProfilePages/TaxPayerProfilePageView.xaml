<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:local="clr-namespace:EGAZT;assembly:GAZT"
             xmlns:converter="clr-namespace:GAZTeServicesApp.Converters"
             xmlns:core="clr-namespace:Syncfusion.XForms.Core;assembly=Syncfusion.Core.XForms"
             xmlns:gradient="clr-namespace:Syncfusion.XForms.Graphics;assembly=Syncfusion.Core.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             mc:Ignorable="d"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.TaxPayerProfile_View.TaxPayerProfilePageView"
             Title="{x:Static local:AppResources.TaxpayerProfile}"
             BackgroundColor="White"
              NavigationPage.HasNavigationBar="False"
     >
    <!--  Style="{StaticResource ContentPageStyle}"
    BackgroundImageSource="{core:OnPlatformOrientationStringValue Default=sf_LoginBackground.png,
                                                                  iOSPhoneLandscape=sf_LoginBackground-Landscape.png,
                                                                  iOSTabletLandscape=sf_LoginBackground-Landscape.png}"-->
    <ContentPage.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary>
                <ResourceDictionary Source="..\CommonStyle\Styles.xaml" />
            </ResourceDictionary>-->
            <converter:BooleanToColorConverter x:Key="ColorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <!--<ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                --><!--  Title View  --><!--
                <controls:TitleView Title="{x:Static local:AppResources.TaxpayerProfile}"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.BackButtonClicked}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="#006450"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                             />
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
