<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:EGAZT;assembly:GAZT"
             xmlns:animations="clr-namespace:Rg.Plugins.Popup.Animations;assembly=Rg.Plugins.Popup"
             xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup" xmlns:local1="clr-namespace:GAZT"
             FlowDirection="{Binding FlowDirections}" 
             x:Class="EGAZT.Views.SyncFusionEnabledViews.AddPop.AddPopPageView">
    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
               >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Frame Margin="10,0,10,0" CornerRadius="2" BorderColor="Gray" Opacity="2" Grid.ColumnSpan="2" Grid.Row="0" Grid.Column="0"  HorizontalOptions="CenterAndExpand" VerticalOptions="Center" BackgroundColor="White">
                <StackLayout  HorizontalOptions="CenterAndExpand" VerticalOptions="Center" BackgroundColor="White">
                    <StackLayout Orientation="Horizontal"  BackgroundColor="White"  VerticalOptions="Center">
                        <Label Margin="0,0,0,0" Text="{Binding HeaderText}"  FontFamily="{StaticResource SomarSemiBold}"   HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTSmallGreenLabelStyle}"/>
                        <Image  Grid.Row="0" Grid.Column="1"  HorizontalOptions="End" Source="ic_close.png">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="CloseImage_Tapped"></TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>
                    </StackLayout>
                    <Label x:Name="Message_label" FontFamily="{StaticResource SomarSemiBold}" LineHeight="0.8" Margin="0,0,0,0" Padding="2" Text="{Binding PopMessage}"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" FontAttributes="{Binding IsBold}" TextColor="{Binding IsRed}"  FlowDirection="{Binding FlowDirections}" />
                    <Label  x:Name="xyz" FlowDirection="{Binding FlowDirections}"  Margin="0,0,0,0" Text="{Binding LinkMessage}" TextDecorations="Underline"  IsVisible="{Binding IsVisibleLink}"   HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding onLinkClicked}"></TapGestureRecognizer>
                        </Label.GestureRecognizers>
                    </Label>
                </StackLayout>
            </Frame>
        </Grid>
    </ScrollView>
</pages:PopupPage>