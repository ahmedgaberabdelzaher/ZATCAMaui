<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GAZT"
             xmlns:custom2="clr-namespace:EGAZT"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:local2="clr-namespace:GAZT.CustomControl"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:tabView="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.MyCertificate.MyCertificate" FlowDirection="RightToLeft"
             Title="{x:Static custom2:AppResources.MyCertificate}"
              NavigationPage.HasNavigationBar="False"
               BackgroundColor="#005e4b">
    <ContentPage.Resources>
        <ResourceDictionary>
            <local2:DataMarkerConverter x:Key="converter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <!--<StackLayout Spacing="0">
                <controls:TitleView Title="{x:Static custom2:AppResources.MyCertificate}"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.BackButtonClicked}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="#006450"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                             />
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>-->
            <Grid>
                <StackLayout>
                    <Grid Padding="0,5,0,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static custom2:AppResources.MyCertificate}" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" FontSize="Large" />
                        <Label Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}"  Style="{StaticResource IconLabelStyle}" Text="{DynamicResource StyleReverseBack}" TextColor="White" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer      Command="{TemplateBinding BindingContext.BackButtonClicked}" ></TapGestureRecognizer>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <yummy:PancakeView  BackgroundColor="Black" CornerRadius="32,32,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,15,0,0" BackgroundColor="White" x:Name="VATRMainGrid">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="10*" />
                                <RowDefinition Height="90*" />

                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="1" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <StackLayout x:Name="MainLayout" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <tabView:SfTabView BackgroundColor="White" x:Name="tabView" Grid.ColumnSpan="2" Grid.Row="0" Grid.Column="0" VisibleHeaderCount="3" SelectedIndex="{Binding SelectedTab}"  >
            <tabView:SfTabView.SelectionIndicatorSettings>
                <tabView:SelectionIndicatorSettings
                    Color="DarkGreen"
                    Position="Bottom"
                    StrokeThickness="2"/>
            </tabView:SfTabView.SelectionIndicatorSettings>
            <tabView:SfTabItem Title="{x:Static custom2:AppResources.ZakatCertificates}" IsVisible="{Binding IsCertificateAvailableZakatTab}"
                                TitleFontSize="12"
                            SelectionColor="DarkGreen"
                               FontIconFontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                               TitleFontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                               FontIconFontColor="#FF00AFF0"
                             TitleFontColor="Gray">
                <tabView:SfTabItem.Content>
                    <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0,0,0,0" Margin="0,10,0,0">
                        <ListView  IsVisible="{Binding IsCertificateAvailableZakat}" ItemsSource ="{Binding CertificateListZakat}" VerticalOptions="Fill" x:Name="CertificateLstZakat" HasUnevenRows="true" SelectedItem="{Binding SelectedCertificate}" BackgroundColor="Transparent" SeparatorVisibility="None">
                            <x:Arguments>
                                <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                            </x:Arguments>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <cards:SfCardView HasShadow="True" Margin="10" Opacity=".9" BorderWidth=".05" BorderColor="#5d6770"  ShadowColor="#5d6770" BackgroundColor="White" CornerRadius="3"  IndicatorColor="DarkGreen" IndicatorPosition="Left" IndicatorThickness="5" >
                                            <StackLayout Orientation="Horizontal" Margin="0,5,0,5">
                                                <local:CustomLabel Text="{Binding Descript}" Style="{StaticResource MiniBlackLabelStyle}"    FontFamily="{StaticResource GAZT_FONT_MEDIUM}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Margin="10" HorizontalTextAlignment="Start">
                                                </local:CustomLabel>
                                                <Image Source="ic_pdf.png" Aspect="AspectFit" HorizontalOptions="End" VerticalOptions="CenterAndExpand" Margin="10,0,10,0">
                                                </Image>
                                            </StackLayout>
                                        </cards:SfCardView>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                            <local:CustomLabel Margin="0,20,0,0"  Text="{x:Static custom2:AppResources.Nocertificateavailable}" Style="{StaticResource MiniBlackLabelStyle}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding SetNoDataLabelVisibilityZakat}">
                        </local:CustomLabel>
                    </StackLayout>
                </tabView:SfTabItem.Content>
            </tabView:SfTabItem>
            <tabView:SfTabItem Title="{x:Static custom2:AppResources.VATCertificates}" IsVisible="{Binding IsCertificateAvailableVATTab}"
                                TitleFontSize="12"
                            SelectionColor="DarkGreen"
                             FontIconFontColor="#FF00AFF0"
                              FontIconFontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                               TitleFontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                               TitleFontColor="Gray">
                <tabView:SfTabItem.Content>
                        <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0,0,0,0" Margin="0,10,0,0">
                        <ListView IsVisible="{Binding IsCertificateAvailableVAT}"   ItemsSource ="{Binding CertificateListVAT}" VerticalOptions="Fill" x:Name="CertificateLstVAT" HasUnevenRows="true" SelectedItem="{Binding SelectedCertificate}" BackgroundColor="Transparent" SeparatorVisibility="None">
                            <x:Arguments>
                                <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                            </x:Arguments>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                            <cards:SfCardView HasShadow="True" Margin="10"  Opacity=".9" BorderWidth=".05" BorderColor="#5d6770"  ShadowColor="#5d6770" BackgroundColor="White" CornerRadius="3"  IndicatorColor="DarkGreen" IndicatorPosition="Left"  IndicatorThickness="5" >
                                                <StackLayout Orientation="Horizontal" Padding="0,5,0,5">
                                                <local:CustomLabel Text="{Binding Descript}" Style="{StaticResource MiniBlackLabelStyle}"    FontFamily="{StaticResource GAZT_FONT_MEDIUM}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Margin="10" HorizontalTextAlignment="Start">
                                                </local:CustomLabel>
                                                <Image Source="ic_pdf.png" Aspect="AspectFit" HorizontalOptions="End" VerticalOptions="CenterAndExpand" Margin="10,0,10,0">
                                                </Image>
                                            </StackLayout>
                                        </cards:SfCardView>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                            <local:CustomLabel Margin="0,20,0,0" Text="{x:Static custom2:AppResources.Nocertificateavailable}" Style="{StaticResource MiniBlackLabelStyle}"   FontFamily="{StaticResource GAZT_FONT_MEDIUM}"  HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding SetNoDataLabelVisibilityVAT}">
                        </local:CustomLabel>
                    </StackLayout>
                </tabView:SfTabItem.Content>
            </tabView:SfTabItem>
            <tabView:SfTabItem Title="{x:Static custom2:AppResources.ExciseCertificates}" IsVisible="{Binding IsCertificateAvailableETTab}"
                                TitleFontSize="12"
                            SelectionColor="DarkGreen"
                             FontIconFontColor="#FF00AFF0"
                                  FontIconFontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                               TitleFontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                               TitleFontColor="Gray">
                <tabView:SfTabItem.Content>
                    <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="10,0,10,0">
                        <ListView IsVisible="{Binding IsCertificateAvailableET}"  ItemsSource ="{Binding CertificateListET}" VerticalOptions="Fill" x:Name="CertificateLstET" HasUnevenRows="true" SelectedItem="{Binding SelectedCertificate}" BackgroundColor="Transparent" SeparatorVisibility="None">
                            <x:Arguments>
                                <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                            </x:Arguments>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <cards:SfCardView HasShadow="True" Margin="10" Opacity=".9" BorderWidth=".05" BorderColor="#5d6770"  ShadowColor="#5d6770" BackgroundColor="White" CornerRadius="3"  IndicatorColor="DarkGreen" IndicatorPosition="Left" IndicatorThickness="5" >
                                            <StackLayout Orientation="Horizontal">
                                                <local:CustomLabel Text="{Binding Descript}" Style="{StaticResource MiniBlackLabelStyle}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Margin="10" HorizontalTextAlignment="Start" FontFamily="{StaticResource GAZT_FONT_MEDIUM}">
                                                </local:CustomLabel>
                                                <Image Source="ic_pdf.png" Aspect="AspectFit" HorizontalOptions="End" VerticalOptions="CenterAndExpand" Margin="10,0,10,0">
                                                </Image>
                                            </StackLayout>
                                        </cards:SfCardView>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                            <local:CustomLabel Margin="0,20,0,0" Text="{x:Static custom2:AppResources.Nocertificateavailable}" Style="{StaticResource MiniBlackLabelStyle}"  HorizontalOptions="Center" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" VerticalOptions="Center" IsVisible="{Binding SetNoDataLabelVisibilityET}">
                        </local:CustomLabel>
                    </StackLayout>
                </tabView:SfTabItem.Content>
            </tabView:SfTabItem>
        </tabView:SfTabView>
            </StackLayout>
        <!--<Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="12*" />
                <RowDefinition Height="88*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="33*" />
                <ColumnDefinition Width="34*" />
                <ColumnDefinition Width="33*" />
            </Grid.ColumnDefinitions>
            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" BackgroundColor="#005e4b">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="10" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="33*" />
                        <ColumnDefinition Width="34*" />
                        <ColumnDefinition Width="33*" />
                    </Grid.ColumnDefinitions>
                    <StackLayout Grid.Row="0" Grid.Column="0" HorizontalOptions="CenterAndExpand" VerticalOptions="Start" Spacing="0">
                       <local:CustomLabel Text="{x:Static custom2:AppResources.ZakatCertificates}" Style="{DynamicResource searchBarStyleForZakat}"  HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" VerticalOptions="FillAndExpand" VerticalTextAlignment="Start">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ClickGestureRecognizer_ClickedForZakat" Command="{Binding OnZakatCertificateClicked}" />
                            </Label.GestureRecognizers>
                        </local:CustomLabel>
                    </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="CenterAndExpand" VerticalOptions="Start" Spacing="0">
                        <local:CustomLabel  Text="{x:Static custom2:AppResources.VATCertificates}" Style="{DynamicResource searchBarStyleForVAT}"  HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" VerticalOptions="FillAndExpand" VerticalTextAlignment="Start">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ClickGestureRecognizer_ClickedForVAT" Command="{Binding OnVATCertificateClicked}" />
                            </Label.GestureRecognizers>
                        </local:CustomLabel>
                    </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="2" HorizontalOptions="CenterAndExpand" VerticalOptions="Start" Spacing="0">
                        <local:CustomLabel  Text="{x:Static custom2:AppResources.ExciseCertificates}" Style="{DynamicResource searchBarStyleForExcise}"  HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" VerticalOptions="FillAndExpand" VerticalTextAlignment="Start">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer  Tapped="ClickGestureRecognizer_ClickedForExcise" Command="{Binding OnExciseCertificateClicked}" />
                            </Label.GestureRecognizers>
                        </local:CustomLabel>
                    </StackLayout>
                </Grid>
            </StackLayout>
              -->
        <!--</Grid>-->
    </ContentPage.Content>
</ContentPage>