<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:local="clr-namespace:EGAZT;assembly:GAZT"
              xmlns:local1="clr-namespace:GAZT"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:cards1="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms" xmlns:custom1="clr-namespace:GAZT.CustomControl"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.AmendSalesDetails.AmendSalesDetailsPageView"
             Title="{x:Static local:AppResources.ZAmendSalesDetails}"
             NavigationPage.HasNavigationBar="False"
             FlowDirection="RightToLeft"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             BackgroundColor="White">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <controls:TitleView Title="{x:Static local:AppResources.ZAmendSalesDetails}"  FontSize="13"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.GoBackClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="{StaticResource Primary}"
                            Style="{StaticResource IconButtonStyle}"
                             Text="{DynamicResource StyleReverseBack}"
                             />
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="88*"/>
                    <RowDefinition Height="12*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <!--<Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White">-->
                    <ScrollView BackgroundColor="White" Orientation="Vertical" Grid.Row="0" Grid.Column="0"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                        <Grid BackgroundColor="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86*"/>
                                <ColumnDefinition Width="14*"/>
                            </Grid.ColumnDefinitions>
                            <StackLayout HorizontalOptions="FillAndExpand" HeightRequest="30" VerticalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0" >
                                                           <Label x:Name="SalesType"  Text="{Binding SalesType}" Grid.Row="0" Grid.Column="0" IsEnabled="False"  HorizontalOptions="StartAndExpand" VerticalOptions="FillAndExpand"  VerticalTextAlignment="Center" Style="{StaticResource GAZTGoldLabelStyleForSmallFont}"  FontFamily="{StaticResource GAZT_FONT_BOLD}" >
                            </Label>
                                </StackLayout>
                            <!--<Label Text="{x:Static local:AppResources.OldValue}" IsEnabled="False" Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" >
                            </Label>
                            <Frame Grid.Row="2" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                            </Frame>
                            <custom:GAZTBorderlessEntry  Grid.Row="2" Placeholder="{Binding OldValue}" IsEnabled="False"   Grid.Column="0"   Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <custom:AlphaNumericValidatorBehaviour/>
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>-->
                            <inputLayout:SfTextInputLayout  Margin="10,-6,10,-6" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
    Hint="{x:Static local:AppResources.OldValue}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020" HasError="False" >
                                <custom:GAZTBorderlessEntry  Grid.Row="2" IsReadOnly="True" Text="{Binding OldValue}"  TextColor="{StaticResource ForgotPasswordGrayTextColor}"  Style="{StaticResource GAZTTextBoxStyleForEntry}"  FontFamily="{StaticResource SomarSemiBold}">
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <custom:AlphaNumericValidatorBehaviour/>
                                    </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                            <!--<Label  Text="{x:Static local:AppResources.ZNewValue}"   Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" >
                            </Label>
                            <Frame Grid.Row="4" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                            </Frame>
                            <custom:GAZTBorderlessEntry x:Name="NewValue" Grid.Row="4" Text="{Binding NewValue}"  Unfocused="OnEntryUnFocussed" Focused="OnEntryFocussed"  Keyboard="Numeric"  Grid.Column="0"   Style="{StaticResource GAZTTextBoxStyleForEntry}">
                            </custom:GAZTBorderlessEntry>-->
                            <!--<Image Grid.Row="1"  Grid.Column="1"  Margin="0,0,0,0" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_TIN_Status.png"  >
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPasswordVisibilityClickedForOldPassword" />
                        </Image.GestureRecognizers>
                    </Image>-->
                            <inputLayout:SfTextInputLayout  Margin="10,-6,10,-6" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
    Hint="{x:Static local:AppResources.ZNewValue}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020" HasError="False" >
                                <custom:GAZTBorderlessEntry x:Name="NewValue"  Text="{Binding NewValue}"  Unfocused="OnEntryUnFocussed" Focused="OnEntryFocussed"  Keyboard="Numeric" TextChanged="OnNewValueTextChanged"    Style="{StaticResource GAZTTextBoxStyleForEntry}"  FontFamily="{StaticResource SomarSemiBold}">
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                            <!--<Label Text="{x:Static local:AppResources.ZChangeReason}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" >
                            </Label>
                            <Frame Grid.Row="6" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                            </Frame>
                            <custom:GAZTBorderlessEntry Text="{Binding ChangeReason}" Grid.Row="6"   Grid.Column="0"  Style="{StaticResource GAZTTextBoxStyleForEntry}">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <custom:AlphaNumericValidatorBehaviour/>
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>-->
                            <!--<Image Grid.Row="3"  Grid.Column="1"  Margin="0,0,0,0" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_TIN_Status.png"  >
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPasswordVisibilityClickedForNewPassword" />
                        </Image.GestureRecognizers>
                    </Image>-->
                            <inputLayout:SfTextInputLayout  Margin="10,-6,10,-6" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
    Hint="{x:Static local:AppResources.ZChangeReason}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020" HasError="False" >
                                <custom:GAZTBorderlessEntry Text="{Binding ChangeReason}" Style="{StaticResource GAZTTextBoxStyleForEntry}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}">
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <custom1:AlphabetandArabicCharacters/>
                                    </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                            <Label Text="{x:Static local:AppResources.Attachments}"  Style="{StaticResource GAZTSmallGreenLabelStyle}" FontFamily="{StaticResource GAZT_FONT_REGULAR}" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" >
                            </Label>
                            <!--<Frame Grid.Row="12" Style="{StaticResource GAZTFrameStyleForEntry}" CornerRadius="8" Margin="20,0,20,0"  Grid.Column="0" Grid.ColumnSpan="2">
                            </Frame>
                            <custom:GAZTBorderlessEntry Text="{Binding AttachmentName}" Grid.Row="12" IsEnabled="False" Grid.Column="0"    Style="{StaticResource GAZTTextBoxStyleForEntry}">
                            </custom:GAZTBorderlessEntry>
                            <Image Grid.Row="12"  Grid.Column="1"  Margin="0,0,0,0" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_attachment.png">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OnAttachmentClick}" />
                                </Image.GestureRecognizers>
                            </Image>-->
                             <inputLayout:SfTextInputLayout    Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"    Margin="10,0,10,-6"
        Hint="{x:Static local:AppResources.ZZAttachment}"
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#{StaticResource Primary}" ErrorColor="#B00020" HasError="False" >
                            <custom:GAZTBorderlessEntry Text="{Binding AttachmentName}" TextColor="{StaticResource PrimaryColor}" Grid.Row="12" IsReadOnly="True" Grid.Column="0"    Style="{StaticResource GAZTTextBoxStyleForEntry}"   FontFamily="{StaticResource GAZT_FONT_MEDIUM}">
                            </custom:GAZTBorderlessEntry>
                    </inputLayout:SfTextInputLayout>
                             <Image Grid.Row="12"  Grid.Column="1"   Margin="13,2,13,1" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_attachment.png">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OnAttachmentClick}" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Label Text="{x:Static local:AppResources.ZNote}" Grid.Row="8"   HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Grid.Column="0"  Style="{StaticResource GAZTGoldLabelStyleForSmallFont}"   FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                            <Label Text="{x:Static local:AppResources.ZFilesizeshouldnotbemorethan5MB}"  Grid.Row="9" Grid.Column="0"  Grid.ColumnSpan="2"  HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"   FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                            <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="10" Grid.Column="0"  Grid.ColumnSpan="2">
                                <custom:CustomLabel Text="{x:Static local:AppResources.ZZChooseonlyfilewithextensionForZAKAT}" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"   FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                            </StackLayout>
                            <Label Text="{x:Static local:AppResources.ZMaximumnoof5attachmentscanbeuploaded}"  Grid.Row="11" Grid.Column="0"  Grid.ColumnSpan="2"  HorizontalOptions="StartAndExpand" VerticalOptions="Start"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"   FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                            <!--<Label Grid.Row="7"  Grid.Column="0" Grid.ColumnSpan="2"   HorizontalOptions="Start" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" >
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static local:AppResources.ZNote}"  Style="{StaticResource GAZTGoldLabelStyleForSmallFont}"/>
                                        <Span Text="{x:Static x:Environment.NewLine}" />
                                        <Span  Text="{x:Static local:AppResources.ZFilesizeshouldnotbemorethan5MB}" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" />
                                        <Span Text="{x:Static x:Environment.NewLine}" />
                                        <Span  Text="{x:Static local:AppResources.ZChooseonlyfilewithextension}" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" />
                                        <Span Text="{x:Static x:Environment.NewLine}" />
                                        <Span  Text="{x:Static local:AppResources.ZMaximumnoof5attachmentscanbeuploaded}" Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>-->
                            <!--<StackLayout HorizontalOptions="FillAndExpand" IsVisible="True" VerticalOptions="FillAndExpand" Grid.Row="8"  Margin="0,0,0,0" Grid.Column="0" Grid.ColumnSpan="2" >
                                <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  >
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86*"/>
                                            <ColumnDefinition Width="14*"/>
                                        </Grid.ColumnDefinitions>-->
                            <StackLayout Grid.Row="13"  Grid.Column="0" Grid.ColumnSpan="2"  Margin="0,0,0,0"  HorizontalOptions="FillAndExpand" VerticalOptions="Fill"  >
                                <ListView  x:Name="Attachmentlist" 
           ItemsSource="{Binding ZakatReturnAttachmentsList}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                                          
                      ItemTapped="Attachmentlist_ItemTapped"
                BackgroundColor="White"
            SeparatorVisibility="None"
            >
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <ContentView>
                                                    <cards1:SfCardView HasShadow="False" Margin="10,10,10,0" Opacity=".9" BorderWidth=".05" BorderColor="{StaticResource EntryTextColor}"  ShadowColor="{StaticResource EntryTextColor}" BackgroundColor="White" CornerRadius="8"  IndicatorColor="{StaticResource Primary}" IndicatorPosition="Left" IndicatorThickness="5" >
                                                        <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"  Padding="10" >
                                                            <Grid Style="{DynamicResource GridStyle}" ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" BackgroundColor="White" Margin="0">
                                                                <!--<Grid.RowDefinitions>
                                                                        <RowDefinition Height="auto"/>
                                                                        <RowDefinition Height="auto"/>
                                                                    </Grid.RowDefinitions>-->
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="52*" />
                                                                    <ColumnDefinition Width="10*" />
                                                                    <ColumnDefinition Width="15*" />
                                                                    <ColumnDefinition Width="15*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="30" />
                                                                    <RowDefinition Height="30" />
                                                                </Grid.RowDefinitions>
                                                                <!--<Label Text="{Binding aa}" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0" 
                                   />-->
                                                                <Label Text="{Binding Filename}" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
  FontFamily="{StaticResource SomarSemiBold}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                                                           LineBreakMode="WordWrap"
                                                                       TextColor="{StaticResource PrimaryColor}"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                                          Grid.ColumnSpan="2"
                                   />
                                                                <Label Text="{Binding UploadededDateToShow}" 
                                                                       Margin="0,0,0,0"
                                                                       TextColor="{StaticResource PrimaryColor}"
                                                                       Style="{StaticResource MiniGrayLabelStyle}"
                                                                         FontFamily="{StaticResource SomarSemiBold}"
                                                                        HorizontalOptions="StartAndExpand"
                                                                         VerticalOptions="CenterAndExpand"
                                                                         LineBreakMode="CharacterWrap"
                                                                           Grid.Row="1"
                                                                           Grid.Column="0"
                                                                           Grid.ColumnSpan="2"
                                   />
                                                                  <Image Grid.Row="0"  Grid.Column="2" Grid.RowSpan="2"  HorizontalOptions="Center" VerticalOptions="CenterAndExpand" Source="ic_file_download.png"  >
                                                                <Image.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnDownloadAttachmentClicked" />
                                                                </Image.GestureRecognizers>
                                                            </Image>
                                                                <Image Grid.Row="0"  Grid.Column="3"  Aspect="AspectFit" Grid.RowSpan="2"  HorizontalOptions="Center" VerticalOptions="Center" Source="ic_delete.png"  >
                                                                    <Image.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                                Tapped="OnDeleteAttachmentClickedTapped"
                                                                                NumberOfTapsRequired="1" />
                                                                    </Image.GestureRecognizers>
                                                                </Image>
                                                            </Grid>
                                                        </StackLayout>
                                                    </cards1:SfCardView>
                                                </ContentView>
                                            </ViewCell>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackLayout>
                        </Grid>
                    </ScrollView>
                <!--</Grid>-->
                <buttons:SfButton Text="{x:Static local:AppResources.Save}" FontFamily="{StaticResource SomarBold}" TextColor="White"  Command="{Binding OnZakatReturnDataUpdateClicked}" Grid.Row="1" Grid.Column="0" CornerRadius="0" Margin="0" Padding="0" VerticalOptions="EndAndExpand" HeightRequest="56"  IsEnabled = "{Binding IsSaveButtonEnable}" BackgroundColor="{Binding ButtonBackgroundColor}" >
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="gray" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="White" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </buttons:SfButton>
            </Grid>
            <!-- Acticity indicator layout start -->
            <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
<busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                       
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="{StaticResource Primary}"/>
                        <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                    </StackLayout>
                </StackLayout>
            </Grid>
            <!-- Acticity indicator layout end -->
        </Grid>
    </ContentPage.Content>
</ContentPage>