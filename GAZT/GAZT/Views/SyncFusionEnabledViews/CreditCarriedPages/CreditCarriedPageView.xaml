<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local1="clr-namespace:GAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:local="clr-namespace:EGAZT;assembly:GAZT"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:cards1="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             mc:Ignorable="d"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.CreditCarried.CreditCarriedPageView"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">
    <ContentPage.Resources>
        <ResourceDictionary>
            <custom1:DataMarkerConverter x:Key="converter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <controls:TitleView Title=""  FontSize="13"   BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.GoBackClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="{StaticResource Primary}"
                            Style="{StaticResource IconButtonStyle}"
                             Text="{DynamicResource StyleReverseBack}"
                             />
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
        <Frame Style="{StaticResource GAZTFrameStyleEntryForLableBackground}" HorizontalOptions="FillAndExpand" VerticalOptions="StartAndExpand"  >
                <local1:CustomLabel Text="{x:Static local:AppResources.ZVatcreditcarriedforward}" HorizontalTextAlignment="Start" FontSize="Caption"  VerticalOptions="Center" HorizontalOptions="StartAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}" >
                </local1:CustomLabel>
            </Frame>
        <StackLayout Margin="10,10,10,0"    HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <ListView  x:Name="NewCreditCarriedList" 
           ItemsSource="{Binding CreditCarriedsList}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                        BackgroundColor="White"
                      IsVisible="{Binding IsListViewVisible}" 
            SeparatorVisibility="None"
            >
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <ContentView>
                                    <cards1:SfCardView HasShadow="False" Margin="10" Opacity=".9" BorderWidth=".05" BorderColor="{StaticResource EntryTextColor}"  ShadowColor="{StaticResource EntryTextColor}" BackgroundColor="White" CornerRadius="3" >
                                        <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Margin="10,10,0,5" Padding="10" >
                                            <Grid Style="{DynamicResource GridStyle}" ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White" >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <!--<Label Text="{x:Static local:AppResources.ZVatSerialNumber}" Margin="8,0,8,0" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="1"/>
                                                <Label Text="{Binding LineNo}" 
                                 Margin="-7,0,-7,0" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="2" 
                                   Grid.ColumnSpan="4"/>-->
                                                <Label  Margin="0" 
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                           >
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.ZVatSerialNumber}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}" FontSize="11"></Span>
                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "  FontFamily="{StaticResource GAZT_FONT_MEDIUM}" FontSize="11"></Span>
                                                            <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding LineNo}"  FontFamily="{StaticResource SomarSemiBold}" FontSize="11"  
></Span>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <!--<Label Text="{x:Static local:AppResources.ZVatReturnReferenceNumber}" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                                           Margin="8,0,8,0"
                                   Grid.Row="1"
                                   Grid.Column="1"/>
                                                <Label Text="{Binding Fbnum}" 
                                  Margin="-7,0,-7,0" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="2"
                                   Grid.ColumnSpan="4"/>-->
                                                <Label  Margin="0" 
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                                           >
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.ZVatReturnReferenceNumber}" FontSize="11"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></Span>
                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : " FontSize="11"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></Span>
                                                            <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding Fbnum}" FontSize="11"  FontFamily="{StaticResource SomarSemiBold}"
></Span>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <!--<Label Text="{x:Static local:AppResources.ZVatDocumentNumber}" Margin="8,0,8,0" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                   Grid.Column="1"/>
                                                <Label Text="{Binding DocNo}" 
                                  Margin="-7,0,-7,0" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                   Grid.Column="2"
                                   Grid.ColumnSpan="4"/>-->
                                                <Label  Margin="0" 
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                                           >
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.ZVatDocumentNumber}" FontSize="11"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></Span>
                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : " FontSize="11"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></Span>
                                                            <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding DocNo}" FontSize="11"  FontFamily="{StaticResource SomarSemiBold}"
></Span>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <!--<Label Text="{x:Static local:AppResources.ZAmount}" Margin="8,0,8,0" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="1"/>
                                                <Label Text="{Binding CreditAmt}" 
                                  Margin="-7,0,-7,0"
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="2" 
                                   Grid.ColumnSpan="4"/>-->
                                                <Label  Margin="0" 
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                                           >
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.ZAmount}" FontSize="11"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></Span>
                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : " FontSize="11"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></Span >
                                                            <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding CreditAmt}" FontSize="11"  FontFamily="{StaticResource SomarSemiBold}"
></Span>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <!--<StackLayout Grid.Row="1"  BackgroundColor="AliceBlue" Grid.Column="3" Grid.ColumnSpan="2" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.RowSpan="4" ></StackLayout>-->
                                            </Grid>
                                        </StackLayout>
                                    </cards1:SfCardView>
                                </ContentView>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
                <local1:CustomLabel Text="{x:Static local:AppResources.Nodataavailable}" IsVisible="{Binding IsNoDataLabelVisible}" Style="{StaticResource GAZTGrayLabelStyleForSmallFont}"  HorizontalOptions="Center" VerticalOptions="Center" >
                </local1:CustomLabel>
            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>