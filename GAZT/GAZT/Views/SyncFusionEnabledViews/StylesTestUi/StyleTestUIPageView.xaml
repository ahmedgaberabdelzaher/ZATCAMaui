<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:custom2="clr-namespace:EGAZT"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             mc:Ignorable="d"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.StylesTestUi.StyleTestUIPageView"
             FlowDirection="LeftToRight"
             	>
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <ScrollView>
        <StackLayout Margin="10">
            <buttons:SfButton x:Name="btnprimary" Text="Primary" Style="{StaticResource PrimaryButtonStyle}"/>
            <buttons:SfButton x:Name="btnSecondary" Text="Primary"  Style="{StaticResource SecondaryButtonStyle}"/>
                <Label Text="Page Title"   Style="{StaticResource PageTitleBlack}" />
                <Label Text="Page Title" Style="{StaticResource PageTitleGrey}" />

                <Label Text="Section Title" Style="{StaticResource SectionTitleBlack}" />
                <Label Text="Section Title" Style="{StaticResource SectionTitleGrey}" />

                <Label Text="Value Title" Style="{StaticResource ValueLabelBlack}" />
                <Label Text="Value Title" Style="{StaticResource ValueLabelGrey}" />

                <Label Text="Body Title" Style="{StaticResource BodyLabelBlack}" />
                <Label Text="Body Title" Style="{StaticResource BodyLabelGrey}" />

                <Label Text="Caption Title" Style="{StaticResource CaptionLabelBlack}" />
                <Label Text="Caption Title" Style="{StaticResource CaptionLabelGrey}" />
            <!--Income card--> 
                <Frame BorderColor="LightGray" Margin="0,10,0,10"  CornerRadius="15"  Padding="0"  HasShadow="False">
                    <Grid Padding="15">
                        <Grid.RowDefinitions >
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="0" Spacing="-3">
                            <Label Text="Individual Zakat" Style="{StaticResource ValueLabelBlack}" />
                            <Label Text=" Zakat" Style="{StaticResource CaptionLabelGrey}" />
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1"  VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                            <yummy:PancakeView    Padding="15,10,10,10"  
                               CornerRadius="20"  BorderThickness="1" BackgroundColor="AliceBlue" VerticalOptions="CenterAndExpand" HorizontalOptions="End" >
                                <Label Text="Submitted"  Style="{StaticResource CaptionLabelGrey}" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="CenterAndExpand"/>
                            </yummy:PancakeView>
                        </StackLayout>
                    </Grid>
                </Frame>
                <!--Income card-->

              
                <!--ListIconLeftCard-->

                <Frame BorderColor="LightGray" Padding="0" CornerRadius="8"  Margin="0,10,0,10"  HasShadow="False">
                    <StackLayout Orientation="Horizontal" Padding="15,10,15,10">
                        <Image>
                            <Image.Source>
                                <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.ContentCopy}"/>
                            </Image.Source>
                        </Image>
                        <Label Text="TIN Number" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>
                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                            <Label Text="3101503102" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>

                        </StackLayout>
                    </StackLayout>
                </Frame>
                <!--ListIconLeftCard-->
                <!--ListIconRightCard-->
                <Frame BorderColor="LightGray" Padding="0" CornerRadius="8"  Margin="0,10,0,10" HasShadow="False">
                    <StackLayout Orientation="Horizontal"  Padding="15,10,15,10">
                      
                        <Label Text="TIN Number" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>
                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                            <Label Text="3101503102" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>
                            <Image>
                                <Image.Source>
                                    <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.ContentCopy}"/>
                                </Image.Source>
                            </Image>

                        </StackLayout>
                    </StackLayout>
                </Frame>
                <!--ListIconRightCard-->
            <!--Distributive-->
                <Frame BorderColor="LightGray" Padding="0" Margin="0,10,0,10" CornerRadius="8"  HasShadow="False">
                    <StackLayout Orientation="Horizontal"  Padding="15,10,15,10">
                        <Image>
                            <Image.Source>
                                <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.ContentCopy}"/>
                            </Image.Source>
                        </Image>
                        <Label Text="TIN Number" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>
                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                            <Image>
                                <Image.Source>
                                    <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.ContentCopy}"/>
                                </Image.Source>
                            </Image>

                        </StackLayout>
                    </StackLayout>
                </Frame>
                <!--Distributive-->
                <!--Summery-->
                <Frame BorderColor="AliceBlue" BackgroundColor="AliceBlue" Padding="0" Margin="0,10,0,10" CornerRadius="8"   HasShadow="False">
                    <StackLayout Orientation="Horizontal"  Padding="15,10,15,10">
                        <Image>
                            <Image.Source>
                                <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.ContentCopy}"/>
                            </Image.Source>
                        </Image>
                        <Label Text="TIN Number" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>
                    </StackLayout>
                </Frame>
                <!--Summery-->
                <Frame BorderColor="LightGray" BackgroundColor="White" Padding="0" Margin="0,10,0,10" CornerRadius="8"   HasShadow="False">
                    <StackLayout Orientation="Horizontal"  Padding="15,10,15,10">
                        <Image>
                            <Image.Source>
                                <FontImageSource FontFamily="UserIconFont" Color="{StaticResource Primary}" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.PlusCircleOutline}"/>
                            </Image.Source>
                        </Image>
                        <Label Text="TIN Number" Style="{StaticResource ValueLabelPrimary}" HorizontalOptions="Start"/>
                    </StackLayout>
                </Frame>
                <!--Total Small-->
                <Frame BorderColor="AliceBlue" BackgroundColor="AliceBlue" Padding="0" Margin="0,10,0,10" CornerRadius="8"   HasShadow="False">
                    <StackLayout Orientation="Horizontal"  Padding="15,10,15,10">
                        <Label Text="Total" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" HorizontalOptions="Start"/>
                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                            <Label Text="Amount" Style="{StaticResource SectionTitleBlack}" HorizontalOptions="Start"/>
                            <Image>
                                <Image.Source>
                                    <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.ContentCopy}"/>
                                </Image.Source>
                            </Image>
                        </StackLayout>
                    </StackLayout>
                </Frame>
                <!--Total Small-->
            
            <!--Inbox Unread-->
                <Frame BorderColor="LightGray"  CornerRadius="15" Margin="0,10,0,10"  Padding="0"  HasShadow="False">
                    <Grid Padding="15">
                        <Grid.RowDefinitions >
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="0" Spacing="-3">
                            <Label Text="Message Title" Style="{StaticResource ValueLabelBlack}" FontFamily="{StaticResource SSTArBold}" />
                            <Label Text=" Date" Style="{StaticResource CaptionLabelGrey}" />
                        </StackLayout>
                        
                            <Label x:Name="Image_backArrow" Grid.Row="0" Margin="10,0,10,0" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center"   Style="{StaticResource IconLabelStyle}" Text="{StaticResource Back}" Rotation="180">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer  Command="{Binding OnBackButtonClick}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        
                    </Grid>
                </Frame>
                <!--Inbox Unread-->
                <!--inbod read-->
                <Frame BorderColor="LightGray"  CornerRadius="15" Margin="0,10,0,10"  Padding="0"  HasShadow="False">
                    <Grid Padding="15">
                        <Grid.RowDefinitions >
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="0" Spacing="-3">
                            <Label Text="Message Title" Style="{StaticResource ValueLabelBlack}"   />
                            <Label Text=" Date" Style="{StaticResource CaptionLabelGrey}" />
                        </StackLayout>
                        <Label  Grid.Row="0" Margin="10,0,10,0" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center"   Style="{StaticResource IconLabelStyle}" Text="{StaticResource Back}" Rotation="180">
                        </Label>

                    </Grid>
                </Frame>
                <!--inbod read-->





                <!-- My Bills template UI Starts -->
                <Frame BorderColor="LightGray"  CornerRadius="15" Margin="0,10,0,10"  Padding="0"  HasShadow="False">
                    <StackLayout Padding="0">
                        <Grid  Padding="15" RowSpacing="0" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-10">
                                <Label  Text="ZAKAT" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                                <Label  Text="Amendment by Gazt" Style="{StaticResource GAZTSmallGrayLblMediumFont}" VerticalOptions="CenterAndExpand"  FontSize="Small" />
                            </StackLayout>
                            <StackLayout Grid.Row="0" Grid.Column="1"  VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                                <yummy:PancakeView    Padding="10,10,10,10"  
                               CornerRadius="20"  BorderThickness="1" BackgroundColor="AliceBlue" VerticalOptions="CenterAndExpand" HorizontalOptions="End" >
                                    <Label Text="Submitted" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                                </yummy:PancakeView>
                            </StackLayout>
                        </Grid>
                        <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />
                        <Grid Padding="10,10,10,10" RowSpacing="15" >
                            <Grid.RowDefinitions >
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Text="1200.00 SAR" VerticalOptions="CenterAndExpand" TextColor="Black" FontSize="Medium" FontAttributes="Bold"/>
                            <StackLayout Grid.Row="1" Grid.Column="0" Spacing="-5">
                                <Label Text="SADAD Number" Style="{StaticResource CaptionLabelGrey}"/>
                                <Label Text="SADAD Number" Style="{StaticResource ValueLabelBlack}" />
                            </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="1" Spacing="-5">
                                <Label Text="SADAD Number" Style="{StaticResource CaptionLabelGrey}"/>
                                <Label Text="SADAD Number" Style="{StaticResource ValueLabelBlack}" />
                            </StackLayout>
                        </Grid>

                    </StackLayout>
                </Frame>
                <!-- My Bills template UI Ends -->
            <!--Total Big-->
                <Frame BorderColor="LightGray"  CornerRadius="15" Margin="0" Padding="0"  HasShadow="False">
                    <StackLayout Padding="0">
                        
                        <Grid   Margin="0"  RowSpacing="0"  >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackLayout Padding="15" Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="2" >
                                <Label  Text="Total Sales" VerticalOptions="Center" Style="{StaticResource SectionTitleBlackBold}"/>
                            </StackLayout>
                       
                         
                        </Grid>
                        <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />
                        <Grid Padding="10,10,10,10" RowSpacing="15"  >
                            <Grid.RowDefinitions >
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Text="1200.00 SAR" VerticalOptions="CenterAndExpand" TextColor="Black" FontSize="Medium" FontAttributes="Bold"/>
                            <StackLayout Grid.Row="1" Grid.Column="0" Spacing="-5">
                                <Label Text="Test" Style="{StaticResource CaptionLabelGrey}"/>
                                <Label Text="Test" Style="{StaticResource ValueLabelBlack}" />
                            </StackLayout>
                            <StackLayout Grid.Row="1" Grid.Column="1" Spacing="-5">
                                <Label Text="Test" Style="{StaticResource CaptionLabelGrey}"/>
                                <Label Text="Test" Style="{StaticResource ValueLabelBlack}" />
                            </StackLayout>
                        </Grid>

                    </StackLayout>
                </Frame>
                <!--Total big-->
            </StackLayout>
            </ScrollView>
    </ContentPage.Content>
</ContentPage>