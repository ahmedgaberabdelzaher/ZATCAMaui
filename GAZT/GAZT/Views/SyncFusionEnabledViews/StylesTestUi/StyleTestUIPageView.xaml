                                     HorizontalOptions="FillAndExpand" WidthRequest="30" HeightRequest="30"
                                        ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
                                        OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020">
                        <control:BorderlessEntry   Text="{Binding OTP}"  IsPassword="True" HorizontalTextAlignment="Center"   FontSize="Small" TextColor="Black" Placeholder="****"  PlaceholderColor="Gray" Keyboard="Numeric" MaxLength="4">
                           
                        </control:BorderlessEntry>
                    </inputLayout:SfTextInputLayout>
                </StackLayout>
                


                <!-- My Bills template UI Starts -->
                <Frame Grid.Row="0" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BorderColor="LightGray" CornerRadius="8" Margin="0,5,0,0" HasShadow="False" Padding="10">
