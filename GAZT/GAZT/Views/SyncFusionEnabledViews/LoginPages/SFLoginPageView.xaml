<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.SyncFusionEnabledViews.SFLogin.SFLoginPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:converter="clr-namespace:GAZTeServicesApp.Converters"
    xmlns:custom2="clr-namespace:EGAZT"
    Title="Login"
    BackgroundColor="White"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:BooleanToColorConverter x:Key="ColorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid x:Name="loginGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>
                <StackLayout IsVisible="false" Orientation="Horizontal">

                    <!--  Left/Right icon  -->
                    <Image
                        x:Name="backbutton"
                        Margin="20,60,20,0"
                        HorizontalOptions="Start"
                        Rotation="180"
                        Source="arrowLeftwhite.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="StartAndExpand">
                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="0" />
                            </DataTrigger>
                        </Image.Triggers>
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackCommand}" />
                        </Image.GestureRecognizers>
                    </Image>

                    <Image
                        x:Name="HamburgerMenu"
                        Margin="10,55,10,0"
                        HorizontalOptions="EndAndExpand"
                        Source="Burger"
                        Style="{StaticResource SmallIcon}"
                        VerticalOptions="Start">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding HamburgerMenuClickedCommand}" NumberOfTapsRequired="1" />
                        </Image.GestureRecognizers>
                    </Image>
                </StackLayout>

                <Grid
                    Grid.Row="0"
                    Grid.Column="0"
                    IsVisible="false">
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        BackgroundColor="Black"
                        Opacity="0.4"
                        Orientation="Vertical"
                        VerticalOptions="FillAndExpand" />
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="15,15"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        Opacity="0.8"
                        Orientation="Vertical"
                        VerticalOptions="Center" />
                </Grid>

                <Grid
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,-20,0,-20"
                    IsVisible="{Binding IsLoading}">
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        BackgroundColor="Black"
                        Opacity="0.4"
                        Orientation="Vertical"
                        VerticalOptions="FillAndExpand" />
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="15,15"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        Opacity="0.8"
                        Orientation="Vertical"
                        VerticalOptions="Center">
                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                            <busyindicator:SfBusyIndicator
                                x:Name="busyindicatorForLanding"
                                AnimationType="SingleCircle"
                                EnableAnimation="True"
                                HorizontalOptions="CenterAndExpand"
                                IsBusy="True"
                                TextColor="{StaticResource Secondary}"
                                TitlePlacement="Bottom"
                                VerticalOptions="CenterAndExpand"
                                ViewBoxHeight="70"
                                ViewBoxWidth="70" />
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </Grid>
            <StackLayout
                x:Name="sessionExpiredView"
                Margin="0"
                BackgroundColor="Transparent"
                IsVisible="false">
                <StackLayout
                    Padding="40"
                    BackgroundColor="Transparent"
                    VerticalOptions="CenterAndExpand">
                    <Image Aspect="AspectFit" Source="errorNew.png" />
                    <Label
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="Large"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static custom2:AppResources.Information}"
                        TextColor="White" />
                    <Label
                        FontFamily="{StaticResource SomarSemiBold}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static custom2:AppResources.ZYourSessionhasexpiredPleaseLoginagain}"
                        TextColor="White" />
                </StackLayout>

                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="30,60,30,80"
                    HorizontalOptions="Center"
                    VerticalOptions="End">
                    <buttons:SfButton
                        x:Name="btnLogin"
                        Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,8,0,16"
                        Clicked="btnLoginClicked"
                        HeightRequest="46"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.LoginTitle}" />
                </StackLayout>
            </StackLayout>
            <controls:BottomMenu
                Grid.Row="0"
                Margin="20"
                VerticalOptions="EndAndExpand" />
        </Grid>
    </ContentPage.Content>
</ContentPage>