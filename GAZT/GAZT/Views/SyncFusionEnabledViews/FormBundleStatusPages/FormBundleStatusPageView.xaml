<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
               xmlns:custom="clr-namespace:GAZT"
               xmlns:local1="clr-namespace:GAZT"
               xmlns:local="clr-namespace:GAZT"
              xmlns:custom2="clr-namespace:EGAZT"
               xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             Title="{x:Static custom2:AppResources.ZZFormBundleStatus}"
                          xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             NavigationPage.HasNavigationBar="False"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.FormBundleStatus.FormBundleStatusPageView"
             BackgroundColor="#005e4b">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary Source="..\Common\Styles.xaml" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <!--<StackLayout Spacing="0">
                <controls:TitleView Title="{x:Static custom2:AppResources.ZZFormBundleStatus}"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.BackButtonClicked}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="#006450"
                            Style="{StaticResource IconButtonStyle}"
                           Text="{DynamicResource StyleReverseBack}"
                             />
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>-->

            <Grid>
                <StackLayout>
                    <Grid Padding="0,5,0,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static custom2:AppResources.ZZFormBundleStatus}" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" FontSize="Large" />
                        <Label Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}"  Style="{StaticResource IconLabelStyle}" Text="{DynamicResource StyleReverseBack}" TextColor="White" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer      Command="{TemplateBinding BindingContext.BackButtonClicked}" ></TapGestureRecognizer>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    
                    <yummy:PancakeView  BackgroundColor="Black" CornerRadius="32,32,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,15,0,0" BackgroundColor="White" x:Name="VATRMainGrid">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="10*" />
                                <RowDefinition Height="90*" />

                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="1" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>
             
            </Grid>

        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid x:Name="ParentContainerForOTP" >
            <Grid.RowDefinitions>
                <RowDefinition Height="100*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackLayout Grid.Row="0" Grid.Column="0">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White"  RowSpacing="0">
                    <!--Padding="10,20,10,0"-->
                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"    Margin="0"  Padding="0,5,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <!--SelectedIndex="{Binding IDTypeIndex}" Margin="10,-6,10,-6" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"  Padding="10,20,10,0"-->
                        <inputLayout:SfTextInputLayout  Margin="10,0,10,-6"  
    Hint="{x:Static custom2:AppResources.ZZPleaseselectFormBundleType}"  Grid.Row="0" Grid.Column="0"
    ContainerType="Outlined" x:Name="FrmIDType"  UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <custom:BorderlessEntry IsSpellCheckEnabled="False" Text="{Binding TxtFBtype}" FontSize="Small" FontAttributes="Bold" Style="{StaticResource GAZTTextBoxStyleForEntry}" FontFamily="{StaticResource SSTArabicMedium}">
                            </custom:BorderlessEntry>
                            <inputLayout:SfTextInputLayout.HintLabelStyle>
                                <inputLayout:LabelStyle >
                                    <inputLayout:LabelStyle.FontFamily>
                                        <OnPlatform x:TypeArguments="x:String" iOS="{StaticResource SSTArabicMedium}" Android="{StaticResource SSTArabicMedium}" WinPhone="{StaticResource SSTArabicMedium}" />
                                    </inputLayout:LabelStyle.FontFamily>
                                </inputLayout:LabelStyle>
                            </inputLayout:SfTextInputLayout.HintLabelStyle>
                        </inputLayout:SfTextInputLayout>
                        <custom:CustomButton x:Name="btn" Clicked="TapGestureRecognizer_Tapped" FontSize="Small" BackgroundColor="Transparent" Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" >
                        </custom:CustomButton>

                        <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="DDlIDType"
                    HeaderHeight="55"
                    ShowHeader="true"
                    HeaderText="{x:Static custom2:AppResources.ZZPleaseselectFormBundleType}"
HeaderTextColor="White"
                                             ShowColumnHeader="False"
                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"
                                            HeaderBackgroundColor="#006450"
                    SelectedItemTextColor="#006450"
                    BorderColor="Black"
                     BackgroundColor="#EAF7CC"
                    UnSelectedItemTextColor="#006450"
                                SelectedItemFontSize="15"
                                           
                   ItemHeight="40"
                     DisplayMemberPath="Txt50" ItemsSource="{Binding FormBundleList}"   OkButtonClicked="DDlIDType_OkButtonClicked"  CancelButtonClicked="DDlIDType_CancelButtonClicked" Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" SelectionChanged="DDlIDType_SelectionChanged" 
                   PickerHeight="250"
                    PickerWidth="300"
                                             HeaderFontSize="14"
                    OKButtonTextColor="#006450"
                    CancelButtonTextColor="#006450"
                        ShowFooter="True"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                             FooterHeight="46">
                            <syncfusion:SfPicker.Behaviors>
                                <custom1:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>
                        </syncfusion:SfPicker>
                        <!--SelectedItem="{Binding SelectedFormBindleFbtyp,Mode=TwoWay }"-->
                        <!--SelectedItem="{Binding SelectedSignUpUsing,Mode=TwoWay}"-->
                        <!--pickere 1 new-->
                        <!--<Frame Grid.Row="0"  Margin="10,13,10,0" Padding="13" VerticalOptions="FillAndExpand" Grid.Column="0" Grid.ColumnSpan="7"  Style="{StaticResource GAZTFrameStyleForEntry}"    >
                    </Frame>
                    <custom:GAZTBorderlessPicker x:Name="BPicker" Margin="10,13,10,0" Title="{x:Static custom2:AppResources.ZZPleaseselectFormBundleType}" VerticalOptions="CenterAndExpand" Style="{StaticResource GAZTDropdownStyle}"  IsEnabled="true"   ItemsSource="{Binding FormBundleList}" ItemDisplayBinding="{Binding Txt50}"   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="5" SelectedItem="{Binding SelectedFormBindleFbtyp }" ></custom:GAZTBorderlessPicker>
                    <Image Grid.Row="0"  Grid.Column="6"  x:Name="BPicker_imgtap" Margin="0,13,0,0"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Source="ic_dropdownOne.png" >
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                        </Image.GestureRecognizers>
                    </Image>-->
                        <!--HDHBHFBDBV-->
                        <inputLayout:SfTextInputLayout  Margin="10,-6,10,-6"  
    Hint="{x:Static custom2:AppResources.ZZPleaseselectFormBundleNumber}"  Grid.Row="1" Grid.Column="0" 
    ContainerType="Outlined" x:Name="FrmIDType1"  UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <custom:BorderlessEntry IsSpellCheckEnabled="False" Text="{Binding TxtFBnum}" FontSize="Small" Style="{StaticResource GAZTTextBoxStyleForEntry}" FontFamily="{StaticResource SSTArabicMedium}">
                            </custom:BorderlessEntry>
                            <inputLayout:SfTextInputLayout.HintLabelStyle>
                                <inputLayout:LabelStyle >
                                    <inputLayout:LabelStyle.FontFamily>
                                        <OnPlatform x:TypeArguments="x:String" iOS="{StaticResource SSTArabicMedium}" Android="{StaticResource SSTArabicMedium}" WinPhone="{StaticResource SSTArabicMedium}" />
                                    </inputLayout:LabelStyle.FontFamily>
                                </inputLayout:LabelStyle>
                            </inputLayout:SfTextInputLayout.HintLabelStyle>
                        </inputLayout:SfTextInputLayout>
                        <custom:CustomButton x:Name="btn1" Clicked="TapGestureRecognizer_Tapped_1" FontSize="Small" BackgroundColor="Transparent" Grid.Row="1" Grid.Column="0" Margin="10,0,10,0" >
                        </custom:CustomButton>
                        <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="CPicker"
                    HeaderHeight="55"
                    ShowHeader="true"
                    HeaderText="{x:Static custom2:AppResources.ZZPleaseselectFormBundleNumber}"
HeaderTextColor="White"
                    ShowColumnHeader="False"
                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"
                                      HeaderBackgroundColor="#006450"
                    SelectedItemTextColor="#006450"
                    BorderColor="Black"
                    UnSelectedItemTextColor="#006450"            
                   ItemHeight="40"
                   BackgroundColor="#EAF7CC"
                   DisplayMemberPath="Fbnum" ItemsSource="{Binding FormBundleApplicatioNumberList}"     Grid.Row="1" Grid.Column="0" Margin="10,0,10,0"
                    SelectionChanged="CPicker_SelectionChanged" OkButtonClicked="CPicker_OkButtonClicked" CancelButtonClicked="CPicker_CancelButtonClicked"
                    IsEnabled="True"
                    ShowFooter="True"
                                             PickerHeight="250"
                    PickerWidth="300"
                                             HeaderFontSize="14"
                    OKButtonTextColor="#006450"
                    CancelButtonTextColor="#006450"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    CancelButtonBackgroundColor="#EAF7CC" FooterHeight="46">
                            <syncfusion:SfPicker.Behaviors>
                                <custom1:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>
                        </syncfusion:SfPicker>
                        <!--SelectedItem="{Binding SelectedFormBindleFbnum}"-->
                        <!--<Frame Grid.Row="1"  Margin="10,13,10,0" Padding="13" VerticalOptions="FillAndExpand" Grid.Column="0" Grid.ColumnSpan="7"  Style="{StaticResource GAZTFrameStyleForEntry}"   >
                    </Frame>
                    <custom:GAZTBorderlessPicker x:Name="CPicker" Title="{x:Static custom2:AppResources.ZZPleaseselectFormBundleNumber}" Margin="10,13,10,0" VerticalOptions="CenterAndExpand" Style="{StaticResource GAZTDropdownStyle}"   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"  ItemsSource="{Binding FormBundleApplicatioNumberList}" ItemDisplayBinding="{Binding Fbnum}"  SelectedItem="{Binding SelectedFormBindleFbnum}" IsEnabled="{Binding IsCPickerEnable}"></custom:GAZTBorderlessPicker>
                    <Image Grid.Row="1"  Grid.Column="6"  x:Name="CPicker_imgtap"  Margin="0,13,0,0"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Source="ic_dropdownOne.png" >
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer  Tapped="TapGestureRecognizer_Tapped_1" />
                        </Image.GestureRecognizers>
                    </Image>-->
                        <!--<ListView  x:Name="fblist" 
           ItemsSource="{Binding ListFormBudles}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                           Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="7"
                              Margin="10,13,10,0"
            SeparatorVisibility="None"
            >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout>
                                        <Label Text="{Binding Fbnum}"></Label>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>-->
                        <!--<StackLayout Margin="10,0,10,0" HorizontalOptions="FillAndExpand"  Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="7" >-->
                        <ListView    Grid.Row="2"  Grid.Column="0"
           ItemsSource="{Binding ListFormBudles}"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="Start"
            HasUnevenRows="True"
                               BackgroundColor="White"
                            ItemTapped="ListView_ItemTapped"
            SeparatorVisibility="None"
            >
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <cards:SfCardView HasShadow="True" Margin="10" Opacity=".9" BorderWidth=".05" BorderColor="#5d6770"  ShadowColor="#5d6770" BackgroundColor="White" CornerRadius="8"  IndicatorColor="DarkGreen" IndicatorPosition="Left" IndicatorThickness="5" >
                                            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Margin="0" Padding="10" >
                                                <Grid ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand"  BackgroundColor="White" >
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Label  Margin="0" 
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0" 
                                                           >
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Text="{x:Static custom2:AppResources.ZStatus}"></Span>
                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Text=" : "></Span>
                                                                <Span Style="{StaticResource MicroGrayLabelStyleNewEn}"  FontFamily="{StaticResource SSTArabicMedium}" Text="{Binding FbStatus}"></Span>
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <!--<Label Text="{x:Static custom2:AppResources.ZStatus}" Margin="0" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                           />
                                                        <Label Text="{Binding FbStatus}" 
                                  Margin="0" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                                           />-->
                                                    <Label  Margin="0" 
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0" 
                                                           >
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"  Text="{x:Static custom2:AppResources.ZZDescriptionForFormBundle}"></Span>
                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Text=" : "></Span>
                                                                <Span Style="{StaticResource MicroGrayLabelStyleNewEn}"  FontFamily="{StaticResource SSTArabicMedium}"       Text="{Binding FbDesc}"></Span>
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <!--<Label 
                                                 Style="{StaticResource MiniGoldLabelStyle}"
                                                HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                                        Grid.ColumnSpan="4"
                                                         Text="{x:Static custom2:AppResources.ZZDescriptionForFormBundle}"
                                   >
                                                        </Label>
                                                                <Label Text="{Binding FbDesc}" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                                           />-->
                                                </Grid>
                                            </StackLayout>
                                        </cards:SfCardView>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <!--</StackLayout>-->
                    </Grid>
                </Grid>
            </StackLayout>
            <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle" 
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                        
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70"
                                       TextColor="#006450"/>
                        <!--Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"-->
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>