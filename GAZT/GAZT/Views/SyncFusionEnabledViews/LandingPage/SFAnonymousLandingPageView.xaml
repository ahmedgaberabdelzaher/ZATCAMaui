                                    <gradient:SfGradientStop Color="#b8495c" Offset="1.0" />
                                </gradient:SfLinearGradientBrush.GradientStops>
                            </gradient:SfLinearGradientBrush>
                        </gradient:SfGradientView.BackgroundBrush>
                    </gradient:SfGradientView>
                </StackLayout>-->
                <!--<controls:TapAnimationGrid  Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" ColumnSpacing="0" Command="{Binding ShowOptionsCommand}" RowSpacing="0" Tapped="False" x:Name="burgerMenu_tapGrid" BackgroundColor="Transparent" VerticalOptions="Start"  HorizontalOptions="Start" >-->
                <Label x:Name="HamberLabel" Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Style="{StaticResource IconLabelStyle}"   Text="{StaticResource BurgerMenu}" TextColor="White" HorizontalOptions="Start" VerticalOptions="Start" >
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowOptionsCommand}"></TapGestureRecognizer>
                    </Label.GestureRecognizers>
                </Label>
                <!--</controls:TapAnimationGrid>-->
                <StackLayout x:Name="LogoStackLayout" Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" >
                    <Image  Aspect="AspectFit" Source="logo_gazt.png" HorizontalOptions="Center" VerticalOptions="Center"  Margin="0,0,0,0" ></Image>
                    <!--<local1:CustomLabel  TextColor="White" Text="{x:Static local:AppResources.ZZZLandingPageTitle}" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" Style="{StaticResource LabelStyleFromCommonStyle}" ></local1:CustomLabel>-->
                </StackLayout>
                <!--<StackLayout Grid.Row="1" Grid.Column="0" HorizontalOptions="CenterAndExpand" >
                 <Button   VerticalOptions="Center" Text="{x:Static local:AppResources.LogIn}" TextColor="White"  BackgroundColor="#d99a29"  Clicked="SignIn_Clicked" Padding="20,0,20,0"/>              
                </StackLayout>-->
                <!--HeightRequest="56"-->
            </Grid>
            <!--<local1:CustomLabel Grid.Row="2" Grid.Column="0" Text="Copyright" TextDecorations="Underline"   TextColor="Black"  HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" VerticalOptions="CenterAndExpand" Style="{StaticResource LabelStyleFromCommonStyle}" >
