                <local1:CustomLabel TextDecorations="Underline" IsEnabled="False"  TextColor="White"  HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" VerticalOptions="CenterAndExpand" Style="{StaticResource LabelStyleFromCommonStyle}" >
