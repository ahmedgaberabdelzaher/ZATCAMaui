    <ContentPage.Content>
        <Grid x:Name="ParentContainer" BackgroundColor="White" >
            <Grid.RowDefinitions>
                <RowDefinition  Height="26*"/>
                <RowDefinition  Height="74*"/>
                     
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>
            <ScrollView Grid.Row="1" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <StackLayout Padding="5">
                    <local1:CustomLabel  Margin="7,13,7,13" Padding="0" TextColor="#006450"  Text="{x:Static local:AppResources.ZZZWelcomeOnLanding}" Style="{StaticResource LabelStyleFromCommonGreenStyle}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></local1:CustomLabel>
                    <local1:CustomLabel  Margin="7,0,7,5" HorizontalOptions="StartAndExpand"    TextColor="#5D6770" HorizontalTextAlignment="Start" Text="{x:Static local:AppResources.ZZZLandingCreateAccountNote}" x:Name="LandingCreateAccountNote"  Style="{StaticResource LabelStyleFromCommonGrayStyle}" FontFamily="{StaticResource SSTArabicMedium}"></local1:CustomLabel>
                    <StackLayout VerticalOptions="Center" HorizontalOptions="CenterAndExpand" Margin="6,0,6,0">
                        <buttons:SfButton  Style="{StaticResource SfButtonStyle}" CornerRadius="4"  VerticalOptions="Center"   HeightRequest="40" Text="{x:Static local:AppResources.LogIn}" TextColor="White"  BackgroundColor="#006450"  Clicked="SignIn_Clicked" Padding="20,0,20,0" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                    </StackLayout>
                    <StackLayout VerticalOptions="Center"  HorizontalOptions="CenterAndExpand" Margin="6,0,6,0">
                        <buttons:SfButton  Style="{StaticResource SfButtonStyle}" CornerRadius="4" HorizontalOptions="Fill"
                                           BorderWidth="1" VerticalOptions="Center" BorderColor="#d99a29"  HeightRequest="40"
                                           Text="{x:Static local:AppResources.ZZSignup}" TextColor="#d99a29"
                                           BackgroundColor="White"  Clicked="SignUP_Clicked" Padding="20,0,20,0"
                                           FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                    </StackLayout>
                    <!--<StackLayout VerticalOptions="Center"  HorizontalOptions="CenterAndExpand" Margin="6,0,6,0">
                        <buttons:SfButton  Style="{StaticResource SfButtonStyle}" CornerRadius="4" HorizontalOptions="Fill"
                                           BorderWidth="1" VerticalOptions="Center" BorderColor="#d99a29"  HeightRequest="40"
                                           Text="{x:Static local:AppResources.ZZZZestablishmentsignup}" TextColor="#d99a29"
                                           BackgroundColor="White"  Clicked="Establishmentsignup_Clicked" Padding="20,0,20,0"
                                           FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                    </StackLayout>-->
                    <Label Padding="5,0,5,0" Margin="1,13"  TextColor="#006450" Text="{x:Static local:AppResources.ZZeServices}" Style="{StaticResource LabelStyleFromCommonGreenStyle}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></Label>
                    <listView:SfListView x:Name="SfListView" SelectionMode="None" AutoFitMode="Height" WidthRequest="{OnIdiom Phone=350, Tablet=320, Desktop=320}"
                                         ItemSpacing="5" ItemsSource="{Binding eServicesAvailableToTheTP}" HorizontalOptions="Center" VerticalOptions="Center">
                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView CornerRadius="8" HeightRequest="110" WidthRequest="100" BorderColor="#006450" BorderWidth=".5" IndicatorPosition="Bottom" IndicatorThickness="8" IndicatorColor="#006450">
                                    <cards:SfCardView.Content>
                                        <Grid>
                                            <!--<gradient:SfGradientView>
                                                <gradient:SfGradientView.BackgroundBrush>
                                                    <gradient:SfLinearGradientBrush>
                                                        <gradient:SfLinearGradientBrush.GradientStops>
                                                            <gradient:SfGradientStop Color="White" Offset="0.0"/>
                                                            <gradient:SfGradientStop Color="White" Offset="0.0"/>
                                                        </gradient:SfLinearGradientBrush.GradientStops>
                                                    </gradient:SfLinearGradientBrush>
                                                </gradient:SfGradientView.BackgroundBrush>
                                            </gradient:SfGradientView>-->
                                            <StackLayout Margin="10" Spacing="5" HorizontalOptions="Center" VerticalOptions="Center" >
                                                <Image Source="{Binding iConImagePath}" >
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTappedeService"></TapGestureRecognizer>
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                <Label HorizontalTextAlignment="Center" TextColor="#006450"  Style="{StaticResource LabelStyleFromCommonGrayStyle}" FontSize="8.5" >
                                                    <Label.FormattedText >
                                                        <FormattedString>
                                                            <Span Text="{Binding eServiceName}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTappedeService"></TapGestureRecognizer>
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </StackLayout>
                                        </Grid>
                                    </cards:SfCardView.Content>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                        <!--Layout to customize number of columns in SfListView-->
                        <listView:SfListView.LayoutManager>
                            <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=3, Tablet=3, Desktop=3}" />
                        </listView:SfListView.LayoutManager>
                        <listView:SfListView.Behaviors>
                            <behavior:SfListViewExtendHeightBehavior ></behavior:SfListViewExtendHeightBehavior>
                        </listView:SfListView.Behaviors>
                    </listView:SfListView>
                    <Label  Text="{Binding CopyRightText}" FontSize="Micro"   TextColor="#d99a29"  HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center" VerticalTextAlignment="End" VerticalOptions="EndAndExpand" Style="{StaticResource LabelStyleFromCommonGrayStyle}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}">
                    </Label>
                </StackLayout>
            </ScrollView>
            <Grid x:Name="GreenHeader" Grid.Row="0" Grid.Column="0" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition  Height="50*"/>
                    <RowDefinition  Height="30*"/>
                    <RowDefinition  Height="20*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*"/>
                </Grid.ColumnDefinitions>
                <!--<Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Aspect="AspectFill" Source="sf_BannerImage.png" Margin="0,-5,0,0" ></Image>-->
                <border:SfBorder x:Name="border" Grid.Row="0" Grid.Column="0"  Grid.RowSpan="4"    BorderWidth="0">
                    <Grid Grid.Row="0" Grid.Column="0"  Grid.RowSpan="4">
                        <gradient:SfGradientView>
                            <gradient:SfGradientView.BackgroundBrush>
                                <gradient:SfLinearGradientBrush>
                                    <gradient:SfLinearGradientBrush.GradientStops>
                                        <gradient:SfGradientStop Color="#003228" Offset="0.0" />
                                        <gradient:SfGradientStop Color="#006450" Offset="1.0" />
                                    </gradient:SfLinearGradientBrush.GradientStops>
                                </gradient:SfLinearGradientBrush>
                            </gradient:SfGradientView.BackgroundBrush>
                        </gradient:SfGradientView>
                    </Grid>
                </border:SfBorder>
                <!--<StackLayout Grid.Row="0" Grid.Column="0"  Grid.RowSpan="4" Margin="0,-5,0,0" >
