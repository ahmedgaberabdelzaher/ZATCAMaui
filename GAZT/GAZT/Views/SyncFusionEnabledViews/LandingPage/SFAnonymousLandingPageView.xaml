        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid x:Name="ParentContainer">
            <Grid.RowDefinitions>
                <RowDefinition  Height="30*"/>
                <RowDefinition  Height="70*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>

          

            <ScrollView Grid.Row="1" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                <StackLayout Padding="5">

                    <Label Padding="5" TextColor="#006450" Text="{x:Static local:AppResources.ZZeServices}"></Label>

                    <listView:SfListView x:Name="SfListView" SelectionMode="None" AutoFitMode="Height" ItemSpacing="5" ItemsSource="{Binding eServicesAvailableToTheTP}" >

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView CornerRadius="8" HeightRequest="100" WidthRequest="100" BorderColor="#006450" BorderWidth=".5" IndicatorPosition="Bottom" IndicatorThickness="8" IndicatorColor="#006450">
                                    <cards:SfCardView.Content>
                                        <Grid>
                                            <!--<gradient:SfGradientView>
                                                <gradient:SfGradientView.BackgroundBrush>
                                                    <gradient:SfLinearGradientBrush>
                                                        <gradient:SfLinearGradientBrush.GradientStops>
                                                            <gradient:SfGradientStop Color="White" Offset="0.0"/>
                                                            <gradient:SfGradientStop Color="White" Offset="0.0"/>
                                                        </gradient:SfLinearGradientBrush.GradientStops>
                                                    </gradient:SfLinearGradientBrush>
                                                </gradient:SfGradientView.BackgroundBrush>
                                            </gradient:SfGradientView>-->

                                            <StackLayout Margin="10" Spacing="5" HorizontalOptions="Center" VerticalOptions="Center" >
                                                <Image Source="{Binding iConImagePath}" >
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTappedeService"></TapGestureRecognizer>
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                <Label HorizontalTextAlignment="Center" TextColor="#006450" LineHeight="{OnPlatform Android=1.25, Default=-1}" FontFamily="{StaticResource Montserrat-Regular}" FontSize="Micro" >
                                                    <Label.FormattedText >
                                                        <FormattedString>
                                                            <Span Text="{Binding eServiceName}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTappedeService"></TapGestureRecognizer>
                                                    </Label.GestureRecognizers>
                                                </Label>

                                            </StackLayout>
                                        </Grid>
                                    </cards:SfCardView.Content>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>

                        <!--Layout to customize number of columns in SfListView-->
                        <listView:SfListView.LayoutManager>
                            <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=3, Tablet=4, Desktop=5}" />
                        </listView:SfListView.LayoutManager>

                        <listView:SfListView.Behaviors>
                            <behavior:SfListViewExtendHeightBehavior ></behavior:SfListViewExtendHeightBehavior>
                        </listView:SfListView.Behaviors>

                    </listView:SfListView>

                </StackLayout>

            </ScrollView>

            <Grid Grid.Row="0" Grid.Column="0" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition  Height="50*"/>
                    <RowDefinition  Height="30*"/>
                    <RowDefinition  Height="20*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Aspect="AspectFill" Source="sf_BannerImage.png" Margin="0,-5,0,0" ></Image>

                <!--<controls:TapAnimationGrid Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" ColumnSpacing="0" Command="{Binding ShowOptionsCommand}" RowSpacing="0" Tapped="False" VerticalOptions="Start" BackgroundColor="Transparent" HorizontalOptions="Start">
                    <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource IconLabelStyle}" Text="{StaticResource BurgerMenu}" TextColor="White" HorizontalOptions="Start" VerticalOptions="Start" />
                </controls:TapAnimationGrid>-->

                <Image Grid.Row="0" Grid.Column="0" Aspect="AspectFit" Source="sf_ic_Dashboard_Logo_White.png" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,10,0,0" ></Image>

               <StackLayout Grid.Row="1" Grid.Column="0" HorizontalOptions="CenterAndExpand" >
                 <Button   VerticalOptions="Center" Text="{x:Static local:AppResources.LogIn}" BackgroundColor="#d99a29"  Clicked="SignIn_Clicked" Padding="20,0,20,0"/>              
                </StackLayout>
               
            </Grid>


            <!--<busyindicator:SfBusyIndicator x:Name="BusyIndicator" AnimationType="HorizontalPulsingBox" ViewBoxWidth = "150" ViewBoxHeight="150" TextColor="DarkGreen" IsBusy="{Binding IsLoading}" Grid.Row="0" Grid.RowSpan="2"/>-->
        </Grid>
    </ContentPage.Content>
</ContentPage>