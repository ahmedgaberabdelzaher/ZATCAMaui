                                    TodayTextColor="Green"
                                    TodaySelectionBackgroundColor="Green"
                                    TodaySelectionTextColor="Black"
                                    SelectedDayTextColor="Black"                                
                                    PreviousMonthBackgroundColor="Transparent"
                                    WeekEndBackgroundColor="Transparent" 
                                    PreviousMonthTextColor="Green" SelectionShape="Circle" 
                                    DayHeaderFontSize="10" 
                                    DayHeight="15" 
                                    DayHeaderFormat="" 
                                    DayLabelTextAlignment="Center">

                                </syncfusionCalendar:MonthViewSettings>


                            </syncfusionCalendar:SfCalendar.MonthViewSettings>

                        </syncfusionCalendar:SfCalendar>
                    </syncfusion:SfExpander.Content>
                </syncfusion:SfExpander>
            </StackLayout>-->

            <ScrollView Grid.Row="1" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                <StackLayout Padding="5">

                                        <local1:CustomLabel  Padding="5" TextColor="#006450" Text="{x:Static local:AppResources.ZZMyCommitments}"  FontFamily="{StaticResource GAZT_FONT_BOLD}"></local1:CustomLabel>

                    <syncfusionCalendar:SfCalendar Margin="0" Opacity="1" x:Name="calendar" ViewMode="MonthView" ShowInlineEvents="True" MaximumEventIndicatorCount="1" DataSource="{Binding BillsAndReturnsSchedule}" NumberOfWeeksInView="2" HeightRequest="240" InlineViewMode="Agenda" AgendaViewHeight="80" FirstDayofWeek="0" FlowDirection="LeftToRight">

                        <syncfusionCalendar:SfCalendar.MonthViewSettings >

                            <syncfusionCalendar:MonthViewSettings 
                               DayCellFontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                DayHeaderFontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                               HeaderFontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                
                                    CurrentMonthBackgroundColor="Transparent" 
                                    DayHeaderBackgroundColor="Transparent" 
                                    DisabledBackgroundColor="Transparent"
                                    InlineBackgroundColor="Transparent" 
                                    AgendaSelectedDateColor="#D99A29"
                                    DateSelectionColor="#AA0C19"
                                    TodayBorderColor="Green"
                                    TodayTextColor="Green"
                                    TodaySelectionBackgroundColor="Green"
                                    TodaySelectionTextColor="White"
                                    SelectedDayTextColor="White"                                
                                    WeekEndBackgroundColor="Transparent" 
                                    PreviousMonthTextColor="White" SelectionShape="Circle" 
                                    DayHeaderFontSize="15" 
                                    DayLabelTextAlignment="Center" HeaderFontSize="16" SelectionRadius="15" HeaderFontAttributes="Bold" HeaderBackgroundColor="Transparent">
                                
                                <syncfusionCalendar:MonthViewSettings.InlineItemTemplate>
                                    <DataTemplate>
                                        <StackLayout VerticalOptions="CenterAndExpand">
                                            <!--<Label TextColor="Red" Text="{Binding Subject}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" VerticalTextAlignment="Center" HorizontalTextAlignment="Start" LineBreakMode="WordWrap" Padding="0,15,0,1" FontSize="Micro">--> 
                                            <Editor HeightRequest="80" TextColor="#AA0C19" Text="{Binding Subject}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"         FontSize="Micro" IsEnabled="False" IsSpellCheckEnabled="False"/>
                                            
                                            <!--<Button BackgroundColor="DarkGreen" Text="COPY" TextColor="White" />-->
                                        </StackLayout>
                                    </DataTemplate>
                                </syncfusionCalendar:MonthViewSettings.InlineItemTemplate>

                            </syncfusionCalendar:MonthViewSettings>
                            
                            
                        </syncfusionCalendar:SfCalendar.MonthViewSettings>
                    </syncfusionCalendar:SfCalendar>

                    <local1:CustomLabel Padding="5" TextColor="#006450" Text="{x:Static local:AppResources.MyBills}" FontFamily="{StaticResource GAZT_FONT_BOLD}"></local1:CustomLabel>

                    <listView:SfListView SelectionMode="None" AutoFitMode="Height" ItemSpacing="5" ItemsSource="{Binding BillsInfoItems}" SelectedItem="{Binding SelectedBillsType}">

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView CornerRadius="2" BorderWidth=".25" BorderColor="#5d6770" HasShadow="True" ShadowColor="#5d6770" BackgroundColor="White">
                                    <cards:SfCardView.Content>
                                        <Grid>
                                            <StackLayout Margin="5" Spacing="5" >
                                                <StackLayout Orientation="Horizontal" >
                                                    <Image Aspect="AspectFit"  Source="{Binding iConImagePath}" HorizontalOptions="Start">
                                                        <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnImageClicked"></TapGestureRecognizer>
                                                    </Image.GestureRecognizers>
                                                    </Image>
                                                    <!--<Image Aspect="AspectFit"  Source="{Binding iConImagePath}" HorizontalOptions="Start">

                                                    </Image>-->
                                                    <local1:CustomLabel TextColor="#5d6770"  LineHeight="{OnPlatform Android=1.25, Default=-1}" VerticalTextAlignment="Center">
                                                        <Label.FormattedText >
                                                            <FormattedString>
                                                                <Span  Text="{Binding BillTypeName}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                         <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnLabelClicked"></TapGestureRecognizer>
                                                    </Label.GestureRecognizers>
                                                    </local1:CustomLabel>
                                                      <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnStackLayoutClicked"></TapGestureRecognizer>
                                                    </StackLayout.GestureRecognizers>
                                                </StackLayout>
                                                <local1:CustomLabel Text="{Binding BillCount}" FontSize="Title"  TextColor="#474747" Padding="0,10,0,15">
 <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnLabelClicked"></TapGestureRecognizer>
                                                    </Label.GestureRecognizers>
                                                </local1:CustomLabel>

                                                <local1:CustomLabel Text="{x:Static local:AppResources.ZSAR}"  TextColor="Gray" FontFamily="{StaticResource SSTArabicMedium}">
 <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnLabelClicked"></TapGestureRecognizer>
                                                    </Label.GestureRecognizers>
                                                </local1:CustomLabel>
                                                <local1:CustomLabel Text="{Binding BillAmount}" TextColor="#006450"  FontFamily="{StaticResource SSTArabicMedium}" FontSize="Micro">
 <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnLabelClicked"></TapGestureRecognizer>
                                                    </Label.GestureRecognizers>
                                                </local1:CustomLabel>
                                                <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnStackLayoutClicked"></TapGestureRecognizer>
                                                    </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                        </Grid>
                                    </cards:SfCardView.Content>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>


                        <listView:SfListView.LayoutManager>
                            <listView:GridLayout SpanCount="3"/>
                        </listView:SfListView.LayoutManager>

                        <listView:SfListView.Behaviors>
                            <behavior:SfListViewExtendHeightBehavior ></behavior:SfListViewExtendHeightBehavior>
                        </listView:SfListView.Behaviors>

                    </listView:SfListView>

                    <local1:CustomLabel Padding="5" TextColor="#006450" Text="{x:Static local:AppResources.Returns}"  FontFamily="{StaticResource GAZT_FONT_BOLD}"></local1:CustomLabel>

                    <listView:SfListView SelectionMode="None" AutoFitMode="Height" ItemSpacing="5" ItemsSource="{Binding ReturnInfoItems}">

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView CornerRadius="2" HeightRequest="120" HasShadow="True" ShadowColor="#5d6770">
                                    <cards:SfCardView.Content>
                                        <Grid>
                                            <gradient:SfGradientView>
                                                <gradient:SfGradientView.BackgroundBrush>
                                                    <gradient:SfLinearGradientBrush>
                                                        <gradient:SfLinearGradientBrush.GradientStops>
                                                            <gradient:SfGradientStop Color="{Binding BackgroundGradientStart}" Offset="1.0"/>
                                                            <gradient:SfGradientStop Color="{Binding BackgroundGradientEnd}" Offset="1.0"/>
                                                        </gradient:SfLinearGradientBrush.GradientStops>
                                                    </gradient:SfLinearGradientBrush>
                                                </gradient:SfGradientView.BackgroundBrush>
                                            </gradient:SfGradientView>

                                            <StackLayout Margin="5" Spacing="5" VerticalOptions="Center"  HorizontalOptions="Center">
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"></TapGestureRecognizer>
                                                </StackLayout.GestureRecognizers>
                                                <StackLayout Orientation="Horizontal" VerticalOptions="Center" HorizontalOptions="Center">
                                                    <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"></TapGestureRecognizer>
                                                    </StackLayout.GestureRecognizers>
                                                    <Image Aspect="AspectFit"  Source="{Binding iConImagePath}" HorizontalOptions="Start"></Image>
                                                    <local1:CustomLabel Text="{Binding ReturnCount}" TextColor="{DynamicResource Gray-White}">
                                                    </local1:CustomLabel>
                                                </StackLayout>
                                                <local1:CustomLabel Text="{Binding ReturnTypeName}" TextColor="{DynamicResource Gray-White}">
                                                </local1:CustomLabel>
                                            </StackLayout>
                                        </Grid>
                                    </cards:SfCardView.Content>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>


                        <listView:SfListView.LayoutManager>
                            <listView:GridLayout SpanCount="3" />
                        </listView:SfListView.LayoutManager>

                        <listView:SfListView.Behaviors>
                            <behavior:SfListViewExtendHeightBehavior ></behavior:SfListViewExtendHeightBehavior>
                        </listView:SfListView.Behaviors>

                    </listView:SfListView>

                    <local1:CustomLabel Padding="5" TextColor="#006450" Text="{x:Static local:AppResources.ZZeServices}" FontFamily="{StaticResource GAZT_FONT_BOLD}"></local1:CustomLabel>

                    <listView:SfListView x:Name="SfListView" SelectionMode="None" AutoFitMode="Height" ItemSpacing="5" ItemsSource="{Binding eServicesAvailableToTheTP}" >

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView CornerRadius="8" HeightRequest="100" WidthRequest="100" BorderColor="#006450" BorderWidth=".5" IndicatorPosition="Bottom" IndicatorThickness="8" IndicatorColor="#006450">
                                    <cards:SfCardView.Content>
                                        <Grid>
                                            <!--<gradient:SfGradientView>
                                                <gradient:SfGradientView.BackgroundBrush>
                                                    <gradient:SfLinearGradientBrush>
                                                        <gradient:SfLinearGradientBrush.GradientStops>
                                                            <gradient:SfGradientStop Color="White" Offset="0.0"/>
                                                            <gradient:SfGradientStop Color="White" Offset="0.0"/>
                                                        </gradient:SfLinearGradientBrush.GradientStops>
                                                    </gradient:SfLinearGradientBrush>
                                                </gradient:SfGradientView.BackgroundBrush>
                                            </gradient:SfGradientView>-->

                                            <StackLayout Margin="10" Spacing="5" HorizontalOptions="Center" VerticalOptions="Center"  >
                                                <Image Source="{Binding iConImagePath}"  >
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTappedTest" NumberOfTapsRequired="1"></TapGestureRecognizer>
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                <Label HorizontalTextAlignment="Center"  TextColor="#006450" Style="{StaticResource LabelStyleFromCommonGrayStyle}" FontSize="Micro">
                                                    <Label.FormattedText >
                                                        <FormattedString>
                                                            <Span Text="{Binding eServiceName}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTappedTest" NumberOfTapsRequired="1"></TapGestureRecognizer>
                                                    </Label.GestureRecognizers>
                                                </Label>
                                                 <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTappedTest" NumberOfTapsRequired="1"></TapGestureRecognizer>
                                                    </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                        </Grid>
                                    </cards:SfCardView.Content>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>

                        <!--Layout to customize number of columns in SfListView-->
                        <listView:SfListView.LayoutManager>
                            <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=3, Tablet=4, Desktop=5}" />
                        </listView:SfListView.LayoutManager>

                        <listView:SfListView.Behaviors>
                            <behavior:SfListViewExtendHeightBehavior ></behavior:SfListViewExtendHeightBehavior>
                        </listView:SfListView.Behaviors>

                    </listView:SfListView>

                </StackLayout>

            </ScrollView>

            <Grid Grid.Row="0" Grid.Column="0" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition  Height="50*"/>
                    <RowDefinition  Height="30*"/>
                    <RowDefinition  Height="20*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Aspect="AspectFill" Source="sf_BannerImage.png" Margin="0,-5,0,0" ></Image>

                <!--<controls:TapAnimationGrid Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" ColumnSpacing="0" Command="{Binding ShowOptionsCommand}"  RowSpacing="0" Tapped="False" VerticalOptions="Start" BackgroundColor="Transparent" HorizontalOptions="Start">-->
                <local1:CustomLabel Grid.Row="0" Grid.Column="0" Style="{StaticResource IconLabelStyle}" Text="{StaticResource BurgerMenu}" TextColor="White" HorizontalOptions="Start" VerticalOptions="Start" >
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowOptionsCommand}" >
                            
                        </TapGestureRecognizer>
                    </Label.GestureRecognizers>
                </local1:CustomLabel>
                <!--</controls:TapAnimationGrid>-->

                <Image Grid.Row="0" Grid.Column="0" Aspect="AspectFit" Source="sf_ic_Dashboard_Logo_White.png" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,10,0,0" ></Image>
                <local1:CustomLabel  Grid.Row="1" Grid.Column="0" VerticalTextAlignment="Start" LineBreakMode="WordWrap"  HorizontalTextAlignment="Center"  TextColor="White" BindingContext="{Binding TaxPayerProfile}">
                    <Label.FormattedText >
                        <FormattedString>
                            <Span Text="{x:Static local:AppResources.Hi}" FontFamily="{StaticResource SSTArBold}"/>
                            <Span Text="{Binding Name}" TextColor="White"  FontFamily="{StaticResource SSTArBold}"/>
                            <!--<Span Text="&#10;"/>
                            <Span Text="{Binding Email}" TextColor="White"/>-->
                            <Span Text="&#10;"/>
                            <Span Text="{Binding Tin}" TextColor="White" FontFamily="{StaticResource SSTArBold}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </local1:CustomLabel>
            </Grid>

            <Grid Grid.Row="0"  Grid.RowSpan="2" Grid.Column="0" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0"  Grid.RowSpan="2" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0"  Grid.RowSpan="2" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                        Title="{x:Static local:AppResources.ActivityIndicatorTitle}"
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#006450"/>
                        
                        
                    </StackLayout>
                </StackLayout>
            </Grid>
      
            
            
            <!--<busyindicator:SfBusyIndicator x:Name="BusyIndicator" AnimationType="HorizontalPulsingBox" ViewBoxWidth = "150" ViewBoxHeight="150" TextColor="DarkGreen" IsBusy="{Binding IsLoading}" Grid.Row="0" Grid.RowSpan="2"/>-->
        </Grid>
    </ContentPage.Content>
</ContentPage>