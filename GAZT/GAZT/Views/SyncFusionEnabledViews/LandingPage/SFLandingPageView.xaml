<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GAZTeServicesApp.Views.LandingPage.SFLandingPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behavior="clr-namespace:GAZTeServicesApp.Behaviors"
    xmlns:template="clr-namespace:GAZTeServicesApp.Views.Templates"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:syncfusionCalendar="clr-namespace:Syncfusion.SfCalendar.XForms;assembly=Syncfusion.SfCalendar.XForms"
    xmlns:rotator="clr-namespace:Syncfusion.SfRotator.XForms;assembly=Syncfusion.SfRotator.XForms"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:gradient="clr-namespace:Syncfusion.XForms.Graphics;assembly=Syncfusion.Core.XForms"
    xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:core="clr-namespace:Syncfusion.XForms.Core;assembly=Syncfusion.Core.XForms"
   xmlns:local="clr-namespace:GAZT;assembly:GAZT"
    x:Name="articleTilePage"
    BackgroundColor="{DynamicResource Gray-White}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--<converter:BooleanToStringConverter x:Key="BoolToStringConverter" />-->

            <DataTemplate x:Key="HorizontalArticleView">
                <template:ArticleTileTemplate ParentBindingContext="{Binding Path=BindingContext, Source={x:Reference articleTilePage}}" />
            </DataTemplate>

            <DataTemplate x:Key="HeaderView">
                <StackLayout Spacing="8">
                    <!--  Rotator view  -->
                    <rotator:SfRotator
                        x:Name="Rotator"
                        BackgroundColor="White"
                        DotPlacement="Default"
                        DotsBorderColor="Transparent"
                        EnableLooping="False"
                        HeightRequest="210"
                        HorizontalOptions="Center"
                        ItemsSource="{Binding FeaturedStories}"
                        NavigationStripMode="Dots"
                        SelectedDotColor="{DynamicResource GAZTPrimaryColor}"
                        UnselectedDotColor="{DynamicResource Gray-White}"
                        VerticalOptions="Start">
                        <rotator:SfRotator.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Grid">
                                    <Image
                                        Aspect="AspectFill"
                                        BackgroundColor="{DynamicResource Gray-200}"
                                        HeightRequest="210"
                                        Source="{Binding ImagePath}" />

                                    <border:SfBorder
                                        BackgroundColor="{DynamicResource GAZTPrimaryColor}"
                                        BorderWidth="0"
                                        HorizontalOptions="Start"
                                        Opacity="0.6"
                                        VerticalOptions="Center">
                                        <Label
                                            Margin="16"
                                            FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                            FontSize="20"
                                            LineBreakMode="TailTruncation"
                                            LineHeight="{OnPlatform Default=-1,
                                                                    Android=1.25}"
                                            MaxLines="2"
                                            Text="{Binding Name}"
                                            TextColor="{DynamicResource Gray-White}"
                                            WidthRequest="200" />
                                    </border:SfBorder>

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.FeatureStoriesCommand, Source={x:Reference Rotator}}" CommandParameter="{Binding BindingContext, Source={x:Reference Grid}}" />
                                    </Grid.GestureRecognizers>

                                </Grid>
                            </DataTemplate>
                        </rotator:SfRotator.ItemTemplate>
                    </rotator:SfRotator>
                </StackLayout>
            </DataTemplate>

            <!--<DataTemplate x:Key="AppointmentTemplate">
                <Button xmlns="http://xamarin.com/schemas/2014/forms" 
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
                x:Class="AppointmentTemplate" 
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand" 
                BackgroundColor="{Binding Color}" 
                Text="{Binding Subject}" 
                FontAttributes="Bold" 
                TextColor="White" />
            </DataTemplate >

            <DataTemplate x:Key="AllDayAppointmentTemplate">
                <Button xmlns="http://xamarin.com/schemas/2014/forms"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="Calendar_Sample.AllDayAppointmentTemplate"
            HorizontalOptions="FillAndExpand" 
            VerticalOptions="FillAndExpand" 
            BackgroundColor="{Binding Color}" 
            Text="{Binding Subject}" 
            FontAttributes="Bold" 
            TextColor="Black" />
            </DataTemplate>-->
            
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid x:Name="ParentContainer">
            <Grid.RowDefinitions>
                <RowDefinition  Height="30*"/>
                <RowDefinition  Height="70*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>

            <!--<StackLayout>
                <syncfusion:SfExpander IconColor="#006450">
                    <syncfusion:SfExpander.Header>
                        <Label Padding="10" TextColor="#006450" LineHeight="{OnPlatform Android=1.25, Default=-1}" FontFamily="{StaticResource Montserrat-Regular}" FontSize="Small" Text="My Commitments" VerticalTextAlignment="Center" />
                    </syncfusion:SfExpander.Header>
                    <syncfusion:SfExpander.Content>
                        <syncfusionCalendar:SfCalendar Margin="0" Opacity="1" x:Name="calendar" ViewMode="MonthView" ShowInlineEvents="True" MaximumEventIndicatorCount="2" DataSource="{Binding BillsAndReturnsSchedule}" NumberOfWeeksInView="1" HeightRequest="240" InlineViewMode="Agenda" AgendaViewHeight="80" FirstDayofWeek="0" >

                            <syncfusionCalendar:SfCalendar.MonthViewSettings>

                                <syncfusionCalendar:MonthViewSettings 
                                    CurrentMonthBackgroundColor="Transparent" 
                                    DayHeaderBackgroundColor="Transparent" 
                                    HeaderBackgroundColor="Transparent" 
                                    DisabledBackgroundColor="Transparent"
                                    InlineBackgroundColor="Transparent" 
                                    AgendaSelectedDateColor="Green"
                                    DateSelectionColor="Orange"
                                    TodayBorderColor="Green"
                                    TodayTextColor="Green"
                                    TodaySelectionBackgroundColor="Green"
                                    TodaySelectionTextColor="Black"
                                    SelectedDayTextColor="Black"                                
                                    PreviousMonthBackgroundColor="Transparent"
                                    WeekEndBackgroundColor="Transparent" 
                                    PreviousMonthTextColor="Green" SelectionShape="Circle" 
                                    DayHeaderFontSize="10" 
                                    DayHeight="15" 
                                    DayHeaderFormat="" 
                                    DayLabelTextAlignment="Center">

                                </syncfusionCalendar:MonthViewSettings>


                            </syncfusionCalendar:SfCalendar.MonthViewSettings>

                        </syncfusionCalendar:SfCalendar>
                    </syncfusion:SfExpander.Content>
                </syncfusion:SfExpander>
            </StackLayout>-->

            <ScrollView Grid.Row="1" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                <StackLayout Padding="5">

                    <Label Padding="5" TextColor="#006450" Text="{x:Static local:AppResources.ZZMyCommitments}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></Label>

                    <syncfusionCalendar:SfCalendar Margin="0" Opacity="1" x:Name="calendar" ViewMode="MonthView" ShowInlineEvents="True" MaximumEventIndicatorCount="1" DataSource="{Binding BillsAndReturnsSchedule}" NumberOfWeeksInView="2" HeightRequest="240" InlineViewMode="Agenda" AgendaViewHeight="80" FirstDayofWeek="0" >

                        <syncfusionCalendar:SfCalendar.MonthViewSettings >

                            <syncfusionCalendar:MonthViewSettings 
                                HeaderFontFamily="{StaticResource SSTArBold}"
                              DayHeaderFontFamily="{StaticResource SSTArabicMedium}"
                                DayCellFontFamily="{StaticResource SSTArabicMedium}"
                               
                                    CurrentMonthBackgroundColor="Transparent" 
                                    DayHeaderBackgroundColor="Transparent" 
                                    DisabledBackgroundColor="Transparent"
                                    InlineBackgroundColor="Transparent" 
                                    AgendaSelectedDateColor="#D99A29"
                                    DateSelectionColor="Red"
                                    TodayBorderColor="Green"
                                    TodayTextColor="Green"
                                    TodaySelectionBackgroundColor="Green"
                                    TodaySelectionTextColor="Black"
                                    SelectedDayTextColor="Black"                                
                                    WeekEndBackgroundColor="Transparent" 
                                    PreviousMonthTextColor="White" SelectionShape="Circle" 
                                    DayHeaderFontSize="15" 
                                    DayLabelTextAlignment="Center" HeaderFontSize="16" SelectionRadius="15" HeaderFontAttributes="Bold" HeaderBackgroundColor="Transparent">
                                
                                <syncfusionCalendar:MonthViewSettings.InlineItemTemplate>
                                    <DataTemplate>
                                        <StackLayout VerticalOptions="CenterAndExpand">
                                            <Label TextColor="Red" Text="{Binding Subject}" VerticalTextAlignment="Center" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" HorizontalTextAlignment="Start" LineBreakMode="WordWrap" Padding="0,15,0,1" FontSize="Micro"> 
                                            </Label>
                                            <!--<Button BackgroundColor="DarkGreen" Text="COPY" TextColor="White" />-->
                                        </StackLayout>
                                    </DataTemplate>
                                </syncfusionCalendar:MonthViewSettings.InlineItemTemplate>

                            </syncfusionCalendar:MonthViewSettings>
                            
                            
                        </syncfusionCalendar:SfCalendar.MonthViewSettings>
                    </syncfusionCalendar:SfCalendar>

                    <Label Padding="5" TextColor="#006450" Text="{x:Static local:AppResources.MyBills}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></Label>

                    <listView:SfListView SelectionMode="None" AutoFitMode="Height" ItemSpacing="5" ItemsSource="{Binding BillsInfoItems}">

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView CornerRadius="2" BorderWidth=".25" BorderColor="#5d6770" HasShadow="True" ShadowColor="#5d6770" BackgroundColor="White">
                                    <cards:SfCardView.Content>
                                        <Grid>
                                            <StackLayout Margin="5" Spacing="5">
                                                <StackLayout Orientation="Horizontal">
                                                    <Image Aspect="AspectFit"  Source="{Binding iConImagePath}" HorizontalOptions="Start"></Image>
                                                    <Label TextColor="#5d6770"  LineHeight="{OnPlatform Android=1.25, Default=-1}" VerticalTextAlignment="Center">
                                                        <Label.FormattedText >
                                                            <FormattedString>
                                                                <Span  Text="{Binding BillTypeName}"  Style="{StaticResource GAZT_FONT_BOLD}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>
                                                <Label Text="{Binding BillCount}" FontSize="Title" FontFamily="{StaticResource SSTArabicMedium}" TextColor="#474747" Padding="0,10,0,15">
                                                </Label>
                                                <Label Text="{x:Static local:AppResources.ZSAR}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" TextColor="Gray">
                                                </Label>
                                                <Label Text="{Binding BillAmount}" FontFamily="{StaticResource SSTArabicMedium}" TextColor="#006450" >
                                                </Label>
                                            </StackLayout>
                                        </Grid>
                                    </cards:SfCardView.Content>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>


                        <listView:SfListView.LayoutManager>
                            <listView:GridLayout SpanCount="3"/>
                        </listView:SfListView.LayoutManager>

                        <listView:SfListView.Behaviors>
                            <behavior:SfListViewExtendHeightBehavior ></behavior:SfListViewExtendHeightBehavior>
                        </listView:SfListView.Behaviors>

                    </listView:SfListView>

                    <Label Padding="5" TextColor="#006450" Text="{x:Static local:AppResources.Returns}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></Label>

                    <listView:SfListView SelectionMode="None" AutoFitMode="Height" ItemSpacing="5" ItemsSource="{Binding ReturnInfoItems}">

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView CornerRadius="2" HeightRequest="120" HasShadow="True" ShadowColor="#5d6770">
                                    <cards:SfCardView.Content>
                                        <Grid>
                                            <gradient:SfGradientView>
                                                <gradient:SfGradientView.BackgroundBrush>
                                                    <gradient:SfLinearGradientBrush>
                                                        <gradient:SfLinearGradientBrush.GradientStops>
                                                            <gradient:SfGradientStop Color="{Binding BackgroundGradientStart}" Offset="1.0"/>
                                                            <gradient:SfGradientStop Color="{Binding BackgroundGradientEnd}" Offset="1.0"/>
                                                        </gradient:SfLinearGradientBrush.GradientStops>
                                                    </gradient:SfLinearGradientBrush>
                                                </gradient:SfGradientView.BackgroundBrush>
                                            </gradient:SfGradientView>

                                            <StackLayout Margin="5" Spacing="5" VerticalOptions="Center" HorizontalOptions="Center">
                                                <StackLayout Orientation="Horizontal" VerticalOptions="Center" HorizontalOptions="Center">
                                                    <Image Aspect="AspectFit"  Source="{Binding iConImagePath}" HorizontalOptions="Start">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"></TapGestureRecognizer>
                                                        </Image.GestureRecognizers>
                                                    </Image>
                                                    <Label Text="{Binding ReturnCount}" TextColor="{DynamicResource Gray-White}">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"></TapGestureRecognizer>
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                </StackLayout>
                                                <Label Text="{Binding ReturnTypeName}" TextColor="{DynamicResource Gray-White}">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"></TapGestureRecognizer>
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </StackLayout>
                                        </Grid>
                                    </cards:SfCardView.Content>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>


                        <listView:SfListView.LayoutManager>
                            <listView:GridLayout SpanCount="3" />
                        </listView:SfListView.LayoutManager>

                        <listView:SfListView.Behaviors>
                            <behavior:SfListViewExtendHeightBehavior ></behavior:SfListViewExtendHeightBehavior>
                        </listView:SfListView.Behaviors>

                    </listView:SfListView>

                    <Label Padding="5" TextColor="#006450" Text="{x:Static local:AppResources.ZZeServices}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></Label>

                    <listView:SfListView x:Name="SfListView" SelectionMode="None" AutoFitMode="Height" ItemSpacing="5" ItemsSource="{Binding eServicesAvailableToTheTP}" >

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView CornerRadius="8" HeightRequest="100" WidthRequest="100" BorderColor="#006450" BorderWidth=".5" IndicatorPosition="Bottom" IndicatorThickness="8" IndicatorColor="#006450">
                                    <cards:SfCardView.Content>
                                        <Grid>
                                            <!--<gradient:SfGradientView>
                                                <gradient:SfGradientView.BackgroundBrush>
                                                    <gradient:SfLinearGradientBrush>
                                                        <gradient:SfLinearGradientBrush.GradientStops>
                                                            <gradient:SfGradientStop Color="White" Offset="0.0"/>
                                                            <gradient:SfGradientStop Color="White" Offset="0.0"/>
                                                        </gradient:SfLinearGradientBrush.GradientStops>
                                                    </gradient:SfLinearGradientBrush>
                                                </gradient:SfGradientView.BackgroundBrush>
                                            </gradient:SfGradientView>-->

                                            <StackLayout Margin="10" Spacing="5" HorizontalOptions="Center" VerticalOptions="Center" >
                                                <Image Source="{Binding iConImagePath}" >
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTappedTest"></TapGestureRecognizer>
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                <Label HorizontalTextAlignment="Center" TextColor="#006450" LineHeight="{OnPlatform Android=1.25, Default=-1}" FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="Micro" >
                                                    <Label.FormattedText >
                                                        <FormattedString>
                                                            <Span Text="{Binding eServiceName}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTappedTest"></TapGestureRecognizer>
                                                    </Label.GestureRecognizers>
                                                </Label>

                                            </StackLayout>
                                        </Grid>
                                    </cards:SfCardView.Content>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>

                        <!--Layout to customize number of columns in SfListView-->
                        <listView:SfListView.LayoutManager>
                            <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=3, Tablet=4, Desktop=5}" />
                        </listView:SfListView.LayoutManager>

                        <listView:SfListView.Behaviors>
                            <behavior:SfListViewExtendHeightBehavior ></behavior:SfListViewExtendHeightBehavior>
                        </listView:SfListView.Behaviors>

                    </listView:SfListView>

                </StackLayout>

            </ScrollView>

            <Grid Grid.Row="0" Grid.Column="0" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition  Height="50*"/>
                    <RowDefinition  Height="30*"/>
                    <RowDefinition  Height="20*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Aspect="AspectFill" Source="sf_BannerImage.png" Margin="0,-5,0,0" ></Image>

                <controls:TapAnimationGrid Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" ColumnSpacing="0" Command="{Binding ShowOptionsCommand}" RowSpacing="0" Tapped="False" VerticalOptions="Start" BackgroundColor="Transparent" HorizontalOptions="Start">
                    <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource IconLabelStyle}" Text="{StaticResource BurgerMenu}" TextColor="White" HorizontalOptions="Start" VerticalOptions="Start" />
                </controls:TapAnimationGrid>

                <Image Grid.Row="0" Grid.Column="0" Aspect="AspectFit" Source="sf_ic_Dashboard_Logo_White.png" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,10,0,0" ></Image>
                <Label  Grid.Row="1" Grid.Column="0" VerticalTextAlignment="Start" FontFamily="{StaticResource GAZT_FONT_BOLD}" HorizontalTextAlignment="Center"  TextColor="White" BindingContext="{Binding TaxPayerProfile}">
                    <Label.FormattedText >
                        <FormattedString>
                            <Span Text="{x:Static local:AppResources.Hi}" TextColor="White"/>
                            <Span Text="{Binding Name}" TextColor="White"/>
                            <!--<Span Text="&#10;"/>
                            <Span Text="{Binding Email}" TextColor="White"/>-->
                            <Span Text="&#10;&#10;"/>
                            <Span Text="{Binding Tin}" TextColor="White"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>


            <!--<busyindicator:SfBusyIndicator x:Name="BusyIndicator" AnimationType="HorizontalPulsingBox" ViewBoxWidth = "150" ViewBoxHeight="150" TextColor="DarkGreen" IsBusy="{Binding IsLoading}" Grid.Row="0" Grid.RowSpan="2"/>-->
        </Grid>
    </ContentPage.Content>
</ContentPage>