<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.SyncFusionEnabledViews.SFLanding.SFLandingPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:EGAZT;assembly:GAZT"
    xmlns:local1="clr-namespace:GAZT"
    xmlns:behavior="clr-namespace:GAZTeServicesApp.Behaviors"
    xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:syncfusionCalendar="clr-namespace:Syncfusion.SfCalendar.XForms;assembly=Syncfusion.SfCalendar.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:gradient="clr-namespace:Syncfusion.XForms.Graphics;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:local11="clr-namespace:GAZT.SyncFusionEnabledBehaviors.Behaviors"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    x:Name="LandingPage"
   
    BackgroundColor="#003228"
    NavigationPage.HasNavigationBar="False"
    NavigationPage.HasBackButton="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid x:Name="ParentContainer" RowSpacing="0" BackgroundColor="White">
            <Grid.RowDefinitions>
                <RowDefinition  Height="30*"/>
                <RowDefinition  Height="2*"/>
                <RowDefinition  Height="68*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>
            <ScrollView Grid.Row="2" Grid.Column="0" BackgroundColor="White" Margin="0,-10,0,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <StackLayout Padding="5" HorizontalOptions="FillAndExpand" BackgroundColor="White" VerticalOptions="FillAndExpand">
                    <!--<syncfusionCalendar:SfCalendar Margin="0" Opacity="1" x:Name="calendar" ViewMode="MonthView" ShowInlineEvents="True" MaximumEventIndicatorCount="1" DataSource="{Binding BillsAndReturnsSchedule}" NumberOfWeeksInView="2" HeightRequest="240" InlineViewMode="Agenda" AgendaViewHeight="80" FirstDayofWeek="0" FlowDirection="LeftToRight">
                        <syncfusionCalendar:SfCalendar.MonthViewSettings >
                            <syncfusionCalendar:MonthViewSettings 
                               DayCellFontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                DayHeaderFontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                               HeaderFontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                    CurrentMonthBackgroundColor="Transparent" 
                                    DayHeaderBackgroundColor="Transparent" 
                                    DisabledBackgroundColor="Transparent"
                                    InlineBackgroundColor="Transparent" 
                                    AgendaSelectedDateColor="#D99A29"
                                    DateSelectionColor="#AA0C19"
                                    TodayBorderColor="Green"
                                    TodayTextColor="Green"
                                    TodaySelectionBackgroundColor="Green"
                                    TodaySelectionTextColor="White"
                                    SelectedDayTextColor="White"                                
                                    WeekEndBackgroundColor="Transparent" 
                                    PreviousMonthTextColor="White" SelectionShape="Circle" 
                                    DayHeaderFontSize="15" 
                                    DayLabelTextAlignment="Center" HeaderFontSize="16" SelectionRadius="15" HeaderFontAttributes="Bold" HeaderBackgroundColor="Transparent">
                                <syncfusionCalendar:MonthViewSettings.InlineItemTemplate>
                                    <DataTemplate>
                                        <StackLayout VerticalOptions="CenterAndExpand">
                                            -->
                    <!--<Label TextColor="Red" Text="{Binding Subject}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" VerticalTextAlignment="Center" HorizontalTextAlignment="Start" LineBreakMode="WordWrap" Padding="0,15,0,1" FontSize="Micro">-->
                    <!-- 
                                            <Editor HeightRequest="80" TextColor="#AA0C19" Text="{Binding Subject}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"         FontSize="Micro" IsEnabled="False" IsSpellCheckEnabled="False"/>
                                            -->
                    <!--<Button BackgroundColor="DarkGreen" Text="COPY" TextColor="White" />-->
                    <!--
                                        </StackLayout>
                                    </DataTemplate>
                                </syncfusionCalendar:MonthViewSettings.InlineItemTemplate>
                            </syncfusionCalendar:MonthViewSettings>
                        </syncfusionCalendar:SfCalendar.MonthViewSettings>
                    </syncfusionCalendar:SfCalendar>-->
                    <Grid BackgroundColor="White" VerticalOptions="FillAndExpand" Padding="0" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="5*"/>
                            <RowDefinition  Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <local1:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static local:AppResources.NoAppointmentText}" BackgroundColor="White" IsVisible="{Binding IsNoDuesLabelVisible}" Style="{StaticResource GAZTGrayLabelStyleForSmallFont}"  HorizontalOptions="Center" VerticalOptions="Center" >
                        </local1:CustomLabel>
                        <listView:SfListView  x:Name="ReturnsList" 
                                          Grid.Row="1" Grid.Column="0"
          ItemsSource="{Binding CommitmentReturnsList}"
                                       IsScrollBarVisible="True"
                                         SelectionBackgroundColor="White"
                                      Orientation="Vertical"
                                          IsVisible="{Binding IsListviewVisible}"
          HorizontalOptions="FillAndExpand"
           IsScrollingEnabled="False"
           AutoFitMode="Height" ItemSpacing="1" 
                 BackgroundColor="White"     
            >
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <cards:SfCardView HasShadow="True" IndicatorColor="{Binding ColorCode}" IndicatorPosition="Left" IndicatorThickness="5" VerticalOptions="CenterAndExpand"  Margin="3" Padding="0" Opacity=".9" BorderWidth=".01" BorderColor="#5d6770"  ShadowColor="#5d6770" BackgroundColor="White" CornerRadius="3" HorizontalOptions="FillAndExpand"  >
                                            <StackLayout Orientation="Horizontal"  BackgroundColor="White" HorizontalOptions="FillAndExpand" Margin="5" >
                                                <Grid Style="{DynamicResource GridStyle}"  ColumnSpacing="0" RowSpacing="1"   BackgroundColor="White" HorizontalOptions="FillAndExpand" >
                                                    <Grid.ColumnDefinitions>
                                                        <!--<ColumnDefinition Width="15*" />-->
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <!--<RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />-->
                                                    </Grid.RowDefinitions>
                                                    <local1:CustomLabel Text="{Binding Incotext}" 
                                   Style="{StaticResource MicroGrayLabelStyleNew}"
                                                                        FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                                       HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                                                    FontSize="Micro"
                                                                    IsVisible="{Binding IsUnSubmittedReturn}"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                                     Margin="5,0,5,0"
                                                           />
                                                    <local1:CustomLabel Text="{Binding Txt50}" 
                                         FontFamily="{StaticResource SSTArabicMedium}"
                                   Style="{StaticResource MicroGrayLabelStyleNew}"
                                                       HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                                                    FontSize="Micro"
                                                                    IsVisible="{Binding IsPaymentOverdue}"
                                   Grid.Row="0"
                                     Grid.Column="0"
                                                                     Margin="5,0,5,0"
                                                           />
                                                    <local1:CustomLabel 
                                                      FontFamily="{StaticResource SSTArLight}"
                                   Style="{StaticResource MicroGrayLabelStyleNew}"
                                                       HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                                    Margin="5,0,5,0"
                                                    FontSize="Micro"
                                                  IsVisible="{Binding IsUnSubmittedReturn}"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                                          >
                                                        <local1:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Text="{x:Static local:AppResources.ZTaxPeriod}" FontSize="Micro"></Span>
                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Text=" : " FontSize="Micro"></Span>
                                                                <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" FontFamily="{StaticResource SSTArabicMedium}" Text="{Binding TaxPeriod}" FontSize="Micro"></Span>
                                                            </FormattedString>
                                                        </local1:CustomLabel.FormattedText>
                                                    </local1:CustomLabel>
                                                    <local1:CustomLabel 
                                                      FontFamily="{StaticResource SSTArLight}"
                                   Style="{StaticResource MicroGrayLabelStyleNew}"
                                                       HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                                    Margin="5,0,5,0"
                                                    FontSize="Micro"
                                                  IsVisible="{Binding IsPaymentOverdue}"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                                          >
                                                        <local1:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Text="{x:Static local:AppResources.ZAmount}" FontSize="Micro"></Span>
                                                                <Span Style="{StaticResource MicroGrayLabelStyleNew}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Text=" : " FontSize="Micro"></Span>
                                                                <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" FontFamily="{StaticResource SSTArabicMedium}" Text="{Binding Amount}" FontSize="9"></Span>
                                                                <Span Text="{x:Static local:AppResources.ZSAR}"  TextColor="Gray"  Style="{StaticResource MicroGrayLabelValue}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" FontSize="9"></Span>
                                                            </FormattedString>
                                                        </local1:CustomLabel.FormattedText>
                                                    </local1:CustomLabel>
                                                    <StackLayout  Grid.Row="2" Margin="5,0,5,0" Orientation="Horizontal" Grid.Column="0" >
                                                        <local1:CustomLabel
                                                   VerticalOptions="CenterAndExpand"
                                                    Margin="0,0,0,0"
                                FontFamily="{StaticResource SSTArabicMedium}"
                                                          >
                                                            <local1:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.DueDate}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}" FontSize="Micro"></Span>
                                                                    <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : " FontSize="Micro" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"></Span>
                                                                </FormattedString>
                                                            </local1:CustomLabel.FormattedText>
                                                        </local1:CustomLabel>
                                                        <Label
                                   Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                                      FontSize="Micro"
                                                   VerticalOptions="CenterAndExpand"
                                                    Margin="-5,0,-5,0"
                                                    FlowDirection="LeftToRight"
                                                   Text="{Binding FormatedSingleDueDate}"
                                  FontFamily="{StaticResource SSTArabicMedium}"
                                                          >
                                                            <!--<Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.DueDate}" FontSize="Micro"></Span>
                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : " FontSize="Micro"></Span>
                                                            <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding FormatedSingleDueDate}"  FontSize="Micro"></Span>
                                                        </FormattedString>
                                                    </Label.FormattedText>-->
                                                        </Label>
                                                    </StackLayout>
                                                    <!--<Image  Grid.Row="0"  Grid.Column="0"  Grid.RowSpan="2"  Source="{Binding StatusImage}" HorizontalOptions="Center" VerticalOptions="Start"/>-->
                                                </Grid>
                                            </StackLayout>
                                        </cards:SfCardView>
                                    </ViewCell>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                        </listView:SfListView>
                        <StackLayout Grid.Row="0" Grid.Column="0" VerticalOptions="FillAndExpand">
                            <local1:CustomLabel   BackgroundColor="White"  Padding="5" TextColor="#006450" Text="{x:Static local:AppResources.ZZMyUpcomingCommitments}" Style="{StaticResource LabelStyleFromCommonGreenStyleDashboard}"></local1:CustomLabel>
                        </StackLayout>
                    </Grid>
                    <StackLayout BackgroundColor="White">
                        <local1:CustomLabel Padding="5,10,5,5" BackgroundColor="White" TextColor="#006450" Text="{x:Static local:AppResources.MyBills}" Style="{StaticResource LabelStyleFromCommonGreenStyleDashboard}" VerticalOptions="FillAndExpand"></local1:CustomLabel>
                        <listView:SfListView SelectionMode="None" BackgroundColor="White" AutoFitMode="Height" ItemSpacing="5" ItemsSource="{Binding BillsInfoItems}" SelectedItem="{Binding SelectedBillsType}">
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <cards:SfCardView CornerRadius="2" BorderWidth=".25" BorderColor="#5d6770" HasShadow="True" ShadowColor="#5d6770" BackgroundColor="White">
                                        <cards:SfCardView.Content>
                                            <Grid>
                                                <StackLayout Margin="5,0,5,0" Spacing="0" >
                                                    <StackLayout Orientation="Horizontal" HeightRequest="40">
                                                        <Image Aspect="AspectFit"  Source="{Binding iConImagePath}" HorizontalOptions="Start">
                                                            <Image.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnImageClicked"></TapGestureRecognizer>
                                                            </Image.GestureRecognizers>
                                                        </Image>
                                                        <!--<Image Aspect="AspectFit"  Source="{Binding iConImagePath}" HorizontalOptions="Start">
                                                    </Image>-->
                                                        <local1:CustomLabel TextColor="#5d6770"  LineHeight="{OnPlatform Android=1.25, Default=-1}" VerticalTextAlignment="Center" HorizontalOptions="Start" HorizontalTextAlignment="Start" Style="{StaticResource MicroGrayLabelValue}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}">
                                                            <Label.FormattedText >
                                                                <FormattedString>
                                                                    <Span  Text="{Binding BillTypeName}" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnLabelClicked"></TapGestureRecognizer>
                                                            </Label.GestureRecognizers>
                                                        </local1:CustomLabel>
                                                        <StackLayout.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnStackLayoutClicked"></TapGestureRecognizer>
                                                        </StackLayout.GestureRecognizers>
                                                    </StackLayout>
                                                    <local1:CustomLabel Text="{Binding BillCount}" FontSize="Title"  TextColor="#474747" Padding="0,10,0,15" Style="{StaticResource MicroGrayLabelValue}" FontFamily="{StaticResource SSTArabicMedium}">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnLabelClicked"></TapGestureRecognizer>
                                                        </Label.GestureRecognizers>
                                                    </local1:CustomLabel>
                                                    <local1:CustomLabel Text="{x:Static local:AppResources.ZSAR}"  TextColor="Gray"  Style="{StaticResource MicroGrayLabelValue}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnLabelClicked"></TapGestureRecognizer>
                                                        </Label.GestureRecognizers>
                                                    </local1:CustomLabel>
                                                    <local1:CustomLabel Text="{Binding BillAmount}" TextColor="#006450"  FontFamily="{StaticResource SSTArabicMedium}" Style="{StaticResource MicroGrayLabelValue}" FontSize="9">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnLabelClicked"></TapGestureRecognizer>
                                                        </Label.GestureRecognizers>
                                                    </local1:CustomLabel>
                                                    <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnStackLayoutClicked"></TapGestureRecognizer>
                                                    </StackLayout.GestureRecognizers>
                                                </StackLayout>
                                            </Grid>
                                        </cards:SfCardView.Content>
                                    </cards:SfCardView>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                            <listView:SfListView.LayoutManager>
                                <listView:GridLayout SpanCount="3"/>
                            </listView:SfListView.LayoutManager>
                            <listView:SfListView.Behaviors>
                                <behavior:SfListViewExtendHeightBehavior ></behavior:SfListViewExtendHeightBehavior>
                            </listView:SfListView.Behaviors>
                        </listView:SfListView>
                    </StackLayout>
                    <local1:CustomLabel Padding="5" BackgroundColor="White" TextColor="#006450" Text="{x:Static local:AppResources.Returns}"  Style="{StaticResource LabelStyleFromCommonGreenStyleDashboard}"></local1:CustomLabel>
                    <listView:SfListView SelectionMode="None" BackgroundColor="White" AutoFitMode="Height" ItemSpacing="5" ItemsSource="{Binding ReturnInfoItems}">
                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView CornerRadius="2" HeightRequest="120" HasShadow="True" ShadowColor="#5d6770">
                                    <cards:SfCardView.Content>
                                        <Grid>
                                            <gradient:SfGradientView>
                                                <gradient:SfGradientView.BackgroundBrush>
                                                    <gradient:SfLinearGradientBrush>
                                                        <gradient:SfLinearGradientBrush.GradientStops>
                                                            <gradient:SfGradientStop Color="{Binding BackgroundGradientStart}" Offset="1.0"/>
                                                            <gradient:SfGradientStop Color="{Binding BackgroundGradientEnd}" Offset="1.0"/>
                                                        </gradient:SfLinearGradientBrush.GradientStops>
                                                    </gradient:SfLinearGradientBrush>
                                                </gradient:SfGradientView.BackgroundBrush>
                                            </gradient:SfGradientView>
                                            <StackLayout Margin="5" Spacing="5" VerticalOptions="Center"  HorizontalOptions="Center">
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"></TapGestureRecognizer>
                                                </StackLayout.GestureRecognizers>
                                                <StackLayout Orientation="Horizontal" VerticalOptions="Center" HorizontalOptions="Center">
                                                    <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"></TapGestureRecognizer>
                                                    </StackLayout.GestureRecognizers>
                                                    <Image Aspect="AspectFit"  Source="{Binding iConImagePath}" HorizontalOptions="Start"></Image>
                                                    <local1:CustomLabel Text="{Binding ReturnCount}" TextColor="{DynamicResource Gray-White}" Style="{StaticResource MicroGrayLabelValue}" FontFamily="{StaticResource SSTArabicMedium}" FontSize="Title" >
                                                    </local1:CustomLabel>
                                                </StackLayout>
                                                <local1:CustomLabel Text="{Binding ReturnTypeName}" TextColor="{DynamicResource Gray-White}" Style="{StaticResource MicroGrayLabelValue}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}">
                                                </local1:CustomLabel>
                                            </StackLayout>
                                        </Grid>
                                    </cards:SfCardView.Content>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                        <listView:SfListView.LayoutManager>
                            <listView:GridLayout SpanCount="3" />
                        </listView:SfListView.LayoutManager>
                        <listView:SfListView.Behaviors>
                            <behavior:SfListViewExtendHeightBehavior ></behavior:SfListViewExtendHeightBehavior>
                        </listView:SfListView.Behaviors>
                    </listView:SfListView>
                    <local1:CustomLabel Padding="5" TextColor="#006450" Text="{x:Static local:AppResources.ZZeServices}" Style="{StaticResource LabelStyleFromCommonGreenStyleDashboard}"></local1:CustomLabel>
                    <listView:SfListView x:Name="SfListView" SelectionMode="None" AutoFitMode="Height" ItemSpacing="5" ItemsSource="{Binding eServicesAvailableToTheTP}" >
                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView CornerRadius="8" HeightRequest="100" WidthRequest="100" BorderColor="#006450" BorderWidth=".5" IndicatorPosition="Bottom" IndicatorThickness="8" IndicatorColor="#006450">
                                    <cards:SfCardView.Content>
                                        <Grid>
                                            <!--<gradient:SfGradientView>
                                                <gradient:SfGradientView.BackgroundBrush>
                                                    <gradient:SfLinearGradientBrush>
                                                        <gradient:SfLinearGradientBrush.GradientStops>
                                                            <gradient:SfGradientStop Color="White" Offset="0.0"/>
                                                            <gradient:SfGradientStop Color="White" Offset="0.0"/>
                                                        </gradient:SfLinearGradientBrush.GradientStops>
                                                    </gradient:SfLinearGradientBrush>
                                                </gradient:SfGradientView.BackgroundBrush>
                                            </gradient:SfGradientView>-->
                                            <StackLayout Margin="10" Spacing="5" HorizontalOptions="Center" VerticalOptions="Center"  >
                                                <Image Source="{Binding iConImagePath}"  >
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTappedTest" NumberOfTapsRequired="1"></TapGestureRecognizer>
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                <Label HorizontalTextAlignment="Center"  TextColor="#006450" Style="{StaticResource LabelStyleFromCommonGrayStyle}" FontSize="9" >
                                                    <Label.FormattedText >
                                                        <FormattedString>
                                                            <Span Text="{Binding eServiceName}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTappedTest" NumberOfTapsRequired="1"></TapGestureRecognizer>
                                                    </Label.GestureRecognizers>
                                                </Label>
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTappedTest" NumberOfTapsRequired="1"></TapGestureRecognizer>
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                        </Grid>
                                    </cards:SfCardView.Content>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                        <!--Layout to customize number of columns in SfListView-->
                        <listView:SfListView.LayoutManager>
                            <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=3, Tablet=4, Desktop=5}" />
                        </listView:SfListView.LayoutManager>
                        <listView:SfListView.Behaviors>
                            <behavior:SfListViewExtendHeightBehavior ></behavior:SfListViewExtendHeightBehavior>
                        </listView:SfListView.Behaviors>
                    </listView:SfListView>
                </StackLayout>
            </ScrollView>
            <Grid Grid.Row="0" Grid.Column="0" RowSpacing="0" BackgroundColor="White">
                <Grid.RowDefinitions>
                    <RowDefinition  Height="50*"/>
                    <RowDefinition  Height="30*"/>
                    <RowDefinition  Height="20*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*"/>
                </Grid.ColumnDefinitions>
                <!--<Image Grid.Row="0" Grid.Column="0" BackgroundColor="White" Grid.RowSpan="3" Aspect="AspectFill" Source="sf_BannerImage.png" Margin="0,-5,0,0" ></Image>-->
                <border:SfBorder x:Name="border" Grid.Row="0" Grid.Column="0"  Grid.RowSpan="4"    BorderWidth="0">
                    <Grid Grid.Row="0" Grid.Column="0"  Grid.RowSpan="4">
                        <gradient:SfGradientView>
                            <gradient:SfGradientView.BackgroundBrush>
                                <gradient:SfLinearGradientBrush>
                                    <gradient:SfLinearGradientBrush.GradientStops>
                                        <gradient:SfGradientStop Color="#003228" Offset="0.0" />
                                        <gradient:SfGradientStop Color="#006450" Offset="1.0" />
                                    </gradient:SfLinearGradientBrush.GradientStops>
                                </gradient:SfLinearGradientBrush>
                            </gradient:SfGradientView.BackgroundBrush>
                        </gradient:SfGradientView>
                    </Grid>
                </border:SfBorder>

                <!--<controls:TapAnimationGrid Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" ColumnSpacing="0" Command="{Binding ShowOptionsCommand}"  RowSpacing="0" Tapped="False" VerticalOptions="Start" BackgroundColor="Transparent" HorizontalOptions="Start">-->
                <local1:CustomLabel Grid.Row="0" Grid.Column="0" Style="{StaticResource IconLabelStyle}" Text="{StaticResource BurgerMenu}" TextColor="White" HorizontalOptions="Start" VerticalOptions="Start" >
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowOptionsCommand}" >
                        </TapGestureRecognizer>
                    </Label.GestureRecognizers>
                </local1:CustomLabel>
                <!--</controls:TapAnimationGrid>-->
                <Image Grid.Row="0" Grid.Column="0" Aspect="AspectFit" Source="sf_ic_Dashboard_Logo_White.png" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,10,0,0" ></Image>
                <Label  Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" VerticalTextAlignment="Start" LineBreakMode="WordWrap"  HorizontalTextAlignment="Center"  TextColor="White" BindingContext="{Binding TaxPayerProfile}" LineHeight="{OnPlatform iOS=.7, Android=1}">
                    <Label.FormattedText >
                        <FormattedString>
                            <Span Text="{x:Static local:AppResources.Hi}" FontFamily="{StaticResource SSTArBold}"/>
                            <Span Text="{Binding Name}" TextColor="White"  FontFamily="{StaticResource SSTArBold}"/>
                            <!--<Span Text="&#10;"/>
                            <Span Text="{Binding Email}" TextColor="White"/>-->
                            <Span Text="&#10;"/>
                            <Span Text="{Binding Tin}" TextColor="White" FontFamily="{StaticResource SSTArBold}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>
            <Grid Grid.Row="0"  Grid.RowSpan="3" Grid.Column="0" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0"  Grid.RowSpan="2" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0"  Grid.RowSpan="2" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                        Title="{x:Static local:AppResources.ActivityIndicatorTitle}"
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#006450"/>
                    </StackLayout>
                </StackLayout>
            </Grid>
