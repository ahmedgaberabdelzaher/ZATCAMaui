                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.ZSadadInvoiceNumber}"></Span>
                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                                            <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding VTRE2}"></Span>
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
