                                                            <Image  Grid.Row="0"  Grid.Column="3" Grid.ColumnSpan="1" Grid.RowSpan="1"  Source="{Binding StatusImage}" HorizontalOptions="EndAndExpand" VerticalOptions="Start"/>
                                                            <!--<BoxView  
                     Grid.Row="0" Grid.Column="2" Grid.RowSpan="5" Margin="0" BackgroundColor="Gray" VerticalOptions="Fill" HorizontalOptions="Center" WidthRequest="1"/>-->


                                                        </Grid>
                                                    </StackLayout>
                                                </cards1:SfCardView>
                                            </ViewCell>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <local1:CustomLabel Margin="0,20,0,0" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" Text="{x:Static local:AppResources.NoBillsAvailable}" Style="{StaticResource MiniBlackLabelStyle}"  HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding SetNoDataLabelVisibilityUNPAID}">
                                </local1:CustomLabel>
                            </StackLayout>

                        </tabview:SfTabItem.Content>
                    </tabview:SfTabItem>
                    <tabview:SfTabItem Title="{x:Static local:AppResources.PartiallyPaid}"   
                             TitleFontSize="14"
                            SelectionColor="Black"
                             FontIconFontColor="#FF00AFF0"
                                   
                             TitleFontColor="Gray">

                        <tabview:SfTabItem.Content>

                            <StackLayout Margin="10,0,10,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <ListView  x:Name="BillsPartiallyPaid" 
           ItemsSource="{Binding MyBillsPartiallyPaid}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
                                           IsVisible="{Binding SetNoDataLabelVisibilityPPAIDList}"
                                            ItemTapped="Bills_ItemTapped"
                                           
            HasUnevenRows="True"
                 BackgroundColor="White"     
            SeparatorVisibility="None"
            >
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <cards1:SfCardView HasShadow="True" Margin="10" Opacity=".9" BorderWidth=".05" BorderColor="#5d6770"  ShadowColor="#5d6770" BackgroundColor="White" CornerRadius="3"  IndicatorColor="{Binding Colorcode}" IndicatorPosition="Left" IndicatorThickness="5" >

                                                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Margin="10,10,0,5" Padding="10" >
                                                        <Grid Style="{DynamicResource GridStyle}" ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White" >
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="39*" />
                                                                <ColumnDefinition Width="39*" />
                                                                <ColumnDefinition Width="15*" />
                                                                <ColumnDefinition Width="7*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Label Text="{Binding Txt30}" 
                                       
                                   Style="{StaticResource MicroGrayLabelStyleNew}"
                                                       HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                           Grid.ColumnSpan="2"/>

                                                            <Label  Margin="0" 
                                  
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                                                        Grid.ColumnSpan="2"
                                                           >
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.ZSadadInvoiceNumber}"></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding VTRE2}"></Span>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                            <Label  Margin="0" 
                                  
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                                           >
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.TaxType}"></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding Abtypt}"></Span>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>



                                                            <Label  Margin="0" 
                                  
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                                                        Grid.ColumnSpan="2"
                                                           >
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.DueAmount}"></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding TestDueAmount}"></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" "></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNewEn}"   Text="{x:Static local:AppResources.ZSAR} "/>

                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>




                                                            <Label  Margin="0" 
                                  
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="4"
                                   Grid.Column="0"
                                                                        Grid.ColumnSpan="2"
                                                           >
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}"  Text="{x:Static local:AppResources.DueDate}"></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNew}" Text=" : "></Span>
                                                                        <Span Style="{StaticResource MicroGrayLabelStyleNewEn}" Text="{Binding FAEDN, StringFormat='{}{0:yyyy}'}"></Span>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>



                                                            <Image  Grid.Row="1"  Grid.Column="2"  Grid.ColumnSpan="3" Grid.RowSpan="5"  Source="sf_Sadad_logo.png" HorizontalOptions="StartAndExpand" VerticalOptions="StartAndExpand"/>

                                                            <!--<StackLayout Grid.Row="1"  BackgroundColor="AliceBlue" Grid.Column="3" Grid.ColumnSpan="2" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.RowSpan="4" ></StackLayout>-->
                                                            <Image  Grid.Row="0"  Grid.Column="3" Grid.ColumnSpan="1" Grid.RowSpan="1"  Source="{Binding StatusImage}" HorizontalOptions="EndAndExpand" VerticalOptions="Start"/>
                                                            <!--<BoxView  
                     Grid.Row="0" Grid.Column="2" Grid.RowSpan="5" Margin="0" BackgroundColor="Gray" VerticalOptions="Fill" HorizontalOptions="Center" WidthRequest="1"/>-->


                                                        </Grid>
                                                    </StackLayout>
                                                </cards1:SfCardView>
                                            </ViewCell>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <local1:CustomLabel Margin="0,20,0,0" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" Text="{x:Static local:AppResources.NoBillsAvailable}" Style="{StaticResource MiniBlackLabelStyle}"  HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding SetNoDataLabelVisibilityPPAID}">
                                </local1:CustomLabel>
                            </StackLayout>

                        </tabview:SfTabItem.Content>
                    </tabview:SfTabItem>
                </tabview:SfTabView.Items>
            </tabview:SfTabView>

            <Grid Grid.Row="0"   Grid.Column="0" IsVisible="{Binding IsLoading}" >
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="RollingBall" 
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="Center"
                                           IsBusy="{Binding IsLoading}"
                                       ViewBoxWidth = "70" 
                                         Title="{x:Static local:AppResources.ActivityIndicatorTitle}"
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="Black"/>
                    </StackLayout>
                </StackLayout>
            </Grid>

        </Grid>

    </ContentPage.Content>
</ContentPage>