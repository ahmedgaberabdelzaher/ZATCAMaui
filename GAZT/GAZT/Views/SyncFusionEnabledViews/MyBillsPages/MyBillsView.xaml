<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local2="clr-namespace:GAZT.CustomControl"
             xmlns:local="clr-namespace:GAZT;assembly:GAZT"
             xmlns:chart="clr-namespace:Syncfusion.SfChart.XForms;assembly=Syncfusion.SfChart.XForms"
             xmlns:cards1="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:tabview="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:local1="clr-namespace:GAZT"
             xmlns:syncfusion="clr-namespace:Syncfusion.XForms.Expander;assembly=Syncfusion.Expander.XForms"
             FlowDirection="RightToLeft"
             Title="{x:Static local:AppResources.MyBills}"
             x:Class="GAZT.Views.MyBillsView"
              NavigationPage.HasNavigationBar="False">
    <!--<ContentPage.ToolbarItems>
        <ToolbarItem Icon="ic_bell.png" Order="Primary" Priority="0" Command="{Binding OnBellClicked}" />
    </ContentPage.ToolbarItems>-->
    <ContentPage.Resources>
        <ResourceDictionary>
            <local2:DataMarkerConverter x:Key="converter" />
            <ResourceDictionary Source="..\Common\Styles.xaml" />
        </ResourceDictionary>
    </ContentPage.Resources>


    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <!--  Title View  -->
                <controls:TitleView Title="{x:Static local:AppResources.MyBills}"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="{DynamicResource Gray-White} ">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.OnBackButtonClicked}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="#006450"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                            
                            
                             />
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>


    <ContentPage.Content>
        <Grid x:Name="ParentContainer">
            <Grid.RowDefinitions>
                <RowDefinition  Height="100*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>
            <tabview:SfTabView Margin="0,0,0,2" Grid.Row="0"  SelectionChanged="simTab_SelectionChanged"  Grid.Column="0" x:Name="simTab" SelectedIndex="{Binding SelcectedBillsIndex}" VisibleHeaderCount="4" >
                <tabview:SfTabView.SelectionIndicatorSettings>
                    <tabview:SelectionIndicatorSettings
                    Color="DarkGreen" 
                    Position="Bottom" 
                    StrokeThickness="2"/>
                </tabview:SfTabView.SelectionIndicatorSettings>
                <tabview:SfTabView.Items>
                    <tabview:SfTabItem Title="{x:Static local:AppResources.All}"   
                             TitleFontSize="14"
                            SelectionColor="Black"
                             FontIconFontColor="#FF00AFF0"
                                   
                             TitleFontColor="Gray">

                        <tabview:SfTabItem.Content>
                                 <StackLayout Margin="10,0,10,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                                    <!--<chart:SfChart HeightRequest="160">

                                <chart:SfChart.Series>
                                    <chart:PieSeries ItemsSource="{Binding ListMyBillsChartModel}"  XBindingPath="BillType" YBindingPath="BillCount"/>
                                </chart:SfChart.Series>
                            </chart:SfChart>-->
                                <syncfusion:SfExpander IsExpanded="True">
                                    <syncfusion:SfExpander.Header>
                                        <Grid>
                                            <Label TextColor="#495F6E" Margin="10,0,10,0"  Text=""  HeightRequest="50" VerticalTextAlignment="Center" />
                                        </Grid>
                                    </syncfusion:SfExpander.Header>
                                    <syncfusion:SfExpander.Content>
                                       
                                        <chart:SfChart x:Name="Chart" HorizontalOptions="FillAndExpand" IsVisible="{Binding SetNoDataLabelVisibilityALLList}"  VerticalOptions="FillAndExpand" SelectionChanged="Chart_SelectionChanged" AnnotationClicked="Chart_AnnotationClicked" LegendItemClicked="Chart_LegendItemClicked"  HeightRequest="210">
                                            <chart:SfChart.Title>
                                                <chart:ChartTitle Text="{x:Static local:AppResources.MyBills}"  />
                                            </chart:SfChart.Title>
                                            <!--<chart:SfChart.BindingContext>
                                    <sampleBrowser:PieSeriesViewModel />
                                </chart:SfChart.BindingContext>-->
                                            <!--<chart:SfChart.ChartBehaviors>
                                    <chart:ChartTooltipBehavior />
                                </chart:SfChart.ChartBehaviors>-->
                                            <chart:SfChart.Legend>
                                                <chart:ChartLegend IconHeight="14" IconWidth="14" OverflowMode="Wrap" DockPosition="Top" ToggleSeriesVisibility="False"/>
                                            </chart:SfChart.Legend>
                                            <chart:SfChart.Series>

                                                <chart:PieSeries x:Name="pieSeries" EnableDataPointSelection="true"   EnableAnimation="True" ExplodeOnTouch="True" ItemsSource="{Binding ListMyBillsChartModel,Mode=TwoWay}" XBindingPath="BillType" YBindingPath="BillCount" DataMarkerPosition="OutsideExtended">
                                                    <chart:PieSeries.ColorModel>
                                                        <chart:ChartColorModel Palette="Custom" CustomBrushes="{Binding Colors}">
                                                        </chart:ChartColorModel>
                                                    </chart:PieSeries.ColorModel>
                                                    <!--<chart:PieSeries.ColorModel>

                                                        <chart:ChartColorModel Palette="Custom">
                                                            <chart:ChartColorModel.CustomBrushes>   
                                                                <Color>

                                                                    #006450

                                                                </Color>

                                                                <Color>

                                                                    #AA0C19
                                                                </Color>

                                                                <Color>

                                                                    #D99A29

                                                                </Color>

                                                            </chart:ChartColorModel.CustomBrushes>
                                                        </chart:ChartColorModel>

                                                    </chart:PieSeries.ColorModel>-->

                                                    <chart:PieSeries.DataMarker>
                                                        <chart:ChartDataMarker >
                                                            <chart:ChartDataMarker.LabelTemplate>
                                                                <DataTemplate>
                                                                    <StackLayout Orientation="Vertical">
                                                                        <Label FontSize="12" TextColor="Black" HorizontalOptions="CenterAndExpand" Text="{Binding Converter={StaticResource converter}, ConverterParameter='Label'}"/>
                                                                        <Label FontSize="12" TextColor="Black" HorizontalOptions="CenterAndExpand" Text="{Binding Converter={StaticResource converter}}"/>
                                                                    </StackLayout>
                                                                </DataTemplate>
                                                            </chart:ChartDataMarker.LabelTemplate>
                                                            <chart:ChartDataMarker.LabelStyle>

                                                                <chart:DataMarkerLabelStyle LabelPosition="Auto"/>

                                                            </chart:ChartDataMarker.LabelStyle>
                                                        </chart:ChartDataMarker>
                                                    </chart:PieSeries.DataMarker>
                                                </chart:PieSeries>
                                            </chart:SfChart.Series>
                                        </chart:SfChart>
                                      
                                    </syncfusion:SfExpander.Content>
                                </syncfusion:SfExpander>
                                <ListView  x:Name="Bills" 
           ItemsSource="{Binding MyBills,Mode=TwoWay}"
                                           IsVisible="{Binding SetNoDataLabelVisibilityALLList}"
