<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
               xmlns:custom="clr-namespace:GAZT"
                FlowDirection="RightToLeft"
               xmlns:local="clr-namespace:GAZT;assembly:GAZT"
             Title="{x:Static local:AppResources.ZZCreateYourGAZTAccount}"
              xmlns:local1="clr-namespace:GAZT"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             x:Class="GAZT.Views.NewViews.CreateGaztAccountPageView">
    <ContentPage.Content>
        <StackLayout>
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"   Margin="0" Padding="0,10,0,10" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="90*" />
                    <RowDefinition Height="10*" />

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <ScrollView Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" >
                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"   Margin="0" Padding="0,10,0,10" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0"  Grid.Column="0" Grid.ColumnSpan="2"   Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start"  >
                            <Label.FormattedText>
                                <FormattedString>

                                    <Span  Text="{x:Static local:AppResources.ZZPasswordregulationsforSignup}" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                     
                        <inputLayout:SfTextInputLayout   x:Name="frmPass"  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.Password}" HelperText="{x:Static local:AppResources.ZZZRequired}"
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                            <Entry Text="{Binding TxtPassword}"  x:Name="EntryPass"  FontSize="Small" IsPassword="True">
                               
                            </Entry>
                        </inputLayout:SfTextInputLayout>


                        <inputLayout:SfTextInputLayout   x:Name="frmCfrmPass"  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZZConfirmpassword}" HelperText="{x:Static local:AppResources.ZZZRequired}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                            <Entry TextChanged="EntryCfrmPass_TextChanged" Text="{Binding TxtConfirmPassword}" IsPassword="True"  x:Name="EntryCfrmPass"  FontSize="Small">
                          
                            </Entry>
                        </inputLayout:SfTextInputLayout>
                        <inputLayout:SfTextInputLayout  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZZEmailAddress}" HelperText="{x:Static local:AppResources.ZZZRequired}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                            <Entry  Text="{Binding TxtEmailAddress}"  IsEnabled="False" FontSize="Small">
                           
                            </Entry>
                        </inputLayout:SfTextInputLayout>


                        <inputLayout:SfTextInputLayout  Grid.Row="4" Grid.Column="0" x:Name="frmEmailCode"  Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZZConfirmationcodesenttoemailaddress}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1" HelperText="{x:Static local:AppResources.ZZZRequired}"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                            <Entry  Text="{Binding TxtEmailCode}" IsPassword="True" Keyboard="Numeric" FontSize="Small" IsEnabled="{Binding IsOTPEntryEnable}">
                                <Entry.Behaviors>
                                    <custom1:OnlyNumericValuesBehaviour/>
                                </Entry.Behaviors>
                            </Entry>
                        </inputLayout:SfTextInputLayout>

                        <inputLayout:SfTextInputLayout  Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZZMobileNumber}" HelperText="{x:Static local:AppResources.ZZZRequired}"
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                            <Entry  Text="{Binding TxtMobileNumber}"  IsEnabled="False" FontSize="Small">

                            </Entry>
                        </inputLayout:SfTextInputLayout>
                        <inputLayout:SfTextInputLayout  Grid.Row="6" Grid.Column="0" x:Name="frmMobileCode"  Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZZConfirmationcodesenttoMobileNumber}" HelperText="{x:Static local:AppResources.ZZZRequired}"
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                            <Entry  Text="{Binding TxtMobileNumberCode}" IsPassword="True" Keyboard="Numeric" FontSize="Small" IsEnabled="{Binding IsOTPEntryEnable}">
                                <Entry.Behaviors>
                                    <custom1:OnlyNumericValuesBehaviour/>
                                </Entry.Behaviors>
                            </Entry>
                        </inputLayout:SfTextInputLayout>


                        <!--ZZZVerificationsCode-->

                        <Label Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="StartAndExpand"  Margin="10,0,10,0">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span  Text="{x:Static local:AppResources.ZZThecodewillbeexpiredwithin}"  Style="{StaticResource InformationGrayColorLabel}"   />
                                    <Span  Text="{Binding OTPValidDuration}" FontFamily="{StaticResource SSTArBold}" Style="{StaticResource InformationRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label> <!--ZZResendtheverificationcode-->
                        <Button Text="{x:Static local:AppResources.ZZResendtheverificationcode}" HeightRequest="56"  Command="{Binding OnResendOTPClicked}" VerticalOptions="StartAndExpand" Margin="0" CornerRadius="0" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTVerifyButton}" BackgroundColor="{Binding ButtonDisableColor}" IsEnabled="{Binding IsResendOTPEnabled}"></Button>

                    </Grid>
                </ScrollView>
                <StackLayout Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"  Margin="0,0,0,-15"  BackgroundColor="White">
                    <Button Text="{x:Static local:AppResources.ZZSubmit}" HeightRequest="56" Style="{StaticResource GAZTVerifyButton}" CornerRadius="0" VerticalOptions="EndAndExpand" x:Name="btnSubmit" Clicked="btnSubmit_Clicked" IsEnabled="{Binding IsVerifyOTPEnabled}" BackgroundColor="{Binding VerifyButtonDisableColor}" Margin="0" ></Button>

                </StackLayout>
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>