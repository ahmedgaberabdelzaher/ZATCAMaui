<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
               xmlns:custom="clr-namespace:GAZT"
                FlowDirection="RightToLeft"
               xmlns:local="clr-namespace:EGAZT;assembly:GAZT"
             Title="{x:Static local:AppResources.ZZCreateYourGAZTAccount}"
              xmlns:local1="clr-namespace:GAZT"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.CreateGaztAccount.CreateGaztAccountPageView"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
            <ControlTemplate>
                <StackLayout Spacing="0">
                <controls:TitleView Title="{x:Static local:AppResources.ZZCreateYourGAZTAccount}"  FontSize="14"  FontFamily="{StaticResource GAZT_FONT_BOLD}" BackgroundColor="{DynamicResource Gray-White} ">
                        <controls:TitleView.LeadingView>
                            <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.GoBackClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            TextColor="#006450"
                            Style="{StaticResource IconButtonStyle}"
                             Text="{DynamicResource StyleReverseBack}"
                             />
                        </controls:TitleView.LeadingView>
                    </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
                </StackLayout>
            </ControlTemplate>
        </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <StackLayout Spacing="0">
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"    Margin="0" Padding="0,0,0,0" RowSpacing="10" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="75*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <ScrollView Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" BackgroundColor="White"  >
                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" RowSpacing="15"  Margin="0" Padding="0,10,0,10" BackgroundColor="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <custom:CustomLabel Grid.Row="0"  Grid.Column="0" Grid.ColumnSpan="2"  FontFamily="{StaticResource GAZT_FONT_BOLD}"  Style="{StaticResource GAZTSmallGreenLabelStyle}"  HorizontalOptions="Start"  >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span  Text="{x:Static local:AppResources.ZZPasswordregulationsforSignup}" FontSize="14" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </custom:CustomLabel>
                        <inputLayout:SfTextInputLayout   x:Name="frmPass"  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.Password}" HelperText="{x:Static local:AppResources.ZZZRequired}"
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <Entry Text="{Binding TxtPassword}" TextChanged="EntryPass_TextChanged"  x:Name="EntryPass"  FontSize="Small" IsPassword="True">
                            </Entry>
                        </inputLayout:SfTextInputLayout>
                        <inputLayout:SfTextInputLayout   x:Name="frmCfrmPass"  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZZConfirmpassword}" HelperText="{x:Static local:AppResources.ZZZRequired}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <Entry TextChanged="EntryCfrmPass_TextChanged" Text="{Binding TxtConfirmPassword}" IsPassword="True"  x:Name="EntryCfrmPass"  FontSize="Small">
                            </Entry>
                        </inputLayout:SfTextInputLayout>
                        <inputLayout:SfTextInputLayout  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZZEmailAddress}" HelperText="{x:Static local:AppResources.ZZZRequired}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <Entry  Text="{Binding TxtEmailAddress}"  IsEnabled="False" FontSize="Small">
                            </Entry>
                        </inputLayout:SfTextInputLayout>
                        <inputLayout:SfTextInputLayout  Grid.Row="4" Grid.Column="0" x:Name="frmEmailCode"  Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZZConfirmationcodesenttoemailaddress}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1" HelperText="{x:Static local:AppResources.ZZZRequired}"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <Entry  Text="{Binding TxtEmailCode}" x:Name="ConfrmEmail_Entry" IsPassword="True" Keyboard="Numeric" FontSize="Small" IsEnabled="{Binding IsOTPEntryEnable}" MaxLength="4">
                                <Entry.Behaviors>
                                    <custom1:OnlyNumericValuesBehaviour/>
                                </Entry.Behaviors>
                            </Entry>
                        </inputLayout:SfTextInputLayout>
                        <inputLayout:SfTextInputLayout  Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZZMobileNumber}" HelperText="{x:Static local:AppResources.ZZZRequired}"
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <Entry  Text="{Binding TxtMobileNumber}"  IsEnabled="False" FontSize="Small">
                            </Entry>
                        </inputLayout:SfTextInputLayout>
                        <inputLayout:SfTextInputLayout  Grid.Row="6" Grid.Column="0" x:Name="frmMobileCode"  Grid.ColumnSpan="2"  Margin="10,-6,10,-6"
    Hint="{x:Static local:AppResources.ZZConfirmationcodesenttoMobileNumber}" HelperText="{x:Static local:AppResources.ZZZRequired}"
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False" >
                            <Entry  Text="{Binding TxtMobileNumberCode}" x:Name="CnfrmMob_entry" IsPassword="True" Keyboard="Numeric" FontSize="Small" IsEnabled="{Binding IsOTPEntryEnable}" MaxLength="4">
                                <Entry.Behaviors>
                                    <custom1:OnlyNumericValuesBehaviour/>
                                </Entry.Behaviors>
                            </Entry>
                        </inputLayout:SfTextInputLayout>
                        <!--ZZZVerificationsCode-->
                        <Label Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="StartAndExpand"  Margin="10,0,10,0">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span  Text="{x:Static local:AppResources.ZZThecodewillbeexpiredwithin}"  FontSize="10" FontFamily="{StaticResource GAZT_FONT_BOLD}" Style="{StaticResource InformationGrayColorLabel}"   />
                                    <Span  Text="{Binding OTPValidDuration}" FontFamily="{StaticResource SSTArBold}"  FontSize="10" Style="{StaticResource InformationRedColorLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <!--ZZResendtheverificationcode-->
                    </Grid>
                </ScrollView>
                <Grid Grid.Row="0"    Grid.Column="0" Grid.ColumnSpan="2"  IsVisible="{Binding IsLoading}" >
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                    </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <!--<ActivityIndicator IsVisible="true" IsRunning="true" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Color="White" />
                        <Label Text="{x:Static local:AppResources.ActivityIndicatorTitle}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" />-->
                            <!--<busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                        Title="{x:Static local:AppResources.ActivityIndicatorTitle}"
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#006450"/>-->
                        </StackLayout>
                    </StackLayout>
                </Grid>
                <StackLayout Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" VerticalOptions="End"  Margin="0,0,0,0"  BackgroundColor="White" Orientation="Vertical">
                    <Button Text="{x:Static local:AppResources.ZZResendtheverificationcode}" HeightRequest="56"  Command="{Binding OnResendOTPClicked}" VerticalOptions="StartAndExpand" Margin="0" CornerRadius="0"   BackgroundColor="{Binding ButtonDisableColor}" IsEnabled="{Binding IsResendOTPEnabled}" FontAttributes="Bold" Opacity="0.7" TextColor="{Binding ButtonDisableTextColor}"></Button>
                    <Button x:Name="btnSubmitNext" Text="{x:Static local:AppResources.ZZSubmit}" CornerRadius="0" HeightRequest="56" Clicked="btnSubmit_Clicked" VerticalOptions="End" IsEnabled="{Binding IsVerifyOTPEnabled}"  Margin="0" FontSize="15"     BackgroundColor="{Binding VerifyButtonDisableColor}" Opacity="0.7"  FontAttributes="Bold" TextColor="{Binding VerifyButtonDisableTextColor}" />
                </StackLayout>
                <Grid Grid.Row="0" Grid.RowSpan="2"   Grid.Column="0" Grid.ColumnSpan="2"  IsVisible="{Binding IsLoading}" >
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                    </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <!--<ActivityIndicator IsVisible="true" IsRunning="true" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Color="White" />
                        <Label Text="{x:Static local:AppResources.ActivityIndicatorTitle}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" />-->
                            <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                        
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#006450"/>
                        </StackLayout>
                        <!--Title="{x:Static local:AppResources.ActivityIndicatorTitle}"-->
                    </StackLayout>
                </Grid>

            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>