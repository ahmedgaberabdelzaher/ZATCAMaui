                                        </Grid.ColumnDefinitions>
                                        <Frame Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"    Style="{StaticResource GAZTFrameStyleEntryForLableBackground}"   >
                                        </Frame>
                                        <Label Text="{x:Static custom2:AppResources.ZVatTaxReturnDetails}"   VerticalOptions="Center" HorizontalOptions="CenterAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}"  FontFamily="{StaticResource GAZT_FONT_BOLD}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" >
