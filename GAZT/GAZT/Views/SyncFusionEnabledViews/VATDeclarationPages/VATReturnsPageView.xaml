<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:local1="clr-namespace:GAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:local="clr-namespace:EGAZT;assembly:GAZT"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:tabView="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:custom2="clr-namespace:EGAZT"
             mc:Ignorable="d"
             Title="{x:Static custom2:AppResources.VATDeclaration}"
             x:Class="EGAZT.Views.SyncFusionEnabledViews.VATReturnsPage.VATReturnsPageView"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White" >
    <ContentPage.Resources>
        <ResourceDictionary>
            <custom1:DecimalPlacesConverter x:Key="DecimalPlacesConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <!--<ContentPage.ToolbarItems>
        --><!--<ToolbarItem IconImageSource="ic_save.png"  
                Priority="0" Order="Primary" Command="{Binding OnSaveAsDraftClicked}" />-->
        <!--<ToolbarItem IconImageSource="ic_validation.png" x:Name="ICvalidation" 
                Priority="1" Order="Primary"   />--><!--
        <ToolbarItem IconImageSource="ic_more_options.png"  
                Priority="2" Order="Primary" Clicked="onMoreOptionClicked" />
    </ContentPage.ToolbarItems>-->
    <ContentPage.Content>
        <Grid x:Name="ParentContainerForVAT" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
            <Grid.RowDefinitions>
                <RowDefinition Height="100*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackLayout Grid.Row="0" Grid.Column="0">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"   x:Name="MainGrid"  ColumnSpacing="0" RowSpacing="0" Margin="0" Padding="0,0,0,10" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <tabView:SfTabView BackgroundColor="White"  Grid.Column="0"  TabItemTapped="SfTabView_TabItemTapped" Grid.Row="0" Grid.ColumnSpan="2" VerticalOptions="FillAndExpand" x:Name="SfTabView"  SelectedIndex="{Binding SelectedIndex,Mode=TwoWay}" SelectionChanged="SfTabView_SelectionChanged">
                        <tabView:SfTabView.SelectionIndicatorSettings>
                            <tabView:SelectionIndicatorSettings
                    Color="DarkGreen"
                    Position="Bottom"
                    StrokeThickness="2"/>
                        </tabView:SfTabView.SelectionIndicatorSettings>
                        <tabView:SfTabItem Title="{x:Static custom2:AppResources.ZZInstruction}" 
                            SelectionColor="DarkGreen"
                             FontIconFontColor="#FF00AFF0"
                             TitleFontColor="Gray"
                             TitleFontFamily="{StaticResource GAZT_FONT_MEDIUM}">
                            <tabView:SfTabItem.Content>
                                <ScrollView HorizontalOptions="FillAndExpand" x:Name="TabInstruction"  IsVisible="{Binding IsVisibleInstrunction}"  VerticalOptions="FillAndExpand"  >
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="0" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="15*"/>
                                            <ColumnDefinition Width="85*"/>
                                        </Grid.ColumnDefinitions>
                                        <Frame Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"   Style="{StaticResource GAZTFrameStyleEntryForLableBackground}"   >
                                        </Frame>
                                        <Label Text="{x:Static custom2:AppResources.ZInstructions}"   VerticalOptions="Center" HorizontalOptions="CenterAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}"  FontFamily="{StaticResource GAZT_FONT_BOLD}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" >
                                        </Label>
                                        <Label Text="{x:Static custom2:AppResources.ZVatReadInstructions}"  Grid.Row="1" Grid.Column="0"  Grid.ColumnSpan="2"  HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                                        <local1:CustomLabel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                            <local1:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="1."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                    <Span Text="{x:Static custom2:AppResources.ZZPleasefilltherequestedinformationforeachstep}"  FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                </FormattedString>
                                            </local1:CustomLabel.FormattedText>
                                        </local1:CustomLabel>
                                        <local1:CustomLabel  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2"  HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                            <local1:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="2."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                    <Span Text="{x:Static custom2:AppResources.ZVatSubmittedInstructions}" FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                </FormattedString>
                                            </local1:CustomLabel.FormattedText>
                                        </local1:CustomLabel>
                                        <local1:CustomLabel   Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                            <local1:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="3."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                    <Span Text="{x:Static custom2:AppResources.ZVatDateInstructions}" FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                </FormattedString>
                                            </local1:CustomLabel.FormattedText>
                                        </local1:CustomLabel>
                                        <local1:CustomLabel  Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource MicroGrayLabelStyleNewEn}">
                                            <local1:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="4."  FontFamily="{StaticResource SSTArLight}" FontSize="11"/>
                                                    <Span Text="{x:Static custom2:AppResources.ZVatFaqSectionInstructions}" FontFamily="{StaticResource GAZT_FONT_REGULAR}" FontSize="11"/>
                                                    <!--<Span Text="{x:Static custom2:AppResources.ZVatClickFaqInstructions}" >
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"></TapGestureRecognizer>
                                            </Span.GestureRecognizers>
                                        </Span>-->
                                                </FormattedString>
                                            </local1:CustomLabel.FormattedText>
                                        </local1:CustomLabel>
                                        <Label Grid.Row="6" Text="{x:Static custom2:AppResources.ZVatClickFaqInstructions}" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,2" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"  FontFamily="{StaticResource GAZT_FONT_REGULAR}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.onFaqSectionClicked}"></TapGestureRecognizer>
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <CheckBox x:Name="chkDeclaration" IsChecked="{Binding IsDeclarationCheckedForInstruction}" VerticalOptions="CenterAndExpand"  IsEnabled="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsDeclarationCheckEnabled}"  Grid.Row="7" Margin="10,0,10,0" Grid.Column="0">
                                            <CheckBox.Triggers>
                                                <DataTrigger TargetType="CheckBox" Binding="{Binding Source={x:Reference chkDeclaration}, Path=IsChecked}" Value="false">
                                                    <Setter Property="Color" Value="#ff0000" />
                                                </DataTrigger>
                                            </CheckBox.Triggers>
                                        </CheckBox>
                                        <local1:CustomLabel  Grid.Row="7" Grid.Column="1"  Margin="0,0,0,5"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}">
                                            <local1:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static custom2:AppResources.ZVatDeclarationInstructions}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}" FontSize="12"/>
                                                </FormattedString>
                                            </local1:CustomLabel.FormattedText>
                                        </local1:CustomLabel>
                                        <!--<Label Text="00000000000.00" Grid.Row="2" Grid.Column="1"    HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"   Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>
                            <Label Text="Zakat Amount" Grid.Row="3" Grid.Column="0"  HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"/>
                            <Label Text="SAR 00000000000.00" Grid.Row="3" Grid.Column="1"    HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"   Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"/>
                            <Label Text="By Paying the invoice,GAZT Zakat Certificate will be issued to you automatically in case there are no other outstanding obligation,paying the invoice means you conform the correctness of the return information." Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"  HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand" Margin="10"  Style="{StaticResource GAZTGreenLabelStyleForDashboardIcon}"/>
                            <Button Text="Copy SADAD Payment Number" Command="{Binding OnCopySadadNumberButtonClicked}" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource GAZTVerifyButton}"></Button>
                            <Button Text="Pay by MADA" Command="{Binding OnPayByMadaButtonClicked}" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTVerifyButton}"></Button>-->
                                    </Grid>
                                </ScrollView>
                            </tabView:SfTabItem.Content>
                        </tabView:SfTabItem>
