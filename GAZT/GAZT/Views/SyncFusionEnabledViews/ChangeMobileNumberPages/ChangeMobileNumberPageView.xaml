<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:local="clr-namespace:GAZT;assembly:GAZT"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:converter="clr-namespace:GAZTeServicesApp.Converters"
             xmlns:core="clr-namespace:Syncfusion.XForms.Core;assembly=Syncfusion.Core.XForms"
             xmlns:gradient="clr-namespace:Syncfusion.XForms.Graphics;assembly=Syncfusion.Core.XForms"
             xmlns:controls="clr-namespace:GAZTeServicesApp.Controls"
             x:Class="GAZT.Views.NewViews.ChangeMobileNumberPageView"
             Title="{x:Static local:AppResources.ChangeMobileNumber}"
             NavigationPage.HasNavigationBar="False"
             Style="{StaticResource ContentPageStyle}"
              BackgroundImageSource="{core:OnPlatformOrientationStringValue Default=sf_LoginBackground.png,
                                                                  iOSPhoneLandscape=sf_LoginBackground-Landscape.png,
                                                                  iOSTabletLandscape=sf_LoginBackground-Landscape.png}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary>
                <ResourceDictionary Source="..\CommonStyle\Styles.xaml" />
            </ResourceDictionary>-->
            <converter:BooleanToColorConverter x:Key="ColorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </ContentPage.Resources>



    <ContentPage.Content>
        <Grid x:Name="ParentContainerForChangeMobileNumber" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >

            <custom:CustomLabel
                x:Name="BackLabel"
                       VerticalOptions="StartAndExpand"
                HorizontalOptions="StartAndExpand"
                        Margin="8,10,8,0"
                        Style="{StaticResource IconLabelStyle}"
                         TextColor="#ffffff"
                        Text="{DynamicResource StyleReverseBack}"
               
                >
                <custom:CustomLabel.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackButtonClicked}"></TapGestureRecognizer>
                </custom:CustomLabel.GestureRecognizers>
            </custom:CustomLabel>

            <gradient:SfGradientView Style="{StaticResource SfGradientViewStyle}" />


            <StackLayout   Margin="{core:OnPlatformOrientationThickness PhonePortrait='20,32',
                                                                 PhoneLandscape='150,32',
                                                                 TabletPortrait='200,50',
                                                                 TabletLandscape='300,50',
                                                                 Desktop='30'}"  WidthRequest="{OnPlatform Default='-1',
                                              UWP='350'}" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" Orientation="Vertical"  IsVisible="{Binding OTPLayoutVisibility}" BackgroundColor="Transparent" Padding="0,10,0,0">


                <ScrollView HorizontalOptions="Center">
                    <ScrollView.VerticalOptions>
                        <OnIdiom
                        x:TypeArguments="LayoutOptions"
                        Default="CenterAndExpand"
                        Phone="FillAndExpand" />
                    </ScrollView.VerticalOptions>
                    <Grid Grid.Row="0" Grid.Column="0" RowSpacing="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25*"/>
                            <ColumnDefinition Width="61*"/>
                            <ColumnDefinition Width="14*"/>
                        </Grid.ColumnDefinitions>

                        <Label Text="{x:Static local:AppResources.ChangeMobileNumber}" TextColor="#ffffff" Style="{StaticResource LabelStyle}" FontFamily="{StaticResource GAZT_FONT_BOLD}" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"/>


                        <inputLayout:SfTextInputLayout x:Name="LayoutCurrentMobile"   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"    Margin="10,-6,10,-6"
   
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                            <custom:GAZTBorderlessEntry  x:Name="TCurrentMobile" TextColor="#ffffff" FontSize="Small"  Placeholder="{Binding CurrentMobile}" PlaceholderColor= "White"  IsEnabled="False">
                            </custom:GAZTBorderlessEntry>
                        </inputLayout:SfTextInputLayout>



                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"   IsVisible="{Binding NewMobileNumberEnglishLayout}">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20*"></ColumnDefinition>
                                <ColumnDefinition Width="80*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            
                            <Label  Text="{Binding CountryCode}" Grid.Row="0" Grid.Column="0" TextColor="#D99A29" FontSize="Medium"  VerticalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"></Label>


                            <!--<inputLayout:SfTextInputLayout VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"  x:Name="CountryCodeLayout"  Grid.Row="1" Grid.Column="0"   Margin="10,-6,10,-6"
   
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                        <Label  Text="{Binding CountryCode}" Padding="0,14,0,14"  VerticalTextAlignment="Center"  HorizontalOptions="CenterAndExpand" TextColor="#7D858D" FontSize="Small" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"></Label>
                    </inputLayout:SfTextInputLayout>-->

                            <inputLayout:SfTextInputLayout Grid.Row="0" Grid.Column="1"  x:Name="NewMobileNumberLayout"  Margin="7,0,7,0"
    Hint="{x:Static local:AppResources.EnterNewMobileNumber}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >

                                <custom:GAZTBorderlessEntry Text="{Binding NewMobile}" VerticalTextAlignment="Center" TextColor="White" x:Name="Username" Keyboard="Numeric" FontSize="Small" >
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <custom:MobileNumberValidatorBehaviour/>
                                    </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                        </Grid>


                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"   IsVisible="{Binding NewMobileNumberArabicLayout}">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80*"></ColumnDefinition>
                                <ColumnDefinition Width="20*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <!--<inputLayout:SfTextInputLayout VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"  x:Name="CountryCodeLayout"  Grid.Row="1" Grid.Column="0"   Margin="10,-6,10,-6"
   
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >
                        <Label  Text="{Binding CountryCode}" Padding="0,14,0,14"  VerticalTextAlignment="Center"  HorizontalOptions="CenterAndExpand" TextColor="#7D858D" FontSize="Small" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"></Label>
                    </inputLayout:SfTextInputLayout>-->

                            <inputLayout:SfTextInputLayout Grid.Row="0" Grid.Column="0"  x:Name="NewMobileNumberLayoutForArabic" FlowDirection="LeftToRight"  Margin="7,0,7,0"
    Hint="{x:Static local:AppResources.EnterNewMobileNumber}" 
    ContainerType="Outlined" UnfocusedColor="#B1B1B1"
    OutlineCornerRadius="8" ErrorColor="#B00020" HasError="False" >

                                <custom:GAZTBorderlessEntry Text="{Binding NewMobile}" VerticalTextAlignment="Center"  TextColor="White" x:Name="UsernameForArabic" Keyboard="Numeric" FontSize="Small" >
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <custom:MobileNumberValidatorBehaviour/>
                                    </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>

                            <Label  Text="{Binding CountryCode}" Grid.Row="0" Grid.Column="1" TextColor="#D99A29" FontSize="Medium"  VerticalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"></Label>


                        </Grid>








                        <!-- Acticity indicator layout start -->
                        <!--
                        <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                            <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.7" VerticalOptions="FillAndExpand">
                            </StackLayout>
                            <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                                <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                    <ActivityIndicator IsVisible="true" IsRunning="true" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Color="White" />
                                    <Label Text="{x:Static local:AppResources.ActivityIndicatorTitle}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" />
                                </StackLayout>
                            </StackLayout>
                        </Grid>
                        -->
                        <!-- Acticity indicator layout End -->
                    </Grid>

                </ScrollView>
            </StackLayout>
            <StackLayout     HorizontalOptions="FillAndExpand" VerticalOptions="EndAndExpand" Margin="0" Padding="0"  Orientation="Vertical">
                <buttons:SfButton
                    Margin="0"
                    VerticalOptions="EndAndExpand"
                HorizontalOptions="FillAndExpand"
                   BackgroundColor="#D99A29"
                            Opacity="0.7"
                   FontFamily="{StaticResource GAZT_FONT_BOLD}"
                    HeightRequest="56"
                    CornerRadius="0"
                  Command="{Binding OnVerifyButtonClicked}"
                    IsEnabled="{Binding IsVerifyOTPEnabled}"
                    Text="{x:Static local:AppResources.ZUpdateMobile}"
                    TextColor="{DynamicResource Gray-White}"
                     />
            </StackLayout>
        </Grid>

    </ContentPage.Content>
</ContentPage>