<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"  xmlns:local="clr-namespace:GAZT;assembly:GAZT" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"      xmlns:skia="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms" x:Class="GAZT.Views.OTPView" Title="OTPView">
    <ContentPage.Content>
         <Grid RowSpacing="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
             <Grid.RowDefinitions>
            <RowDefinition Height="42*" />
            <RowDefinition Height="4*" />
                            <RowDefinition Height="7*" />
            <RowDefinition Height="4*" />
                            <RowDefinition Height="9*" />
            <RowDefinition Height="4*" />
                  <RowDefinition Height="30*" />
                          

                
        </Grid.RowDefinitions>
 <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="13*"/>
                 <ColumnDefinition Width="16*"/>
                <ColumnDefinition Width="3*"/>
                 <ColumnDefinition Width="16*"/>
                                <ColumnDefinition Width="3*"/>
                 <ColumnDefinition Width="16*"/>
                                <ColumnDefinition Width="3*"/>
                 <ColumnDefinition Width="16*"/>
                 <ColumnDefinition Width="14*"/>
                </Grid.ColumnDefinitions>
            
       
        <skia:SKCanvasView x:Name="canvasView"
                         Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="10"
                           PaintSurface="OnCanvasViewPaintSurface" />
           
                
             <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="10" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
             <Grid.RowDefinitions>
            <RowDefinition Height="27*" />
            <RowDefinition Height="53*" />
                           
                            <RowDefinition Height="20*" />
        </Grid.RowDefinitions>
 <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*"/>
              
                </Grid.ColumnDefinitions>
                
                <Image Source="ic_logo.png" Grid.Row="1" Grid.Column="0"  HorizontalOptions="Center" VerticalOptions="Start" Aspect="AspectFit"/>
                
                </Grid>
            
            <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="10" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                <Image Source="ic_logo.png" Aspect="AspectFit"/>
            </StackLayout>
                     <StackLayout Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="8" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                
                <local:CustomLabel Text="{x:Static local:AppResources.OTPSentInformation}" Style="{StaticResource SmallGoldLabelStyle}"   HorizontalOptions="Center" VerticalOptions="Center" TextColor="#c49b2d"/>
            </StackLayout>
            <Frame x:Name="OTPOne" Grid.Row="4" Grid.Column="1"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BorderColor="#c49b2d" OutlineColor="#c49b2d" CornerRadius="6" HasShadow="false" >

            </Frame>
                                                     <local:BorderlessEntry x:Name="OTPEEntryOne" Grid.Row="4" Grid.Column="1"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="2" BackgroundColor="White"/>

              
              <Frame x:Name="OTPTwo" Grid.Row="4" Grid.Column="3"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BorderColor="#c49b2d" OutlineColor="#c49b2d" CornerRadius="6" HasShadow="false" >

            </Frame>
                                                     <local:BorderlessEntry x:Name="OTPEEntryTwo" Grid.Row="4" Grid.Column="3"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="2" BackgroundColor="White"/>
                                                     
            
              <Frame x:Name="OTPThree" Grid.Row="4" Grid.Column="5"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BorderColor="#c49b2d" OutlineColor="#c49b2d" CornerRadius="6" HasShadow="false" >

            </Frame>
                                                     <local:BorderlessEntry x:Name="OTPEEntryThree" Grid.Row="4" Grid.Column="5"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="2" BackgroundColor="White"/>
                                                     
            
              <Frame x:Name="OTPFour" Grid.Row="4" Grid.Column="7"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BorderColor="#c49b2d" OutlineColor="#c49b2d" CornerRadius="6" HasShadow="false" >

            </Frame>
                                                     <local:BorderlessEntry x:Name="OTPEEntryFour" Grid.Row="4" Grid.Column="7"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="2" BackgroundColor="White"/>
                                                     
            
            
            </Grid>
    </ContentPage.Content>
</ContentPage>
