<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:local="clr-namespace:GAZT;assembly:GAZT" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:skia="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms" xmlns:local1="clr-namespace:GAZT" x:Class="GAZT.Views.OTPView"  FlowDirection="RightToLeft" BackgroundColor="White">
    <ContentPage.Content>
        <StackLayout>
            <Grid RowSpacing="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="37.46*" />
                    <RowDefinition Height="4.25*" />
                    <RowDefinition Height="7.45*" />
                    <RowDefinition Height="4.25*" />
                    <RowDefinition Height="9.58*" />
                    <RowDefinition Height="4.25*" />
                    <RowDefinition Height="8.41*" />
                    <RowDefinition Height="24.35*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="18*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="18*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="18*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="18*" />
                    <ColumnDefinition Width="19*" />
                </Grid.ColumnDefinitions>
                <skia:SKCanvasView Margin="0,-2,0,0" x:Name="canvasView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="10" PaintSurface="OnCanvasViewPaintSurface" />
                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="10" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="15*" />
                        <RowDefinition Height="55*" />
                        <RowDefinition Height="30*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ic_logo.png" Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Start" Aspect="AspectFit" />
                </Grid>
                <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="10" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Image Source="ic_logo.png" Aspect="AspectFit" />
                </StackLayout>
              
                <!--<Image Source="ic_OTP_Rectangle.png" x:Name="OTPOne" Grid.Row="4" Grid.Column="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Aspect="AspectFit" >
                </Image>
               
                <local1:BorderlessEntry Keyboard="Numeric"  x:Name="OTPEEntryOne" Grid.Row="4" Grid.Column="1" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" VerticalOptions="FillAndExpand" Margin="2" BackgroundColor="Transparent" />-->
                               <Image Source="ic_OTP_Rectangle.png" x:Name="OTPOne" Grid.Row="4" Grid.Column="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                </Image>
                <local1:BorderlessEntry Text="" Keyboard="Numeric" x:Name="OTPEEntryOne" Grid.Row="4" Grid.Column="1" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" VerticalOptions="FillAndExpand" Margin="2" BackgroundColor="Transparent" />
              
                
                 <Image Source="ic_OTP_Rectangle.png" x:Name="OTPTwo" Grid.Row="4" Grid.Column="3" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                </Image>
                <local1:BorderlessEntry Text="" Keyboard="Numeric" x:Name="OTPEEntryTwo" Grid.Row="4" Grid.Column="3" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" VerticalOptions="FillAndExpand" Margin="2" BackgroundColor="Transparent" />
                
                 <Image Source="ic_OTP_Rectangle.png"  x:Name="OTPThree" Grid.Row="4" Grid.Column="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                </Image>
                <local1:BorderlessEntry Text="" x:Name="OTPEEntryThree" Keyboard="Numeric" Grid.Row="4" Grid.Column="5" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" VerticalOptions="FillAndExpand" Margin="2" BackgroundColor="Transparent" />

                  <Image Source="ic_OTP_Rectangle.png"  x:Name="OTPFour" Grid.Row="4" Grid.Column="7" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                </Image>
                <local1:BorderlessEntry Text="" x:Name="OTPEEntryFour" Keyboard="Numeric" Grid.Row="4" Grid.Column="7" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" VerticalOptions="FillAndExpand" Margin="2" BackgroundColor="Transparent" />


                 <!--<Image Source="ic_OTP_Rectangle.png"  x:Name="OTPFour" Grid.Row="4" Grid.Column="7" HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit" >
                </Image>
                <local1:BorderlessEntry Text="" x:Name="OTPEEntryFour" StyleId="OTPEntry" Keyboard="Numeric" Grid.Row="4" Grid.Column="7" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" VerticalOptions="FillAndExpand" Margin="2" BackgroundColor="Transparent" />-->
                <Frame HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="7" HasShadow="false" CornerRadius="4" BackgroundColor="#005e4b" Margin="0,0,0,0">
                </Frame>
                <local1:CustomLabel Text="Validate OTP" Style="{StaticResource SmallWhiteLabelStyle}" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="7" HorizontalTextAlignment="Center" VerticalOptions="Center" VerticalTextAlignment="Center">
                    <local1:CustomLabel.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnSubmitClicked}" />
                    </local1:CustomLabel.GestureRecognizers>
                </local1:CustomLabel>
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>