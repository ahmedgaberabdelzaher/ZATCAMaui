<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GAZT.Views.ForgotUsernamePassword"
             xmlns:cards="clr-namespace:PanCardView;assembly=PanCardView"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms"
             xmlns:local1="clr-namespace:GAZT"
             xmlns:local="clr-namespace:GAZT"
             FlowDirection="RightToLeft">
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid Grid.Row="0" Grid.Column="0" RowSpacing="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="37.46*" />
                    <RowDefinition Height="52.54*" />
                    <RowDefinition Height="10.54*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>
                <skia:SKCanvasView Margin="0,-2,0,0" x:Name="canvasView" Grid.Row="0" Grid.Column="0" PaintSurface="OnCanvasViewPaintSurface" />
                <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" RowSpacing="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4*" />
                        <!--spacce-->
                        <RowDefinition Height="1.69*" />
                        <!--Text-->
                        <RowDefinition Height="1.81*" />
                        <!--space-->
                        <RowDefinition Height="3*" />

                        <RowDefinition Height="10.25*" />
                        <!--Text-->
                        <RowDefinition Height="3*" />
                        <!--space-->
                        <RowDefinition Height="10.25*" />
                        <!--Text-->
                        <RowDefinition Height="3*" />
                        <!--space between text and box-->
                        <RowDefinition Height="9.25*" />
                        <!--box-->
                        <RowDefinition Height="3*" />
                        <!--space between box and 3 boxes-->
                        <RowDefinition Height="9.25*" />
                        <!--3 boxes-->
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="9.25*" />
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="5.25*" />

                        <RowDefinition Height="7.25*" />
                        <!--space-->
                        <RowDefinition Height="6*" />
                        <!-- bottom height 14.31-->
                        <RowDefinition Height="3.875*" />
                        <!--5.56 space form bottom-->
                        <RowDefinition Height="3.875*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <!--5.69-->
                        <ColumnDefinition Width="31*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="31*" />
                        <!--26.95-->
                        <ColumnDefinition Width="1*" />
                        <!--2.99-->
                        <ColumnDefinition Width="31*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>


                    <StackLayout  Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5" Grid.RowSpan="13" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                        <cards:CarouselView  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" x:Name="CardView" >
                            <cards:CarouselView.ItemTemplate>
                                <DataTemplate>
                                    <ContentView>
                                        <Frame  VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Padding="0" HasShadow="true" IsClippedToBounds="true" CornerRadius="4" BorderColor="#B1B1B1" BackgroundColor="White">
                                            <Image Source="{Binding Source}" />
                                        </Frame>
                                    </ContentView>
                                </DataTemplate>
                            </cards:CarouselView.ItemTemplate>
                        </cards:CarouselView>
                    </StackLayout>


                    <!--  forgot userName with Corporate-->
                    <Frame  Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="10,0,10,0" >
                    </Frame>
                    <StackLayout Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="12,2,12,1"  >
                        <local1:CustomPicker Style="{StaticResource PickerStyle}" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="5"  FontSize="10" Image="ic_dropdownOne.png" Title="{x:Static local:AppResources.SelectPasswordUserName}" IsEnabled="true" TextColor="Black" HorizontalOptions="FillAndExpand" SelectedItem="{Binding SelectedForgotType, Mode=TwoWay}" ItemsSource="{Binding ForgotTypeList}" DisplayMemberBinding="CredentialType" Margin="10,0,10,0" />

                    </StackLayout>

                    <Label Text="{x:Static local:AppResources.SelectPasswordUserName}"  IsEnabled="False"  Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="5" Style="{StaticResource MiniGoldLabelStyle}"  HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="White" >
                        <Label.Margin>
                            <OnIdiom x:TypeArguments="Thickness" Phone="25,-13,25,0" Tablet="30,-18,30,0" />
                        </Label.Margin>
                    </Label>

                    <Frame  Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="10,0,10,0">
                    </Frame>
                    <StackLayout Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="12,2,12,1"   >
                        <local1:CustomPicker Style="{StaticResource PickerStyle}" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="5" FontSize="10" Image="ic_dropdownOne.png" Title="{x:Static local:AppResources.IDType}"  TextColor="Black" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" SelectedItem="{Binding SelectedTaxPayerType, Mode=TwoWay}" ItemsSource="{Binding TaxpayerTypeList}" DisplayMemberBinding="TaxPayerType" Margin="10,0,10,0" IsEnabled="{Binding IsTaxPayerTypeEnable}"/>

                    </StackLayout>

                    <Label Text="{x:Static local:AppResources.IDType}" IsEnabled="False"  Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="5" Style="{StaticResource MiniGoldLabelStyle}"  HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="White">
                        <Label.Margin>
                            <OnIdiom x:TypeArguments="Thickness" Phone="25,-13,25,0" Tablet="30,-18,30,0" />
                        </Label.Margin>
                    </Label>

                    <!--For Password-->
                    <!--<Frame  Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="10,0,10,0" IsVisible="{Binding IsForgotPassword}">
                </Frame>

                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="15,0,15,0"  Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="5" IsVisible="{Binding IsForgotPassword}">

                    <local1:BorderlessEntry Text="{Binding UserName}" Style="{StaticResource EntryStyle}" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="5" Margin="2,1,2,1" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" BackgroundColor="White" IsVisible="{Binding IsForgotPassword}">
                    </local1:BorderlessEntry>
                </StackLayout>

                <Label  Text="{x:Static local:AppResources.UserName}" Style="{StaticResource MiniGoldLabelStyle}" Grid.Row="8" Grid.Column="1"  Grid.ColumnSpan="3" HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="White" IsVisible="{Binding IsForgotPassword}">
                    <Label.Margin>
                        <OnIdiom x:TypeArguments="Thickness" Phone="25,-13,25,0" Tablet="30,-18,30,0" />
                    </Label.Margin>
                </Label>-->

                    <!--  forgot userName with Individual-->
                    <Frame  Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="10,0,10,0" >
                    </Frame>

                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="15,0,15,0"  Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="5" >

                        <local1:BorderlessEntry Text="{Binding IDNumber}" Style="{StaticResource EntryStyle}" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="5" Margin="2,1,2,1" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" BackgroundColor="White" >
                        </local1:BorderlessEntry>
                    </StackLayout>
                    <Label  Text="{Binding IDNumberOrCorporateIDOrUserName}" Style="{StaticResource MiniGoldLabelStyle}" Grid.Row="8" Grid.Column="1"  Grid.ColumnSpan="3" HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="White" >
                        <Label.Margin>
                            <OnIdiom x:TypeArguments="Thickness" Phone="25,-13,25,0" Tablet="30,-18,30,0" />
                        </Label.Margin>
                    </Label>


                    <!--  forgot userName with Corporate-->
                    <!--<Frame  Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="10,0,10,0" IsVisible="{Binding IsForgotUserNameWithCorporate}">
                </Frame>

                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="15,0,15,0"  Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="5" IsVisible="{Binding IsForgotUserNameWithCorporate}">

                    <local1:BorderlessEntry Text="{Binding CorporateID}" Style="{StaticResource EntryStyle}" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="5" Margin="2,1,2,1" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" BackgroundColor="White" IsVisible="{Binding IsForgotUserNameWithCorporate}">
                    </local1:BorderlessEntry>
                </StackLayout>
                <Label  Text="{x:Static local:AppResources.CorportaeID}" Style="{StaticResource MiniGoldLabelStyle}" Grid.Row="8" Grid.Column="1"  Grid.ColumnSpan="3" HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="White" IsVisible="{Binding IsForgotUserNameWithCorporate}">
                    <Label.Margin>
                        <OnIdiom x:TypeArguments="Thickness" Phone="25,-13,25,0" Tablet="30,-18,30,0" />
                    </Label.Margin>
                </Label>-->

                    <Frame  Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="10,0,10,0">
                    </Frame>

                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="15,0,15,0"  Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="5">

                        <local1:BorderlessEntry Text="{Binding UserName}" Style="{StaticResource EntryStyle}" Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="5" Margin="2,1,2,1" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" BackgroundColor="White">
                        </local1:BorderlessEntry>
                    </StackLayout>
                    <Label  Text="{x:Static local:AppResources.IDNumber}" Style="{StaticResource MiniGoldLabelStyle}" Grid.Row="10" Grid.Column="0"  Grid.ColumnSpan="3" HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="White">
                        <Label.Margin>
                            <OnIdiom x:TypeArguments="Thickness" Phone="25,-13,25,0" Tablet="30,-18,30,0" />
                        </Label.Margin>
                    </Label>

                    <Frame  Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="10,0,10,0">
                    </Frame>

                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="15,0,15,0"  Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="5">

                        <local1:BorderlessEntry Text="{Binding EnteredCaptchaValue}" Style="{StaticResource EntryStyle}" Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="5" Margin="2,1,2,1" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" BackgroundColor="White">
                        </local1:BorderlessEntry>
                    </StackLayout>
                    <Label  Text="Captcha" Style="{StaticResource MiniGoldLabelStyle}" Grid.Row="10" Grid.Column="0"  Grid.ColumnSpan="3" HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="White">
                        <Label.Margin>
                            <OnIdiom x:TypeArguments="Thickness" Phone="25,-13,25,0" Tablet="30,-18,30,0" />
                        </Label.Margin>
                    </Label>

                    <Frame Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="10,0,10,0">
                    </Frame>
                    <Label  Text="{Binding Captcha}" Style="{StaticResource MiniGoldLabelStyle}" Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="5" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="White">

                    </Label>
                    <Image Grid.Row="12" Grid.Column="5" Source="ic_sync_captcha.png" Aspect="AspectFit" HorizontalOptions="End" VerticalOptions="Center" Margin="10,0,10,0">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnCaptchaRegenerateClicked}" />
                        </Image.GestureRecognizers>
                    </Image>
                    <!--<BoxView Grid.Row="16" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="0.5" BackgroundColor="#d5d5d5" />
                <Image Grid.Row="16" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" Source="ic_home_selected.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                <Image Grid.Row="17" Grid.RowSpan="2" Grid.Column="1" Source="ic_question.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                <Image Grid.Row="17" Grid.RowSpan="2" Grid.Column="5" Source="ic_user_2.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnMyTaxPayerProfileClicked}" />
                    </Image.GestureRecognizers>
                </Image>-->
                </Grid>
                <Frame HorizontalOptions="FillAndExpand" IsEnabled="{Binding IsLoginEnabled}" VerticalOptions="FillAndExpand" Grid.Row="2" Grid.Column="0"  HasShadow="false" CornerRadius="4" BackgroundColor="#005e4b" Margin="10,0,10,10">
                </Frame>
                <Label   Text="{x:Static local:AppResources.Submit}" IsEnabled="{Binding IsLoginEnabled}" Style="{StaticResource SmallWhiteLabelStyle}"  Grid.Row="2" Grid.Column="0"  HorizontalTextAlignment="Center" VerticalOptions="Center" VerticalTextAlignment="Center" Margin="10,0,10,10">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnSubmitClicked}" />
                    </Label.GestureRecognizers>
                </Label>

            </Grid>
            <!--<StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" Orientation="Vertical" Spacing="20" Padding="10" BackgroundColor="White" IsVisible="{Binding NewPasswordLayoutVisibility}">
                <Label Text="Enter New password"></Label>
                <Entry Text="{Binding NewPassword}" HorizontalOptions="FillAndExpand"></Entry>
                 <Label Text="Enter Confirm password"></Label>
                <Entry Text="{Binding ConfirmPassword}" HorizontalOptions="FillAndExpand"></Entry>
                <Button Text="Submit" Command="{Binding OnChangePasswordSubmitClicked}" HorizontalOptions="FillAndExpand"></Button>
            </StackLayout>-->

            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" Orientation="Vertical" Spacing="20" Padding="10" BackgroundColor="White" IsVisible="{Binding OTPLayoutVisibility}">
                <Label Text="Enter OTP"></Label>
                <Entry Text="{Binding EnteredOTP}" HorizontalOptions="FillAndExpand"></Entry>
                <Label Text="Resend OTP">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnResendOTPClicked}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Button Text="Submit" Command="{Binding OnValidateOTPClicked}" HorizontalOptions="FillAndExpand"></Button>
            </StackLayout>


        </Grid>
    </ContentPage.Content>
</ContentPage>