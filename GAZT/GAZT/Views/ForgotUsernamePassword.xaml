<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GAZT.Views.ForgotUsernamePassword"
             Title="Forgot password or UserName"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms"
             xmlns:local1="clr-namespace:GAZT">
    <ContentPage.Content>
        <Grid RowSpacing="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="37.46*" />
                <RowDefinition Height="62.54*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*" />
            </Grid.ColumnDefinitions>
            <skia:SKCanvasView Margin="0,-2,0,0" x:Name="canvasView" Grid.Row="0" Grid.Column="0" PaintSurface="OnCanvasViewPaintSurface" />
            <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" RowSpacing="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" />
                    <!--spacce-->
                    <RowDefinition Height="7.69*" />
                    <!--Text-->
                    <RowDefinition Height="1.81*" />
                    <!--space-->
                    <RowDefinition Height="7.78*" />
                    <!--Text-->
                    <RowDefinition Height="1.39*" />
                    <!--space-->
                    <RowDefinition Height="2.22*" />
                    <!--Text-->
                    <RowDefinition Height="7.86*" />
                    <!--space between text and box-->
                    <RowDefinition Height="36.48*" />
                    <!--box-->
                    <RowDefinition Height="3.75*" />
                    <!--space between box and 3 boxes-->
                    <RowDefinition Height="12.09*" />
                    <!--3 boxes-->
                    <RowDefinition Height="8.19*" />
                    <!--space-->
                    <RowDefinition Height="5*" />
                    <!-- bottom height 14.31-->
                    <RowDefinition Height=".875*" />
                    <!--5.56 space form bottom-->
                    <RowDefinition Height=".875*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <!--5.69-->
                    <ColumnDefinition Width="31*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="31*" />
                    <!--26.95-->
                    <ColumnDefinition Width="1*" />
                    <!--2.99-->
                    <ColumnDefinition Width="31*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <!--<Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85*" />
                        <ColumnDefinition Width="15*" />
                    </Grid.ColumnDefinitions>
                    <local1:CustomPicker Grid.Column="0" Title="select" IsEnabled="true" TextColor="Black" HorizontalOptions="FillAndExpand" SelectedItem="{Binding ForgotCredentialType, Mode=TwoWay}" ItemsSource="{Binding TaxpayerTypeList}" DisplayMemberBinding="TaxPayerType" />
                    <StackLayout Grid.Column="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White">
                        <Image Source="ic_dropdown.png" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSelectedTaxPAyerType" />
                            </Image.GestureRecognizers>
                        </Image>
                    </StackLayout>
                </Grid>-->

                <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85*" />
                        <ColumnDefinition Width="15*" />
                    </Grid.ColumnDefinitions>
                    <local1:CustomPicker Grid.Column="0" Title="select" IsEnabled="true" TextColor="Black" HorizontalOptions="FillAndExpand" SelectedItem="{Binding ForgotCredentialType, Mode=TwoWay}" ItemsSource="{Binding TaxpayerTypeList}" DisplayMemberBinding="TaxPayerType" />
                    <StackLayout Grid.Column="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White">
                        <Image Source="ic_dropdown.png" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSelectedTaxPAyerType" />
                            </Image.GestureRecognizers>
                        </Image>
                    </StackLayout>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85*" />
                        <ColumnDefinition Width="15*" />
                    </Grid.ColumnDefinitions>
                    <local1:CustomPicker Grid.Column="0" Title="select" IsEnabled="true" TextColor="Black" HorizontalOptions="FillAndExpand" SelectedItem="{Binding SelectedForgotType, Mode=TwoWay}" ItemsSource="{Binding ForgotTypeList}" DisplayMemberBinding="CredentialType"  />
                    <StackLayout Grid.Column="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White">
                        <Image Source="ic_dropdown.png" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSelectedForgetType" />
                            </Image.GestureRecognizers>
                        </Image>
                    </StackLayout>
                </Grid>

                <Frame Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource FrameStyle}" Margin="0">
                </Frame>
                <local1:BorderlessEntry Text="{Binding IDNumber}" Style="{StaticResource EntryStyle}" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="5" Margin="15,1,15,1" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="FillAndExpand" BackgroundColor="White" IsEnabled="False">
                </local1:BorderlessEntry>
                <Label Text="ID Number" IsEnabled="False" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="5" Style="{StaticResource MiniGoldLabelStyle}"  HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="White">
                    <Label.Margin>
                        <OnIdiom x:TypeArguments="Thickness" Phone="25,-13,25,0" Tablet="30,-18,30,0" />
                    </Label.Margin>
                </Label>
                
                
                <BoxView Grid.Row="10" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="0.5" BackgroundColor="#d5d5d5" />
                <Image Grid.Row="10" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="7" Source="ic_home_selected.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                <Image Grid.Row="11" Grid.RowSpan="2" Grid.Column="1" Source="ic_question.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                <Image Grid.Row="11" Grid.RowSpan="2" Grid.Column="5" Source="ic_user_2.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnMyTaxPayerProfileClicked}" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>