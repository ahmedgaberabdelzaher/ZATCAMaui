<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cards="clr-namespace:PanCardView;assembly=PanCardView" xmlns:local="clr-namespace:GAZT;assembly:GAZT" xmlns:local1="clr-namespace:GAZT"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms"
             xmlns:tabview="clr-namespace:Syncfusion.XForms.TabView;assembly=Syncfusion.SfTabView.XForms"
             xmlns:cards1="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             FlowDirection="RightToLeft"
             Title="{x:Static local:AppResources.MyBills}"
             x:Class="GAZT.Views.MyBillsView">
    <!--<ContentPage.ToolbarItems>
        <ToolbarItem Icon="ic_bell.png" Order="Primary" Priority="0" Command="{Binding OnBellClicked}" />
    </ContentPage.ToolbarItems>-->
    <ContentPage.Content>
        <tabview:SfTabView Margin="0,0,0,2" x:Name="simTab" VisibleHeaderCount="2" >
            <tabview:SfTabView.SelectionIndicatorSettings>
                <tabview:SelectionIndicatorSettings
                    Color="DarkGreen" 
                    Position="Bottom" 
                    StrokeThickness="2"/>
            </tabview:SfTabView.SelectionIndicatorSettings>
            <tabview:SfTabView.Items>
                <tabview:SfTabItem Title="{x:Static local:AppResources.All}"   
                             TitleFontSize="14"
                            SelectionColor="Black"
                             FontIconFontColor="#FF00AFF0"
                                   
                             TitleFontColor="Gray">

                    <tabview:SfTabItem.Content>
                       
                            <StackLayout Margin="10,0,10,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <ListView  x:Name="Bills" 
           ItemsSource="{Binding MyBills}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                 BackgroundColor="White"     
            SeparatorVisibility="None"
            >
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                            <cards1:SfCardView HasShadow="True" Margin="10" Opacity=".9" BorderWidth=".05" BorderColor="#5d6770"  ShadowColor="#5d6770" BackgroundColor="White" CornerRadius="8"  IndicatorColor="{Binding Colorcode}" IndicatorPosition="Left" IndicatorThickness="5" >

                                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Margin="10,10,0,5" Padding="10" >
                                                    <Grid Style="{DynamicResource GridStyle}" ColumnSpacing="0" RowSpacing="2"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White" >
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48*" />
                                                            <ColumnDefinition Width="42*" />
                                                            <ColumnDefinition Width="3*" />
                                                            <ColumnDefinition Width="7*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Label Text="{x:Static local:AppResources.TaxType}" Margin="0" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                                           Grid.ColumnSpan="2"/>

                                                        <Label Text="{Binding Abtypt}" 
                                                  
                                  Margin="0" 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                                           Grid.ColumnSpan="2"/>


                                                        <Label 
                                                 Style="{StaticResource MiniGoldLabelStyle}"
                                  
                                                HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="2"
                                             
                                   Grid.Column="0"
                                                        Grid.ColumnSpan="2"
                                   >
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span   Text="{x:Static local:AppResources.ZSadadInvoiceNumber}"  />

                                                                    <!--<Span Text="{x:Static local:AppResources.Number}" Style="{StaticResource MiniGoldLabelStyle}" />-->
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>

                                                        <Label Text="{Binding VTRE2}" 
                                                 
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                                           Grid.ColumnSpan="2"/>

                                                        <Label Text="{x:Static local:AppResources.DueAmount}" 
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                   HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="4"
                                   Grid.Column="0"
                                                           Grid.ColumnSpan="2"
                                   />
                                                        <Label  
                                     
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                    HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="5"
                                   Grid.Column="0"
                                                        Grid.ColumnSpan="2">

                                                            <Label.FormattedText>
                                                                <FormattedString>

                                                                    <Span  Text="{Binding TestDueAmount}"  />
                                                                    <Span Text=" "/>
                                                                    <Span    Text="{x:Static local:AppResources.ZSAR} "/>

                                                                </FormattedString>
                                                            </Label.FormattedText>

                                                        </Label>

                                                        <Label Text="{x:Static local:AppResources.DueDate}" 
                                      
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="6"
                                   Grid.Column="0"
                                                           Grid.ColumnSpan="2"
                                   />
                                                        <Label Text="{Binding FAEDN, StringFormat='{}{0:yyyy}'}" 
                                       
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="7"
                                   Grid.Column="0"
                                                           Grid.ColumnSpan="2"/>
                                                        <Label Text="{x:Static local:AppResources.ZDescription}" 
                                      
                                   Style="{StaticResource MiniGoldLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="8"
                                   Grid.Column="0"
                                                           Grid.ColumnSpan="2"
                                   />
                                                        <Label Text="{Binding Txt30}" 
                                       
                                   Style="{StaticResource MiniGrayLabelStyle}"
                                                       HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="CenterAndExpand"
                                   Grid.Row="9"
                                   Grid.Column="0"
                                                           Grid.ColumnSpan="2"/>

                                                        <!--<StackLayout Grid.Row="1"  BackgroundColor="AliceBlue" Grid.Column="3" Grid.ColumnSpan="2" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.RowSpan="4" ></StackLayout>-->
                                                        <Image  Grid.Row="1"  Grid.Column="3" Grid.ColumnSpan="1" Grid.RowSpan="10"  Source="{Binding StatusImage}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                                                        <BoxView  
                     Grid.Row="0" Grid.Column="2" Grid.RowSpan="10" Margin="0" BackgroundColor="Gray" VerticalOptions="Fill" HorizontalOptions="Center" WidthRequest="1"/>


                                                    </Grid>
                                                </StackLayout>
                                            </cards1:SfCardView>
                                        </ViewCell>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackLayout>                      
                    </tabview:SfTabItem.Content>
