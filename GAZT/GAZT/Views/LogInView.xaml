<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GAZT.Views.LogInView"
             xmlns:local="clr-namespace:GAZT;assembly:GAZT" BackgroundColor="White">
    <ContentPage.Content>
        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Spacing="0">
            
            <Grid RowSpacing="20" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="42*"/>
                <RowDefinition Height="10*"/>
                    <RowDefinition Height="10*"/>
                <RowDefinition Height="10*"/>
                    <RowDefinition Height="8*"/>
            </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70*"/>
                                        <ColumnDefinition Width="20*"/>
                                        <ColumnDefinition Width="10*"/>
                </Grid.ColumnDefinitions>
                <Image Source="ic_background_green.png" Aspect="AspectFill" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" />
                <Frame Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="10,0,10,0"  BackgroundColor="White"  OutlineColor="Olive" BorderColor="Olive" HasShadow="false" CornerRadius="4">
                    
                </Frame>
                <local:BorderlessEntry Text="" Placeholder="User Name" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="12,1,0,1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="White">
                     
                </local:BorderlessEntry>
            <Image Source="ic_user.png"  Grid.Row="1" Grid.Column="2"  HorizontalOptions="Start" VerticalOptions="Center" />
            <Label Text="User Name" Grid.Row="1" Grid.Column="0" Margin="20,-10,0,0" Grid.ColumnSpan="3" HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="White"/>
                </Grid>
        </StackLayout> 
    </ContentPage.Content>
</ContentPage>
