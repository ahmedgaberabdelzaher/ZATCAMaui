<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="GAZT.Views.LogInView" xmlns:skia="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms" xmlns:local="clr-namespace:GAZT;assembly:GAZT" BackgroundColor="White" FlowDirection="RightToLeft">
    <ContentPage.ToolbarItems>
        <ToolbarItem Icon="ic_language.png" Order="Primary" Priority="0" Clicked="OnOnLanguageClickClicked" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <ScrollView>
        <Grid RowSpacing="0" ColumnSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="42*" />
                <RowDefinition Height="8*" />
                <RowDefinition Height="8*" />
                <RowDefinition Height="4*" />
                <RowDefinition Height="8*" />
                <RowDefinition Height="4*" />
                <RowDefinition Height="7.9*" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="10*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="13*" />
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="67*" />
            </Grid.ColumnDefinitions>
            <skia:SKCanvasView x:Name="canvasView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" PaintSurface="OnCanvasViewPaintSurface" />
            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="27*" />
                    <RowDefinition Height="53*" />
                    <RowDefinition Height="20*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>
                <Image Source="ic_logo.png" Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Start" Aspect="AspectFit" />
            </Grid>
            <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="Transparent">
            </StackLayout>
            <Frame Grid.Row="2" Grid.Column="0" Style="{StaticResource FrameStyle}" Grid.ColumnSpan="3" Margin="10,0,10,0">
            </Frame>
            <local:BorderlessEntry Text="" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,1,12,1" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="CenterAndExpand" BackgroundColor="White">
            </local:BorderlessEntry>
            <Image Source="ic_user.png" Grid.Row="2" Grid.Column="0" HorizontalOptions="End" VerticalOptions="Center" />
            <local:CustomLabel Text="{x:Static local:AppResources.UserName}" Style="{StaticResource MiniGoldLabelStyle}" Grid.Row="2" Grid.Column="0" Margin="20,-5,20,0" Grid.ColumnSpan="3" HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="White" />
            <!--   <Button Margin="10" TextColor="Black" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="Ar" Clicked="OnArClicked" BackgroundColor="Teal"/>
                            <Button Margin="10" TextColor="Black" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Text="En" Clicked="OnEnClicked" BackgroundColor="Teal"/>
-->
            <StackLayout Grid.Row="3" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            </StackLayout>
            <Frame Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="10,0,10,0" Style="{StaticResource FrameStyle}">
            </Frame>
            <local:BorderlessEntry Text="" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,1,12,1" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start" VerticalOptions="CenterAndExpand" BackgroundColor="White">
            </local:BorderlessEntry>
            <Image Source="ic_password.png" Grid.Row="4" Grid.Column="0" HorizontalOptions="End" VerticalOptions="Center" />
            <local:CustomLabel Text="{x:Static local:AppResources.Password}" Style="{StaticResource MiniGoldLabelStyle}" Grid.Row="4" Grid.Column="0" Margin="20,-5,20,0" Grid.ColumnSpan="3" HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="White" />
            <StackLayout Grid.Row="5" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            </StackLayout>
            <!--   <StackLayout Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="3"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Padding="10,0,10,0" BackgroundColor="#005e4b">
              
                <Label Text="Search" HorizontalTextAlignment="Center" VerticalOptions="FillAndExpand" VerticalTextAlignment="Center" TextColor="#c49b2d" >
    -->
            <!--  <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnSearchBtnClick}"/>
                                      </Label.GestureRecognizers>-->
            <!-- </Label>-->
            <!-- <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer clic="{Binding OnSearchBtnClick}"/>
                                      </StackLayout.GestureRecognizers>-->
            <Frame HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" HasShadow="false" CornerRadius="4" BackgroundColor="#005e4b" Margin="10,0,10,0">
            </Frame>
            <local:CustomLabel Text="{x:Static local:AppResources.Login}" Style="{StaticResource SmallWhiteLabelStyle}" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" HorizontalTextAlignment="Center" VerticalOptions="Center" VerticalTextAlignment="Center">
                <local:CustomLabel.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OnLoginButtonClicked}" />
                </local:CustomLabel.GestureRecognizers>
            </local:CustomLabel>
            <StackLayout Grid.Row="7" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            </StackLayout>
            <StackLayout Padding="10,0,10,0" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Image Source="ic_checkbox.png" Aspect="AspectFit" HorizontalOptions="Start" VerticalOptions="Center" />
                <local:CustomLabel FontSize="Medium" Text="Remember me" Style="{StaticResource SmallMiniGoldLabelStyle}" HorizontalOptions="Start" VerticalOptions="Center">
                </local:CustomLabel>
            </StackLayout>
        </Grid>
        <!--</Grid>-->
