<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:custom="clr-namespace:GAZT"
    x:Class="EGAZT.Controls.Header">
     <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        
        </ResourceDictionary>
    </ContentView.Resources>
 <Grid  Padding="20,5,20,5" ColumnDefinitions="10*,80*,10*">
                <StackLayout Grid.Column="0">
                    <Image Source="arrowLeftwhite.png" Rotation="180" VerticalOptions="CenterAndExpand" HorizontalOptions="Start" Style="{DynamicResource BackButtonArrow}">
                        <Image.Triggers>
                            <DataTrigger TargetType="Image" Binding="{Binding AppDirection}"  Value="LeftToRight">
                                <Setter Property="Rotation" Value="0"></Setter>
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>
              <custom:CustomLabel x:Name="titleTxt" Grid.Column="1"  Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
            </Grid>
</ContentView>
