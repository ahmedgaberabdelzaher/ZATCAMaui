<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="EGAZT.Controls.PickerWithSearch"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView">
    <ContentView.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid
        Grid.Row="0"
        Margin="0,0,0,0"
        VerticalOptions="FillAndExpand">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding ClosePickerCommand}" />
        </Grid.GestureRecognizers>
        <StackLayout
            Grid.Row="0"
            Grid.Column="0"
            BackgroundColor="Black"
            Opacity="0.4"
            Orientation="Vertical"
            VerticalOptions="FillAndExpand" />
        <yummy:PancakeView
            Padding="20,20,20,10"
            BackgroundColor="White"
            CornerRadius="15,15,0,0"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">

            <Grid
                Margin="0,0,0,0"
                RowDefinitions="auto,*,auto"
                VerticalOptions="FillAndExpand">
                <SearchBar
                    x:Name="PortsSearchBar"
                    Grid.Row="0"
                    Margin="0,0,3,0"
                    FontFamily="{StaticResource SomarBold}"
                    Placeholder="{x:Static ResourceManager:AppResources.ZSearch}"
                    Text="{Binding SearchTxt}"
                    TextColor="{StaticResource Primary}">
                    <SearchBar.Behaviors>
                        <xct:EventToCommandBehavior
                            Command="{Binding SearchInPortsCommand}"
                            CommandParameter="{Binding Text, Source={x:Reference PortsSearchBar}}"
                            EventName="TextChanged" />
                    </SearchBar.Behaviors>
                </SearchBar>
                <Grid Grid.Row="1">
                    <CollectionView
                        x:Name="PortSearchlst"
                        IsVisible="{Binding IsPickerOpened}"
                        ItemsSource="{Binding Ports}"
                        VerticalScrollBarVisibility="Never">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="7" Padding="10,2,10,2">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.PortSelectionChangedCommand, Source={x:Reference PortSearchlst}}" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Label
                                        HorizontalTextAlignment="Start"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding Name}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
                <buttons:SfButton
                    Grid.Row="2"
                    Margin="0,0,0,10"
                    BackgroundColor="White"
                    BorderColor="{StaticResource PrimaryColor}"
                    Command="{Binding ClosePickerCommand}"
                    FontSize="16"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZClose}"
                    TextColor="#0996D4"
                    VerticalOptions="CenterAndExpand" />

            </Grid>
        </yummy:PancakeView>
    </Grid>

</ContentView>
