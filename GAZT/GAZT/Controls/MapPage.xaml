<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"		
	xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"	
	xmlns:gmaps="clr-namespace:Xamarin.Forms.GoogleMaps;assembly=Xamarin.Forms.GoogleMaps"
    x:Class="EGAZT.Controls.MapPage">

 	<ContentView.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
				<ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</ContentView.Resources>

	<Grid  VerticalOptions="EndAndExpand" >

        <yummy:PancakeView  Style="{StaticResource CommonTopCurves}"
							CornerRadius="15,15,0,0"
							Padding="0"
							HeightRequest="400"
							VerticalOptions="EndAndExpand"
							BackgroundColor="White">

			<gmaps:Map MapType="Street"
					  x:Name="map"
					  HasRotationEnabled="True"
                      HasScrollEnabled="True"
                      HasZoomEnabled="True"
					  MyLocationEnabled="True"
					  IsShowingUser="True"
                      IsIndoorEnabled="True"
					  MapClicked="map_MapClicked"/>

		</yummy:PancakeView>

		<Image Source="CloseIcon"
			   Aspect="AspectFit"
			   WidthRequest="25"
			   HeightRequest="25"
			   Margin="10"
			   VerticalOptions="StartAndExpand"
			   HorizontalOptions="StartAndExpand">

			<Image.GestureRecognizers >
			<TapGestureRecognizer Command="{Binding CloseMapCommand}"/>
			</Image.GestureRecognizers>

		</Image>

	</Grid>
</ContentView>



