<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="EGAZT.Controls.MapPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:animations="clr-namespace:Rg.Plugins.Popup.Animations;assembly=Rg.Plugins.Popup"
    xmlns:gmaps="clr-namespace:Xamarin.Forms.GoogleMaps;assembly=Xamarin.Forms.GoogleMaps"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView">

    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>

    <pages:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </pages:PopupPage.Animation>

    <Grid VerticalOptions="EndAndExpand">

        <yummy:PancakeView
            Padding="0"
            BackgroundColor="White"
            CornerRadius="15,15,0,0"
            HeightRequest="400"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">

            <gmaps:Map
                x:Name="map"
                IsIndoorEnabled="True"
                MapLongClicked="map_MapLongClicked"
                MapClicked="map_MapClicked"
                MapType="Street"
                MyLocationEnabled="True" />

        </yummy:PancakeView>

        <Image
            Margin="10"
            Aspect="AspectFit"
            HeightRequest="25"
            HorizontalOptions="StartAndExpand"
            Source="CloseIcon"
            VerticalOptions="StartAndExpand"
            WidthRequest="25">

            <Image.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseMapCommand}" />
            </Image.GestureRecognizers>

        </Image>

    </Grid>
</pages:PopupPage>



