<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="EGAZT.Controls.MapPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gmaps="clr-namespace:Xamarin.Forms.GoogleMaps;assembly=Xamarin.Forms.GoogleMaps"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView">

    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid VerticalOptions="EndAndExpand">

        <yummy:PancakeView
            Padding="0"
            BackgroundColor="White"
            CornerRadius="15,15,0,0"
            HeightRequest="400"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">

            <gmaps:Map
                x:Name="map"
                HasRotationEnabled="True"
                HasScrollEnabled="True"
                HasZoomEnabled="True"
                IsIndoorEnabled="True"
                IsShowingUser="True"
                MapLongClicked="map_MapLongClicked"
                MapType="Street"
                MyLocationEnabled="True" />

        </yummy:PancakeView>

        <Image
            Margin="10"
            Aspect="AspectFit"
            HeightRequest="25"
            HorizontalOptions="StartAndExpand"
            Source="CloseIcon"
            VerticalOptions="StartAndExpand"
            WidthRequest="25">

            <Image.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseMapCommand}" />
            </Image.GestureRecognizers>

        </Image>

    </Grid>
</ContentView>



