<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Controls.UploadingPopup"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:animations="clr-namespace:Rg.Plugins.Popup.Animations;assembly=Rg.Plugins.Popup"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:custom="clr-namespace:GAZT">

     <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>

    <pages:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </pages:PopupPage.Animation>

    <Grid VerticalOptions="EndAndExpand">

        <yummy:PancakeView
            Padding="0"
            BackgroundColor="White"
            CornerRadius="15,15,0,0"
            HeightRequest="200"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="20"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <!--Image Frame-->
                <Frame Style="{StaticResource CommonTopCurves}"
                       CornerRadius="25"
                       BorderColor="#BCBCBB">

                    <StackLayout Spacing="10">

                        <!--Image Icon-->
                         <Image
                            HeightRequest="30"
                            HorizontalOptions="Center"
                            Source="imageFile.png"
                            Aspect="AspectFit"
                            VerticalOptions="Start"
                            WidthRequest="30"/>

                         <!--  UploadImage Label  -->
                        <custom:CustomLabel
                            FontSize="25"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="{x:Static ResourceManager:AppResources.UploadImage}"
                            VerticalOptions="Center" />




                    </StackLayout>

                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectedUploadLabelCommand}"
                                              CommandParameter="image"/>

                    </Frame.GestureRecognizers>
                </Frame>


                <!--File Frame-->
                <Frame Style="{StaticResource CommonTopCurves}"
                       CornerRadius="25"
                       Grid.Column="1"
                       BorderColor="#BCBCBB">

                    <StackLayout Spacing="10" >

                        <!--File Icon-->
                         <Image
                            HeightRequest="30"
                            HorizontalOptions="Center"
                            Source="fileUpload.png"
                            Aspect="AspectFit"
                            VerticalOptions="Start"
                            WidthRequest="30"/>

                         <!--  UploadFile Label  -->
                         <custom:CustomLabel
                            FontSize="25"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="{x:Static ResourceManager:AppResources.UploadFile}"
                            VerticalOptions="Start" />

                    </StackLayout>

                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectedUploadLabelCommand}"
                                              CommandParameter="file"/>

                    </Frame.GestureRecognizers>
                </Frame>

            </Grid>

        </yummy:PancakeView>

    </Grid>
</pages:PopupPage>

