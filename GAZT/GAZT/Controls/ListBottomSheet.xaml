<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="EGAZT.Controls.ListBottomSheet"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid Margin="0">

            <StackLayout
                Opacity="0.4"
                Orientation="Vertical"
                VerticalOptions="FillAndExpand">
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ClosBottomSheetCommand}" />
                </StackLayout.GestureRecognizers>
            </StackLayout>
            <yummy:PancakeView
                Padding="20,15"
                BackgroundColor="White"
                CornerRadius="15,15,0,0"
                HeightRequest="180"
                Shadow="{yummy:ShadowMarkup Color=#FF0000,
                                            Offset='0,0'}"
                Style="{StaticResource CommonTopCurves}"
                VerticalOptions="EndAndExpand">
                <ScrollView>
                    <StackLayout x:Name="itemList" BindableLayout.ItemsSource="{Binding BottomSheetList}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <StackLayout x:Name="selectedItem">
                                    <Label
                                        FontFamily="{StaticResource SomarBold}"
                                        FontSize="16"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding Name}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                BindingContext="{Binding Source={x:Reference itemList}, Path=BindingContext}"
                                                Command="{Binding SelectedBottomItemCommand}"
                                                CommandParameter="{Binding Source={x:Reference selectedItem}, Path=BindingContext}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <!--  Horizontal Line  -->
                                    <BoxView
                                        Margin="0,10"
                                        BackgroundColor="{StaticResource NeutralLightGrey}"
                                        HeightRequest="2" />
                                </StackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </ScrollView>
            </yummy:PancakeView>
        </Grid>
    </ContentView.Content>
</ContentView>