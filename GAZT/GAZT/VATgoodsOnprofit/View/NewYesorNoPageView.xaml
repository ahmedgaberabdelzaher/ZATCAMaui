<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
             xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             x:Class="EGAZT.Views.NewDesign.Common.NewYesorNoPageView"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             FlowDirection="RightToLeft"
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="partials_background.png"
             xmlns:local="clr-namespace:EGAZT.CustomControl"
             xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms" xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             ios:Page.UseSafeArea="true">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <local:StringToColorConvertor x:Key="StringToColorConvertor" />
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />-->
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->

                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0"
                  Padding="0,0,0,0" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="24,10,24,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>
                        <custom:CustomLabel Grid.Column="1" Grid.Row="0" Text="{x:Static ResourceManager:AppResources.ZProfitOnGoods}" TextColor="White" HorizontalOptions="CenterAndExpand" FontFamily="{StaticResource Somar-Regular}" VerticalOptions="CenterAndExpand" FontSize="Large" >
                        </custom:CustomLabel>
                        <Image Grid.Row="0" Grid.Column="0" 
                               VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"
                               Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="backButton_Tapped" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                </Grid.RowDefinitions>

                <StackLayout Padding="24,10,24,10" Grid.Row="0" Orientation="Horizontal">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label Style="{StaticResource ValueLabelBlack}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1"  Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQ1}"/>
                        <Grid Grid.Row="1" HeightRequest="100">
                        <buttons:SfRadioGroup x:Name="RadioQ1" Orientation="Horizontal" >
                            <buttons:SfRadioButton x:Name="YesQ1" HorizontalOptions="StartAndExpand" Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQOptionsYes}" IsChecked="{Binding IsYesQ1Checked}" StateChanged="YesQ1_StateChanged" TextColor="{StaticResource Primary}" UncheckedColor="{Binding rq1}" CheckedColor="{StaticResource SecondaryNew}"/>
                            <buttons:SfRadioButton x:Name="NoQ1" StateChanged="YesQ1_StateChanged" TextColor="{StaticResource Primary}" Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQOptionsNo}" IsChecked="{Binding IsNoQ1Checked}" UncheckedColor="{Binding rq1}" CheckedColor="{StaticResource SecondaryNew}" HorizontalOptions="StartAndExpand"/>
                        </buttons:SfRadioGroup>
                    </Grid>
                  </Grid>
                </StackLayout>

                <StackLayout Padding="24,10,24,10" Grid.Row="1" Orientation="Horizontal" IsVisible="{Binding basedonQ1}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label Style="{StaticResource ValueLabelBlack}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQ2}"/>
                      <Grid Grid.Row="1" HeightRequest="100">

                       <buttons:SfRadioGroup x:Name="Radio1" Orientation="Horizontal"  >
                            <buttons:SfRadioButton x:Name="Yes"  HorizontalOptions="StartAndExpand" Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQOptionsYes}" IsChecked="{Binding IsYesQ2Checked}" StateChanged="Yes_StateChanged" TextColor="{StaticResource Primary}" CheckedColor="{StaticResource SecondaryNew}" UncheckedColor="{Binding rq2}"/>
                            <buttons:SfRadioButton x:Name="No"  Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQOptionsNo}" IsChecked="{Binding IsNoQ2Checked}" UncheckedColor="{Binding rq2}" StateChanged="Yes_StateChanged" TextColor="{StaticResource Primary}" CheckedColor="{StaticResource SecondaryNew}" HorizontalOptions="StartAndExpand"/>
                        </buttons:SfRadioGroup>

                       </Grid>
                    </Grid>
                </StackLayout>

            </Grid>

            <Grid Grid.Row="2" Grid.Column="0" Padding="24,10,24,10">
                <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>

                 <buttons:SfButton  Grid.Row="0" x:Name="btnSubmit" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Text="{x:Static ResourceManager:AppResources.ZprofitsOnGoodsSubmit}"
                                  Style="{StaticResource PrimaryButtonStyle}" Clicked="OnSubmitButtonClicked" />
                 <buttons:SfButton   Grid.Row="1" x:Name="btnCancel" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Text="{x:Static ResourceManager:AppResources.ZprofitsOnGoodscancel}"
                                  Style="{StaticResource SecondaryButtonStyle}" Clicked="OnCancelButtonClicked" />
            </Grid>
           

            <Grid Grid.Row="0" Grid.Column="0"  IsVisible="{Binding IsLoading}" Margin="0,-20,0,0">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="{StaticResource Secondary}"/>
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>

